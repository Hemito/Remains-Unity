# Keep only the Unity project and public repository documents at the root.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/RemainsUnity/
!/README.md
!/README.en.md
!/CONTRIBUTING.md
!/PROJECT_STATUS.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/LICENSING.md
!/ADDITIONAL_PERMISSIONS.md
!/AUTHORING_INPUTS.md
!/Tools/
/Tools/*
!/Tools/RoomConvert/
!/Tools/RoomEditor/
!/Tools/Shared/
/Tools/Shared/*
!/Tools/Shared/SwfXmlPatch.cs
**/[Bb]in/

# Generated Unity state and local files.
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Bb]uild/
**/[Bb]uilds/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
**/.vs/
**/.idea/
**/.vscode/
**/*.csproj
**/*.sln
**/*.slnx
**/*.suo
**/*.user
**/*.tmp
**/*.pidb
**/sysinfo.txt
**/MirrorExamplesPipelineConverted.txt
.env
.env.*
**/*.pfx
**/*.p12

# Local instructions, tooling state and diagnostic output never belong in the public project.
**/.agents/
**/.codex/
**/AGENTS.md
**/AGENTS.md.meta
**/CLAUDE.md
**/CLAUDE.md.meta
**/*.log

# Generated performance-test metadata.
RemainsUnity/Assets/Resources/PerformanceTestRun*.json*

# The public room format converter keeps its .NET project files.
!/Tools/RoomConvert/**/*.csproj
!/Tools/RoomEditor/**/*.csproj
!/RemainsUnity/Tests/**/*.csproj

!/DEVELOPER_TODO.md
!/Tools/LocalizationSourceScan/**/*.csproj
!/Tools/LocalizationReuse/**/*.csproj
!/Tools/LocalizationOwn/**/*.csproj
