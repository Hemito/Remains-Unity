    damexpl=\\\"120\\\" /><phis speed=\\\"75\\\" deviation=\\\"3\\\" /><vis tipdec=\\\"11\\\"
    vbul=\\\"fireball\\\" flare=\\\"\\\" /><dop effect=\\\"igni\\\" damage=\\\"15\\\"
    ch=\\\"1\\\" /><snd shoot=\\\"fireball\\\" noise=\\\"800\\\" /><sats cons=\\\"60\\\"
