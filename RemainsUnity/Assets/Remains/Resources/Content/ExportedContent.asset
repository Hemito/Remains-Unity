    knock=\\\"20\\\" destroy=\\\"30\\\" /><char maxhp=\\\"420\\\" damage=\\\"60\\\"
    prec=\\\"10\\\" /><phis speed=\\\"250\\\" deviation=\\\"5\\\" recoil=\\\"15\\\"
    massa=\\\"3\\\" /><vis tipdec=\\\"2\\\" shell=\\\"1\\\" /><snd shoot=\\\"p127_s\\\"
    reload=\\\"p10mm_r\\\" noise=\\\"1700\\\" /><sats cons=\\\"17\\\" /><ammo holder=\\\"7\\\"
    reload=\\\"30\\\" /><a>p50mg</a><com price=\\\"2500\\\" worth=\\\"4\\\" chance=\\\"0.3\\\"
