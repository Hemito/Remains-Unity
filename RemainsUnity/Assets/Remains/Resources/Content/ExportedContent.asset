    attribute presence -> Emitter gilza at logical weapon X/Y; part:gilza\",\"label\":null,\"frame\":null,\"metadataXml\":\"<part
    id=\\\"gilza\\\" vis=\\\"visualGilza\\\" ctrans=\\\"1\\\" minliv=\\\"20\\\" rliv=\\\"10\\\"
