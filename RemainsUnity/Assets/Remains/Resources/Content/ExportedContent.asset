    runtime pose not baked\",\"animationLabels\":[]},\"ruleSources\":[\"source/rules/fe/weapon/Weapon.as\",\"source/rules/fe/weapon/WThrow.as\",\"source/rules/fe/weapon/Bullet.as\",\"source/rules/fe/weapon/PhisBullet.as\",\"source/rules/fe/weapon/SmartBullet.as\",\"source/rules/fe/graph/Emitter.as\",\"source/rules/fe/unit/Mine.as\"],\"issues\":[]}]},{\"version\":1,\"id\":\"hsword\",\"definition\":\"weapon:hsword\",\"evidence\":\"code/resource-derived;
