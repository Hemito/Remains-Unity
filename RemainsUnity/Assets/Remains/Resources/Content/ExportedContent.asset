    visbul prefix; base then grade attributes\",\"label\":null,\"frame\":null,\"metadataXml\":null,\"sheet\":null},{\"role\":\"flare-grade-1\",\"resource\":\"pfeUI:3040\",\"rule\":\"weapon.vis.flare;
