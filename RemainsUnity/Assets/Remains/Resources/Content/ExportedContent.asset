    runtime pose not baked\",\"animationLabels\":[\"ready\",\"reload\",\"shoot\"]},\"ruleSources\":[\"source/rules/fe/weapon/Weapon.as\",\"source/rules/fe/weapon/Bullet.as\",\"source/rules/fe/weapon/PhisBullet.as\",\"source/rules/fe/weapon/SmartBullet.as\",\"source/rules/fe/graph/Emitter.as\"],\"issues\":[]},{\"grade\":1,\"parameters\":{\"grade\":1,\"behavior\":\"Weapon\",\"evidence\":\"code-derived;
