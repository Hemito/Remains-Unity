    knock=\\\"0\\\" destroy=\\\"0\\\" /><char maxhp=\\\"300\\\" damage=\\\"75\\\"
    rapid=\\\"12\\\" destroy=\\\"50\\\" /><phis speed=\\\"2000\\\" deviation=\\\"5\\\"
    recoil=\\\"0\\\" massa=\\\"8\\\" m=\\\"2\\\" /><vis vbul=\\\"termo\\\" tipdec=\\\"11\\\"
    flare=\\\"laser\\\" spring=\\\"2\\\" /><snd shoot=\\\"termo_s\\\" reload=\\\"laser_r\\\"
