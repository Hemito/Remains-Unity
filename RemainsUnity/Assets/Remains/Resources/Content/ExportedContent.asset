    declaration; before XML and subclass constructor\"},\"tip\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:104
    declaration; before XML and subclass constructor\"},\"tipDamage\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:162
    declaration; before XML and subclass constructor\"},\"tipDecal\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:218
    declaration; before XML and subclass constructor\"},\"uniq\":{\"raw\":\"-1\",\"numeric\":-1,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:100
    declaration; before XML and subclass constructor\"},\"variant\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:102
    declaration; before XML and subclass constructor\"},\"visionMult\":{\"raw\":\"1\",\"numeric\":1,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:246
    declaration; before XML and subclass constructor\"},\"volna\":{\"raw\":\"false\",\"numeric\":null,\"boolean\":false,\"source\":\"fe/weapon/Weapon.as:130
    declaration; before XML and subclass constructor\"},\"weaponSkill\":{\"raw\":\"1\",\"numeric\":1,\"boolean\":null,\"source\":\"fe/weapon/Weapon.as:70
    declaration; before XML and subclass constructor\"}},\"derived\":{\"baseAutomaticFire\":{\"raw\":\"false\",\"numeric\":null,\"boolean\":false,\"source\":\"Weapon.as:856-859;
    sequential getCharParam calls; owner-independent baseline only\"},\"baseRecoilUp\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"Weapon.as:569;
    int recoil/int recoilUp; NPC multiplier applied later at571-573\"}},\"rules\":[{\"id\":\"constructor-selection\",\"expression\":\"tip1=WClub;
    tip12=WPaint; tip4=WThrow; tip5=WMagic; otherwise punch>0=WPunch; otherwise Weapon\",\"source\":\"Weapon.as:343-395\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"variant-overlay\",\"expression\":\"vis,snd,phis,ammo,dop,char:
    base[0], then section[grade] if present; E4X @attribute.length() tests presence,
    including empty values; com only price may use grade, sats only base\",\"source\":\"Weapon.as:433-567\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"automatic-fire\",\"expression\":\"Every non-null
    getCharParam call recomputes auto=(currentRapid<=6), then if auto attribute exists
    assigns (attribute != string '0'); empty auto therefore means true; base auto
    is not retained merely because grade omits auto\",\"source\":\"Weapon.as:856-859\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"presence-flags\",\"expression\":\"vis.shell/bulanim/phisbul;
    phis.distexpl/volna; sats.no/noperc activate by attribute presence, including
    literal 0 and empty string\",\"source\":\"Weapon.as:441-448,607-621,767-773\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"physics-mass-reset\",\"expression\":\"Every existing
    phis section assigns massa=attribute.massa>0 ? massa/50 : 0; absent grade.massa
    clears base mass; XML overlay is not final runtime massa\",\"source\":\"Weapon.as:715-722\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"conditional-gravity\",\"expression\":\"Each getPhisParam
    call first assigns grav if @grav exists; then assigns grav2 to grav only if owner
    exists, owner.fraction!=Unit.F_PLAYER and @grav2 exists (including empty/0).
    Process base then grade calls in order; grav2 is not unconditional projectile
    gravity and never applies to a player-faction owner\",\"source\":\"Weapon.as:751-758;
    calls at433-567\",\"status\":\"code-derived; runtime unverified\"},{\"id\":\"coordinate-origin\",\"expression\":\"Visual
    SWF origin is local(0,0); emit socket coordinates are source pixels; PNG canvas/pivot
    transforms apply separately; mirror/weapon rotation transform socket before launching\",\"source\":\"Weapon.as:1396-1418,1993-2012\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"muzzle\",\"expression\":\"vis.emit exists and
    visual parent exists: localToGlobal(emit.x,emit.y) then parent.globalToLocal;
    otherwise original uses weapon X/Y\",\"source\":\"Weapon.as:1396-1418\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"attachment\",\"expression\":\"Owner.weaponX/weaponY,
    owner.weaponKrep and owner.magicX/magicY are actor-specific; krep can override
    weapon default; tip5 starts from magic attachment\",\"source\":\"Weapon.as:499-502,1062-1093;
    Unit.setWeaponPos\",\"status\":\"code-derived; runtime unverified\"},{\"id\":\"launch-direction\",\"expression\":\"rot-recoilUpAngle*side/50
    + randomSpread + (projectileIndex-(kol-1)/2)*deviation*pi/360; dx=cos(rot)*velocity,
    dy=sin(rot)*velocity\",\"source\":\"Weapon.as:1456-1507\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"launch-speed\",\"expression\":\"speed*ownerSpeedMultiplier;
    if neither gravity nor wave, additionally random factor [0.8,1.2); gravity, acceleration,
    homing and flame behavior remain runtime rules\",\"source\":\"Weapon.as:1496-1560\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"critical-parameters\",\"expression\":\"critM=XMLcrit-1;
    critCh=0.1*XMLcrit; precision=XMLprec*40; antiprec=XMLantiprec*40; owner modifiers
    apply later\",\"source\":\"Weapon.as:803-827,1629-1642,1696-1705\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"ammunition\",\"expression\":\"a[0] selects base
    item; replacement ammunition requires item.base==ammoBase; ammunition modifiers
    reset to declared baseline then apply item attributes; no owner-derived result
    is baked\",\"source\":\"Weapon.as:558-563,1745-1810,1918-1931\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"shoot-sound\",\"expression\":\"snd.shoot plays
    at weapon X/Y after shoot, when shotCounter % sndShoot_n == 0; sndShoot_n declaration
    is1, optional shoot_n read by getSndParam\",\"source\":\"Weapon.as:304-306,645-655,1616-1620\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"prep-sound\",\"expression\":\"snd.t1/t2 are playback
    positions; looping restarts at t1+200ms and release advances to t2+100ms using
    runtime attack state\",\"source\":\"Weapon.as:1239-1252\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"shoot-animation\",\"expression\":\"Animated weapon
    gotoAndPlay('shoot') on shoot only when t_shoot<=1; t_shoot then3; stage/lifetime
    remain original timeline and simulation rules\",\"source\":\"Weapon.as:1599-1610\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"shell\",\"expression\":\"If vis.shell is present,
    emit gilza at weapon X/Y with dx=-10*visualScaleX,dy=-10,dr=-15*visualScaleX;
    shell is not launched from emit socket\",\"source\":\"Weapon.as:236,1566-1574\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"impact-and-explosion\",\"expression\":\"flare
    defaults to vbul and is emitted by Bullet on impact; explicit visexpl overrides
    explosion appearance; otherwise damage type and underwater state choose branch-specific
    effects/sounds\",\"source\":\"Weapon.as:507-510; Bullet.as:345-382,879-1000\",\"status\":\"code-derived;
    runtime unverified\"},{\"id\":\"specialized-classes\",\"expression\":\"WClub
    overrides speed15 and base-only reach/combo/power fields; WThrow overrides holder1/ammo=id/projectile=weapon
    and reads base-only timer/fall; WMagic/WPunch/WPaint have separate attack/animation
    rules\",\"source\":\"WClub.as:110-190; WThrow.as:30-72; WMagic.as; WPunch.as;
    WPaint.as\",\"status\":\"code-derived; runtime unverified\"}],\"units\":{\"coordinates\":\"source
    pixels: X right, Y down; independent of exported PNG zoom\",\"deviation/drot/drot2\":\"XML
    degrees; original angular calculations convert to radians\",\"rapid/prep/reload/recharg\":\"original
    simulation steps; no conversion to seconds\",\"snd.t1/snd.t2\":\"sound playback
    position in milliseconds\",\"speed/accel\":\"source displacement per simulation
    step / acceleration per step; modifiers remain dynamic\"},\"issues\":[\"\u0420\u0430\u0437\u0434\u0435\u043B
    \u043E\u0440\u0443\u0436\u0438\u044F n \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E, \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u0432 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u043C
    \u043A\u043B\u0430\u0441\u0441\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043E.\",\"\u041A\u043B\u0430\u0441\u0441
    WClub: \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B XML \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B,
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u043E
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438 \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438;
    \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E Weapon \u043D\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u044B
    \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438.\",\"\u0418\u0442\u043E\u0433\u043E\u0432\u044B\u0439
    \u0443\u0440\u043E\u043D, \u0440\u0430\u0437\u0431\u0440\u043E\u0441, \u0442\u0435\u043C\u043F,
    \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441 \u0438 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430,
    \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430,
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u043E\u0440\u0443\u0436\u0438\u044F
    \u0438 \u043C\u0438\u0440\u0430; \u043F\u0430\u043A\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
    \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430, \u0430 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u044B\u0439
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0431\u043E\u044F.\"]},\"graphics\":[{\"role\":\"appearance-grade-1\",\"resource\":\"pfeUI:1421\",\"rule\":\"verified
    Weapon.as variant->base shared artwork rule\",\"label\":null,\"frame\":null,\"metadataXml\":null,\"sheet\":null},{\"role\":\"item-image-grade-1\",\"resource\":\"pfeUI:1421\",\"rule\":\"Loot.as
    vis<ID>[_grade], shared base when grade absent; inventory/world image is identical;
    independent of held vweap override\",\"label\":null,\"frame\":null,\"metadataXml\":null,\"sheet\":null}],\"sounds\":[{\"role\":\"fall\",\"resource\":\"sound:79\",\"rule\":\"snd/attribute
    symbol fall_hammer\",\"label\":null,\"frame\":null,\"metadataXml\":null,\"sheet\":null},{\"role\":\"shoot\",\"resource\":\"sound_weapon:38\",\"rule\":\"snd/attribute
    symbol m_med\",\"label\":null,\"frame\":null,\"metadataXml\":null,\"sheet\":null}],\"ammoDefinitions\":[],\"effects\":[],\"effectResolutionRule\":\"configured
    references are not unconditional spawns; actual effects depend on hit/material/water/damage
    type/ammo and particle rules in Bullet.as/Emitter.as\",\"launch\":{\"appearance\":\"pfeUI:1421\",\"coordinateSpace\":\"weapon-local
    source pixels; x right, y down; independent of PNG zoom\",\"rule\":\"melee sweep;
    not a muzzle-fired projectile\",\"directionRule\":\"sampled melee path, owner
    facing and attack phase; specialized behavior adapter\",\"source\":\"source/rules/fe/weapon/WClub.as:148\",\"socketName\":\"emit\",\"hasAuthoredSocket\":false,\"missingSocketPolicy\":\"explicit
    original logical weapon X/Y; not sprite center; requires owner pose\",\"casingOriginRule\":\"logical
    weapon X/Y; Emitter gilza; not emit (Weapon.as:1568-1572)\",\"poseRule\":\"compose
    owner attachment/aim/facing + weapon visual recoil + frame emit; Weapon.as:1972-2011;
    runtime pose not baked\",\"animationLabels\":[]},\"ruleSources\":[\"source/rules/fe/weapon/Weapon.as\",\"source/rules/fe/weapon/WClub.as\",\"source/rules/fe/weapon/Bullet.as\",\"source/rules/fe/weapon/PhisBullet.as\",\"source/rules/fe/weapon/SmartBullet.as\",\"source/rules/fe/graph/Emitter.as\"],\"issues\":[]}]}]"
