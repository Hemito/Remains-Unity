    implicit flare=visbul; impact effect; part:sparkl\",\"label\":null,\"frame\":null,\"metadataXml\":\"<part
    id=\\\"sparkl\\\" vis=\\\"flSparkl\\\" minliv=\\\"3\\\" anim=\\\"1\\\" />\",\"sheet\":null},{\"role\":\"item-image-grade-0\",\"resource\":\"pfeUI:1762\",\"rule\":\"Loot.as
    vis<ID>[_grade], shared base when grade absent; inventory/world image is identical;
