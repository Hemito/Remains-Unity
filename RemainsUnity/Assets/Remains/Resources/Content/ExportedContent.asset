    destroy=\\\"500\\\" pow=\\\"1\\\" /><char maxhp=\\\"500\\\" damage=\\\"85\\\"
    knock=\\\"28\\\" /><phis massa=\\\"15\\\" m=\\\"3\\\" minlong=\\\"60\\\" long=\\\"70\\\"
