    attribute overlay; see execution rules for presence tests, conversion and conditional
    overrides\",\"values\":{\"crit\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@crit\"},\"damage\":{\"raw\":\"0\",\"numeric\":0,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@damage\"},\"damexpl\":{\"raw\":\"120\",\"numeric\":120,\"boolean\":null,\"source\":\"AllData/weapon/char[1]/@damexpl\"},\"destroy\":{\"raw\":\"120\",\"numeric\":120,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@destroy\"},\"expl\":{\"raw\":\"100\",\"numeric\":100,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@expl\"},\"knock\":{\"raw\":\"25\",\"numeric\":25,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@knock\"},\"prec\":{\"raw\":\"10\",\"numeric\":10,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@prec\"},\"rapid\":{\"raw\":\"24\",\"numeric\":24,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@rapid\"},\"tipdam\":{\"raw\":\"3\",\"numeric\":3,\"boolean\":null,\"source\":\"AllData/weapon/char[0]/@tipdam\"}}},{\"name\":\"phis\",\"meaning\":\"XML
    attribute overlay; see execution rules for presence tests, conversion and conditional
