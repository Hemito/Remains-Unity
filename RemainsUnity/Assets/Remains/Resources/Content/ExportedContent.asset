    id=\\\"plasma\\\" vis=\\\"flPlasma\\\" minliv=\\\"3\\\" anim=\\\"1\\\" />\",\"sheet\":null},{\"role\":\"item-image-grade-0\",\"resource\":\"pfeUI:1396\",\"rule\":\"Loot.as
