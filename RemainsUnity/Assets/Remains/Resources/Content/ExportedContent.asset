    visbul prefix; base then grade attributes\",\"label\":null,\"frame\":null,\"metadataXml\":null,\"sheet\":null},{\"role\":\"flare-grade-0\",\"resource\":\"pfeUI:3048\",\"rule\":\"Weapon.as
