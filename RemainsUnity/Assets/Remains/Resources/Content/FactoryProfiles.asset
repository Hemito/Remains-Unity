  - id: remains:factory:raiders
    title: "\u0417\u0430\u0445\u0432\u0430\u0447\u0435\u043D \u0440\u0435\u0439\u0434\u0435\u0440\u0430\u043C\u0438"
    description: "\u0411\u0430\u043D\u0434\u0430 \u043E\u0431\u0436\u0438\u043B\u0430
      \u0446\u0435\u0445\u0430. \u041F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435
      \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u0437\u0430\u043D\u044F\u0442\u044B
      \u0440\u0435\u0439\u0434\u0435\u0440\u0430\u043C\u0438, \u0443 \u043C\u043D\u043E\u0433\u0438\u0445
      \u0435\u0441\u0442\u044C \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B."
    chance: 3
    monsterRooms: 1
    raiderRooms: 8
    robotRooms: 1
    raiderVariants: 010000000200000003000000040000000500000005000000050000000700000007000000
    raiderEquipment: 4
    dropForeignPlaced: 0.9
    ownCrawlers: 0.85
  - id: remains:factory:guarded
    title: "\u041D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u044B\u0439"
    description: "\u0421\u044E\u0434\u0430 \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F. \u0426\u0435\u0445\u0430
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442
      \u0431\u043E\u0442\u044B \u0438 \u0442\u0443\u0440\u0435\u043B\u0438."
    chance: 3
    monsterRooms: 1
    raiderRooms: 1
    robotRooms: 8
    raiderVariants: 
