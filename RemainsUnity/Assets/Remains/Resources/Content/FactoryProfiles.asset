    dropForeignPlaced: 0.9
    ownCrawlers: 0.85
  - id: remains:factory:infested
    title: "\u0417\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439"
    description: "\u0417\u0430\u0432\u043E\u0434 \u043E\u0442\u0434\u0430\u043D \u0442\u0432\u0430\u0440\u044F\u043C:
