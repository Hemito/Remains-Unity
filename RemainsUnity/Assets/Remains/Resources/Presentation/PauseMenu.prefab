    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0410\u0432\u0442\u043E\u043F\u0430\u0443\u0437\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
    \u0432\u0441\u0435\u0445 \u043C\u0435\u043D\u044E/\u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435\u0439\n\u0432
    \u044D\u0442\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0440\u043E\u0432\u043D\u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C."
