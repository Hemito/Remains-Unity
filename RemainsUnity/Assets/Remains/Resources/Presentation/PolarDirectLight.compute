// Editor comparison: preserve DirectLight's source shape, energy, range and absorption rules.
// All emitting samples keep their own polar layer; only the view direction is discretised at 5cm/radius.
#pragma kernel BuildMaps
#pragma kernel Field
#pragma kernel ExactField
#pragma kernel ClearWork
#pragma kernel AddWork
#pragma kernel RemoveField
#pragma kernel Detail
#pragma kernel DetailFlash

#include "LightRangeWeight.hlsl"

Texture2D<float> _Scene;
StructuredBuffer<float4> _Samples;
StructuredBuffer<float> _MarchDistances;
RWTexture2DArray<float> _MapOut;
Texture2DArray<float> _Map;
RWTexture2D<float4> _Field;
RWTexture2D<float4> _Work;
Texture2D<float4> _WorkField;
RWTexture2D<float4> _DirectSum;
Texture2D<float4> _RemovedField;
int2 _RemovalOrigin,_RemovalSize;
int2 _WorkSize,_WorkOrigin,_WorkFieldOrigin;
int4 _WorkClip;
int2 _SceneSize,_FieldOrigin,_FieldSize;
int _SampleCount,_SampleOffset,_Angles,_RadialSamples;
float4 _SceneRect,_SourceBounds,_Radiance;
float _PPU,_Radius,_ProjectedWidth,_MarchStep;
static const float Tau=6.283185307179586;
// HLSL static storage is invocation-local, not groupshared: the shared filter calls the active sample's prefix.
static int ActiveSample=0;
static int ActiveRow=-1;
bool Inside(int2 p){return all(p>=0) && all(p<_SceneSize);}
int2 ScenePoint(float2 world){return int2(floor((world-_SceneRect.xy)*_PPU));}
float2 WorldOf(int2 p){return _SceneRect.xy+(float2(p)+.5)/_PPU;}
bool InEmitterBounds(float2 world){return all(world>=_SourceBounds.xy) && all(world<=_SourceBounds.zw);}
// The angular box is one bin wide; atan2 supplies [0,N), so only the adjacent
// seam bins -1/N can escape. Avoid two integer divisions per prefix lookup.
int Wrap(int angle){return angle<0?angle+_Angles:(angle>=_Angles?angle-_Angles:angle);}

[numthreads(64,1,1)]
void BuildMaps(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=uint(_Angles) || id.y>=uint(_SampleCount))return;
    float angle=(id.x+.5)*Tau/_Angles;
    float2 direction=float2(cos(angle),sin(angle));
    float2 from=_Samples[_SampleOffset+id.y].xy;
    float transmission=1;bool stopped=false,leaving=true;
    [loop] for(int row=0;row<_RadialSamples;row++)
    {
        if(!stopped)
        {
            float2 world=from+direction*_MarchDistances[row];int2 p=ScenePoint(world);
            if(!Inside(p)){transmission=0;stopped=true;}
            else
            {
                float alpha=saturate(_Scene[p]);
                if(!(leaving && InEmitterBounds(world) && alpha>=.99))
                {
                    leaving=false;
                    if(alpha>=.99){transmission=0;stopped=true;}
                    else if(alpha>.0001)transmission*=pow(max(0,1-alpha),_MarchStep*_PPU);
                    if(transmission<.0001){transmission=0;stopped=true;}
                }
            }
        }
        _MapOut[int3(id.x,row,id.y)]=transmission;
    }
}
int PrefixRow(float distanceWorld)
{
    if(distanceWorld<.5/_PPU)return -1;
    float finish=max(0,distanceWorld-.6/_PPU);
    int count=min(max(0,(int)ceil(finish/_MarchStep-.5)),_RadialSamples);
    [loop] while(count>0 && _MarchDistances[count-1]>=finish)count--;
    [loop] while(count<_RadialSamples && _MarchDistances[count]<finish)count++;
    return count-1;
}
float PolarSample(int angle,float distanceWorld){return ActiveRow<0?1:_Map[int3(Wrap(angle),ActiveRow,ActiveSample)];}
#include "PolarAngularFilter.hlsl"
float PolarTransmission(float2 delta,float distanceWorld)
{
    if(distanceWorld<.5/_PPU)return 1;
    ActiveRow=PrefixRow(distanceWorld);
    float angle=frac(atan2(delta.y,delta.x)/Tau+1)*_Angles;
    return PolarBoxFilter(angle,.05*_Angles/(Tau*_Radius),distanceWorld);
}
float ExactTransmission(float2 from,float2 to)
{
    float2 delta=to-from;float distanceWorld=length(delta);
    if(distanceWorld<.5/_PPU)return 1;
    float2 direction=delta/distanceWorld;
    float finish=max(0,distanceWorld-.6/_PPU),transmission=1;bool leaving=true;
    [loop] for(float at=_MarchStep*.5;at<finish;at+=_MarchStep)
    {
        float2 world=from+direction*at;int2 p=ScenePoint(world);
        if(!Inside(p))return 0;
        float alpha=saturate(_Scene[p]);
        if(leaving && InEmitterBounds(world) && alpha>=.99)continue;
        leaving=false;
        if(alpha>=.99)return 0;
        if(alpha>.0001)transmission*=pow(max(0,1-alpha),_MarchStep*_PPU);
        if(transmission<.0001)return 0;
    }
    return transmission;
}
float3 Irradiance(float2 target,bool exact)
{
    float3 light=0;
    [loop] for(int pointIndex=0;pointIndex<_SampleCount;pointIndex++)
    {
        float4 source=_Samples[_SampleOffset+pointIndex];float2 delta=target-source.xy;float d=length(delta);
        float edge=LightRangeWeight(d,_Radius);
        if(edge<=0)continue;
        ActiveSample=pointIndex;
        float transmission=exact?ExactTransmission(source.xy,target):PolarTransmission(delta,d);
        float patchWidth=source.z*_ProjectedWidth;
        float value=2*atan(patchWidth/(2*max(d,.5/_PPU)))*edge;
        light+=_Radiance.rgb*(value*transmission);
    }
    return light;
}
float3 Receiver(int2 p,bool exact)
{
    if(_Scene[p]<.99)return Irradiance(WorldOf(p),exact);
    const int2 sides[4]={int2(1,0),int2(-1,0),int2(0,1),int2(0,-1)};
    float3 light=0;
    [unroll]for(int side=0;side<4;side++)
    {
        int2 q=p+sides[side];
        if(Inside(q) && _Scene[q]<.99)light=max(light,Irradiance(WorldOf(q),exact));
    }
    return light;
}
[numthreads(8,8,1)]
void Field(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_FieldSize)))return;
    _Field[id.xy]=float4(Receiver(_FieldOrigin+int2(id.xy),false),1);
}
[numthreads(8,8,1)]
void ExactField(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_FieldSize)))return;
    _Field[id.xy]=float4(Receiver(_FieldOrigin+int2(id.xy),true),1);
}
[numthreads(8,8,1)]
void ClearWork(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_WorkSize)))return;
    _Work[id.xy]=0;
}
[numthreads(8,8,1)]
void AddWork(uint3 id:SV_DispatchThreadID)
{
    int2 p=_WorkClip.xy+int2(id.xy);
    if(any(p>=_WorkClip.zw))return;
    int2 target=p-_WorkOrigin;
    _Work[target]=float4(_Work[target].rgb+_WorkField[p-_WorkFieldOrigin].rgb,1);
}

// Linear source removal; never subtract from a tone-mapped/composited camera texture.
[numthreads(8,8,1)]
void RemoveField(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_RemovalSize)))return;
    int2 p=_RemovalOrigin+int2(id.xy);
    _DirectSum[p]=float4(max(0,_DirectSum[p].rgb-_RemovedField[id.xy].rgb),1);
}

RWTexture2D<float4> _DetailOut;
Texture2D<float4> _DetailMask;
int2 _DetailSize;
int4 _DetailClip;
float4 _DetailRect;
int _DetailMode;
RWTexture2D<float4> _DetailBack;
float3 DetailIrradiance(int2 pixel)
{
    float2 world=_DetailRect.xy+(float2(pixel)+.5)/_DetailSize*_DetailRect.zw;
    int2 p=ScenePoint(world);
    return Inside(p)?(_Scene[p]>=.99?Receiver(p,false):Irradiance(world,false)):0;
}
[numthreads(8,8,1)]
void Detail(uint3 id:SV_DispatchThreadID)
{
    int2 pixel=_DetailClip.xy+int2(id.xy);
    if(any(pixel>=_DetailClip.zw))return;
    float opacity=1;
    if(_DetailMode==2){opacity=saturate(_DetailMask[pixel].a);if(opacity==0)return;}
    float3 light=DetailIrradiance(pixel);
    if(_DetailMode==1)light=-light;
    if(_DetailMode==2)light*=-opacity;
    if(_DetailMode==3)light*=1-saturate(_DetailMask[pixel].a);
    _DetailOut[pixel]=float4(_DetailOut[pixel].rgb+light,1);
}
[numthreads(8,8,1)]
void DetailFlash(uint3 id:SV_DispatchThreadID)
{
    int2 pixel=_DetailClip.xy+int2(id.xy);
    if(any(pixel>=_DetailClip.zw))return;
    float3 light=DetailIrradiance(pixel);
    _DetailOut[pixel]=float4(_DetailOut[pixel].rgb+light,1);
    _DetailBack[pixel]=float4(_DetailBack[pixel].rgb+light*(1-saturate(_DetailMask[pixel].a)),1);
}

