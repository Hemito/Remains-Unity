// Radiance cascades (flatland light transport, prototype). Grid = room light texels.
// Scene: rgb emitted radiance (lamps, glowing screens), a = absorption (1 walls and lamps; objects
// partly: a ray crossing the texel keeps 1 - a of its light). Rays gather emission × transmittance until it runs out (an
// opaque texel ends the ray); rays leaving the room are lost (as in the reference tracer).
// Cascade c: probes every 2^c texels, 4^(c+1) directions, ray interval [(4^c-1)/3, (4^(c+1)-1)/3]
// texels (a hit takes the scene emission plus the wall's bounce radiance); each probe stores its directions as a 2^(c+1) square block. Computed from the top
// cascade down; a ray that hits nothing continues with the cascade above (its 4 sub-directions,
// bilinear between the 4 nearest upper probes). Fluence = Σ radiance × 2π / 4 over cascade 0;
// opaque texels (inside walls, beams) then take the brightest open texel within 2 texels, so thin
// beams and wall rims read the light beside them; lamp disks look up to 6 texels (their centre).
#pragma kernel Seed
#pragma kernel Jump
#pragma kernel Distance
#pragma kernel Cascade
#pragma kernel Fluence
#pragma kernel Fill
#pragma kernel Bounce
#pragma kernel TransientScene
#pragma kernel CombineDirect

#define FAR 1e6
#define TAU 6.28318530718

Texture2D<float4> _Scene;
Texture2D<float2> _SeedsIn;
RWTexture2D<float2> _SeedsOut;
Texture2D<float2> _SeedsFinal;
RWTexture2D<float> _DistanceOut;
Texture2D<float> _Distance;
Texture2D<float4> _Upper;
RWTexture2D<float4> _Cascade;
Texture2D<float4> _Cascade0;
RWTexture2D<float4> _Fluence;
Texture2D<float4> _FluenceRaw;
Texture2D<float4> _Bounce;          // wall radiance from the previous update (one bounce per update)
RWTexture2D<float4> _BounceOut;
float _Albedo;
float _BounceGain;
RWTexture2D<float4> _TransientScene;
Texture2D<float4> _StaticFluence;
Texture2D<float4> _DirectFluence;
float _EdgeTexels;   // shadows.edge in light texels (walls' lit edge; reserved)
float _RimTexels;    // objects, rim mode: width of the dimming at the dark edge
int _ObjectGradient; // objects: 1 gradient through the body, 0 rim
int2 _Size;
int _Step;
int _Level;
int _Top;

bool Inside(int2 p) { return all(p >= 0) && all(p < _Size); }

[numthreads(8,8,1)]
void Seed(uint3 id : SV_DispatchThreadID)
{
    if (!Inside(int2(id.xy))) return;
    float4 scene = _Scene[id.xy];
    _SeedsOut[id.xy] = scene.a > 0.004 || any(scene.rgb > 0) ? float2(id.xy) : float2(-FAR, -FAR);
}

// Jump flood: nearest opaque texel among the 3×3 neighbours at distance _Step.
[numthreads(8,8,1)]
void Jump(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!Inside(p)) return;
    float2 best = _SeedsIn[p];
    float bestDistance = best.x < -FAR * 0.5 ? FAR : distance(best, float2(p));
    for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 q = p + int2(dx, dy) * _Step;
            if (!Inside(q)) continue;
            float2 s = _SeedsIn[q];
            if (s.x < -FAR * 0.5) continue;
            float d = distance(s, float2(p));
            if (d < bestDistance) { bestDistance = d; best = s; }
        }
    _SeedsOut[p] = best;
}

[numthreads(8,8,1)]
void Distance(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!Inside(p)) return;
    float2 s = _SeedsFinal[p];
    _DistanceOut[p] = s.x < -FAR * 0.5 ? FAR : distance(s, float2(p));
}

[numthreads(8,8,1)]
void Cascade(uint3 id : SV_DispatchThreadID)
{
    int c = _Level;
    int block = 1 << (c + 1), directions = block * block, spacing = 1 << c;
    int2 probes = (_Size + spacing - 1) / spacing;
    int2 probe = int2(id.xy) / block, local = int2(id.xy) % block;
    if (any(probe >= probes)) return;
    int dir = local.x + local.y * block;
    float2 origin = (float2(probe) + 0.5) * spacing;
    float angle = (dir + 0.5) / directions * TAU;
    float2 d = float2(cos(angle), sin(angle));
    float start = ((1 << (2 * c)) - 1) / 3.0, end = ((1 << (2 * (c + 1))) - 1) / 3.0;

    float4 result = float4(0, 0, 0, 1);   // rgb radiance, a = transmittance left for the cascade above
    float t = start;
    for (int i = 0; i < 256 && t < end && result.a > 0.002; i++)
    {
        float2 p = origin + d * t;
        int2 texel = int2(floor(p));
        if (!Inside(texel)) { result.a = 0; break; }
        float sd = _Distance[texel];
        if (sd < 0.5)
        {
            // Emitting or absorbing texel: its emission (lamps, glowing screens; walls' bounce by
            // their absorption), then the light behind it is dimmed. One step per texel inside.
            float4 scene = _Scene[texel];
            result.rgb += result.a * (scene.rgb + _Bounce[texel].rgb * scene.a * _BounceGain);
            result.a *= 1 - scene.a;
            t += 1.0;
        }
        else t += max(sd - 1.0, 0.5);
    }

    if (result.a > 0.002 && c < _Top)
    {
        int upperSpacing = spacing * 2, upperBlock = block * 2;
        int2 upperProbes = (_Size + upperSpacing - 1) / upperSpacing;
        float2 f = origin / upperSpacing - 0.5;
        int2 q0 = int2(floor(f));
        float2 w = f - q0;
        float3 merged = 0;
        for (int k = 0; k < 4; k++)
        {
            int j = dir * 4 + k;
            int2 jl = int2(j % upperBlock, j / upperBlock);
            for (int corner = 0; corner < 4; corner++)
            {
                int2 o = int2(corner & 1, corner >> 1);
                int2 q = clamp(q0 + o, int2(0, 0), upperProbes - 1);
                float weight = (o.x ? w.x : 1 - w.x) * (o.y ? w.y : 1 - w.y);
                merged += _Upper[q * upperBlock + jl].rgb * weight;
            }
        }
        result.rgb += merged * 0.25 * result.a;
    }
    _Cascade[id.xy] = result;
}

[numthreads(8,8,1)]
void Fluence(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!Inside(p)) return;
    float3 sum = _Cascade0[p * 2].rgb + _Cascade0[p * 2 + int2(1, 0)].rgb + _Cascade0[p * 2 + int2(0, 1)].rgb + _Cascade0[p * 2 + int2(1, 1)].rgb;
    _Fluence[p] = float4(sum * (TAU / 4), 1);
}

[numthreads(8,8,1)]
void Fill(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!Inside(p)) return;
    float own = _Scene[p].a;
    if (own <= 0.004) { _Fluence[p] = _FluenceRaw[p]; return; }   // open
    if (own < 0.99)
    {
        // Partly absorbing object (unlike walls; its own texels are dimmed by its own absorption).
        const int r = 16;
        float4 lit = _FluenceRaw[p];
        if (_ObjectGradient == 0)
        {
            // Rim: the body takes the brightest light around it fully; it dims only within _RimTexels
            // of an open texel that is dark (the shadow side), for volume.
            for (int dy = -r; dy <= r; dy += 2)
                for (int dx = -r; dx <= r; dx += 2)
                {
                    int2 q = p + int2(dx, dy);
                    if (Inside(q) && _Scene[q].a <= 0.004 && dx * dx + dy * dy <= r * r) lit = max(lit, _FluenceRaw[q]);
                }
            float bright = max(lit.r, max(lit.g, lit.b));
            float dark = 1e4;
            int rr = (int)ceil(_RimTexels) + 1;
            for (int dy2 = -rr; dy2 <= rr; dy2++)
                for (int dx2 = -rr; dx2 <= rr; dx2++)
                {
                    int2 q = p + int2(dx2, dy2);
                    if (!Inside(q) || _Scene[q].a > 0.004) continue;
                    float4 f = _FluenceRaw[q];
                    if (max(f.r, max(f.g, f.b)) < 0.5 * bright) dark = min(dark, length(float2(dx2, dy2)));
                }
            float t = saturate((dark - 0.5) / _RimTexels);
            _Fluence[p] = lit * (t * t * (3 - 2 * t));
            return;
        }
        // Gradient: for each nearby open texel q (every second), its light dimmed linearly by the share
        // of the way from q's edge to the far edge (thickness measured along q → p); rays that cannot
        // beat the current light are skipped before measuring.
        for (int gy = -r; gy <= r; gy += 2)
            for (int gx = -r; gx <= r; gx += 2)
            {
                int2 q = p + int2(gx, gy);
                if (!Inside(q) || _Scene[q].a > 0.004) continue;
                float d = length(float2(gx, gy));
                if (d > r || d < 0.5) continue;
                float4 f = _FluenceRaw[q];
                if (all(f <= lit)) continue;
                float2 dir = -float2(gx, gy) / d;
                float rest = 0;
                for (int k = 1; k <= 32; k++)
                {
                    int2 s2 = int2(round(float2(p) + dir * k));
                    if (!Inside(s2) || _Scene[s2].a <= 0.004) break;
                    rest = k;
                }
                float t = (d - 0.5) / max(d + rest, 1);
                lit = max(lit, f * saturate(1 - t));
            }
        _Fluence[p] = lit;
        return;
    }
    float4 best = 0;
    int reach = any(_Scene[p].rgb > 0) ? 6 : 2;   // lamp disks: up to their centre
    for (int dy = -reach; dy <= reach; dy++)
        for (int dx = -reach; dx <= reach; dx++)
        {
            int2 q = p + int2(dx, dy);
            if (Inside(q) && _Scene[q].a < 0.99) best = max(best, _FluenceRaw[q]);
        }
    _Fluence[p] = best;
}

// Bounce: a wall texel beside open space reflects diffusely (flatland Lambert: outgoing radiance =
// albedo / 2 × irradiance). Irradiance from each open 4-neighbour q (normal n = q - p) uses only the
// cascade-0 directions leaving the wall (d·n > 0): E = Σ L(d) (d·n) Δθ, Δθ = π/2. Directions back
// into the wall would see the wall's own glow (no self-lighting). Averaged over open sides; read
// by the next update, so light bounces once per update and settles over a few frames.
[numthreads(8,8,1)]
void Bounce(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!Inside(p)) return;
    float4 scene = _Scene[p];
    if (scene.a < 0.99 || any(scene.rgb > 0)) { _BounceOut[p] = 0; return; }   // walls only
    const int2 sides[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };
    float3 sum = 0; float count = 0;
    for (int i = 0; i < 4; i++)
    {
        int2 q = p + sides[i];
        if (!Inside(q) || _Scene[q].a >= 0.99) continue;
        float3 e = 0;
        for (int k = 0; k < 4; k++)
        {
            float angle = (k + 0.5) / 4 * TAU;
            float c = dot(float2(cos(angle), sin(angle)), float2(sides[i]));
            if (c > 0) e += _Cascade0[q * 2 + int2(k % 2, k / 2)].rgb * c * (TAU / 4);
        }
        sum += e; count++;
    }
    _BounceOut[p] = float4(count > 0 ? sum / count * (_Albedo * 0.5) : 0, 1);
}

// Isolate transient emission while preserving the static scene's absorption.
[numthreads(8,8,1)]
void TransientScene(uint3 id : SV_DispatchThreadID)
{
    if (!Inside(int2(id.xy))) return;
    _TransientScene[id.xy] = float4(0, 0, 0, _Scene[id.xy].a);
}

[numthreads(8,8,1)]
void CombineDirect(uint3 id : SV_DispatchThreadID)
{
    if (!Inside(int2(id.xy))) return;
    _Fluence[id.xy] = float4(_StaticFluence[id.xy].rgb + _DirectFluence[id.xy].rgb, 1);
}
