    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041C\u043E\u0434\u044B \u0438\u043B\u0438 \u0438\u0433\u0440\u043E\u0432\u044B\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F.\n\u0418\u0441\u0445\u043E\u0434\u043D\u0430\u044F
    \u043A\u043E\u043F\u0438\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F;
    \u043C\u043E\u0434\u044B \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
