// The light around the camera (LevelLightView): the level's direct light cropped to the camera area, actor shadows
// taken out of their lamps' own direct light (background), muzzle flashes added for one frame.
#pragma kernel SubtractField
#pragma kernel AddFlash
#pragma kernel ResolveGridFill
#pragma kernel CopyDirect
#pragma kernel CopyDetailed
#pragma kernel ResolveDetailed
#pragma kernel AddWorldLight

RWTexture2D<float4> _Front;           // what actors and props receive (flashes, no shadows)
RWTexture2D<float4> _Back;            // what walls and the background receive (with actor shadows)
Texture2D<float4> _FieldIn;           // a source's direct field, aligned to the level grid at _FieldOrigin
Texture2D<float4> _Mask;              // projected shadow mask of that source over the area (alpha)
Texture2D<float4> _Fill;              // reconstructed world fill, aligned to the same fine grid as the direct sum
Texture2D<float4> _DirectIn;          // FP32 additive sum; the camera buffers remain FP16
int2 _AreaOrigin,_FieldOrigin,_FieldSize;
int2 _AreaSize;
float _FillGain;
SamplerState sampler_linear_clamp;
int2 _OutputSize;
float4 _OutputRect,_WorldRect;
float4 _DynamicRect;
float4 _DynamicCone,_DynamicPosition;
float _DynamicGain;
int4 _Clip;                           // area-local x0, y0, x1, y1 (exclusive)

[numthreads(8,8,1)]
void CopyDirect(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_AreaSize)))return;
    float4 value=_DirectIn[int2(id.xy)+_AreaOrigin];
    _Front[id.xy]=value;_Back[id.xy]=value;
}

bool FieldTexel(int2 p,out int2 f)
{
    f=p+_AreaOrigin-_FieldOrigin;
    return all(f>=0) && all(f<_FieldSize);
}
[numthreads(8,8,1)]
void SubtractField(uint3 id:SV_DispatchThreadID)
{
    int2 p=_Clip.xy+int2(id.xy);int2 f;
    if(any(p>=_Clip.zw) || !FieldTexel(p,f)) return;
    _Back[p]=float4(max(0,_Back[p].rgb-_FieldIn[f].rgb*saturate(_Mask[p].a)),1);
}
[numthreads(8,8,1)]
void AddFlash(uint3 id:SV_DispatchThreadID)
{
    int2 p=_Clip.xy+int2(id.xy);int2 f;
    if(any(p>=_Clip.zw) || !FieldTexel(p,f)) return;
    float3 flash=_FieldIn[f].rgb;
    _Front[p]=float4(_Front[p].rgb+flash,1);
    _Back[p]=float4(_Back[p].rgb+flash*(1-saturate(_Mask[p].a)),1);
}
float3 SoftKnee(float3 direct)
{
    direct=max(0,direct);
    return min(direct,1)+(1-exp(-max(0,direct-1)));
}
[numthreads(8,8,1)]
void ResolveGridFill(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_AreaSize)))return;
    int2 p=int2(id.xy);
    float3 fill=max(0,_Fill[p+_AreaOrigin].rgb)*_FillGain;
    // Each source's mask has already removed only that source's RGB. Other sources and fill survive.
    // A transient flash contributes direct light only: it never writes the world fill.
    _Front[p]=float4(max(SoftKnee(_Front[p].rgb),fill),1);
    _Back[p]=float4(max(SoftKnee(_Back[p].rgb),fill),1);
}

[numthreads(8,8,1)]
void CopyDetailed(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_OutputSize)))return;
    float4 value=float4(max(0,_DirectIn[id.xy].rgb),1);
    _Front[id.xy]=value;_Back[id.xy]=value;
}
[numthreads(8,8,1)]
void ResolveDetailed(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=uint2(_OutputSize)))return;
    float2 world=_OutputRect.xy+(float2(id.xy)+.5)/_OutputSize*_OutputRect.zw;
    float2 uv=(world-_WorldRect.xy)/_WorldRect.zw;
    float3 fill=max(0,_Fill.SampleLevel(sampler_linear_clamp,uv,0).rgb)*_FillGain;
    _Front[id.xy]=float4(max(SoftKnee(_Front[id.xy].rgb),fill),1);
    _Back[id.xy]=float4(max(SoftKnee(_Back[id.xy].rgb),fill),1);
}
[numthreads(8,8,1)]
void AddWorldLight(uint3 id:SV_DispatchThreadID)
{
    int2 p=_Clip.xy+int2(id.xy);if(any(p>=_Clip.zw))return;
    float2 world=_OutputRect.xy+(float2(p)+.5)/_OutputSize*_OutputRect.zw;
    float2 uv=(world-_DynamicRect.xy)/_DynamicRect.zw;
    float angularWeight=1;
    if(dot(_DynamicCone.xy,_DynamicCone.xy)>.5)
    {
        float2 delta=world-_DynamicPosition.xy;
        float distanceSquared=dot(delta,delta);
        if(distanceSquared>.000001)
            angularWeight=smoothstep(_DynamicCone.z,_DynamicCone.w,dot(_DynamicCone.xy,delta*rsqrt(distanceSquared)));
    }
    if(angularWeight<=0)return;
    float3 value=_FieldIn.SampleLevel(sampler_linear_clamp,uv,0).rgb*(_DynamicGain*angularWeight);
    _Front[p]=float4(_Front[p].rgb+value,1);
    _Back[p]=float4(_Back[p].rgb+value*(1-saturate(_Mask[p].a)),1);
}
