    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432: 4. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u043A\u043E\u043F\u0438\u044E \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F.\n\u0414\u0440\u0443\u0433\u0438\u0435
    \u0432\u0435\u0442\u0432\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F;
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430
    \u043D\u0435\u0442."
