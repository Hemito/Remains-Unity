    m_Localized: "\u4E00\u79CD\u5728\u6218\u4E89\u671F\u95F4\u7531\u9A6C\u56FD\u673A\u68B0\u516C\u53F8\u8BBE\u8BA1\u7684\u6218\u6597\u673A\u5668\u9A6C\uFF0C\u88AB\u7528\u4E8E\u4FDD\u62A4\u6700\u91CD\u8981\u7684\u519B\u4E8B\u3001\u653F\u5E9C\u548C\u79C1\u9A6C\u8BBE\u65BD\uFF0C\u540C\u65F6\u4E5F\u7528\u4E8E\u524D\u7EBF\u4F5C\u6218\u3002\u8FD9\u662F\u4E00\u4E2A\u771F\u6B63\u7684\u5766\u514B\uFF0C\u6BD4\u5C0F\u9A6C\u8981\u5927\u5F97\u591A\uFF0C\u9760\u7740\u56DB\u4E2A\u8F6E\u5B50\u79FB\u52A8\u3002\u5B83\u88C5\u5907\u6709\u597D\u51E0\u79CD\u91CD\u578B\u6B66\u5668\uFF0C\u50CF\u901F\u5C04\u673A\u67AA\uFF0C\u5BFC\u5F39\u53D1\u5C04\u5668\u548C\u9B54\u80FD\u67AA\u68B0\u3002\u662F\u6781\u5176\u5371\u9669\u7684\u654C\u9A6C\u3002"
