  - m_Id: 2729436480
    m_Localized: "\u5982\u679C\u542F\u7528\u8FD9\u4E2A\u9009\u9879\uFF0C\u6E38\u620F\u5F00\u59CB\u65F6\uFF0C\u753B\u9762\u5C06\u88AB\u7F29\u653E\u5230100%\uFF0C\u53EF\u4EE5\u7528\u6EDA\u8F6E\u8C03\u6574\u7F29\u653E\u3002\u5982\u679C\u7981\u7528\uFF0C\u7F29\u653E\u6BD4\u4F8B\u5C06\u4F1A\u662F\u5C06\u623F\u95F4\u586B\u6EE1\u5C4F\u5E55\u3002\n\t\u5982\u679C\u4F60\u7684\u663E\u793A\u5668\u662F\u5168\u9AD8\u6E05\u5C4F\uFF081920x1080\uFF09\u6216\u8005\u66F4\u9AD8\uFF0C\u8BF7\u542F\u7528\u6B64\u9009\u9879.\n\t\u5982\u679C\u663E\u793A\u5668\u5206\u8FA8\u7387\u8F83\u4F4E\uFF0C\u5219\u5EFA\u8BAE\u7981\u7528\u6B64\u9009\u9879\uFF0C\u4EE5\u6B64\u6765\u51CF\u5C11\u786C\u4EF6\u8D1F\u8377\u5E76\u63D0\u9AD8\u6E38\u620F\u6027\u80FD\u3002\n\t\u4F60\u53EF\u4EE5\u5728\u6E38\u620F\u91CC\u9762\u6309@1\u6765\u6539\u53D8\u7F29\u653E\u3002\u5982\u679C\u623F\u95F4\u6CA1\u6709\u586B\u6EE1\u5C4F\u5E55\uFF0C\u4F60\u53EF\u4EE5\u6309\u4F4F@2\u6765\u62D6\u52A8\u89C6\u89D2\u3002"
    m_Metadata:
      m_Items: []
