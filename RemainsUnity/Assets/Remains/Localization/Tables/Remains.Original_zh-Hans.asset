  - m_Id: 2725241068
    m_Localized: "\u673A\u5668\u9A6C\u662F\u5C0F\u9A6C\u56FD\u5927\u6218\u4E4B\u524D\u7684\u79D1\u6280\u9769\u547D\u4EA7\u7269\u3002\u5B83\u4EEC\u4EE3\u8868\u4E86\u6700\u5148\u8FDB\u7684\u9646\u9A6C\u79D1\u6280\u548C\u72EC\u89D2\u517D\u9B54\u6CD5\uFF0C\u5B83\u4EEC\u66FE\u7528\u6765\u8FDB\u884C\u5404\u79CD\u5DE5\u4F5C\uFF0C\u50CF\u5185\u52A1\u7BA1\u7406\uFF0C\u4E5F\u53EF\u4EE5\u662F\u8D22\u4EA7\u4FDD\u62A4\u3002\u5728\u6218\u4E89\u671F\u95F4\uFF0C\u5B83\u4EEC\u7684\u96F6\u4EF6\u5347\u7EA7\uFF0C\u53EF\u4EE5\u7528\u4E8E\u519B\u4E8B\u884C\u52A8\u3002\n\u867D\u7136\u5982\u4ECA\u6CA1\u6709\u5C0F\u9A6C\u751F\u4EA7\u673A\u5668\u9A6C\u4E86\uFF0C\u4F46\u8FD9\u4E9B\u4ECE\u4E0A\u4E2A\u4E16\u7EAA\u7559\u4E0B\u6765\u7684\u673A\u5668\u9A6C\u4ECD\u7136\u6709\u8BB8\u591A\u53EF\u4EE5\u8FD0\u4F5C\u3002\u5927\u90E8\u5206\u90FD\u662F\u6218\u6597\u6216\u5B89\u4FDD\u673A\u5668\u9A6C\uFF0C\u5B83\u4EEC\u7EE7\u7EED\u6267\u884C\u7740\u5185\u7F6E\u7A0B\u5E8F\uFF0C\u968F\u65F6\u51C6\u5907\u5168\u529B\u653B\u51FB\u4EFB\u4F55\u5165\u4FB5\u5B83\u4EEC\u7BA1\u7406\u8303\u56F4\u7684\u95EF\u5165\u8005\u3002"
    m_Metadata:
      m_Items: []
