    m_Localized: "\u4E00\u4E2A\u54D4\u54D4\u5C0F\u9A6C\u7684\u533B\u7597\u6A21\u5757\u7684\u9644\u52A0\u6A21\u7EC4\u3002\u5B83\u4F1A\u4E00\u76F4\u76D1\u89C6\u4F60\u7684\u5065\u5EB7\u72B6\u6001\uFF0C\u5E76\u5728\u6709\u751F\u547D\u5782\u5371\u65F6\u81EA\u52A8\u4F7F\u7528\u533B\u7597\u9B54\u6CD5\uFF0C\u786E\u4FDD\u4F7F\u7528\u8005\u53D7\u5230\u4E25\u91CD\u4F24\u5BB3\u5374\u4E0D\u81F3\u4E8E\u6B7B\u4EA1\uFF0C\u4FDD\u6301\u826F\u597D\u72B6\u6001\u3002\u4F46\u6BCF\u6B21\u4F7F\u7528\u540E\u90FD\u9700\u8981\u957F\u65F6\u95F4\u7684\u5145\u80FD\u3002"
    m_Metadata:
