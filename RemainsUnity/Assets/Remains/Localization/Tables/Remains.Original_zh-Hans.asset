  - m_Id: 2729436362
    m_Localized: "\u9519\u8BEF 0-4570-7f45-a420-ff98\uFF08\u7CFB\u7EDF\u9519\u8BEF\uFF0C\u8BF7\u8054\u7CFB\u7BA1\u7406\u5458\uFF09\n\t\n\u53EF\u80FD\u662F\u7535\u78C1\u8109\u51B2\u5BF9\u54D4\u54D4\u5C0F\u9A6C\u7CFB\u7EDF\u9020\u6210\u4E86\u6545\u969C\u3002\n\t\t\t\t\n\u68C0\u6D4B\u5B50\u7CFB\u7EDF\u548C\u6A21\u7EC4\uFF1A\n\u2022
      \u7528\u6237\u72B6\u6001 - \u4E0D\u53EF\u7528\n\u2022 \u533B\u7597\u6A21\u7EC4
      - \u4E0D\u53EF\u7528\n\u2022 \u5E93\u5B58\u5206\u7C7B - \u4E0D\u53EF\u7528\n\u2022
      \u5236\u56FE\u6A21\u7EC4 - \u4E0D\u53EF\u7528\n\u2022 \u8F85\u52A9\u7784\u51C6\u9B54\u6CD5
      - \u4E0D\u53EF\u7528\n\u2022 \u7528\u6237\u754C\u9762 - \u7981\u7528\n\u2022
      \u6838\u5FC3\u64CD\u4F5C\u7CFB\u7EDF - \u672A\u54CD\u5E94\n\t\n\u8B66\u544A\uFF01\u9700\u8981\u91CD\u65B0\u542F\u52A8\n\n\u7CFB\u7EDF\u91CD\u542F\u4E2D\uFF0C\u8BF7\u7A0D\u540E......."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436363
    m_Localized: "\u8FD9\u662F\u4F60\u7684\u6B66\u5668\u4E0E\u6CD5\u672F\u7684\u5217\u8868\u3002\u65B0\u7684\u4E0E\u672A\u4F7F\u7528\u8FC7\u7684\u6B66\u5668\u4F1A\u7528\u7B26\u53F7
      [\u2629] \u6807\u8BB0\u3002\n\n\u6309[\u9F20\u6807\u5DE6\u952E]\u6765\u88C5\u5907\u60F3\u7528\u7684\u6B66\u5668\u3002\u4E5F\u53EF\u4EE5\u4F7F\u7528[\u9F20\u6807\u6EDA\u8F6E]\u6765\u76F4\u63A5\u5728\u6E38\u620F\u4E2D\u5207\u6362\u6B66\u5668\uFF0C\u65E0\u9700\u6253\u5F00\u5E93\u5B58\u3002\n\u6309[\u9F20\u6807\u53F3\u952E]\u6765\u9690\u85CF\u4F60\u4E0D\u60F3\u4F7F\u7528\u7684\u6B66\u5668\uFF0C\u518D\u6B21\u70B9\u51FB\u53EF\u4EE5\u91CD\u65B0\u663E\u793A\u3002\n\u5C06\u9F20\u6807\u653E\u5728\u5217\u8868\u7269\u54C1\u4E0A\uFF0C\u7136\u540E\u6309[\u5FEB\u6377\u952E]\uFF08[1]-[0]\uFF0C[-]\uFF0C[=]\uFF09\u6765\u5C06\u6B66\u5668\u8BBE\u7F6E\u6216\u8005\u53D6\u6D88\u8BBE\u7F6E\u5728\u6B64\u5FEB\u6377\u952E\u4E0A\u3002\u5728\u6E38\u620F\u4E2D\u6309\u4E0B\u5BF9\u5E94\u7684\u6309\u952E\uFF0C\u53EF\u4EE5\u5FEB\u901F\u5207\u6362\u5230\u6B64\u6B66\u5668\u3002\n\u4F60\u4E5F\u53EF\u4EE5\u628A[\u5FEB\u6377\u952E]\u548C@1\u3002\u952E\u7EC4\u5408\u4F7F\u7528\uFF0C\u8FD9\u6837\u5C31\u53EF\u4EE5\u5C06\u5FEB\u6377\u952E\u6570\u91CF\u4ECE12\u4E2A\u589E\u52A0\u523024\u4E2A\u3002\n\u5C06\u9F20\u6807\u653E\u5728\u8E44\u96F7\u3001\u5730\u96F7\u6216\u8005\u653B\u51FB\u6027\u9B54\u6CD5\u4E0A\uFF0C\u7136\u540E\u6309@2\u6216@3\u6765\u8BBE\u7F6E\u4E3A\u526F\u6B66\u5668\u3002\u8FD9\u6837\u4F60\u5C31\u53EF\u4EE5\u5728\u4EFB\u4F55\u65F6\u5019\u5C06\u5176\u4E0E\u4E3B\u6B66\u5668\u4E00\u8D77\u4F7F\u7528\u3002\u5982\u679C\u6CA1\u6709\u8BBE\u7F6E\u526F\u6B66\u5668\uFF0C\u5462\u4E48\u6700\u540E\u4E00\u4E2A\u9009\u4E2D\u7684\u7206\u70B8\u7269\u5C06\u4F1A\u8BBE\u7F6E\u5728@4\u6765\u4F7F\u7528\uFF0C\u6700\u540E\u4E00\u4E2A\u6CD5\u672F\u5C06\u4F1A\u8BBE\u7F6E\u5728@5\u6765\u4F7F\u7528\u3002\n\u6B64\u5916\uFF0C\u4F60\u8FD8\u53EF\u4EE5\u5C06\u4E00\u4E2A\u4FDD\u62A4\u6027\u9B54\u6CD5\u8BBE\u7F6E\u5728[\u5FEB\u6377\u65BD\u6CD5\u952E]\uFF08\u8BE6\u89C1\u63A7\u5236\u8BBE\u7F6E\uFF09\u7684\u5176\u4E2D\u4E00\u4E2A\u4F4D\u7F6E\uFF0C\u4EE5\u6B64\u4F5C\u4E3A\u5FEB\u6377\u9B54\u6CD5\u3002\u5728\u6E38\u620F\u4E2D\u6309\u5BF9\u5E94\u7684\u952E\u53EF\u4EE5\u7ACB\u5373\u4F7F\u7528\u6240\u8BBE\u7F6E\u7684\u9B54\u6CD5\u800C\u4E0D\u9700\u8981\u88C5\u5907\u5B83\u3002\n\n\u5C4F\u5E55\u53F3\u4FA7\u663E\u793A\u6B66\u5668\u5C5E\u6027\u3002\n\u4F24\u5BB3\uFF1A\u6B66\u5668\u7684\u57FA\u672C\u4F24\u5BB3\uFF08\u62EC\u53F7\u4E2D\u7684\u662F\u8003\u8651\u4E86\u81EA\u8EAB\u5176\u4ED6\u7279\u6027\u4E0E\u52A0\u6210\u7684\u5B9E\u9645\u4F24\u5BB3\uFF0C\u65B9\u62EC\u53F7\u4E2D\u662F\u9730\u5F39\u67AA\u7684\u5355\u53D1\u7684\u5B50\u5F39\u6570\uFF09\n\u6BCF\u79D2\u4F24\u5BB3\uFF1A\u6839\u636E\u4F60\u5168\u90E8\u7279\u6027\u7B97\u7684\u6BCF\u79D2\u4F24\u5BB3\uFF08\u62EC\u53F7\u4E2D\u662F\u8003\u8651\u4E86\u6B66\u5668\u88C5\u586B\u65F6\u95F4\u7684\u6BCF\u79D2\u4F24\u5BB3\uFF09\n\u884C\u52A8\u70B9\u6570\u6D88\u8017\uFF1A\u5728S.A.T.S.\u6A21\u5F0F\u4E2D\u6BCF\u6B21\u653B\u51FB\u7684\u884C\u52A8\u70B9\u6570\u6D88\u8017\uFF08\u62EC\u53F7\u4E2D\u662F\u81EA\u52A8\u6B66\u5668\u5728S.A.T.S.\u4E2D\u653B\u51FB\u7684\u6B21\u6570\uFF09\n\u5C04\u7A0B\uFF1A\u80FD\u786E\u4FDD\u6B66\u5668\u51FB\u4E2D\u76EE\u6807\u7684\u8DDD\u79BB\u3002\u5728\u5B9E\u6218\u4E2D\u8FD9\u4E2A\u503C\u662F\u76F8\u5BF9\u7684\uFF0C\u5B83\u53D6\u51B3\u4E8E\u4F60\u62E5\u6709\u7684\u6B66\u5668\u6280\u80FD\u548C\u5176\u5B83\u5F71\u54CD\u56E0\u7D20\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436364
    m_Localized: "\u8FD9\u662F\u4F60\u7684\u62A4\u7532\u4E0E\u62A4\u7B26\u7684\u5217\u8868\u3002\n\n\u6309[\u9F20\u6807\u5DE6\u952E]\u6765\u7A7F\u4E0A\u6216\u8005\u5378\u4E0B\u62A4\u7532\u3002\n\u5C06\u5149\u6807\u653E\u5728\u5217\u8868\u7269\u54C1\u4E0A\uFF0C\u7136\u540E\u6309[\u5FEB\u6377\u4F7F\u7528\u952E]\uFF08[1]-[0]\uFF0C[-]\uFF0C[=]\uFF09\u6765\u5C06\u62A4\u7532\u5206\u914D\u5728\u8FD9\u4E2A\u952E\u4E0A\uFF0C\u6216\u8005\u53D6\u6D88\u5206\u914D\u3002\u9664\u5F00\u4F60\u6B63\u5728\u88AB\u653B\u51FB\u7684\u65F6\u5019\uFF0C\u5728\u6E38\u620F\u4E2D\u6309\u4E0B\u5BF9\u5E94\u7684\u952E\u53EF\u4EE5\u5FEB\u6377\u7A7F\u4E0A\u6B64\u62A4\u7532\u3002\u4F60\u4E5F\u53EF\u4EE5\u6309@1\u6765\u914D\u5408[\u5FEB\u6377\u4F7F\u7528\u952E]\u7684\u5206\u914D\u4E0E\u4F7F\u7528\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436365
    m_Localized: "\u8FD9\u662F\u4F60\u88C5\u5907\u7684\u5217\u8868\uFF0C\u91CC\u9762\u5305\u62EC\u6240\u6709\u4F60\u53EF\u4EE5\u4F7F\u7528\u7684\u7269\u54C1\uFF0C\u4F8B\u5982\uFF1A\u4FDD\u62A4\u6027\u9B54\u6CD5\u3001\u836F\u7269\u3001\u5316\u5B66\u54C1\u3001\u836F\u6C34\u3001\u98DF\u7269\u3001\u5DE5\u5177\u3001\u4E66\u4EE5\u53CA\u55B7\u6F06\u7F50\u7B49\u3002\n\n\u6309
      [\u9F20\u6807\u5DE6\u952E] \u6765\u4F7F\u7528\u7269\u54C1\u6216\u8005\u88C5\u5907\u4FDD\u62A4\u6027\u9B54\u6CD5
      - \u5982\u679C\u4F60\u6709\uFF08\u88C5\u5907\u7684\u6CD5\u672F\u53EF\u4EE5\u5728\u6E38\u620F\u4E2D\u6309@2\u6765\u4F7F\u7528\uFF09\u3002\n\u5C06\u5149\u6807\u653E\u5728\u5217\u8868\u7269\u54C1\u4E0A\uFF0C\u7136\u540E\u6309[\u5FEB\u6377\u4F7F\u7528\u952E]\uFF08[1]-[0]\uFF0C[-]\uFF0C[=]\uFF09\uFF0C\u6765\u5C06\u7269\u54C1\u5206\u914D\u5728\u8FD9\u4E2A\u952E\u4E0A\uFF0C\u6216\u8005\u53D6\u6D88\u5206\u914D\u3002\u5728\u6E38\u620F\u4E2D\u6309\u4E0B\u5BF9\u5E94\u7684\u952E\u4F60\u5C31\u53EF\u4EE5\u4F7F\u7528\u6B64\u7269\u54C1\u800C\u65E0\u9700\u8FDB\u5165\u5E93\u5B58\u3002\u4F60\u4E5F\u53EF\u4EE5\u6309@1\u6765\u914D\u5408
      [\u5FEB\u6377\u4F7F\u7528\u952E] \u7684\u5206\u914D\u4E0E\u4F7F\u7528\u3002\n\u6B64\u5916\uFF0C\u4F60\u8FD8\u53EF\u4EE5\u901A\u8FC7\u5C06\u4FDD\u62A4\u6027\u9B54\u6CD5\u8BBE\u7F6E\u5728
      [\u5FEB\u6377\u65BD\u6CD5\u69FD]\uFF08\u8BE6\u89C1\u63A7\u5236\u8BBE\u7F6E\uFF09\u5176\u4E2D\u4E4B\u4E00\u7684\u6309\u952E\u4E2D\u3002\u8FD9\u6837\u4F60\u5C31\u53EF\u4EE5\u5FEB\u901F\u4F7F\u7528\u9B54\u6CD5\u800C\u4E0D\u9700\u8981\u53BB\u88C5\u5907\u5B83\u3002\n\n\u65B0\u7269\u54C1\u4F1A\u7528[\u2629]\u6765\u6807\u8BB0\u3002\u6570\u91CF\u65B0\u589E\u52A0\u7684\u7269\u54C1\u4F1A\u7528[+]\u6765\u6807\u8BB0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436366
    m_Localized: "\u8FD9\u4E2A\u5217\u8868\u5305\u542B\u4F60\u6240\u6709\u7684\u5176\u4ED6\u7269\u54C1\uFF0C\u4F8B\u5982\u8D35\u91CD\u7269\u54C1\u3001\u795E\u5668\u3001\u4EFB\u52A1\u7269\u54C1\u3001\u8BBE\u8BA1\u56FE\u3001\u96F6\u4EF6\u8FD8\u6709\u5404\u79CD\u5176\u4ED6\u5783\u573E\u3002\u8FD9\u4E9B\u4E1C\u897F\u8981\u4E48\u88AB\u81EA\u52A8\u4F7F\u7528\uFF0C\u8981\u4E48\u6839\u672C\u7528\u4E0D\u4E0A\uFF0C\u8FD9\u4E9B\u4E1C\u897F\u53EF\u4EE5\u5356\u7ED9\u5546\u9A6C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436367
    m_Localized: "\u8FD9\u662F\u4F60\u6240\u6709\u5F39\u836F\u548C\u7206\u70B8\u7269\u7684\u5217\u8868\u3002\u9002\u5408\u4F60\u6B63\u4F7F\u7528\u7684\u6B66\u5668\u7684\u5F39\u836F\u90FD\u5728\u5217\u8868\u9876\u90E8\u3002\n\n\u6309[\u9F20\u6807\u5DE6\u952E]\u6765\u88C5\u586B\u6240\u9700\u7C7B\u578B\u7684\u5F39\u836F\u3002\u4F60\u53EF\u4EE5\u53EF\u4EE5\u5728\u6E38\u620F\u4E2D\u4F7F\u7528[\u9F20\u6807\u6EDA\u8F6E]\u548C@1\u6765\u5207\u6362\u5F39\u836F\u79CD\u7C7B\u800C\u65E0\u9700\u6253\u5F00\u5E93\u5B58\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436368
    m_Localized: "\u5728\u6709\u9650\u8D1F\u91CD\u7684\u6A21\u5F0F\u4E0B\u5927\u591A\u6570\u7269\u54C1\u90FD\u6709\u91CD\u91CF\u3002\u4F60\u6240\u6709\u7684\u7269\u54C1\u90FD\u5C06\u5206\u7C7B\uFF0C\u5E76\u4E14\u6BCF\u7C7B\u7269\u54C1\u7684\u79CD\u7C7B\u90FD\u662F\u5206\u5F00\u8BA1\u7B97\u7684\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436369
    m_Localized: "[\u6B66\u5668]\n\u4F60\u53EF\u4EE5\u5728\u4EFB\u52A1\u4E2D\u643A\u5E26\u6709\u9650\u91CF\u7684\u6B66\u5668\uFF0C\u5176\u6570\u91CF\u53D6\u51B3\u4E8E\u4F60\u7684
      [\u6B66\u5668\u69FD] \u6570\u91CF\u3002\u540C\u65F6\uFF0C\u5200\u4E0E\u624B\u67AA\u5360\u4E00\u4E2A\u69FD\uFF0C\u6B65\u67AA\u4E0E\u9730\u5F39\u7B49\u5360\u7528\u4E24\u4E2A\u69FD\uFF0C\u5927\u578B\u6B66\u5668\u5360\u7528\u4E09\u4E2A\u69FD\u3002\u8E44\u96F7\u4E0E\u5730\u96F7\u7684\u643A\u5E26\u91CF\u6CA1\u6709\u9650\u5236\u3002\u800C\u5176\u5269\u4E0B\u7684\u6B66\u5668\u53EA\u80FD\u5728\u57FA\u5730\u4F7F\u7528\u3002\n\u5982\u679C\u8981\u653E\u5F03\u4F7F\u7528\u67D0\u4E2A\u7279\u5B9A\u7684\u6B66\u5668\u5E76\u817E\u51FA\u5176\u5360\u7528\u7684\u69FD\u53E3\uFF0C\u53EF\u4EE5\u6309\u5BF9\u5176[\u9F20\u6807\u53F3\u952E]\u3002\u6B66\u5668\u5C06\u8BBE\u7F6E\u4E3A\u9690\u85CF\uFF0C\u5E76\u4E14\u4E0D\u4F1A\u5360\u7528\u6B66\u5668\u69FD\uFF0C\u4F60\u4E5F\u65E0\u6CD5\u4F7F\u7528\u5B83\u3002\u5982\u679C\u4F60\u518D\u6B21\u6361\u8D77\u4E00\u628A\u540C\u6837\u7684\u6B66\u5668\uFF0C\u9690\u85CF\u7684\u6B66\u5668\u5219\u4F1A\u53D8\u4E3A\u53EF\u7528\uFF0C\u6216\u8005\u5F53\u4F60\u56DE\u5230\u8425\u5730\u65F6\u4F7F\u7528\u54D4\u54D4\u5C0F\u9A6C\u6216\u8005\u6B66\u5668\u67B6\u6765\u91CD\u65B0\u83B7\u53D6\u5B83\u3002\n\u4F60\u53EF\u4EE5\u643A\u5E26\u8D85\u51FA\u6B66\u5668\u69FD\u6570\u91CF\u7684\u6B66\u5668\uFF0C\u4F46\u662F\u8FD9\u4F1A\u4F7F\u4F60\u884C\u52A8\u7F13\u6162\uFF0C\u8F7B\u5FAE\u7684\u8D85\u91CD\u4F60\u5C06\u4E0D\u80FD\u5954\u8DD1\u4E0E\u51B2\u523A\uFF0C\u7EE7\u7EED\u8D85\u91CD\u7684\u8BDD\u4F60\u5C31\u80FD\u4E00\u6B65\u6B65\u5730\u8D70\uFF0C\u6700\u7EC8\u4F60\u5C06\u65E0\u6CD5\u79FB\u52A8\u3002\u5728\u57FA\u5730\u4E2D\u4E5F\u4F1A\u51CF\u901F\uFF0C\u9664\u975E\u51CF\u8F7B\u91CD\u91CF\uFF0C\u5426\u5219\u4F60\u54EA\u90FD\u4E0D\u80FD\u53BB\u3002\n\n[\u9B54\u6CD5]\n\u4F60\u53EA\u80FD\u4F7F\u7528\u6709\u6570\u91CF\u7684\u653B\u51FB\u6216\u9632\u5FA1\u6027\u9B54\u6CD5\u3002\u5176\u5B83\u7684\u90FD\u4E0D\u53EF\u4EE5\u4F7F\u7528\u3002\u6BCF\u79CD\u9B54\u6CD5\u90FD\u4F1A\u5360\u636E\u4E00\u4E2A[\u9B54\u6CD5\u69FD]\uFF0C\u5176\u4F59\u7684\u89C4\u5219\u548C\u6B66\u5668\u76F8\u540C\u3002\n\u6BCF\u8D85\u8FC7\u4E00\u4E2A\u6CD5\u672F\u643A\u5E26\u4E0A\u9650\u90FD\u4F1A\u51CF\u5C1125%\u7684\u9B54\u6CD5\u6062\u590D\u901F\u5EA6."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436370
    m_Localized: "[\u62A4\u7532]\n\u4F60\u53EA\u80FD\u7A7F\u4E00\u5957\u62A4\u7532\u53BB\u884C\u52A8\uFF0C\u5176\u4ED6\u7684\u62A4\u7532\u5C06\u88AB\u7559\u5728\u8425\u5730\uFF08\u9664\u5F00\u9632\u62A4\u670D\u4E0E\u8863\u670D\uFF09\u3002\u5728\u4EFB\u4F55\u65F6\u5019\u4F60\u53EA\u80FD\u6362\u6210\u4FDD\u62A4\u6027\u670D\u88C5\u548C\u8863\u670D\uFF0C\u6216\u8005\u6362\u56DE\u62A4\u7532\u3002\n\u62A4\u7B26\u53EF\u4EE5\u968F\u65F6\u66F4\u6362."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436371
    m_Localized: "[\u88C5\u5907]\n\u8FD9\u4E00\u9879\u5305\u62EC\u90A3\u4E9B\u4F60\u5728\u4EFB\u4F55\u65F6\u523B\u90FD\u53EF\u80FD\u7528\u5230\u7684\u6709\u4EF7\u503C\u8FD8\u6709\u6613\u788E\u7684\u7269\u54C1\uFF08\u4E5F\u5305\u62EC\u6218\u6597\u4E2D\uFF09\uFF0C\u8FD9\u4E5F\u662F\u4E3A\u4EC0\u4E48\u7269\u54C1\u5206\u7C7B\u628A\u5B83\u4EEC\u653E\u5728\u5355\u72EC\u7684\u5305\u4E2D\uFF1A\u836F\u7269\u3001\u836F\u6C34\u3001\u5316\u5B66\u6B66\u5668\u3001\u9690\u5F62\u5C0F\u9A6C\u3001\u4FEE\u7406\u5305\u4EE5\u53CA\u7B26\u6587\u7B49\u3002\u6BCF\u4E00\u79CD\u7269\u54C1\u90FD\u6709\u81EA\u5DF1\u7279\u6709\u7684[\u91CD\u91CF]\uFF0C\u90FD\u4F1A\u663E\u793A\u6240\u5360\u7528\u7684\u5E93\u5B58\u7A7A\u95F4\u3002\n\u5982\u679C\u4F60\u8D85\u989D\u643A\u5E26\u8FD9\u4E9B\u4E1C\u897F\uFF0C\u90A3\u4E48\u5728\u4F60\u53D7\u5230\u4F24\u5BB3\u65F6\u5B83\u4EEC\u53EF\u80FD\u6BC1\u574F\uFF0C\u6216\u8005\u662F\u4ECE\u80CC\u5305\u4E2D\u6389\u51FA\u53BB\u3002\n[\u5F39\u836F]\n\u8FD9\u4E00\u9879\u5305\u62EC\u6240\u6709\u7684\u5F39\u836F\u3001\u7535\u6C60\u8FD8\u6709\u7206\u70B8\u7269\u3002\u7531\u4E8E\u5176\u5371\u9669\u6027\uFF0C\u800C\u4E14\u90FD\u5FC5\u987B\u80FD\u591F\u5FEB\u901F\u7ED9\u6B66\u5668\u88C5\u586B\uFF0C\u6240\u6709\u7269\u54C1\u5206\u7C7B\u628A\u5B83\u4EEC\u653E\u5728\u4E86\u5F39\u836F\u888B\u91CC\u3002\u5B83\u4EEC\u4E0D\u80FD\u4E0E\u5176\u5B83\u4E1C\u897F\u6DF7\u5728\u4E00\u8D77\u3002\n[\u5783\u573E]\n\u4F60\u80CC\u5305\u7C7B\u7684\u5176\u5B83\u4E1C\u897F\u5C06\u88AB\u5206\u5230\u201C\u5783\u573E\u201D\u8FD9\u4E00\u7C7B\u3002\u8FD9\u4E00\u7C7B\u5305\u542B\u4E86\u6240\u6709\u90A3\u4E9B\u4F60\u5E76\u4E0D\u662F\u7ECF\u5E38\u8981\u7528\u7684\u4E1C\u897F\uFF0C\u4E0D\u8BBA\u5B83\u4EEC\u662F\u98DF\u7269\u3001\u996E\u6599\u3001\u4E66\u7C4D\u3001\u8BB0\u5FC6\u7403\u3001\u7528\u4E8E\u51FA\u552E\u7684\u7269\u54C1\u3001\u6B66\u5668\u96F6\u4EF6\u3001\u88C5\u7532\u677F\u8FD8\u662F\u836F\u5242\u6210\u5206\u3002\u98DF\u7269\u4E0E\u996E\u6599\u53EF\u4EE5\u968F\u65F6\u98DF\u7528\uFF0C\u4F46\u662F\u4F60\u5FC5\u987B\u56DE\u5230\u57FA\u5730\u6765\u770B\u4E66\u6216\u8005\u662F\u8BB0\u5FC6\u7403\uFF0C\u56E0\u4E3A\u4F7F\u7528\u8FD9\u4E9B\u4E1C\u897F\u9700\u8981\u65F6\u95F4\u548C\u5B89\u5168\u7684\u5730\u65B9\u3002\n\u5F39\u836F\u4E0E\u5783\u573E\u643A\u5E26\u8FC7\u591A\u4F1A\u50CF\u6B66\u5668\u4E00\u6837\u51CF\u6162\u4F60\u7684\u901F\u5EA6\u3002\u5E93\u5B58\u4E2D\u4E0D\u540C\u5206\u9879\u7684\u91CD\u91CF\u4F1A\u53E0\u52A0\u8BA1\u7B97\u3002\n[\u5176\u4ED6\u7269\u54C1]\n\u6240\u6709\u4E0D\u8BA1\u7B97\u91CD\u91CF\u7684\u7269\u54C1\u3002\u4EFB\u52A1\u7269\u54C1\u3001\u94A5\u5319\u8FD8\u6709\u5DE5\u5177\uFF08\u5982\u87BA\u4E1D\u5200\uFF09\u3001\u54D4\u54D4\u5C0F\u9A6C\u7684\u690D\u5165\u6A21\u7EC4\u3001\u795E\u5668\u3001\u8BBE\u8BA1\u56FE\u3001\u55B7\u6F06\u7F50\u7B49\u3002\u5B83\u4EEC\u5728\u5E93\u5B58\u4E2D\u4E0D\u4F1A\u5F71\u54CD\u5B58\u653E\u7A7A\u95F4\uFF0C\u4E5F\u4E0D\u80FD\u88AB\u653E\u5230\u50A8\u7269\u7BB1\u6216\u8005\u4E22\u5F03\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436372
    m_Localized: "\u8FD9\u662F\u4E16\u754C\u5730\u56FE\uFF0C\u4E0A\u9762\u4F1A\u663E\u793A\u4F60\u53EF\u4EE5\u53BB\u7684\u5730\u65B9\u3002\u5730\u70B9\u6709\u4EE5\u4E0B\u79CD\u7C7B\uFF1A\n[\u57FA\u5730]
      - \u4F60\u65E0\u9700\u6218\u6597\u7684\u5730\u65B9\uFF0C\u4F60\u53EF\u4EE5\u5728\u8FD9\u91CC\u4EA4\u6613\u3001\u6CBB\u7597\u6216\u662F\u63A5\u53D7\u4EFB\u52A1\u3002\n[\u4E00\u822C\u5730\u70B9]
      - \u4F60\u53EF\u4EE5\u63A2\u7D22\u4E00\u6B21\uFF0C\u6240\u6709\u654C\u9A6C\u4E0E\u7269\u54C1\u4E0D\u4F1A\u5237\u65B0\u3002\u5B8C\u6210\u4E86\u8FD9\u79CD\u5730\u65B9\u7684\u4E3B\u8981\u76EE\u6807\u540E\uFF0C\u5B83\u4EEC\u5C06\u88AB\u6807\u8BB0\u4E3A\u201C\u5DF2\u6E05\u7A7A\u201D\u3002\u4F46\u4F60\u8FD8\u662F\u53EF\u4EE5\u968F\u65F6\u91CD\u8FD4\u8FD9\u4E9B\u5730\u70B9\u63A2\u7D22\u6B8B\u4F59\u7684\u5BB9\u5668\u6216\u8005\u79D8\u5BC6\u5730\u70B9\u3002\n[\u5237\u65B0\u5730\u70B9]
      - \u53EF\u4EE5\u591A\u6B21\u63A2\u7D22\u4E0E\u6E05\u7406\uFF0C\u4EE5\u6B64\u6765\u83B7\u5F97\u7ECF\u9A8C\u4E0E\u7269\u54C1\u3002\u4F60\u6BCF\u6B21\u91CD\u65B0\u8FDB\u5165\u65F6\uFF0C\u5B83\u4EEC\u4F1A\u751F\u6210\u65B0\u7684\u751F\u7269\u4E0E\u654C\u9A6C\uFF0C\u5BB9\u5668\u4E5F\u4F1A\u5237\u65B0\u65B0\u7684\u7269\u54C1\u5728\u5185\u3002\u540C\u65F6\uFF0C\u5237\u65B0\u5730\u70B9\u4F1A\u751F\u6210\u4E00\u4E9B[\u8BD5\u70BC\u623F\u95F4]\u3002\u5B8C\u6210\u8FD9\u4E9B\u8BD5\u70BC\u4F60\u53EF\u4EE5\u83B7\u5F97\u7A00\u6709\u7269\u54C1\uFF0C\u8BB8\u591A[\u4EFB\u52A1\u7269\u54C1]\u80FD\u5728\u5176\u4E2D\u627E\u5230\u3002\n\u5927\u90E8\u5206\u5237\u65B0\u5730\u70B9\u90FD\u6709[\u7B49\u7EA7]\u3002\u5728\u9AD8\u7B49\u7EA7\u7684\u5730\u70B9\u4F60\u53EF\u4EE5\u78B0\u5230\u4E00\u4E9B\u6709\u8DA3\u7684\u65B0\u5730\u56FE\u3001\u654C\u9A6C\u8FD8\u6709\u8BD5\u70BC\uFF0C\u4E5F\u5305\u62EC\u901A\u5F80\u65B0\u5730\u70B9\u7684\u8DEF\u3002\u5982\u679C\u60F3\u8981\u8FDB\u5165\u4E0B\u4E00\u7B49\u7EA7\u7684\u5730\u70B9\uFF0C\u4F60\u5FC5\u987B\u62B5\u8FBE\u8FD9\u4E2A\u5730\u70B9\u7684\u5E95\u7AEF\uFF0C\u5E76\u4E14\u8FDB\u5165\u6709[\u51FA\u53E3]\u6807\u793A\u7684\u95E8\u3002\u4E00\u822C\u6765\u8BF4\uFF0C\u4F60\u81F3\u5C11\u9700\u8981\u8FBE\u5230\u5730\u70B9\u76842-3\u7EA7\u624D\u80FD\u8FDB\u4E00\u6B65\u63A8\u8FDB\u6545\u4E8B\u53D1\u5C55\u3002\u6B64\u5916\uFF0C\u4F60\u81F3\u5C11\u8981\u6E05\u7406\u638925%\u7684\u654C\u9A6C\u624D\u80FD\u8BA9\u57FA\u5730\u7684\u5546\u9A6C\u91CD\u65B0\u8865\u8D27\u3002\n\u4F60\u53EF\u4EE5\u901A\u8FC7\u4F7F\u7528\u57FA\u5730\u5899\u4E0A\u7684\u5730\u56FE\u6216\u662F\u4F60\u7684\u54D4\u54D4\u5C0F\u9A6C\u4E0A\u7684\u5730\u56FE\u6765\u53BB\u4EFB\u4F55\u5F53\u524D\u53EF\u4EE5\u53BB\u7684\u5730\u70B9\u3002\u5982\u679C\u4F60\u4ECE\u5237\u65B0\u5730\u70B9\u4F20\u9001\u56DE\u4E86\u57FA\u5730\uFF0C\u90A3\u4E48\u4F7F\u7528[MAS\u7EC8\u7AEF\u673A]\u5219\u53EF\u4F7F\u4F60\u8FD4\u56DE\u81F3\u4E0A\u4E00\u5730\u70B9\u3002\u5982\u679C\u4F60\u4F7F\u7528\u5730\u56FE\u8FD4\u56DE\uFF0C\u90A3\u4E48\u5730\u70B9\u5C06\u4F1A\u91CD\u65B0\u5237\u65B0\u751F\u6210\u3002\n\u6CE8\u610F\uFF0C\u5982\u679C\u4F60\u5728\u4E00\u4E2A\u751F\u6210\u5730\u70B9\u4FDD\u5B58\u4E86\u6E38\u620F\uFF0C\u90A3\u4E48\u4F60\u518D\u6B21\u52A0\u8F7D\u6B64\u5B58\u6863\u65F6\u4F60\u5C06\u56DE\u5230\u57FA\u5730\uFF01\u5176\u5730\u70B9\u751F\u6210\u5185\u5BB9\u4E0D\u4F1A\u4FDD\u5B58\uFF0C\u53EA\u4F1A\u4FDD\u5B58\u5DF2\u7ECF\u62B5\u8FBE\u7684\u6700\u5927\u5730\u70B9\u7B49\u7EA7\u4E0E\u5DF2\u7ECF\u5B8C\u6210\u7684\u8BD5\u70BC\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436373
    m_Localized: "\u4F60\u53EF\u4EE5\u5728\u6E38\u620F\u4E2D\u4FDD\u5B58\u6E38\u620F\u81F3\u5B58\u6863\u69FD\uFF0810\u4E2A\u5B58\u6863\u69FD
      + 1\u4E2A\u81EA\u52A8\u5B58\u6863\u69FD\uFF09\u6216\u4FDD\u5B58\u5230\u6587\u6863\u4E2D\u3002\n\u4FDD\u5B58\u6E38\u620F\u7684\u5B58\u6863\u6587\u4EF6\u53EF\u4EE5\u8BA9\u4F60\u5907\u4EFD\u6E38\u620F\u5B58\u6863\u6216\u662F\u5728\u4E0D\u540C\u7248\u672C\u7684\u6E38\u620F\u4E2D\u4F7F\u7528\u3002\u5982\u8981\u4FDD\u5B58\u5B58\u6863\u6587\u4EF6\uFF0C\u53EF\u4EE5\u5728[\u4FDD\u5B58]\u680F\u4E2D\u9009\u62E9\u4FDD\u5B58\u5B58\u6863\u6309\u94AE\n\n[\u6CE8\u610F\uFF01\u91CD\u8981\u63D0\u9192\uFF01]\n\u5404\u7C7B\u78C1\u76D8\u6E05\u7406\u7A0B\u5E8F\u53EF\u80FD\u5220\u9664\u5B58\u6863\u69FD\u7684\u5B58\u6863\uFF01\u5982\u679C\u4F60\u6B63\u5728\u4F7F\u7528\u7C7B\u4F3C\u7684\u7A0B\u5E8F\uFF0C\u53EF\u4EE5\u901A\u8FC7\u70B9\u51FB[\u5BFC\u51FA\u5B58\u6863]\u6765\u5907\u4EFD\u5B58\u6863\u6587\u4EF6\uFF0C\u5E76\u4F7F\u7528[\u8F7D\u5165]\u4E2D\u7684[\u52A0\u8F7D\u5B58\u6863]\u6309\u94AE\u6765\u52A0\u8F7D\u4FDD\u5B58\u7684\u5B58\u6863\u6587\u4EF6\u3002\n\u4E5F\u5EFA\u8BAE\u4F60\u5B9A\u671F\u4FDD\u5B58\u6E38\u620F\u7684\u5B58\u6863\u6587\u4EF6\uFF0C\u4EE5\u9632\u4E07\u4E00\u3002"
    m_Metadata:
      m_Items: []
