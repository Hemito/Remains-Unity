  - m_Id: 2725241090
    m_Localized: "\u673A\u5668\u5C0F\u9A6C\uFF0C\u524D\u5C0F\u9A6C\u56FD\u79D1\u6280\u7684\u7ED3\u6676\uFF0C\u662F\u5728\u5BA1\u5224\u65E5\u524D\u4E0D\u4E45\u521B\u9020\u51FA\u6765\u7684\u3002\u6700\u521D\u7684\u8BBE\u8BA1\u6A21\u578B\u672C\u662F\u6BD4\u8F83\u548C\u5E73\u7684\u4E00\u79CD\uFF0C\u4F46\u51E0\u4E4E\u7ACB\u523B\u5C31\u88AB\u88C5\u4E0A\u6700\u65B0\u7684\u6B66\u5668\uFF0C\u80FD\u91CF\u5C4F\u969C\uFF0C\u751A\u81F3\u4E00\u4E9B\u9B54\u6CD5\u4E86\u3002\u7531\u4E8E\u5176\u6781\u7AEF\u7684\u590D\u6742\u6027\u548C\u6210\u672C\u95EE\u9898\uFF0C\u5B83\u4EEC\u6CA1\u6709\u5B9E\u9645\u88AB\u6295\u5165\u5728\u6218\u6597\u4E2D\u4F7F\u7528\uFF0C\u53EA\u88AB\u4F5C\u4E3A\u90A3\u4E9B\u5BCC\u6709\u7684\u548C\u6709\u5F71\u54CD\u529B\u7684\u9A6C\u7684\u8B66\u536B\u548C\u52A9\u7406\uFF0C\u5B83\u4EEC\u5C31\u50CF\u4E00\u4E2A\u771F\u6B63\u7684\u5C0F\u9A6C\u4E00\u6837\u3002\u73B0\u5728\u6B8B\u5B58\u7684\u673A\u5668\u5C0F\u9A6C\u4EEC\u4F3C\u4E4E\u5DF2\u7ECF\u5931\u53BB\u4E86\u5B83\u4EEC\u6700\u540E\u7684\u667A\u6167\u82AF\u7247\uFF0C\u5E76\u6210\u4E3A\u4E86\u76F8\u5F53\u5927\u7684\u5A01\u80C1\u3002"
    m_Metadata:
      m_Items: []
