      m_Items: []
  - m_Id: 2729436197
    m_Localized: Panzerbrechend (AP)
    m_Metadata:
      m_Items: []
  - m_Id: 2729436198
    m_Localized: "Panzerbrechende Kugeln sind spezielle Projektile mit hartem Kern
      und einer weichen Mantel, die zum Durchschlagen von R\xFCstungen entwickelt
      wurde. Solche Projektile sind jedoch weniger wirksam gegen ungesch\xFCtzte
      Ziele und haben eine schlechtere Bremswirkung"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436199
    m_Localized: Weiche Geschosse
    m_Metadata:
      m_Items: []
  - m_Id: 2729436200
    m_Localized: "Weiche Geschosse sind Projektile, die sich verformen, wenn sie
      auf ein weiches Ziel wie einen K\xF6rper treffen. Solche Projektile richten
      mehr Schaden bei ungesch\xFCtzten Zielen an, jedoch k\xF6nnen sie dadurch Panzerungen
      nur schlecht durchdringen und sind daher gegen gepanzerte Ziele ungeeignet"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436201
    m_Localized: Panzerbrechend
    m_Metadata:
      m_Items: []
  - m_Id: 2729436202
    m_Localized: "Diese Munition verwendet anstelle eines normalen Projektils 5 pfeilf\xF6rmige
      Geschosse verwendet, die sich zum Durchschlagen von R\xFCstungen eignen, aber
      eine geringere Bremswirkung haben"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436203
    m_Localized: Brandmunition
    m_Metadata:
      m_Items: []
  - m_Id: 2729436204
    m_Localized: "Patronen mit magisch verzauberten Kugeln, die das Ziel beim Aufprall
      entz\xFCnden"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436205
    m_Localized: Magisch
    m_Metadata:
      m_Items: []
  - m_Id: 2729436206
    m_Localized: "Patronen mit denen magische Energietechnologie mit herk\xF6mmlichen
      Schusswaffen genutzt werden kann. Beim Auftreffen auf ein Ziel verwandelt sich
      die Kugel in Plasma"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436207
    m_Localized: "\xDCberladung"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436208
    m_Localized: "Eine Batterie mit h\xF6herer Leistung. Verbessert den Schaden und
      gibt der Waffe die F\xE4higkeit, R\xFCstungen zu verbrennen, aber die Waffe
      nutzt sich dadurch schneller ab"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436209
    m_Localized: Optimierter Brennstoff
    m_Metadata:
      m_Items: []
  - m_Id: 2729436210
    m_Localized: "Brennstoff mit speziellen Zus\xE4tzen, welche die Brenntemperatur
      deutlich erh\xF6hen"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436211
    m_Localized: Plasma
    m_Metadata:
      m_Items: []
  - m_Id: 2729436212
    m_Localized: "Eine m\xE4chtigere magische Ausf\xFChrung f\xFCr Granaten"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436213
    m_Localized: Puls
    m_Metadata:
      m_Items: []
  - m_Id: 2729436214
    m_Localized: "Granate mit einer Impulsladung f\xFCr den Kampf gegen Roboter"
    m_Metadata:
      m_Items: []
