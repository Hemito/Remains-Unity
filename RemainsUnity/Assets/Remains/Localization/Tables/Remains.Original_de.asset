    m_Metadata:
      m_Items: []
  - m_Id: 2729435944
    m_Localized: "Zerst\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435945
    m_Localized: "@1 - Ziel ausw\xE4hlen@@2 - abbrechen ausw\xE4hlen, verlassen@@3
      oder @4 - annehmen"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435946
