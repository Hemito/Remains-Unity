      m_Items: []
  - m_Id: 2733629459
    m_Localized: "Achtung! Schwere Verletzung erlitten. \xC4rztliche hilfe erforderlich"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629460
    m_Localized: Achtung! Mehrere schwere Verletzungen festgestellt. Kritischer medizinischer
      Zustand. Ein sofortiger Krankenhausaufenthalt ist erforderlich
    m_Metadata:
      m_Items: []
  - m_Id: 2733629461
    m_Localized: "Verletzungen mit denen du nicht \xFCberleben kannst, Ruhe in Frieden,
      @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629462
    m_Localized: Achtung! Geringer Blutverlust festgestellt
    m_Metadata:
      m_Items: []
  - m_Id: 2733629463
    m_Localized: Achtung! Schwerer Blutverlust festgestellt
    m_Metadata:
      m_Items: []
  - m_Id: 2733629464
    m_Localized: Achtung! Sehr schwerer Blutverlust. Kritischer medizinischer Zustand
    m_Metadata:
      m_Items: []
  - m_Id: 2733629465
    m_Localized: Benutzer verblutet, Ruhe in Frieden, @1
    m_Metadata:
      m_Items: []
  - m_Id: 2733629466
    m_Localized: "Geringe magische Ersch\xF6pfung"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629467
    m_Localized: "Achtung! Starke magische Ersch\xF6pfung"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629468
    m_Localized: "Achtung! Deine Magie ist ersch\xF6pft. Weiteres Zaubern nicht mehr
      m\xF6glich"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629469
    m_Localized: Achtung! Du wurdest vergiftet!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629470
    m_Localized: Achtung! Du blutest!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629471
    m_Localized: "Du bist ein wenig s\xFCchtig nach @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629472
    m_Localized: "Deine Sucht nach @1 ist st\xE4rker geworden"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629473
    m_Localized: "Du bist vollkommen s\xFCchtig nach @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629474
    m_Localized: 'Begleiter gerufen: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629475
    m_Localized: 'Begleiter entlassen: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629476
    m_Localized: Begleiter wird wiedergeboren
    m_Metadata:
      m_Items: []
  - m_Id: 2733629477
    m_Localized: "Aktion nicht verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629478
    m_Localized: Robo Eule muss repariert werden
    m_Metadata:
      m_Items: []
  - m_Id: 2733629479
    m_Localized: "@1 gestorben. Zeit bis f\xFCr Wiederbelebung - @2 Sekunden"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629480
    m_Localized: '@1 zusammengebrochen'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629481
    m_Localized: "@1 kehrt zu dir zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629482
    m_Localized: Ich kann hier keinen Begleiter herbeirufen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629483
    m_Localized: Dein Begleiter wird dir hier nicht folgen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629484
    m_Localized: "Pr\xFCfung \"@1\" vollendet"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629485
    m_Localized: Muss an einem sicheren Ort erfolgen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629486
    m_Localized: "H\xE4ndler haben jetzt neue Waren zum Verkauf"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629487
    m_Localized: "Ausl\xF6ser [@1] = @2"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629488
    m_Localized: "Schwierigkeitsgrad ge\xE4ndert: \"@1\""
    m_Metadata:
      m_Items: []
  - m_Id: 2733629489
    m_Localized: 'Gegenstand erforderlich: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629490
    m_Localized: 'Gegenstand benutzt: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629491
    m_Localized: Kann nur Sprengstoffe oder Zaubers zuweisen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629492
    m_Localized: "Nur f\xFCr Verteidigungszauber"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629493
    m_Localized: "Zauber nicht verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629494
    m_Localized: Waffe entfernt
    m_Metadata:
      m_Items: []
  - m_Id: 2733629495
    m_Localized: Lasse deine Sachen nicht im Basislager herumliegen, benutze das
      Lager
    m_Metadata:
      m_Items: []
  - m_Id: 2733629496
    m_Localized: "Es w\xE4re besser diesen Gegenstand aufzubewahren"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629497
    m_Localized: "Der H\xE4ndler hat nicht genug Kronkorken f\xFCr deine Waren"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629498
    m_Localized: "Nicht gen\xFCgend freie Waffenpl\xE4tze"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629499
    m_Localized: "Nicht gen\xFCgend freie Zauberpl\xE4tze"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629500
    m_Localized: "Ausr\xFCstung wurde ezrst\xF6rt (@1, @2stk)"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629501
    m_Localized: Items fell out of the bag (@1, @2stk)
    m_Metadata:
      m_Items: []
  - m_Id: 2733629502
    m_Localized: 'Epischer Feind besiegt: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629503
    m_Localized: Elektrisches Feld abgeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 2733629504
    m_Localized: Elektrisches Feld eingeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 2733629505
    m_Localized: "Nicht verf\xFCgbar, wenn der Alihorn-Modus aktiviert ist"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629506
    m_Localized: "Daf\xFCr hast du jetzt keine Zeit"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629507
    m_Localized: "\xDCberladen! Zu viele Gegenst\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629508
    m_Localized: Test Protokoll
    m_Metadata:
      m_Items: []
  - m_Id: 2733629509
    m_Localized: Test Protokoll 2
    m_Metadata:
      m_Items: []
  - m_Id: 2733629510
    m_Localized: Technische Tunnel
    m_Metadata:
      m_Items: []
  - m_Id: 2733629511
    m_Localized: Beginn deiner Reise
    m_Metadata:
      m_Items: []
  - m_Id: 2733629512
    m_Localized: "Oberfl\xE4che"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629513
    m_Localized: "Equestrianisches \xD6dland, hart und grausam."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629514
    m_Localized: Banditenlager
    m_Metadata:
      m_Items: []
  - m_Id: 2733629515
    m_Localized: "Ruinen, besetzt von einer gro\xDFen Bande von Banditen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629516
    m_Localized: Falls Springs
    m_Metadata:
      m_Items: []
  - m_Id: 2733629517
    m_Localized: "Eine kleine Siedlung, in der die Sklavenh\xE4ndler beheimatet sind.
      Der Eingang zum Stable 88 befindet sich hier."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629518
    m_Localized: "\"T\xE4nzelndes Pony\" Lager"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629519
    m_Localized: "Einer der wenigen sicheren Orte, an denen du dich ausruhen, deine
      Wunden behandeln und Vorr\xE4te auff\xFCllen kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629520
    m_Localized: Fabrik
    m_Metadata:
      m_Items: []
  - m_Id: 2733629521
    m_Localized: "Teilweise zerst\xF6rter Fabrikkomplex \"ManeTec\", besetzt von
      Banditen. Abgesehen von ihnen solltest du auf automatische Verteidigungssysteme
      und gelegentliche Monster achten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629522
    m_Localized: "Abteilung f\xFCr Spezialforschungen"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629523
    m_Localized: Die Hauptzentrale der ManeTec-Fabrik, in der zuvor Forschung und
      Entwicklung betrieben wurde. Der zentrale Hauptrechner ist irgendwo hier.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629524
    m_Localized: Kanalisation
    m_Metadata:
      m_Items: []
  - m_Id: 2733629525
    m_Localized: "Abwassertunnel, gef\xFCllt mit Schlamm, giftigen und radioaktiven
      Abf\xE4llen. Es ist ein Unterschlupf f\xFCr verschiedene Monster, und wilde
      Ghule stellen eine erhebliche Bedrohung dar. Viele Passagen und R\xE4ume sind
      \xFCberflutet."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629526
    m_Localized: Stable 88
    m_Metadata:
      m_Items: []
  - m_Id: 2733629527
    m_Localized: "Die Bev\xF6lkerung ist vor vielen Jahren gestorben, und diejenigen,
      die blieben, wurden zu wilden Ghulen. Sicherheitsroboter und Gesch\xFCtzt\xFCrme
      sind dort besonders gef\xE4hrlich."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629528
    m_Localized: Stable 88 - Kern
    m_Metadata:
      m_Items: []
  - m_Id: 2733629529
    m_Localized: "Hier befinden sich das Overmare-B\xFCro, das Hauptsicherheitsb\xFCro,
      der Hauptserver und der Reaktorkern, der den gesamten Stable mit Energie versorgt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629530
    m_Localized: Hankey Garagen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629531
    m_Localized: Treffpunkt nach Anweisung des Mentors.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629532
    m_Localized: Manehattan Ruinen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629533
    m_Localized: "In den Ruinen von Manehattan gibt es viele Gefahren. Hier trifft
      man oft auf Trupps von Sklavenh\xE4ndlern und S\xF6ldnern. Vor einiger Zeit
      kamen auch Berichte \xFCber Gruppen von Alih\xF6rnern der G\xF6ttin auf, die
      dort aufgetaucht sein sollen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629534
    m_Localized: "Milit\xE4rbasis"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629535
    m_Localized: "Ehemals eine Milit\xE4rbasis, jetzt Basis der St\xE4hlernen Bruderschaft."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629536
    m_Localized: Canterlot Ruinen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629537
    m_Localized: "Die ehemalige Hauptstadt von Equestria. Jetzt mit der t\xF6dlichen
      Rosa Wolke versucht und von verschiedenen Monstern bewohnt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629538
    m_Localized: M.A.S. Turm
    m_Metadata:
      m_Items: []
  - m_Id: 2733629539
    m_Localized: "Ein gro\xDFer, aber schwer zerst\xF6rter Wolkenkratzer in der fr\xFCher
      eines der Regionalb\xFCros des Ministeriums f\xFCr Arkane Wissenschaften war."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629540
    m_Localized: Labyrinth
    m_Metadata:
      m_Items: []
  - m_Id: 2733629541
    m_Localized: "Finde den Weg aus dem Labyrinth heraus. Tipp: Um in der H\xF6he
      eines Blocks in enge Passagen zu gelangen, dr\xFCcke [W] + [A] oder [W] + [D]."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629542
    m_Localized: Mit einem Infrarot-Trank findst du leicht den richtigen Weg
    m_Metadata:
      m_Items: []
  - m_Id: 2733629543
    m_Localized: "Schleim K\xF6nigreich"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629544
    m_Localized: "Gelange bis ans Ende, ohne auf einen Schleim zu treten. Tipp: Verwende
      einen Chemikalienschutzanzug, um S\xE4uresch\xE4den zu minimieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629545
    m_Localized: Gammastrahlung
    m_Metadata:
      m_Items: []
  - m_Id: 2733629546
    m_Localized: "Durchquere die Strahlungszone, ohne zu sterben. Tipp: Verwende
      alle verf\xFCgbaren Strahlenschutzmittel"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629547
    m_Localized: 'Um in horizontaler Richtung zu springen verwende einen Kinetischen
      Puls [Shift] + [A], [A] or [Shift] + [D], [D]'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629548
    m_Localized: Kombinationsschloss
    m_Metadata:
      m_Items: []
  - m_Id: 2733629549
    m_Localized: "\xD6ffne durch Dr\xFCcken der richtigen Kn\xF6pfe alle Panzert\xFCren"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629550
    m_Localized: "Nur eine Kombination \xF6ffnet alle T\xFCren. Die Hinweisnummer
      steht an der Wand hinter der Kiste. Diese Zahl in bin\xE4rer Form ist der richtige
      Code."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629551
    m_Localized: Fall
    m_Metadata:
      m_Items: []
  - m_Id: 2733629552
    m_Localized: "\xDCberwinde den Auftrieb des Anti-Schwerkraft-Aufzuges. Du musst
      eine ausreichende Fallgeschwindigkeit erreichen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629553
    m_Localized: Der dritte Teleport ist unter dem Boden versteckt.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629554
    m_Localized: "Tasterschie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629555
    m_Localized: "Aktiviere alle Taster in dem du darauf schie\xDFt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629556
    m_Localized: "Um den unteren Taster zu bet\xE4tigen, verwende eine Granate in
      Verbindung mit Telekinese."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629557
    m_Localized: Zwei Seiten
    m_Metadata:
      m_Items: []
  - m_Id: 2733629558
    m_Localized: "Bet\xE4tige beide Tasten an den Seiten des Raumes gleichzeitig."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629559
    m_Localized: "Um zu verhindern dass sich die T\xFCr automatisch schlie\xDFt,
      platziere etwas in der T\xFCr\xF6ffnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629560
    m_Localized: Granaten Zielwurf
    m_Metadata:
      m_Items: []
  - m_Id: 2733629561
    m_Localized: "Bet\xE4tige alle roten Kn\xF6pfe durch den gezielten Wurf von Sprengstoff.
      Tipp: Verwende S.A.T.S. zum besseren Zielen. Wenn du eine Granate weiter werfen
      m\xF6chtest, musst du die F\xE4higkeit \"Sprengstoffe\" erlernen. Die Wurfkraft
      kann durch \xC4ndern der Mauszeigerposition angepasst werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629562
    m_Localized: "Um den n\xE4chsten Knopf zu dr\xFCcken verwende Telekinese und
      eine Stange Dynamit. Zum dr\xFCcken des am weitesten entfernten Knopfes verwende
      S.A.T.S. und w\xE4hle die richtige Flugbahn. Du ben\xF6tigst mindestens die
      F\xE4higkeit \"Sprengstoff\" Stufe 3."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629563
    m_Localized: Regenbogen Feuer
    m_Metadata:
      m_Items: []
  - m_Id: 2733629564
    m_Localized: "Du musst alle Kn\xF6pfe dr\xFCcken. Jeder Knopf reagiert auf eine
      andere Art von Schaden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629565
    m_Localized: "Laser, Feuer, Elektrizit\xE4t, S\xE4ure, Plasma, Frost"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629566
    m_Localized: Fallender Turm
    m_Metadata:
      m_Items: []
  - m_Id: 2733629567
    m_Localized: Verwende die Kisten um zum oberen Durchgang zu gelangen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629568
    m_Localized: Baue einen schiefen Turm in dem du eine Kiste auf die Kante der
      anderen setzt. Ziehe am Schluss der Aufgabe die unterste Kiste heraus. Physik!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629569
    m_Localized: "G\xFCterverkehr"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629570
    m_Localized: "Benutze die im Raum befindliche Ausr\xFCstung um zum oberen Gang
      zu gelangen. Fall nicht runter!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629571
    m_Localized: "Baue einen Stapel aus Kisten auf die Bewegliche Plattform. Wenn
      du etwas in die Grube fallen l\xE4sst verlasse den Raum kurz und versuche es
      erneut."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629572
    m_Localized: Verwirrung
    m_Metadata:
      m_Items: []
  - m_Id: 2733629573
    m_Localized: Springe auf die Plattformen und Leitern um innerhalb der vorgegebenen
      Zeit nach oben zu gelangen. Zu einfach? Dann mach das doch mal wenn "links"
      und "rechts" vertauscht sind!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629574
    m_Localized: Ausgrabung
    m_Metadata:
      m_Items: []
  - m_Id: 2733629575
    m_Localized: Irgendwo hier befindet sich ein Tresor. Finde ihn!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629576
    m_Localized: "Es gibt viele Sch\xE4tze im Untergrund - benutze einen Vorschlaghammer
      oder Dynamit, um an sie zu gelangen. Achtung, die Bodenvibration zieht Monster
      an!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629577
    m_Localized: Abtauchen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629578
    m_Localized: Schwimmst du gerne in radioaktivem Wasser? Nun, du musst, es gibt
      keinen anderen Weg.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629579
    m_Localized: "Lasse das Wasser ab in dem du den St\xF6psel heraus ziehst. Verwende
      einen Strahlenschutzanzug."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629580
    m_Localized: Schnelligkeit
    m_Metadata:
      m_Items: []
  - m_Id: 2733629581
    m_Localized: "Du musst den Knopf hier dr\xFCcken und dann zur anderen Seite laufen
      bevor sich die T\xFCr schlie\xDFt. Es ist ganz einfach aber die Zeit ist sehr
      knapp."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629582
    m_Localized: "Das Wasser auf der unteren Ebene verlangsamt dich, werde es los.
      Verwende Medikamente um schneller zu Laufen und h\xF6her zu Springen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629583
    m_Localized: Bloatsprite Kindergarten
    m_Metadata:
      m_Items: []
  - m_Id: 2733629584
    m_Localized: "Zerst\xF6re alle Bloatsprite Nester."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629585
    m_Localized: "Bloatsprites sind anf\xE4llig f\xFCr magische Energiewaffen. Zerst\xF6re
      die Nester so schnell wie m\xF6glich, oder sie werden immer mehr Bloatsprites
      produzieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629586
    m_Localized: Ameisentunnel
    m_Metadata:
      m_Items: []
  - m_Id: 2733629587
    m_Localized: "Zerst\xF6re alle Ameisennester."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629588
    m_Localized: "Ameisennester sind am anf\xE4lligsten f\xFCr Explosionen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629589
    m_Localized: "B\xFCro des Fabrikchefs"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629590
    m_Localized: Hole dir die wertvollen Sachen aus dem Tresor.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629591
    m_Localized: Datenraum
    m_Metadata:
      m_Items: []
  - m_Id: 2733629592
    m_Localized: "Datenspeicher und Serverraum. Zutritt nur f\xFCr Overmare, den
      Technischen Dienst und den Systemadministrator gestattet. Achtung! Beim Eindringen
      er\xF6ffnen Sicherheitssysteme ohne Vorwarnung das Feuer."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629593
    m_Localized: Geflutete Tunnel
    m_Metadata:
      m_Items: []
  - m_Id: 2733629594
    m_Localized: "Kannst du deinen Atem f\xFCr lange Zeit anhalten, durch schlammiges
      Wasser navigieren und die Mechanismen reparieren? Wenn nicht, wirst du hier
      nicht durch kommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629595
    m_Localized: Bewegliche Plattformen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629596
    m_Localized: Benutze die beweglichen Plattformen um ans Ziel zu gelangen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629597
    m_Localized: Laserfallen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629598
    m_Localized: Vermeide es in die Lichtschranken geraten, entwaffne sie oder versuche
      es auf deine Weise.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629599
    m_Localized: "Die Lasersensoren reagieren nur auf feindliche Ziele. Wie dich.
      Sie k\xF6nnen mit ausreichenden Kenntnissen in \"Wissenschaften\" ausgeschaltet
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629600
    m_Localized: Gefahrenzone
    m_Metadata:
      m_Items: []
  - m_Id: 2733629601
    m_Localized: "Begib dich durch die Passage, die von Gesch\xFCtzt\xFCrmen bewacht
      wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629602
    m_Localized: "Hinter einer geborsten Mauer befindet sich ein Sprengsatz, der
      den Weg zum Becken mit Wasser \xF6ffnet. Das Wasser sch\xFCtzt dich vor Energiewaffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629603
    m_Localized: Roboter
    m_Metadata:
      m_Items: []
  - m_Id: 2733629604
    m_Localized: Banditen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629605
    m_Localized: Wachbots
    m_Metadata:
      m_Items: []
  - m_Id: 2733629606
    m_Localized: Zombies
    m_Metadata:
      m_Items: []
  - m_Id: 2733629607
    m_Localized: "Kl\xE4rgrube"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629608
    m_Localized: Scorpion Grube
    m_Metadata:
      m_Items: []
  - m_Id: 2733629609
    m_Localized: Banditenlager
    m_Metadata:
      m_Items: []
  - m_Id: 2733629610
    m_Localized: "Sklavenh\xE4ndlerlager"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629611
    m_Localized: "Bloatsprite K\xF6nig"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629612
    m_Localized: Gravitationsanomalie
    m_Metadata:
      m_Items: []
  - m_Id: 2733629613
    m_Localized: Besiege die Gegner bei der Schwerkraft des Mondes.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629614
    m_Localized: Sendeturm
    m_Metadata:
      m_Items: []
  - m_Id: 2733629615
    m_Localized: "Sorge daf\xFCr dass alle Kn\xF6pfe bet\xE4tigt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629616
    m_Localized: "Verwende X-37 mit Funkausl\xF6ser."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629617
    m_Localized: Technische Abteilung
    m_Metadata:
      m_Items: []
  - m_Id: 2733629618
    m_Localized: Finde die Passage durch das Labyrinth der technischen Abteilungen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629619
    m_Localized: "\xDCberraschung"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629620
    m_Localized: Achtung
    m_Metadata:
      m_Items: []
  - m_Id: 2733629621
    m_Localized: "Banditenanf\xFChrer (Boss)"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629622
    m_Localized: Ultra-Wachbot (Boss)
    m_Metadata:
      m_Items: []
  - m_Id: 2733629623
    m_Localized: Alihorn (Boss)
    m_Metadata:
      m_Items: []
  - m_Id: 2733629624
    m_Localized: Boss der Fabrik
    m_Metadata:
      m_Items: []
  - m_Id: 2733629625
    m_Localized: "Boss des Sklavenh\xE4ndlerlagers"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629626
    m_Localized: Boss des aufgegebenen Stable
    m_Metadata:
      m_Items: []
  - m_Id: 2733629627
    m_Localized: Boss der Manehattan Ruinen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629628
    m_Localized: Generatorraum
    m_Metadata:
      m_Items: []
  - m_Id: 2733629629
    m_Localized: Bibliothek
    m_Metadata:
      m_Items: []
  - m_Id: 2733629630
    m_Localized: "Dunkler und gef\xE4hrlicher Keller"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629631
    m_Localized: "\xD6ffne diese T\xFCr nicht, der Tod erwartet dich dort drinnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629632
    m_Localized: "Ein mysteri\xF6ser Keller"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629633
    m_Localized: Seltsamer Ort
    m_Metadata:
      m_Items: []
  - m_Id: 2733629634
    m_Localized: Verlassenes Lager
    m_Metadata:
      m_Items: []
  - m_Id: 2733629635
    m_Localized: Gefangenenlager
    m_Metadata:
      m_Items: []
  - m_Id: 2733629636
    m_Localized: Irgendwo auf dem Weg nach Canterlot...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629637
    m_Localized: Verdecktes Zeichen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629638
    m_Localized: Eine kleine Siedlung, die eine Gruppe von Zebras beherbergt.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629639
    m_Localized: "Kl\xE4ranlage"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629640
    m_Localized: "Ein kleines Geb\xE4ude, in dem die St\xE4hlerne Bruderschaft unter
      dem Kommando von Stahlhufe ein provisorisches Lager eingerichtet hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629641
    m_Localized: "Ministerium f\xFCr Prestige"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629642
    m_Localized: "Das Hauptb\xFCro eines der Ministerien der Epoche des gro\xDFen
      Krieges - das Ministerium f\xFCr Prestige"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629643
    m_Localized: Bunker
    m_Metadata:
      m_Items: []
  - m_Id: 2733629644
    m_Localized: "Lagerbunker der St\xE4hlernen Bruderschaft. Besser gesch\xFCtzt
      als jedes andere Objekt in der Region. Der Versuch, hier reinzukommen, w\xE4re
      reiner Wahnsinn."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629645
    m_Localized: "Stable-Tec B\xFCro, Mitarbeiter-Eingang"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629646
    m_Localized: Alihorn Lager
    m_Metadata:
      m_Items: []
  - m_Id: 2733629647
    m_Localized: Kampf um die Fabrik
    m_Metadata:
      m_Items: []
  - m_Id: 2733629648
    m_Localized: "Bek\xE4mpfe mehrere Wellen von Gegnern, die nacheinander kommen.
      Die Zeit f\xFCr die Vernichtung jeder Welle ist begrenzt. Versuche dabei nicht
      zu sterben, sonst musst du wieder von vorne beginnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629649
    m_Localized: Kampf um die Kanalisation
    m_Metadata:
      m_Items: []
  - m_Id: 2733629650
    m_Localized: Kampf um den Stable
    m_Metadata:
      m_Items: []
  - m_Id: 2733629651
    m_Localized: Kampf um Manehattan
    m_Metadata:
      m_Items: []
  - m_Id: 2733629652
    m_Localized: Kampf um Canterlot
    m_Metadata:
      m_Items: []
  - m_Id: 2733629653
    m_Localized: Boss von Canterlot
    m_Metadata:
      m_Items: []
  - m_Id: 2733629654
    m_Localized: "Boss der Milit\xE4rbasis"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629655
    m_Localized: "Schneller Sch\xFCtze"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629656
    m_Localized: "Bringe alle 6 Kn\xF6pfe dazu gleichzeitig zu leuchten. Schie\xDFe
      sehr schnell und genau!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629657
    m_Localized: Verwende die Little Macintosh und S.A.T.S.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629658
    m_Localized: Dunkle Spheren
    m_Metadata:
      m_Items: []
  - m_Id: 2733629659
    m_Localized: Benutze die dunklen Kugeln um an das Ende des Raumes zu gelangen.
      Du kannst mit ihnen wie mit einem Schalter interagieren.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629660
    m_Localized: Springen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629661
    m_Localized: Enclaven Basis
    m_Metadata:
      m_Items: []
  - m_Id: 2733629662
    m_Localized: "Ein gro\xDFes Geb\xE4ude, das von der Enklave auf dem Berg gebaut
      wurde. Die Enklave unternahm keine Versuche, die Bewohner des \xD6dlands zu
      kontaktieren, und nach der Anzahl der Truppen auf der Basis ist es unwahrscheinlich,
      dass sie mit friedlichen Absichten dort sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629663
    m_Localized: "Enclaven Au\xDFenposten"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629664
    m_Localized: Die Tore zur Hauptbasis
    m_Metadata:
      m_Items: []
  - m_Id: 2733629665
    m_Localized: Kommandoposten
    m_Metadata:
      m_Items: []
  - m_Id: 2733629666
    m_Localized: "Der Kommandoposten befindet sich ganz oben \xFCber der Wolkenbarriere.
      Der Basiskommandant muss hier sein"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629667
    m_Localized: Waffenfabrik
    m_Metadata:
      m_Items: []
  - m_Id: 2733629668
    m_Localized: "In dieser Fabrik wurden fr\xFCher gro\xDFkalibrige Waffen hergestellt.
      Aufgrund des leistungsf\xE4higen und immer noch funktionst\xFCchtigen Sicherheitssystems
      wurde dieser Ort noch nicht gepl\xFCndert."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629669
    m_Localized: Legion Hauptquartier
    m_Metadata:
      m_Items: []
  - m_Id: 2733629670
    m_Localized: "Das gut getarnte tempor\xE4re Hauptquartier der Zebra-Legion. Nach
      guter alter Zebratradition ist der Weg dorthin wahrscheinlich mit vielen Minen
      und Fallen gesch\xFCtzt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629671
    m_Localized: Bewegliche Ziele
    m_Metadata:
      m_Items: []
  - m_Id: 2733629672
    m_Localized: Lasse alle sechs sich bewegenden Ziele gleichzeitig aufleuchten
    m_Metadata:
      m_Items: []
  - m_Id: 2733629673
    m_Localized: Elektrisches Feld
    m_Metadata:
      m_Items: []
  - m_Id: 2733629674
    m_Localized: "Ber\xFChre keine Metallb\xF6den, Treppen, Balken oder T\xFCren,
      bis das Elektrische Feld ausgeschaltet ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629675
    m_Localized: Blitze
    m_Metadata:
      m_Items: []
  - m_Id: 2733629676
    m_Localized: Durchquere die elektrischen Entladungen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629677
    m_Localized: Zwinger
    m_Metadata:
      m_Items: []
  - m_Id: 2733629678
    m_Localized: Umkleideraum
    m_Metadata:
      m_Items: []
  - m_Id: 2733629679
    m_Localized: Kampf um die Enclaven Basis
    m_Metadata:
      m_Items: []
  - m_Id: 2733629680
    m_Localized: Boss der Enclaven Basis
    m_Metadata:
      m_Items: []
  - m_Id: 2733629681
    m_Localized: Stable Pi
    m_Metadata:
      m_Items: []
  - m_Id: 2733629682
    m_Localized: "Ein v\xF6llig autonomer Geheimbunker, der zu Beginn des Krieges
      gebaut wurde und die besten Equestrianischen Wissenschaftler und Ingenieure
      retten sollte. Deine Heimat."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629683
    m_Localized: Fort Rocks
    m_Metadata:
      m_Items: []
  - m_Id: 2733629684
    m_Localized: "Eine der uneinnehmbarsten Festungen von Equestria. Sie verf\xFCgt
      \xFCber leistungsstarke Artillerie- und Luftabwehrsysteme"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629685
    m_Localized: Stable Pi
    m_Metadata:
      m_Items: []
  - m_Id: 2733629686
    m_Localized: Stable Pi Eingang
    m_Metadata:
      m_Items: []
  - m_Id: 2733629687
    m_Localized: Thunderhead
    m_Metadata:
      m_Items: []
  - m_Id: 2733629688
    m_Localized: Nahe Stable Pi
    m_Metadata:
      m_Items: []
  - m_Id: 2733629689
    m_Localized: Deine Reise beginnt
    m_Metadata:
      m_Items: []
  - m_Id: 2733629690
    m_Localized: NEUE STUFE ERREICHT
    m_Metadata:
      m_Items: []
  - m_Id: 2733629691
    m_Localized: "Achtung! Der Gesundheitszustand des Benutzers ist kritisch, eine
      Fortsetzung der Mission ist unm\xF6glich. [br]Beginne Notverlegung zur Basis."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629692
    m_Localized: "Dein Gesundheitszustand ist kritisch, ein fortf\xFChren der Mission
      ist nicht m\xF6glich. [br]Suche \xE4rztliche Hilfe auf."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629693
    m_Localized: "Du bist mit Gegenst\xE4nden \xFCberladen! [br] Lasse einige deiner
      Waffen am Waffenst\xE4nder und lege Gegenst\xE4nde die du entbehren kannst
      in das Lager"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629694
    m_Localized: "Dr\xFCcke @1 oder @2 um dich nach links oder rechts zu bewegen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629695
    m_Localized: "Dr\xFCcke @1 um zu Springen. [br]Halte die Taste gedr\xFCckt um
      h\xF6her zu springen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629696
    m_Localized: "Dr\xFCcke @1 um die Leiter hoch zu klettern."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629697
    m_Localized: "Dr\xFCcke @1 um Leitern runter zu klettern."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629698
    m_Localized: "Dr\xFCcke @1 um zu Kriechen und @2 um wieder Aufzustehen.[br]Verwende
      Kriechen um durch schmale G\xE4nge zu gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629699
    m_Localized: "Dr\xFCcke @1+@2 um runter zu Springen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629700
    m_Localized: "\xDCberpr\xFCfe die verschiedenen Beh\xE4lter, denen du w\xE4hrend
      deiner Reise begegnest. Dieser Kasten hier enth\xE4lt vielleicht etwas Interessantes.
      [br]Gehe n\xE4her heran, bewege den Mauszeiger dar\xFCber und dr\xFCcke @1,
      um hineinzuschauen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629701
    m_Localized: "Verwende Telekinese, um Dinge zu heben und zu bewegen. Bewege dazu
      den Mauszeiger \xFCber das Objekt und dr\xFCcke @1. Zum Fallen lassen des Objektes
      dr\xFCcke @2 noch einmal."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629702
    m_Localized: "Die Holzwand am Ende des Korridors sieht ziemlich verwittert aus.
      Wahrscheinlich kann sie mit ein paar starken Tritten durchbrochen werden. Gehe
      nahe heran und dr\xFCcke @1, um zuzutreten. [br]F\xFCr einen st\xE4rkeren Tritt
      mit den Hinterbeinen dr\xFCcke @2 + @3."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629703
    m_Localized: "Sieht so aus, als k\xF6nntest du dort oben einige n\xFCtzliche
      Werkzeuge finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629704
    m_Localized: Du hast Medikamente gefunden. Verwenden sie zur Behandlung von Wunden,
      die du dir im Kampf zuziehst. Die Schnelltaste zum Benutzen von Medikamenten
      ist - @1
    m_Metadata:
      m_Items: []
  - m_Id: 2733629705
    m_Localized: "Diese Wand ist alt und rissig und sieht nicht so robust aus wie
      andere W\xE4nde. Vermutlich kannst du sie mit einer Brechstange einschlagen.
      Bewege den Mauszeiger \xFCber den Wandabschnitt und dr\xFCcke @1 um ihn einzuschlagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629706
    m_Localized: "Eine verschlossene T\xFCr, was? Kein Problem. Versuche das Schloss
      zu knacken. Wenn es misslingt, brich sie einfach mit einer Brechstange auf."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629707
    m_Localized: "Verwende Telekinese und platziere einige Kisten \xFCbereinander,
      um auf den obigen Pfad zu gelangen. [br]Standardm\xE4\xDFig kannst du die rechte
      Maustaste dr\xFCcken, um die Telekinese zu verwenden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629708
    m_Localized: "Eine Brechstange kann nicht nur zum Einschlagen von W\xE4nden verwendet
      werden. Dort unten gibt es ein paar Kakerlaken. \xDCbe mit der Brechstange
      an ihnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629709
    m_Localized: "Dr\xFCcke @1 um den PipBuck zu verwenden. Dieses Ger\xE4t verf\xFCgt
      \xFCber mehrere Funktionen - von der Anzeige deines aktuellen Gesundheitszustandes
      bis hin zum Durchsuchen deines Inventars."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629710
    m_Localized: "Um das Zielen zu vereinfachen, kannst du den Stable-Tec Arcane
      Targeting Spell (S.A.T.S.) verwenden. [br]Dr\xFCcke dazu @1 (oder standardm\xE4\xDFig
      die mittlere Maustaste)."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629711
    m_Localized: "Du kannst Waffen mit dem PipBuck, Zifferntasten oder @1 und @2
      wechseln (oder standardm\xE4\xDFig mit dem Mausrad)."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629712
    m_Localized: Eine Brechstange! Du kannst sie als Waffe verwenden oder Dinge damit
      zerschlagen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629713
    m_Localized: "Ein Schraubenzieher! Ein n\xFCtzliches Werkzeug. Es kann dir helfen,
      einfache Schl\xF6sser zu \xF6ffnen. Versuche es an dieser Truhe."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629714
    m_Localized: "Eine Selbstlade-Pistole - ein guter Fund. Sie geh\xF6rt zur Klasse
      der magischen Energiewaffendie keine Spark-Batterien ben\xF6tigen. Die Ladung
      wird im Laufe der Zeit automatisch wiederhergestellt"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629715
    m_Localized: "Schusswaffen - man kann nie genug davon haben. Dr\xFCcke @1 zum
      Nachladen"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629716
    m_Localized: "Du hast ein Buch gefunden, das den Zauber \"Telekinetisches Geschoss\"
      beschreibt. Um ihn zu Verwenden, r\xFCste ihn wie eine normale Waffe aus. Zauberspr\xFCche
      ben\xF6tigen keine Munition, verbrauchen aber deine magische Energie."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629717
    m_Localized: "Ignoriere kein Terminal. Einige von ihnen k\xF6nnen wertvolle Daten
      enthalten, andere k\xF6nnen T\xFCrschl\xF6sser, Mechanismen und Sicherheitssysteme
      steuern. Gesch\xFCtzte Terminals k\xF6nnen gehackt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629718
    m_Localized: "Du hast technische Schemata f\xFCr eine hufgemachte Waffe gefunden.
      Wenn du \xFCber alle erforderlichen Komponenten verf\xFCgst, kannst du versuchen,
      diese Waffe an der Werkbank zu bauen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629719
    m_Localized: "Du kannst \xFCber diese Grube springen, jedoch du musst rennen,
      um schneller zu werden und direkt am Rand zu springen. [br]Halte @1 gedr\xFCckt,
      w\xE4hrend du rennst und springst, um dich schneller zu bewegen und weiter
      zu springen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629720
    m_Localized: Falls du es nicht schaffst, hilft dir diesmal diese Plattform. Aber
      im Ernst, so schwer ist es nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629721
    m_Localized: "Sieht so aus, als m\xFCsstest du schwimmen. Dr\xFCcke und halte
      @1, um nach oben zu schwimmen und aus dem Wasser zu springen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629722
    m_Localized: "Halte @1 gedr\xFCckt und bewege den Mauszeiger, um die Kamera zu
      bewegen. Dr\xFCcke @2, um die Vergr\xF6\xDFerung zu \xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629723
    m_Localized: "Du hast die F\xE4higkeit [br]Doppelsprung erlangt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629724
    m_Localized: "Dr\xFCcke beim Springen erneut @1, um mit Telekinese aus der Luft
      zu springen. [br]Mit dieser Technik kannst du viel weiter springen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629725
    m_Localized: "Du kannst mit Hilfe des Doppelsprunges auch an schwer zug\xE4ngliche
      Stellen gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629726
    m_Localized: Halte @1 + @3(@2) um einen Block hoch zu klettern, ohne zu springen,
      oder durch enge Passagen die nur einen Block hoch sind zu kriechen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629727
    m_Localized: "Gehe nach links, um den Komplex weiter zu erkunden. [br]Oder gehe
      nach rechts, um an die Oberfl\xE4che zu gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629728
    m_Localized: "An Orten mit hoher Hintergrundstrahlung solltest du nicht lange
      verweilen, insbesondere nicht in der N\xE4he von magischem Strahlenabfall,
      es sei denn, du m\xF6chtest dir eine t\xF6dliche Dosis der Strahlenkrankheit
      zuziehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629729
    m_Localized: "Verwende RadAway, um deinen K\xF6rper von magischer Verstrahlung
      zu reinigen. Die Heiltr\xE4nken helfen hier nicht weiter."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629730
    m_Localized: Du musst hier rennen (halte @1) um nicht herunterzufallen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629731
    m_Localized: "Beim Laufen, halte @1 gedr\xFCckt um Treppen nach oben zu steigen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629732
    m_Localized: "Halte @1 um deine Waffe h\xF6her zu heben. [br]Du kannst den roten
      Knopf aktivieren in dem du darauf schie\xDFt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629733
    m_Localized: "Dr\xFCcke @1 um w\xE4hrend des Sprunges nach einer Leiter zu greifen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629734
    m_Localized: "Du kannst dich in Wandnischen, hinter Kisten und M\xF6beln verstecken.
      W\xE4hrend du in Deckung bist, bekommst du Boni f\xFCr Heimlichkeit und Ausweichen.
      Um dich zu verstecken, stelle dich vor ein m\xF6gliches Versteck und dr\xFCcke
      @1."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629735
    m_Localized: "Es ist nicht n\xF6tig, jeden Feind zu bek\xE4mpfen, einige K\xE4mpfe
      k\xF6nnen vermieden werden. Warte, bis der Feind wegschaut, und versuche, unentdeckt
      zu bleiben. Nutze die Wandnische, um dich zu verstecken."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629736
    m_Localized: "Halte @1 oder @2 gedr\xFCckt und dr\xFCcke @3, um von der Leiter
      nach links bzw. rechts abzuspringen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629737
    m_Localized: "Dr\xFCcke @1 um dich von der Leiter fallen zu lassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629738
    m_Localized: "Dr\xFCcke @1 zweimal, um vom Stahltr\xE4ger abzuspringen.[br]Halte
      w\xE4hrend des Fallens @2 gedr\xFCckt, um an den anderen vorbeifallen zu k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629739
    m_Localized: "Halte @3 gedr\xFCckt, und dr\xFCcke zweimal schnell hintereinander
      auf @1 oder @2, um zu st\xFCrmen. [br]Dieser Trick kann dir helfen, bestimmte
      Orte zu erreichen, und du kannst ihn auch im Kampf einsetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629740
    m_Localized: "W\xE4hrend du @3 gedr\xFCckt h\xE4lst, dr\xFCcke zweimal schnell
      @1 oder @2, um zu sto\xDFen. [br]Wenn du einen Sto\xDF auf den angreifenden
      Feind ausf\xFChrst, kannst du dabei vermeiden, selbst Schaden zu erleiden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629741
    m_Localized: "Ein Zeichen des Ministeriums der Ehrfurcht weist auf geheime Orte
      und Verstecke hin. Manchmal verstecken sich solche Orte hinter falschen Mauern,
      die von jeder Waffe zerst\xF6rt werden k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629742
    m_Localized: "Du m\xF6chtest dem Balefire Phoenix etwas anbieten, hast aber nichts
      Passendes dabei."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629743
    m_Localized: "Der Balefire Phoenix mag dich. Er gibt ein melodi\xF6ses Zwitschern
      von sich und verschwindet. Vielleicht begegnet ihr euch wieder."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629744
    m_Localized: Deine Abenteuer enden hier. Ruhe in Frieden.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629745
    m_Localized: "Du hast t\xF6dliche Verletzungen erlitten. Ruhe in Frieden..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629746
    m_Localized: "Durch diese T\xFCr gelangst du in eine tiefere Ebene der Fabrik.
      Dort triffst du auf neue Feinde, neue Pr\xFCfungen und neue Belohnungen. [br]Benutze
      das MAS-Terminal, um das Basislager zu besuchen, Vorr\xE4te aufzuf\xFCllen
      und deine Gesundheit wiederherzustellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629747
    m_Localized: "Hinter dieser T\xFCr befindet sich ein Durchgang zur Kanalisation.
      Zum \xD6ffnen ben\xF6tigst du einen Schl\xFCssel. [br]Empfohlen f\xFCr Abenteurer
      ab Stufe 6."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629748
    m_Localized: "Diese Passage f\xFChrt zu einem verlassenen Stable. [br]Dieser
      Ort gilt als ziemlich gef\xE4hrlich. Empfohlen f\xFCr Abenteurer ab Stufe 10.
      [br]Oder du begibst dich tiefer in die Kanalisation."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629749
    m_Localized: "Eine halbe Stunde sp\xE4ter, nachdem @lp ihre Geschichte von die
      von ihren \xD6dlands-Abenteuern beendet hatte..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629750
    m_Localized: "Ein paar Tage sp\xE4ter..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629751
    m_Localized: '[Erweiterte Steuerelemente]'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629752
    m_Localized: "Halte @1 - um deine Waffe h\xF6her zu heben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629753
    m_Localized: "Auch im Liegen, halte @2 und @1 gedr\xFCckt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629754
    m_Localized: "@1 in der N\xE4he einer Kiste, eines M\xF6belst\xFCckes oder einer
      Wandnische - verstecke dich dahinter."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629755
    m_Localized: zweimal @1 - um aus einem Strahl heraus zu springen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629756
    m_Localized: "@1 + @2 oder @3 - zum Kriechen in engen Durchg\xE4ngen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629757
    m_Localized: '@1 + @2 oder @3 - um im langsamen Tempo zu gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629758
    m_Localized: "Dr\xFCcke schnell @1 + @2 oder @3 - um die Richtung zu wechsseln."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629759
    m_Localized: "@1 + zweimal @2 oder @3 - f\xFCr einen Seitenhieb um einen Angriff
      Auszuweichen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629760
    m_Localized: '@1 - mit den Vorderhufen zuzutreten, @2 + @3 - nach hinten austreten.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629761
    m_Localized: "@1,@2 - Waffe ausw\xE4hlen, zugewiesene Schnellwahltasten anzeigen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629762
    m_Localized: '@3 + @1,@2 - Munitionsart wechseln.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629763
    m_Localized: Halte @1 - zum entladen einer Waffe.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629764
    m_Localized: "Im Inventar - @1-@2 (Zifferntasten) - k\xF6nnen Waffen, R\xFCstungen
      oder anderen Gegenst\xE4nden Schnellwahltasten zugewiesen werden. Dr\xFCcke
      die zugewiesene Taste im Spiel um den Gegenstand auszuw\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629765
    m_Localized: "Im Inventar - @3 + @1-@2 - gilt das gleiche f\xFCr zus\xE4tzliche
      Pl\xE4tze."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629766
    m_Localized: '[Rechte Maustaste] im PipBuck "Waffen" Auswahl - zum Ausblenden
      nicht verwendeter Waffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629767
    m_Localized: "[Gro\xDFschreibtaste] + [Linke Maustaste] beim Handeln - um die
      maximale Anzahl einer Ware auszuw\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629768
    m_Localized: '@1 - verwendet den letzten Angriffszauber.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629769
    m_Localized: "@1 - verwendet den ausgew\xE4hlten Schutzzauber."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629770
    m_Localized: '@1 - gibt deinem Begleiter die Anweisung, sich zu bewegen oder
      anzugreifen.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629771
    m_Localized: "Halte @1 gedr\xFCckt - um deinen Begleiter zur\xFCckzurufen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629772
    m_Localized: '[Eingabe] - um den aktuellen Raum neu zu zeichnen (im Falle von
      Anzeigefehlern)'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629773
    m_Localized: '[Ende] - Kommandozeile'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629774
    m_Localized: "[W\xF6rterverzeichnis]"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629775
    m_Localized: "[Der Gro\xDFe Krieg] - Ein globaler Krieg zwischen Equestria und
      dem Zebras-Reich, der vor etwa 200 Jahren stattfand. Dieser Krieg endete mit
      der gegenseitigen Ausrottung und Umwandlung von Equestria in das heutige \xD6dland."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629776
    m_Localized: "[Megazauber] - Gew\xF6hnliche Zauber, um ein Vielfaches verst\xE4rkt,
      die im Gro\xDFen Krieg als Massenvernichtungswaffen eingesetzt wurden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629777
    m_Localized: "[Balefire-Bombe] - Zebra Megazauber auf Basis von Drachenfeuer,
      verborgen in einer speziellen Vorrichtung. Wenn sie aktiviert wird, explodiert
      sie mit einer ungeheuren Kraft, die mit einer Schockwelle ganze St\xE4dte zerst\xF6ren
      und das Gebiet mit magischer Strahlung verseuchen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629778
    m_Localized: "[Rosa Wolke] - Ein schrecklicher Megazauber, der die Hauptstadt
      von Equestria, Canterlot, zerst\xF6rte. Es handelt sich dabei um eine Wolke
      aus extrem giftigem Gas von rosa Farbe, die alle Lebensformen t\xF6ten kann.
      Es gibt keinen Schutz davor."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629779
    m_Localized: "[Stable-Tec] - Ein Unternehmen, das vor dem Gro\xDFen Krieg existierte.
      Bekannt f\xFCr den Bau einer Vielzahl von unterirdischen Befestigungen, in
      denen Ponys im Falle von Massenvernichtungsangriffen \xFCberleben sollten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629780
    m_Localized: "[PipBuck] - Ein tragbarer Computer von Stable-Tec, den Ponys an
      einem der Vorderbeine tragen k\xF6nnen. Er hat viele Funktionen - \xDCberwachen
      des Gesundheitszustands des Benutzers, Sortieren des Inventars, Zuordnen und
      Navigieren, Anzeigen von Dateien und F\xFChren von Aufzeichnungen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629781
    m_Localized: '[S.A.T.S.] - Stable-Tec Arcane Targeting Spell. Ein im PipBuck
      integrierter Spezialzauber, mit dem du den subjektiven Zeitfluss stoppen und
      mit jeder Waffe genauer zielen kannst.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629782
    m_Localized: "[Stable] - Ein v\xF6llig autonomer unterirdischer Bunker f\xFCr
      Ponys, der f\xFCr langfristige Nutzung ausgelegt ist. W\xE4hrend des Krieges
      wurden mehr als hundert Stable gebaut, aber die meisten von ihnen wurden aus
      verschiedenen Gr\xFCnden aufgegeben und alle ihre Bewohner starben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629783
    m_Localized: '[Ministerien]'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629784
    m_Localized: "Sechs Regierungsorganisationen, die w\xE4hrend des Gro\xDFen Weltkriegs
      von der regierenden Prinzessin Luna gegr\xFCndet wurden und deren gemeinsames
      Ziel es war, den Krieg zu gewinnen und die staatliche Integrit\xE4t von Equestria
      zu wahren. Die Ministerien wurden von den Bewahrern der Elemente der Harmonie
      regiert.\n[Ministerium f\xFCr Arkane Wissenschaften] - Abgek\xFCrzt [MAS] -
      Ein Institut unter der Leitung von Twilight Sparkle. Das MAS besch\xE4ftigte
      sich haupts\xE4chlich mit der Entwicklung magischer Waffen und Kampfzauber.\n[Ministerium
      f\xFCr Prestige] - Ein Ministerium unter der Leitung von Rarity. Es hat Stra\xDFen
      dekoriert, gedruckte Medien herausgegeben und war f\xFCr Zensur und Propaganda
      verantwortlich.\n[Ministerium des Friedens] - Ministerium unter der Leitung
      von Fluttershy. Es befasste sich mit Gesundheitsfragen, der Herstellung von
      Medikamenten, Heiltr\xE4nken und der Versorgung von Verwundeten im Kampf. Dieses
      Ministerium war auch f\xFCr die Erfindung der Megaspells verantwortlich.\n[Ministerium
      der Moral] Ein Ministerium unter der Leitung von Pinky Pie. Offiziell k\xFCmmerte
      es sich um die patriotische Erziehung, unterst\xFCtzte die Moral der Bev\xF6lkerung
      und organisierte die Feiertage. Inoffiziell befasste es sich mit Spionage und
      Spionageabwehr.\n[Ministerium f\xFCr Kriegstechnologie] - Abgek\xFCrzt [MWT]
      - Das Ministerium unter der Leitung von Applejack. Es befasste sich mit der
      Entwicklung der neuesten Waffen und Schutzausr\xFCstung, wie der Power R\xFCstung.\n[Ministerium
      der Ehrfurcht] - Das Ministerium unter der Leitung von Rainbow Dash. Was genau
      dieses tat, war nicht wirklich bekannt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629785
    m_Localized: Was ist passiert? Wo bin ich?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629786
    m_Localized: Ich muss... Aufstehen......
    m_Metadata:
      m_Items: []
  - m_Id: 2733629787
    m_Localized: Ich mache mich wohl besser auf den Weg.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629788
    m_Localized: MAS Terminals
    m_Metadata:
      m_Items: []
  - m_Id: 2733629789
    m_Localized: Achtung! Unbekanntes Signal erkannt
    m_Metadata:
      m_Items: []
  - m_Id: 2733629790
    m_Localized: "Entschl\xFCssle..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629791
    m_Localized: "Signal entschl\xFCsselt.\n\t\t\t\t\t\t\t\t\t\tPipBuck Signatur
      identifiziert.\n\t\t\t\t\t\t\t\t\t\tVerbindung hergestellt.\n\t\t\t\t\t\t\t\t\t\tStarte
      System..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629792
    m_Localized: "Wilkommen, Neuer Benutzer.\n\t\t\t\t\t\t\t\tDies ist das Notfall-Rettungssystem
      des Ministeriums f\xFCr Arkane Wissenschaften."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629793
    m_Localized: "Sie wurden erfolgreich im System registriert und k\xF6nnen nun
      auf alle Berechtigungen zugreifen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629794
    m_Localized: "Im Falle von akuter Lebensgefahr wie einem pl\xF6tzlichen Zebraangriff,
      Terroraktionen, einer Megazauber-Explosion oder einem Sturz von einer Treppe
      werden Sie zur Sicherheit automatisch zum n\xE4chstgelegenen MAS-Terminal teleportiert.
      Dort erhalten Sie auch die notwendige medizinische Behandlung."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629795
    m_Localized: "Warnung: Das System befindet sich derzeit in der Beta-Phase. Einige
      kleinere Fehler und Fehlfunktionen k\xF6nnen auftreten. Wir danken f\xFCr Ihr
      Verst\xE4ndnis."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629796
    m_Localized: Inventarhandbuch
    m_Metadata:
      m_Items: []
  - m_Id: 2733629797
    m_Localized: "*** Anweisungen zur Verwendung deiner Ausr\xFCstung ***\n\t\t\t\t\t\t\t\tAlles,
      was du w\xE4hrend einer Reise findest und sammelst, wird in deinem Inventar
      gelagert. Du kannst das Inventar mit dem PipBuck (Taste @1 oder @2) im Bereich
      [Inventar] durchsuchen.\n\t\t\t\t\t\t\t\tDieser Bereich enth\xE4lt verschiedene
      Abschnitte, zwischen denen du mit den Schaltfl\xE4chen im oberen Teil der Benutzeroberfl\xE4che
      wechseln kannst: [Waffen], [R\xFCstung], [Ausr\xFCstung], [Sonstiges], [Munition]."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629798
    m_Localized: "Im Abschnitt [Waffen] kannst du jede Waffe sehen, die du besitzt.
      Von hier aus kannst du sie ausr\xFCsten, ihre Eigenschaften einsehen, den Zustand
      und die zugeh\xF6rige Munition \xFCberpr\xFCfen.\n\t\t\t\t\t\t\t\tEbenso kannst
      du in Abschnitt [R\xFCstung] R\xFCstungen anlegen und deren Eigenschaften und
      ihren Zustand \xFCberpr\xFCfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629799
    m_Localized: "Der Abschnitt [Ausr\xFCstung] zeigt alle Gegenst\xE4nde an, die
      du verwenden kannst - Medikamente, Reparaturs\xE4tze, B\xFCcher usw.\n\t\t\t\t\t\t\t\tDu
      kannst Gegenst\xE4nde von hier \xFCber die PipBuck-Oberfl\xE4che oder im Spiel
      mit der Taste @1 verwenden.\n\t\t\t\t\t\t\t\tDr\xFCcke @5, um den Gegenstand
      zu verwenden, welcher in der oberen linken Ecke des Bildschirms direkt unter
      deiner Gesundheitsleiste angezeigt wird. Dr\xFCcke @2 oder @3, um den vorherigen
      oder n\xE4chsten Gegenstand auszuw\xE4hlen.\n\t\t\t\t\t\t\t\tUm Medikamente
      zu verwenden, kannst du die Schnelltaste @4 dr\xFCcken - wodurch der am besten
      geeignete Heiltrank wird verwendet."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629800
    m_Localized: "Die Abschnitte [Munition] und [Sonstiges] enthalten den ganzen
      Rest deiner Ausr\xFCstung - Munition, Artefakte, wertvolle Gegenst\xE4nde und
      M\xFCll aller Art."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629801
    m_Localized: "Oh nein, dar\xFCber kann ich nicht springen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629802
    m_Localized: Es sei denn...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629803
    m_Localized: "Ich k\xF6nnte mir selbst einen kleinen Telekinese-Sto\xDF geben!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629804
    m_Localized: Tutorial beendet
    m_Metadata:
      m_Items: []
  - m_Id: 2733629805
    m_Localized: "Eine Gang? Sieht so aus, als k\xE4me von da Licht. Das ist vermutlich
      der Ausgang."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629806
    m_Localized: Und links ist nur Dunkelheit. Ich glaube, ich sollte zum Ausgang
      gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629807
    m_Localized: Oder sollte ich lieber zuerst den restlichen Bereich erkunden?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629808
    m_Localized: Du hast erfolgreich den Ausgang erreicht und steigst eine Stufe
      auf!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629809
    m_Localized: "Mit jeder Stufe erh\xE4lst du Fertigkeitspunkte und Talente. Verwende
      sie, um deine Fertigkeiten zu verbessern - \xFCber den PipBuck, im Bereich
      \"Status\" und \"Fertigkeiten\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629810
    m_Localized: Oh oh... Mit dem Wasser stimmt doch was nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629811
    m_Localized: "Soweit ich wei\xDF, sollte es eine andere Farbe haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629812
    m_Localized: "Dieses Deckengesch\xFCtz sieht gef\xE4hrlich aus und ich habe nicht
      einmal eine anst\xE4ndige Waffe. Ich glaube nicht, dass es sinnvoll w\xE4re,
      dagegen anzuk\xE4mpfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629813
    m_Localized: "Eigentlich auch nicht n\xF6tig, oder? Wenn ich auf die andere Seite
      will, kann ich mich einfach daran vorbei schleichen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629814
    m_Localized: Also gut, lass es uns versuchen!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629815
    m_Localized: "Gesch\xFCtzt\xFCrme"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629816
    m_Localized: "Gesch\xFCtzt\xFCrme sind station\xE4re Verteidigungsroboter, die
      an bestimmten Orten installiert und mit leistungsstarken Waffen ausgestattet
      sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629817
    m_Localized: "Im Kampfmodus erkennen sie automatisch feindliche Ziele in der
      N\xE4he und er\xF6ffnen ohne Vorwarnung das Feuer."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629818
    m_Localized: "Es gibt im \xD6dland einige funktionierende T\xFCrme aus der Vorkriegszeit,
      die auch nach all den Jahren noch anvertraute Objekte bewachen. Dieser Umstand
      definitiv ein gro\xDFes Problem f\xFCr diejenigen, die darauf aus sind, von
      Industrieanlagen und milit\xE4rischen Einrichtungen leichte Beute zu bekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629819
    m_Localized: "Gl\xFCcklicherweise sind Gesch\xFCtzt\xFCrme trotz ihrer t\xF6dlichen
      Feuerkraft relativ leicht zu entfernen. Du kannst Panzerbrechende oder Impulswaffen
      verwenden oder sie einfach \xFCber das Sicherheitsterminal abschalten. Aber
      am wichtigsten - vermeide es getroffen zu werden, was nicht so schwer ist.
      Da sich die T\xFCrme nicht bewegen k\xF6nnen, werden sie dich nicht verfolgen,
      nachdem du ihren Erfassungsbereich verlassen hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629820
    m_Localized: Bloatsprites
    m_Metadata:
      m_Items: []
  - m_Id: 2733629821
    m_Localized: "Von Bloatsprites nimmt man an, dass es sich um ehemalige Parasprites
      handelt, die durch magische Strahlenbelastung mutiert sind.\n\t\t\t\t\tW\xE4hrend
      sie neue, gef\xE4hrliche F\xE4higkeiten erlangt haben, haben sie auch die ber\xFCchtigte
      Gabe der schnellen Fortpflanzung ihrer Vorfahren geerbt, daher kannst du etliche
      von ihnen finden, die durch das Equestria-\xD6dland streifen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629822
    m_Localized: "Einige von ihnen k\xF6nnen giftige Dornen und S\xE4ure spucken,
      andere greifen ihre Beute mit sehr scharfen Z\xE4hnen an.\n\t\t\t\t\tDer gef\xE4hrlichste
      Typ injiziert Eier in den K\xF6rper des Opfers, und das neugeborene Ungeziefer
      frisst es dann von innen heraus auf."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629823
    m_Localized: "W\xE4hrend einzelne Bloatsprites keine gro\xDFe Bedrohung darstellen,
      kann ein Schwarm dir gro\xDFe Probleme bereiten. Diese Kreaturen sind schwer
      mit Kugeln zu t\xF6ten, versuche es mit Magie und Nahkampfwaffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629824
    m_Localized: "Da ist definitiv etwas hinter dieser Wand. Ich kann eine Art verd\xE4chtiges
      Summen h\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629825
    m_Localized: "Hmm... diese Wand sieht nicht besonders massiv aus. Ich k\xF6nnte
      versuchen ein Loch da hinein zu schlagen, aber ist es das auch Wert?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629826
    m_Localized: "Das ist eine ganz sch\xF6ne Menge Sprengstoff! Ich k\xF6nnte versuchen
      es zu entsch\xE4rfen aber ich bezweifle dass meine F\xE4higkeiten daf\xFCr
      hoch genug sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629827
    m_Localized: "Ich k\xF6nnte auch einfach darauf schie\xDFen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629828
    m_Localized: "Aber vorher gehe ich lieber ein paar Schritte zur\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629829
    m_Localized: "Hoffentlich st\xFCrzt die Decke nicht \xFCber mir ein..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629830
    m_Localized: Nachricht vom Mentor
    m_Metadata:
      m_Items: []
  - m_Id: 2733629831
    m_Localized: "Pl\xF6tzlich schaltet sich dein PipBuck von selbst ein. Die \xFCbliche
      Benutzeroberfl\xE4che auf dem Bildschirm wird durch eine Reihe von Symbolen
      ersetzt, die W\xF6rter und S\xE4tze bilden. Du verstehst nicht, was los ist,
      denn du wei\xDFt dass die Standard-PipBuck-Software sowas nicht kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629832
    m_Localized: "Gr\xFC\xDFe, \"Chosen-25\" @lp. Ich bin der Mentor, meine Aufgabe
      ist es, deine Handlungen zu lenken und dir den Weg zu weisen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629833
    m_Localized: Was?! Was ist das jetzt? Wer redet da mit mir ... und wie kann ich
      dir antworten?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629834
    m_Localized: "Du m\xF6chtest wahrscheinlich wissen, wer ich bin, wie ich in deinem
      PipBuck gekommen bin und warum du \xFCberhaupt auf mich h\xF6ren solltest.
      Deine Fragen sind mehr als verst\xE4ndlich und ich werde sie nat\xFCrlich so
      gut wie m\xF6glich beantworten.\nVorerst muss meine Identit\xE4t geheim bleiben.
      Eine Sache, die ich dir sagen kann ist dass wir beide uns gut kennen, und ich
      bin keineswegs dein Feind.\nDiese Nachrichten wurden im Voraus auf deinem PipBuck
      hochgeladen und werden dir jetzt angezeigt. Und wenn ich richtig liege, was
      du jetzt denkst - nein, es gibt keine direkte Verbindung. Du kannst mir momentan
      noch nicht antworten oder mir Fragen stellen.\nHier ist mein erstes und wichtigstes
      Argument, warum du auf mich h\xF6ren solltest."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629835
    m_Localized: "Der PipBuck beginnt mit der Wiedergabe einer Audioaufnahme. Erstaunlicherweise
      ist darauf meine eigene Stimme zu h\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629836
    m_Localized: "Hallo, @lp der Zukunft - sagte @lp, das bin ich erst vor ein paar
      Tagen. - Ich \xFCberlasse dir ... ich meine, mir ... diese Nachricht, um die
      Situation kurz zu erkl\xE4ren. Vor einiger Zeit bist du mit einer seltsamen
      L\xFCcke in deiner Erinnerung an einem unbekannten Ort aufgewacht. Und so wie
      ich mich selbst kenne werde ich niemanden Glauben schenken au\xDFer mir selbst.
      Lass mich dir Folgendes sagen:\nIch, das hei\xDFt du, wurdest mit einer sehr
      wichtigen Mission betraut. Wirklich wichtig f\xFCr den gesamten Stable, und
      ich, also du, bin wirklich davon \xFCberzeugt. Gegenw\xE4rtig stehst du unter
      dem Einfluss eines Zaubers, der einige deiner Erinnerungen blockiert. Ich..
      du warst damit einverstanden, diesen Bann absolut freiwillig und ohne den geringsten
      Zwang oder die geringste Bedrohung auf dich zu nehmen. Ich habe es getan, weil
      es notwendig war. Vertraue mir einfach ... das hei\xDFt, dir selbst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629837
    m_Localized: "Aus Sicherheitsgr\xFCnden wirst du dich nicht erinnern, wo sich
      dein Zuhause, deine Freunde und Familie befinden. Aber wisse, dass es nur vor\xFCbergehend
      ist. Befolge vorerst einfach die Anweisungen des Mentors, er wird dir sagen,
      was zu tun ist. Er wird dich nicht anl\xFCgen, das kann ich dir versichern.
      W\xE4hrend du auf einer Mission bist, lautet dein Codename \"Chosen-25\". Das
      ist alles Viel Gl\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629838
    m_Localized: Die Aufnahme wurde beendet und auf dem Bildschirm werden neue Nachrichten
      angezeigt.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629839
    m_Localized: "Nun, da wir mit den Hauptfragen fertig sind, sende ich dir deine
      Anweisungen. Denke daran, es liegt in deinem Interesse, diese so schnell wie
      m\xF6glich auszuf\xFChren.\nBald gelangst du an einem Ort namens \"Equestrianisches
      \xD6dland\". Sei dort \xE4u\xDFerst vorsichtig, nach meinen Informationen ist
      dieser Ort sehr gef\xE4hrlich. Du k\xF6nntest aggressiven wilden Ponys und
      mutierten Tieren begegnen. Mit Strahlung kontaminierte Bereiche sind ebenfalls
      eine Gefahr. Versuche Kontakt mit Einheimischen aufzunehmen.\nDu erh\xE4lst
      die n\xE4chste Nachricht, wenn die Zeit gekommen ist. Denke daran, deine Aufgabe
      ist f\xFCr uns alle sehr wichtig. Bis zum n\xE4chsten Mal, \"Chosen-25\""
    m_Metadata:
      m_Items: []
  - m_Id: 2733629840
    m_Localized: "Die Nachrichten verschwinden und der PipBuck kehrt zum Normalzustand
      zur\xFCck. Im Bereich \"Aufgaben\" werden neue Eintr\xE4ge angezeigt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629841
    m_Localized: Ich erinnere mich an meinen Stable! Ich erinnere mich an irgendwas
      ... undeutlich ...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629842
    m_Localized: Argh!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629843
    m_Localized: "Ged\xE4chtniszauber? Wie konnte ich dem nur zustimmen? Aber das
      war bestimmt meine Stimme auf dem Band, und wenn ich mir so sicher gewesen
      bin dass ich diesem ... Mentor vertraut habe, muss es Gr\xFCnde daf\xFCr gegeben
      haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629844
    m_Localized: "Auf jeden Fall habe ich keine gro\xDFe Wahl. Entweder bleibe ich
      f\xFCr immer an diesen Ort oder ich f\xFChre die Anweisungen des Mentors aus,
      und dann werden wir sehen, was als n\xE4chstes kommt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629845
    m_Localized: "Also das ist das Equestrianische \xD6dland?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629846
    m_Localized: "Es ist so... ger\xE4umig..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629847
    m_Localized: Oh! Mir wird schwindlig!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629848
    m_Localized: Ich kann nicht glauben dass ich wirklich in einem Rattenloch herum
      krieche...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629849
    m_Localized: "Warum mache ich das \xFCberhaupt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629850
    m_Localized: Erste Begegnung mit einem Banditen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629851
    m_Localized: Warte, ich glaube, ich habe dort ein Pony gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629852
    m_Localized: E.F.S. zeigt ein feindliches Ziel! Auch wenn es ein Pony ist, scheint
      es nicht sehr freundlich zu sein.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629853
    m_Localized: Sollte ich dennoch wirklich zuerst angreifen? Oder sollte ich zumindest
      versuchen, mit ihm zu reden?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629854
    m_Localized: "\xC4hm.. Hallo! Lebst du hier? Ich..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629855
    m_Localized: Wha? Wer verdammt bist du???|Wha? Wer zum Heuhaufen bist du denn???
    m_Metadata:
      m_Items: []
  - m_Id: 2733629856
    m_Localized: Hey, alle ponys mal her kommen! Hier wirds gleich lustig!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629857
    m_Localized: "Ich... habe ein Pony get\xF6tet?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629858
    m_Localized: Nein! Was auch immer das gewesen ist, an diesem Psycho war nicht
      mehr viel von einem Pony!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629859
    m_Localized: Hinterhalt der Banditen
    m_Metadata:
      m_Items: []
  - m_Id: 2733629860
    m_Localized: "Hallo, kleines Pony. Was machst du hier so ganz alleine? Willst
      du dich nicht ein wenig mit uns am\xFCsieren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629861
    m_Localized: "Du willst spielen, was? Na dann komm mal her, mal sehen, wer von
      und mehr Spa\xDF haben wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629862
    m_Localized: "Ha-ha-ha, so mag ich das! Heute ist unser Gl\xFCckstag. Jetzt werden
      wir..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629863
    m_Localized: Huh, Was zum?|Huh, Was zum Heuhaufen?!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629864
    m_Localized: Hey ya! In Deckung!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629865
    m_Localized: Begegnung mit Calamity
    m_Metadata:
      m_Items: []
  - m_Id: 2733629866
    m_Localized: "Hey, bist du verr\xFCckt oder was, alleine hier herumzuspazieren?
      Ich bin froh, dass ich gerade rechtzeitig gekommen bin, sonst kann ich mir
      gar nicht vorstellen, was diese Banditen mit dir angestellt h\xE4tten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629867
    m_Localized: "\xC4hmm... danke f\xFCr die Hilfe, aber ich hatte alles im unter
      Kontrolle."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629868
    m_Localized: "Aha, aber sicher. Dein \"unter Kontrolle\" konnte ich sehen. Ein
      Pony ohne R\xFCstung mit einer einfachen Waffe gegen einen ganzen Haufen Drecks\xE4cke."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629869
    m_Localized: Warum schaust du mich so an?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629870
    m_Localized: Tut mir leid Ich habe noch nie zuvor ein Pegasus gesehen. In unserem
      ... Ich meine, an dem Ort, von dem ich komme, gab es keine Pegasi.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629871
    m_Localized: "Ah, ich verstehe! Ja ich sch\xE4tze, von uns gibt es nicht so viele
      im \xD6dland ... Moment, von was f\xFCr einen Ort redest du?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629872
    m_Localized: Nun ... ich bin kein Einheimischer, mein Zuhause ist weit weg.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629873
    m_Localized: "Wie weit?.. Ahh halte deine Pferde im Zaum. Ich rate mal: Bist
      aus einem Stable? Kein Wort! Du musst von dort sein! Dieses lustige Kost\xFCm.
      Ja, jetzt ist alles klar. Um ehrlich zu sein, es gibt so wenige Stable in denen
      noch Ponys leben, dass ich Ponys wie euch heutzutage nur noch selten treffe."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629874
    m_Localized: "Du hast recht. Aber lass uns jetzt nicht dar\xFCber reden, in Ordnung?
      Du bist einer der Einheimischen, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629875
    m_Localized: "Nun, das k\xF6nnte man wohl so sagen. Sch\xF6n dich zu treffen,
      Ich bin Calamity"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629876
    m_Localized: "Sch\xF6n auch dich zu treffen, ich bin @lp. H\xF6r zu, Calamiti,
      wenn es dir nicht zu viel M\xFChe macht, kannst du mir den Weg zur n\xE4chsten
      Stadt oder einer anderen Siedlung zeigen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629877
    m_Localized: "Nat\xFCrlich, ich werde dich sogar begleiten. In der N\xE4he gibt
      es ein Lager, \"Das T\xE4nzelnde Pony\". Ich bin mir sicher, dort wirst du
      alles finden, was du brauchst. Sag mir, wenn du bereit bist aufzubrechen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629878
    m_Localized: "Herzliche Gl\xFCckw\xFCnsche! Du hast [die erste Ebene der Fabrik]
      geschafft. Um zur [zweiten Ebene] zu gelangen, gehe durch die T\xFCr zu deiner
      Rechten. In jeder n\xE4chsten Ebene warten neue Pr\xFCfungen, neue Feinde und
      neue Belohnungen auf dich!\nAu\xDFerdem kannst du das [MAS Terminal] benutzen
      und dich zum Lager teleportieren wo du deine Vorr\xE4te auff\xFCllen und dich
      heilen kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629879
    m_Localized: "Aha, mal sehen ... das sieht aus wie eine \xDCbersicht der gesamten
      Fabrik..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629880
    m_Localized: Jetzt bin ich auf der ersten Ebene. Darunter sind die zweite, dritte
      und ... viele mehr.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629881
    m_Localized: "Der Zentralrechner, den ich suche, befindet sich in der Abteilung
      f\xFCr Spezialforschungen. Die Zug\xE4nge befinden sich auf der dritten Ebene
      und darunter. Ich muss also tiefer gehen. Ja, und es scheint, als ob ich einen
      Sicherheitszugriff-Schl\xFCssel ben\xF6tige um dort hinein zu gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629882
    m_Localized: "Ja.. diese Fabrik ist echt riesig. Wenn ich wollte, k\xF6nnte ich
      sie f\xFCr immer erkunden..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629883
    m_Localized: "Ja, es scheint als w\xE4re ich auf dem richtigen Weg. Die Sonderforschungsabteilung
      ist den Korridor hinunter."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629884
    m_Localized: "Gehe geradeaus den Korridor entlang, um zur [Sonderforschungsabteilung]
      zu gelangen und deine Mission zu erf\xFCllen. Oder gehe durch die [Ausgang]
      -T\xFCr, um eine neue Werksebene zu erkunden. Du kannst hierher zur\xFCckkehren,
      wenn du bereit daf\xFCr bist."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629885
    m_Localized: "Sieht so aus, als w\xE4re das die Abteilung f\xFCr Spezialforschungen.
      Jetzt muss ich den Zentralrechner finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629886
    m_Localized: Systemfehler. Bitte kontaktieren sie den Administrator
    m_Metadata:
      m_Items: []
  - m_Id: 2733629887
    m_Localized: "Erstes Gespr\xE4ch mit dem Mentor"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629888
    m_Localized: "Du verbindest deinen PipBuck mit dem Zentralrechner-Terminal. Eine
      Weile passiert nichts, dann laufen eine Reihe von Schriftzeichen durch den
      PipBuck-Bildschirm, die dann durch eine Download-Anzeige ersetzt werden. Danach
      erwacht der gro\xDFe Bildschirm des Terminals zum Leben und eine Zeile nach
      der anderen erscheint."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629889
    m_Localized: Autorisiere...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629890
    m_Localized: Systemstart...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629891
    m_Localized: Suche nach Dateien...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629892
    m_Localized: '"Rainbow" Projekt Dateien gefunden...'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629893
    m_Localized: "Remote-Verbindung hergestellt. Die \xDCbertragung beginnt, bitte
      warten Sie..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629894
    m_Localized: Sieht aus als liefe alles wie geplant!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629895
    m_Localized: "Pl\xF6tzlich ist eine Stimme zu h\xF6ren die irgendwo aus der Maschine
      kommt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629896
    m_Localized: "Hallo, @lp. Ich bin es, dein Mentor. Herzlichen Gl\xFCckwunsch,
      Du hast deine erste Mission erfolgreich abgeschlossen. Im Moment bekommen wir
      Daten, auf die wir fast zwei Jahrhunderte gewartet haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629897
    m_Localized: "Was? Mentor? Sprichst du \xFCber dieses Terminal zu mir? Und ich
      kann dir antworten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629898
    m_Localized: "Ja, @lp. Gerade hat dein PipBuck ein Programm auf dem Zentralrechner
      gestartet, \xFCber das wir kommunizieren k\xF6nnen. Nat\xFCrlich hast du viele
      Fragen. Jetzt kannst du sie stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629899
    m_Localized: "Fragen? Oh sicher. Wer bist du? ... und wer bin ich? Warum erinnere
      ich mich an nichts aus meiner Vergangenheit? Und ... was sind das f\xFCr Daten
      nach denen du gesucht hast?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629900
    m_Localized: "Die Antworten auf all diese Fragen h\xE4ngen miteinander zusammen.
      Ich bin wirklich dein Mentor, ein Pony, das du dein ganzes Leben lang gekannt
      hast. Ich kann dir meinen Namen noch nicht sagen. Dein Zuhause, der Ort, an
      dem du geboren und aufgewachsen bist ist Stable Pi. Ich habe keine Befugnis,
      Einzelheiten dar\xFCber oder \xFCber die Dateien, die du gefunden hast, offenzulegen.
      Diese Informationen sind streng vertraulich. F\xFCr die Sicherheit unseres
      gemeinsamen Zuhauses mussten wir dir die Erinnerung daran nehmen. Falls du
      vom Feind gefangen genommen werden w\xFCrdest, h\xE4tten sie nie etwas von
      dir erfahren. Ich hoffe, du verstehst das."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629901
    m_Localized: "War das wirklich n\xF6tig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629902
    m_Localized: "Leider ja. Wir haben viele Feinde. Wenn du die Mission abgeschlossen
      hast und zur\xFCckkommst, l\xF6se ich den Zauber und die Erinnerungen kehren
      zu dir zur\xFCck. Aber nicht vorher. Du selbst hast diesen Bedingungen zugestimmt,
      oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629903
    m_Localized: "Ja, ich habe die Aufnahme geh\xF6rt. Aber das macht es nicht einfacher!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629904
    m_Localized: Das verstehe ich ... aber ich glaube daran, dass du Erfolg haben
      wist.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629905
    m_Localized: "Kannst du mir wenigstens etwas \xFCber den Zweck meiner Mission
      erz\xE4hlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629906
    m_Localized: "Das ist der Hauptgrund, warum wir uns gerade unterhalten. Lange
      vor Kriegsende war Stable Pi eine geheime Zuflucht f\xFCr Wissenschaftler und
      Ingenieure, die an den wichtigsten Forschungen f\xFCr die Equestria-Armee beteiligt
      waren. Nachdem die Bomben gefallen waren und die Zeit des alten Equestria zu
      Ende ging, wechselten wir in ein v\xF6llig autonomes Leben. Der gesamte Stablekomplex
      ist tief unter der Erde der Eingang ist auf keiner Karte zu finden. Geheimhaltung
      ist uns daher sehr wichtig. Wir sind keine Krieger, wir k\xF6nnen unser unsch\xE4tzbares
      Wissen nicht vor der Gier der \xD6dlandbewohner sch\xFCtzen. Deshalb treten
      wir mit der Au\xDFenwelt so gut wie nie in kontakt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629907
    m_Localized: "Aha. Aber warum musstest du mich an die Oberfl\xE4che schicken?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629908
    m_Localized: "Eine der letzten Entwicklungen von Stable Pi vor dem J\xFCngsten
      Gericht war das \"Sun\" Projekt. Ich kann dir nichts dar\xFCber erz\xE4hlen,
      aber es ist nicht nur f\xFCr unsere kleine Gemeinschaft, sondern f\xFCr ganz
      Equestria \xE4u\xDFerst wichtig. Leider war das Projekt zu damaligen Zeitpunkt
      noch nicht abgeschlossen, da es in engem Zusammenhang mit einer anderen wichtigen
      Entwicklung stand. Gleichzeitig wurde parallel in den ManeTec-Laboren an dem
      Projekt \"Rainbow\" gearbeitet. Nach unseren Informationen war dieses zweite
      Projekt abgeschlossen und der gesamte Satz an Pl\xE4nen und technischen Dokumentationen
      sollte an uns gesendet werden. Aber aus irgendeinem Grund ist das nie passiert.
      Die Kommunikationsverbindung mit deren Zentralrechner blieb zwar bestehen,
      der Server reagierte jedoch nicht auf unsere Versuche, die Daten per Fernzugriff
      zu senden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629909
    m_Localized: "Und deswegen musste ich diesen Server wieder zum Laufen bringen?
      Und warum hast du mich \"Chosen-25\" genannt? Und warum hast du mich geschickt?
      War ich wirklich die beste Wahl f\xFCr diese wichtige Mission?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629910
    m_Localized: "Der Titel \"Auserw\xE4hlter\" hat Tradition. Der erste Versuch,
      einen Abgesandten an die Oberfl\xE4che zu schicken, wurde vor fast hundert
      Jahren unternommen. Er wurde der \"Auserw\xE4hlte\" genannt, weil er aus vielen
      Kandidaten wegen seiner Kompetenz gew\xE4hlt wurde. Er wurde durch einen Teleportationszauber
      ins \xD6dland gebracht, erf\xFCllte jedoch die Mission nicht und kehrte nie
      zur\xFCck. Dann haben wir andere geschickt. K\xE4mpfer und Diplomaten, starke
      und gerissene, einzelne und ganze Einheiten. Es gab also \"Chosen-2\", \"Chosen-3\"
      und so weiter. Niemandem gelang es. Aber dir. Also ja, es stellt sich also
      am Ende heraus, dass du die beste Wahl warst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629911
    m_Localized: "Ich bin froh, dass ich helfen konnte. Kann ich jetzt zur\xFCckkommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629912
    m_Localized: "Tut mir leid, aber nein. Das Senden der Dateien war das erste,
      aber nicht unser einzige Ziel. F\xFCr die Projekte \"Sun\" und \"Rainbow\"
      ben\xF6tigen wir auch einige Komponenten, die wir im Stable Pi nicht haben.
      Du musst sie finden. Wir brauchen Zeit, um die empfangenen Pl\xE4ne zu studieren,
      aber eine der fehlenden Komponenten ist bereits bekannt. Es ist der Quanten
      Kogitator, und wir haben Belege daf\xFCr, dass er sich im Stable 88 befinden
      sollte - dem Forschungsstable, der unserem \xE4hnelt, aber \xFCber wesentlich
      mehr Ressourcen verf\xFCgt und sich auf Forschung im Bereich der Robotik konzentriert.
      Leider wurde aus uns unbekannten Gr\xFCnden nach dem Versiegeln des Stable
      der Kommunikationskanal unterbrochen. Deine Aufgabe ist es, den Status des
      Stable 88 zu \xFCberpr\xFCfen und den Quantum Kogitor von den Ponys zu holen,
      die ihn bewohnen. Der Eingang zu Stable 88 befindet sich an einem Ort namens
      Falls Springs."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629913
    m_Localized: Das Laden der Dateien ist fast abgeschlossen, die Verbindung wird
      jeden Augenblick unterbrochen. Hast du noch mehr fragen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629914
    m_Localized: "Eigentlich habe ich viele Fragen. Wie w\xE4re es mit..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629915
    m_Localized: "Datei\xFCbertragung abgeschlossen. Verbindung getrennt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629916
    m_Localized: Luna verdammt!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629917
    m_Localized: "Das hei\xDFt, ich stecke hier f\xFCr l\xE4ngere Zeit fest? Und
      au\xDFerdem muss ich wieder mein Leben riskieren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629918
    m_Localized: "Aber \"ich\" aus der Vergangenheit war \xFCberzeugt von der Wichtigkeit
      dieser Mission. Habe ich damals alles \xFCber meine zuk\xFCnftige Mission gewusst?
      Dass ich so lange hier bleiben w\xFCrde?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629919
    m_Localized: "Aber selbst wenn nicht, hei\xDFt das nicht, dass ich aufh\xF6ren
      muss. Die mir anvertraute Aufgabe ist \xE4u\xDFerst wichtig, und das bedeutet,
      dass ich sie erf\xFCllen muss. So oder so."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629920
    m_Localized: Informationen aus dem Zentralrechner erhalten
    m_Metadata:
      m_Items: []
  - m_Id: 2733629921
    m_Localized: "In Ordnung gut. Vielleicht m\xF6chte mir dieses kleine schlaue
      Metallding noch etwas sagen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629922
    m_Localized: 'Abfrage: Projekt "Sun"'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629923
    m_Localized: "*Suche abgeschlossen*\n\t\t\t\t\t*Dateien Gefunden: 0*\n\t\t\t\t\t*Protokoll
      \xDCbereinstimmungen: 5*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629924
    m_Localized: Das war's schon?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629925
    m_Localized: 'Abfrage: Projekt "Rainbow"'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629926
    m_Localized: "*Suche abgeschlossen*\n\t\t\t\t\t*Dateien Gefunden: 0*\n\t\t\t\t\t*Protokoll
      \xDCbereinstimmungen: 5*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629927
    m_Localized: "Arrgh! Sieht so aus, als ob die Dateien nach der \xDCbertragung
      aus dem Speicher gel\xF6scht wurden. Toll. Einfach toll."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629928
    m_Localized: "Abfrage: Protokolle f\xFCr Projekt \"Rainbow\""
    m_Metadata:
      m_Items: []
  - m_Id: 2733629929
    m_Localized: "*Suche abgeschlossen*\n\t\t\t\t\t*Datei Historie:\n\t\t\t\t\tDatei
      heruntergeladen: vor 69 457 Tagen; \n\t\t\t\t\tDatei\xFCbertragungsversuch
      - FEHLER: DER VORGANG WURDE VOM EMPF\xC4NGER NICHT BEST\xC4TIGT. DATEI\xDCBERTRAGUNG
      ABGEBROCHEN: vor 69 425 Tagen;\n\t\t\t\t\tDatei Zugriff: vor 81 Tagen;\n\t\t\t\t\tDatei
      \xFCbertragen: vor 3 Minuten;"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629930
    m_Localized: "Sieht so aus, als w\xFCrde ich nichts Neues herausfinden ... warte,
      was ?! gut.. gut..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629931
    m_Localized: "*Datei zugriff:\n\t\t\t\t\tAuf die Datei wurde vor 81 Tagen, 5
      Stunden und 18 Minuten von einem autorisierten PipBuck-Ger\xE4t mit Seriennummer
      PX 457095004132 L zugegriffen*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629932
    m_Localized: "Ein PipBuck Benutzer, h\xE4? Ich kann mich nicht erinnern, jemanden
      an der Oberfl\xE4che mit einem PipBuck gesehen zu haben. Was w\xE4re wenn ...
      was w\xE4re wenn es \"Chosen-24\" gewesen ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629933
    m_Localized: "Ja, Sie muss es sein. Vielleicht ist sie schon weit von hier entfernt,
      oder sogar tot. Trotzdem sollte ich versuchen, sie zu finden. Was, wenn sie
      im \"Tanzenden Pony\" gewesen ist? Ich muss Calamity fragen - wenn jemand etwas
      wei\xDF dann er."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629934
    m_Localized: "Gespr\xE4ch mit Calamity \xFCber \xABChosen 24\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629935
    m_Localized: Calamity?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629936
    m_Localized: "Hall\xF6chen, @lp. brauchst du etwas?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629937
    m_Localized: Nun ja. Sag mal, hast du in den letzten Monaten jemanden wie mich
      gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629938
    m_Localized: Huh? Du meinst jemanden der wie du aussiehst? Jemand kleines? Oder
      ein Abenteurer wie du?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629939
    m_Localized: "\xC4hm... Nein, das nicht. Ich meine, jemanden aus dem Stable."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629940
    m_Localized: "Ach, diese Art jemand. Ayep, einen habe ich gesehen. Eine ungew\xF6hnliche
      Person, um ehrlich zu sein, k\xF6nnte daran liegen dass sie aus dem Stable
      ist. Aber das Herz am rechten Fleck. Ich wollte dich noch fragen, ob sie eine
      Freundin von dir ist, aber irgendwie ist mir das entfallen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629941
    m_Localized: "Jedenfalls ist sie vor drei oder vier Monaten hier hergekommen.
      Sie war hungrig und schwach, und blieb an der Praxis vom Dok stehen als sie
      dort vorbei kam. Er hatte gerade ein paar unserer Jungs versorgt, die von Banditen
      angegriffen wurden. Sie ging hinein, redete ungef\xE4hr f\xFCnf Minuten lang
      mit ihm \xFCber irgendetwas und blieb dann dort. Seitdem arbeitete sie mit
      dem Dok. Er lobte sie sehr, aber murrte auch dauernd, weil unser Neuling st\xE4ndig
      versuchte, kranke kostenlos zu behandeln."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629942
    m_Localized: Und warum ist sie nicht mehr hier? Hat Doktor Sepsis sie rausgeschmissen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629943
    m_Localized: "Nein, das sicher nicht. Aber ich bef\xFCrchte dass noch etwas schlimmeres
      passiert sein k\xF6nnte. Aber wei\xDFt du, frag doch den Dok lieber selbst
      ... Er wird dir das alles besser erz\xE4hlen k\xF6nnen als ich."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629944
    m_Localized: "Gespr\xE4ch mit dem Dok \xFCber Velvet"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629945
    m_Localized: "Doktor, wir m\xFCssen uns unterhalten. Es ist sehr wichtig..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629946
    m_Localized: Wenn es venerisch ist, lass uns lieber hinter den Vorhang gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629947
    m_Localized: "Was?! Nein, sowas nicht. Ich m\xF6chte dich nach einem Stable-Bewohner
      fragen. Kanntest du sie? Mir wurde gesagt, dass sie dir vor einiger Zeit hier
      in der Klinik geholfen hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629948
    m_Localized: "Ah, aber nat\xFCrlich erinnere ich mich an sie. Velvet Remedy -
      so hie\xDF sie. Ja, sie hat mir hier eine Weile geholfen. Sehr kompetent und
      gut in Medizin, obwohl sie Autodidaktin ist. Sie hat viel aus B\xFCchern gelernt,
      das hat man sofort gemerkt. Wenig \xDCbung, vor allem in Chirurgie."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629949
    m_Localized: Aber sehr nett, sogar zu sehr. Sie wollte jeden Pony kostenlos helfen.
      Und nicht nur Ponys, jeder Kreatur. Wir hatten ein paar Streitereien mit ihr,
      weil ihre Freundlichkeit die Klinik in eine Schiflage brachte. Aber wir haben
      einen Kompromiss gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629950
    m_Localized: "Sie fragte viel \xFCber unser Leben hier, aber vor allem interessierte
      sie sich f\xFCr Ghule. Sie versuchte, das Geheimnis ihres Anti-Lebens zu enth\xFCllen,
      und glaubte mir nicht, dass dies die schwarze Magie der Zebras sei. Infolgedessen
      beschloss sie, selbst nach der Wahrheit zu suchen. Dumme Idee, wenn du mich
      fragst. Ghule k\xF6nnen nicht mehr geheilt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629951
    m_Localized: "Zuerst suchte sie nur nach ihnen ... Ich habe versucht, sie davon
      abzubringen, aber es war zwecklos. Dann sagte sie, dass sie herausgefunden
      habe, wo diese Kreaturen am h\xE4ufigsten vorkommen. Ich glaube, in einigen
      Abwasserkan\xE4len oder anderen verlassenen L\xF6chern. Dann ist sie einfach
      gegangen und das wars. Ich habe sie seitdem nicht mehr gesehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629952
    m_Localized: "Schade ... wahrscheinlich hat sie mehr Ghule gefunden, n\xF6tig.
      Sei vorsichtig, wiederhole nicht ihren Fehler."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629953
    m_Localized: Und du hast nicht nach ihr gesucht?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629954
    m_Localized: "Wir haben uns nach ihr umgesehen. Calamity flog herum, und hat
      sogar einige Abwasserrohre \xFCberpr\xFCft. Wir haben keine Spur von ihr gefunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629955
    m_Localized: Alles klar... Danke.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629956
    m_Localized: Keine Ursache ... Und warum fragst du nach ihr? Kanntet ihr euch?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629957
    m_Localized: Ja... Ich meine, nein...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629958
    m_Localized: "Ich wei\xDF es nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629959
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629960
    m_Localized: "Gut, dann k\xFCmmere ich mich mal wieder um meine eigenen Angelegenheiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629961
    m_Localized: "Halt! Es ist gef\xE4hrlich, weiter zu gehen! Ich muss einen anderen
      Weg finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629962
    m_Localized: Ein Lager? Hier? Interessant...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629963
    m_Localized: Ich sollte mich vorsichtig umsehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629964
    m_Localized: "Das Lager in den Abwasserkan\xE4len"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629965
    m_Localized: Alsooo.. Bisher keine Spur von Ghulen - das ist schon mal gut.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629966
    m_Localized: "Aber es gibt Anzeichen f\xFCr einen Kampf. Die Matratze ist zerknautscht,
      als ob ein paar Ponys darauf herumgestampft h\xE4tten. Ein Stapel B\xFCcher
      wurde umgeworfen. Gleiches gilt f\xFCr den Topf und die Flaschen vom Tisch.
      Sie sind zerbrochen, als w\xE4ren sie heruntergefallen, nachdem jemand auf
      den Tisch getreten hat. Oder sowas \xE4hnliches.. Und das alles ist schon eine
      ganze Weile unber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629967
    m_Localized: Auf jeden Fall aber gibt es kein Blut. Vielleicht lebt der Besitzer
      dieses Lagers noch... Ich muss noch ein paar Spuren suchen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629968
    m_Localized: Velvets Tagebuch
    m_Metadata:
      m_Items: []
  - m_Id: 2733629969
    m_Localized: "Oh, und hier ist ein Tagebuch! Es geh\xF6rt vermutlich dem Besitzer
      des Lagers. Aha... eine Unterschrift: \"Velvet Remedy\""
    m_Metadata:
      m_Items: []
  - m_Id: 2733629970
    m_Localized: "(lesen) Gut-Gut-Gut... Sie hat hier Ghule studiert und einige Experimente
      durchgef\xFChrt... Ich werde mir das Tagebuch sp\xE4ter genauer ansehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629971
    m_Localized: "Das Lager stand jedoch lange Zeit leer und sie zog offensichtlich
      nicht freiwillig aus. Wer k\xF6nnte sie hier gefunden haben, au\xDFer den Ghulen?
      ... Die Sklavenh\xE4ndler aus dem Lager oben vielleicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629972
    m_Localized: "Gespr\xE4ch mit den Gefangenen \xFCber Velvet"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629973
    m_Localized: Psst, sei leise. Ich werde dich jetzt befreien.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629974
    m_Localized: Dank dir, Fremder.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629975
    m_Localized: Wenn du wegen deiner Freundin gekommen bist, tut es mir leid, sie
      ist nicht mehr bei uns.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629976
    m_Localized: Warte, von wem redest du da?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629977
    m_Localized: "Ein anderes Pony. Wir sind mit ihr vor den Sklavenh\xE4ndlern davon
      gelaufen. Aie trug dasselbe St\xFCck Metall an ihrem Bein wie du. Bist du aus
      dem gleichen Clan wie sie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629978
    m_Localized: "Bitte, erz\xE4hle mir mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629979
    m_Localized: "Ein schwarzes Einhorn mit einer silberner M\xE4hne. Sie sagte,
      ihr Name sei Velvet Remedy. Nach der Flucht sind wir eine Weile zusammen gewandert.
      Sie sprach nicht viel \xFCber ihre Vergangenheit, aber sie war eine sehr gute
      Sanit\xE4terin. Wir trennten uns, nachdem wir auf ein paar Zebras getroffen
      waren. Diese Kreaturen lockten sie zu sich. Sie gaben vor, krank zu sein, und
      deine Freundin hat den K\xF6der geschluckt. Wir haben versucht, sie davon abzubringen,
      aber sie wollte nicht zuh\xF6ren. Inzwischen wird sie wohl im Magen der Gestreiften
      gelandet sein. Tut mir leid."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629980
    m_Localized: "Hmm... danke dass du mir das erz\xE4hlt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629981
    m_Localized: "Herzliche Gl\xFCckw\xFCnsche! Du hast [die erste Ebene der Kanalisation]
      geschafft. Du kannst die Kanalisation verlassen, indem du die Leiter nach oben
      steigst, oder tiefer hinein gehst, indem du die [Ausgang] - T\xFCr betrittst.
      In den tieferen Ebenen findest du mehr Feinde, Pr\xFCfungen und Belohnungen
      und am Ende jeder Ebene kannst du auch den Ausweg finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629982
    m_Localized: "Gespr\xE4ch mit den Gefangenen"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629983
    m_Localized: Hey! Du bist keiner von denen oder? Du siehst jedenfalls nicht so
      aus... Bitte, hilf mir!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629984
    m_Localized: "Was ist passiert? Wer hat dich in diesen K\xE4fig gesteckt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629985
    m_Localized: "Und wer sind \"die\" \xFCberhaupt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629986
    m_Localized: "Die Sklavenh\xE4ndler! Eine ganze Bande von ihnen. Sie haben uns
      bei einem \xDCberfall gefangen genommen, mich und die anderen Ponys. Und jetzt
      halten Sie uns in K\xE4figen gefangen, bis sie uns zu Filly bringen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629987
    m_Localized: "Sie entf\xFChren andere Ponys... und behandeln sie als w\xE4ren
      sie eine Art Eigentum?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629988
    m_Localized: Ja! Bitte lass mich hier nicht alleine!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629989
    m_Localized: Ich werde nicht! Weder dich noch die anderen Gefangenen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733629990
    m_Localized: "Aber der K\xE4fig ist abgeschlossen... Ich bin mir nicht sicher
      ob ich das Schloss auf bekomme..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629991
    m_Localized: "Die Sklavenh\xE4ndler m\xFCssen den Schl\xFCssel haben. H\xF6chstwahrscheinlich
      hat der Aufseher einen Zweitschl\xFCssel. Aber denk nicht einmal daran, ihn
      zu stehlen oder ihn dir mit Gewalt zu nehmen ... Es gibt zu viele von denen
      f\xFCr dich alleine."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629992
    m_Localized: Das werden wir ja sehen!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629993
    m_Localized: Wo sind die anderen Gefangenen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733629994
    m_Localized: "Ich wei\xDF nicht. Sie m\xFCssen in diesem gro\xDFen Geb\xE4ude
      dort sein. Ich hoffe sie sind so weit noch in Ordnung..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629995
    m_Localized: "Ich versuche das Schloss des K\xE4figs zu \xF6ffnen. Wenn es nicht
      klappt, muss ich den Schl\xFCssel holen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629996
    m_Localized: "Ich kann nicht glauben, dass Dinge wie diese tats\xE4chlich passieren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629997
    m_Localized: "Gespr\xE4ch mit dem Aufseher"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629998
    m_Localized: "Ahh, da bist du! Du hast hier so viel \xC4rger gemacht, was?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629999
    m_Localized: "Das stimmt. Und du musst der Aufseher sein Hast du die Schl\xFCssel
      f\xFCr die K\xE4fige der Gefangenen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630000
    m_Localized: "Logo! Du willst das ganze Fleisch frei lassen? Nun, ich habe die
      Schl\xFCssel. Komm her ... damit ich sie dir geben kann..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630001
    m_Localized: Begegnung mit Butch
    m_Metadata:
      m_Items: []
  - m_Id: 2733630002
    m_Localized: "Oh, wow... du bist echt ein Riese! K\xF6nnen Ponys tats\xE4chlich
      so gro\xDF werden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630003
    m_Localized: "Ahhh, schei\xDFe ich raffs nicht! Was verdammt noch mal ist hier
      los??? Was sollen die ganzen Sch\xFCsse? Hast du deinen verdammten Verstand
      verloren?|Er, Ich verstehs nicht! Was zum Heuhaufen geht hier vor??? Was sollten
      die ganzen Sch\xFCsse? Hast du deinen verdammten Verstand verloren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630004
    m_Localized: "HEY, SEID IHR VERFICKT NOCH MAL TAUB!!?? BEWEGT EURE \xC4RSCHE
      HIER HER IHR BASTARDE!!!|HEY, SEID IHR TAUB!!?? KOMMT HER IHR BASTARDE, SOFORT!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630005
    m_Localized: "Spare dir deinen Atem gro\xDFer, kein Pony wird kommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630006
    m_Localized: Was quietscht da unten so? Wer bist du, ein Floh?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630007
    m_Localized: Deine Bande ist erledigt und deine Gefangenen sind frei. Irgendwelche
      letzten Worte?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630008
    m_Localized: "Ich werde dich mit meinem linken Huf zermalmen, kleine Fotze. Das
      wars f\xFCr dich! |Ich werde dich mit meinem linken Huf zermalmen, Pipsqueak.
      Das wars f\xFCr dich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630009
    m_Localized: Sharp Shooters Brief
    m_Metadata:
      m_Items: []
  - m_Id: 2733630010
    m_Localized: "Butch! Du Hurensohn! Nicht nur, dass du meinen Anweisungen nicht
      folge geleistet hast, sondern du verdr\xFCcktst dich auch noch, damit ich dir
      nicht pers\xF6nlich in den Arsch treten kann? Vergiss nicht, wenn ich herausfinde,
      dass du deine Aufgaben noch einmal ignorierst, wird diese Aktion deine letzte
      in meinem Kader gewesen sein!\nHabe ich dir nicht befohlen dich auf die suche
      zu machen? Habe ich, und du Wichser kannst es nicht leugnen. Du wurdest angewiesen,
      deine Jungs zu sammeln und pers\xF6nlich um 15:28 Uhr beim Eingang vom Stable
      zu erscheinen. Das sollte gestern erledigt werden! Was zum Teufel hast du die
      ganze Zeit getrieben? Rumsitzen, saufen und dich an den Eiern kratzen?\nDeine
      letzte Chance: Heute Abend wirst du ein Dutzend deiner Bastarde nehmen und
      meinen Befehl ausf\xFChren, um das Haus dieser s\xFC\xDFen Schlampe mit PipBuck
      zu finden, die deine Jungs vor einer Woche aufgelesen haben. Es k\xF6nnte einen
      Bunker nur ein paar Meilen unter der Erde geben, der randvoll mit feinstem
      Fleisch ist, den wir uns nicht entgehen lassen k\xF6nnen. Verstehst du, Butch?
      Das k\xF6nnen wir einfach nicht!\nWenn ich vom Stable 88 zur\xFCckkomme und
      du immer noch hier bist, IST DEIN ARSCH F\xC4LLIG!\nUnd ja: Wenn ich herausfinde,
      dass deine Jungs den wahren Zweck dieses kleinen Spaziergangs erfahren, schneide
      ich dir pers\xF6nlich die Zunge raus.\n\nSharp Shooter | Butch! Du Bastard!
      Nicht nur, dass du meinen Anweisungen nicht folge geleistet hast, sondern du
      verdr\xFCcktst dich auch noch, damit ich dir nicht pers\xF6nlich in den Arsch
      treten kann? Vergiss nicht, wenn ich herausfinde, dass du deine Aufgaben noch
      einmal ignorierst, wird diese Aktion deine letzte in meinem Kader gewesen sein!\nHabe
      ich dir nicht befohlen dich auf die suche zu machen? Habe ich, das kannst du
      nicht leugnen. Du wurdest angewiesen, deine Jungs zu sammeln und pers\xF6nlich
      um 15:28 uhr dem Eingang vom Stable zu erscheinen. Das sollte gestern erledigt
      werden! Was zum Teufel hast du die ganze Zeit getrieben? Rumsitzen, saufen
      und dich an den Eiern kratzen?\nDeine letzte Chance: Heute Abend wirst du ein
      Dutzend deiner Bastarde nehmen und meinen Befehl ausf\xFChren, um das Haus
      dieses s\xFC\xDFen Sch\xE4tzchens mit PipBuck zu finden, die deine Jungs vor
      einer Woche aufgelesen haben. Es k\xF6nnte einen Bunker nur ein paar Meilen
      unter der Erde geben, der randvoll mit feinstem Fleisch ist, den wir uns nicht
      entgehen lassen k\xF6nnen. Verstehst du, Butch? Wir k\xF6nnen nicht!\nWenn
      ich vom Stable 88 zur\xFCckkomme und du immer noch hier bist, IST DEIN ARSCH
      F\xC4LLIG!\nUnd noch etwas: Wenn ich herausfinde, dass deine Jungs den wahren
      Zweck dieses kleinen Spaziergangs erfahren, schneide ich dir pers\xF6nlich
      die Zunge raus.\n\nSharp Shooter"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630011
    m_Localized: Licht, Wasser und firsche Luft!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630012
    m_Localized: "Verfickte Schei\xDFe!|Echt s\xFC\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630013
    m_Localized: Eine Notiz! Mal sehen, was steht denn da?..
    m_Metadata:
      m_Items: []
  - m_Id: 2733630014
    m_Localized: "Oh, nein... es scheint, als h\xE4tten diese Bastarde \"Chosen-24\"
      gefangen genommen! Ich muss sie so schnell wie m\xF6glich finden und retten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630015
    m_Localized: "Wer ist dieser Sharp Shooter, ein ortsans\xE4ssiger Anf\xFChrer?
      Nach dem Zettel zu urteilen, h\xE4lt er sich irgendwo im Stable 88 auf. Ich
      kann es kaum erwarten, ihn zu treffen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630016
    m_Localized: "Halt! Ich wei\xDF nicht, wer du bist, aber gehe blos nicht weiter!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630017
    m_Localized: Wieso? Was ist dort?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630018
    m_Localized: "Nicht was, sondern Wer. Butch, Kopf der Sklavenh\xE4ndler. Riesig
      wie ein B\xFCffel, und wild wie ein Mantikor. Wenn er dich sieht, bist du tot!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630019
    m_Localized: "Das werden wir noch sehen! Mach dir keine Sorgen um mich, lass
      uns erstmal deinen K\xE4fig \xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630020
    m_Localized: Das Tor zum Stable 88... Was soll man dazu noch sagen, sehr beeindruckend.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630021
    m_Localized: "Du hast das Ende von [der ersten Ebene des verlassenen Stable]
      erreicht. Gehe durch die [Ausgang] -T\xFCr, um zur [zweiten Ebene] zu gelangen.
      In tieferen Ebenen findest du mehr Feinde, Pr\xFCfungen und Belohnungen. Es
      wird dir dabei helfen, die n\xF6tige Erfahrung zu sammeln."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630022
    m_Localized: Hmm... Bisher habe ich noch keinen der Orte gesehen, nach denen
      ich suche. Ich muss in die tieferen Ebenen gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630023
    m_Localized: "Der Korridor da ... Soweit ich den typischen Stable-Plan kenne,
      f\xFChrt er zum Stablekern und zum Zentralrechner. Vielleicht ist der Quanten
      Kogitator ja dort?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630024
    m_Localized: "Gehe den Korridor nach rechts, um zum [Stable Kern] zu gelangen.
      Oder betreten die [Ausgang] -T\xFCr, um eine neue Stable-Ebene zu erkunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630025
    m_Localized: "Sklavenh\xE4ndler Gespr\xE4ch \xFCber Roboter"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630026
    m_Localized: Bericht.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630027
    m_Localized: "\xC4hhmm... Boss! Es gibt keine M\xF6glichkeit dort hinein zu kommen,
      solange dieser verfickte Roboter da ist!|Err... Boss! Es gibt keine M\xF6glichkeit
      dort hinein zu kommen, solange dieser verdammte Roboter da ist"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630028
    m_Localized: "Wessen Problem ist das? Meins etwa? Ich habe den Befehl gegeben,
      das bedeutet, dass der Durchgang ges\xE4ubert werden muss! Ihr habt gelernt,
      mit Robotern umzugehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630029
    m_Localized: "Aber, \xE4\xE4hmm... Boss! Das ist nicht einfach irgendein Roboter!
      Er hat 5 von uns innerhalb von Sekunden abgeknallt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630030
    m_Localized: "DAS INTERESSIERT MICH EINEN SCHEI\xDF! DEINE AUFGABE IST, ZU TUN,
      WAS ICH BEFEHLE, UND WENN ICH DIR BEFEHLE, DICH SELBST ZU T\xD6TEN, GEHST DU
      UND T\xD6TEST DICH SELBST! DU SOLLTEST DIESEN SEKTOR VOR DREI VERDAMMTEN TAGEN
      GES\xC4UBERT HABEN! VERSTEHST DU, WAS DAS BEDEUTET? ES BEDEUTET, DASS, WENN
      ICH IN EINER STUNDE ZUR\xDCCKKOMME UND DU DIESEN ROBOTER NICHT WEGGEBLASEN
      HAST MACHE ICH DAS MIT DIR! KAPIERST DU DAS DU WURM ?! DU! TUN! DAS VERSTEHEN?!
      | DAS INTERESSIERT MICH EINEN DRECK! DEINE AUFGABE IST, ZU TUN, WAS ICH BEFEHLE,
      UND WENN ICH DIR BEFEHLE, DICH SELBST ZU T\xD6TEN, GEHST DU UND T\xD6TEST DICH
      SELBST! DU SOLLTEST DIESEN SEKTOR VOR DREI VERDAMMTEN TAGEN GES\xC4UBERT HABEN!
      VERSTEHST DU, WAS DAS BEDEUTET? ES BEDEUTET, DASS, WENN ICH IN EINER STUNDE
      ZUR\xDCCKKOMME UND DU DIESEN ROBOTER NICHT AUS DEM WEG GER\xC4UMT HAST MACHE
      ICH DAS MIT DIR! KAPIERST DU DAS DU MADE ?! DU! TUN! DAS VERSTEHEN?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630031
    m_Localized: "Verstanden, Boss! \xC4hm ... Wir machen das gleich! K\xF6nnten
      wir uns.. also wei\xDFt du ... Impulsgranaten nehmen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630032
    m_Localized: "Nehmt mit was ihr baucht. In einer Stunde wird dieser beschissene
      Roboter nicht mehr da sein, es ist mir egal, wie du es anstellst, kapiert?
      Ich bin verdammt m\xFCde von euch Idioten ... | Nehmt mit was ihr beaucht.
      In einer Stunde wird dieser Roboter nicht mehr da sein, es ist mir egal, wie
      du es anstellst, kapiert? Ich bin verdammt m\xFCde von euch Idioten ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630033
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630034
    m_Localized: Die kommen hier nicht durch? Vielleicht ist das der Ort, den ich
      gesucht habe. Und das muss Sharp Shooter sein. Jetzt lass uns mal mit ihm plaudern...
    m_Metadata:
      m_Items: []
  - m_Id: 2733630035
    m_Localized: Und dennoch ... von welchem Roboter haben die wohl gesprochen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630036
    m_Localized: "Notizen des Sklavenh\xE4ndler Anf\xFChrers"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630037
    m_Localized: "Verdammt, er ist tot! Wie kann ich jetzt mehr \xFCber die andere
      Auserw\xE4hlte erfahren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630038
    m_Localized: Warte mal, was ist das? Eine Art von Notizen. Lass mal sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630039
    m_Localized: "Nun, das ist nur M\xFCll. Mal weiter lesen:\n- Tag f\xFCnf. Nichts.\n-
      Hier auch nicht.\n- Nein\u2026\n- Aha, hier!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630040
    m_Localized: Hundesohn...|Verdammter Bastard...
    m_Metadata:
      m_Items: []
  - m_Id: 2733630041
    m_Localized: Sie ist entkommen! Heilige Celestia, sie konnte entkommen!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630042
    m_Localized: Sharp Shooters Tagebuch
    m_Metadata:
      m_Items: []
  - m_Id: 2733630043
    m_Localized: "Nur wenige Stunden nach unserer Unterhaltung und unsere herrlich
      strahlende Hoffnung f\xFCr alle Ponys, unser Heiland, *Fick-Dich* Redeye hatte
      schon wieder genug von mir. \"Gehe den alten Stable sauber machen!\" Echt jetzt
      du Pisser? Vielleicht sollte er lieber selbst die Schaufel in die Hufe nehmen.
      Noch nie in meinem Leben habe ich einen so rachs\xFCchtigen Bastard getroffen.
      Also gut, schei\xDF drauf. Zumindest kann ich mich ausruhen und meine Jungs
      k\xF6nnen diese Blechb\xFCchsen abknallen. |Nur wenige Stunden nach unserer
      Unterhaltung und unsere herrlich strahlende Hoffnung f\xFCr alle Ponys, unser
      Heiland, *k\xFCss-meine-Flanke* Red-Eye hatte schon wieder genug von mir. \"Gehe
      den alten Stable sauber machen!\" Echt jetzt? Vielleicht sollte er lieber selbst
      die Schaufel in die Hufe nehmen. Noch nie in meinem Leben habe ich einen so
      rachs\xFCchtigen Bastard getroffen. Also gut, was solls. Zumindest kann ich
      mich ausruhen und meine Jungs k\xF6nnen diese Blechb\xFCchsen abknallen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630044
    m_Localized: "Tag 1. Meine Truppe versammelte sich im Morgengrauen und ging durch
      das Nordtor hinaus. Als ich unter dem Bogen hindurchging, h\xF6rte ich den
      Wachposten vom Turm kichern. Diese Freaks hatten keine Angst und lachten immer
      noch \xFCber meinen Streit mit \"Redeye\", auch als ich in ihre Richtung schaute.
      Ich habe beide erschossen, damit Sie sich nicht mit mir anlegen. Wenn jemand
      fragt warum, sage ich, das war weil sie den Anf\xFChrer missachtet haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630045
    m_Localized: "Tag 21. Die \xFCbliche Routine wurde mit der Ankunft von Butchs
      Bande unterbrochen. Sie wurden geschickt, um Karten von den unterirdischen
      Abwasserkan\xE4len zu erstellen, und w\xE4hrend dieser Aufgabe stie\xDFen sie
      auf ein Einhorn, das mit einer Leiche in einer dunklen Ecke spielte. Aber das
      ist nicht die Hauptsache. Die Sache ist, dass sie einen PipBuck hat. Die Wachen,
      die sie gefangen haben, glauben, dass sie eine Gelehrte der St\xE4hlernen Bruderschaft
      ist. Ich werde sie nicht an ihren Glauben zweifeln lassen, aber meine Erfahrung
      sagt etwas v\xF6llig anderes. Die St\xE4hlerne Bruderschaft h\xE4tten niemals
      eine einzige unbewaffneten Gelehrte ausgesandt. Auf dieser Welt gibt es nur
      drei Arten von Ponys, die Zugang zu solchen Rarit\xE4ten wie einem PipBuck
      haben: Die St\xE4hlerne Bruderschaft, Elite Red-Eye Wachen und Bewohner der
      noch versiegelten Stable. Letztere sind so selten, dass viele glauben, es g\xE4be
      \xFCberhaupt keine funktionierenden Stable mehr, aber unsere Gefangene geh\xF6rt
      eindeutig nicht zu den ersten beiden Kategorien. Nein, sie ist aus einem Stable!
      Wenn ja, dann scheine ich der gl\xFCcklichste Bastard von hier bis Canterlot
      zu sein. Dieses kleine K\xFCken sieht aus, als w\xE4re es gerade aus einem
      Reagenzglas kommen und sie kann noch nicht lange an der Oberfl\xE4che sein.
      Ihre Heimat muss also ganz in der N\xE4he sein. Wenn ich einen unber\xFChrten
      Stable voller Bewohner finde ... wird das die gr\xF6\xDFte Beute meines Lebens!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630046
    m_Localized: "Tag 22. Gestern habe ich meinem Gast einen Tag Zeit gegeben, um
      sich das Gehirn zu zermartern und mir zu sagen, wo ihr zu Hause ist. Heute
      ist die Zeit abgelaufen, aber sie ist taub gegen\xFCber meiner Stimme der Vernunft.
      Sie behauptet, dass sie sich \"nicht daran erinnert\". Hah! Leider hat sie
      heute nichts Wichtiges gesagt. Wir werden unser Gespr\xE4ch morgen fortsetzen.
      Aber bei der G\xF6ttin, wie s\xFC\xDF sie unter den Schl\xE4gen einer Peitsche
      schreit..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630047
    m_Localized: "Tag 25. Die Gefangene schweigt noch immer. Unter Tr\xE4nen beteuert
      sie, dass sie sich an nichts erinnert. Nun, Ich muss zugeben dass die in ihrem
      Stable wirklich wissen wie man lernt das Maul zu halten. Ich muss anfangen,
      mich selbst auf die Suche danach zu begeben. Das Problem ist nur dass es unter
      den Jungs von Butch mindestens ein Paar Spione von meinen Konkurrenten geben
      muss. Sobald sie wissen, dass wir einen Stable gefunden haben, laufen sie noch
      am selben Abend davon und erstatten ihren Auftraggeber Bericht. Daher werden
      wir den Mythos der Gelehrten von den Stahl-\xC4rschen unterst\xFCtzen. Ich
      werde meine zuverl\xE4ssigsten Leute an die Spitze des Suchtrupps stellen,
      und nur sie werden den wahren Zweck der Suche erfahren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630048
    m_Localized: "Tag 26. Entflohene Sklaven. Ein Wachanf\xE4nger schlief auf seinem
      Posten ein und einige von diesen drecks Sklaven konnten fliehen, darunter auch
      unser z\xE4hes M\xE4del. Ich kann nicht l\xE4nger darauf hoffen, etwas aus
      ersten Hufen \xFCber den Stable-Eingang zu erfahren. Die beiden Trottel wurden
      im Morgengrauen aufgeh\xE4ngt, aber was macht das jetzt noch aus? Wir m\xFCssen
      uns jetzt nur noch auf Gl\xFCck und eine gr\xFCndliche Suche verlassen. |Tag
      26. Flucht von Sklaven. Auf dem Posten schlief ein Wachneuling ein, und einige
      Gefangene konnten fliehen, darunter auch unser z\xE4hes M\xE4dchen. Ich kann
      nicht l\xE4nger darauf hoffen, etwas aus ersten Hufen \xFCber den Stable-Eingang
      zu erfahren. Die beiden Idioten wurden in der Morgend\xE4mmerung aufgeh\xE4ngt,
      aber was macht das jetzt noch aus? Wir m\xFCssen uns jetzt nur noch auf Gl\xFCck
      und gr\xFCndliche Suche verlassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630049
    m_Localized: Zentralkern Statusbericht
    m_Metadata:
      m_Items: []
  - m_Id: 2733630050
    m_Localized: Das Sicherheits-Kraftfeld wurde deaktiviert.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630051
    m_Localized: 'Zustand des Systems:

      Reaktor-Kern: 17.56% Leistung.

      Zentraler
      Hauptrechner: Betriebsbereit.

      Sicherheitssysteme: Aktiv.

      Ultra-Wachbot:
      Aktiv'
    m_Metadata:
      m_Items: []
  - m_Id: 2733630052
    m_Localized: 'Achtung!

      Austritt radioaktiver Stoffe aus dem Reaktor.

      Es
      wird nicht empfohlen sich derzeit in der Zone F-17 aufzuhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 2733630053
    m_Localized: Der Quanten Kogitator... Das ist er!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630054
    m_Localized: Ich habs geschafft! Ich habs geschafft! Hura!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630055
    m_Localized: "Jetzt sollte ich den Mentor kontaktieren. Ich frage mich ... ob
      ich das mit Hilfe dieses Gro\xDFrechners tun kann? Er sieht genauso aus wie
      der in der ManeTec-Fabrik..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630056
    m_Localized: "Zweites Gespr\xE4ch mit dem Mentor"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630057
    m_Localized: "Hoffentlich funktioniert das\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630058
    m_Localized: "*Installiere neues Ger\xE4t*\n*Ger\xE4t verbunden: Personal Computer
      \"PipBuck\", Modell PX 778185578322 S*\n*Zugangsrechte: Gast*\n*Warnung: Benutzer
      der Kategorie \"Gast\" haben eingeschr\xE4nkte Rechte. Sie k\xF6nnen: Neue
      Dokumente erstellen, Dokumente aus der Kategorie \"F\" einsehen, eine Kommunikationsverbindung
      mit Adressen aus der Kontaktliste herstellen, die Temperatur und Luftfeuchtigkeit
      des Raumes einstellen, das \"W\xF6rter raten\" Spiel spielen*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630059
    m_Localized: "\xD6ffne die Liste verf\xFCgbarer Kontakte."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630060
    m_Localized: "*Kontaktliste: \"Intern\" Kategorie - 47 Adressen; \"Extern\" Kategorie
      - 35 Adressen; \"Prim\xE4re\" Kategorie - 3 Adressen.*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630061
    m_Localized: 'Suche: Stable Pi'
    m_Metadata:
      m_Items: []
  - m_Id: 2733630062
    m_Localized: "*Addresse \"Stable Pi\": \xDCbereinstimmung - 1. Addresse, Status
      - Aktiv. Fordere Sitzung f\xFCr Kommunikation an...*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630063
    m_Localized: '*Minuten vergehen*'
    m_Metadata:
      m_Items: []
  - m_Id: 2733630064
    m_Localized: Hallo, @lp.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630065
    m_Localized: Ja, es funktioniert!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630066
    m_Localized: "Ruhe, nicht herumschreien, ich bin gerade aufgewacht! Ist dir \xFCberhaupt
      klar, dass es zwei Uhr morgens ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630067
    m_Localized: "Tut mir leid, ich habe nicht mitbekommen wie sp\xE4t es ist, als
      ich mich durch diesen riesigen Stable voller Roboter und Sklavenh\xE4nder gek\xE4mpft
      habe."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630068
    m_Localized: Voll von was?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630069
    m_Localized: "H\xF6re mir nur zu. Vom Stable 88 aus operiert gro\xDFe Gruppe
      von Ponys, die andere Ponys fangen und versklaven."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630070
    m_Localized: "Ich wei\xDF wer Sklavenh\xE4ndler sind, @lp\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630071
    m_Localized: .. und die vor einiger Zeit die Chosen-24 gefangen haben und sich
      auf die Suche nach unserem Stable gemacht haben.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630072
    m_Localized: "Warte einen Augenblick. Wenn es eine Bedrohung f\xFCr den Stable
      Pi gibt, m\xFCssen wir sehr strenge Sicherheitsma\xDFnahmen ergreifen. Bist
      du sicher, mit dem was du da sagst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630073
    m_Localized: "Ja, vollkommen. Ich habe ihre Befehle gelesen. Wegen ihrer Paranoia
      hielten diese Typen ihr Wissen \xFCber unseren Stable geheim, nur ihre Offiziere
      wussten davon. Ich habe sie beseitigt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630074
    m_Localized: Ihre Offiziere ausgeschaltet? Das ist... beeindruckend!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630075
    m_Localized: "Und dennoch, @lp, Bei allem Respekt kann ich deinen Worten nicht
      einfach blind vertrauen. Von diesem Tag an habe ich keine andere Wahl, als
      zus\xE4tzliche Vorsichtsma\xDFnahmen zu treffen. F\xFCr mich und dich bedeutet
      dies, dass solche Kommunikationssitzungen nicht mehr akzeptabel sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630076
    m_Localized: "Hast du etwas zu \xFCber deine Hauptmission zu berichten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630077
    m_Localized: Ich habe den Kogitator.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630078
    m_Localized: Herrlich! Gut gemacht, @lp!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630079
    m_Localized: "Die Situation ist also wie folgt: Der Kogitator ist nur eines von
      mehreren Objekten, die wir ben\xF6tigen. Die beiden verbleibenden sind: Das
      Alihorn Amulett und das Schwarze Buch. Das sind die antiken Artefakte, die
      vor dem Krieg von den Ponys untersucht worden waren und die man f\xFCr das
      Projekt \"Rainbow\" vorsah. Beide waren weit von uns entfernt, als die Welt
      von den Mega-Zaubern getroffen wurde."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630080
    m_Localized: "Laut unseren Archiven befand sich Alihorn Amulett im Forschungsinstitut
      von M.A.S. in Manehattan, w\xE4hrend das Schwarze Buch in Canterlot aufbewahrt
      wurde. Das sind deine n\xE4chsten Ziele. Zum Kogitator. Du musst ihn uns \xFCbergeben.
      Ich sende dir die Koordinaten und die Zeit f\xFCr unser n\xE4chstes Treffen,
      wo ein zuverl\xE4ssiges... Pony auf dich wartet. Er wird mit dir \xFCber einen
      Sprite-Bot sprechen. Mach dir keine Sorgen, du wirst sofort erkennen, dass
      er es ist, mit dem du reden musst. Er wird dir den Kogitator abnehmen und dir
      dann sagen, was du wissen m\xF6chtest. Wir k\xF6nnen immer noch nicht zulassen,
      dass unsere Geheimnisse durch dich in feindliche Hufe geraten, aber ich finde,
      du hast das Recht, mehr \xFCber deine Vergangenheit zu erfahren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630081
    m_Localized: "Ich m\xF6chte aber jetzt Antworten haben..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630082
    m_Localized: '*Verbindung getrennt*'
    m_Metadata:
      m_Items: []
  - m_Id: 2733630083
    m_Localized: Verdammt!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630084
    m_Localized: Unerwartete Begegnung mit der Bruderschaft
    m_Metadata:
      m_Items: []
  - m_Id: 2733630085
    m_Localized: Hey, du!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630086
    m_Localized: "Immer mit der Ruhe, Ich m\xF6chte euch Metallponys nicht weh tun."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630087
    m_Localized: Ich werde dir ein paar Fragen stellen und du wirst sie beantworten.
      Ist das dein Sprite-Bot?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630088
    m_Localized: Was? Was meinst du?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630089
    m_Localized: "Ich habe dir eine Frage gestellt. Hier liegt ein Sprite-Bot vor
      uns. Geh\xF6rt der dir?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630090
    m_Localized: Da liegst du falsch. Ich besitze keine Sprite-Bots.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630091
    m_Localized: "Warte mal Rose. Es scheint, als h\xE4tten wir hier ein Missverst\xE4ndnis."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630092
    m_Localized: "Ich entschuldige mich f\xFCr meine Freundin, kleines. Sie wollte
      dich nicht erschrecken."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630093
    m_Localized: Was soll das, Diamond?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630094
    m_Localized: Psst.. sei leise.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630095
    m_Localized: Sag mir, kleines, woher hast du das Ding da an deinem Bein?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630096
    m_Localized: "H\xF6rt auf, so mit mir zu reden! Und dieses \"Ding\" geh\xF6rt
      mir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630097
    m_Localized: "Tut mir leid, kleines, aber da liegst Du falsch. Fakt ist, dass
      solch eine Technologie ein Antikes Erbe ist. Wir sind die St\xE4hlerne Bruderschaft,
      eine Gemeinschaft, deren Aufgabe es ist, diese Technologien zu bewahren. Daher
      k\xF6nnen wir einen solchen Gegenstand nicht deiner Obhut \xFCberlassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630098
    m_Localized: "Au\xDFerdem bist du doch nicht zuf\xE4llig hier, oder? Als wir
      diesen Bot fanden, schwebte er nur so auf der Stelle und versteckte sich im
      Geb\xFCsch. Ungew\xF6hnliches Verhalten f\xFCr eine gedankenlose Maschine,
      nicht wahr? Umso ungew\xF6hnlicher, dass dieser Roboter in dem Moment, in dem
      er uns entdeckt hat, versucht hat zu entkommen. Jemand kontrollierte diesen
      Bot und er wollte sich hier mit einem bestimmten Pony treffen, das zuf\xE4llig
      genau im richtigen Moment an diesen verlassenen, uninteressanten Ort vorbeikam.
      Verstehst du worauf ich hinaus will, M\xE4dchen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630099
    m_Localized: Kurz gesagt - Du kommst mit uns mit. Jetzt.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630100
    m_Localized: "Warum so unh\xF6flich? Liebling, noch einmal bitte verzeih uns.
      Wir sind nicht deine Feinde. Aber wir m\xFCssen dich zu uns nach Hause mitnehmen,
      wo du uns deinen PipBuck \xFCbergeben und uns verraten wirst, woher du ihn
      hast und wer den Sprite-Bot kontrolliert hat. Auf diese Weise wirst du jedem
      einen gro\xDFen Gefallen tun, das versichere ich dir! Im Gegenzug werden wir
      dich gut behandeln und dir Vorr\xE4te f\xFCr die Reise geben. Einverstanden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630101
    m_Localized: "Ich w\xFCrde sagen, das war der wohl mit Abstand der ungew\xF6hnlichste
      Versuch, mich auszurauben, solange ich mich erinnern kann. Nein, ich gehe nirgendwo
      mit euch hin und ich gebe euch auch nicht meinen PipBuck. Habt ihr verstanden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630102
    m_Localized: Ja, Reisender. Wir verstehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630103
    m_Localized: "S\xF6ldnerbrief"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630104
    m_Localized: "Peck, das ist Stinker. Koroch, folgende Situation. Meine Einheit
      wurde neu zugewiesen, um die Hauptabteilung zu st\xE4rken, und das Gebiet wurde
      an deine Abteilung \xFCbertragen. Es war keine Zeit, dich pers\xF6nlich zu
      suchen, also werde ich dir diese Nachricht hinterlassen. Du glaubst, ich habe
      dich betrogen - du kannst alles stehen und liegen lassen und zum Hauptquartier
      fliegen, um deine Anschuldigungen Tweek vorzutragen. Ich kichere vor Freude
      dar\xFCber, wie er dir wegen \"Ungehorsams\" in den Arsch treten wird. Im Ernst,
      Kumpel, das ist die Wahrheit.\nDu warst nicht bei der Einsatzbesprechung der
      Nachhutkommandeure, also gebe ich dir die Kurzfassung des Wesentlichen. Wir
      erwarten eigentlich keinen Kontakt, aber nur f\xFCr den Fall, sollte jeder
      auf Ponys dieser Stahl-\xC4rsche achten. Diese Schei\xDFkerle haben es sich
      angew\xF6hnt, Spione an die Orte unserer Operationen zu schicken. Ich Pers\xF6nlich
      gebe einen Schei\xDF darauf, aber diese Art der \xDCberwachung macht unsere
      Auftraggeber nerv\xF6s. Daher wird befohlen, jedes Mistst\xFCck bei Sichtkontakt
      sofort zu erschie\xDFen. Einfach ausgedr\xFCckt: Diese Schei\xDFkerle lehnen
      es strikt ab ihre PipBucks abzulegen. Das widerspricht ihren Grunds\xE4tzen
      oder so. Also sag einfach deinen Jungs, sie sollen L\xF6cher in jedes Pony
      machen, das so ein Ger\xE4t an seinem Bein hat. Und t\xF6tet nicht versehentlich
      jemand anderen, unser Auftraggeber braucht die Einheimischen am Leben. Der
      Konvoi wird von Zeit zu Zeit zu euch geschickt, um die Ponys abzuholen, die
      ihr abfangen konntet, damit ihr eure Gruppe nicht trennen m\xFCsst. Ich hoffe,
      eure Jungs haben Augen, die scharf genug sind, um PipBucks nicht mit Verb\xE4nden
      zu verwechseln. |Du warst nicht bei der Einsatzbesprechung der Kommandeure,
      also gebe ich dir die Kurzfassung des Wesentlichen. Wir erwarten eigentlich
      keinen Kontakt, aber nur f\xFCr den Fall, sollte jeder auf Ponys dieser Stahl-\xC4rsche
      achten. Diese Schei\xDFkerle haben es sich angew\xF6hnt, Spione an die Orte
      unserer Operationen zu schicken. Ich Pers\xF6nlich gebe einen Dreck darauf,
      aber diese Art der \xDCberwachung macht unsere Auftraggeber nerv\xF6s. Daher
      wird befohlen, jeden von denen bei Sichtkontakt sofort zu erschie\xDFen. Einfach
      ausgedr\xFCckt: Diese Typen lehnen strikt ihre PipBucks abzulegen. Das widerspricht
      ihren Grunds\xE4tzen oder so. Also sag einfach deinen Jungs, sie sollen L\xF6cher
      in jedes Pony machen, das so ein Ger\xE4t an seinem Bein hat. Und t\xF6tet
      nicht versehentlich jemand anderen, unser Auftraggeber braucht die Einheimischen
      am Leben. Der Konvoi wird von Zeit zu Zeit zu euch geschickt, um die Ponys
      abzuholen, die ihr abfangen konntet, damit ihr eure Gruppe nicht trennen m\xFCsst.
      Ich hoffe, eure Jungs haben Augen, die scharf genug sind, um PipBucks nicht
      mit Verb\xE4nden zu verwechseln.\nDu warst nicht bei der Besprechung der Kommandeure,
      also gebe ich dir die Kurzfassung. Wir erwarten eigentlich niemanden, aber
      nur f\xFCr den Fall, soll jeder auf diese Stahlflanken aufpassen. Diese Schweine
      haben die Angewohnheit, Spione an die Orte unserer Operationen zu schicken.
      Ich pers\xF6nlich habe nichts dagegen, aber diese Art der \xDCberwachung macht
      unsere Arbeitgeber nerv\xF6s. Daher wurde befohlen, jeden Bastard von denen
      den ihr seht zu erschie\xDFen. Einfach ausgedr\xFCckt: Diese Technikfanatiker
      lehnen strikt ab, ihe PipBucks abzulegen. Das widerspricht ihren Grunds\xE4tzen
      oder so. Also sag einfach deinen Jungs, sie sollen L\xF6cher in jedes Pony
      machen, das so ein Ger\xE4t an seinem Bein hat. Und nicht versehentlich irgendwelche
      Zivilisten t\xF6ten, unser Auftraggeber braucht Einheimische am Leben. Der
      Konvoi wird von Zeit zu Zeit euch Ihnen geschickt, um die Ponys abzuholen,
      die ihr abfangen kontet, damit ihr eure die Gruppe nicht trennen m\xFCsst.
      Ich hoffe, eure Jungs haben Augen, die scharf genug sind, um PipBucks nicht
      mit Verb\xE4nden zu verwechseln. Haha!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630105
    m_Localized: Beobachtung der Mainhatten Ruinen
    m_Metadata:
      m_Items: []
  - m_Id: 2733630106
    m_Localized: Hier ein guter Ort, um sich umzusehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630107
    m_Localized: Du nimmst ein Fernglas heraus und beobachtest die Umgebung.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630108
    m_Localized: "\xDCberall sind nur Ruinen ... Ja, der Krieg hat diesen Ort nicht
      verschont ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630109
    m_Localized: Halt!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630110
    m_Localized: "Ein hoher Wolkenkratzer mit einem gro\xDFen Symbol des Ministeriums
      f\xFCr Arkane Wissenschaften. Stark besch\xE4digt, aber es stehen noch mindestens
      drei\xDFig Stockwerke davon. Vielleicht ist dies das wissenschaftliche Forschungsinstitut
      des M.A.S. Wenn es einen Ort gibt, an dem man nach dem Alihorn-Amulett suchen
      kann, dann ist er dort."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630111
    m_Localized: "Also, welcher w\xE4re der beste Weg dorthin? Von unten gibt es
      kein Durchkommen, alles ist mit Schutt bedeckt. Aber der Wolkenkratzer ist
      mit einer Einschienenbahn verbunden, ich k\xF6nnte vom Dach eines nahe gelegenen
      Geb\xE4udes dorthin gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630112
    m_Localized: "Aber.. was sind das f\xFCr schwarze Flecken um das Institut herum?
      Verstehe ich nicht, mal vergr\xF6\xDFern ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630113
    m_Localized: "Alih\xF6rner! Fick den Manticore! Da ist ein ganzer Haufen von
      denen.|Alih\xF6rner! Celestia verdammt nochmal! Eine ganze Herde von denen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630114
    m_Localized: "Aber warum sind das so viele? K\xF6nnte das bedeuten dass das Amulett
      wirklich dort ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630115
    m_Localized: "Auf dieser Schiene fuhren fr\xFCher Z\xFCge ... und jetzt ist es
      nur noch ein Versteck f\xFCr Blutschwingen. Aber ich kann sie nutzen, um zum
      MAS Turm zu gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630116
    m_Localized: "Gehe nach rechts, um zum [MAS-Turm] zu gelangen. Oder gehe durch
      die [Ausgang] -T\xFCr, um Manehattan weiter zu erkunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630117
    m_Localized: Sprite-bot Untersuchung
    m_Metadata:
      m_Items: []
  - m_Id: 2733630118
    m_Localized: Was haben wir denn hier.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630119
    m_Localized: "Sieht aus wie ein gew\xF6hnlicher Sprite-Bot."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630120
    m_Localized: "Naja, Auf den zweiten Blick nicht mehr. Es fehlen mehrere Komponenten.
      Die Bewaffnung wurde entfernt, die \"unendliche\" Batterie wurde durch eine
      kompaktere und entsprechend kurzlebige ersetzt. Im Inneren des Geh\xE4uses
      befindet sich ein gro\xDFer Hohlraum anstelle der entfernten Komponenten, der
      durch grob geschwei\xDFte Planken von anderen Teilen getrennt ist. Kein Zweifel,
      das ist der Sprite-Bot, der mir den Kogitator abnehmen sollte."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630121
    m_Localized: "Das Treffen ist also gescheitert. Der Sprite-Bot ist zerst\xF6rt
      und der der mir den Kogitator abnehmen sollte, hat nun keine M\xF6glichkeit
      mehr dazu. Ohh, fick dich Nightmare Moon, diese Freaks!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630122
    m_Localized: "Zumindest hat der Mentor mir die beiden anderen fehlenden Komponenten
      des Projekts erkl\xE4rt. Ich muss sie nur finden ... in den Ruinen der beiden
      gr\xF6\xDFten St\xE4dte der Vergangenheit ... wo sie sich befinden k\xF6nnten
      oder auch nicht. Wunderbar, lass uns aufbrechen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630123
    m_Localized: "Gut, wir sind auf jeden Fall weitergekommen. Sieht so aus, als
      w\xFCrden sie mich hier nicht sofort erschie\xDFen. Ich sollte mich umsehen
      und ein paar Fragen stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630124
    m_Localized: "Willkommen im \"t\xE4nzelnden Pony\" - dem friedlichsten und sichersten
      Ort im \xD6dland. Hier kannst du dich ausruhen, handeln, deine Ausr\xFCstung
      reparieren und dich medizinisch versorgen lassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630125
    m_Localized: "Bitte befolge die Regeln. K\xE4mpfen, Schie\xDFen, Stehlen und
      Verschieben von M\xF6beln ist verboten. Zuwiderhandelnde werden erschossen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630126
    m_Localized: Der Bereich Gesundheit deines PipBuck
    m_Metadata:
      m_Items: []
  - m_Id: 2733630127
    m_Localized: "Denke daran, deinen Gesundheitszustand h\xE4ufig zu \xFCberpr\xFCfen!
      Gehe dazu in deinem PipBuck zum Abschnitt \"Gesundheit\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630128
    m_Localized: "Vergiss nicht, dass du nicht lange \xFCberleben wirst, wenn du
      nur Heiltr\xE4nke verwendest. Sie sorgen daf\xFCr, dass du dich besser f\xFChlst,
      aber du wirst schwere Verletzungen und Traumata dadurch nicht los.\n\t\t\t\t\tWenn
      du dich an allerlei gef\xE4hrlicher Orte herumtreibst, aber selbst kein Experte
      f\xFCr Medizin bist, solltest du auf jeden Fall regelm\xE4\xDFig einen Arzt
      aufsuchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630129
    m_Localized: Benutze eine Werkbank
    m_Metadata:
      m_Items: []
  - m_Id: 2733630130
    m_Localized: "Verwende eine Werkbank, wenn du Ausr\xFCstungsgegenst\xE4nde erstellen,
      reparieren oder verbessern musst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630131
    m_Localized: "Um neue Waffen und Sprengstoffe zusammenzubauen, ben\xF6tigst du
      Schemata, Materialien und die entsprechende F\xE4higkeiten.\n\t\t\t\t\tF\xFCr
      die Reparatur von Waffen und R\xFCstungen ben\xF6tigst du die erforderlichen
      Komponenten und Reparaturf\xE4higkeiten. Oder du kannst den H\xE4ndler daf\xFCr
      bezahlen.\n\t\t\t\t\tVermeide abgenutzte R\xFCstungen oder zerbrochene Waffen,
      sie werden dich im kritischsten Moment im Stich lassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630132
    m_Localized: "Willkommen auf dem \xDCbungsgel\xE4nde. Hier kannst du dich mit
      Nahkampfwaffen, Schusswaffen, Granaten und Magie austoben, ohne irgendpony
      zu st\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630133
    m_Localized: "W\xE4hrend du hier bist, verschlei\xDFen deine Waffen nicht und
      du verbrauchst keine Munition. Ballere so viel du willst!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630134
    m_Localized: "Du kannst gegen jeden Boss erneut k\xE4mpfen, aber erst, nachdem
      du seinen Schl\xFCssel erhalten hast. Die Boss-Stufe wird deiner entsprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630135
    m_Localized: Begegnung mit Daiquiri
    m_Metadata:
      m_Items: []
  - m_Id: 2733630136
    m_Localized: "Willkommen in meiner Bar dem \"T\xE4nzelnden Pony\". Das ist \xFCbrigens
      auch der Name unseres Lagers. Wir freuen uns immer, friedliche Reisende hier
      zu sehen. Mach uns keine Probleme, und wir werden miteinander auskommen. Ich
      hei\xDFe Daiquiri."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630137
    m_Localized: "Hallo, ich bin @lp. So wie ich das sehen kann bist du f\xFCr diesen
      Ort hier verantwortlich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630138
    m_Localized: "So in der Art. Zumindest versuche ich, alle wichtigen Probleme
      zu l\xF6sen. Frage mich, wenn du etwas brauchst oder einfach nur etwas trinken
      m\xF6chtest."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630139
    m_Localized: "Wenn du handeln oder ein paar Kronkorken verdienen m\xF6chtest,
      besuche die H\xE4ndler in der Haupthalle. Sie haben immer Arbeit zu erledigen,
      vielleicht stellen sie dich als Helfer ein."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630140
    m_Localized: Wenn du zusammengeflickt werden musst, besuche die Klinik. Unser
      Arzt ist der beste Arzt, den du hier finden wirst.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630141
    m_Localized: "Vielen Dank f\xFCr die Gastfreundschaft. Wenn ich Informationen
      ben\xF6tige, werde ich dich auf jeden Fall aufsuchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630142
    m_Localized: "(Zu dir selbst) Gut, der erste Kontakt ist offiziell hergestellt.
      Jetzt muss ich alles in Erfahrung bringen, was mir bei der Suche nach der Fabrik
      helfen k\xF6nnte."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630143
    m_Localized: "Die Zerst\xF6rte Fabrik"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630144
    m_Localized: Ich komme von weit her und kenne diese Gegend nicht. Gibt es Orte,
      die einen Besuch wert sind oder die man lieber vermeiden sollte?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630145
    m_Localized: "Das einzig Reizvolle hier ist die zerst\xF6rte Vorkriegsfabrik.
      Sie hat w\xE4hrend der Bombardierung nicht viel Schaden genommen, da die meisten
      Geb\xE4udeteile unterirdisch liegen. Dort gibt es viele wertvolle Dinge zu
      finden, die Einheimischen gehen normalerweise dorthin, um Beute zu machen.
      Die Fabrik ist einfach nur riesig, es scheint unm\xF6glich, sie selbst in zehn
      Jahren vollst\xE4ndig zu erkunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630146
    m_Localized: "Fabrik? H\xF6rt sich interessant an, ich werde sie mir auf jeden
      Fall ansehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630147
    m_Localized: "Sicher, du bist willkommen, aber sei vorsichtig. Banditen halten
      sich dort oft auf und an einigen Stellen sind noch Gesch\xFCtzt\xFCrme aktiv.
      Du k\xF6nntest sogar auf Minen sto\xDFen - pass also auf wo du hintrittst.
      Aber du kannst dich nicht verlaufen: In den Korridoren zwischen allen Abteilungen
      findest du Karten, mit denen du immer einen Ausweg findest."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630148
    m_Localized: "Also, wie findest du es hier? Gef\xE4llt dir dieser Ort?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630149
    m_Localized: "Ganz in Ordnung, die Ponys scheinen freundlich zu sein und das
      Lager selbst ist ... charmant. Gibt es viele Orte wie diesen im \xD6dland?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630150
    m_Localized: "*Wiehern*, ehr weniger. Hier in der Gegend ist dies die einzige
      Siedlung, in der sie nicht versuchen werden, dich zu t\xF6ten, zu berauben
      oder dich gefangen zu nehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630151
    m_Localized: Wohnst du auch hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630152
    m_Localized: "Ich? Nein, aber mein Haus ist in der N\xE4he. Ich komme hierher,
      um zu arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630153
    m_Localized: Und was arbeitest du so, wenn ich fragen darf?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630154
    m_Localized: "Darfst du. Meistens bewache ich die Karawanen die hier durchkommen.
      F\xFCr die n\xE4chsten Tage werde ich daher hier festsitzen, also z\xF6gere
      nicht zu fragen, wenn du etwas brauchst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630155
    m_Localized: "Daiquiri \xFCber Falls Springs"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630156
    m_Localized: Ich habe eine Frage an dich, die mir sehr wichtig ist.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630157
    m_Localized: Frag ruhig.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630158
    m_Localized: Falls Springs. Sagt dir dieser Name etwas?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630159
    m_Localized: "Nat\xFCrlich. Das ist nicht weit von hier, vielleicht eine Tagesreise
      oder so. Folge der alten Stra\xDFe nach Osten, du kannst es nicht verfehlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630160
    m_Localized: "Nur ... warum willst du dorthin? Wei\xDFt du, was das f\xFCr ein
      Ort ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630161
    m_Localized: Wie meinst du das?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630162
    m_Localized: "Falls Springs ist das Versteck der Sklavenh\xE4ndler. Hast du etwas
      mit denen zu schaffen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630163
    m_Localized: "Was? Mit Sklavenh\xE4ndlern? Nein nat\xFCrlich nicht!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630164
    m_Localized: "Dann w\xE4re es in deinem Interesse, nicht dort hin zu gehen. Es
      sei denn, du willst in einem K\xE4fig enden. Ich habe geh\xF6rt, die interessieren
      sich besonders f\xFCr Einh\xF6rner."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630165
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630166
    m_Localized: "Hey, @lp! K\xF6nnte ich dich mal sprechen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630167
    m_Localized: "Calamity \xFCber Falls Springs"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630168
    m_Localized: "Ich habe Ausversehen euer Gespr\xE4ch mit geh\xF6rt. Sag mir mal
      ehrlich, du hast doch nichts mit den Sklavenh\xE4ndlern zu tun, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630169
    m_Localized: "Zutun? Wenn du meine Meinung h\xF6ren m\xF6chtest, ist der Sklavenhandel
      widerlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630170
    m_Localized: Gut. Ich bin froh, dass du so denkst. Aber warum musst du dann dorthin?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630171
    m_Localized: "Pers\xF6nliche Angelegenheiten. Hast du etwas dagegen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630172
    m_Localized: "Sie werden dich dort entweder t\xF6ten oder gefangen nehmen und
      an Red Eye \"verkaufen\". Ich verstehe nur nicht, was f\xFCr ein Verlangen
      dich dorthin zieht."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630173
    m_Localized: "In Ordung. Du hast mir geholfen, also sage ich es dir. Stable 88,
      hast du davon geh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630174
    m_Localized: "Ah, deshalb ... Yeup, ich habe geh\xF6rt, dass es in Falls Springs
      einen Eingang zum Stable gibt. Ich habe aber auch geh\xF6rt, dass die Ponys
      von dort nie zur\xFCckkehren."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630175
    m_Localized: "Wieso nicht? Wegen der Sklavenh\xE4ndler?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630176
    m_Localized: "Nein, die sind erst vor kurzem dort aufgetaucht. Das Hauptproblem
      sind nicht einmal die. Der Stable ist voller Roboter. Stable 88 wurde aufgegeben,
      und kein Pony wei\xDF, wielange das schon her ist. Vielleicht haben die es
      damals schon von Anfang an so gebaut, ohne Ponys. Ich wei\xDF es nicht ...
      es sind nur Ger\xFCchte. Ja, dort gibt es bestimmt eine Menge wertvoller Sachen,
      aber das Risiko ... nein, ohne guten Grund w\xFCrde ich meine Nase nicht in
      solch einen Ort stecken."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630177
    m_Localized: Seine Bewohner sind tot? Wow ... Und dennoch muss ich dorthin gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630178
    m_Localized: "Du bist hartn\xE4ckig, ich mag das! Wenn du das \xFCberleben willst,
      h\xF6re genau auf meine Worte."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630179
    m_Localized: "Das Sklavenh\xE4ndlerlager ist gut befestigt. Um es herum gibt
      es eine hohe Mauer, \xFCber die man nicht klettern kann, und mit T\xFCrmen
      mit Scharfsch\xFCtzen und Maschinengewehren. Dort direkt am Haupttor, bekommst
      du ein Dutzend zus\xE4tzliche L\xF6cher in deinem K\xF6rper. Aber du k\xF6nntest
      versuchen, durch die Kanalisation zu gelangen. Ein entflohener Sklave erz\xE4hlte
      mir, dass er auf diesem Weg entkommen war. Dort ist es auch gef\xE4hrlich,
      aber zumindest hast du da eine Chance."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630180
    m_Localized: "Hmm... vielen Dank. Dein Rat k\xF6nnte mir das Leben retten."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630181
    m_Localized: "Gut, dann viel Gl\xFCck! Dass du es schaffst, unter der Nase der
      Sklavenh\xE4ndler in diesen Stable zu gelangen ... Oh ja, das werden ganz sch\xF6ne
      Neuigkeiten werden! Viele Leute hier werden dich sicher fragen, ob du ein paar
      Sachen von dort mitbringen k\xF6nntest. Du kannst damit gutes Geld machen,
      wei\xDFt du das?."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630182
    m_Localized: "Calamity \xFCber Manehattan"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630183
    m_Localized: Da bist du ja, @lp!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630184
    m_Localized: Habt ihr auf mich gewartet?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630185
    m_Localized: "Aber sicher! Man trifft nicht jeden Tag ein Pony, das es schafft
      den Sklavenh\xE4ndlern in die Flanken zu treten!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630186
    m_Localized: "Nachdem du dich nach Falls Springs erkundigt hast, war ich besorgt
      um dich, @lp. Ich beschloss, dort hin zu fliegen und nachzusehen falls du diesen
      Freaks in die Hufe gelaufen w\xE4rst. Aber ich dort fand war ein Haufen Leichen
      und leere K\xE4fige. Ich vermute, du wei\xDFt wirklich, wie man auf sich aufpasst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630187
    m_Localized: "Und du hast nicht nur ein paar schlechte Ponys erschossen, @lp.
      Diese Bande war eine Bedrohung f\xFCr unser Lager. Und meiner Erfahrung nach
      h\xE4tten wir unsere Hufe in ihrem Blut tr\xE4nken m\xFCssen wenn du mit deinem
      Mut nicht gewesen w\xE4rst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630188
    m_Localized: "Als Leiter dieses Lagers kann ich deine Leistungen nicht unbeachtet
      lassen. F\xFCr die Hilfe mit den Sklavenh\xE4ndlern verdienst du eine anst\xE4ndige
      Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630189
    m_Localized: "Danke daf\xFCr, aber um ehrlich zu sein habe ich das nur zur Verfolgung
      meiner eigenen Ziele getan, nicht aus Alturismus. Vergeudet keine Komplimente
      an mich."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630190
    m_Localized: Oh, apropo, hast du dein Ziel erreicht @lp? Also falls es kein Geheimnis
      ist.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630191
    m_Localized: Ist in Ordnung. Ich habe dort bekommen was ich brauchte, aber jetzt
      sieht es so aus als ob ich noch weiter gehen muss.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630192
    m_Localized: Achso? Und wo solls hingehen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630193
    m_Localized: Manehattan.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630194
    m_Localized: Nicht doch.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630195
    m_Localized: Wieso?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630196
    m_Localized: "Davon mal abgesehen dass es ziemlich weit ist? Red Eye und die
      G\xF6ttinnen haben dort ihr Revier. Massenhaft einheimische Ponys werden dort
      gejagt und nach Fillydelphia r\xFCber verschleppt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630197
    m_Localized: "@lp, Ich wei\xDF dass du es gewohnt bist mit Sklavenh\xE4ndlern
      klar zu kommen aber dort ist alles anders. Dort gibt es viel mehr von denen,
      und Talons und Alih\xF6rner."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630198
    m_Localized: "Ehrlich gesagt ich wei\xDF nicht einmal wer die alle sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630199
    m_Localized: Oh man, ihr Stable Ponys...
    m_Metadata:
      m_Items: []
  - m_Id: 2733630200
    m_Localized: Eyep.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630201
    m_Localized: "Ich werde es dir erkl\xE4ren, @lp. Talons sind keine Ponys, es
      sind Greife. Hast du schon einmal von denen geh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630202
    m_Localized: Ich kann mich daran erinnern...
    m_Metadata:
      m_Items: []
  - m_Id: 2733630203
    m_Localized: "Also, Talons sind Greifen-S\xF6ldner. Ich wei\xDF nicht wie ich
      das sagen soll, aber... die f\xFChren ein anderes Leben. Und haben andere Prinzipien.
      Eigentlich sind das ganz normale Typen aber anstatt eines Gewissens haben die
      Vertr\xE4ge. Wer sie bezahlt, mit dem sind sie befreundet. Und momentan werden
      sie von Red Eye bezahlt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630204
    m_Localized: "Die sind schon seit Jahrzehnten S\xF6ldner und haben in dieser
      Zeit viele Kronkorken verdient. Und sie geben die Kronkorken aus um die t\xF6dlichsten
      Waffen in ganz Equestria zu kaufen, deshalb ist es ein gewagten Unterfangen
      sich mit denen anzulegen. Und dort wird es ein ganzes Batallion geben."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630205
    m_Localized: "Aber auch die sind noch nicht einmal so gef\xE4hrlich wie die Alih\xF6rner."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630206
    m_Localized: "Tats\xE4chlich ist wenig dar\xFCber bekannt was sie wirklich sind.
      Sie sehen aus wie Prinzessinin, haben aber nichts mit ihnen gemeinsam. Sie
      sind skrupellos, arrogant und egoistisch. Und sie besitzen sehr starke Magie."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630207
    m_Localized: "Aber das ist noch nicht alles. Ich habe keine Ahnung wie aber sie
      scheinen st\xE4ndig telepatisch miteinander in Kontakt zu stehen. Sie bezeichnen
      das als \"Einheit\" und versuchen jedes Pony in ihrer Gewalt da mit hineinzuziehen.
      Kopf dieser Einheit ist eine bestimmte G\xF6ttin welche die Anderen irgendwo
      vom inneren der Mariponi Basis aus befehligt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630208
    m_Localized: "Und sie sind Partner von Red Eye, deswegen helfen die Alih\xF6rner
      jetzt den Sklavenh\xE4ndlern."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630209
    m_Localized: "Und hier ist noch eine Kirsche f\xFCr oben drauf: Ponys die aus
      Manehatten gerettet wurden sagten sie h\xE4tten ein besonders gro\xDFes Alihorn
      gesehen. Sie sei be\xE4ngstigend wie die ewige Nacht und t\xF6dlich wie ein
      Rudel H\xF6llenhunde."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630210
    m_Localized: Willst du immer noch dort hingehen?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630211
    m_Localized: "Nein. Ich m\xF6chte gar nicht dort hin. Aber ich muss."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630212
    m_Localized: "Immer noch.., huh? Ich habe Mitleid mit dir.. Nun, dann bleibt
      mir nur noch eines zu sagen, @lp. Viel Gl\xFCck da drau\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630213
    m_Localized: "Richtig. Viel Gl\xFCck, @lp. Komm in einem St\xFCck zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630214
    m_Localized: "Und nimm das hier, du k\xF6nntest es in Manehattan gebrauchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630215
    m_Localized: Red Eye
    m_Metadata:
      m_Items: []
  - m_Id: 2733630216
    m_Localized: Calamity, Ich wollte dich schon lange etwas fragen. Wer ist dieser
      Red Eye?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630217
    m_Localized: "Ich habe schon mehrfach von ihm geh\xF6rt, wei\xDF aber au\xDFer
      dass er der Anf\xFChrer der Sklavenh\xE4ndler sein soll nichts weiter."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630218
    m_Localized: "Eyep, das stimmt. Er Befiehlt tats\xE4chlich diese Bastarde."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630219
    m_Localized: "Aber er bfiehlt nicht einfach nur Ponys zu schnappen und sie nach
      Fillydelphia zu entf\xFChren. Er glaubt ernsthaft dass er sie rettet und versucht
      so eine neue Welt aufzubauen. Naja, das behauptet er zumindest."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630220
    m_Localized: "Seine Basis ist in Fillydelphia, oder ehr die ganze Stadt. Dort
      arbeiten die Sklaven bis sie sterben. Sie bauen dort Fabriken wieder auf in
      denen sie Waffen f\xFCr die Red Eye Armee herstellen. Man sagt die Stadt sei
      echt gro\xDF geworden aber ich bin noch nie dort gewesen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630221
    m_Localized: "Und jeden Tag treibt er seine Ideen in die K\xF6pfe der Ponys,
      wie sie f\xFCr die Zukunft ihrer Fohlen leiden m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630222
    m_Localized: "Das ist alles Schwachsinn, @lp. Welche Zukunft k\xF6nnte auf Knochen
      gebaut werden? Sklaven sterben f\xFCr seine Ideen und seine Sklavenh\xE4ndler
      sind nichts als Banditen. So baut man keine Zukunft auf."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630223
    m_Localized: "Aber es gibt auch welche die ihm glauben. So bekommt er neue Rekruten
      f\xFCr seine Armee. Diese Rekruten gr\xFC\xDFen die Ponys auf der Stra\xDFe
      oft mit einer Kugel zwischen die Augen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630224
    m_Localized: Ja, jetzt wird mir langsam alles klar. Dannk dir, Calamity
    m_Metadata:
      m_Items: []
  - m_Id: 2733630225
    m_Localized: Ich werde versuchen seinen Gefolgsleuten ein paar Manieren beizubringen.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630226
    m_Localized: "Lass dich nicht mitrei\xDFen, @lp. Das letzte was ich m\xF6chte
      ist dass du get\xF6tet oder doch noch in die Sklaverei verschleppt wirst."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630227
    m_Localized: 'Ach ja, eine Sache noch: In seinen Reden soll er oft damit prahlen
      dass er aus einem Stable gekommen ist. Um ehrlich zu sein es gibt nicht mehr
      viele intakte Stable. Hat jemand deinen Stable in den letzten 10 Jahren verlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 2733630228
    m_Localized: Ich habe keine Ahnung. Er ist aus einem Stable sagst du?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630229
    m_Localized: Eyep.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630230
    m_Localized: Die Sache wird mehr und mehr interessanter.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630231
    m_Localized: Das Alihorn Amulett
    m_Metadata:
      m_Items: []
  - m_Id: 2733630232
    m_Localized: Oh!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630233
    m_Localized: STEHEN BLEIBEN, STERBLICHER. ZU DIR SPRECHEN DIE ABGESANTEN DER
      EINHEIT!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630234
    m_Localized: "Kannst du bitte aufh\xF6ren zu schreien??"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630235
    m_Localized: "STILL! DU HAST ES GEWAGT DEN BODEN ZU BETRETEN DER DEN WILLEN DER
      G\xD6TTIN GEWEIHT IST, UND DER H\xDCTERIN DES AMULETTS!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630236
    m_Localized: Das Alihorn Amulett, nehme ich an?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630237
    m_Localized: SCHWEIG!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630238
    m_Localized: "DU HAST ES AUCH GEWAGT UNSERE SCHWESTERN ANZUGREIFEN, IHNEN IN
      DEN R\xDCCKEN ZU FALLEN!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630239
    m_Localized: "DIE EINHEIT HAT IHR URTEIL GEF\xC4LLT. DU VERSIENTS NICHTS ANDERES
      ALS DEN TOD."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630240
    m_Localized: WIR SIND GEKOMMEN UM IHR URTEIL ZU VOLLSTRECKEN.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630241
    m_Localized: "DU HAST KEINE CHANCE UNS IN EINEM EHRENVOLLEN KAMPF ZU SCHLAGEN,
      WURM. DER ZORN DER G\xD6TTIN WIRD DICH ZU ASCHE VERBRENNEN. GIB AUF, UND DIE
      EINHEIT WIRD DICH WENIGER... SCHMERZVOLL STERBEN LASSEN."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630242
    m_Localized: Begegnung mit Blood Moon
    m_Metadata:
      m_Items: []
  - m_Id: 2733630243
    m_Localized: Begegnung mit Blood Moon
    m_Metadata:
      m_Items: []
  - m_Id: 2733630244
    m_Localized: "DER M\xC4CHTIGE M\xD6RDER DER ALIH\xD6RNER STATTET UNS ALSO EINEN
      BESUCH AB, WIR SIND FASZINIERT."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630245
    m_Localized: "Richtig. Und du bist die n\xE4chste."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630246
    m_Localized: "DEIN GREIST IST EINDRUCKSVOLL, ABER DEIN K\xD6RPER IST SCHWACH.
      DU BIST NICHTS, EIN H\xC4UFSCHEN STAUB VOR DEN HUFEN DER G\xD6TTIN."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630247
    m_Localized: "NOCH IST DIE HOFFNUNG F\xDCR DICH NICHT VERLOREN, STAUB. DU BESITZT
      GRO\xDFES POTENTIAL, UND DIE G\xD6TTIN GLAUBT DASS DU W\xDCRDIG BIST. W\xDCRDIG
      EINE VON UNS ZU WERDEN."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630248
    m_Localized: NIMM SEIN SCHICKSAL AN STERBLICHER, UND WERDE EIN TEIL DER EINHEIT.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630249
    m_Localized: "Was w\xE4re da f\xFCr mich drin?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630250
    m_Localized: "DIE G\xD6TTIN IST BEREIT DICH IN UNSERE REIHEN AUSZUNEHMEN. DU
      WIRST EINS MIT UNS WERDEN. EIN EINZIGER M\xC4CHTIGER GEIST, DAS ERBE EQUESTRIAS!
      DIE ALIHORN G\xD6TTINNEN NEHMEN KEINE GEW\xD6HNLICHEN KREATUREN WIE J\xC4MMERLICHEN
      SKLAVENH\xC4NDLER BEI SICH AUF. DU SCHLIE\xDFT DICH DER EINHEIT AN ODER GEHST
      IN FLAMMEN AUF. W\xC4HLE STERBLICHER, TRIFF DIE WICHTIGSTE ENTSCHEIDUNG DEINES
      LEBENS!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630251
    m_Localized: Mmm, well... nah, nicht interessiert.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630252
    m_Localized: WELCHE ARROGANZ. WIE DUMM!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630253
    m_Localized: DANN WIRST DU EBEN BRENNEN, INSEKT!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630254
    m_Localized: Das ist es nicht wahr? Das Alihorn Amulett.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630255
    m_Localized: "Ja, zweifellos! Wenn ich es in den Hufen halte, f\xFChle ich ein
      seltsames Zittern in meinen Muskeln. Ich scheine es mit Kraft zu versorgen."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630256
    m_Localized: Was passiert wenn ich es anlege?
    m_Metadata:
      m_Items: []
  - m_Id: 2733630257
    m_Localized: Ahh.. nicht so schnell Amulett!
    m_Metadata:
      m_Items: []
  - m_Id: 2733630258
    m_Localized: Ich darf und ich werde es nicht tragen, so ist es sicherer. Besser
      wenn ich es blos bei mir trage.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630259
    m_Localized: "Ich werde es dem Kurier des Mentors \xFCbergeben sobald sich die
      Gelegenheit dazu wieder ergibt."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630260
    m_Localized: "Calamity \xFCber Canterlot"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630261
    m_Localized: Hallo Calamity.
    m_Metadata:
      m_Items: []
  - m_Id: 2733630262
    m_Localized: "Sch\xF6n dich wiederzusehen, @lp. Ich hatte schon fast die Hoffnung
      verloren dass du zur\xFCckkommst.\nWas machen deine Gesch\xE4fte?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630263
    m_Localized: "Besser h\xE4tte es nicht laufen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823744
    m_Localized: "Wars das jetzt? H\xF6rst du jetzt auf dich in Gefahrensituationen
      zu st\xFCrzen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823745
    m_Localized: "Ich f\xFCrchte das war es noch nicht ganz. Jetzt muss ich nach
      Canterlot."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823746
    m_Localized: "Canterlot?..\nEs gibt einfachere Wege zu sterben, wei\xDFt du das?
      Welche Gesch\xE4fte treiben dich nach Canterlot?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823747
    m_Localized: "Ich tue das f\xFCr meinen Stable. Glaub mir, es ist wirklich wichtig."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823748
    m_Localized: "Ich hatte gehofft das nicht noch einmal h\xF6ren zu m\xFCssen.\nBist
      du dir da sicher?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823749
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823750
    m_Localized: Bin ich.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823751
    m_Localized: "Wie du meinst. Aber dabei kann ich dir nicht helfen.\nIch selbst
      bin noch nie dort gewesen. Ich wei\xDF nur was die Leute \xFCber diesen Ort
      sagen, und das ist nicht viel."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823752
    m_Localized: "Auf jeden Fall wei\xDF ich weniger als du. Sag mir was du wei\xDFt,
      vielleicht kann mir das dort wieder das Leben retten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823753
    m_Localized: "Gut, dann h\xF6re zu.\nMan erz\xE4hlt sich viele schreckliche Geschichten
      \xFCber diese Stadt. Vor dem Krieg war sie die Hauptstadt, und Celestia und
      Luna lebten dort. Dann haben die Zebras ein giftiges Gas dort freigesetzt,
      dass als Rosa Wolke bekannt ist und alles t\xF6tet. Diese Nebelwolke schmilzt
      und verklebt alles was sie ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823754
    m_Localized: '"Schmilzt"?'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823755
    m_Localized: "Eyep. Du wei\xDFt schon.. Aus zwei Dingen werden eins. Wie der
      PipBuck den du an deinem Bein tr\xE4gst. B\xE4\xE4\xE4m! Er klebt an dir an,
      damit du ihn nicht abschieben kannst ohne dein eigenes Fleisch zu zerrei\xDFen.
      Ich wei\xDF nicht ob das nur eine Geschichte ist um Fohlen zu erschrecken aber
      ich w\xFCrde es nicht ausprobieren.\nIch wei\xDF nicht genau was damals dort
      passiert ist aber von dieser Wolke soll es da eine Menge geben. Ich habe noch
      nicht davon geh\xF6rt dass Ponys jemals wieder von dort zur\xFCckgekehrt sein
      sollen, au\xDFer sie haben es sich kurz angesehen und sind schnell wieder verduftet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823756
    m_Localized: "Ich habe auch geh\xF6rt dass es dort Geister geben soll. Die Seelen
      von toten Ponys. Sie sind auf eine so schreckliche Art und Weise gestorben
      dass sie unsere Welt nicht mehr verlassen k\xF6nnen, und jetzt in Canterlot
      verweilen. Die einzige Freude die ihnen bleibt ist es sich die Lebenden zu
      holen. Und tun sie auch!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823757
    m_Localized: "Ich kann dir auch nicht einmal genau sagen wie du dort hin kommst.
      Ich wei\xDF dass es fr\xFCher die Hauptstadt war, also m\xFCssen viele Wege
      dort hin f\xFChren. Es soll im Norden liegen also w\xFCrde ich an deiner Stelle
      der Hauptstra\xDFe dort hin folgen, bis ich etwas finde das mich weiter bringt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823758
    m_Localized: "Ich glaube deine Ratschl\xE4ge werden mir sehr helfen Calamity.
      Dank dir."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823759
    m_Localized: "@lp?\nDu solltest nicht dort hin gehen, wei\xDFt du? Ich wei\xDF
      nicht was mit deinem Stable los ist aber kein Pony sollte so sehr sein Leben
      aufs Spiel setzen m\xFCssen. Du k\xF6nntest bei uns bleiben, die Leute hier
      w\xFCrden dich gerne aufnehmen. Du k\xF6nntest ein Mitglied der Patrouille
      werden, oder Winrys Lehrling, oder vielleicht er\xF6ffnest du auch dein eigenes
      Gesch\xE4ft. Du bist ein gutes M\xE4dchen das kann jeder sehen. Bleib einfach
      hier."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823760
    m_Localized: Ich werde bei euch bleiben. Irgendwann einmal. Aber nich jetzt.
      Ich kann meine Mission jetzt nicht aufgeben.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823761
    m_Localized: "Du solltest das nicht tun, @lp. Nat\xFCrlich ist es deine Entscheidung
      aber ich sage dir, du machst einen Fehler. Sag mir doch wenigstens wof\xFCr
      du das alles machst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823762
    m_Localized: Tut mir leid, Calamity. Das kann ich nicht. Es soll so sein.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823763
    m_Localized: "Gut dann, viel Gl\xFCck dir. Mal wieder."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823764
    m_Localized: "Eine letzte Frage.\nWas meintest du mit: \"Ich hatte gehofft das
      nicht noch einmal h\xF6ren zu m\xFCssen\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823765
    m_Localized: "Ist egal. Mache dir dar\xFCber keine Gedanken."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823766
    m_Localized: Begegnung mit den Zebras
    m_Metadata:
      m_Items: []
  - m_Id: 2737823767
    m_Localized: "Bleib wo du bist! Die Hufe so dass ich sie sehen kann. Ich wei\xDF
      nicht ob es dir nicht aufgefallen ist aber deine Verkleidung funktioniert nicht!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823768
    m_Localized: "Bedrohe uns nicht, Fremder. Du bist alleine und wir sind zu f\xFCnft.
      Du w\xE4rst besser dran wenn jeder von uns seiner Wege geht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823769
    m_Localized: Wenn das ein Trick ist, werdet ihr es bereuen. Wo wollt ihr hin?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823770
    m_Localized: "Ponys sind keine Freunde der Legion, daher bist du nicht unser
      Feind. Wir gehen nach Hause. T\xF6ten Ponys etwa diejenigen die nach hause
      zur\xFCckkehren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823771
    m_Localized: Legion? Was ist das?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823772
    m_Localized: "Unsere Feinde, und auch die deinen. Zebras, die in der Vergangenheit
      leben und immer noch den Krieg f\xFChren der vor zweihundert Jahren endete."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823773
    m_Localized: Ja, solchen bin ich begegnet. Ehrlich gesagt hatte ich erwartet
      dass ihr mich angreift. Ich bin froh dass ihr anders seid.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823774
    m_Localized: "Zebras uns Ponys sollten keine Feinde sein. Wir haben uns fr\xFCher
      bek\xE4mpft, und was haben wir dadurch erreicht? Wir begr\xFC\xDFen immer neue
      Freunde die wir hier treffen. Und wir haben gelernt dass auch ihr Ponys mit
      Freundlichkeit und Gastfreundschaft reagieren k\xF6nnt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823775
    m_Localized: "K\xFCrzlich haben wir schon einmal ein freundliches Pony getroffen.
      Eine schwarze Stute rettete zwei unserer Br\xFCder das Leben, kam dann mit
      zu uns nach Hause und rettete noch mehr Leben. Wenn sie nicht gewesen w\xE4re
      h\xE4tten wir uns von vielen Zebras verabschieden m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823776
    m_Localized: "Ein schwarzen Pony? Hat sie zuf\xE4llig ein Ger\xE4t wie dieses
      an ihrem Bein?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823777
    m_Localized: "Ja, so eins tr\xE4gt sie. Kennt ihr euch?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823778
    m_Localized: Ich muss mit ihr sprechen. Bitte, nehmt mich zu euch mit.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823779
    m_Localized: Wir werden dich mit uns nehmen, Fremder. Aber sei dir gesagt dass
      wir nicht zulassen werden dass du ihr etwas tust. Versuche es erst gar nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823780
    m_Localized: Alles klar, lasst uns losgehen!
    m_Metadata:
      m_Items: []
  - m_Id: 2737823781
    m_Localized: Das ist also eure Siedlung? Sieht... bescheiden aus.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823782
    m_Localized: "Wir m\xFCssen unter schwierigen Bedingungen \xFCberleben. Daf\xFCr
      ist das Risiko hier in der n\xF6rdlichen Wildnis auf Soldaten der Legion zu
      sto\xDFen gering."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823783
    m_Localized: "Bel\xE4stigen sie euch?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823784
    m_Localized: "Gl\xFCcklicherweise nicht. Jedoch gelten wir bei ihnen als Verbrecher
      und Verr\xE4ter und sie w\xFCrden uns ohne Vorwarnung t\xF6ten wenn sie uns
      sehen. Deshalbs sind wir gezwungen uns zu verstecken. Aus ihrer Sicht sind
      wir nichts als nervige Insekten und solange sie gr\xF6\xDFere Probleme haben
      werden sie nicht nach uns suchen. Wenn die Legion jedoch beschlie\xDFt hier
      durch zu kommen werden sie uns fr\xFCher oder sp\xE4ter finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823785
    m_Localized: Dann, solltet ihr vielleicht weiter Richtung Norden ziehen oder?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823786
    m_Localized: "Es hat keinen Sinn, sich vor den Kundschaftern und Spionen der
      Legion zu verstecken. Und wenn wir weiter nach norden gehen entfernen wir uns
      nur weiter von unseren bekannten Nahrungsquellen und Vorr\xE4ten. Wir sind
      nicht die einzigen Zebras die sich vor der Legion verstecken. Aber weder wir
      noch die anderen Siedlungen haben bishier im Norden von Canterlot etwas interessantes
      gefunden. Es gibt keinen Ort an den man gehen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823787
    m_Localized: "Und wie wollt ihr dann \xFCberleben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823788
    m_Localized: "Irgendwie, so wie wir es jetzt tun. Zumindest versuchen sie hier
      nicht uns zu t\xF6ten. Das ist schon mal etwas."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823789
    m_Localized: "Du wolltest deine Ponyfreundin sehen. Sie muss in dem Geb\xE4ude
      dort sein und auf Zira aufpassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823790
    m_Localized: "Ah ja, dank dir, \xE4hmm... Wir haben uns noch nicht vorgestellt
      oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823791
    m_Localized: Askari.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823792
    m_Localized: '@lp. Danke noch einmal.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823793
    m_Localized: Triff Velvet Remedy
    m_Metadata:
      m_Items: []
  - m_Id: 2737823794
    m_Localized: Velvet? Chosen-24?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823795
    m_Localized: Haben wir uns schon einmal getroffen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823796
    m_Localized: "M\xF6glicherweise, in der Vergangenheit.. vermutlich. In der Gegenwart..
      noch nicht.\nIch bin Chosen-25. Mein name ist @lp. Ich wurde entsandt um deine
      Mission zu beenden. Ich bin froh dich endlich zu treffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823797
    m_Localized: "Armes Kind...\nSie haben deine Errinerung gel\xF6scht, nicht wahr?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823798
    m_Localized: Das stimmt.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823799
    m_Localized: Und dich ausgesandt um die Daten aus der Fabrik zu holen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823800
    m_Localized: Ja, haben sie.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823801
    m_Localized: Ich hoffe du warst schlau genug das nicht zutun.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823802
    m_Localized: "Ich habe die Daten bekommen und sie dem Mentor \xFCbergeben. Ich
      habe auch neue Auftr\xE4ge von ihm erhalten. Einer davon f\xFChrt mich nun
      nach Canterlot."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823803
    m_Localized: "Heilige Celestia...\nDu hast keine Ahnung was du da tust oder?
      Hast du irgendwas \xFCber das Projekt erfahren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823804
    m_Localized: "Nein, die Daten wurden gel\xF6scht nachdem ich sie an den Stable
      geschickt hatte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823805
    m_Localized: "Dann besteht immer noch die Chance dich nur Vernunft zu bringen.\nDu
      solltest diesen Ponys nicht helfen, wei\xDFt du? Was der Mentor sucht ist eine
      Waffe. Und diese Waffe wird nur noch mehr Schmerz in diese Welt bringen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823806
    m_Localized: "Woher wei\xDFt du das?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823807
    m_Localized: "Ich habe die Notizen dazu gelesen. Ich la\xDF sie.. Das Projekt
      \"Sun\" hat nur Zerst\xF6rung zum Ziel. Eine Waffe mit solch einer Macht kann
      nichts gutes bewirken."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823808
    m_Localized: Jede Waffe kann zum Schutz, oder zumindest als Warnung verwendet
      werden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823809
    m_Localized: "Sieh dich um, @lp. siehst du das? Das hier sind die Folgen einer
      \"Warnung\". Fr\xFCher dachten die Ponys, je mehr Waffen sie h\xE4tten desto
      sicherer seien sie. Jetzt leben nur noch ein Huf voll ihrer Nachkommen auf
      dessen was diese Ponys damals als Heimat bezeichneten.\nAuch wenn dieser sogenannte
      \"Mentor\" an die guten Absichten dieses Projekts glaubt, so bleibt das Ergebnis
      das Gleiche. Und Stable Pi wird alles was er ber\xFChrt verderben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823810
    m_Localized: "Diese Welt und die Ponys in ihr brauchen keine Waffen mehr, @lp.
      Sie m\xFCssen Leben. Leben und gedeihen. Ist das nicht unsere Aufgabe? Wir
      m\xFCssen diesen armen Ponys, Zebras und anderen Kreaturen die hier leben helfen
      ohne sie zu t\xF6ten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823811
    m_Localized: "Nicht alle Ponys sind bereit diese Hilfe auch anzunehmen, Velvet.
      Kannst du das nicht sehen? du warst eine Gefangene der Sklavenh\xE4ndler, das
      wei\xDFt du doch! Wie haben sie dich behandelt? Wie gehen sie mit allem um
      was ihnen in die Hufe f\xE4llt? Lege die Waffen nieder und du wirst in Ketten
      enden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823812
    m_Localized: "Es gibt andere M\xF6glichkeiten sich zu sch\xFCtzen. Ohne das \"Sun\"
      Projekt. Jahrhunderte lang lebe Stable Pi ohne das, und es wir auch Jahrhunderte
      weiterbestehen. Der Mentor macht es nur schlimmer f\xFCr uns und f\xFCr alle
      anderen wenn er versucht dieses finstere Projekt aus der Vergangenheit zu vollenden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823813
    m_Localized: "Du weist einfach alle Argumente des Mentors zur\xFCck. Warum glaubst
      du nicht dass das alles f\xFCr einen h\xF6heren Zweck bestimmt sein k\xF6nnte?
      Was wei\xDFt du wirklich \xFCber die potentielle Verwendung? Die Pl\xE4ne dar\xFCber
      sagen nicht viel aus oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823814
    m_Localized: "Richtig, tun sie nicht. Aber Waffen erf\xFCllen nur einen Zweck
      - zu t\xF6ten. Und egal wie sehr sich ihre Besitzer als Verteidiger ausgeben,
      fr\xFCher oder sp\xE4ter werden sie zu M\xF6rdern. Es gibt keine andere M\xF6glichkeit
      in dieser von der G\xF6ttin verlassenen Welt. Ich bin schon l\xE4nger hier
      als du, @lp, Ich wei\xDF das. Ich sehe es jeden Tag. Der Mentor wird genau
      so enden und alle andere mit sich rei\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823815
    m_Localized: "Und wenn es doch anders wird? Was wenn diese Waffe helfen kann
      das B\xF6se in dieser Welt zu besiegen? W\xE4re Equestria dann nicht besser?
      Stelle dir mal vor wenn das Schicksal der Ponys denen du hilfst nicht mehr
      darin besteht im Sklaventum zu sterben, oder Alih\xF6rner zu werden. W\xFCrde
      es sich nicht lohnen daf\xFCr zu k\xE4mpfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823816
    m_Localized: "Du bist wirklch naiv, @lp. Alle Waffen die in Equestria hergestellt
      wurden... Ob Karabinar oder Messer wurden f\xFCr einen Zweck geschaffen, dem
      sie entsprechen sollten. Zum Schutz. Und jedes Mal versagten sie und machten
      alles nur noch schlimmer."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823817
    m_Localized: "Aber dieses Mal kennen wir den Preis f\xFCr unsere Fehler, Velvet!
      Dieses mal verstehen wir wof\xFCr wir k\xE4mpfen und was wir zu verhindern
      versuchen. Die Ponys von damals wussten das nicht und so starben sie.\nIch
      glaube dem Mentor. Ich glaube dass er versteht was er da zu erreichen versucht.
      Viel besser als ich oder du. Und dass er nichts b\xF6ses damit vor hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823818
    m_Localized: "Ich kann dir da nicht zustimmen, @lp. Du hast deine Wahrheit und
      ich meine. Ich kann nur hoffen dass du Recht hast und ich nicht, weil ich dich
      nicht aufhalten kann wenn etwas schief l\xE4uft und nicht so ist wie du es
      dir vorgestellt hast. Aber ich m\xF6chte dich mal etwas fragen.\nVersprich
      mir dass der Mentor Equestria nichts antut wenn es nicht so wird wie du es
      erwartest."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823819
    m_Localized: "Ich verspreche es. Ich wei\xDF das er nichts \xFCbles im Schilde
      f\xFChrt, aber ich verspreche es."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823820
    m_Localized: Danke, @lp.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823821
    m_Localized: Ich bin froh dich endlich gefunden zu haben, Velvet. Immerhin sind
      wir aus dem gleichen Stable. Es bedeutet viel, ein Pony zu finden dass einen
      versteht.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823822
    m_Localized: "Aus dem gleichen Stable. Mit der gleichen Geschichte. Sie l\xF6schten
      unsere Erinnerung um sich vor den Bedrohungen zu sch\xFCtzen und \xFCberlie\xDFen
      uns dem grausamen \xD6dland. Was k\xF6nnte uns jetzt noch \xFCberraschen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823823
    m_Localized: Jeah.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823824
    m_Localized: "Gespr\xE4ch mit Velvet"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823825
    m_Localized: "Wie gesagt ich muss jetzt nach Canterlot. Wei\xDFt du irgendwas
      \xFCber diesen Ort?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823826
    m_Localized: Ich bestehe immer noch darauf dass du deine Mission vergisst, @lp.
      Wenn nicht um die Welt von einer Bedrohung zu befreien, dann zumindest um deiner
      eigenen Sicherheit willen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823827
    m_Localized: Ich werde mein Ziel nicht aufgeben, Velvet. Tut mir leid.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823828
    m_Localized: In Ordnung, ich werde deinen Standpunkt akzeptieren.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823829
    m_Localized: "Die Zebras die hier leben wandern ab und zu nach Canterlot. Es
      ist sehr gef\xE4htlich aber wenn du wei\xDFt wo die Bedrohung dort her kommt
      besteht die Chance dass du leben zur\xFCckkehrst.\nFrag Zambezi danach, sie
      war schon mehrmals in in der Stadt. Manchmal kann das Bed\xFCrfnis zu \xDCberleben
      dazu f\xFChren dass man schreckliche Risiken eingeht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823830
    m_Localized: "Danke. Kannst du mir noch etwas \xFCber diese Siedlung hier erz\xE4hlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823831
    m_Localized: "Sicher doch.\nVerdecktes Zeichen ist die Zuflucht jener Zebras,
      die den Ruf der Legion nicht gefolgt sind. Die Zebras der Legion hassen Ponys
      von ganzem Herzen und glauben dass sie uns alle vernichten m\xFCssen. Sie verlangen
      dass jedes Zebra in diesen heiligen Krieg unter ihrem Banner steht. Wenn sich
      Zebras weigern werden sie zu den gleichen Feinden der Legion wie die Ponys."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823832
    m_Localized: "Verdecktes Zeichen ist ihr Versteck. Hier findet die Legion sie
      nicht. Aber es ist sehr schwierig in der Wildnis zu \xFCberleben. Viele werden
      krank, und das ganze Lager muss von Zeit zu Zeit hungern. Sie erhalten die
      notwendigen Ressourcen entweder durch lange Reisen in verlassene St\xE4dte
      oder durch \xE4u\xDFerst riskante \xDCberf\xE4lle auf Caterlot. Aber nur wenige
      wagen es die zweite Option zu w\xE4hlen, und diejenigen die es tun gelten als
      Helden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823833
    m_Localized: "Ich kam hier her als ich eine Gruppe lokaler Zebras traf, die die
      Ruinen von Manehatten erkundeten. Sie brauchten \xE4rztliche Hilfe die sie
      nirgendwo bekommen konnten. Ich habe ihnen geholfen ihr Zuhause zu erreichen,
      und jetzt k\xFCmmere ich mich hier um die bed\xFCrftigen. Sie brauchen viel
      mehr Hilfe als andere Ponys."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823834
    m_Localized: Danke nochmals, Velvet. Vielleicht kann ich ihnen auch etwas helfen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823835
    m_Localized: "Das w\xE4re gro\xDFartig."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823836
    m_Localized: Dieser Vogel,.. er ist... wundervoll...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823837
    m_Localized: Qwirrr!
    m_Metadata:
      m_Items: []
  - m_Id: 2737823838
    m_Localized: "Ich wei\xDF nicht was ich sagen soll... so einen Freund h\xE4tte
      ich auch gerne."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823839
    m_Localized: "Zambezi \xFCber Canterlot"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823840
    m_Localized: Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 2737823841
    m_Localized: Hallo auch du, Reisender. Mein Name ist Zambezi. Und wie lautet
      deiner?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823842
    m_Localized: '@lp. Freut mich dich kennen zu lernen. Mir wurde gesagt dass du
      das Zebra bist dass die gefahren von Canterlot besser kennt als jedes andere.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823843
    m_Localized: Das ist wahr, ich kann es nicht leugnen. Ich habe viele Reisen in
      diese verdammte Stadt unternommen. Versuchst du auch dort hin zu kommen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823844
    m_Localized: "Leider schon. Ich muss tats\xE4chlich nach Canterlot. Kann du mit
      da helfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823845
    m_Localized: "Wissen, ist kostbar in diesen Tagen, und normalerweise nicht umsonst
      zu haben. Doch diejenigen, die versuchen von bed\xFCrftigen zu profitieren,
      werden ihr Gl\xFCck ganz schnell wieder verlireren. Ich werde dir sagen was
      ich kann, ohne einen Kronkorken da\xFCfr zu verlagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823846
    m_Localized: "Einst gab es Krieg zwischen den Ponys und den unsrigen. Anfangs
      war die Zwietracht klein, doch das sollte nicht lange so sein. Sie wuchs von
      Jahr zu Jahr, bis die Welt durch Feuer und Angst niedergebrannt war. Als dies
      passierte, griffen die Zebraschamanen zu den m\xE4chtigsten Zaubern die auf
      dieser Welt existierten. - Nekromantie"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823847
    m_Localized: "Sie schufen ein Gas, die Rosa Wolke, und schlossen es in Amulette
      aus denen ein ewiger Strom flie\xDFen sollte. Die Amulette wurden heimlich
      in der Stadt versteckt, und zur rechten Stunde entlie\xDF man den t\xF6dlichen
      Effekt.\nDiejenigen die in die Wolke gerieten, fanden nach ihrem tod, nie wieder
      Fireden. Sie sind dazu verdammt sich immer wider zu erheben, und durch die
      Stra\xDFen zu wandern in denen sie einst lebten. Wenn du das Pech hast ihnen
      zu begegnen, stelle sicher dass sie wirklich nicht mehr leben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823848
    m_Localized: "Aber nicht nur die Ponys sind bedroht, der Hass der Schamanen war
      so gro\xDF dass die Wolke den Ort noch immer bewohnt. Die beste Maske wird
      dich nicht sch\xFCtzen, selbst deine R\xFCstung kann dir dort nicht n\xFCtzen.
      Lege alles ab, was du nicht misst, denn sonst die Wolke es mit dir verschmilzt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823849
    m_Localized: "An einigen Stellen ist die Wolke so dicht, dass sie wurde fest
      oder gar fl\xFCssig. Denke nicht einmal daran in diesen Schleim hinein zu treten,
      es wird dir dabei nur Unheil geschehen. Es bekommt dich die ganze Macht der
      Wolke zu fassen, wie an dem Tag an dem sie in die Welt entlassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823850
    m_Localized: "Die dunkelste Frucht der Wolke sind die Nekrosprites, ihr schecklicher
      Anblick auch sp\xE4ter noch plagt deinen Geist. Der Schwarze Dunst ist zum
      Leben erweckt, gew\xF6hnliche Waffen haben auf ihn keinen Effekt. Sie werden
      ihn hindurchschreiten, als versuchtest du einen Schatten zu teilen. Das einzige
      was hilft ist Magie, ansonsten kannst du nur noch fliehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823851
    m_Localized: "Die dunkle Magie erfasste selbst leblose Dinge, Sender verbreiten
      die t\xF6dlichen Kl\xE4nge. Zerst\xF6re sie, ohne dich ihnen zu n\xE4hern,
      denn dies w\xE4re ein gro\xDFer Fehler."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823852
    m_Localized: "Was? Das klingt als w\xE4re dieser Ort eine einzige Todesfalle.
      Gibt es dort etwas was nicht mit einem schnellen Tod verbunden ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823853
    m_Localized: "Eine weitere Bedrohung erschien k\xFCrzlich in der verfluchten
      Stadt. Eine Kreatur mit H\xF6rnern und Fl\xFCgeln welche die Katakomben bewohnt,
      bringt jedem der sich nicht vorsieht einen schrecklichen Tod. Duch Schatten
      an den W\xE4nden kannst du sie erkennen, doch du kannst nichts weiter tun als
      fort zu rennen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823854
    m_Localized: "Es gibt... viel zu \xFCberdenken. Vielleicht m\xF6chte ich jetzt
      doch nicht mehr dort hin."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823855
    m_Localized: "Nur gr\xF6\xDFte Not kann Ponys und Zebras dazu bewegen sich dort
      hin zu begeben, wenn dein Ziel so wichtig ist, solltest du es erw\xE4gen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823856
    m_Localized: 'Ich werde mein Ziel nicht aufgeben. Danke Zambezi. Eines noch:
      Wie gelange ich am schnellsten nach Canterlot?'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823857
    m_Localized: "Der einfachste Weg f\xFChrt \xFCber die Stra\xDFe im Norden der
      Stadt, erst gerade aus und dann biegst du Rechts ab. Nach einem halben Tag
      kannst du die Kuppeln am Horizont schon sehen, dann kannst du dein Ziel nicht
      mehr verfehlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823858
    m_Localized: Danke nochmal!
    m_Metadata:
      m_Items: []
  - m_Id: 2737823859
    m_Localized: Hey, Velvet! Was ist mit diesem Zebra hier passiert, ist sie krank?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823860
    m_Localized: "Das ist Zira. Ja, ich f\xFCrchte sie hat Fieber. Sie ist schon
      mehrere Tage bewusstlos und ich kann nichts tun. Anscheinend reichen meine
      medizinischen Kenntnisse daf\xFCr nicht aus..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823861
    m_Localized: Darf ich mal schauen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823862
    m_Localized: "Wenn du in Medizin ausgebildet bist, dann nat\xFCrlich. Vielleicht
      kannst du ja helfen eine Diagnose zu stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823863
    m_Localized: Du untersuchst das kranke Zebra, kannst aber abgesehen von Fieber
      und schneller Atmung keine besonderen Symptome erkennen. Deine medizinischen
      Kenntnisse reichen hier nicht aus.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823864
    m_Localized: "Du untersuchst das kranke Zebra uns stellst eine Reihe charakteristischer
      Symptome fest. Unz\xE4hlige medizinische Zeitschriften die du gelesen hast
      geben dir die M\xF6glichkeit dich an eine seltene Krankheit zu erinnern, die
      Symptome abzugleichen und eine Diagnose zu stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823865
    m_Localized: "Ich glube ich wei\xDF was mit ihr nicht stimmt. Bei all den Symptomen
      scheint es sich um ein Staub-Fieber zu handeln."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823866
    m_Localized: "Hmm... Ja, vielleicht hast du recht. Aber diese Krankheit ist sehr
      selten. Wie... nun.. das spielt keine Rolle. Wenn ja dann besteht keine Chance
      sie mit Tr\xE4nken oder Zauberspr\xFCchen zu heilen. Nur ein Impfstoff kann
      hefen, aber ich habe keine Ahnung wo man den her bekommen k\xF6nnte. Alles
      was wir hier haben sind alte Vorkriegsreserven und Tr\xE4nke aus eigener Produktion."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823867
    m_Localized: "M\xF6glicherweise kann Doktor Sepsis helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823868
    m_Localized: "K\xF6nnte sein. Au\xDFerdem k\xF6nnten wir sowieso keinen besseren
      Arzt finden. Ich verstehe dass du viel zutun hast, @lp, aber k\xF6nntest du
      ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823869
    m_Localized: "Aber sicher Velvet, kein Problem. Ich werde dem Dok so bald wie
      m\xF6glich einen Besuch abstatten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823870
    m_Localized: "Bitte beeile dich. Ich wei\xDF nicht wieviel Zeit ihr noch bleibt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823871
    m_Localized: "Hallo, Dok. Ich h\xE4tte hier eine dringende Angelegenheit."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823872
    m_Localized: "Erz\xE4hle. Braucht ein Pony Hilfe?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823873
    m_Localized: Ja. Ein... Pony... hat Staub-Fieber. Ich brauche einen Impfstoff,
      sonst...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823874
    m_Localized: Sonst stirbt es. Ich verstehe schon. Aber bist du dir da sicher
      dass es diese Krankheit ist? Das ist wirlich selten.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823875
    m_Localized: "Alle Sympthome stimmen \xFCberein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823876
    m_Localized: "\"Alle Sympthome\"? Also hast du beschlossen jetzt Artzt zu werden?
      Bist du dir dar\xFCber im klaren dass diese Sache kein Spiel ist? Das Leben
      eines Ponys h\xE4ngt von deiner Entscheidung ab. Wenn du die Krankheit falsch
      disgnostizierst, kann der Patient leicht sterben, w\xE4ren du dich fragst warum
      die Behandlung nicht gewirkt hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823877
    m_Localized: "Dok, ich verstehe dass es ernst ist und ich nicht die richtige
      Ausbildung habe um mich f\xFCr den Doktorgrad zu qualifizieren. Ich habe mich
      jedoch mittlerweile ziemlich lange mit Medizin befasst, und die Symptome des
      Patienten stimmen genau mit der Beschreibung des Staubfiebers \xFCberein: der
      Patient leidet unter Tr\xE4nenden Augen, einer R\xF6tung der Schleimhaut des
      Auges, als w\xE4re Sand darin obwohl die Untersuchung der Augenlieder keine
      Hinweise auf Fremdk\xF6rper ergab. Die Temperatur ist merklich h\xF6her als
      die \xFCblicher katarrhalischen Temperaturen und deutet ehr auf eine Virusinfektion
      hin. Aber es gibt kein Schwitzen dass f\xFCr solch eine Krankheit charateristisch
      w\xE4re. Und..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823878
    m_Localized: "Stop, das reicht. Wenn das echte Sympthome sind dann stimme ich
      h\xF6chstwahrscheinlich zu dass er Patient das Staub-Fieber hat. Ohne eine
      pers\xF6nliche Untersuchung kann ich nichts sicher sagen, aber dieses mal vertraue
      ich deinen Beobachtungen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823879
    m_Localized: 5000 Kronkorken.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823880
    m_Localized: Wow! Ist das nicht ein bisschen viel?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823881
    m_Localized: "Ich habe diese Ampulle von einem fahrenden H\xE4ndler f\xFCr 4500
      Kronkorken erstanden, ohne zu wissen ob ich jemals einen Patienten mit dieser
      Krankheit haben w\xFCrde. Und die ganze Zeit habe ich sie unter geeigneten
      Lagerbedinungen aufbewahrt, die \xFCbrigens Strom verbrauchen. Und der Kraftstoff
      f\xFCr die Generatoren ist nicht umsonst wie du wei\xDFt. Also sag lieber \"Danke\"
      daf\xFCr dass ich dir die Medizin fast zum Selbstkosten-Preis verkaufe und
      dich dabei nicht an deine Einnahmen aus dem Verkauf von Waren aus der Vorkriegs-Zeit
      erinnere."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823882
    m_Localized: "Um der G\xF6ttinnen willen! Also sch\xF6n, gib mir den Impfstoff,
      ich zahle."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823883
    m_Localized: "Du injizierst dem Patienten den Impfstoff und stellst fast sofort
      positive Ver\xE4nderungen fest. Sie atmet jetzt gleichm\xE4\xDFiger und tiefer
      und das Fieber geht zur\xFCck. Es scheint als sei die Kriese \xFCberstanden
      und dass sie jetzt gesund werden wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823884
    m_Localized: "Sieht gut aus, Zira wird sich bald besser f\xFChlen. Was f\xFCr
      ein gutes Gef\xFChl anderen zu helfen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823885
    m_Localized: Ich sollte sie in ein oder zwei Tagen wieder aufsuchen und schauen
      wie es ihr geht.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823886
    m_Localized: '@lp! ich bin froh dass du gekommen bist. Es ist wegen Zira.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823887
    m_Localized: Was? Was ist los? Geht es ihr besser?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823888
    m_Localized: "Ja! Wahrscheinlich wird sie noch eine Weile im Bett bleiben m\xFCssen
      aber die Gefahr ist vor\xFCber, daran besteht kein Zweifel. Und alles dank
      dir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823889
    m_Localized: Ach bitte, das war doch nichts.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823890
    m_Localized: "Nein, @lp! andere zu helfen ist nicht \"nichts\"! Tats\xE4chlich
      erschienst du mir bei unseren ersten Treffen wie die Einheimischen hier, die
      nur wissen wie man \xFCberlebt. Aber du hast bewiesen dass du mehr kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823891
    m_Localized: "Hier, ich habe ein kleines Geschenk f\xFCr dich. Eine Figur des
      besten Ponys \xFCberhaupt. Ihre Freundlichkeit und ihr Mitgef\xFChl waren Grenzenlos
      - Fluttershy, die Chefin des Friedensministeriums. M\xF6ge sie immer bei dir
      sein, so wie sie bei mir ist..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823892
    m_Localized: Alles in Ordnung. Ich lasse sie jetzt ein wenig schlafen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823893
    m_Localized: Sie braucht dringend eine Behandlung.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823894
    m_Localized: Hallo, Bist du nicht @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823895
    m_Localized: Du bist aufgewacht? Ich bin froh das zu sehen! Hallo! Ja das bin
      ich.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823896
    m_Localized: Velvet sagte mir dass du die Medizin besorgt hast die mich gerettet
      hat.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823897
    m_Localized: Nun, so schwer war das nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823898
    m_Localized: Vielleicht nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823899
    m_Localized: Wie geht es dir...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823900
    m_Localized: "Vielleicht war es wirklich einfach f\xFCr dich, dieses Medikament
      zu bekommen. Vielleicht h\xE4tte ich mich auch ohne es erholt. Vielleicht..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823901
    m_Localized: "Ich wei\xDF nicht was ich sagen soll. ich bin \xFCberrascht!\nHier
      im Verdeckten Zeichen helfen wir uns immer gegenseitig. Wir sind darauf angewiesen
      um zu \xFCberleben. Aber wir leben auch zusammen. Und du ... nur ein Vorbeiziehender."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823902
    m_Localized: "Nun, ich war in der Lage helfen, warum h\xE4tte ich es nicht tun
      sollen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823903
    m_Localized: "Was geht dich das an? Du hast geholfen, ohne eine Gegenleistung
      daf\xFCr zu erhalten. In unserer Welt kann das schlimm enden, das wei\xDF jeder.
      Es ist nicht leicht zu \xFCberleben, alles ist wertvoll. Du und deine Freundin
      sind so ... unglaublich! Ja, umwerfend.\nWenn ihr dumm w\xE4rt, w\xE4re das
      verst\xE4ndlich. Aber dumme Ponys leben nicht lange."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823904
    m_Localized: "Velvet hat uns viele Dinge erz\xE4hlt. Wie die Welt fr\xFCher war,
      das was wir brauchen, um anderen zu helfen. Ich wei\xDF nicht, ich kann nicht
      glauben dass man so \xFCberleben kann wie ihr es jetzt tut. Aber irgendwie
      habt ihr beide es geschafft.\nDanke f\xFCr die Hilfe. Daf\xFCr dass du mir
      geholfen hast, obwohl du mich \xFCberhaupt nicht kennst. Und daf\xFCr dass
      du nicht so lebst wie wir es tun. Du und Velvet ... Ich verstehe es nicht,
      aber es freut mich zu sehen, dass du es schaffst, so zu leben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823905
    m_Localized: "Ich wei\xDF nicht, ob meine Antwort dir weiter hilft, aber ich
      bin nur froh zu sehen, dass du dich besser f\xFChlst. Ich bin einfach jemand,
      der nicht das Leben anderer Ponys ruiniert. Oder das der Zebras."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823906
    m_Localized: "Ich kenne dich nicht gut, m\xF6glicherweise werde ich das nie.
      Aber Velvet sagte dasselbe. Darin seid ihr euch \xE4hnlich."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823907
    m_Localized: "\xDCber die Rosa Wolke"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823908
    m_Localized: "Canterlot! Die fr\xFChere Hauptstadt von Equestria ... Das muss
      einmal eine wundersch\xF6ne Stadt gewesen sein. Was haben sie dir angetan?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823909
    m_Localized: "In den Ruinen von Canterlot warten viele Gefahren auf dich. Die
      gef\xE4hrlichsten davon sind die Rosa Wolke und die dunkle Magie. Denke daran,
      dass R\xFCstungen nicht vor dunklen Zauberspr\xFCchen sch\xFCtzen und die Wirkung
      der Rosa Wolke nur verschlimmern! Erfahrene Kundschafter, die Canterlot besucht
      haben, raten ausdr\xFCcklich davon ab, R\xFCstungen zu tragen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823910
    m_Localized: Transmitter
    m_Metadata:
      m_Items: []
  - m_Id: 2737823911
    m_Localized: "Was ist das?... argh! Dieses furchtbare Ger\xE4usch.. als stecke
      mein Kopf in einem Schraubstock."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823912
    m_Localized: "Ahh, das ist ein Lautsprecher aus dem dieses verdammte Ger\xE4usch
      kommt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823913
    m_Localized: "Es w\xE4re gef\xE4hrlich sich ihm zu n\xE4hern. Ich frage mich
      ob ich ihn aus dieser Entfernung treffen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823914
    m_Localized: Begegnung mit Stahlhufe
    m_Metadata:
      m_Items: []
  - m_Id: 2737823915
    m_Localized: "Wir gr\xFC\xDFen dich Fremder. Wir hatten nicht erwartet an diesem
      Ort ein vern\xFCnftiges Pony anzutreffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823916
    m_Localized: Das stimmt wohl. Was haben Ponys wie ihr in Canterlot zu suchen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823917
    m_Localized: "Ponys wie wir? Das klingt so als h\xE4ttest du schon einmal ein
      paar von uns getroffen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823918
    m_Localized: "Habe ich. Ungl\xFCcklicherweise haben wir uns nicht gut verstanden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823919
    m_Localized: "Bitte um Erlaubnis zu sprechen Star Paladin. Soweit ich das beurteilen
      kann k\xF6nnte dies das Pony sein dass Riven Diamond und Scarlet Rose get\xF6tet
      hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823920
    m_Localized: Wirklich? Ist das wahr Fremder?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823921
    m_Localized: Was? Nein! Das hatte ich nicht gemeint als ich sagte...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823922
    m_Localized: "Ich habe sie auf der Video Aufzeichnung von Scarlet Roses R\xFCstung
      gesehen. Irrtum ausgeschlossen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823923
    m_Localized: Ich habe nur versucht dort etwas zu erledigen!..
    m_Metadata:
      m_Items: []
  - m_Id: 2737823924
    m_Localized: "Ziehe keine voreiligen Schl\xFCsse. Wir sind nicht deine Feinde,
      falls du das denkst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823925
    m_Localized: "Die Ritter die du get\xF6tet hast waren seit langem ein Problem.
      Au\xDFerdem waren sie aktive Unterst\xFCtzer unseres \xC4ltesten Coldsight.
      Ich kann es zwar nicht guthei\xDFen wenn Mitglieder der Bruderschaft get\xF6tet
      werden, aber es hat sich herausgestellt dass angesichts der momentanen Situation
      deine Taten unserer Division mehr Nutzen als Schaden gebracht haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823926
    m_Localized: "Sieht so aus als h\xE4ttet ihr eine schwierige Beziehung zu euren
      Br\xFCdern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823927
    m_Localized: "In der Tat. \xDCbrigens, wie hei\xDFt du Fremder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823928
    m_Localized: Mein Name ist @lp.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823929
    m_Localized: "Sehr erfreut dich zu treffen. Mein Name ist Stahlhufe, ich bin
      der Star Paladin der St\xE4hlernen Bruderschaft, Neighara Division. Meine Br\xFCder
      die du hier vor dir siehst sind - Green Wire, Groundshire und Great Gage. Es
      hat sich so ergeben dass ich und meine Anh\xE4nger im Widerspruch zu den meisten
      Anderen in der Bruderschaft stehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823930
    m_Localized: "Wir k\xE4mpfen nicht so wie du es vielleicht von gew\xF6hnlichen
      Ponys gew\xF6hnt bist. Und leider f\xFChren ideologische Unterschiede oft zu
      Missverst\xE4ndnissen und Konfrontationen. Im Moment ist jeder Feind von Coldsight
      unser Freund. Vorausgesetzt du stimmst einer Zusammenarbeit mit uns zu."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823931
    m_Localized: Je nachdem, was du unter "Zusammenarbeit" verstehst.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823932
    m_Localized: Beginnen wir damit was du in dieser Stadt zu suchen hast. Ich bin
      nicht zum ersten mal hier, vielleicht kann ich dir bei der Suche helfen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823933
    m_Localized: "Wenn das nicht irgendein Trick ist, w\xE4re das wirklich nett von
      dir. Ich suche das Hauptb\xFCro des Ministeriums f\xFCr Prestige."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823934
    m_Localized: "Kein Problem. Gehe einfach die Stra\xDFe dort entlang und biege
      an der ersten Kreuzung links ab. Nach drei H\xE4userbl\xF6cken bist du an der
      Hauptstra\xDFe. Folge ihr dann gelangst du zur Eingangshalle des Ministeriums."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823935
    m_Localized: "Danke f\xFCr den Hinweis. Ich hoffe dass er hilft."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823936
    m_Localized: "Unsere Gruppe ist vom letzten \xDCberfall auf dem Weg zur\xFCck
      zum Lager. Wenn du an der Fortsetzung einer Zusammenarbeit mit uns interessiert
      bist kannst du uns gerne besuchen. Momentan halten wir uns in der alten Kl\xE4ranlage
      auf. Etwa f\xFCnf Meilen s\xFCdlich der Stadt. Entlang der alten Ponyville
      Eisenbahnstrecke."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823937
    m_Localized: Ich werde mal vorbeischauen, wenn ich Zeit dazu habe.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823938
    m_Localized: Eine Mission von Stahlhufe
    m_Metadata:
      m_Items: []
  - m_Id: 2737823939
    m_Localized: "Warum seid ihr \xFCberhaupt hier?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823940
    m_Localized: "Das ist kein Geheimnis. Wir sind hier im die Geheimnisse zu l\xFCften,
      die nach dem Krieg in der Stadt von der Wolke verborgen geblieben sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823941
    m_Localized: "Bis zum letzten Tag bl\xFChten in Equestria zahlreiche wissenschaftliche
      und technologische Projekte auf. Sie wurden an mehrere Organisationen verteilt.
      Eine dieser Organisationen war die Stable-Tec Corporation.\nDiese Gesellschaft
      hat sich haupts\xE4chlich mit dem Bau der Stable befasst. Gro\xDFe und unglaublich
      gut gesch\xFCtzte unterirdische Einrichtungen, deren Aufgabe es war das Leben
      der Ponys vor den Mega-Zaubern zu retten. Stable-Tec war jedoch auch an wissenschaftlichen
      Aktivit\xE4ten beteiligt, die in der Regel mit dem Leben im Untergrund verbunden
      waren.\nEines dieser Projekte war die Schaffung von industriellen Hydrokulturfarmen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823942
    m_Localized: "Solche Farmen w\xFCrden den Anbau verschiedener Pflanzen erm\xF6glichen,
      ohne nat\xFCrlichen Boden oder Sonnenlicht zu ben\xF6tigen. Diese Entwicklung
      war vielversprechender als die k\xFCnstlichen Obstg\xE4rten, die in den meisten
      Stable als Hauptnahrungsquelle verwendet wurden. Aber die letzten Tests wurden
      nie abgeschlossen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823943
    m_Localized: "\xDCber die Existenz dieses Projekts haben wir aus Computerprotokollen
      anderer Stable-Tec B\xFCros erfahren, aber diese Forschung f\xFChrte man in
      der Canterlot Niederlassung des Unternehmens durch, daher sind detailierte
      Daten und die Koordinaten des Standorts nur hier zu finden. Deshalb haben wir
      angefangen danach zu suchen.\nLeider schlie\xDFen meine Kentnisse \xFCber diese
      Stadt keine Objekte ein die mit der Stable-Tec Corporation in Verbindung stehen.
      Deshalb sind wir gezwungen blind danach zu suchen, bisher ohne Erfolg."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823944
    m_Localized: "Wenn du w\xE4hrend deiner Reise auf die Canterlot Niederlassung
      von Stable-Tec sto\xDFen solltest m\xF6chte ich dich bitten uns mitzuteilen
      wo sie sich befindet. Eine solche Geste w\xE4re ein gro\xDFer Schritt um unsere
      Zusammenarbeit zu f\xF6rdern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823945
    m_Localized: Sicher doch.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823946
    m_Localized: Sieht aus als ob das Terminal noch funktioniert. Mal sehen...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823947
    m_Localized: "*Dateiarchiv \"F\xFCr den Chef\"*\n*Der Zugriff auf das Archiv
      ist beschr\xE4nkt. Bitte geben die ein Unternehmenspasswort der Klasse \"K\"
      ein, um den Inhalt anzuzeigen.*"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823948
    m_Localized: Was soll das? Na egal, ich habe schon viel schwierigere gehackt.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823949
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823950
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823951
    m_Localized: Was?..
    m_Metadata:
      m_Items: []
  - m_Id: 2737823952
    m_Localized: "Was soll das hei\xDFen?, \"Keine \xDCbereinstimmungen im Ger\xE4tespeicher\"?
      K\xF6nnte das Passwort eventuell Teil der Datei selbst sein?\nGrr, was f\xFCr
      ein Unsinn?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823953
    m_Localized: "Na sch\xF6n, ich mache es anders. Ich kopiere die Datei einfach
      und bringe sie so der Bruderschaft. Nichts einfacher als das."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823954
    m_Localized: Hydrokulturfarmen
    m_Metadata:
      m_Items: []
  - m_Id: 2737823955
    m_Localized: "Dein Vorgesetzter bat mich, da bei einer Sache zu helfen. Er ben\xF6tigt
      Daten \xFCber Hydrokulturen, aus der Canterlot Niederlassung von Stable-Tec.
      Ich fand das B\xFCro, konnte jedoch nur eine speziell verschl\xFCsselte Datei
      bekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823956
    m_Localized: Lass mich mal sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823957
    m_Localized: "Das \xFCbliche Passwort-System von Stable-Tec. Ich habe ein Archiv
      aller Codes die jemals vom Unternehmen verwendet wurden. Dauert bestimmt nicht
      lange das richtige zu finden.\nHier, ... das wars schon. Wollen mal sehen was
      du da gefunden hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823958
    m_Localized: Was? So einfach?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823959
    m_Localized: Alles ist einfach wenn man nur das richtige Werkzeug hat. Und jetzt
      Ruhe bitte ich muss mich konzentrieren...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823960
    m_Localized: "Ja, genau danach haben wir gesucht. Alle n\xF6tigen Informationen
      sind in dem Archiv enthalten. Wenn das wirklich die einzige Datei war die du
      aus dem B\xFCro herunterladen konntest haben wir gro\xDFes Gl\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823961
    m_Localized: "Ich m\xF6chte dir offiziell danken, im Namen von uns allen. Ponys
      wie du beweisen dass die Prinzipien unseres Paladin Stahlhufe, auch dem Wohl
      aller Ponys dient."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823962
    m_Localized: Ich bin froh, dass ich helfen konnte.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823963
    m_Localized: "Puh, in Canterlot herumzulaufen ist ganz sch\xF6n hart. Ich muss
      schnell zum Ministerium und dann hier raus!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823964
    m_Localized: "Gehe nach rechts zum [Hauptb\xFCro des Ministeriums f\xFCr Prestige].
      Oder betritt die [Ausgang] T\xFCr um Canterlot weiter zu erkunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823965
    m_Localized: Begegnung mit Mchavi
    m_Metadata:
      m_Items: []
  - m_Id: 2737823966
    m_Localized: Hm... Hallo?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823967
    m_Localized: "Du bist schon da, @lp. Ich hatte dich erst sp\xE4ter erwartet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823968
    m_Localized: "Woher wei\xDFt du wer ich bin?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823969
    m_Localized: 'Jenen die den dunklen Pfad beschreiten wird vieles von dem was
      verborgen ist offenbart @lp. Das blinde Pony sollte sich nicht wundern dass
      der sehende sein Spiegelbild im Spiegel sieht.

      Aber vergib mir meine
      Manieren. Ich habe zu viele Sterne mit diesen hirnlosen Leichen verbracht.
      Da vergisst man schnell wie man mit den lebenden spricht.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823970
    m_Localized: "Mein Name ist Mchavi. Ich bin eine alte Schamanin der Familie,
      die von den \xE4ltesten Zebra Zauberern abstammt. Ich bin hier auf Gehei\xDF
      meines Herrn dem Legaten Caesarius."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823971
    m_Localized: Wen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737823972
    m_Localized: "Deine Freunde aus dem Verdeckten Zeichen h\xE4tten dir wirklich
      mehr erz\xE4hlen k\xF6nnen. Legate Caesarius er ist der Tyrann der Legion,
      der Anf\xFChrer des Zebravolkes. Sein Schicksal ist es zu regieren was von
      dieser Welt noch \xFCbrig ist. Mein schicksal ist es ein Stein, auf dem Weg
      zu sein den er beschreitet, und ihn zu seinem Schicksal hinzuf\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823973
    m_Localized: "Also bist du einer dieser verdammten Verbrecher? Und wie ist es
      so, friedliebend Ponys zu t\xF6ten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823974
    m_Localized: "Sei vorsichtig mit deinen Worten, Kind. Deine Unwissenheit wird
      dir nur Kummer bringen. Die Legion hat nie etwas getan wof\xFCr sie keinen
      Grund hatte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823975
    m_Localized: "Und was war der Grund daf\xFCr, diejenigen zu \xFCberfallen, die
      euch nichts getan haben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823976
    m_Localized: Nicht jedes Wissen kann ohne Vorbereitung erworben werden. Dein
      Verstand ist nicht bereit, um die Wahrheit der Legion zu begreifen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823977
    m_Localized: "Ist es deine \"Wahrheit\" dass du jedes Pony t\xF6ten musst, nur
      weil sie Ponys sind?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823978
    m_Localized: "Das ist was Askari dir bei eurem ersten Treffen erz\xE4hlt hat,
      oder nicht? Sein Verst\xE4ndnis ist kaum besser als das deine.\nDu musst nur
      wissen dass Caesarius f\xFCr jede Kreatur einen Plan hat, und jede Kreatur
      hat ihren Zweck. Und die Regeln dieser grausamen Welt schreiben vor, dass es
      f\xFCr manche von ihnen die ultimative Bestimmung ist zu sterben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823979
    m_Localized: Ich habe diesen epischen Unsinn satt.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823980
    m_Localized: "Es betr\xFCbt mich das zu h\xF6ren. Auch wenn ich wusste dass du
      das sagen w\xFCrdest noch bevor du das erste Wort ausgesprochen hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823981
    m_Localized: "Die Geister der Ahnen fl\xFCstern mir die Wahrheit zu, weisen den
      Weg und enth\xFCllen die Zukunft. Sie sagten voraus dass du hier her kommen
      w\xFCrdest um mir zu helfen. Ich studiere hier die alten Zauberspr\xFCche,
      die von unseren Vorfahren dieser Stadt auferlegt wurden. Sie werden zur Gr\xF6\xDFe
      der Legion beitragen, wenn sich hunderte unserer toten Feinde, auf die noch
      lebenden st\xFCrzen. Mein Herr erwartet Ergebnisse, und dein Herz, ist die
      letzte Zutat die ich noch brauche. Das Herz, eine gesunden Ponys."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823982
    m_Localized: "Dies ist deine Rolle in den Pl\xE4nen des Legaten. Dein Lebenszweck,
      dein Schicksal. Jeder w\xFCrdige Sohn der Legion, strebt danach sein Schicksal
      zu erf\xFCllen. Und du... naja. Ich wei\xDF ja bereits was du tun wirst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823983
    m_Localized: Ich lebe noch... und ich habe das Buch!
    m_Metadata:
      m_Items: []
  - m_Id: 2737823984
    m_Localized: Ich kann es kaum glauben. Lief wohl nicht ganz so wie sie sich das
      vorgestellt hat.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823985
    m_Localized: "Grr... sieht so aus als h\xE4tte es diese Hexe geschafft mein Hirn
      zu verdrehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823986
    m_Localized: Wie auch immer, es ist geschafft. Jetzt bleibt nichts weiter zutun
      als die Sachen nach Hause zu bringen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823987
    m_Localized: "Ob ich \xFCber das Kommunikationsger\xE4t hier den Stable erreichen
      kann?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823988
    m_Localized: "Diese verr\xFCckte Hexe war aus einem bestimmten Grund hier. Ich
      sollte mir dieses Ger\xE4t hier mal genauer ansehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823989
    m_Localized: "Kein Zweifel, dass das hier eine Kommunikationszentrale ist. Sehr
      leistungsstark. Damit kann man mit jedem \xE4hnlichen Ger\xE4t Kontakt aufnehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823990
    m_Localized: 'Ob ich mit dem Mentor Kontakt aufnehmen kann?

      Ich kann es
      ja mal veruchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823991
    m_Localized: "*Scannen des Empfangsbereichs*\n*Antworten erhalten: 4*\n*Sortiere
      Empf\xE4ngerliste*\n*Sortieren vollst\xE4ndig. Standorte der Stable-Tec Kategorie
      gefunden: 0*"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823992
    m_Localized: "Und wie w\xE4re es damit?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823993
    m_Localized: '*Rufe Kontaktliste ab*

      *Verbindungen der letzten Sitzungen:
      4*

      *Letzte Sitzung vor: 72 319 Tagen*'
    m_Metadata:
      m_Items: []
  - m_Id: 2737823994
    m_Localized: Liste letzter Verbindungen anzeigen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737823995
    m_Localized: "* 1 Verbindung wurde hergestellt, vor 72319 Tagen. Kontakt: Manehattan
      B\xFCro des Ministerium f\xFCr Prestige*\n* 2 Verbindung wurde hergestellt,
      vor 17 Tagen. Kontakt: Neighara Milit\xE4rbasis*\n* 3 Verbindung wurde hergestellt,
      vor 12 Tagen. Kontakt: Neighara Milit\xE4rbasis*\n* 4 Verbindung wurde hergestellt,
      vor 3 Tagen. Kontakt: Neighara Milit\xE4rbasis*"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823996
    m_Localized: "Neighara Milit\xE4rbasis? Geh\xF6rt Stahlhufe nicht zuf\xE4llig
      dazu?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823997
    m_Localized: Aufzeichnung von Verbindung 2 abspielen;
    m_Metadata:
      m_Items: []
  - m_Id: 2737823998
    m_Localized: "*FEHLER: Aufzeichnung von Verbindung 2 nicht gefunden. Grund: Datei
      vom Administratur gel\xF6scht, vor: 12 Tagen;"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823999
    m_Localized: Aufzeichnung von Verbindung 3 abspielen;
    m_Metadata:
      m_Items: []
  - m_Id: 2737824000
    m_Localized: "*FEHLER: Aufzeichnung von Verbindung 3 nicht gefunden. Grund: Datei
      vom Administratur gel\xF6scht, vor: 3 Tagen;"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824001
    m_Localized: Aufzeichnung von Verbindung 4 abspielen;
    m_Metadata:
      m_Items: []
  - m_Id: 2737824002
    m_Localized: "\"Ich w\xFCnsche dir einen guten Abend, \xC4ltester\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824003
    m_Localized: "\"Behalte deine Gr\xFC\xDFe f\xFCr dich Hexe, Warum st\xF6rst du
      uns?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824004
    m_Localized: "\"Das wei\xDFt du doch genau. Caesarius wird schon sehr bald mit
      den Vorbereitungen beginnen. Sobald ich triumphierend von meiner Pilgerreise
      aus der verdammten Stadt zur\xFCckgekehrt bin. Ihr solltet langsam mit den
      Vorbereitungen eures Teils beginnen.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824005
    m_Localized: "\"Sag mir nicht was ich meinen Br\xFCdern zu befehlen habe Hexe.
      Es ist mir egal was du dort treibst, wenn du verhandeln m\xF6chtest musst du
      einen Zeitrahmen angeben.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824006
    m_Localized: "\"Die Geister weisen @lp den richtigen Weg. In drei Tagen wird
      sie zu mir kommen und noch am gleichen Tag, werde ich meine Reise zur\xFCck
      zu meinem Herren antreten.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824007
    m_Localized: "\"Was? Was f\xFCr Geister? Was f\xFCr ein @lp? Wovon zum Heuhaufen
      redest du da?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824008
    m_Localized: "\"Du solltest nur wissen, dass die Soldaten der Legion in f\xFCnf
      Tagen zu unserem Treffpunkt marschieren werden. Wenn sie kommen, m\xFCssen
      deine Krieger in Position sein\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824009
    m_Localized: "\"Wenn du alleine w\xE4rst, Hexe, w\xFCrde ich \xFCber dein ganzes
      Durcheinander lachen. Aber dein Verm\xE4chtnis vertraut dir und ich vertraue
      ihm. Deshalb werden meine Soldaten p\xFCnktlich da sein. Entt\xE4usche mich
      nicht.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824010
    m_Localized: "\"Das \"Sun\" Projekt und Stable Pi geh\xF6ren der Bruderschaft,
      \xC4ltester, als Gegenleistung f\xFCr die Verwendung dieser Ressourcen im gemeinsamen
      Kampf. Legat Caesarius setzt auf deine Deskretion.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824011
    m_Localized: Warte, Was?!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824012
    m_Localized: "Die Legion und die St\xE4hlerne Bruderschaft? Gemeinsame Sache?
      Stable Pi?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824013
    m_Localized: "Ich wei\xDF, wer mir Antworten geben wird. Stahlhufe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824014
    m_Localized: "Coldsights Verschw\xF6rung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824015
    m_Localized: Stahlhufe?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824016
    m_Localized: "Ich h\xF6re, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824017
    m_Localized: "H\xF6re dir das mal an..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824018
    m_Localized: "\"Du solltest nur wissen, dass die Soldaten der Legion in f\xFCnf
      Tagen zu unserem Treffpunkt marschieren werden. Wenn sie kommen, m\xFCssen
      deine Krieger in Position sein\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824019
    m_Localized: "\"Wenn du alleine w\xE4rst, Hexe, w\xFCrde ich \xFCber dein ganzes
      Durcheinander lachen. Aber dein Verm\xE4chtnis vertraut dir und ich vertraue
      ihm. Deshalb werden meine Soldaten p\xFCnktlich da sein. Entt\xE4usche mich
      nicht.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824020
    m_Localized: "\"Das \"Sun\" Projekt und Stable Pi geh\xF6ren der Bruderschaft,
      \xC4ltester, als Gegenleistung f\xFCr die Verwendung dieser Ressourcen im gemeinsamen
      Kampf. Legat Caesarius setzt auf deine Deskretion.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824021
    m_Localized: "M\xF6chtest du mir irgendwas sagen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824022
    m_Localized: "Diese Stimme... das ist \xC4ltester Coldsight. Woher hast du diese
      Aufnahme und mit wem spricht der \xC4lteste da?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824023
    m_Localized: "*R\xE4uspern*, Ich bin jetzt dran, Fragen zu stellen.\nDein \xC4ltester
      schmiedet gro\xDFe Pl\xE4ne und arbeitet mit der Zebra Legion zusammen. Meinst
      du nicht, das h\xE4ttest du mir sagen sollen, wenn du willst dass ich mit dir
      \"zusammenarbeite\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824024
    m_Localized: "Ich wei\xDF nicht mehr als du, @lp. Schau her, ich habe dir bereits
      gesagt dass ich mit Coldsight zur Zeit auf Kollisionskurs bin. Ich bin in seine
      Pl\xE4ne nicht involviert weil er mich f\xFCr einen Rivalen h\xE4lt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824025
    m_Localized: Du willst nicht involviert sein?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824026
    m_Localized: "Du warst dort in Canterlot alleine gegen vier von uns. Jetzt bist
      du alleine gegen das ganze Lager. Wenn ich auf Coldsights Seite w\xE4re, h\xE4tten
      wir dich dann am leben gelassen, nachdem wir dich als M\xF6rder von Rose und
      Diamond identifiziert hatten? W\xFCrden wir dich jetzt am Leben lassen wo du
      dir der Pl\xE4ne des \xC4ltesten bewusst geworden bist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824027
    m_Localized: "Also sch\xF6n, du hast mich \xFCberzeugt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824028
    m_Localized: "Jetzt sage mir woher du die Aufnahme hast. Wenn das keine F\xE4lschung
      ist, ist der \xC4lteste Coldsight in ein schweres Verbrechen gegen die Bruderschaft
      verwickelt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824029
    m_Localized: "Im Ministerium traf ich eine Zebra Schamanin die dort die Rosa
      Wolke untersucht hat. Sie kontaktierte deinen \xC4ltesten h\xE4ufiger \xFCber
      das Kommunikationszentrum des Ministeriums. Von da habe ich diese Aufnahme."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824030
    m_Localized: "Dann haben sich meine Bef\xFCrchtungen best\xE4tigt. \xC4ltester
      Coldsight ist ein angesehener F\xFChrer unserer Abteilung. Aber seine Loyalit\xE4t
      gegen\xFCber den Idealen der Bruderschaft ist fraglich. Sogar sein eigenartiges
      Pflichtverst\xE4ndnis sollte den Pl\xE4nen der Zebras widersprechen. Vor allen
      was die Legion angeht.\nEine solche Tat muss schwerwiegende Gr\xFCnde haben.
      Trotz unserer Differenzen kann ich immer noch nicht glauben dass der \xC4lteste
      das ohne einen guten Grund getan haben sollte. Ich werde umgehend eine Suche
      nach ihm arrangieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824031
    m_Localized: Eine Suche?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824032
    m_Localized: "Ja. Ich uns meine Gruppe haben uns bewusst vom Rest der Neighara
      Division distanziert, die Coldsight treu ist. Daher sind unsere Kenntnisse
      \xFCber gegenw\xE4rtige Eins\xE4tze der Kommandozentrale, einschlie\xDFlich
      der \xC4ltesten begrenzt und gr\xF6\xDFtenteils veraltet. Unter seinen Rittern
      und Paladinen gibt es jedoch einige meiner heimlichen Anh\xE4nger. Ich werde
      sie kontaktieren und alles in Erfahrung bringen was wir wissen m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824033
    m_Localized: Wielange wird das dauern?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824034
    m_Localized: "Nicht l\xE4nger als einen Tag. Meine Leute m\xFCssen die Kommunikationsverbindung
      wiederherstellen und wenn wir Gl\xFCck haben, k\xF6nnen wir eine stabile Funkverbindung
      f\xFCr l\xE4nger aufrechterhalten. Nachdem ich den Aufenthaltsort von Coldsight
      bestimmt habe, werde ich zu ihm gehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824035
    m_Localized: Ich gehe mit dir.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824036
    m_Localized: "Was geht dich das an? Das ist eine interne Angelegenheit der St\xE4hlernen
      Bruderschaft. Bis vor kurzem wusstest du noch nichts \xFCber uns."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824037
    m_Localized: Wir haben ein gemeinsames Interesse.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824038
    m_Localized: "Ah, jetzt verstehe ich. Stable Pi ist deine Heimat, ist es nicht
      so? Das erkl\xE4rt den PipBuck an deinem Bein und deine \xFCberm\xE4\xDFige
      Sauberkeit im Vergleich zu den anderen Ponys an der Oberfl\xE4che."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824039
    m_Localized: Ich bin ni...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824040
    m_Localized: "Na sch\xF6n. Also nimmst du mich jetzt mit?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824041
    m_Localized: "Dass du aus dem Stable bist k\xF6nnte hilfreich sein. Laut der
      Aufzeichnung versucht der \xC4lteste Coldsight die Kontrolle \xFCber deinen
      Stable zu erlangen. Und ich bin mir sicher er versucht das nicht nur aus Gier.
      Vielleicht k\xF6nntest du im Namen deines Stable mit ihm verhandeln und einen
      Kompromiss finden, der ein Blutvergie\xDFen oder eine Zusammenarbeit mit den
      Zebras ausschlie\xDFt. Wir haben immer noch die Chance, das Problem auf friedlichen
      Wege zu l\xF6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824042
    m_Localized: "Danke f\xFCr dein Vertrauen, Stahlhufe.\nDa du mein Geheimnis nun
      kennst, m\xF6chte ich dich auch etwas fragen. Was hast du genau f\xFCr Meinungsverschiedenheiten
      mit Coldsight?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824043
    m_Localized: "Coldsight ist eines jener Ponys, deren Seelen durch das Leben im
      \xD6dland von allen Spuren von Emotionen befreit wurden. F\xFCr ihn gibt es
      kein Mitleid, sein oberstes Ziel ist der Wohlstand der St\xE4hlernen Bruderschaft
      und sonst nichts. Dies verst\xF6\xDFt direkt gegen die urspr\xFCnglichen Prinzipien
      der Bruderschaft, die von Applejack aufgestellt wurden um alle Ponys zu sch\xFCtzen.
      Aber sein Standpunkt wird von vielen einflussreichen Kommandeuren unserer Fraktion
      geteilt und sie sind \xE4u\xDFerst hartn\xE4ckig bei der F\xF6rderung dieser
      Politik. Dagegen vorzugehen bedeutet einen B\xFCrgerkrieg in der Bruderschaft
      zu entfachen. Das m\xF6chte ich noch viel weniger als dass Coldsight an die
      Macht kommt, deswegen versuchen meine Unterst\xFCtzer und ich Konflikte zu
      vermeiden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824044
    m_Localized: "Leider ist Coldsight sehr misstrauisch und wei\xDF dass ich in
      der Lage bin seine Untergebenen zu beeinflussen. Deshalb sieht er mich als
      Konkurrenten im Kampf um die Macht. Bisher gelang es uns gr\xF6\xDFere Auseinandersetzungen
      in unserer Beziehung zu vermeiden, ich hoffe dass das auch in Zukunft so bleiben
      wird, trotz des bevorstehenden schwierigen Gespr\xE4ches."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824045
    m_Localized: "Naha, genug gequasselt. Wenn du mit verhandeln m\xF6chtest solltest
      du dir eine bessere Ausr\xFCstung zulegen. Vor allem eine R\xFCstung. Auch
      wenn ich auf ein friedliches Ergebnis hoffe, m\xFCssen wir uns auf das Schlimmste
      vorbereiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824046
    m_Localized: "Alles klar, ich werde mich darum k\xFCmmern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824047
    m_Localized: "Hast du herausgefunden, wo sich Coldsight aufh\xE4lt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824048
    m_Localized: "Ja, aus einer zuverl\xE4ssigen Quelle haben wir erfahren, dass
      er unweit von hier \xFCber einen alten Milit\xE4rst\xFCtzpunkt verf\xFCgt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824049
    m_Localized: "Dann r\xFCcken wir also aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824050
    m_Localized: "Ich kann nicht behaupten, dass du f\xFCr eine m\xF6gliche Konfrontation
      gut genug vorbereitet bist. Wir sollten jedoch keine Zeit verschwenden, wenn
      Coldsight beschlie\xDFt an einen anderen Standort der Neighara-Division zu
      ziehen, ist es m\xF6glicherweise viel schwieriger, ihn zu treffen. Wir r\xFCcken
      aus!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824051
    m_Localized: Konfrontation unter Rittern
    m_Metadata:
      m_Items: []
  - m_Id: 2737824052
    m_Localized: Stehen bleiben!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824053
    m_Localized: Nimm die Waffen runter Riddle, Wir sind es.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824054
    m_Localized: "Star Paladin Stahlhufe! \xC4ltester Coldsight beschuldigt dich
      und deine Leute des Verrats. Wir haben Anweisung euch zu erschie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824055
    m_Localized: "Diese Anschuldigungen sind absurd! Lass mich mit dem \xC4ltesten
      sprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824056
    m_Localized: "Wir verhandeln nicht mit Verr\xE4tern. Er\xF6ffnet das Feuer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824057
    m_Localized: "\xDCber Verrat"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824058
    m_Localized: "Was war das? Warum haben sie dich einen Verr\xE4ter genannt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824059
    m_Localized: "Alea iacta est. Coldsight hat die Grenze \xFCberschritten und einen
      offenen Konflikt ausgel\xF6st. Vielleicht hat er irgendwie vom Mord an seinem
      Komplizen erfahren und vermutet, dass ich irgendwie involviert sein k\xF6nnte.
      Vielleicht auch etwas anderes. Wie auch immer, der Krieg hat begonnen, jetzt
      m\xFCssen wir handeln."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824060
    m_Localized: "Coldsight r\xFCckt vor, das bedeutet, dass viele Br\xFCder, die
      mich unterst\xFCtzen, in gro\xDFer Gefahr sind. Ich muss sofort zu unserer
      Basis zur\xFCckkehren und den n\xE4chsten Schritt planen. Du bist jetzt wieder
      auf dich gestellt. Sch\xFCtze deinen Stable nach belieben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824061
    m_Localized: "Kann ich mich euren Konflikt anschlie\xDFen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824062
    m_Localized: "Obwohl ich auf unsere Zusammenarbeit z\xE4hle, vertraue ich dir
      daf\xFCr immer noch nicht genug, Stablebewohner. Au\xDFerdem haben meine Untergebenen
      keine Kampferfahrung mit leicht gepanzerten Verb\xFCndeten, und wir k\xF6nnten
      dich sogar im Kampf verletzen. Es ist besser f\xFCr jedes Pony, wenn du dich
      nur eine Weile ruhig verh\xE4lst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824063
    m_Localized: Wir werden sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824064
    m_Localized: Begegnung mit Coldsight
    m_Metadata:
      m_Items: []
  - m_Id: 2737824065
    m_Localized: "Verdammte Wilde! Wie kannst du es wagen, in die Basis der St\xE4hlernen
      Bruderschaft einzudringen und meine Soldaten zu t\xF6ten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824066
    m_Localized: "Du hast damit angefangen. Du h\xE4ttest deine Hufe vom Stable Pi
      fernhalten sollen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824067
    m_Localized: Ist das etwa der Grund?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824068
    m_Localized: "Wie viele Ponys hast du heute get\xF6tet? Wie viel Blut wurde vergossen?
      Wir sch\xFCtzen nur unsere Heimat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824069
    m_Localized: "In dem du mein Zuhause zerst\xF6ren willst! Ersparen mir deine
      Tiraden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824070
    m_Localized: "Die Ponys aus dem Stable Pi haben Geheimnisse, die vielen Ponys
      das Leben retten k\xF6nnen! Sie sind gierig, eifers\xFCchtig und unglaublich
      dumm, diese Technologien sollten Ihnen nicht alleine geh\xF6ren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824071
    m_Localized: Ich sehe, dass es sinnlos ist, mit dir zu reden... Mein Zuhause
      wird erst nach deinem Tod sicher sein.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824072
    m_Localized: Informationen von Stahlhufe
    m_Metadata:
      m_Items: []
  - m_Id: 2737824073
    m_Localized: "Hallo, @lp. Sieht so aus, als h\xE4tte ich dich untersch\xE4tzt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824074
    m_Localized: Wieso?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824075
    m_Localized: "Du hast Coldsight erledigt. Meine Anh\xE4nger unter seinen Rittern
      haben mir gerade davon berichtet. Du hast einen sehr gef\xE4hrlichen Schritt
      gemacht.\nBis jetzt warst du bedeutungslos f\xFCr die St\xE4hlerne Bruderschaft,
      doch mit dem Mord an dem \xC4ltesten werden seine Unterst\xFCtzer dich nicht
      vergessen. Von nun an solltest du noch vorsichtiger sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824076
    m_Localized: "Seine Unterst\xFCtzer? Ist der Konflikt mit seinem Tod denn nicht
      vorbei?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824077
    m_Localized: "Im Gegenteil, jetzt wird alles noch viel schlimmer. Das war jedoch
      unvermeidbar. Die einzige Chance das Blutvergie\xDFen zu verhindern, h\xE4tte
      darin bestanden dass ich mein Kommando abgegeben und mich ins Exil begeben
      h\xE4tte. Vielleicht h\xE4tte ich das tun sollen. Zu viele sind bereits bei
      dieser Auseinandersetzung gestorben, und noch mehr werden Zuk\xFCnftig daran
      zugrunde gehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824078
    m_Localized: "Ich denke du solltest etwas wissen. Da du sich als best\xE4ndiger
      und unerbittlicher Gegner von Coldsights Ideen erwiesen hast, glaube ich dass
      ich dir mehr denn je vertrauen kann. Ich glaube die Zeit ist reif dass ich
      dir Informationen zur Verf\xFCgung stellen kann, die dir helfen werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824079
    m_Localized: "Erstens: Die t\xFCkische Absprache zwischen Coldsight und der Legion
      scheint offenbar tief verwurzelt zu sein. Anscheinend wissen fast alle Kommandeure
      der Division, und so gar einige Ritter von dieser Vereinigung und sind bereit
      daran teilzunehmen. Das bedeutet dass die Interaktionen dieser beiden Kr\xE4fte
      vorerst weiter anhalten und sich wahrscheinlich auch bald Zebras dem Konflikt
      anschlie\xDFen werden. Die Gr\xFCnde f\xFCr diese Vereinigung sind uns noch
      immer nicht bekannt, aber meine Untergebenen bem\xFChen sich es bald herauszufinden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824080
    m_Localized: "Zweitens: Coldsight war im Besitz von Pl\xE4nen f\xFCr ein experimentelles
      Kampf-Exoskelett, dass anscheinend in deinem Stable entwickelt wurde. Offenbar
      war dieses Exoskelett der Hauptgrund f\xFCr sein Interesse an dem Stable Pi.
      Es ist eine R\xFCstung und gleichzeitig eine Waffe mit t\xF6dlicher Kampfkraft."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824081
    m_Localized: "Es scheint jedoch nur ein Exemplar davon zu geben. Um es in Gang
      zu setzen werden ein paar einzigartige Artefakte aus der Vorkriegszeit ben\xF6tigt
      die mir nicht bekannt sind. Ich erfuhr erst davon als ich die Dokumente \xFCber
      dieses Exoskelett erhielt. Die Projekte f\xFCr seine Schaffung hie\xDFen \"Sun\"
      und \"Rainbow\". Sehe ich das richtig, dass du an die Oberfl\xE4che geschickt
      wurdest um die notwendigen Artefakte zu beschaffen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824082
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824083
    m_Localized: Ich werde sie dir nicht wegnehmen oder deinen Stable angreifen,
      bei meinem Wort als Paladin. Der Feind meines Feindes ist mein Freund. Du hast
      mir geholfen, ich helfe dir. Wenn dein Stable von einer Invasion der Neighara
      Division der Bruderschaft oder der Zebra-Legion bedroht wird, werden wir euch
      beistehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824084
    m_Localized: "Danke, ich bin froh das zu h\xF6ren. Aber ich hoffe dass sich diese
      Gefahr von meinem Stable abwenden l\xE4sst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824085
    m_Localized: "Ich w\xFCrde mich nicht nur auf Hoffnung verlassen. Unsere Feinde
      sind stark und wir haben viel zutun, wenn wir uns vor ihnen sch\xFCtzen wollen.
      Momentan k\xE4mpfen Truppen der mir treuen Ritter an mehreren Orten gleichzeitig,
      verteidigen wichtige Befestigungen und versuchen die Br\xFCder zu befreien,
      die beim ersten feindlichen Angriff gefangen genommen wurden. Vielleicht wird
      dieser Krieg in naher Zukunft neue Teilnehmer gewinnen. Entweder zu ihren gunsten,
      oder zu unseren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824086
    m_Localized: "Das hei\xDFt, vielen Ponys droht jetzt Gefahr, nicht nur meinem
      Stable. Ich war egoistisch. Ich muss die Bewohner mehrerer Siedlungen vor der
      bevorstehenden Bedrohung warnen. Sie d\xFCrfen nicht von einem Angriff der
      St\xE4hlernen Bruderschaft oder der Legion \xFCberrascht werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824087
    m_Localized: "Ich verstehe dass du dich beeilen musst. Sobald du alles erledigt
      hast komme bitte wieder hier her zur\xFCck. Wir brauchen m\xF6glicherweise
      deine Hilfe."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824088
    m_Localized: Der Bunker
    m_Metadata:
      m_Items: []
  - m_Id: 2737824089
    m_Localized: "Gibt es strategische St\xFCtzpunkte von Coldsights \xC4nh\xE4ngern
      in der N\xE4he?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824090
    m_Localized: "Ja. Der Vorkriegs-Lagerbunker s\xFCd-\xF6stlich von hier. Eines
      von mehreren Hauptlagern unserer Division. Es ist gut gesch\xFCtzt, ich w\xFCrde
      davon abraten, dort gewaltsam eindringen zu wollen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824091
    m_Localized: Das werden wir ja sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824092
    m_Localized: "Diesmal nicht, @lp. Dieser Bunker wurde speziell entworfen um den
      Angriff einer kleinen Armee standhalten zu k\xF6nnen. Im geschlossenen Zustand
      k\xF6nnen die Tore nicht einmal durch die Explosion einer taktischen Sprengwaffe
      zerst\xF6rt werden. Es zu erobern w\xFCrde Monate dauern, bis die Verteidiger
      ausgehungert sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824093
    m_Localized: "Um es einzunehmen, m\xF6glicherweise. Aber was ist mit Infiltration?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824094
    m_Localized: Ich bin nicht dein Vorgesetzter, @lp, aber ich finde nicht dass
      es das Risiko Wert ist. Wir haben momentan dringendere Angelegenheiten.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824095
    m_Localized: "Wenn du dich dennoch dazu entschlie\xDFen solltest dort hin zu
      gehen... ein kleiner Ratschlag: Suche vorher Schreiberin Amaranth auf. Sie
      hat vielleicht etwas dass dir dabei hilft dort hinein zu gelangen. Und jetzt
      entschuldige mich, wir haben viel zutun."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824096
    m_Localized: "Bedrohung f\xFCr das \"T\xE4nzelnde Pony\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824097
    m_Localized: '@lp! Ich freue mich riesig dich wieder zu sehen! Hast du die Canterlot-Angelegenheit
      des Jahres hinter dich gebracht?'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824098
    m_Localized: Ja, ich habe alles was ich brauche. Wie auch immer, wir haben jetzt
      viel zutun.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824099
    m_Localized: '"Wir"?'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824100
    m_Localized: "Ich f\xFCrchte ich habe schlechte Nachrichten, Daiquiri. Schwere
      Zeiten stehen uns bevor.\nDie Neighara Division der St\xE4hlernen Bruderschaft
      und die Zebra Legion haben ein B\xFCndnis geschlossen. Nicht jedem Pony gef\xE4llt
      das, und jetzt stehen im Norden ganze Regionen in den Flammen des B\xFCrgerkrieges.
      Es ist sehr wahrscheinlich dass unsere Siedlung an diesen K\xE4mpfen beteiligt
      sein wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824101
    m_Localized: '"Unsere Siedlung", huh...'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824102
    m_Localized: "Schwere Zeiten, in der Tat. Du w\xFCrdest das wohl nicht sagen
      wenn es nicht ernst w\xE4re, @lp. Wenn das wahr ist sollten wir uns darauf
      vorbereiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824103
    m_Localized: "Ich werde f\xFCr uns neue Patrouillen arrangieren. Der Boss und
      ich selbst werden eine Schicht drauf legen. An uns kommt kein Feind vorbei."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824104
    m_Localized: Und wir brauchen schwere Waffen. Bei diesen Stahlflanken kommt man
      mit normalen Gewehren nicht weit. Auf sowas sind wir nicht vorbereitet...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824105
    m_Localized: Kann ich irgendwie helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824106
    m_Localized: Wir sind es gewohnt, uns zu verteidigen. Wir schaffen es schon irgendwie.
      Aber wenn du bereit bist uns zu helfen, sind deine Waffen immer wilkommen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824107
    m_Localized: "Wo wir gerade dabei sind, Stalwart k\xF6nnte uns auch helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824108
    m_Localized: "Calamity hat Recht. Normalerweise sprechen wir nicht dar\xFCber,
      aber du hast das Recht es zu erfahren.  Oak ist ein ehemaliges Mitglied der
      St\xE4hlernen Bruderschaft. Ich wei\xDF nicht warum er ausgestiegen ist, das
      hat er uns nie erz\xE4hlt. Aber sein Wissen k\xF6nnte uns jetzt sehr helfen.
      Und wenn er Hilfe braucht, sollten wir tun was wir k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824109
    m_Localized: Ich werde mit ihm reden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824110
    m_Localized: Hey, @lp. Du siehst besorgt aus. Stimmt was nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824111
    m_Localized: "Hallo. Daiquiri sagte du w\xE4rst ein ehemaliges Mitglied der St\xE4hlernen
      Bruderschaft."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824112
    m_Localized: "Hmm... Ja, das ist wahr.\nDer Boss h\xE4tte es dir wohl nicht ohne
      Grund gesagt. Nun spucks schon aus, was ist los?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824113
    m_Localized: "Die Neighara Division der St\xE4hlernen Bruderschaft bek\xE4mpft
      sich selbst. Und einer der beiden Seiten stehen Zebras der Legion bei. Wir
      werden hier m\xF6glicherweise von einem Angriff bedroht sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824114
    m_Localized: "Oh, Das... das war jetzt ein Schlag aus heiterem Himmel, sowas
      h\xE4tte ich nicht erwartet. Wie konnte das passieren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824115
    m_Localized: "Lange Geschichte. Die Kurzfassung: Ihr \xC4ltester hat seine Nase
      in Dinge gesteckt die ihn nichts angingen und sich so Feinde gemacht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824116
    m_Localized: Coldsight?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824117
    m_Localized: Ja, genau der. Kennst du ihn?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824118
    m_Localized: Das tat ich mal. Aber genug von meiner Vergangenheit, wie kann ich
      dir jetzt helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824119
    m_Localized: "Die bessere Frage w\xE4re wohl: Wie kann ich DIR helfen? Du bist
      ein Experte in Sachen St\xE4hlerne Bruderschaft, und wei\xDFt am besten wie
      wir uns vor ihnen sch\xFCtzen k\xF6nnen. Wenn du meine Hilfe brauchst, bin
      ich bereit zu besorgen was n\xF6tig ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824120
    m_Localized: "Ich kann mir nat\xFCrlich nicht gleich einen vollst\xE4ndigen Plan
      aus dem Hut zaubern. Aber ich mache mir Gedanken zu dem Thema ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824121
    m_Localized: "Bedrohung f\xFCr das \"Verdeckte Zeichen\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824122
    m_Localized: Nett dich wieder zu Treffen, @lp. Gibts was neues?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824123
    m_Localized: "Ungl\xFCcklicherweise ja.\nVor kurzem bin ich mit ein paar Dingen
      konfrontiert gewesen, denen ich lieber aus dem Weg gegangen w\xE4re. Ich habe
      eine Menge beunruhigender Sachen erfahren die ich mit dir Teilen muss."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824124
    m_Localized: Ist in Canterlot irgendwas passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824125
    m_Localized: "Nicht nur das. Es geht um viel mehr als nur die alten Ruinen.\nIch
      habe zuf\xE4llig erfahren dass die Neighara-Division der St\xE4hlernen Bruderschaft
      ein milit\xE4risches B\xFCndnis mit dem Anf\xFChrer der Legion eingegangen
      ist. Warum wei\xDF ich nicht aber die Folge war ein bewaffneter Konflikt unter
      den Angeh\xF6rigen der Bruderschaft. Im Moment weitet sich der Konflikt weiter
      aus. Und da sich viele Objekte von Interesse in der n\xE4he von \"Verdecktes
      Zeichen\" befinden bef\xFCrchte ich dass ihr hier in Gefahr sein werdet. Wenn
      nicht wegen der Bruderschaft, dann wegen den Soldaten der Legion."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824126
    m_Localized: Beunruhigende Neuigkeiten, sehr beunruhigend.. bist du dir damit
      sicher, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824127
    m_Localized: Absolut.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824128
    m_Localized: "Dann sind wir gezwungen unsere Bem\xFChungen auf Aufl\xE4ren und
      Patrouillen zu konzentrieren. Wir haben schon nur wenige Zebras die Vorr\xE4te
      sammeln und die neue Bedrohung entzieht uns auch diese. Ich werde einen Siedlungsrat
      einberufen damit wir entscheiden k\xF6nnen was wir tun werden um uns zu sch\xFCtzen.
      Vielleicht sind wir in naher Zukunft auf deine Hilfe angewiesen @lp. Wenn du
      uns helfen m\xF6chtest k\xF6nnen wir dir nichts daf\xFCr geben, aber jeder
      Huf z\xE4hlt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824129
    m_Localized: Ich werde euch helfen, so gut ich kann.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824130
    m_Localized: "Der Rat wird Entscheidungen treffen, die f\xFCr uns \xE4u\xDFerst
      wichtig sind. Wir k\xF6nnen \xFCber das Schicksal der Gemeinde nicht ohne unsere
      Pfadfinder entscheiden, und sie sind noch nicht von den Versorgungstouren zur\xFCckgekehrt.
      Ich werde dich informieren, wenn sie kommen, und wir werden unsere weiteren
      Ma\xDFnahmen planen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824131
    m_Localized: Pass auf deine Sachen auf
    m_Metadata:
      m_Items: []
  - m_Id: 2737824132
    m_Localized: Es kommen harte Zeiten.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824133
    m_Localized: "Unterst\xFCtze das \"T\xE4nzelnde Pony\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824134
    m_Localized: "Alles klar, um uns gegen einen so starken Feind wie St\xE4hlerne
      Bruderschaft zu verteidigen...\nBrauchen wir auf jeden Fall gro\xDFe Waffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824135
    m_Localized: "Ich habe da einige zuverl\xE4ssige Quellen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824136
    m_Localized: "Nein, @lp. GRO\xDFE Waffen.\nWenn wir uns nur mit Anti-Mach-Gewehren
      ausstatten, k\xF6nnen wir m\xF6glicherweise einen ausgeglichenen Kampf gegen
      Power-R\xFCstungen f\xFChren. Aber glaube mir: Coldsights Ritter haben keine
      Angst davor, unter gleichen Bedingungen zu k\xE4mpfen. Wenn sie sich entschlie\xDFen,
      uns zu vernichten, werden sie nicht aufh\xF6ren und selbst wenn wir gewinnen,
      w\xFCrden wir f\xFCr einen hohen Preis daf\xFCr zahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824137
    m_Localized: "Wenn wir die St\xE4hlerne Bruderschaft nicht dazu bringen k\xF6nnen,
      uns zu f\xFCrchten, m\xFCssen wir zumindest den Angriff auf das Lager aufschieben.
      Und dies kann nur erreicht werden, wenn die Kosten f\xFCr einen Angriff auf
      das \"T\xE4nzelnde Pony\" himmelhoch sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824138
    m_Localized: "Um ehrlich zu sein, bin ich mir nicht sicher, ob wir das schaffen
      k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824139
    m_Localized: "Zum Gl\xFCck bin ich mir sicher. H\xF6r mal zu.\nAls ich bei der
      Bruderschaft war, hatten wir Zugang zum Archiv, das eine detaillierte Karte
      einer Fabrik enthielt. Dort haben wir von den Fertigungshallen f\xFCr die Herstellung
      von Schiffskanonen und Munition erfahren, die in einem der unterirdischen Stockwerke
      gebaut wurden. Gesch\xFCtze f\xFCr Zerst\xF6rer, um genau zu sein. Waffen f\xFCr
      Schiffe, gro\xDF genug f\xFCr uns."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824140
    m_Localized: "Wir von der Bruderschaft, h\xE4tten uns schon lange mit ihnen befassen
      sollen, aber im \xD6dland gab es wenig Verwendung f\xFCr sowas, und wir hatten
      immer wichtigere Dinge zu erledigen. Jetzt spielt sie das Schicksal in unsere
      Hufe, die Hufe des \"T\xE4nzelnden Ponys\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824141
    m_Localized: Und ich muss diese Produktionshallen erkunden?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824142
    m_Localized: "Wenn du bereit bist uns zu helfen, ja. Ich werde dir die genaue
      Position der Hallen zeigen und du wirst nach dort unten gehen und herausfinden,
      ob in den Lagern noch ein paar dieser Waffensysteme vorhanden sind. Und stelle
      sicher, dass unsere Leute nicht ins Feuer der Sicherheitst\xFCrme geraten,
      wenn sie kommen. Ich wei\xDF, dass du gut darin bist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824143
    m_Localized: "Das \"T\xE4nzelnde Pony\" ist sicher"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824144
    m_Localized: "Es ist alles gut, Oak. Die Lager sind immer noch voll, es gibt
      viele Granaten, und weder Roboter noch T\xFCrme k\xF6nnen den Pony-Pl\xFCnderern
      dort noch etwas anhaben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824145
    m_Localized: "Sehr gut. Tats\xE4chlich w\xFCrde schon eine einzige Waffe dieser
      Art ausreichen, damit Coldsights Soldaten es sich \xFCberlegen, bevor sie uns
      angreifen, aber es schadet nie, ein paar mehr davon zu haben.\nWir k\xF6nnen
      sie ja nicht auf R\xE4der setzen und als Angriffswaffen einsetzen, aber eine
      statische Verteidigung wird mehr als genug sein. Jetzt haben wir viel zu tun
      und ich hoffe, dass es noch nicht zu sp\xE4t ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824146
    m_Localized: "Ich hoffe, dass wenn etwas schief l\xE4uft, Stahlhufes Ritter und
      ich in der N\xE4he sind, um zur Hilfe zu kommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824147
    m_Localized: "Stahlhufe? Wenn er sich Coldsight widersetzt, solltest du dir da
      keine Sorgen machen. Dieser alte Fuchs hat seine Ohren \xFCberall. Coldsight
      h\xE4tte ihn nicht \xFCberrumpeln sollen: Bei allem Respekt, aber er h\xE4tte
      es nie geschafft, einen Kommandanten mit fast zweihundert Jahren Erfahrung
      zu schlagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824148
    m_Localized: Mit wieviel Jahren Erfahrung?!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824149
    m_Localized: "Hast du das nicht gewusst? Stahlhufe ist ein Canterlot Ghul. Er
      hat im gro\xDFen Krieg gek\xE4mpft. Du h\xE4ttest mir fr\xFCher sagen sollen,
      dass er unser Verb\xFCndeter ist. Er hat ein hohes Ansehen unter den Rittern.
      Und im Gegensatz zu Coldsight behandelt er die \xD6dlands-Ponys ausreichend
      Freundlich. Wenn sich das \"Tanzende Pony\" tats\xE4chlich im Krieg befindet,
      sollten wir unser Bestes geben, um seine Unterst\xFCtzung zu erlangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824150
    m_Localized: 'Das habe ich echt nicht erwartet. Aber du hast Recht: Wenn Coldsights
      Soldaten friedliche Siedlungen angreifen wird er einschreiten.

      Um genau
      zu sein, braucht definitiv mindestens eine weitere Siedlung Hilfe. Wenn ich
      hier nicht noch gebraucht werde, mache ich mich auf den Weg dorthin.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824151
    m_Localized: "Du hast keine Zeit zu verlieren, was? Nat\xFCrlich, geh nur. Wir
      schaffen das hier schon.\nWenn du Stahlhufe triffst sag ihm mal hallo von mir.
      Und danke, daf\xFCr dass du uns von ihm erz\xE4hlt hast. Das sind m\xF6glicherweise
      die besten Neuigkeiten, die wir seit langen geh\xF6rt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824152
    m_Localized: "Guten Tag, @lp. Du kommst gerade rechtzeitig. Alle Mitglieder unseres
      Rates sind von der Expeditionen zur\xFCck. Heute Abend werden wir uns treffen,
      um unsere n\xE4chsten Schritte zu besprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824153
    m_Localized: Gut. Es gibt viel zu bereden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824154
    m_Localized: '"Verdecktes-Zeichen" Rat'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824155
    m_Localized: "Wir alle wissen warum wir hier sind. Lasst uns keine Zeit verlieren.
      @lp, sage uns bitte ausf\xFChrlich, welche Art von Unheil uns bedroht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824156
    m_Localized: "Ich habe dem, was ich vorher schon gesagt habe, nicht viel hinzuzuf\xFCgen.
      Die Legion und die Neighara Division bildeten eine milit\xE4rische Allianz.
      Warum und gegen was wei\xDF ich nicht. Sie planen jedoch anzugreifen... mein
      Zuhause. Und diese Allianz f\xFChrte zu einer Spaltung in den Reihen der St\xE4hlernen
      Bruderschaft. Ein bewaffneter Konflikt breitet sich gerade aus und es ist unwahrscheinlich,
      dass dieser vor der vollst\xE4ndigen Zerst\xF6rung einer der beiden Seiten
      enden wird. Das bedeutet, dass die Ritter, die eine Allianz mit der Legion
      eingegangen sind, h\xF6chstwahrscheinlich Unterst\xFCtzung von ihren neuen
      Freunden anfordern werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824157
    m_Localized: Was geht uns das an?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824158
    m_Localized: "Soweit ich das beurteilen kann, ist die St\xE4hlerne Bruderschaft
      an Stellungskriege gew\xF6hnt. Sie werden sich wichtige St\xFCtzpunkte, Lagerh\xE4user
      sowie die Gebiete drum herum erk\xE4mpfen. Eine der Basen befindet sich hier
      ganz in der N\xE4he."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824159
    m_Localized: "Und das bedeutet das Risiko einer zuf\xE4lligen Begegnung mit unseren
      Truppen oder sogar der Siedlung selbst. W\xE4hrend wir das Problem mit der
      Bruderschaft friedlich l\xF6sen k\xF6nnten, w\xFCrde die Legion ohne einen
      Gedanken zu verschwenden alle Kr\xE4fte mobilisieren um uns zu vernichten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824160
    m_Localized: "Die K\xE4mpfe werden vermutlich nicht lange andauern. Wenn wir
      genug Vorr\xE4te sammeln und ein paar Monate nach Norden gehen, k\xF6nnten
      wir diesen Sturm abwarten und dann zur\xFCckkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824161
    m_Localized: "Warte, es ist noch zu fr\xFCh um das zu beurteilen. @lp, woher
      wei\xDFt du das alles?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824162
    m_Localized: "Also...\nErstens kenne ich den Anf\xFChrer einer der Seiten dieses
      Konflikts. Derjenige, der gegen die Freundschaft mit der Legion ist. Und zweitens
      ... in Canterlot traf ich zuf\xE4llig eine Zauberin der Legion. Sie hie\xDF
      Mchavi."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824163
    m_Localized: Das ist sehr schlecht...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824164
    m_Localized: "Wenn die Legion Totenbeschw\xF6rer in diese Region entsandt hat,
      sind wir bereits gef\xE4hrdet. Viele von ihnen besitzen die Gabe des Sehens.
      Unsere Entdeckung ist jetzt nur noch eine Frage der Zeit."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824165
    m_Localized: "...und selbst wenn wir jetzt nach Norden gehen, k\xF6nnten wir
      nicht mehr zur\xFCck, sollte die Legion gewinnen. Wenn Totenbeschw\xF6rer hier
      sind, bedeutet das, dass Caesar vor hat, sich hier endg\xFCltig niederzulassen.\nWir
      m\xFCssen angreifen! Jetzt, bevor sie uns finden! Wir haben K\xE4mpfer, die
      \xDCberraschung ist auf unserer Seite. Ich habe es satt, mich zu verstecken!
      Nutze den Moment und schlage den Feind, lasst sie uns erledigen! Genug mit
      Weglaufen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824166
    m_Localized: ... dumm.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824167
    m_Localized: "Das ist Selbstmord, Mwimbaji. Ein \xDCberraschungsangriff funktioniert
      nur einmal. Sobald die Legion von uns wei\xDF, w\xE4ren wir zum Scheitern verurteilt.
      Wir w\xFCrden fr\xFCher oder sp\xE4ter gejagt und geschlachtet werden. Wir
      kennen nicht einmal das genaue Kr\xE4fteverh\xE4ltnis in diesem Konflikt. Bisher
      klang der Vorschlag von Mshauri am sinnvollsten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824168
    m_Localized: Was wenn ich euch helfe? Auch wenn die Legion herausfindet, wer
      sie angegriffen hat, ich bin nur ein Pony, meine Taten werden eure Anwesenheit
      nicht preisgeben.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824169
    m_Localized: "Es w\xE4re schwierig das mit einem Huf zu machen. Du m\xFCsstest
      genau wissen, wo du die treffen kannst. Und auch dann sind die Chancen nicht
      besonders gut."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824170
    m_Localized: "Trotzdem w\xFCrde es uns helfen. Aber wenn dieses Pony versagt,
      ist es unwahrscheinlich, dass die Legion sie am Leben l\xE4sst, das ist nicht
      ihr Stil.\nWir k\xF6nnen uns aber nicht nur darauf verlassen erfolgreich zu
      sein. In jedem Fall m\xFCssen wir mit den Vorbereitungen f\xFCr unsere Abreise
      beginnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824171
    m_Localized: '"Nicht ihr Stil"?'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824172
    m_Localized: "Trotz all ihrer M\xE4ngel erlaubt die Legion es nicht, diejenigen
      zu foltern, die mutig genug sind, sich ihr entgegen zu stellen. Das ist eine
      sehr alte Tradition, eine Art Respekt: Ein tapferer Feind sollte auf dem Schlachtfeld
      sterben, nicht in Ketten. Sogar ein Pony. Eine edle Tradition ... und so irrational."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824173
    m_Localized: Da bleibt nur eins - tapfer zu sterben.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824174
    m_Localized: "...\n\tIch w\xFCrde lieber gar nicht sterben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824175
    m_Localized: "Wir k\xF6nnten dir auch nicht sagen, wo du die Agenten der Legion
      findest. Und wir werden sie auch nicht suchen gehen. Das Risiko ist einfach
      zu hoch.\nDie Vorbereitungen f\xFCr den Umzug in den Norden werden viel Zeit
      in Anspruch nehmen. Wenn es dir irgendwie gelingt und du uns Zeit verschaffen
      kannst, w\xFCrden wir uns freuen. Aber wir k\xF6nnen nicht warten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824176
    m_Localized: "Ich glaube, ich wei\xDF schon wer mir helfen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824177
    m_Localized: "Dann soll es so sein. @lp, Wir sind dir alle sehr dankbar f\xFCr
      deine Entschlossenheit und deine Hilfe. Wir w\xFCrden es verstehen, wenn du
      deine Meinung \xE4nderst und dich daran erinnern, dass es besser ist, Ihr Leben
      zu retten, als dein Ziel zu erreichen und zu sterben, weil dein Tod ein gr\xF6\xDFerer
      Verlust w\xE4re."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824178
    m_Localized: "Unterst\xFCtze \"Verdecktes Zeichen\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824179
    m_Localized: Hallo Stahlhufe. Ich habe einen Vorschlag, der uns wahrscheinlich
      beiden helfen wird.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824180
    m_Localized: "Ich h\xF6re, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824181
    m_Localized: "Wissen eure Kundschafter etwas \xFCber Legionsbewegungen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824182
    m_Localized: "Genau so viel wie die Anh\xE4nger von Coldsight. Meine Informanten
      berichten mir eine Menge, aber es w\xE4re unvern\xFCnftig Patrouillen zu entsenden
      um die Gestreiften zu \xFCberwachen.\nIm Moment hat sich die Legion darauf
      konzentriert, meinen ehemaligen Br\xFCdern zu helfen. Sie sind stark genug
      f\xFCr einen offenen Kampf, ziehen es jedoch vor, die Aktionen meiner Streitkr\xE4fte
      mit Hinterhalten und Sabotage zu behindern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824183
    m_Localized: Gibt es irgendwelche Schwachstellen in ihrer Strategie?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824184
    m_Localized: "Schwer zu sagen. M\xF6glicherweise k\xF6nnte die Zerst\xF6rung
      ihres Hauptquartiers in dieser Region f\xFCr Verwirrung bei ihren Operationen
      f\xFChren und sie zwingen, ihre Aktivit\xE4ten vor\xFCbergehend einzuschr\xE4nken.
      Zebras beobachten jedoch jeden Schritt meiner Truppen genau und das entsenden
      eines Angriffsteams k\xF6nnte scheitern. Sie w\xFCrden einfach umziehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824185
    m_Localized: "Du fragst doch nicht nur aus purem Interesse, oder? Wenn du vor
      hast, die Zebra Kommandantur aufzusuchen, kann ich dir ihren aktuellen Standort
      geben. Die Zerst\xF6rung des Lagers der Legionsf\xFChrung bietet Raum f\xFCr
      unsere Offensive, und deine F\xE4higkeiten f\xFCr unabh\xE4ngige Operationen
      bieten ernsthafte Erfolgschancen. Schlau."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824186
    m_Localized: "Vielen Dank! Sicher, werde ich den Kommandeuren der Legion einen
      Besuch abstatten. \xDCbrigens, ein Pony l\xE4sst dich gr\xFC\xDFen. Oak Stalwort."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824187
    m_Localized: Oak? Ich erinnere mich an ihn. Netter Kerl. Aber viel zu neugierig.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824188
    m_Localized: '"Verdecktes Zeichen" ist sicher'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824189
    m_Localized: "Gute Neuigkeiten, Askari. Ich habe das regionale Hauptquartier
      der Legion gefunden, ihre Kommandanten get\xF6tet und alle Dokumente, die ich
      finden konnte von dort mitgenommen. Leider beherrsche die Zebrasprache nicht.
      Kannst du mal einen Blick darauf werfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824190
    m_Localized: Sicher.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824191
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824192
    m_Localized: "Das sind Auftr\xE4ge und Berichte. Viele davon. Aber keine einzige
      Erw\xE4hnung von uns oder anderen Ausgesto\xDFenen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824193
    m_Localized: "Das sind sehr gute Neuigkeiten f\xFCr uns, @lp. Ich wei\xDF, wie
      Legion arbeitet. Die Zerst\xF6rung von Kommandos ist f\xFCr sie ein echtes
      Problem, und sie werden sich nicht so schnell davon erholen. Und wenn die Zebras
      der Legion uns auf die eine oder andere Weise entdeckt h\xE4tten, w\xE4re es
      hier erw\xE4hnt worden.\nJetzt haben wir Gewissheit dass wir vorerst in Sicherheit
      sind. Zumindest k\xF6nnen wir nun mehr Zeit auf das Sammeln von Vorr\xE4ten
      und den anderen Vorbereitungen verwenden. Und vielleicht m\xFCssen wir gar
      nicht von hier weg. Deine Hilfe ist f\xFCr uns von unsch\xE4tzbaren Wert!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824194
    m_Localized: "Ich habe auch Neuigkeiten f\xFCr dich. W\xE4hrend deiner Abwesenheit
      hat ein Sprite-Bot deine Freundin besucht. Es klingt seltsam, ich wei\xDF,
      aber er ist hier einfach reingeflogen und hat nach ihr gefragt. Er sagte, er
      m\xFCsse auch mit dir reden. Jetzt ist der Bot bei Velvet in dem Geb\xE4ude
      dort dr\xFCben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824195
    m_Localized: Das Treffen mit dem Beobachter
    m_Metadata:
      m_Items: []
  - m_Id: 2737824196
    m_Localized: Hallo @lp. Gut, dass du gerade noch rechtzeitig aufgetaucht bist.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824197
    m_Localized: Oh... Hallo? Ich glaube nicht, dass wir uns kennen, vielleicht solltest
      du dich besser erst vorstellen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824198
    m_Localized: "Ja, nat\xFCrlich, vergib meine Manieren. Mein richtiger Name wird
      dir nichts sagen, also nenne mich einfach Beobachter.\nWenn du dich erinnerst,
      hat dich der Mentor nach deinem Erfolg bei Stable 88 gebeten, den Kognigator
      zu den Hankey-Garagen zu bringen. Ich war derjenige, den du treffen solltest,
      doch leider wurden wir gest\xF6rt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824199
    m_Localized: Wie hast du mich gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824200
    m_Localized: "Euch... Zum Gl\xFCck habe ich euch gefunden. Dich und Chosen-24.
      Einfach war das nicht. Velvet und ich haben uns schon viel unterhalten, jetzt
      m\xFCssen wir mit dir reden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824201
    m_Localized: Warte mal einen Augenblick. Velvet, kann man ihm vertrauen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824202
    m_Localized: "Ja, ich denke schon. Er hat mir genug erz\xE4hlt um ihn zu glauben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824203
    m_Localized: "Sch\xF6n. Ich habe nicht nur den Kogitator gefunden, sondern auch
      das Alihorn Amulett! Und das Schwarze Buch ebenfalls. Hat der Mentor dir gesagt,
      dass diese Dinge f\xFCr die Projekte auch wichtig sind? Ich vermute, ich sollte
      sie dir so schnell wie m\xF6glich \xFCbergeben, weil..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824204
    m_Localized: "... die Neighara Division sich mit der Legion zusammengetan hat
      und einen Angriff auf Stable Pi plant. Wir sind uns dessen bewusst, @lp.\nNein,
      die Artefakte m\xFCssen bei dir bleiben. Ich bef\xFCrchte, du wirst sie mehr
      brauchen. Ich werde dir erkl\xE4ren wieso. Aber lass mich dir zuerst etwas
      \xFCber dich erz\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824205
    m_Localized: "Der Mentor hat dir bereits mitgeteilt, dass du beauftragt wurdest,
      die fehlenden Komponenten zu sammeln, um die Projekte \"Sun\" und \"Rainbow\"
      abzuschlie\xDFen. Dar\xFCber hinaus hast du freiwillig zugestimmt, dein Ged\xE4chtnis
      vor\xFCbergehend zu l\xF6schen, um die Sicherheit deines Zuhauses zu gew\xE4hrleisten.
      Dieses Vorgehen hat einen erheblichen Nachteil: Dinge in deinem Ged\xE4chtnis
      werden als ganze Objekte blockiert, jedoch nicht bis ins Detail. Das hei\xDFt,
      wenn du einen Teil deiner Erinnerungen wiederherstellst, wirst du dich einm\xE4hlig
      an alles erinnern, was direkt mit dem wiederhergestellten Teil im Zusammenhang
      steht. Pass auf: Der Mentor hat eine silbergraue M\xE4hne..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824206
    m_Localized: "...und ein hellpurpurnes Fell. Er hat einen Hockeyschl\xE4ger-Sch\xF6nheitsfleck,
      tr\xE4gt eine Brille und liebt seine Arbeit sehr! Das und Apfelmarmelade.\nBei
      der G\xF6ttin, ich erinnere mich wirklich an ihn!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824207
    m_Localized: Siehst du? Wie auch immer. Wichtig ist jetzt, dass du dich an die
      Details der Projekte erinnerst, an denen er arbeitet.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824208
    m_Localized: "Er hat Recht, @lp. Jetzt tragen wir die Verantwortung daf\xFCr
      unser Zuhause zu sch\xFCtzen. Und egal wie schwer es f\xFCr mich ist das zuzugeben,
      aber die Waffen, die der Mentor zu vervollst\xE4ndigen versucht, sind f\xFCr
      den Fall, dass etwas schief geht, unsere einzige Chance."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824209
    m_Localized: "Die Projekte \"Sun\" und \"Rainbow\" h\xE4ngen unmittelbar miteinander
      zusammen. \"Rainbow\" ist ein starkes Exoskelett, das mit einer fast undurchdringlichen
      R\xFCstungen und Fl\xFCgeln ausgestattet ist, die ein Erdpony oder ein Einhorn
      in die Luft heben k\xF6nnen. Und das \"Sun\" Projekt ist ein \xE4u\xDFerst
      komplexes, auf Regenb\xF6gen basierendes System, dessen Zweck darin besteht,
      die \xDCberlebensf\xE4higkeit und die magischen Fertigkeiten des Tr\xE4gers
      k\xFCnstlich zu verbessern. Zusammen verleihen sie die zweitgr\xF6\xDFte macht,
      nach der von Celestia und Luna. Aber nur was Zerst\xF6rungsm\xF6glichkeiten
      angeht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824210
    m_Localized: "Ja, Ich erinnere mich daran. Diese Systeme sind unglaublich komplex,
      ein wahres Wunder der Technik. Wie seine Vorg\xE4nger vor ihm glaubt auch der
      Mentor, dass nur sie die Sicherheit von Stable Pi gew\xE4hrleisten k\xF6nnen,
      wenn die Zeit gekommen ist sich der Oberfl\xE4che zu \xF6ffnen. Und sie...
      wir alle wollten endlich unsere Isolation beenden. Aber wir hatten Angst, dies
      ohne Schutz zu tun."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824211
    m_Localized: "W\xE4hrend wir in unserem Hochtechnologie-Bunker sa\xDFen, litten
      und starben Oberfl\xE4chenponys, Generation f\xFCr Generation, bis wir eine
      Waffe gebaut h\xE4tten, die gro\xDF genug w\xE4re, um sie alle zu erschie\xDFen,
      falls etwas schief laufen w\xFCrde. Also war es nicht falsch mal \"Hallo\"
      zu sagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824212
    m_Localized: "Velvet, die Oberfl\xE4che ist voller Ponys, bei denen in einem
      Gespr\xE4ch nur das Kaliber ihrer Waffen z\xE4hlt. Und nur das wird das Leben
      auf der Oberfl\xE4che besser und sicherer machen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824213
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824214
    m_Localized: "Zum Guten oder zum Schlechten, die Dinge haben sich eben so entwickelt.
      Zweihundert Jahre lang war Stable Pi vom \xD6dland isoliert, und die darin
      lebenden Ponys retteten einen Gro\xDFteil der technologischen Vergangenheit
      von Equestria. @lp, hast du dich jemals gefragt, warum du auf den vollen Funktionsumfang
      der M.A.S. Terminals zur\xFCckgreifen kannst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824215
    m_Localized: Weil sie meine PipBuck-Signatur erkennen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824216
    m_Localized: "Korrekt. Nur PipBucks von Stable-Bewohnern besitzen noch die Software,
      welche f\xFCr die Erkennung durch die Terminals erforderlich ist, sowie einige
      andere M.A.S. Ausr\xFCstungsgegenst\xE4nde. Aber der Speicher in diesen die
      von den seltenen gl\xFCcklichen Oberfl\xE4chenponys gefunden wurden, ist schon
      mehrmals wieder gel\xF6scht worden. Aber das ist nichts im Vergleich zu den
      vielen Projekten, an denen euer Stable gearbeitet hat, bevor der j\xFCngste
      Tag kam. Einschlie\xDFlich der Projekte \"Sun\" und \"Rainbow\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824217
    m_Localized: "Es waren erst diese beiden Projekte, die Coldsight auf uns aufmerksam
      gemacht haben. Aber f\xFCrs Erste gibt es noch immer die M\xF6glichkeit, alles
      mehr oder weniger friedlich zu l\xF6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824218
    m_Localized: "Unser Stable wird von einer Invasion bedroht. Wie k\xF6nnen wir
      das \"friedlich\" l\xF6sen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824219
    m_Localized: Es gibt einen Weg. Aber keine Garantie.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824220
    m_Localized: "Ich werde nicht umsonst Beobachter genannt, @lp. Durch ein Netzwerk
      aus Sprite-Bots erfahre ich eine Menge \xFCber das, was im \xD6dland vorgeht.
      Und der Mentor erf\xE4hrt das von mir."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824221
    m_Localized: "Ich wei\xDF, warum Coldsight beschlossen hat, Stable Pi anzugreifen,
      und warum er eine Allianz mit der Legion eingegangen ist. Im \xD6dland ist
      eine neue Bedrohung aufgetaucht, die sogar unvers\xF6hnliche Feinde dazu bewegen
      kann, sich gegen sie zusammenzuschlie\xDFen. Die Enklave.\nAls der j\xFCngste
      Tag kam, verlie\xDFen die Pegasi von Equestria ihr sterbendes Land und versiegelten
      den Himmel. Seitdem hat es im \xD6dland keinen einzigen sonnigen Tag mehr gegeben.
      Die Pegasi selbst leben seit zweihundert Jahren \xFCber der Wolkengrenze. Ich
      wei\xDF nicht, was dort vor sich geht, aber in letzter Zeit kamen zumindest
      einige zu dem Schluss, dass ihre freiwillige Isolation enden solle. Eine gro\xDFe
      Gruppe von Pegasi, die sich selbst die Gro\xDFe Pegasus-Enklave nennt, kam
      vor etwa vier Monaten an die Oberfl\xE4che, gr\xFCndete eine Milit\xE4rbasis
      und lie\xDF nicht zu dass sich ihr jemand n\xE4herte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824222
    m_Localized: Ich kenne einen Pegasus. Sein Name ist Calamity. Kennst du ihn?
      Er hat damit doch nichts zu tun, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824223
    m_Localized: Er hat eine komplizierte Geschichte. Aber nein, damit hat er nichts
      zu tun.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824224
    m_Localized: "Coldsights Ritter versuchten, mit der Enklave in Kontakt zu treten,
      erhielten jedoch keine Antwort. Die Erinnerung an den alten Verrat der Pegasi
      und der Verdacht des \xC4ltesten lie\xDFen ihn die neue Macht als Bedrohung
      f\xFCr die St\xE4hlerne Bruderschaft im Allgemeinen und f\xFCr sich selbst
      im Besonderen wahrnehmen. Trotz fehlender Beweise f\xFCr feindliche Absichten
      der Enklave den Oberfl\xE4chenponys gegen\xFCber begann er, sich auf den Krieg
      vorzubereiten. Wie eine paranoide Spinne webte er sein Netz innerhalb der Neighara-Division,
      trennte die, denen er vertraute, von den \xFCbrigen und weihte sie in seine
      Pl\xE4ne ein, die Basis der Enklave anzugreifen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824225
    m_Localized: "Er war aber auch intelligent genug, um eine n\xFCchterne Einsch\xE4tzung
      seiner Kr\xE4fte und der m\xF6glichen Kr\xE4fte des Feindes vorzunehmen. Ihm
      war klar, dass die Basis nur die Spitze eines Eisbergs sein musste. Schlie\xDFlich
      wusste er nichts dar\xFCber, wie die Pegasi in den letzten zweihundert Jahren
      \xFCberlebt hatten und welchen Anteil sie an der milit\xE4rischen Vorkriegsmacht
      hatten, die sie noch immer besitzen k\xF6nnten. So fand er sich als Verb\xFCndeter
      Caesars wieder, der das Erscheinen einer neuen Macht im \xD6dland ebenso als
      Bedrohung empfand."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824226
    m_Localized: Und so plante er den Angriff auf Stable Pi, @lp. Er wusste von den
      Projekten und plante, sie zu benutzen, um den bevorstehenden Krieg zu gewinnen.
      Und wenn es keinen Krieg gibt...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824227
    m_Localized: "... dann w\xFCrde es f\xFCr unser Zuhause keine Bedrohung geben.
      Ist sich der Mentor dessen bewusst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824228
    m_Localized: "Ja. Und er bat mich dir eine neue Aufgabe zu geben: Finde heraus,
      warum die Enklave auf die Oberfl\xE4che gekommen ist und wie man sie dazu bewegen
      kann wieder zu gehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824229
    m_Localized: "Im Moment k\xE4mpfen die Bruderschaft und die Legion heftig miteinander.
      Wenn die Enklave verschwindet, wird das auch an Bedeutung verlieren. Und angesichts
      des Todes von Coldsight k\xF6nnten die Kontrahenten dann sogar am Verhandlungstisch
      sitzen. Es wird also nicht nur ein Segen f\xFCr Stable Pi sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824230
    m_Localized: "Aber... ist das \xFCberhaupt m\xF6glich? Wie k\xF6nnen wir das
      erreichen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824231
    m_Localized: "Ich wei\xDF es nicht. Die Enklave weigerte sich auch, mich zu kontaktieren.
      Sie schie\xDFen jeden Sprite-Bot ab den ich ihnen schicke. Bevor du handelst,
      musst du mehr \xFCber sie und ihre Ziele erfahren. Wie Velvet sagte, gibt es
      keine Garantie, dass das funktioniert. Aber im Moment ist das die beste Option
      die wir haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824232
    m_Localized: "Und wenn es nicht funktioniert, m\xFCssen wir uns auf die Verteidigung
      von Stable Pi vorbereiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824233
    m_Localized: "Ich k\xF6nnte ihre Basis infiltrieren und herausfinden, wonach
      die Pegasi suchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824234
    m_Localized: "Vielleicht haben wir keine anderen M\xF6glichkeiten. Aber bitte,
      @lp, versuche auf jeden Fall, eine friedliche L\xF6sung zu finden. Wir brauchen
      nicht noch mehr Blutvergie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824235
    m_Localized: "Und wenn ein friedlicher Kontakt fehlschl\xE4gt, bist du die erste
      Verteidigungslinie f\xFCr Stable Pi. Daher bleiben die Artefakte bei dir. Du
      musst \xFCberleben und erfolgreich sein, und sie werden deine Chancen daf\xFCr
      erh\xF6hen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824236
    m_Localized: "Es scheint, als ob sich die Fertigungshallen f\xFCr die Waffen
      hier befinden. Ich hoffe, dass ich hier nichts Gef\xE4hrlicheren als T\xFCrmen
      begegne."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824237
    m_Localized: Obwohl es seltsam ist, dieser Ort ist nicht ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824238
    m_Localized: '(Stimme aus einem Lautsprecher) Achtung! Unautorisierter Zutritt
      erkannt. Initialisiere 144-F Sicherheitsprotokoll.

      Elektrische Felder
      aktiviert.

      Anti-Flugzauber aktiviert.

      Anti-teleportationszauber
      aktiviert.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824239
    m_Localized: "Verfickte Schei\xDFe Celestia!|Das ist hart..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824240
    m_Localized: Elektrische Felder
    m_Metadata:
      m_Items: []
  - m_Id: 2737824241
    m_Localized: "Elektrische Felder... Ich erinnere mich, dass wir etwas \xC4hnliches
      in unserem Stable hatten. Das ist schlecht ... sehr schlecht! Das bedeutet,
      dass jedes Metallobjekt in diesem Raum t\xF6dlich ist. Ich kann nicht auf Metallfu\xDFb\xF6den
      treten, Metallw\xE4nde, T\xFCren und M\xF6bel ber\xFChren, da ich andernfalls
      einen elektrischen Schlag bekomme der meine Gesundheit ernsthaft sch\xE4digt.
      Und ich kann auch nicht mal Telekinese benutzen - das Telekinese-Feld w\xFCrde
      als Leiter dienen und ich bekomme noch mehr ab oder schlimmeres."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824242
    m_Localized: Nur Beton, Holz und Kunststoff sind sicher. Diese Materialien leiten
      keinen Strom. Ich kann auf sie treten oder sie durch Telekinese bewegen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824243
    m_Localized: "Aber vielleicht hat das auch etwas gutes! Wenn dieses System tats\xE4chlich
      unserem \xE4hnlich ist, sollte es Steuerterminals geben, an denen das Feld
      deaktiviert werden kann. Ich bin sicher, dass ich sie hacken kann. Wie k\xF6nnte
      ich mit all meiner Erfahrung scheitern?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824244
    m_Localized: "So mal sehen, was wir hier haben. Spezifikation... Marinegesch\xFCtz,
      Modell 8210 \"Raven\". Entwickelt zum zerst\xF6ren von Torpedobooten und kleinen
      Schiffen. Es kann auf Schiffen aller Art montiert oder f\xFCr Bodenfeuerstellen
      verwendet werden. Technische Daten: Kaliber - 75 mm; Laufl\xE4nge - 3,8 m;
      Gewicht - 790 kg; Projektilgewicht - 8,7 kg; M\xFCndungsgeschwindigkeit - 750
      m / s; Feuerrate - 15 Schuss pro Minute; maximale Schussweite - 6,1 km."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824245
    m_Localized: "Toll! Wenn wir ein paar dieser Gesch\xFCtze in der N\xE4he des
      Lagers aufstellen, wird kein einziger von der St\xE4hlernen Bruderschaft es
      wagen, sich ihm zu n\xE4hern. Bei Discord, jetzt brauchen sie einen Panzer!
      Damit wird das \"T\xE4nzelnde Pony\" mit Sicherheit die am st\xE4rksten befestigte
      Siedlung in der Region sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824246
    m_Localized: "Vielleicht ist das Kaliber sogar etwas zu gro\xDF... Naja, das
      ist nicht mehr mein Problem, die Ponys aus dem Lager werden das schon irgendwie
      machen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824247
    m_Localized: "Bitte beachten Sie: Das elektrische Feld dient dem Schutz wichtiger
      strategischer Objekte. Die Hauptaufgabe besteht darin, das Eindringen feindlicher
      Agenten und den Diebstahl wichtiger Dokumente, die milit\xE4rische Geheimnisse
      enthalten, zu verhindern. Eine Nebenaufgabe ist der Personenschutz. Auf dieser
      Grundlage muss jeder Mitarbeiter die Verhaltensregeln f\xFCr die Aktivierung
      des Elektrofeldes kennen:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824248
    m_Localized: "Verlassen Sie sofort den Metallboden, wenn Sie den Alarm h\xF6ren.
      Ber\xFChren Sie keine Metallw\xE4nde, Treppen, T\xFCren, M\xF6bel oder Ger\xE4te.
      Bewegen Sie sich auf dem Betonboden oder klettern Sie, wo es keinen gibt, auf
      Holz- oder Kunststoffschreibtische, Sofas oder Kisten. Bleiben Sie dort, bis
      das Feld abgeschaltet wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824249
    m_Localized: "Allen Pegasi ist es verboten, zu fliegen und allen Einh\xF6rnern
      - Metallgegenst\xE4nde mittels Telekinese oder Teleport zu ber\xFChren. Solche
      Aktionen k\xF6nnen t\xF6dlich sein, w\xE4hrend das Elektrofeld aktiviert ist.
      Denken Sie auch daran, dass Gummischuhe oder Schutzanz\xFCge Sie nicht vor
      einem elektrischen Schlag bewahren werden, obwohl sie die Wirkung verringern
      k\xF6nnten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824250
    m_Localized: "W\xE4hrend der Dauer die das Elektrofeld aktiv ist wechselt die
      Robotersicherheit in den Alarmzustand. Machen Sie keine pl\xF6tzlichen Bewegungen
      in Gegenwart der Sicherheitsroboter und behalten Sie Ihre Ausweise im Blick.
      Denken Sie daran, dass Ihr Leben und Ihre Sicherheit vom Wissen und der strikten
      Einhaltung dieser Regeln abh\xE4ngt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824251
    m_Localized: "Velvet \xFCber Zuhause"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824252
    m_Localized: "Ich denke einfach nach. So lange im Unklaren \xFCber seine Heimat
      zu bleiben und am Ende gibt es nichts Neues f\xFCr mich."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824253
    m_Localized: "Bist du nicht froh dar\xFCber bald wieder zur\xFCck zu k\xF6nnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824254
    m_Localized: Bist du es, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824255
    m_Localized: Ich? Ich bin nicht sicher. Ich wollte mein Zuhause wiedersehen aber...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824256
    m_Localized: "Aber du wei\xDFt nun \xFCber die Dinge die hier an der Oberfl\xE4che
      passieren und das l\xE4sst dir keine Ruhe, richtig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824257
    m_Localized: "...\nRichtig. Und Tatsache ist dass wir l\xE4ngst h\xE4tten eingreifen
      sollen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824258
    m_Localized: "... da macht die Willkommensparty dann nicht mehr so viel Spa\xDF
      oder? F\xFCr dich ist noch nicht alle Hoffnung verloren, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824259
    m_Localized: Wovon redest du da?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824260
    m_Localized: "Davon dass, dass die Bewohner des \xD6dlands auf dich z\xE4hlen
      k\xF6nnen, wenn es Zeit gekommen ist, dass sich Stable Pi der Welt \xF6ffnet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824261
    m_Localized: "Es sei denn er wird bald wegen unserer Feinde ein f\xFCr alle mal
      versiegelt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824262
    m_Localized: "Wir haben immer noch die M\xF6glichkeit eine bessere L\xF6sung
      f\xFCr die Situation zu finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824263
    m_Localized: "W\xE4hrend du die Basis der Enklave erkundest, helfe ich bei den
      Vorbereitungen der Zebras hier. Und der Beobachter wird sein Bestes tun, um
      die aktuelle Situation in der Region zu kl\xE4ren. Wir m\xFCssen auf jede Entwicklung
      vorbereitet sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824264
    m_Localized: "Gespr\xE4ch mit dem Beobachter"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824265
    m_Localized: Beobachter, nicht wahr?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824266
    m_Localized: Ja.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824267
    m_Localized: "Eines verstehe noch nicht ganz... Warum hilfst du Stable Pi? Du
      geh\xF6rst doch nicht zu uns, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824268
    m_Localized: "Nein, und ich war noch nie dort.\nLass es mich so ausdr\xFCcken,
      ich verfolge eure Versuche, die Artefakten zu erlangen, schon seit geraumer
      Zeit. Und ich stehe schon lange in Kontakt mit eurem Mentor."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824269
    m_Localized: "Warum hast du die Mission dann nicht selbst bekommen? Das h\xE4tte
      viele ehemalige Auserw\xE4hlte gerettet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824270
    m_Localized: "Sprite bots sind wohl kaum ein gutes Mittel um die Orte zu durchqueren
      an denen solche Gegenst\xE4nde aufbewahrt werden und andere M\xF6glichkeiten
      habe ich nicht. Sei dankbar, dass sie es zumindest geschafft haben die ungef\xE4hren
      Standorte der Artefakte herauszufinden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824271
    m_Localized: "Du hast sie gefunden? Der Mentor sagte mir, dass Informationen
      dar\xFCber aus den Archiven stammen w\xFCrden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824272
    m_Localized: "Als ob Vorkriegs-Ponys solche Geheimnisse zuf\xE4llig in irgendwelchen
      Archiven herumliegen h\xE4tten. Abgesehen von den direkt involvierten Mitarbeitern
      haben bestenfalls die Mitglieder des h\xF6chsten Kommandos davon gewusst, wo
      sich solche m\xE4chtigen und gef\xE4hrlichen Gegenst\xE4nde befanden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824273
    m_Localized: Du hast meine Frage noch nicht beantwortet. Warum hilfst du uns?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824274
    m_Localized: "Oh, ja das ist eine gute Frage. Aber es ist zu fr\xFCh um darauf
      zu antworten. Ich werde dich \xFCber meine Absichten informieren, wenn es notwendig
      ist, nicht vorher."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824275
    m_Localized: Konfrontation mit der Enklave
    m_Metadata:
      m_Items: []
  - m_Id: 2737824276
    m_Localized: "Hauptmann! Hauptmann, sehen sie! Noch einer dieser Minderwertigen!
      Erlaubnis auf sie zu schie\xDFen? Fleetfoot durfte beim letzten Mal!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824277
    m_Localized: Erlaubnis erteilt. Du bist diesmal dran.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824278
    m_Localized: Wartet einen Moment! Ich komme in Frieden! Ich bin...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824279
    m_Localized: "... du wirst in Frieden ruhen. Du h\xE4ttest das Gebiet der Enklave
      nicht betreten d\xFCrfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824280
    m_Localized: "Wieso? Wieso muss es immer auf diese Weise enden? Ich wollte...
      frieden schlie\xDFen...\nWieso wollen die einfach alle nicht in Frieden leben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824281
    m_Localized: "Warum muss ich immer wieder andere Ponys t\xF6ten?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824282
    m_Localized: Die Kommandozentrale. Es wird Zeit, das hier zu beenden!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824283
    m_Localized: "Pl\xE4ne der Enklave"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824284
    m_Localized: Stehen bleiben, du Bastard!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824285
    m_Localized: "Ganz ruhig! Ich ergebe mich, Ich ergebe mich! Bitte t\xF6te mich
      nicht!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824286
    m_Localized: "Ich kann nichts garantieren, ihr M\xF6rder.\nWas tust du hier?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824287
    m_Localized: Was? Wen meinst du mit "Ihr"?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824288
    m_Localized: "Na dich, bei Celestia man! Die Enklave nat\xFCrlich! Was treibt
      ihr hier im \xD6dland? Warum seid ihr hier herunter gekommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824289
    m_Localized: Wir sind... Wir haben nur geforscht! Wir erkunden dieses Gebiet!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824290
    m_Localized: "Du l\xFCgst. Ihr w\xFCrdet nicht so viele Soldaten hierher schicken,
      um zu \"Forschen\". L\xFCg mich noch einmal an und du wirst es bereuen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824291
    m_Localized: "Ich L\xFCge nicht! Ich L\xFCge nicht! Wir brauchen die Soldaten
      zu unserem Schutz! Ist nicht beleidigend gemeint, aber ihr Oberfl\xE4chenponys
      k\xF6nnt sehr ... \xE4\xE4mm ... alternativ freundlich sein. Ja, alternativ
      freundlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824292
    m_Localized: Wir? Eure Soldaten haben mich am Eingang angegriffen, ohne mir die
      Chance zu geben, zu verhandeln!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824293
    m_Localized: "Weil eure Art uns mehr als einmal get\xE4uscht und unsere Wachen
      get\xF6tet hat! Oh, Tut mir Leid, tut mir Leid! Ich meinte \"Ponys, die dir
      \xE4hnlich sehen\". Erschie\xDF mich bitte nicht, so habe ich das nicht gemeint!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824294
    m_Localized: Was genau untersucht ihr hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824295
    m_Localized: "Wei\xDFt du, wir ... Pegasi haben uns vor langer Zeit von der Oberfl\xE4che
      abgeschottet. Nat\xFCrlich schauen wir gelegentlich hier vorbei, nur aus Interesse.
      Aber wir haben nichts Schlimmes im Sinn! Ehrlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824296
    m_Localized: "Beruhige dich und erz\xE4hle mir alles. Dann werde ich dich nicht
      erschie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824297
    m_Localized: "Wirklich?\nIn Ordnung, also uns wurde gesagt, wir sollen euch studieren.
      Die Oberfl\xE4che meine ich. Wie viel ihr ver\xE4ndert habt, was ist neu, was
      k\xF6nnen wir gebrauchen ... Nun, kaufen, bei euch. Wir haben M\xF6glichkeiten
      zur Interaktion mit der lokalen Fauna untersucht, informierten uns \xFCber
      Bedrohungen und Ponygesellschaften. Wenn wir uns also entschlie\xDFen, zu euch
      herunter zu kommen, wissen wir was uns erwartet. Wir mussten f\xFCr diese Zwecke
      eine Forschungseinrichtung vor Ort aufbauen und ... hier sind wir."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824298
    m_Localized: "Was? Auf friedliche Weise? Keine Eroberung von Territorien, Ressourcen
      und H\xE4usern?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824299
    m_Localized: "Nun... \xE4hmm... \xFCber sowas habe ich nicht zu entscheiden.
      Ich habe keine Ahnung, glaub mir! Lass mich gehen, und ich werde versuchen,
      den Befehlshaber zu \xFCberreden, keine Strafexpedition hierher zu entsenden!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824300
    m_Localized: Eine Straf-Was?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824301
    m_Localized: Nichts, nichts!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824302
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824303
    m_Localized: "Das waren unsere Befehle! Wenn die Basis angegriffen wird und erheblichen
      Personalverlust erleidet, soll das umgehend gemeldet werden! Wenn ich k\xF6nnte,
      w\xFCrde ich nicht zulassen dass so etwas passiert, ich will keinen Krieg!
      Ich k\xF6nnte behaupten, wir hatten ... ein kleines Missverst\xE4ndnis, ja!
      Ein Missverst\xE4ndnis. Vielleicht w\xFCrde unser Pr\xE4sident sogar ein bisschen
      sanfter vorgehen und nur ein paar D\xF6rfer zerst\xF6ren. Sag mir, woher du
      kommst und sie werden deines verschonen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824304
    m_Localized: "Deine Vorgesetzten ... werden eine Armee schicken? Und jedes Pony
      wegen dieses Angriffes t\xF6ten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824305
    m_Localized: "\xC4hm ... ich habe sie nicht gew\xE4hlt! Ich werde eine Zusammenkunft
      einberufen, ja, eine Zusammenkunft, wir werden es nicht zulassen dass eine
      Armee entsendet wird! Ihr habt nicht einmal n\xFCtzliche Ressourcen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824306
    m_Localized: Celestia erbarme sich deiner...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824307
    m_Localized: Argh! Stirb, du Bastard! Das ist alles deine Schuld! Alles wegen
      Dir!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824308
    m_Localized: Ausreden
    m_Metadata:
      m_Items: []
  - m_Id: 2737824309
    m_Localized: Velvet... Ich... es...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824310
    m_Localized: "Wissen wir @lp. Das Chaos, das du angerichtet hast, hat es mir
      erm\xF6glicht, in die Basis zu gelangen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824311
    m_Localized: Es war ein Gemetzel, @lp. Ein schreckliches Gemetzel. Vielleicht
      waren die Pegasi dir feindlich gesinnt, aber...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824312
    m_Localized: "Wir k\xF6nnen ihr nicht vorwerfen, was sie getan hat, Velvet! Alles
      deutete darauf hin dass es unm\xF6glich war zu verhandeln. Nach all dem Schrecken
      des \xD6dlands und in ihrer Situation..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824313
    m_Localized: '"In ihrer Situation" war nur Vorsicht geboten! Verstehst du die
      Konsequenzen nicht? Trifft dich nicht der Tod so vieler Ponys nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824314
    m_Localized: "Ich habe genug \xDCbel gesehen und kann mir eine n\xFCchterne Einsch\xE4tzung
      der Situation erlauben, junge Dame! Ihre Entscheidung war gerechtfertigt! Es
      ist unsere Schuld, dass wir die Konsequenzen nicht vorhergesehen haben. Jetzt
      ist nicht die Zeit, ihr die M\xE4hne zu rupfen. Es ist Zeit zu handeln!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824315
    m_Localized: "Bitte... Ich verstehe was ich getan habe. Ich habe einen Fehler
      gemacht und bin zu weit gegangen. Aber ... es war einfach nicht anders zu machen.\nDer
      Beobachter hat recht. Wir m\xFCssen handeln."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824316
    m_Localized: "Wir m\xFCssen jeden sagen, was passiert ist. Jedem Pony dem wir
      es sagen k\xF6nnen. Der Krieg kommt und wir haben wenig Zeit.\nDu hast in dieser
      Basis dort viel mehr Ponys get\xF6tet als nur Dutzend Enklave Soldaten, @lp.
      Viel mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824317
    m_Localized: "Velvet! Du solltest solche Anschuldigungen nicht machen.\nIch arbeite
      bereits daran die Siedlungen an der Oberfl\xE4che zu benachrichtigen. Und du,
      @lp, musst den Mentor warnen. Und \xFCbergib ihm die Artefakte. Vielleicht
      schafft er es die Projekte \"Sun\" und \"Rainbow\" zu vervollst\xE4ndigen.
      Vielleicht ist er sogar bereit, uns zu helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824318
    m_Localized: "Tut mir Leid @lp, aber ich m\xF6chte bleiben um dem Beobachter
      zu helfen. Egal wie sehr ich mit dir nach Hause zur\xFCckkehren m\xF6chte,
      meine F\xE4higkeiten werden hier gebraucht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824319
    m_Localized: 'Gut. Dann ziehe ich sofort los.

      ...

      Vergib mir, Velvet.
      Ich... Ich habe versucht freundlich zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824320
    m_Localized: "Nicht n\xF6tig sich bei mir zu entschuldigen. Du wirst dein eigener
      Richter sein. Und kein Pony kann zu sich selbst so streng sein wie du."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824321
    m_Localized: Und dennoch, @lp, obwohl du jeden in dieser Basis massakriert hast,
      hast du den Befehlshaber der sich ergeben hat verschont.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824322
    m_Localized: Ja, das habe ich.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824323
    m_Localized: Nur einen Schritt nach vorn, bei allem was passiert ist. Aber dieser
      Schritt hat einem Pony das Leben gerettet. Vielleicht nicht nur einem.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824324
    m_Localized: "M\xF6glicherweise hast du einen Fehler gemacht, @lp, aber diese
      Tat sagt viel \xFCber dich aus."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824325
    m_Localized: "Der Kommandant, den du get\xF6tet hast... hatte sich ergeben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824326
    m_Localized: "Ja, ich habe ihn get\xF6tet weil... ich wei\xDF nicht. Ich dachte
      es w\xFCrde schon in Ordnung gehen. Ich wusste nicht so recht was ich tun sollte,
      au\xDFerdem habe ich ihm nicht geglaubt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824327
    m_Localized: "Der Beobachter hatte zwar Recht, als er sagte, dass du Gr\xFCnde
      f\xFCr diese Gewalt hattest. Aber trotzdem gibt es Grenzen, die nicht \xFCberschritten
      werden d\xFCrfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824328
    m_Localized: Der Weg nach Hause
    m_Metadata:
      m_Items: []
  - m_Id: 2737824329
    m_Localized: "Wie komme zum Stable Pi zur\xFCck?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824330
    m_Localized: Das ist viel einfacher als du vielleicht denkst. Das im Terminal
      des MAS Notfall Rettungs Systems integrierte Teleportationssystem bringt dich
      nach Hause.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824331
    m_Localized: Ein Terminal? So einfach!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824332
    m_Localized: "\xC4hmm..... oder doch nicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824333
    m_Localized: Ich kann mich damit nur dorthin teleportieren wo ich vorher gewesen
      bin. Aber ich habe keine Ahnung wo mein Zuhause sich befindet.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824334
    m_Localized: "Du brauchst keine Koordinaten, um nach Hause zur\xFCckzukehren.
      Alles, was du brauchst, ist ein PipBuck, der seinem wahren Besitzer geh\xF6rt
      und die Zugangscodes f\xFCr Stable Pi enth\xE4lt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824335
    m_Localized: Und habe ich diese Codes?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824336
    m_Localized: "Nein. Aber ich habe sie. Ich \xFCbertrage sie gerade auf deinen
      PipBuck. Gleich fertig... so jetzt. Jetzt kannst du \xFCber die PipBuck-Karte
      nach Hause gehen. Vielleicht treffen wir uns wieder, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824337
    m_Localized: Warte! Du hast mir nie gesagt, wer du wirklich bist. Wenn du nicht
      im Stable Pi wohnst, wie stehst du dann dazu? In welcher Beziehung stehst du
      zum Mentor? Woher hast du die Zugangscodes und alle Informationen, die du mir
      mitgeteilt hast? Denkst du nicht dass ich ein Recht habe das zu erfahren?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824338
    m_Localized: "Ja, wir sollten das wirklich erfahren. Vertrauen sollte auf gegenseitigkeit
      beruhen, oder? Du wei\xDFt so viel \xFCber uns, aber wir k\xF6nnen nicht behaupten
      etwas \xFCber dich zu wissen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824339
    m_Localized: "*** Der Sprite-Bot macht ein seltsames Ger\xE4usch. Als w\xFCrde
      jemand am anderen Ende der Leitung tief durchatmen ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824340
    m_Localized: "Schon gut.. Du hast recht, ich werde ein bisschen was von mir erz\xE4hlen.
      Ein bisschen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824341
    m_Localized: "Das au\xDFergew\xF6hnlichste, was ihr \xFCber mich wissen solltet,
      ist dass ich ein Drache bin."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824342
    m_Localized: Ein Drache?!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824343
    m_Localized: "Ein Drache? Aber... Ich habe Drachen bisher nur in B\xFCchern gesehen!
      Euch gibt es wirklich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824344
    m_Localized: Ich habe von meiner Art schon lange keinen mehr gesehen. Vielleicht
      bin ich der letzte Drache in dieser Region. Aber wichtiger ist, dass ich als
      Drache sehr lange lebe. Ich erinnere mich noch an das Equestria vor dem Krieg
      mit den Zebras.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824345
    m_Localized: "Und... bist du wirklich \xFCber zweihundert Jahre alt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824346
    m_Localized: "Ich war der pers\xF6nliche Assistent von Twilight Sparkle, Kopf
      des Ministeriums f\xFCr Arkane Wissenschaften. Und w\xE4hrend sich die Stable
      gr\xF6\xDFtenteils au\xDFerhalb unserer Zust\xE4ndigkeit befanden, war Stable
      Pi sehr eng mit uns verbunden. Sobald ich nach dem j\xFCngsten Tag einen Weg
      gefunden hatte, euch zu kontaktieren, half ich euch so gut ich konnte. Auch
      bei der Suche nach Artefakten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824347
    m_Localized: "Das hei\xDFt, du hilfst uns, weil du tats\xE4chlich schon an unserem
      Ursprung beteiligt warst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824348
    m_Localized: "Ja und nein. Meine und Stable Pis Wege kreuzten sich bis zum Ende
      des Krieges nur selten. Aber als die Welt zerst\xF6rt wurde, fing ich an, nach
      jedem Fragment zu greifen, das ich retten konnte. Die meiste Zeit konnte ich
      nichts tun. Jedoch solange euer Stable lebt, gibt es auf dieser Welt noch ein
      St\xFCck Equestria, an das ich mich erinnere. Und ich m\xF6chte helfen, es
      zu sch\xFCtzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824349
    m_Localized: Und dennoch... ein Drache...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824350
    m_Localized: "All das spielt doch keine Rolle. Ich bin zu weit weg, um euch anders
      wie als mit den Sprite-Bots zu helfen, und ich kann meinen Platz hier nicht
      aufgeben. Was jetzt z\xE4hlt, ist, dass wir handeln m\xFCssen. @lp, Du kannst
      dich jetzt jederzeit \xFCber das Terminal nach Hause teleportieren. Ich habe
      dir geholfen, so gut ich konnte, und jetzt muss ich weg. Aber wir bleiben in
      Kontakt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824351
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824352
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824353
    m_Localized: Also... das war nicht was ich erwartet hatte.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824354
    m_Localized: Ja! Ich bin endlich zuhause!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824355
    m_Localized: Mentor? Bist du das? Ja... jetzt erinnere ich mich endlich wieder
      an alles...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824356
    m_Localized: Oh, mein Kopf...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824357
    m_Localized: "Hallo @lp. Nach so vielen Monden... Ich bin froh dich zu sehen.
      Keine Sorge, die Kopfschmerzen sind nur ein Nebeneffekt des Ged\xE4chtniszaubers
      und werden bald vergehen. Und nat\xFCrlich herzlichen Gl\xFCckwunsch zur erfolgreichen
      Erf\xFCllung deiner Mission. Ich bin... wirklich stolz auf dich."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824358
    m_Localized: Ich danke dir... Ich bin froh wieder zuhause zu sein. Wir haben
      viel zu bereden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824359
    m_Localized: Sicher @lp. Wir sollten gleich damit anfangen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824360
    m_Localized: "Der Beobachter erz\xE4hlt mir viel dar\xFCber, was passiert, aber,
      Heilige Celestia, er hat mir nie solche Neuigkeiten wie jetzt gebracht! Du
      sagst also, dass die Pegasi von den Wolken herabsteigen und einen Krieg an
      der Oberfl\xE4che anfangen werden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824361
    m_Localized: "Ja, genau. Mein Angriff auf die Basis wird die Enklave h\xF6chstwahrscheinlich
      zu einer Vergeltungskampagne provoziert haben. Bald verwandelt sich die Oberfl\xE4che
      in ein Schlachtfeld. Oder in ein Schlachthaus..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824362
    m_Localized: "Oh, In welchen Zeiten m\xFCssen wir leben? Aber mach dir keine
      Sorgen, teuerste. Jetzt bist du hier, Zuhause und in Sicherheit. Hier ruhst
      du dich aus, nimmst an einem Rehabilitationskurs teil und dein Leben kehrt
      zu seinem fr\xFCheren, friedlichen Verlauf zur\xFCck. Wenn du es w\xFCnschst
      k\xF6nnen wir alle deine Erinnerungen an die schlimen Dinge an der Oberfl\xE4che
      l\xF6schen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824363
    m_Localized: Entschuldige bitte?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824364
    m_Localized: "Bist du nicht froh wieder hier zu sein? Stell dir vor: Jetzt, wo
      du die Artefakte bekommen hast, werden wir ein so erstaunliches Projekt fertigstellen!
      Wir alle haben so viele Jahre gek\xE4mpft - Jahrhunderte, um eine L\xF6sung
      zu finden! Waren wir jemals so kurz vor dem Abschluss des Projekts?\nIch verstehe,
      @lp, du hast eine Menge erlebt. Wir werden dir helfen. Frau Heartrose wird
      dich professionell psychologisch betreuen, deine Kollegen und Verwandten helfen
      dir, wieder auf die Beine zu kommen. Du wirst als Held geehrt, @lp. Als erster
      Auserw\xE4hlter der in der Lage war das Ziel zu erreichen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824365
    m_Localized: "Und... ihr wollt die Oberfl\xE4chenponys einfach sterben lassen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824366
    m_Localized: "Soweit ich wei\xDF, ist das \"Sterben\" f\xFCr sie ein ganz normaler
      Zustand. Seit zweihundert Jahren vernichten sie sich gegenseitig auf jede erdenkliche
      Weise. Ich verstehe deine Frage nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824367
    m_Localized: "Wie kannst du sowas sagen? Wie k\xF6nnt ihr euch jetzt in so einem
      Moment einfach einschlie\xDFen und eurem Gesch\xE4ft nachgehen, als w\xE4re
      nichts passiert?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824368
    m_Localized: "Ganz, ruhig! Rege dich doch nicht auf. Soweit ich wei\xDF, hast
      du es geschafft, dich an die Bewohner der Oberfl\xE4che zu binden. Vielleicht
      hast du sogar einen guten Grund ihnen zu helfen. Aber so wie wir die ganze
      Situation betrachten, ist es einfach nicht vern\xFCnftig."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824369
    m_Localized: "In Ordung. Ich werde jetzt versuchen, geduldig zu sein. Aber du
      m\xFCsst mir jetzt mal zuh\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824370
    m_Localized: "Ich wei\xDF, dass unser Stable seit fast zwei Jahrhunderten versiegelt
      ist. Ich wei\xDF, dass unser Hauptziel immer das \"Sun\" Projekt war und dass
      wir uns geweigert haben einen Kontakt nach au\xDFen herzustellen, bis wir f\xFCr
      unsere Sicherheit gesorgt haben. Aber im Moment gibt es Siedlungen und Organisationen
      an der Oberfl\xE4che, mit denen wir einen dauerhaften Frieden schlie\xDFen
      k\xF6nnten. Sie k\xF6nnen uns helfen, eine Verbindung zur Oberfl\xE4che herzustellen,
      und wir w\xFCrden ihnen helfen, zu leben und zu gedeihen. Und jetzt sind sie
      in Lebensgefahr. Wir k\xF6nnen versuchen, das Exoskelett zu vervollst\xE4ndigen
      um sie zu sch\xFCtzen. Andernfalls haben wir am Ende nur ein Nirgendwo und
      kein Pony, mit dem wir Kontakt aufnehmen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824371
    m_Localized: "Da h\xF6re ich meine Sch\xFClerin reden! Du wusstest immer, wie
      du deine Gedanken zum Ausdruck bringen kannst, und das ich habe ich immer an
      dir gesch\xE4tzt. Dir fehlt jedoch ein wichtiger Aspekt. Wir sind nicht allm\xE4chtig,
      @lp. Wir wissen nicht, wie stark diese sogenannte Enklave ist, und wir wissen
      nicht, wie weit sie in ihren Krieg gehen k\xF6nnte. Ja, wir k\xF6nnten potenzielle
      Freunde verlieren, wenn wir ihnen nicht helfen. Wenn wir uns jedoch einmischen,
      besteht die Gefahr, dass wir mit ihnen zusammen in Lebensgefahr geraten. Und
      wir k\xF6nnen nicht einmal genau sagen, wie hoch das Risiko daf\xFCr w\xE4re."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824372
    m_Localized: "Wir k\xF6nnen es uns nicht leisten, unseren Stable so r\xFCcksichtslos
      zu riskieren. Der Gedanke, Stable Pi zu verlieren und all das Wissen, welches
      wir besitzen... Wenn wir hier bleiben und das Projekt abschlie\xDFen, haben
      wir viel bessere \xDCberlebenschancen. Das sollte entscheidend sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824373
    m_Localized: "Ich... ich verstehe deine Gr\xFCnde. Du hast recht. Wir sollten
      das Leben der Ponys die hier leben nicht riskieren, f\xFCr einen Krieg, der
      sie nicht betrifft.\nIn dem Fall gebe ich dir die Artefakte, die du ben\xF6tigst,
      um die Projekte abzuschlie\xDFen und verlasse diesen Ort."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824374
    m_Localized: Was? Hast du deinen Verstand verloren, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824375
    m_Localized: "Vielleicht kannst du hier in deinem kleinen Heiligtum sitzen und
      die Ruhe genie\xDFen, aber wegen mir ist ein Krieg im Gange! Und ich kann nicht
      hier bleiben und herumsitzen ohne zu wissen, was los ist!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824376
    m_Localized: "Das kann ich dich nicht tun lassen, @lp! Um deinetwillen, ich verbiete
      es dir Stable Pi zu verlassen! Du bekommst psychologische Hilfe, dir wird ein
      Rehabilitationskurs zur Verf\xFCgung gestellt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824377
    m_Localized: "Du verbietest es mir? Sch\xF6n, halte mich doch davon ab."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824378
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824379
    m_Localized: "Du machst einen gro\xDFen Fehler, @lp. Das \xD6dland hat dir schon
      genug geschadet. Dein Bewusstsein ist gest\xF6rt, du leidest unter dem Hoofington-Syndrom.
      Ich warne dich. Geh nicht!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824380
    m_Localized: "Trotzdem muss ich ablehnen. Nimm die Artefakte. Ich hoffe, ihr
      k\xF6nnt das Projekt abschlie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824381
    m_Localized: "Fein ... ich habe diese M\xF6glichkeit nicht ausgeschlossen. M\xF6ge
      Celestia Erbarmen mit dir haben ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824382
    m_Localized: Bevor du gehst... Hast du es geschafft Velvet Remedy zu finden?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824383
    m_Localized: "Ja, wir haben uns dort drau\xDFen getroffen. Es geht ihr gut, aber
      so wie ich sie verstanden habe, hat sie nicht die Absicht nach Stable Pi zur\xFCckzukehren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824384
    m_Localized: "Das hatte ich bef\xFCrchtet. Ich habe einen Fehler gemacht, als
      ich sie gehen lie\xDF, obwohl sie sich freiwillig gemeldet hat. Jetzt ist es
      offensichtlich, dass es ihr Ziel war, von uns zu entkommen... obwohl ich immer
      noch nicht verstehe, warum."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824385
    m_Localized: "Anscheinend sollten manche Ponys nicht in einem K\xE4figen leben,
      auch wenn dieser K\xE4fig aus Gold besteht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824386
    m_Localized: "Ein K\xE4fig? Wir sind nie ein K\xE4fig gewesen! Wir sind dein
      Zuhause. Und wir werden Ihr Zuhause sein, egal was passiert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824387
    m_Localized: "Jo, @lp, ich bin so froh, dass du zur\xFCck bist! Du hast dich
      so sehr ver\xE4ndert. Aber was soll ich sagen?! Nat\xFCrlich w\xFCrde sich
      jedes Pony nach der R\xFCckkehr von der Oberfl\xE4che ver\xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824388
    m_Localized: "Hallo, Transistor. Du hast dich kein bisschen ver\xE4ndert. Spielst
      du noch immer mit deinen Chips herum?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824389
    m_Localized: "Aber sicher, das ist meine Spezialit\xE4t, was sollte ich sonst
      tun? Ich kann es kaum erwarten, mit der Arbeit am Quanten-Kogitator zu beginnen.
      Das ist ein echtes Wunder, ein Triumph der Technik. Als Mentor uns mitteilte,
      dass du es geschafft hast, wurde ich fast verr\xFCckt! Ehrlich gesagt, ich
      habe \xFCberhaupt nicht an deinen Erfolg geglaubt, nach meinen Berechnungen
      war es eine Wahrscheinlichkeit von 3720..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824390
    m_Localized: "Genug \xFCber Chancen geredet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824391
    m_Localized: Heeey!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824392
    m_Localized: "Erkl\xE4re mir lieber, welche Rolle der Kogitator beim \"Sun\"
      Projekt spielt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824393
    m_Localized: "Was meinst du mit \"welche Rolle\"? Er wird helfen das \"Rainbow\"
      Exoskelett in einen Super-Soldaten zu verwandeln. Er wird die Situation auf
      dem Schlachtfeld von der wahrscheinlichen Flugbahn jeder Kugel bis hin zu den
      Verwundbarsten Stellen jedes Feindes auswerten. Er berechnet, wie man sich
      bewegt, wie man zielt, wie man jede Bewegung auf dem Boden und in der Luft
      steuert und die Bewegungen jedes Feindes vorhersagt. Es ist wie beim S.A.T.S.,
      nur tausendmal besser und alles funktioniert in Echtzeit! Wir haben bereits
      alle Algorithmen, und brauchen nur noch einen leistungsf\xE4higen Prozessor."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824394
    m_Localized: "Ich schaudere bei dem Gedanken, wie es w\xE4re, gegen solchen einen
      Feind zu k\xE4mpfen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824395
    m_Localized: "Nun... Es gibt nur ein Exemplar des Quanten-Kogitators, so etwas
      gibt es sonst nirgendwo. Das ist ein ganzes Rechenzentrum in deiner Tasche!
      Und jetzt haben wir es, also solltest du dir keine Sorgen machen, dass es von
      Feinden benutzt werden k\xF6nnte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824396
    m_Localized: "Ist das wirklich ein Einzelst\xFCck? Wenn ich daran denke dass
      ich es als Erweiterungsmodul f\xFCr meinen PipBuck verwendet habe."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824398
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824399
    m_Localized: "... @lp, du hast es nicht zuf\xE4llig auch als Hammer benutzt,
      oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824400
    m_Localized: "Na ja, vielleicht einmal... Wei\xDFt du, da oben hatte ich eine
      Menge Abenteuer zu bestehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824401
    m_Localized: ... tue sowas nie wieder, verstanden? Lass mich dir stattdessen
      ein anderes Erweiterungsmodul geben. Es funktioniert genauso, mit dem einzigen
      Unterschied, dass es sich dabei nicht um eine einzigartige und unglaublich
      wertvolle Technologie handelt.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824402
    m_Localized: "In Ordnung, entspanne dich. Wei\xDFt du, wenn du die ganze Zeit
      in deiner Werkstatt bist, wirst du irgendwie nerv\xF6s. Ich war froh dich wieder
      zu sehen also arbeite dich nicht zu Tode."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824403
    m_Localized: "@lp, was sind wir dir f\xFCr die \"Rainbow\" -R\xFCstungspl\xE4ne
      schuldig! Du kannst dir nicht vorstellen, wie lange ich auf die Gelegenheit
      gewartet habe, sie mir anzusehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824404
    m_Localized: "Lime Fizzy, wie l\xE4uft es in der Gie\xDFerei?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824405
    m_Localized: "Die Arbeit ist in vollem Gange, die \"Rainbow\" -R\xFCstung ist
      fast fertig. Wenn wir alles richtig machen, wird das ein wahres Meisterwerk
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824406
    m_Localized: "Ist diese R\xFCstung wirklich so besonders? Ich habe viel an der
      Oberfl\xE4che gesehen, es wird schwierig werden, mich zu beeindrucken."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824407
    m_Localized: "Glaube mir, diese R\xFCstung wird etwas ganz besonderes. Erstens
      ist sie mit Fl\xFCgeln ausgestattet und erm\xF6glicht ihrem Besitzer zu fliegen.
      Zweitens werden diese magischen Artefakte, die du beschafft hast, ihre Schutzeigenschaften
      unglaublich verbessern. Und drittens sollten sie die magische Kraft und Effizienz
      von Waffen f\xFCr ihren Besitzer erheblich steigern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824408
    m_Localized: "Deshalb planen wir, sie die \"Alihorn-R\xFCstung\" zu nennen. Derjenige,
      der sie anlegt, wird selbst den G\xF6ttinnen Celestia und Luna in nichts nachstehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824409
    m_Localized: "Das klingt wirklich beeindruckend. Ich hoffe, dass diese Macht
      niemals f\xFCr das B\xF6se eingesetzt wird. Ich habe dort an der Oberfl\xE4che
      zu viel Gewalt gesehen... und selbst einen erheblichen Teil davon verursacht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824410
    m_Localized: War es so hart? Hey, wie ist es dort oben? Wirklich so schlimm?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824411
    m_Localized: "Wie soll ich das sagen... Ja und nein. Dort oben kann das Leben
      hart sein. Und sehr grausam. Oft hei\xDFt es entweder t\xF6ten oder get\xF6tet
      werden. Aber gleichzeitig ist dieses Leben... wirklich. Ich wei\xDF nicht,
      wie ich es erkl\xE4ren soll..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824412
    m_Localized: "Ich glaube ich verstehe. Genau das ist der Grund warum wir die
      \"Alihorn R\xFCstung\" bauen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824413
    m_Localized: "Nein. Ich bef\xFCrchte, du verstehst es immer noch nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824414
    m_Localized: "Oh, @lp, Ich bin froh, dass du vorbeigekommen bist. Ich habe geh\xF6rt,
      dass du vor hast an die Oberfl\xE4che zur\xFCckzukehren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824415
    m_Localized: "Hallo, Mrs. Heartrose. Ja, ich sollte so schnell wie m\xF6glich
      zur\xFCckkehren. Da ist eine sehr wichtige Sache, die noch erledigt werden
      muss."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824416
    m_Localized: "Kann ich dich irgendwie \xFCberreden zu bleiben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824417
    m_Localized: Ich glaube nicht. Tut mir Leid aber ich brauche keine psychologische
      Hilfe. Zumindest jetzt noch nicht. Es werden bald schreckliche Dinge passieren,
      und bis zu einem gewissen Grad ist es meine Schuld.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824418
    m_Localized: "Aha. Dann werde ich dich mit meinem Rat nicht entmutigen oder ver\xE4rgern,
      zumal ich nicht das Gef\xFChl habe, dass es meine Aufgabe ist, ihn dir zu geben.
      Offensichtlich hast du viele Dinge erlebt, von denen ich keine Ahnung habe,
      so dass ich die Situation kaum richtig einsch\xE4tzen oder eine Entscheidung
      f\xFCr dich treffen kann. Ist es das Gef\xFChl von Verantwortung, was dich
      antreibt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824419
    m_Localized: Vermutlich. Es gibt Freunde, die bald meine Hilfe brauchen werden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824420
    m_Localized: "Dann solltest du gehen. Andernfalls w\xFCrdest du es dir niemals
      verzeihen k\xF6nnen, dass du abseits gestanden hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824421
    m_Localized: Bei Celestia, das einzige, was wir unser ganzes Leben lang getan
      haben, ist abseits zu stehen...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824422
    m_Localized: "Ich danke dir. Jetzt f\xFChle ich mich schon ein wenig besser."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824423
    m_Localized: "Gut. Dann lass mich dir noch einen kleinen Rat geben. Geh noch
      nicht gleich weg, ein paar Stunden werden wohl kaum einen Unterschied machen.
      Mache einen Spaziergang durch den Stable, sieh nach deinen Freunden und wirf
      einen Blick in dein Zimmer. Schlie\xDFlich ist dies dein Zuhause, und selbst
      ein kurzer Aufenthalt Zuhause wird sich sicherlich positiv auf dich auswirken."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824424
    m_Localized: "In Ordnung, Ich werde deinem Rat befolgen. Und mach dir um mich
      keine Sorgen, wir werden uns wiedersehen, und dann wird es Zeit f\xFCr ein
      ernsthaftes Gespr\xE4ch von Herz zu Herz."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824425
    m_Localized: "Hallo professor. Ich st\xF6re doch nicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824426
    m_Localized: "Was? Ah, @lp, \xFCberhaupt nicht, \xFCberhaupt nicht... Du bist
      also zur\xFCck, nachdem du deine gro\xDFe Mission erf\xFCllt hast? Ich habe
      an dich geglaubt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824427
    m_Localized: "Ja, ja, und bin nicht nur zur\xFCck, sondern habe auch diese verdammten
      Artefakte. Sie k\xF6nnen sich gar nicht vorstellen, wie viel M\xFChe es gekostet
      hat, die zu bekommen! War es wirklich unm\xF6glich, ohne sie auszukommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824428
    m_Localized: "Oh, Ich w\xFCnschte, es w\xE4re anders ... Du siehst wie absolut
      einzigwartig diese Artefakte sind, nichts kann sie ersetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824429
    m_Localized: "K\xF6nnten Sie mir dann zumindest genauer erl\xE4utern, warum ich
      mein Leben daf\xFCr aufs Spiel setzen musste?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824430
    m_Localized: "Oh, nat\xFCrlich. Das Alihorn Amulett ist in vielerlei Hinsicht
      ein sehr altes und einzigartiges Objekt. Wir wissen viel dar\xFCber aus den
      Forschungsberichten des Ministeriums f\xFCr Arkane Wissenschaften. Es basiert
      auf einem gro\xDFen Kristall aus Arkanit von feinster Reinheit, einem \xE4u\xDFerst
      seltenen Mineral, man k\xF6nnte sogar sagen legend\xE4r! Dieses Material hat
      die F\xE4higkeit, verschiedene auf es gerichtete Energien, einschlie\xDFlich
      der Einhorn-Magie, um ein Vielfaches zu verst\xE4rken."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824431
    m_Localized: "Die daraus resultierenden magischen St\xF6rungen k\xF6nnen jedoch
      die Pers\xF6nlichkeit des Magiers selbst \xE4u\xDFerst negativ beeinflussen
      und sein Denken und seine Wahrnehmung verzerren. Die Sch\xF6pfer des Amuletts
      konnten diesen Effekt nicht ausschalten, so dass es jahrhundertelang als verflucht
      galt und die Seelen seiner Besitzer versklavte. Aber wir haben die Macht der
      Vorkriegs- und der neueren Wissenschaft auf unserer Seite und ich wei\xDF,
      wie wir den Benutzer unserer \"Alihorn-R\xFCstung\" vollst\xE4ndig davor sch\xFCtzen
      k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824432
    m_Localized: Und was ist mit dem Schwarzen Buch?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824433
    m_Localized: "Ah, dieses Artefakt ist etwas vollkommen anderes, aber auch sehr
      bemerkenswert. Die Ponys von damals hielten dank der Propagandamaschine der
      Ministerien die Zebras f\xFCr eine Art bl\xF6de Wilde. Das ist nat\xFCrlich
      v\xF6lliger Unsinn. Die Zebras haben uns in vielen Wissensgebieten umgangen,
      ihr Schamanismus, ihre Alchemie und ihre Nekromantie stehen unserer Magie in
      nichts nach. Wie h\xE4tte der Gro\xDFe Krieg sonst so viele Jahre dauern und
      so enden k\xF6nnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824434
    m_Localized: "Glauben Sie mir, Professor, in den letzten Wochen habe ich eine
      Menge \xFCber Zebras gelernt, was sicher nicht in Ihren B\xFCchern steht. Einige
      dieser Dinge h\xE4tte ich lieber nicht gewusst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824435
    m_Localized: "Sehr interessant. Ich w\xFCrde mich sehr freuen, wenn du mir dieses
      neu erworbene Wissen zu Papier bringen k\xF6nntest."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824436
    m_Localized: "Vielleicht sp\xE4ter..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824437
    m_Localized: "*Seufz*... ja nat\xFCrlich. Also, das Schwarze Buch. Es wurde vor
      vielen Jahrhunderten von einem wahnsinnig gewordenen Zebra-Alchemisten erschaffen.
      Mit Blut geschrieben, in Zebrahaut gebunden und mit Hilfe eines b\xF6sen Schamanismus,
      der uns unbekannt ist, verzaubert. Das ist nur was es von au\xDFen ist. Tats\xE4chlich
      wissen wir nicht viel dar\xFCber was sich in seinem Inneren verbirgt. Aber
      das Wenige, das wir wissen, ist erstaunlich! Mit Hilfe des Buches k\xF6nnte
      man beispielsweise Objekte nahezu unzerst\xF6rbar machen. Stell dir vor, diese
      M\xF6glichkeit w\xFCrde bei der Herstellung von R\xFCstungen angewendet werden!
      Das Buch selbst kann auch nicht mit uns bekannten Mitteln vernichtet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824438
    m_Localized: "Aber warum haben Zebras dann solche R\xFCstungen nicht selbst hergestellt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824439
    m_Localized: "Gute Frage. Anscheinend galt das in diesem Buch enthaltene Wissen
      selbst unter Zebras als verboten und \xE4u\xDFerst geheim. Dar\xFCber hinaus
      sind diese Zauberspr\xFCche zweifellos dunkel und k\xF6nnen einen erheblichen
      Preis fordern, zum Beispiel einen Teil der Seele des Zaubernden. Wir sind jedoch
      bereit, diesen Preis zu zahlen, ich zahle ihn bei Bedarf auch selbst wenn es
      sein muss."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824440
    m_Localized: "Da gibt es noch mehr. Aber den Rest kann ich dir erst erz\xE4hlen,
      nachdem ich das Buch selbst in Augenschein genommen habe. Magier aus dem Ministerium
      f\xFCr Prestige, die das Buch studiert haben, klassifizierten die Ergebnisse
      ihrer Forschung und wir bekamen nur kleine Datenst\xFCcke. Aber das \xFCberrascht
      mich \xFCberhaupt nicht. Sowohl das Buch als auch das darin enthaltene Wissen
      sind sicherlich sehr gef\xE4hrlich."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824441
    m_Localized: "Nun, Professor, jetzt kann ich das Ganze besser verstehen. Viel
      Gl\xFCck bei Ihrer Recherche!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824442
    m_Localized: Calamity und die Enklave
    m_Metadata:
      m_Items: []
  - m_Id: 2737824443
    m_Localized: Calamity? Was machst du denn hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824444
    m_Localized: "Gr\xFC\xDF dich, @lp! Das hast du wohl nicht erwartet oder? Ich
      bin froh dich zu sehen, Pipsqueak!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824445
    m_Localized: "W\xE4hrend du im Stable warst, warnte der Beobachter alle mit seinen
      Sprite-Bots vor der bevorstehenden Invasion. Und zu unserer \xDCberraschung
      bot das \"T\xE4nzelnde Pony\" an, die Streitkr\xE4fte zu vereinen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824446
    m_Localized: Na ja, irgendwie.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824447
    m_Localized: "\"Streitkr\xE4fte vereinen\"? Mit wen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824448
    m_Localized: Mit Stahlhufes Rittern... und den Bewohnern aus dem "Verdeckten
      Zeichen". Die hier lebenden Zebras haben entschieden, dass sie sich lange genug
      versteckt haben.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824449
    m_Localized: "Unsere Leute waren alle dabei, @lp. Unser Trupp aus den besten
      Sch\xFCtzen sollte bereits beim Lager der Bruderschaft sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824450
    m_Localized: "Das ist gut, nehme ich an... aber wieso, Calamity? Was hofft ihr
      zu erreichen? Die Enklave ist ein m\xE4chtiger Gegner, und wir k\xF6nnten besiegt
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824451
    m_Localized: "Wirklich.., sollen wir stattdessen nett und leise herumsitzen?
      Dein Freund mit dem Sprite-Bot meinte, dass die Enklave sich an allen r\xE4chen
      wird, und ich glaube ihm. Ich war selbst dort, ich kenne ihre Gewohnheiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824452
    m_Localized: Du warst ein Soldat der Enklave?!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824453
    m_Localized: "Captain Deadshot Calamity, im Ruhestand. Zu Ihren Diensten. Du
      kannst mich auch einfach \"K\xE4ppi\" nennen, das macht mir nichts aus."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824454
    m_Localized: Warum hast du sie verlassen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824455
    m_Localized: "Nun, wei\xDFt du, du hast ihre Methoden gesehen. Ich bin vor langer
      Zeit gegangen, bevor sie \xFCberhaupt angefangen haben, von der Oberfl\xE4che
      zu reden, aber trotzdem... Glaub mir, @lp, was sie auch im Schilde f\xFChren
      ist auf keinen Fall gut f\xFCr uns.\nMan k\xF6nnte sagen dass es jetzt etwas
      pers\xF6nliches f\xFCr mich ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824456
    m_Localized: "Ihr k\xF6nntet einfach weg gehen. Irgendwo hin, weit weg. Besonders
      du, Calamity, wenn du die Enklave so gut kennst, k\xF6nntest du den Ponys einen
      Ort zeigen, an dem ihre Truppen sie nicht finden w\xFCrden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824457
    m_Localized: "Das Ist nicht der richtige Weg, @lp. Und wir k\xF6nnen nirgendwo
      hingehen. Au\xDFerdem kennen wir alle ein Pony, das sowas auch nicht tun w\xFCrde.\nWei\xDFt
      du, @lp, vielleicht hast du es nicht bemerkt, aber viele Leute folgen deinem
      Beispiel. Ich war nicht einmal \xFCberrascht, als ich herausfand, dass du auch
      Zebras und der St\xE4hlernen Bruderschaft geholfen hast. So hatten wir jemanden,
      \xFCber den wir miteinander kommunizieren konnten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824458
    m_Localized: ... danke.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824459
    m_Localized: Trotzdem es waren meine Taten, die die Enklave provoziert haben.
      Wegen mir seid ihr jetzt alle in Gefahr.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824460
    m_Localized: "Vergiss es, @lp. Ich sags dir. Wenn diese Soldaten hier runterkommen,
      dann weil sie das aus freien St\xFCcken tun. Glaub mir, ich wei\xDF das. Du
      hast garnichts provoziert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824461
    m_Localized: "Es geht nur um Ressourcen, Kriege werden immer deswegen gef\xFChrt.
      Die Pegasi lebten lange Zeit hinter den Wolken, aber es konnte nicht ewig so
      weitergehen. Wei\xDFt du, in den Wolken gibt es weder Metall noch Kohle, und
      ehrlich gesagt auch nicht viel zu essen. Sie h\xE4tten so oder so eine Invasion
      gestartet, wenn nicht jetzt dann n\xE4chstes Jahr."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824462
    m_Localized: "Calamity flog hierher, um die Aktionen mit dem Verdeckten Zeichen
      zu koordinieren. Und Askari sollte sich zum dem Lager der Bruderschaft auf
      machen, @lp. Stahlhufe hat einen Plan, wie wir unsere Streitkr\xE4fte vereinen
      k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824463
    m_Localized: Das ist gut, aber warum wollen die Zebras in den Krieg? Sie wollten
      nach Norden gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824464
    m_Localized: "Eigentlich habe ich sie \xFCberzeugt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824465
    m_Localized: ??!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824466
    m_Localized: "Die Zebras hier hoffen auf das Beste, aber tats\xE4chlich bedeutet
      in den Norden zu gehen f\xFCr die Meisten von ihnen den fast sicheren Tod.
      Hier zu bleiben und zu k\xE4mpfen, ist mehr oder weniger ihre einzige wirkliche
      Chance zu \xFCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824467
    m_Localized: "Aber sie waren doch immer gegen Gewalt. Was hat sich jetzt ge\xE4ndert?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824468
    m_Localized: "Nichts. Aber wenn es um die Wahl zwischen Krieg und dem sicherem
      Tod geht... Ich bin kein Idiot, @lp. Und die Oberfl\xE4chenponys verdienen
      es viel mehr, als diese gefiederten Militaristen hier zu leben. Die beste Option
      w\xE4re, \xFCberhaupt nicht zu k\xE4mpfen, aber da dies nicht m\xF6glich ist,
      ist es besser, die Ersten zu sein, die zu den Waffen greifen.\nAu\xDFerdem
      hat Calamity bemerkt, dass du auch f\xFCr viele in seinem Lager ein Vorbild
      warst. Vertraue mir, du bist auch hier ein Vorbild."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824469
    m_Localized: "Deine Freundin hat Recht, @lp. Ahh... ich sags doch, wenn es mehr
      Ponys wie sie g\xE4be, w\xE4re das Leben hier im \xD6dland besser."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824470
    m_Localized: "Pass auf, @lp, Ich fliege los, um mich dem Gemeinderat anzuschlie\xDFen.
      Oak hat uns von Stahlhufe erz\xE4hlt, wenn er die Wahrheit sagt, lohnt es sich
      zu h\xF6ren, was er vor hat. Und ich denke, es w\xE4re sch\xF6n, wenn du auch
      dort auftauchst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824471
    m_Localized: "Deine Kampff\xE4higkeiten k\xF6nnten sich als n\xFCtzlich erweisen.
      Mach dir keine Sorgen um uns, @lp, wir haben hier Ponys, die in der Lage sind,
      alles zu organisieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824472
    m_Localized: Velvet, wegen Mentor...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824473
    m_Localized: "Er hat sich geweigert zu helfen, nicht wahr? Und beschlossen sich
      einzuschlie\xDFen und still zu sitzen, in der Hoffnung, dass Stable Pi verschont
      bleibt? Das \xFCberrascht mich nicht, @lp. Er h\xE4tte niemals den Mut, die
      Hilflosen zu verteidigen. Mach dir keine Vorw\xFCrfe deswegen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824474
    m_Localized: "Richtig. Ich glaube ich sollte mich dann Calamity anschlie\xDFen.
      Wenn es irgendetwas gibt, bei dem ich Stahlhufe helfen kann, verspreche ich
      dass ich es tun werde."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824475
    m_Localized: Daran habe ich keinen Zweifel.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824476
    m_Localized: Der Kriegsrat
    m_Metadata:
      m_Items: []
  - m_Id: 2737824477
    m_Localized: "Gr\xFC\xDFe @lp. Ich muss zugeben, du hast es wieder mal geschafft,
      mich zu \xFCberraschen. Dank dir und deinen Freunden habe ich pl\xF6tzlich
      eine ganze Menge neuer Verb\xFCndeter."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824478
    m_Localized: ... genau so wie neue Feinde.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824479
    m_Localized: Calamity sagte, dass du bereits auf den neuesten Stand gebracht
      wurdest. Lasst uns keine Zeit verlieren.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824480
    m_Localized: "In Ordnung. Wie ich eingangs schon sagte, sitzen wir jetzt alle
      im selben Boot, und haben gemeinsame Feinde. Wenn wir gemeinsame Milit\xE4reins\xE4tze
      planen wollen, m\xFCssen wir uns zun\xE4chst mit den aktuellen Bedrohungen
      auseinandersetzen, bevor die Enklave ihren ersten Schritt macht. Wir m\xFCssen
      Fort Rocks angreifen und einnehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824481
    m_Localized: "Ihr k\xF6nntet davon ausgehen, dass ich nur versuche, euch zu benutzen,
      um meine Konkurrenten loszuwerden. Ich schlage jedoch vor, dar\xFCber nachzudenken:
      Die Anh\xE4nger des nun toten Coldsight und der Caesar-Legion f\xFChren einen
      unerbittlichen Krieg gegen meine Ritter und es wird nicht aufh\xF6ren, bis
      einer von uns kapituliert. Wenn wir diesen Krieg jetzt nicht beenden, werden
      meine Gegner die n\xE4chste Gelegenheit nutzen, um uns im ung\xFCnstigsten
      Moment in den R\xFCcken zu fallen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824482
    m_Localized: "Ich sollte auch noch erw\xE4hnen, dass um das Territorium um unsere
      Befestigungen herum st\xE4ndig Aufkl\xE4rer der Legion krauchen. Ich muss leider
      zugeben, dass es durch keine unserer Ma\xDFnahmen gelungen ist, diese Bedrohung
      zu beseitigen. Das bedeutet, dass Caesar, egal welche Entscheidung wir heute
      treffen, \xFCber unseren Kontakt mit euch informiert sein wird. Und ihr alle
      steht auf ihrer Bedrohungsliste."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824483
    m_Localized: "Danke, Schreiberin Amaranth. Die Situation ist jedoch nicht so
      schlimm, wie es scheinen mag. Meine Truppen haben im Moment eine erhebliche
      territoriale und zahlenm\xE4\xDFige \xDCberlegenheit \xFCber den Feind erlangt.
      Genau genommen hat der Feind bereits verloren. Wir m\xFCssen nur die \xDCberreste
      seines Widerstands beseitigen. Das bringt uns zur\xFCck nach Fort Rocks. Gegenw\xE4rtig
      dient diese Vorkriegsfestung als Hauptquartier der Coldsight-Ritter und ist
      die einzige Zitadelle, die sich noch unter ihren Hufen befindet. Hier konzentrieren
      sie ihre Hauptkr\xE4fte sowie eine bedeutende Verst\xE4rkung der Legion. Die
      restlichen Abteilungen sind auf mehrere Milit\xE4rst\xFCtzpunkte und Beobachtungsposten
      verteilt. Der Angriff auf Fort Rocks w\xE4re ein Schlag, der den Feind kampfunf\xE4hig
      machen w\xFCrde."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824484
    m_Localized: "Bei allem Respekt, Star Paladin, Fort Rocks ist eine der m\xE4chtigsten
      Festungen in Equestria in seiner gesamten Geschichte schon. Seine Mauern sind
      uneinnehmbar und seine Artillerie ist \xFCberw\xE4ltigend. Wenn wir einen Angriff
      mit allen uns zur Verf\xFCgung stehenden Kr\xE4ften versuchen, w\xE4re dies
      ein Massaker. Ich nehme an, Sie haben einen anderen Plan?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824485
    m_Localized: "In der Tat ist ein Frontalangriff w\xE4re in keinster Weise akzeptabel.
      Bevor wir die Nachricht von der bevorstehenden Ankunft der Enklave erhielten,
      hoffte ich, diese Festung aushungern zu k\xF6nnen, aber jetzt ist dies aus
      Zeitgr\xFCnden auch keine Option mehr. Daher m\xFCssen wir uns auf einen anderen
      Aktionsplan st\xFCtzen. Um ehrlich zu sein, ist es riskant, aber wir haben
      keine andere M\xF6glichkeit. Bitte, Schreiberin Amaranth."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824486
    m_Localized: "Wir haben einen ziemlich detaillierten Plan der Festung und kennen
      ihre Funktionsweise bis ins Detail. Fort Rocks ist mit den fortschrittlichsten
      Artilleriesystemen ausgestattet, die Equestria vor seinem Untergang entwickelt
      hatte. Das bedeutet, dass alle Antriebs- und Lademechanismen der Gesch\xFCtze
      mit elektrischen Servos betrieben werden. Gleiches gilt f\xFCr die Haupttore.
      Im Falle eines Stromausfalls sind alle Abwehrmechanismen durch leistungsstarken
      Batterien abgesichert, die jedoch nach zweihundert Jahren irreparabel besch\xE4digt
      wurden. Wir haben alle Versuche, sie wieder in Stand zu setzen schon lange
      aufgegeben. Wenn also wir die Anlagen von der direkten Energiequelle trennen,
      funktionieren sie nicht mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824487
    m_Localized: "Einfach ausgedr\xFCckt, wenn die Generatoren ausschaltet werden,
      geht ihren Waffen der Saft aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824488
    m_Localized: "Exakt. Momentan werden alle Systeme von einem einzigen Kraftwerk
      angetrieben. Das Problem ist, dass es sich im Fort befindet. Um es herunterzufahren,
      muss man hineingehen. Wir m\xFCssen uns also auf einen Saboteur verlassen,
      der die Festungsmauern passieren, zum Kraftwerk gelangen und den Strom abschalten
      kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824489
    m_Localized: "Ist das der Haken an der Sache? Also, ich wei\xDF nicht, wie wir
      das anstellen k\xF6nnten. Sch\xE4tze, ich k\xF6nnte versuchen, mit einer kleinen
      Bombe \xFCber die Mauer zu fliegen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824490
    m_Localized: "Das k\xF6nnte zwar funktionieren, aber leider ist das Fort mit
      Luftabwehrkanonen ausgestattet. Der Versuch, das Ziel mit der Bombe zu erreichen,
      w\xFCrde sicherlich scheitern, und mit solch einer Last so weit nach oben zu
      fliegen dass du f\xFCr die Luftabwehr unerreichbar w\xE4rst, w\xE4re viel mehr,
      als jedes Pegasus schaffen k\xF6nnte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824491
    m_Localized: "Wir besitzen auch keine Artillerie, die in der Lage w\xE4re, ein
      Projektil aus gr\xF6\xDFerer Entfernung abzufeuern als die Reichweite ihrer
      Festungskanonen. Deshalb frage ich euch nach Vorschl\xE4gen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824492
    m_Localized: "Vielleicht habe ich eine L\xF6sung.\n\tIn vergangenen Zeiten, noch
      bevor meine Heimat im Krieg gegen die eure verwickelt war, mussten wir uns
      oft Feinden entgegenstellen, die auf ihre Festungen vertrauten. Wir kennen
      einen Weg, sie zu besiegen. Unsere Schamanen haben einen Trank erfunden, der
      eine Kreatur f\xFCr kurze Zeit in eine andere verwandeln kann. Seine Seele
      und sein Geist werden gleich bleiben, aber sein K\xF6rper wird sich ver\xE4ndern.
      Unsere auserw\xE4hlten Krieger verwandelten sich in M\xE4use, V\xF6gel oder
      Insekten, drangen in Festungen ein und nachdem sie zu ihrer normalen Form zur\xFCckgekehrt
      waren \xF6ffneten die Tore von innen. Unsere Alchemistin Zambezi bewahrt nur
      f\xFCr diesen Fall immer eine Portion dieses Tranks auf."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824493
    m_Localized: "Ich glaube nicht, dass wir uns auf ein Schamanengebr\xE4u verlassen
      k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824494
    m_Localized: "Das habe ich geh\xF6rt Schreiberin Amaranth. Chief Askari, gibt
      es irgendwelche Einschr\xE4nkungen oder Schwierigkeiten bei der Verwendung
      dieses Tranks?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824495
    m_Localized: "Ja, die gibt es. Das erste ist die Zeit seiner Einsetzbarkeit.
      Der von den m\xE4chtigsten Schamanen der Vergangenheit zubereitete Trank konnte
      einen Krieger mehrere Tage lang in einer anderen Form halten, aber wir k\xF6nnen
      kaum mit mehr als ein paar Minuten rechnen. Das Zweite ist - ein Krieger in
      der Gestalt eines kleinen Tieres, obwohl weniger auff\xE4llig, wird er gleichzeitig
      sehr schwach und verletzlich sein. Aber dann wird er in der Lage sein, in die
      Festung durch einen Riss, ein Rohr oder sogar ein Rattenloch einzudringen,
      das kein Pony je bewachen w\xFCrde."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824496
    m_Localized: "Hmm... Obwohl mir diese Option nicht wirklich gef\xE4llt, muss
      ich zugeben, dass wir einfach keine andere Wahl haben. Es bleibt zu entscheiden,
      wer unser Saboteur sein wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824497
    m_Localized: "Ich k\xF6nnte das machen. Wenn es uns dabei hilft, zu gewinnen,
      bin ich dabei."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824498
    m_Localized: "Tapfere Worte, @lp. Angesichts deiner F\xE4higkeiten, die du im
      Kampf demonstriert hast, glaube ich, dass du mit dieser Mission betraut werden
      kannst. Wenn du es dir anders \xFCberlegst, werde ich dir das nicht nachtragen.
      F\xFCr viele hier bist du ein guter Bekannter oder sogar ein Freund."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824499
    m_Localized: Ich bleibe dabei, ich werde gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824500
    m_Localized: "Ich k\xF6nnte sp\xE4ter nachziehen, wenn der Auftrag erledigt ist.
      Wenn alle Kanonen elektrisch betrieben werden, betrifft das auch die Flugabwehrkanonen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824501
    m_Localized: "Hat irgendein Pony Einw\xE4nde gegen diesen Plan? Keiner? Alle
      einverstanden?\nDann w\xE4re das entschieden. Wir werden auf den Moment warten,
      in dem die Kanonen schweigen. Unsere Angriffstrupps sollten sofort einsatzbereit
      sein, um dem Feind keine Zeit zu geben, die Lage wieder unter Kontrolle zu
      bringen. Wenn die Kanonen abgeschaltet und die Tore entriegelt sind, wird es
      zu einfach sein. Auf gehts!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824502
    m_Localized: 'Achtung!

      Nachdem du Fort Rocks betreten hast, bekommst du
      bis der Krieg vorbei ist keine Gelegenheit mehr, etwas anderes als die Hauptmission
      zu machen.

      Es wird empfohlen, das Spiel auf einen separaten Speicherplatz
      zu sichern.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824503
    m_Localized: "Hier ist es, das Bedienfeld f\xFCr den Generator. So viele Kn\xF6pfe...
      Hmm, was ist, wenn ich den gro\xDFen roten probiere?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824504
    m_Localized: "Aha, sieht so aus als w\xE4re das der Richtige! Funktioniert immer!
      Mal sehen, wie sie jetzt ohne Strom auskommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824505
    m_Localized: "Es ist wahrscheinlich Zeit zu gehen. Ich sollte keine Zeit verschwenden,
      ihre Verst\xE4rkung wird bald hier sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824506
    m_Localized: "Ah, hier bist du, @lp! Ich habe nach dir gesucht. Komm schon, lass
      uns gehen, hier wirds gleich richtig hei\xDF."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824507
    m_Localized: "Ich habe kein Kanonenfeuer mehr geh\xF6rt. Hat es funktioniert?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824508
    m_Localized: "Da kannst du drauf wetten! Als Stahlhufe bemerkte, dass dein Einsatz
      ein Erfolg war, befahl er sofort anzugreifen. Im Moment st\xFCrmen seine Ritter
      die Tore der Festung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824509
    m_Localized: Ich kann bleiben und ihnen helfen...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824510
    m_Localized: "Du hast schon mehr als jeder andere von uns getan. Die Eisenk\xF6pfe
      schaffen das schon, das ist schlie\xDFlich ihre Aufgabe. Ich denke, es w\xE4re
      besser hier raus zu kommen solange wir noch k\xF6nnen, es sei denn nat\xFCrlich
      du hast andere Pl\xE4ne."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824511
    m_Localized: Der Sieg
    m_Metadata:
      m_Items: []
  - m_Id: 2737824512
    m_Localized: Also... wie ist es gelaufen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824513
    m_Localized: Wir haben gewonnen!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824514
    m_Localized: "Alles verlief nach Plan. Wir marschierten in dem Moment zur Festung,
      in dem die Kanonen schwiegen, erreichten das Tor, bevor der Feind es von Huf
      blockieren konnte. Nachdem wir die Zitadelle erfolgreich betreten hatten, legten
      die meisten Ritter ihre Waffen nieder und nur die Zebras der Legion versuchten
      zu fl\xFCchten. Was sich jedoch als unm\xF6glich herausstellte, da der einzige
      Ausweg unter unserer Kontrolle lag."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824515
    m_Localized: "Yeehaw! So machen wir das im \xD6dland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824516
    m_Localized: Bedeutet das, dass unsere Feinde jetzt kapitulieren werden?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824517
    m_Localized: "Das k\xF6nnen wir noch nicht sicher sagen. Tatsache ist jedoch,
      dass die verbleibenden Streitkr\xE4fte, die Coldsight treu geblieben sind,
      und ihre Verb\xFCndeten sich entschlie\xDFen, den Kampf fortzusetzen, aber
      keine Gelegenheit mehr haben werden, uns ernsthaften Schaden zuzuf\xFCgen.
      Jetzt haben ihre verstreuten und relativ kleinen Gruppen nicht einmal mehr
      ein Kommando. Nun brauchen wir keine Angst mehr davor zu haben, dass sie uns
      beim Krieg mit der Enklave in den R\xFCcken fallen werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824518
    m_Localized: Ah, wir sollten feiern!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824519
    m_Localized: Aber sicher. Meine Soldaten brauchen eine ordentliche Pause.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824520
    m_Localized: Vielleicht stimmen meine Leute zu, euch Gesellschaft zu leisten.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824521
    m_Localized: "Ich wei\xDF, uns stehen schwere Zeiten bevor, aber euer Vorschlag
      macht Sinn. Wir werden Kraft brauchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824522
    m_Localized: Also dann...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824523
    m_Localized: Die Invasion
    m_Metadata:
      m_Items: []
  - m_Id: 2737824524
    m_Localized: "Schlechte Nachrichten, Freunde. Speziell f\xFCr dich, @lp. Die
      Enklave hat mit der Invasion begonnen. Und... ich f\xFCrchte, ihr Hauptziel
      ist Stable Pi."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824525
    m_Localized: Was? Wie... wieso? Warum haben sie?..
    m_Metadata:
      m_Items: []
  - m_Id: 2737824526
    m_Localized: "Ich kann nur raten. Meine Sprite-Bots verzeichneten in mehreren
      Gebieten den Abstieg einer gro\xDFen Anzahl von Soldaten und Pegasi-Fahrzeugen.
      Einer dieser Orte ist der an dem der Haupteingang deines Zuhauses verborgen
      ist.\nSie scheinen zu wissen, wohin sie gehen und was zu tun ist. Sie bereiten
      sich darauf vor, hinein zu brechen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824527
    m_Localized: "Das d\xFCrfen wir nicht zulassen. Wir ziehen sofort alle zusammen
      um!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824528
    m_Localized: Ich kann durch das Terminal zum Stable Pi gehen. Ich sofort dort
      hin!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824529
    m_Localized: "Dann werde ich den anderen den Weg zeigen. Viel Gl\xFCck @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824530
    m_Localized: '@lp? Celestia sei Dank, du bist es! Warte, ich schalte die Barriere
      ab und lasse dich rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824531
    m_Localized: Angriff auf die Enklave
    m_Metadata:
      m_Items: []
  - m_Id: 2737824532
    m_Localized: Schnell, sagt mir was hier passiert ist?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824533
    m_Localized: "Sie haben uns angegriffe, Pegasi in seltsamen R\xFCstungen...\nAlles
      war wie gewohnt, jeder hat sich um seine eigenen Angelegenheiten gek\xFCmmert.
      Pl\xF6tzlich h\xF6rten wir ein Knall und der Boden erzitterte. Der Alarm wurde
      ausgel\xF6st und verstummte kurz darauf. Wir glauben, sie haben die Au\xDFenmauer
      gesprengt und dann irgendwie Zugang zum Stable-T\xFCrmechanismus und zu unserem
      Sicherheitssystem bekommen. Ich verstehe nicht, wie das m\xF6glich ist... Und
      f\xFCnf Minuten sp\xE4ter begann ein echter Albtraum! Sie st\xFCrmen hinein
      und t\xF6ten jeden auf ihren Weg!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824534
    m_Localized: "Gl\xFCcklicherweise war Mentor gleich nach der ersten Explosion
      klar, dass dies ein Angriff von au\xDFen war, und warnte jeden \xFCber die
      Freisprecheinrichtung. Wir hoffen, dass die meisten Bewohner in Werkst\xE4tten
      und in den Laboren Zuflucht gefunden haben. Sie haben ihre eigenen autonomen
      Verteidigungssysteme, Kraftfelder und Panzert\xFCren. Aber wof\xFCr? Es gibt
      keine Vorr\xE4te, kein Essen, keine Waffen. Egal wie lange wir hier festsitzen,
      fr\xFCher oder sp\xE4ter kriegen sie uns."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824535
    m_Localized: Mutterficker Fotzen! Ihr wurdet von der Enklave angegriffen und
      dieser Feind ist einfach nur verdammt stark!|Discord Werk! Ihr wurdet von der
      Enklave angegriffen und dieser Feind ist nur verdammt stark!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824536
    m_Localized: Wo ist Mentor?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824537
    m_Localized: "Er wurde verwundet, @lp... ich f\xFCrchte t\xF6dlich. Wir zogen
      uns hierher zur\xFCck, weil wir in dieser Werkstatt am \"Sun\" Projekt gearbeitet
      haben. Auf dem Weg hier hier stie\xDFen auf eine Gruppe von Feinden und Mentor
      wurde von einem Plasmageschoss getroffen. Ich habe es geschafft, einen Massen-Benommenheitszauber
      zu wirken und w\xE4hrend der Feind wieder zur Besinnung kam zog ich ihn hier
      in den Schutz des Kraftfeldes. Ich f\xFCrchte jedoch, er wird nicht \xFCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824538
    m_Localized: "Warum habt ihr die Alihorn R\xFCstung nicht eingesetzt? Ist sie
      etwa noch nicht fertig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824539
    m_Localized: "Professor Brownie, Transistor und Lime Fizzy arbeiten gerade weiter
      daran. Dort im n\xE4chsten Raum. Du kannst dich selbst davon \xFCberzeugen,
      wenn das noch wichtig sein sollte..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824540
    m_Localized: "Ah, @lp... du bist zur\xFCckgekommen... heilige Celestia... wenn
      ich daran denke, wie dumm das alles war... All die Jahrzehnte der Arbeit, all
      die Geheimhaltung... vergeblich. All unser Wissen, unsere Technologien werden...
      von diesen M\xF6rdern aus den Wolken genommen... Und wir alle werden sterben..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824541
    m_Localized: "Niemals! Das werde ich nicht zulassen! Noch ist nicht alles verloren,
      meine Freunde an der Oberfl\xE4che werden uns helfen, gemeinsam werden wir
      diesen Angriff abwehren! Und was ist mit der Alihorn-R\xFCstung?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824542
    m_Localized: "Wir hatten keine Zeit, sie fertigzustellen, keine Zeit zum Konfigurieren,
      zum Testen... Aber dennoch... wie k\xF6nnte es noch schlimmer kommen? Du hast
      recht... benutze sie. T\xF6te diesen Abschaum... du hast mehr Kampferfahrung
      als jeder Stablebewohner."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824543
    m_Localized: "Danke, f\xFCr dein Vertrauen, Mentor."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824544
    m_Localized: "Vertrauen?.. reiner Pragmatismus... wer k\xF6nnte bessere... ch..
      Chancen haben als du?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824545
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824546
    m_Localized: Es tut so weh... so sehr...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824547
    m_Localized: ......
    m_Metadata:
      m_Items: []
  - m_Id: 2737824548
    m_Localized: Vergib mir.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824549
    m_Localized: "Es wird Zeit die R\xFCstung zu holen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824550
    m_Localized: Was? @lp, du bist hier? Wie konntest du...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824551
    m_Localized: "Keine Zeit zum Reden, der Feind h\xE4mmert buchst\xE4blich an unsere
      T\xFCr und k\xF6nnte bald durchbrechen. Ich habe vor, die Alihorn-R\xFCstung
      gegen sie einzusetzen. Schnell, helft mir sie anzuziehen und erkl\xE4rt mir,
      wie man sie benutzt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824552
    m_Localized: Was meinst du mit "Dir helfen, sie anzuziehen"? Du scheinst nicht
      zu wissen, was du da sagst. Und wo ist Mentor?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824553
    m_Localized: "Mentor ist tot! Sie haben ihn get\xF6tet, und jetzt werdet ihr
      tun was ich sage, wenn ihr \xFCberleben und den Stable retten wollt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824554
    m_Localized: Er ist tot?! Was sollen wir jetzt machen...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824555
    m_Localized: "Aber wir haben sie noch nicht einmal getestet! Es k\xF6nnte sowohl
      f\xFCr dich, als auch f\xFCr jedes Pony in deiner Umgebung gef\xE4hrlich werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824556
    m_Localized: "Dann werde ich sie gleich im Kampf testen! Kommt schon! Keine Zeit
      dar\xFCber zu diskutieren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824557
    m_Localized: "Also gut, @lp... sie... sie sollte funktionieren. Hoffe ich. Wenn
      das der Fall ist, hat der Feind keine Chance gegen dich.\nLeute, lasst uns
      das Integrationsprotokoll ausf\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824558
    m_Localized: "\xC4hmm.... was Protokoll?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824559
    m_Localized: "Die neuronale Schnittstelle der \"Alihorn-R\xFCstung\" sollte mit
      deinem Nervensystem verschmelzen. Es k\xF6nnte... ein wenig schmerzhaft werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824560
    m_Localized: "Integration erfolgreich abgeschlossen. Kompatibilit\xE4t mit dem
      Gehirn des Benutzers \xFCberdurchschnittlich gut."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824561
    m_Localized: "Alle Systeme melden normalen Zustand. Leistungskapazit\xE4t...
      ufff... gesch\xE4tzt bei 19 Prozent, aber steigt weiter an..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824562
    m_Localized: "Wie f\xFChlst du dich @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824563
    m_Localized: "F\xFChlt sich sehr befremdlich an. Ich f\xFChle \xFCberhaupt keine
      Panzerung, als ob sie ein Teil von mir w\xE4re... und doch, f\xFChle ich...
      St\xE4rke..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824564
    m_Localized: "Das ist normal, dein Gehirn ist jetzt euphorisch, aber lass dich
      davon nicht t\xE4uschen. Denke daran, die Alihorn R\xFCstung ist stark, aber
      sie macht dich nicht unverwundbar."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824565
    m_Localized: "Leistungskapazit\xE4t jetzt gesch\xE4tzt bei 24 Prozent, und stagniert.
      Wir m\xFCssen die Eingabeparameter \xFCberarbeiten und anpassen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824566
    m_Localized: "Das w\xFCrde Stunden dauern!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824567
    m_Localized: "Daf\xFCr haben wir jetzt keine Zeit! Ich werde mit dem auskommen,
      was wir haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824568
    m_Localized: "Hier sind Daten der Sicherheitssensoren. Der Feind konzentriert
      seine Kr\xE4fte am Haupteingang. Sie bereiten einen neuen Angriffstrupp vor!
      Benutze den Evakuierungstunnel dort links - er f\xFChrt er dich fast bis zum
      Eingang."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824569
    m_Localized: Bleib wachsam. Und geh nicht zu weit.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824570
    m_Localized: "Wir werden f\xFCr dich zu Celestia beten. Du bist unsere letzte
      Hoffnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824571
    m_Localized: "\"Alihorn R\xFCstung\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824572
    m_Localized: "Die \"Alihorn R\xFCstung\" ist eine beeindruckende Verschmelzung
      von Magie und Technik, die im Stable Pi entwickelt wurde. Sie bietet ihrem
      Tr\xE4ger ausgezeichneten Schutz, Flugf\xE4higkeit, verst\xE4rkt seine Waffen
      und magischen F\xE4higkeiten und stellt automatisch die Gesundheit wieder her.\nDie
      F\xE4higkeiten des Tr\xE4gers wirken sich auf die R\xFCstungseffizienz aus
      und verleihen ihm neue Eigenschaften (siehe Registerkarte \"Fertigkeiten\"
      in deinem PipBuck).\nDie R\xFCstung wird mit mehreren Spezialwaffen geliefert,
      f\xFCr die keine Munition erforderlich ist (siehe Registerkarte \"Waffen\"
      in deinem PipBuck).\nVerbesserungen und F\xE4higkeiten:\n- F\xE4higkeit zu
      fliegen und im Flug zu beschleunigen.\n- Verbesserte Gesundheits- und Verteidigungsmerkmale.\n-
      Magische Verbesserung aller Art bei Waffen und Kampfmagie.\n- Alle Waffen sind
      vor Besch\xE4digung und vor Verschlei\xDF gesch\xFCtzt.\n- Eingebauter Kampfzauber,
      Teleport und Schildzauber.\n- Immunit\xE4t gegen Verletzungen, Regeneration
      der Gesundheit und magischer Energie.\nUnm\xF6glich:\n- Verwendung von Chemie,
      Zaubertr\xE4nken und Lebensmitteln.\n- Verwendung anderer Schutzzauber mit
      Ausnahme des eingebauten Schildzaubers.\n- Benutzung der M.A.S. Terminals"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824573
    m_Localized: "@lp? Was tr\xE4gst du denn da?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824574
    m_Localized: "Hallo, Stahlhufe. Dies ist das Ergebnis des Projekts meines Stables,
      an dem Coldsight so interessiert war. Ich bin \xFCberrascht, dass ihr mich
      darin erkannt habt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824575
    m_Localized: "Mein Lokalisator hat dich als verb\xFCndetes Ziel identifiziert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824576
    m_Localized: Achso. Scheint so als ob ihr euch hier ganz gut haltet.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824577
    m_Localized: "Amateure. Der Feind hat eine erhebliche zahlenm\xE4\xDFige \xDCberlegenheit
      und eine hervorragende Ausr\xFCstung, aber seine Befehlshaber wurden nach der
      ersten Begegnung mit einem ausgebildeten Feind nerv\xF6s und konnten die Interaktionen
      ihrer Gruppen  mehr richtig koordinieren. Bisher liegt der taktischer Vorteil
      auf unserer Seite. Ich werde daf\xFCr sorgen, dass es so bleibt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824578
    m_Localized: Askari? Du bist auch hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824579
    m_Localized: Wir haben dir unseren helfenden Huf bei Fort Rock geliehen. Auch
      hier helfen wir dir wieder. Die Zeit des Versteckens ist vorbei.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824580
    m_Localized: All diese Leichen, ist das euer Werk?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824581
    m_Localized: "Sie wussten garnicht, was sie getroffen hat. Keine Sorge @lp, wir
      k\xFCmmern uns um diese fliegenden Ratten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824582
    m_Localized: Thunderhead
    m_Metadata:
      m_Items: []
  - m_Id: 2737824583
    m_Localized: Und @lp, erinnert dich das nicht an irgendetwas?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824584
    m_Localized: "Aber sicher! Unser erstes Treffen. Nur bin ich nicht mehr das Pony,
      das ich vorher war. Und die Eins\xE4tze sind jetzt auch viel h\xF6her."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824585
    m_Localized: "Du hast dich \xFCbrigens auch ver\xE4ndert. Woher hast du die Enklave
      R\xFCstung?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824586
    m_Localized: "Ich nahm sie als Andenken mit, als ich mich von ihrer Armee zur\xFCckgezogen
      habe. Jetzt ist sie ganz praktisch. Warst du in deinem Stable? Wie geht es
      ihnen dort unten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824587
    m_Localized: "Enklave Truppen sind eingedrungen, aber es scheint, als h\xE4tten
      wir die meisten von ihnen erledigt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824588
    m_Localized: "Oh... tut mir leid dich zu entt\xE4uschen, aber es gibt da noch
      ein kleines Problem... eigentlich ein gro\xDFes. Ein ziemlich gro\xDFes."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824589
    m_Localized: Zeig mir wo der Feind ist. Ich habe etwas mit ihm zu besprechen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824590
    m_Localized: "Das wird nicht einfach werden. Ich f\xFCrchte, die Enklave hat
      die [Thunderhead] gegen uns geschickt. Wir sehen sie wegen der Wolken nicht,
      aber meine R\xFCstung hat dasselbe Kommunikationssystem wie sie verbaut, und
      ich h\xF6re alle ihre Gespr\xE4che."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824591
    m_Localized: Bei dem Namen klingelts bei mir nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824592
    m_Localized: "Das ist eine riesige Flugfestung. Mit ein paar Waffen, einem Landungstrupp
      und einem Schutzschild. Bisher haben wir nur gegen den Landetrupp gek\xE4mpft,
      weil sie deinen Stable erobern wollten, anstatt ihn zu bombardieren. Deshalb
      ist die Thunderhead selbst noch nicht aufgetaucht. Aber solange sie da drau\xDFen
      am Himmel ist, werden wir nicht gewinnen. Sie k\xF6nnte noch mehr Truppen absetzen,
      diesen Ort einebenen oder uns direkt bombardieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824593
    m_Localized: "Wir k\xF6nnen so einen Feind auf keinen Fall besiegen, @lp. Wenn
      wir eine ganze Flugabwehrbatterie oder auch ein paar Drachen h\xE4tten..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824594
    m_Localized: "Wir k\xF6nnen nicht einfach aufgeben! Ich trage diese R\xFCstung...
      sie macht mich viel st\xE4rker als du dir vorstellen kannst. Und jetzt habe
      ich Fl\xFCgel, ich kann versuchen, die Thunderhead in der Luft zu zerst\xF6ren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824595
    m_Localized: "Das w\xE4re Selbstmord, @lp. Obwohl... Du bist ein zu kleines Ziel,
      als dass die Thunderhead Gesch\xFCtze dich treffen k\xF6nnten. Ich sch\xE4tze,
      wenn du die ganze Zeit in Bewegung bleibst, k\xF6nntest du es vermeiden, getroffen
      zu werden und wenn du es schaffst, ihrern Schild zu \xFCberwinden... Dann k\xF6nntest
      du durch die Luke des Landes in das Innere gelangen und den Reaktor zerst\xF6ren.
      Das w\xFCrde sie nicht \xFCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824596
    m_Localized: "Schild \xFCberwinden, ins Innere gelangen und den Reaktor zerst\xF6ren.
      Und mich nicht von den Gesch\xFCtzen in die Luft zerrei\xDFen lassen. Habs
      kapiert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824597
    m_Localized: Und dann bringe dein Heu ganz schnell da raus. Es wird so explodieren,
      das solltest du nicht vergessen. Also gut, wenn du dir da so sicher bist, werde
      ich dir den Weg zeigen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824598
    m_Localized: Wir werden diese Stellung halten!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824599
    m_Localized: Der Feind darf hier nicht durchkommen!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824600
    m_Localized: Welche Richtung?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824601
    m_Localized: "Siehst du diese gro\xDFe blitzende Wolke? Da musst du hin. Die
      Thunderhead Pegasi werden nicht gleich auf dich reagieren, etwas dergleichen
      erwarten sie nicht. Vermutlich nicht... Kurz gesagt, sei schnell und wenn du
      es schaffst, nah genug heran zu kommen, um zu schie\xDFen dann schie\xDFe bevor
      sie das Feuer er\xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824602
    m_Localized: "Und, @lp. Versuche zu \xFCberleben, ja? Du hast zu viel durchgemacht,
      um jetzt so zu enden..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824603
    m_Localized: "Diese R\xFCstung l\xE4sst mich nicht sterben, Calamity. Jetzt k\xF6nnte
      ich sogar eine ganze Stadt zerst\xF6ren. Mach dir keine Sorgen um mich."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824604
    m_Localized: Die Thunderhead kann das auch. Sei vorsichtig.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824605
    m_Localized: Mache dir keine Sorgen. Ich werde vorsichtig sein.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824606
    m_Localized: Die Schilde sind aus! Jetzt muss ich da rein!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824607
    m_Localized: Und jetzt sollte ich mein Heu schleunigst hier raus schaffen!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824608
    m_Localized: Waa... Was war das? Was zum Heuhaufen? Ich falle?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824609
    m_Localized: "Ich wurde von der Explosion erfasst! Und... kann die R\xFCstung
      nicht l\xE4nger steuern! Ist sie kaputt gegangen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824610
    m_Localized: "Nein-Nein-Nein-Nein!!! flattert, ihr verdammten Fl\xFCgel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824611
    m_Localized: Sinnlos...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824612
    m_Localized: Was soll ich machen?!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824613
    m_Localized: Ah! Telekinese! Selbst-Levitation! Den Fall verlangsamen!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824614
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824615
    m_Localized: Ich kann nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824616
    m_Localized: Keine Kraft mehr...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824617
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824618
    m_Localized: Ist das jetzt das Ende?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824619
    m_Localized: Ich falle einfach aus den Wolken?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824620
    m_Localized: Wie Lahm...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824621
    m_Localized: Erwischt!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824622
    m_Localized: Calamity!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824623
    m_Localized: Eyep!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824624
    m_Localized: Das war eine gewaltige Explosion! Yeeeee-haw!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824625
    m_Localized: Autsch!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824626
    m_Localized: Mach das nie wieder, ja? Bring mich einfach auf den Boden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824627
    m_Localized: Alles klar, @lp! Was immer du sagst.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824628
    m_Localized: "Wie siehts an der Oberfl\xE4che aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824629
    m_Localized: "Ich wei\xDF nicht genau. Aber sieh selbst! Die Enklave greift nicht
      mehr an!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824630
    m_Localized: Was machen sie dann?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824631
    m_Localized: "Ich verstehe es noch nicht! Aber es scheint als ob sie sich zur\xFCckziehen!
      Ich w\xFCrde das auch tun, wenn unsere Thunderhead in die Luft gesprengt worden
      w\xE4re!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824632
    m_Localized: Dann lass uns zu unseren Freunden eilen! Was auch immer passieren
      wird, wir sollten dort sein.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824633
    m_Localized: "Nein @lp, Tut mir leid, aber ich glaube, du bist im Moment kein
      guter K\xE4mpfer. Au\xDFerdem hast du deinen Teil beigetragen. Sie k\xF6nnen
      den Kampf auch ohne dich beenden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824634
    m_Localized: Und letztlich...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824635
    m_Localized: "Es scheint, als w\xE4re jedes Pony hier, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824636
    m_Localized: Heilige Celestia. Wieviele Ponys gestorben sind.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824637
    m_Localized: "Ponys, Zebras. Erdponys, Einh\xF6rner... Pegasi."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824638
    m_Localized: Und das ist noch nicht das Ende.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824639
    m_Localized: "Aber zumindest machen wir eine Pause. Ihr Flaggschiff zu verlieren
      und die meisten der begleitenden Streikkr\xE4fte machen den Feind benommen.
      Und das in einem solchen Ausma\xDF, dass sie nach unseren Berichten ihre Milit\xE4reins\xE4tze
      in anderen Regionen abgebrochen haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824640
    m_Localized: "Eyep. Wir haben solche Verluste nicht... wie sie. Solche Verluste
      hatten sie seit... Naja, noch niemals, nehme ich an. Wir haben nat\xFCrlich
      noch nicht gewonnen. Aber jetzt werden sie dort oben in den Wolken einen gewaltigen
      Tumult haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824641
    m_Localized: "Wir sind hier, um den Mentor von @lp und Velvet zu ehren. Ich denke,
      wir sollte die Besprechung unserer weiteren Strategie auf sp\xE4ter verschieben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824642
    m_Localized: "Ein Mentor, ein Kollege. F\xFCr manche ein Freund. Wir alle haben
      Freunde und Ponys verloren, die wir kennen. Jetzt ist die Zeit, einen von ihnen
      zu ehren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824643
    m_Localized: "*Hier liegt\nSILVER MANE\nEin Pony, das die Vergangenheit zur\xFCckbringen
      wollte*"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824644
    m_Localized: Celestia erbarme sich deiner Seele.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824645
    m_Localized: "Er war nicht allein in seinen Bestrebungen. Viele Ponys, die ich
      kannte, w\xFCnschten sich dasselbe."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824646
    m_Localized: "Aber nicht jeder wusste, dass dies unm\xF6glich war."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824647
    m_Localized: Die Vergangenheit... Die Vergangenheit ging mit ihm zugrunde.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824648
    m_Localized: "Nein. Wir alle stehen auf dem Fundament der Vergangenheit. Es definiert
      uns und macht uns zu dem, was wir sind. Und es brachte uns schlie\xDFlich alle
      hierher."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824649
    m_Localized: "Ich frage mich... w\xE4ren die Dinge anders gelaufen? Wenn Mentor
      uns nicht an die Oberfl\xE4che geschickt h\xE4tte, wenn ich keine Artefakte
      gefunden h\xE4tte. Oder wenn... nicht f\xFCr die Ereignisse an der Enklave
      Basis gesorgt h\xE4tte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824650
    m_Localized: "Wer wei\xDF. Ich w\xFCrde sagen, dass es anders h\xE4tte sein k\xF6nnen.
      Aber nicht viel anders. All das w\xE4re fr\xFCher oder sp\xE4ter passiert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824651
    m_Localized: "Vielleicht. Stable Pi konnte nicht f\xFCr immer versiegelt bleiben.
      Fr\xFCher oder sp\xE4ter musste das passiere, so oder so."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824652
    m_Localized: "Aber es gibt etwas, das sonst niemals passiert w\xE4re. Wir h\xE4tten
      niemals Ponys treffen k\xF6nnen, die bereit w\xE4ren, den Schrecken des \xD6dlands
      zu trotzen und sich nicht verschlingen zu lassen. Ponys, die sich weigern,
      die Ordnung der Dinge in dieser Welt anzunehmen wie sie ist. Und das hat uns
      die Hoffnung auf eine bessere Zukunft gegeben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824653
    m_Localized: Das ist wahr. Diese Welt ist schon lange in Verzweiflung und Elend
      versunken. Aber solange es Ponys gibt, die an eine bessere Welt glauben, bleibt
      die Hoffnung bestehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824654
    m_Localized: "Und doch... Krieg ver\xE4ndert die Dinge nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824655
    m_Localized: "Aber Ponys... Ponys k\xF6nnen das."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824656
    m_Localized: "Hey, @lp. Ich wei\xDF, das ist vielleicht nicht der beste Zeitpunkt,
      aber du hast die Thunderhead wirklich gro\xDFartig in St\xFCcke gerissen! Diese
      R\xFCstung.. ist sie das Projekt, f\xFCr welches du hierher geschickt wurdest?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824657
    m_Localized: "Ja, obwohl ich mich nicht daran erinnern konnte. Ich denke, der
      Mentor hatte andere Pl\xE4ne, als dieses Exoskelett im Krieg gegen Enklave
      einzusetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824658
    m_Localized: Nun ja. Aber sie kann uns sehr helfen. Ich meine.. sie hat uns sehr
      geholfen. Funktioniert sie noch?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824659
    m_Localized: Ich glaube nicht, dass sie jemals wieder so gut funktionieren wird
      wie vorher. Aber immerhin kann ich damit noch fliegen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824660
    m_Localized: "Auch nicht schlecht. H\xF6r zu, erinnerst du dich, wie ich dir
      vorgeschlagen habe, Wurzeln in unserem guten alten T\xE4nzelnden Pony zu schlagen?
      Wenn du es dir nicht anders \xFCberlegst, liegt das Angebot immer noch auf
      dem Tisch."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824661
    m_Localized: "Ich wei\xDF es noch nicht. Aber danke. Zumindest werde ich auf
      jeden Fall von Zeit zu Zeit dort vorbeischauen. Besonders nachdem wir die Enklave
      besiegt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824662
    m_Localized: "Wei\xDFt du was? Ich werde dir nicht alles im Detail erkl\xE4ren,
      aber vielleicht wird es f\xFCr einige Zeit keinen Krieg geben. Wir haben eine
      komplexe Gesellschaft \xFCber den Wolken, und die Enklave ist dort alles andere
      als allm\xE4chtig. Vielleicht wird sie nach einem solchen Verlust sogar aufgel\xF6st.
      Vielleicht aber auch nicht. Aber jetzt haben sie noch mehr Probleme als nur
      uns."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824663
    m_Localized: Das sind gute Nachrichten. Danke, Calamity
    m_Metadata:
      m_Items: []
  - m_Id: 2737824664
    m_Localized: Nun, es ist immer noch ungewiss. Wir werden sehen, ob ich richtig
      liege. Wenn sich alles beruhigt hat, besuche uns und, wir fliegen zusammen.
      Es ist lange her, dass ich mit einem meiner Freunde geflogen bin.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824665
    m_Localized: Aber sicher.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824666
    m_Localized: "Wei\xDFt du, tief in meinem Herzen wusste ich immer, wie es enden
      w\xFCrde. Vielleicht habe ich den Stable verlassen, weil ich das verhindern
      wollte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824667
    m_Localized: Und doch ist es eigentlich meine Schuld.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824668
    m_Localized: "Ja, es ist auch deine Schuld.\nAber die Schuld liegt auch bei mir.
      Schlie\xDFlich war ich es, die den Mentor aufgrund meiner Ablehnung gezwungen
      hat, einen neuen Auserw\xE4hlten an die Oberfl\xE4che zu schicken. Wenn ich
      nicht gewesen w\xE4re, w\xE4rst du zu Hause geblieben. Und wer wei\xDF, was
      passiert w\xE4re, wenn ich meine Mission erf\xFCllt h\xE4tte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824669
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824670
    m_Localized: "Wenn du in die Vergangenheit reisen zur\xFCckkehren k\xF6nntest,
      bis zu dem Tag, an dem du dich freiwillig gemeldet hast, w\xFCrdest du dich
      wieder bereit erkl\xE4ren an die Oberfl\xE4ch zu gehen wenn du w\xFCsstest
      was dich hier erwartet?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824671
    m_Localized: "Nat\xFCrlich. Nach all dem, was ich an der Oberfl\xE4che gesehen
      habe, wurde mein Wunsch, zumindest ein bisschen hier in Ordnung zu bringen,
      nur noch gr\xF6\xDFer. Es wird ein langer Weg werden, @lp, ein sehr langer
      Weg. Aber wenn ich nicht glauben w\xFCrde, dass wir mit diesen Ponys den Frieden
      zur\xFCckbringen k\xF6nnen, w\xFCsste ich \xFCberhaupt nicht, woran ich glauben
      sollte."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824672
    m_Localized: "Ich werde nun den Stableponys helfen. Es wird ihnen jetzt sehr
      schwer fallen, eine v\xF6llig neue Welt zu entdecken und so viele Ponys zu
      verlieren. Aber wenn sich die Dinge wieder normalisieren, kehre ich zu den
      Zebras zur\xFCck. Sie brauchen mich. Und was wirst du machen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824673
    m_Localized: "ich habe keine Wahl. Ich bin Equestria eine Menge schuldig. Wir
      haben dar\xFCber gesprochen, erinnerst du dich? Jetzt, da ich diesen Ort mit
      eigenen Augen gesehen habe, kann ich die Ponys hier nicht mehr aufgeben. Genau
      wie du."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824674
    m_Localized: "Es gibt vieles, was du mir nie \xFCber dich erz\xE4hlt hast. Vielleicht
      ist die Zeit daf\xFCr gekommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824675
    m_Localized: Ich glaube nicht dass das wichtig ist.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824676
    m_Localized: Immer noch nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824677
    m_Localized: "...\n\tWie ich bereits sagte, stehe ich schon sehr lange mit deinem
      Stable in Kontakt. Wei\xDFt du... heute, fast zweihundert Jahre nach dem Krieg,
      ist das Leben im \xD6dland \xFCberhaupt kein Picknick, aber in den ersten Jahrzehnten
      war es absolut furchtbar. Irgendwann dachte ich, dass ich das letzte intelligente
      Wesen sein w\xFCrde. Deshalb habe ich versucht, Zivilisationsinseln wie dein
      Zuhause zu finden und sie zu besch\xFCtzen. Ich half ihnen, sprach mit ihnen
      dar\xFCber, was um sie herum geschah und warnte vor Gefahren. Ich hatte gehofft,
      dass es nicht so werden w\xFCrde, wenn Stable Pi seine T\xFCren \xF6ffnen w\xFCrde."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824678
    m_Localized: "Warum hast du uns nicht \xFCberredet, uns der Welt zu \xF6ffnen?
      Unsere Hilfe h\xE4tte hier so vielen Ponys das Leben retten k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824679
    m_Localized: "Viele Ponys h\xE4tten euren Tod gewollt. Glaub mir @lp, Ich habe
      oft gesehen wie Stable entriegelt wurden, nur um zerst\xF6rt oder versklavt
      zu werden. Ich wollte nicht, dass euch auch so ein Schicksal widerf\xE4hrt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824680
    m_Localized: "Was hast du dir davon erhofft? Hast du gedacht dass es sp\xE4ter
      besser wird?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824681
    m_Localized: "Ich h\xE4tte nicht gedacht, dass es besser wird. Ich habe nur gehofft.
      Und versucht, die richtigen Ponys zu finden.\nDenke daran, ich habe vor dem
      Krieg gelebt und kannte viele... erstaunliche Ponys. Es ist jetzt schwer zu
      glauben, aber @lp, es gibt Ponys, die k\xF6nnen die Welt ver\xE4ndern. Selbst
      jetzt, in unseren schweren Zeiten, besteht es die Hoffnung, dass sie fr\xFCher
      oder sp\xE4ter auftauchen werden und hier alles auf den Kopf stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824682
    m_Localized: "Aber von solchen Ponys gibt es nur eines unter Millionen und sie
      sind extrem schwer zu finden. Es gibt jedoch immer noch welche, die diese Welt
      zum Besseren ver\xE4ndern. Askari hat das Richtige \xFCber dich gesagt. Du
      und Velvet - du akzeptierst diese Welt nicht wie sie ist. Ihr wollet sie \xE4ndern,
      ihr wollt denjenigen helfen, die am Rande des \xDCberlebens stehen und sich
      jeden Tag mit neuen Gefahren auseinandersetzen m\xFCssen. Und du bist erfolgreich
      damit."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824683
    m_Localized: "Das sind sehr nett gemeinte Worte. Aber immerhin war es mein Eindringen
      in die Enklave Basis, die einen Krieg ausgel\xF6st hat, und wo bereits Hunderte
      gestorben sind. Wenn ich die Welt ver\xE4ndert habe, war das \xFCberhaupt nicht
      gut."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824684
    m_Localized: "So kommt es dir vielleicht vor. Du hast es wahrscheinlich nicht
      bemerkt, aber deine und Velvets Taten brachten den Oberfl\xE4chenponys Hoffnung.
      In ihrem Leben sahen sie zu viel \xDCbel, Grausamkeit und Gleichg\xFCltigkeit.
      Viele begannen zu vergessen, dass es anders sein k\xF6nnte. Mit eurer Selbstlosigkeit
      und Engagement habt ihr sie daran erinnert, dass es m\xF6glich ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824685
    m_Localized: "Jede Geschichte sollte eine Moral haben, oder? Vielleicht w\xE4re
      das die Moral f\xFCr Stable Pi gewesen: \"Der Weg nach Tartarus ist mit guten
      Absichten gepflastert.\" Es ist bedauerlich, dass alles so enden musste. Aber
      was dich betrifft... deine Geschichte ist noch nicht am Ende. Und ich glaube,
      ich sollte dir helfen, sie zu schreiben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824686
    m_Localized: "Dann solltest du mir wohl zun\xE4chst deine Geschichte genauer
      erl\xE4utern."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824687
    m_Localized: "H\xF6rt sich fair an. Ja, ich glaube, ich werde dir zu gegebener
      Zeit meine Geschichte erz\xE4hlen. Oder noch besser - ich werde dich zu mir
      nach Hause einladen, wenn dieser Krieg vorbei ist. Sind wir uns einig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824688
    m_Localized: Einverstanden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824689
    m_Localized: "Denke nur mal dar\xFCber nach. Ich habe so viel Zeit hier an der
      Oberfl\xE4che verbracht. Aber erst jetzt nach allem, was passiert ist, sehe
      ich einen so sch\xF6nen Himmel."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824690
    m_Localized: "Die Pegasi-Streitkr\xE4fte waren gezwungen, sich nach dem Verlust
      ihrer Thunderhead so hastig und unorganisiert nach oben zur\xFCckgezogen dass
      sie die Integrit\xE4t ihrer Wolken-Barriere verletzt haben. Leider wird das
      wohl nicht lange anhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824691
    m_Localized: Mir wurde gesagt, dass du schon seit zweihundert Jahren lebst. Ist
      das wahr?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824692
    m_Localized: "Ja, das ist wahr. Es ist einfach so passiert, dass ich ein Ghul
      wurde. Ein Canterlot-Ghul, um genau zu sein. Ich hatte das Gl\xFCck, meine
      geistige Gesundheit behalten zu d\xFCrfen, und das Pech, diese Welt in den
      Abgrund des Wahnsinns und der Verw\xFCstung gleiten zu sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824693
    m_Localized: Also hast du Equestria gesehen wie es vor dem Krieg war?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824694
    m_Localized: "Ja. Und ich wei\xDF was du jetzt denkst @lp. Und du hast Recht,
      der Himmel ist jetzt genao so wie er damals war.\nSch\xF6ne zeiten..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824695
    m_Localized: "Gibt es eine Chance... K\xF6nnen wir die Vergangenheit jemals wieder
      zur\xFCckholen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824696
    m_Localized: "Ich wei\xDF es nicht. Ich habe es im Laufe der Jahre so viele Male
      gehofft und falsche Versprechungen gegeben. Aber solange es Ponys gibt, die
      Equestria zur\xFCckbringen wollen, wie es vorher war, haben wir immer noch
      eine Chance. Vielleicht nicht wir, aber m\xF6glicherweise werden unsere Nachkommen
      in der Lage sein, unter einem so klaren und sch\xF6nen Himmel zu leben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824697
    m_Localized: "Was sind deine Zukunftspl\xE4ne?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824698
    m_Localized: "Der Krieg mit den Pegasi ist noch nicht vorbei. Aber zumindest
      k\xF6nnen wir jetzt ohne Angst vor den Henkern der Legion leben. Dank deiner
      Hilfe m\xFCssen wir uns nicht mehr verstecken. Meine Siedlung wird das niemals
      vergessen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824699
    m_Localized: "Es tut mir leid, was mit deinem Zuhause passiert ist. Der Feind
      ist t\xFCckisch und skrupellos. Aber viele Ponys haben \xFCberlebt. Wirst du
      jetzt bei ihnen bleiben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824700
    m_Localized: "Zumindest in der ersten Zeit helfe ich ihnen, sich zu verteidigen.
      Und was als n\xE4chstes passiert sehen wir dann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824701
    m_Localized: Du darfst niemals deine Wurzeln vergessen, @lp. Es gibt nichts Schwierigeres
      als mit seiner Heimat zu brechen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824702
    m_Localized: "Du wei\xDFt alles dar\xFCber, nicht wahr?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824703
    m_Localized: Das tue ich. Aber jetzt ist mein Zuhause das Verdecke Zeichen, meine
      Wurzeln sind die Zebras, die darin leben. Und Ponys.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824704
    m_Localized: "Ich w\xFCnsche deinem Zuhause Wohlstand f\xFCr die Zukunft."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824705
    m_Localized: "Wir m\xFCssen weiterleben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824706
    m_Localized: "Ich wei\xDF meine @lp. Denke nur mal daran: Du und ich haben so
      viele Jahre zusammengearbeitet, und jetzt... Ein totales Fiasko, hey?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824707
    m_Localized: Wir leben und sind hier. In unserer Situation ist das bereits ein
      Erfolg.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824708
    m_Localized: "Aber zu so einem Preis, zu einem so hohen Preis... Und wir haben
      keine Alicorn-R\xFCstung mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824709
    m_Localized: "K\xF6nnen wir sie irgendwie reparieren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824710
    m_Localized: "Nein... Ein so hastiger Start bei so geringer Leistung hat sich
      als fatal f\xFCr sie erwiesen. Der Quanten-Kogitator hat den Schaden nicht
      verkraftet, und das Alihorn-Amulett verlor anscheinend vollst\xE4ndig seine
      Kraft. Nur das Exoskelett ist noch intakt, jedoch nur noch ein blasses Abbild
      dessen was sie einmal war! Seit zweihundert Jahren haben wir alle so hart daran
      gearbeitet, das Projekt abzuschlie\xDFen, und jetzt sind wir hier, auf den
      Gr\xE4bern unserer Kameraden, f\xFCr die wir gescheitert sind. Alle unsere
      Arbeit war vergebens."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824711
    m_Localized: "Rei\xDFen sie sich zusammen, Professor. Wenn wir das hier nicht
      getan h\xE4tten, w\xE4ren wir alle umgekommen. Es f\xE4llt mir schwer das zu
      sagen aber, so wird man willensstark. Viele von uns tragen die Last der Schuld,
      und f\xFCr einige wiegt sie sehr schwer. Aber wir m\xFCssen weitermachen. Stabiler
      Pi muss \xFCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824712
    m_Localized: "... Ja. ja, du hast sicher Recht.\nWir haben viel zu tun. Diese
      Invasoren haben nicht nur viele Ponys get\xF6tet, sondern auch den Stable schwer
      besch\xE4digt. Wir m\xFCssen uns davon erholen und vor allem m\xFCssen wir
      einen Weg finden, um uns in Zukunft zu sch\xFCtzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824713
    m_Localized: Ein neues Projekt?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824714
    m_Localized: "Ein neues Projekt? Ich glaube ich nicht. Das w\xE4re wohl kaum...
      Wir m\xFCssen uns etwas anderes einfallen lassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824715
    m_Localized: "Was ist mit dem Schwarzen Buch? Ich k\xF6nnte es bei ihnen lassen,
      vielleicht k\xF6nnen sie eine Verwendung daf\xFCr finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824716
    m_Localized: "Oh, nein-nein-nein, lieber nicht. W\xE4hrend ich mit diesem Ding
      gearbeitet habe, schien ich zu halluzinieren. Wirf es lieber weg - Die Zebras
      hatten vor solcher Hexerei nicht ohne Grund Angst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824717
    m_Localized: "Vielleicht sollten wir unsere neuen Verb\xFCndeten um Hilfe bitten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824718
    m_Localized: "Vielleicht. Aber das kann ich nicht entscheiden. Wir werden jetzt
      erstmal gar nichts entscheiden, zuerst m\xFCssen wir denen gedenken, die nicht
      mehr bei uns sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824719
    m_Localized: Richtig.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824720
    m_Localized: "Was denkst du, wie hat es die Enklave geschafft, Stable Pi so leicht
      zu finden und die Au\xDFent\xFCr so m\xFChelos zu \xF6ffnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824721
    m_Localized: "Wei\xDFt du, das besch\xE4ftigt mich schon seit dem Tag des Angriffs.
      Nat\xFCrlich hatte ich seit dem nicht viel Zeit, aber ich habe dennoch ein
      bisschen in den Archiven gew\xFChlt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824722
    m_Localized: Und, was hast du herausgefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824723
    m_Localized: "Es stellte sich heraus, dass wir die ganze Zeit \xFCber sehr naiv
      waren und glaubten, dass den Standort des Stable niemand sonst kannte. Denke
      mal dar\xFCber nach, wie viel Aufwand erforderlich ist, und wie viele Arbeiter
      beteiligt waren, wie viel Ausr\xFCstung, Vorr\xE4te ... und all diese Dinge
      wurden irgendwo dokumentiert, und zu viele wussten dar\xFCber Bescheid. Nat\xFCrlich
      sind all diese Informationen angesichts der Verw\xFCstungen, die sich jetzt
      an der Oberfl\xE4che ereignen, l\xE4ngst verloren gegangen und vergessen. Aber
      die Enklave ist ganz was anderes. Nach dem, was ich \xFCber sie wei\xDF, m\xFCssen
      sie \xFCber viele Vorkriegsdatenbanken verf\xFCgen. Alles, was sie tun mussten,
      um den Standort f\xFCr den Stable heraus zu finden, war nur die richtigen Fragen
      zu stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824724
    m_Localized: "Und wie haben sie die T\xFCr ge\xF6ffnet? Immerhin wurde sie so
      konzipiert, dass sie selbst den Megazaubern standgehallten hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824725
    m_Localized: "Zuerst dachte ich, dass sie das Sicherheitssystem von einem externen
      Terminal gehackt haben. Aber es war nichts dergleichen. Sie hatten einfach
      die Zugangscodes! Es stellt sich heraus, dass die Au\xDFent\xFCr eines Stable
      durch Eingabe eines solchen Codes ge\xF6ffnet werden kann. Und wir wussten
      nicht einmal, dass es so etwas gibt. Nun, das hei\xDFt, zumindest ich wusste
      das nicht... Mentor h\xE4tte es wissen m\xFCssen, aber aus irgendeinem Grund
      traf er keine Vorsichtsma\xDFnahmen. Es h\xE4tte ausgereicht, die T\xFCr nur
      mechanisch zu blockieren. Ich nehme an, es gab einige Regeln, die so etwas
      vor zweihundert Jahren verboten haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824726
    m_Localized: "Aber ich verspreche dir, jetzt wird alles anders. Ich werde das
      gesamte Sicherheitssystem pers\xF6nlich reorganisieren. Sowas wird nicht wieder
      passieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824727
    m_Localized: "Huh, ich h\xE4tte wirklich nie gedacht, dass Silver mal so sterben
      w\xFCrde. Ein Tod im Bett mit ungef\xE4hr vierzig w\xFCrde viel besser zu ihm
      passen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824728
    m_Localized: Solch ein Tod passt nicht zu jedem Pony.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824729
    m_Localized: Meinst du das Bett? Oder den Mord?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824730
    m_Localized: Beides.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824731
    m_Localized: "Ah, \xE4hm... Richtig."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824732
    m_Localized: "Wei\xDFt du, du hast uns am Ende alle gerettet. Man hat mir erz\xE4hlt,
      wie du dieses Flaggschiff der Enklave abgeschossen hast. Wenn du und die R\xFCstung
      nicht gewesen w\xE4rt, h\xE4tten sie uns vermutlich alle get\xF6tet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824733
    m_Localized: Danke.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824734
    m_Localized: "Ich danke dir. Ich wei\xDF nicht, ob deine Erinnerung inzwischen
      zu dir zur\xFCckgekehrt ist oder nicht, aber ich erinnere mich, wie du und
      ich fr\xFCher zusammengearbeitet haben. Du warst so ruhig. Ich h\xE4tte nie
      gedacht, dass du ein Held werden wirst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824735
    m_Localized: "Ich bin kein Held. Und wenn ich nicht so geworden w\xE4re, wie
      ich jetzt bin, h\xE4tte ich das alles nicht \xFCberlebt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824736
    m_Localized: "Achso, wo wir gerade dabei sind, du schuldest mir \xFCbrigens immer
      noch meine Super Pony-Magazine."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824737
    m_Localized: Ups.. dann sind die Erinnerungen wohl wieder da.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824738
    m_Localized: Wie geht es den restlichen Stablebewohnern jetzt?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824739
    m_Localized: "Thunderhead.. Fast jeders Pony ist entweder geschockt oder gestresst.
      Die meisten von ihnen werden es alleine \xFCberwinden, aber ich werde daf\xFCr
      sorgen, dass niemand in eine Depression ger\xE4t. Solche Ereignisse kommen
      nicht jeden Tag vor."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824740
    m_Localized: "Sieht f\xFCr mich so aus, als ob ihr euch so \xE4hnlich f\xFChlt
      ich an meinem ersten Tag im \xD6dland. Nur in einem gr\xF6\xDFeren Ma\xDFstab.
      Die Bewohner des Stable werden nie wieder die selben sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824741
    m_Localized: "Nat\xFCrlich werden sie das nicht. Aber wir k\xF6nnen immer noch
      zu unserer fr\xFCheren Lebensweise zur\xFCckkehren. Wenn wir d\xFCrfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824742
    m_Localized: "Ich kann f\xFCr niemanden sprechen. Ich kann nur hoffen, dass die
      Anderen sich daf\xFCr entscheiden, uns zu helfen. Aber ich verspreche, dass
      ich pers\xF6nlich alles tun werde, um mein Zuhause zu besch\xFCtzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824743
    m_Localized: "Sage mir, @lp. Wie schnell hast du dich daran gew\xF6hnt, andere
      Ponys sterben zu sehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824744
    m_Localized: "\xC4hmm... Ich hatte viel \xDCbung darin."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824745
    m_Localized: "Du und ich m\xFCssen zum fr\xFChestm\xF6glichen Zeitpunkt ausf\xFChrlicher
      dar\xFCber sprechen. Dein neues Leben ist sehr gef\xE4hrlich, @lp, nicht nur
      f\xFCr deine k\xF6rperliche Gesundheit, sondern auch f\xFCr deine Psyche. Ich
      wei\xDF, dass du das verstehst. Denke immer daran."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824746
    m_Localized: "In Ordnung, zum fr\xFChestm\xF6glichen Zeitpunkt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824747
    m_Localized: "Willkommen zur\xFCck, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824748
    m_Localized: Freut mich zu sehen, dass du immer noch die Hufe schwingst, Daiquiri.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824749
    m_Localized: "Die Freude ist ganz auf meiner Seite! Ich dachte wirklich, das
      w\xE4re das Ende. Die Enklave, meine liebe Celestia! Wenn mir das ein Pony
      vor einem Jahr erz\xE4hlt h\xE4tte, h\xE4tte ich das niemals geglaubt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824750
    m_Localized: Nun, jetzt kannst du wieder aufatmen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824751
    m_Localized: "Ja. All diese R\xE4uber und Sklavenh\xE4ndler werden uns jetzt
      wie Fohlenspielzeug vorkommen. Das ganze Lager munkelt dar\xFCber, wie ihr
      diese Blechkiste geknackt habt! Glaub mir, das werden sie so schnell nicht
      vergessen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824752
    m_Localized: "Bitte, lass uns nicht weiter darauf eingehen. F\xFCr mich ist diese
      Schlacht keine glorreiche Geschichten \xFCber Tapferkeit, sondern eine Erinnerung
      an die toten Bewohner von Stable Pi."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824753
    m_Localized: "Wie du w\xFCnschst. Dann eben nicht. Aber trotzdem @lp, nach allem
      was passiert ist wirst du hier niemals mehr ein Fremder sein. Vergiss das nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824754
    m_Localized: "Ich gr\xFC\xDFe dich, Reisender. Du hattest einen langen und beschwerlichen
      Weg seit unserem letzten Treffen, ich hoffe nun kommt alles zum Besten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824755
    m_Localized: Ja, das war schwierig. Aber es ist noch nicht vorbei, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824756
    m_Localized: "Noch nicht ganz. Solange du lebst, wird dein schicksal dich f\xFChren,
      jedoch ich kann einen Schatten auf dir lasten sp\xFCren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824757
    m_Localized: Was ist es?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824758
    m_Localized: "Das Schwarze Buch um das es geht, doch die Nachricht dar\xFCber
      wo es sich befand, erreichte mich zu sp\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824759
    m_Localized: "Es war n\xF6tig, um das Projekt abzuschlie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824760
    m_Localized: "Nat\xFCrlich war es das. So wie schon f\xFCr viele andere Seelen,
      nur kann euch das Buch was ihr tats\xE4chlich w\xFCnscht nicht geben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824761
    m_Localized: "Wie auch immer, das Projekt wurde beendet und die R\xFCstung hat
      mir geholfen mein Zuhause vor den Invasoren zu verteidigen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824762
    m_Localized: "Invasoren? Hast du je einen von ihnen gesehen, bevor das verdammte
      Buch bei dir gewesen?\nErinnere dich @lp. Erinnere dich daran was das Leben
      f\xFCr dich tat, bevor das Buch zu dir gefunden hat. Wie oft hast du dich gl\xFCcklich
      gef\xFChlt? Wie oft warst du von Sorgen beklommen? Als w\xE4rst du seit dem
      unter den Huf der Stute der Sterne gekommen? Warst du wirklich du selbst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824763
    m_Localized: "Du m\xF6chtest mir sagen dass..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824764
    m_Localized: "Der Weg des Schicksals bleibt und sterblichen verstellt. Doch Artefakte
      wie dieses, Kreationen verr\xFCckter Geister, stehen \xFCber der Lebenswelt.
      Wie Ton in den Hufen eines T\xF6pfers k\xF6nnen sie es ver\xE4ndern, langsam
      aber unaufhaltsam immer weiter. Willst du den Rest deines Lebens in Frieden
      verbringen, so halte dich besser fern von solchen Dingen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824765
    m_Localized: "Das ist... zu komisch, um wahr zu sein. Nein, das ist Unsinn. Tut
      mir Leid, Zambezi, dieses Buch mag B\xF6sartig sein, aber ich werde ein so
      m\xE4chtiges Artefakt nicht einfach irgendwo herumliegen lassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824766
    m_Localized: "Dieser Fehler k\xF6nnte dich in Zukunft um dein Leben bringen,
      jedoch ich kann dich nicht dazu zwingen. Wenn das geschieht werde ich kommen
      und deine Knochen begraben, doch zuvor werde ich mit dem Buch das gleiche machen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824767
    m_Localized: "\xC4mm... Danke?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824768
    m_Localized: "Ich dachte wir w\xE4ren Freunde."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824769
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 2737824770
    m_Localized: "Als Calamity zur\xFCckkam, erz\xE4hlte er uns viel \xFCber deine
      neue R\xFCstung und seine Magie. Du hast das Alihorn-Amulett! Ich w\xFCrde
      alles geben, um es mir anzusehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824771
    m_Localized: "Tut mir Leid, aber ich habe es f\xFCr wichtigere Dinge gebraucht.
      Zum Beispiel, um mein Zuhause zu retten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824772
    m_Localized: "Ich wei\xDF, ich wei\xDF. Aber trotzdem - du h\xE4ttest es zumindest
      f\xFCr eine Minute zu mir bringen k\xF6nnen. Hast du es noch?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824773
    m_Localized: Nein, es ist im Kampf ausgebrannt und existiert nicht mehr. Tut
      mir leid, dass ich es mir erlaubt habe, es in einer Schlacht einzusetzen, die
      das Schicksal von Hunderten Ponys entschieden hat.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824774
    m_Localized: "...\nNein mir tut es Leid, ich h\xE4tte h\xF6flicher sein sollen.
      Aber bei der heiligen Celestia, das Alicorn Amulett, ist Legend\xE4r! Und wie!
      Es entstanden Legenden \xFCber seine Legendarit\xE4t! Und diese Legenden waren..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824775
    m_Localized: "Ja, anscheinend h\xE4tte ich es dir wirklich bringen sollen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824776
    m_Localized: "Diese R\xFCstung... Heilige Celestia, was ist das?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824777
    m_Localized: "Das wissenschaftliche Projekt meines Stable. Sie war sehr n\xFCtzlich
      im Kampf gegen die Enklave, aber jetzt kann ich mit ihr nur noch fliegen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824778
    m_Localized: "\"Nur noch Fliegen\"? Jedes Pony in der Bruderschaft w\xFCrde seine
      Seele daf\xFCr verkaufen! Und wozu war sie denn vorher f\xE4hig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824779
    m_Localized: "Sie setzte eine Macht frei die f\xFCr ihre Sch\xF6pfer unbegreiflich
      war und mit der man viel Schaden anrichten konnte, das war alles."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824780
    m_Localized: "Damit endet die Geschichte eines Ponys namens @lp.\nAber nicht
      dein Spiel. Du kannst weiter durch das \xD6dland reisen, Feinde bek\xE4mpfen,
      Missionen erf\xFCllen, neue Stufen erreichen und Gegenst\xE4nde sammeln.\nWir
      hoffen, du hattest genauso viel Spa\xDF an diesem Spiel, wie wir daran zu arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824781
    m_Localized: "Und es wird keinen endg\xFCltigen Abspann geben! Wof\xFCr sind
      die \xFCberhaupt? Wer liest diese Massen an Texten und langen Listen mit Namen
      derjenigen, die am Entstehungsprozess des Produkts am wenigsten beteiligt waren?
      Wahrscheinlich niemand au\xDFer den Machern.\nWir werden dich also nicht l\xE4nger
      langweilen, damit du weiterspielen kannst!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824782
    m_Localized: "Hey! Wie ich sehe tr\xE4gst du keine richtige R\xFCstung. Nur einen...
      Overall? Mit solchen Klamotten wirst du im \xD6dland nicht lange am Leben bleiben!
      Wenn du \xFCberleben m\xF6chtest, dann denke an deine Verteidigung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824783
    m_Localized: Was? Oh... gut, ja. Aber ich habe sonst nichts. Sag mal, kannst
      du mir dabei helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824784
    m_Localized: "Aber sicher doch, R\xFCstungen sind mein Gesch\xE4ft! Ich f\xFCrchte
      aber, dass ich momentan nichts in deiner Gr\xF6\xDFe da habe. Vielleicht nur
      diese verst\xE4rkten Overalls und ein paar Schutzanz\xFCge. Schaue sie dir
      ruhig mal an, immer noch besser als gar nichts."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824785
    m_Localized: Sieht nicht so toll aus, um ehrlich zu sein. Bist du sicher, dass
      es nichts Besseres gibt?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824786
    m_Localized: "Tut mir leid. Bisher gab in diesem Lager nur Fohlen deiner Gr\xF6\xDFe.
      Und verschwende keine Zeit damit, andere H\xE4ndler zu fragen, ich bin hier
      der einzige R\xFCstungsh\xE4ndler. Aber keine Sorge, ich erwarte bald neue
      Lieferungen, dann finden wir bestimmt etwas Passendes f\xFCr dich. In der Zwischenzeit
      solltest du dir Kronkorken ansparen, gute R\xFCstungen sind nicht billig."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824787
    m_Localized: "Oh, und wenn deine R\xFCstung besch\xE4digt ist, kein Problem.
      Bringe sie dann einfach zu mir und ich repariere sie in k\xFCrzester Zeit.
      Nat\xFCrlich nicht umsonst versteht sich."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824788
    m_Localized: "Und wenn du selbst in der Lage bist dich darum zu k\xFCmmern, kannst
      du dich auf meiner Werkbank austoben. Ich habe nichts dagegen aber mach nichts
      kaputt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824789
    m_Localized: "Hier wie versprochen eine neue Lieferung. Es gibt zwei Exemplare
      in deiner Gr\xF6\xDFe - diese Lederr\xFCstung und diese hier aus Metall. Entscheide
      dich, welche dir am besten gef\xE4llt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824790
    m_Localized: Interessant. Und welche davon ist besser?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824791
    m_Localized: "Jede hat ihre Vor und Nachteile. Metall bietet einen guten Schutz
      vor Kugeln, st\xF6\xDFen und Laserwaffen, aber sie ist ziemlich schwer und
      macht dich langsam. Die Lederr\xFCstung ist leicht, und sch\xFCtzt dich vor
      Feuer, monster Z\xE4hnen und Krallen, aber sie h\xE4lt keine Kugeln ab. Die
      Wahl liegt bei dir."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824792
    m_Localized: "Und was wenn ich beide trage? Du wei\xDFt schon, Leder unter Metall?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824793
    m_Localized: Pffft, der Scherz war gut!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824794
    m_Localized: Hast du irgendwas Besonderes?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824795
    m_Localized: Besonderes? Wie zum Beispiel?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824796
    m_Localized: "Naja, etwas anderes als eine Standardr\xFCstung?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824797
    m_Localized: "Sowas wie eine \"Standardr\xFCstung\" gibt es nicht, alle Arten
      an R\xFCstungen die ich kenne haben ihre eigenen Charakteristika. Aber ich
      wei\xDF was du meinst. Mein alter Freund Wolf hat mir einmal Pl\xE4ne gegeben,
      um aus den Schalen von Radskorpionen R\xFCstungen herzustellen. Wie du vermutlich
      wei\xDFt, sind ihre Chitin Schalen sehr robust und dennoch leicht und flexibel,
      was sie zu einem hervorragenden Material macht. Ich habe jedoch nie die Zeit
      gefunden, damit zu experimentieren, und ich wei\xDF nicht, ob ich das auch
      jemals werde. Wenn du m\xF6chtest, kann ich dir ein Exemplar zu einem sehr
      vern\xFCnftigen Preis verkaufen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824798
    m_Localized: "Ich sehe, du hast Verwendung f\xFCr meine Pl\xE4ne. Wie ist die
      R\xFCstung so?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824799
    m_Localized: Ein bisschen zu eng.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824800
    m_Localized: "Ich k\xF6nnte sie etwas bearbeiten. Dann wird sie dir besser passen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824801
    m_Localized: "Erst gestern ist eine Karawane hier vorbeigekommen, unter anderem
      gab es einen ganzen Haufen an Kampfpanzern aus der Vorkriegszeit zum Verkauf.
      Auch in deiner Gr\xF6\xDFe! M\xF6chtest du einen Blick darauf werfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824802
    m_Localized: Zeig mal, was hast du denn da?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824803
    m_Localized: "Ein gut erhaltenes Beispiel f\xFCr Entwicklungen des M.W.T. Polymerkeramikplatten,
      feuerfestes Gewebe mit Kevlar-Futter. Es ist so angepasst, dass es deine Bewegungen
      nicht behindert. Ideal f\xFCr Mittel- und Nahkampfbedingungen gegen Gegner
      mit Schusswaffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824804
    m_Localized: Und was ist mit Schutz vor Energiewaffen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824805
    m_Localized: "Naja, nicht so toll. Diese R\xFCstung wurde hergestellt, noch bevor
      derartige Waffen weit verbreitet waren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824806
    m_Localized: "Wie auch immer, wenn du schutz vor magischen Energiewaffen braucht,
      kann ich dir auch helfen. Im Lager habe ich noch ein unverkauftes magisches
      R\xFCstungsset. Es wurde speziell entwickelt, um dieser Art Waffen entgegenzuwirken
      und den Tr\xE4ger vor Lasern, Plasma und Elektrizit\xE4t zu sch\xFCtzen. Wenn
      du vor hast, eine Milit\xE4reinrichtung oder einen anderen Ort mit vielen Robotern
      aufzusuchen, w\xE4re diese R\xFCstung die beste Wahl."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824807
    m_Localized: "Wenn ich eine Kampfr\xFCstung tragen w\xFCrde - und eine um ein
      paar Nummern gr\xF6\xDFere Magische R\xFCstung dar\xFCber, w\xE4re ich dann
      gegen alles gesch\xFCtzt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824808
    m_Localized: So funktioniert das nicht, @lp. Mit der Zeit wirst du das noch verstehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824809
    m_Localized: "Heya! Jagst du auch gerne Sachen in die Luft? Gut, weiste - buumm!
      b\xE4m! Bang! Was hast du am liebsten.. Dynamit, Granaten oder Minen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824810
    m_Localized: "Hmm... Ich wei\xDF nicht..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824811
    m_Localized: "Wenn du mich fragst, es geht nichts \xFCber einen Granatenwerfer.
      Whooosh! Buuum! Alle Feinde in St\xFCcke! Hei\xDFe Sache."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824812
    m_Localized: "Nat\xFCrlich haben Minen ihre Vorz\xFCge. Wenn du den Feind \xFCberraschen
      willst, gibt es nichts Besseres. Verstecke ein paar dieser Sch\xF6nheiten auf
      ihrem Weg, und die werden nicht wissen, was sie getroffen hat."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824813
    m_Localized: "Oder, sagen wir, du musst einen Tresor oder einen Raum voller s\xFC\xDFer
      Beute pl\xFCndern, aber der ist gut verschlossen? Eine ordentliche Bombe oder
      ein Paar Dynamit-Pakete werden dein Problem schnell l\xF6sen.. kinderleicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824814
    m_Localized: "Wow, hat Sprengstoff so viele Verwendungsm\xF6glichkeiten? Irgendwie
      hatte ich mir bis jetzt keine Gedanken dar\xFCber gemacht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824815
    m_Localized: "Wollen wir wetten? Egal, ob du ein Feuerwerk kaufen m\xF6chtest,
      oder sonst irgendwas Smokey Pit und sein Laden stehen zu deiner Verf\xFCgung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824816
    m_Localized: "Hey, Fr\xE4ulein, komm mal her, nur in dieser Saison - Magische
      Energiegranaten. Es gibt Plasma - gegen alle Arten von Fleisch, und Impuls
      - gegen wandelnde Schrotthaufen. Nimm sie solange sie noch hei\xDF und frisch
      sind!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824817
    m_Localized: "Sind diese Art Granaten st\xE4rker als gew\xF6hnliche?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824818
    m_Localized: "Wha, hast du denn gar keine Ahnung? Diese Dinger sind um ein Vielfaches
      st\xE4rker! Tats\xE4chlich gibt es leider kein Rumsen und keine richtige Explosion.
      Nicht sehr aufregend."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824819
    m_Localized: "Pass mal auf! Du hast hier so viel Sprengstoff an einem Ort und
      rauchst die ganze Zeit! Ist es nicht gef\xE4hrlich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824820
    m_Localized: ....
    m_Metadata:
      m_Items: []
  - m_Id: 2737824821
    m_Localized: ...........
    m_Metadata:
      m_Items: []
  - m_Id: 2737824822
    m_Localized: "N\xE4\xE4\xE4\xE4........."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824823
    m_Localized: "W\xE4rst du an richtig gro\xDFen Waffen interessierst? Kein Schei\xDF,
      ich meine echt verdammt gro\xDFe! Sieh sie dir an: Ein Mehrfachschuss Granatwerfer
      und ein Raketenwerfer."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824824
    m_Localized: "Und hier - Hufgemachte Bomben, die k\xF6nnen jede verfickte Wand
      in Staub verwandeln, jede T\xFCr, oder jeden Tresor zerrei\xDFen - die habe
      ich selbst gemacht!|Und hier - Hufgemachte Bomben, die k\xF6nnen jede Wand
      in Staub verwandeln, jede T\xFCr, oder jeden Tresor zerrei\xDFen - die habe
      ich selbst gemacht!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824825
    m_Localized: Was, wirklich, jede Wand?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824826
    m_Localized: ....
    m_Metadata:
      m_Items: []
  - m_Id: 2737824827
    m_Localized: "Nun, wenn du es so ausdr\xFCckst *wiehern*. Ein halber Meter Stahlwand
      nat\xFCrlich nicht. Aber alles andere... Kinderleicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824828
    m_Localized: "Whoa, verdammt tolle R\xFCstung die du da hast! Wo kann ich so
      eine bekommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824829
    m_Localized: Schusswaffen, Gewehre, Munition... Komm und such dir etwas aus.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824830
    m_Localized: Was verkaufst du, Waffen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824831
    m_Localized: "Nat\xFCrlich! Ich bin Brass Buckshot, und meine Familie f\xFChrt
      dieses Gesch\xE4ft seit drei Generationen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824832
    m_Localized: "Ich habe nur beste Ware, Qualit\xE4tsgarantie, wir bekommen nicht
      irgendwelchen M\xFCll ... Welche Waffen bevorzugst du, Schusswaffen oder magische
      Energiewaffen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824833
    m_Localized: "Welche w\xFCrdest du empfehlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824834
    m_Localized: "Ich bevorzuge die guten alten Schusswaffen. Sie sind g\xFCnstiger,
      zuverl\xE4ssiger, einfacher zu warten und k\xF6nnen auch dort eingesetzt werden,
      wo magische Energie nicht wirkt, wie unter Wasser zum Beispiel. Das Problem
      ist jedoch, dass es viele verschiedene Kaliber gibt und die Munition einer
      Waffe wahrscheinlich nicht f\xFCr eine andere Waffe passt. Was macht man da?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824835
    m_Localized: "Magische Energiewaffen werden dagegen Standardm\xE4\xDFig mit Spark-Batterien
      geladen, die f\xFCr fast alle Waffen geeignet sind, und das ist, wie ich zugeben
      muss, sehr praktisch. Dar\xFCber hinaus k\xF6nnen Laser, Plasma oder Feuer
      helfen, wo Kugeln nichts bringen. Es gibt Kreaturen im \xD6dland, gegen die
      nur Flammen helfen. Nimm zum Beispiel Schleim."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824836
    m_Localized: "Nat\xFCrlich verkaufe ich auch die passende Munition und Batterien.
      Und wenn du \xFCben m\xF6chtest, haben wir einen gut ausgestatteten Schie\xDFstand,
      durch die T\xFCr dort rechts."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824837
    m_Localized: "Eine gro\xDFe Auswahl an neuen Waffen! Komm, und sieh sie dir an!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824838
    m_Localized: "Wilkommen in der Praxis von Doktor Sepsis (das bin ich zu deiner
      Information). Wir bieten ein Breites Spektrum an medizinischen Dienstleistungen.
      Behandlung von Wunden, Prellungen, Frakturen, Strahlenkrankheit und.. (meine
      Spezialit\xE4t) Blutinfektionen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824839
    m_Localized: "Hallo, Dok, Ich bin @lp. Dieser Ort \xE4hnelt kaum einer Praxis."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824840
    m_Localized: "Dennoch ist dies das Beste, was du in der Gegend finden wirst.
      Wenn du von einem Banditen angeschossen oder von einem wilden Ghul gebissen
      wurdest, und das passiert fr\xFCher oder sp\xE4ter ganz sicher, hast du nichts
      anderes zu tun, als zu mir zu kommen. Dann lernst du den wahren Wert dieses
      Ortes zu sch\xE4tzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824841
    m_Localized: "Und warum kann ich nicht einfach Heiltr\xE4nke nehmen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824842
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824843
    m_Localized: "Du bist nicht sehr bewandert in Medizin, oder? \"Heiltr\xE4nke\",
      wie du sie nennst, sind nichts anderes als anabole Drogen. Wenn du eine schwere
      Verletzung hast, z. B. eine Fraktur oder eine Gehirnersch\xFCtterung, kannst
      du dich nur bei einem guten Arzt mit medizinischer Ausr\xFCstung davon erholen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824844
    m_Localized: Anabo.. was? Drogen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824845
    m_Localized: "Anabloisch, hei\xDFt aufbauend, regenerativ. Kurzgesagt - Dein
      K\xF6rper versucht immer, sich zu seinem normalen Zustand zu erholen, indem
      er die verschiedenen Schnitte, Bluterg\xFCsse usw. heilt. Reparative Medikamente
      beschleunigen diesen Prozess um ein Vielfaches, aber wenn du verletzungen hast,
      mit denen dein K\xF6rper nicht von selbst fertig wird, k\xF6nnen dir Tr\xE4nke
      da auch nicht weiter helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824846
    m_Localized: "Ich sehe du hast einen PipBuck? Dieses Ger\xE4t sollte \xFCber
      ein medizinisches Modul verf\xFCgen, das den Gesundheitszustand des Benutzers
      \xFCberwacht. Nat\xFCrlich kannst du auch selbst einen gebrochenen Knochen
      oder einen tiefen Schnitt diagnostizieren, aber ein funktionierendes medizinisches
      Modul ist in der Lage, alle Prozesse in deinem K\xF6rper zu kontrollieren und
      sie mit dem normalen Zustand zu vergleichen. Das hei\xDFt, es wird merken,
      dass etwas mit dir nicht stimmt, auch wenn du dich gut f\xFChlst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824847
    m_Localized: Aha, Es ist noch nicht einmal aktiviert! Einen Augenblick...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824848
    m_Localized: "Das medizinische Modul ist jetzt in PipBuck verf\xFCgbar. [Status]
      tab - [Gesundheit]"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824849
    m_Localized: "Alles bereit! Das kostet dich 100 Kronkorken. Kleiner Scherz, daf\xFCr
      nehme ich kein Geld. Aber nur f\xFCr den Fall, solltest du dich hier mit der
      Preisliste f\xFCr medizinische Leistungen vertraut machen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824850
    m_Localized: "Wow, deine Preise sind nicht gerade g\xFCnstig."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824851
    m_Localized: "Sie k\xF6nnen auch nicht g\xFCnstig sein. Wenn du glaubst, dass
      Medikamente g\xFCnstig sind, muss ich dich leider entt\xE4uschen. Fast das
      gesamte Geld, das ich verdiene, flie\xDFt in den Kauf neuer Medikamente und
      Ger\xE4te. Mir selbst bleibt nur ein magerer Anteil. Und wenn meine Klinik
      durch niedrige Preise den Bach runter geht, rate mal, wer dann am meisten verliert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824852
    m_Localized: "Wie auch immer, Ich bin kein Monster, wei\xDFt du. Wenn du kurz
      vom sterben bist, und keine Kronkorken hast um mich zu bezahlen, kannst du
      mit ein paar kostenlosen Behandlungen rechnen. Aber nur das eine Mal. Es ist
      nicht so toll, von der G\xFCte eines anderen zu profitieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824853
    m_Localized: "@lp, komm mal her, ich habe ein Angebot f\xFCr dich. Da du mein
      Stammkunde bist, hatte ich gen\xFCgend Gelegenheit, mir ein Bild von den Besonderheiten
      deines K\xF6rpers zu machen. Und der Dicke deiner Brieftasche. Daher halte
      ich es f\xFCr m\xF6glich, dir spezielle Leistungen meiner Klinik anzubieten:
      Kybernetische Implantate."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824854
    m_Localized: "Was? Aber ich m\xF6chte \xFCberhaupt kein Cyborg werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824855
    m_Localized: "Wenn du dir dabei eiserne Hufe und Augen anstelle normaler vorstellst,
      dann nein, ich werde dir nicht dein Bein abschneiden, um an seiner Stelle ein
      Cyber-Bein anzubringen. Meine Implantate sind unsichtbar und verursachen keinen
      Verlust an Mobilit\xE4t oder Sensibilit\xE4t der Kunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824856
    m_Localized: "Angenommen, ich stimme zu. Was verlangst du daf\xFCr von mir?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824857
    m_Localized: "Nur deine Kronkorken. Du bezahlst f\xFCr das Implantat. Ich versetze
      dich in Vollnarkose und f\xFChre die Operation durch. Du schlie\xDFt deine
      Augen und wenn du sie wieder \xF6ffnest, hast du das Implantat und die neuen
      F\xE4higkeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824858
    m_Localized: Du wirst mich nicht erstechen, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824859
    m_Localized: "Ich mache keine Fehler bei meiner Arbeit, sonst w\xE4re ich nicht
      hier. Und ich werde definitiv keine Gans t\xF6ten, die goldene Eier legt. Du
      kannst deine Paranoia beruhigen. \xDCbrigens biete ich auch psychiatrische
      Leistungen an, sei mein Gast."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824860
    m_Localized: "Hallo! Willkommen in meiner bescheidenen Werkstatt! Ich hei\xDFe
      Winry, Wie ist dein Name?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824861
    m_Localized: Hallo, Winry, Ich bin @lp. Was machst du hier so?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824862
    m_Localized: "Von allem etwas. Ich repariere Waffen, B\xFCgeleisen, Toaster und
      zerlege Schrott um an Ersatzteile zu gelangen. Hier kannst du deine Ausr\xFCstung
      reparieren, notwendige Ersatzteile kaufen, Werkzeuge, und alle Arten an n\xFCtzlichen
      kleinen Dingen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824863
    m_Localized: "Au\xDFerdem baue und verkaufe ich Nahkampfwaffen, wei\xDFt du?
      Alles womit man schneiden, stechen und zerschlagen kann, vom Messer bis zum
      Vorschlaghammer. Im Gegensatz zu Schusswaffen oder magischen Energiewaffen
      braucht man daf\xFCr keine Munition, und es gibt keine Ladehemmungen oder Aussetzer.
      Du musst nur wissen, wie man sie benutzt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824864
    m_Localized: Kann ich hier auch selbst Waffen herstellen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824865
    m_Localized: "Aber sicher! Fange damit an, dass du dir Baupl\xE4ne besorgst.
      Es sei denn nat\xFCrlich, du bist in der Lage, neue Dinge direkt im Kopf zu
      erfinden. Baupl\xE4ne k\xF6nnen von Meistern gekauft werden, und du kannst
      dein Gl\xFCck an verschiedenen Orten im \xD6dland versuchen - in verlassenen
      Geb\xE4uden, in Tresoren, Schreibtischen oder B\xFCcherregalen. Wenn die Luft
      im Raum trocken, und das Papier gut ist, f\xE4llt es m\xF6glicherweise nicht
      gleich in deinen Hufen auseinander. Ab und an kannst du auch welche von mir
      bekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824866
    m_Localized: "Wenn du dann alle erforderlichen Teile hast und deine Hufe am richtigen
      Ort sind, k\xF6nnen die Waffen auf einer Werkbank, wie die, die ich hier in
      meiner Werkstatt habe, zusammengebaut werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824867
    m_Localized: "Mit etwas \xDCbung, wirst du in der Lage sein, Dinge herzustellen,
      die nicht viel schlechter sind als das, was fr\xFCher in Vorkriegsfabriken
      hergestellt wurde."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824868
    m_Localized: Hast du es etwa geschafft den alten AutoDoc zu reparieren? Meinen
      Respekt! Ich habe es letzten endes nicht hin bekommen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824869
    m_Localized: Da bist du ja, ich habe auf dich gewartet, @lp!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824870
    m_Localized: "Nat\xFCrlich hast du auf mich gewartet. Wie h\xE4tte ich nicht
      hier her kommen k\xF6nnen? Dieser Ort ist wie geschaffen um ihn aufzusuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824871
    m_Localized: Ohh... Willst mich nicht fragen, woher ich deinen Namen kenne?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824872
    m_Localized: "Nein, ich kenne ja auch deinen Namen, Dusty Nebula. Ich kann sprichw\xF6rtlich
      vor mir geschrieben sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824873
    m_Localized: "Ahh, Ich sehe schon. Du hast also auch die Gabe, die Namen anderer
      Ponys zu kennen, bevor du mit ihnen sprichst. Es scheint als h\xE4ttest du
      ein Potenzial f\xFCr Magie."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824874
    m_Localized: "Ja wirklich? Also.. bis jetzt bin ich mit Ausnahme von Telekinese
      bei keinem Spruch gescheitert. Ich dachte immer, dass Magie eigentlich nichts
      f\xFCr mich ist ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824875
    m_Localized: "Andererseits.. Wenn du ein Magier werden m\xF6chtest, kann ich
      dir helfen die wahre Magie zu lernen. Aber du musst die magischen Kr\xE4fte
      daf\xFCr selbst entwickeln, bis du gelernt hast, Magie aus dir selbst zu ziehen
      wirst du diese Kunst nicht beherrschen. Besuche mich ab und an und ich werde
      die Ver\xE4nderungen in deinem Potenzial beobachten und dir neue Zauberspr\xFCche
      beibringen, wenn du bereit daf\xFCr bist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824876
    m_Localized: "Was hast du au\xDFer Zauberspr\xFCchen noch so f\xFCr mich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824877
    m_Localized: "Mein Aufgabenbereich umfasst nicht nur magisches Wissen. Wenn du
      Geduld und Aufmerksamkeit hast, kann ich dir die Kunst der Alchemie beibringen.
      Ich gebe dir Unterricht, versorge dich mit Rezepten, magischen Kr\xE4utern
      und Laborger\xE4ten. Au\xDFerdem... gef\xE4llt dir meine Kristallkugel?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824878
    m_Localized: Oh, ja, das ist die beste die ich jemals gesehen habe! Sagt sie
      die Zukunft voraus?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824879
    m_Localized: "Das kann sie, auch. Du kannst sie aber auch f\xFCr andere Zwecke
      verwenden. Und zwar um dein Erscheinungsbild zu \xE4ndern. Mach dir keine Sorgen,
      es ist nur eine Illusion, die nur du sehen kannst. Deine Freunde werden keinen
      Unterschied merken und dich wiedererkennen wie zuvor."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824880
    m_Localized: "Hallo, Zuckerst\xFCck! Du bist zum ersten Mal hier oder nicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824881
    m_Localized: Hallo, Das stimmt, Ich bin gerade hier angekommen. Mein Name ist
      @lp, und wie ist deiner?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824882
    m_Localized: "Holly Shine. Es ist so sch\xF6n, neue Gesichter in unserem Lager
      zu sehen! Ich bin so eine Art Chefkoch hier, wenn du hungrig wirst, bin ich
      immer froh, wenn ich dich versorgen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824883
    m_Localized: Klingt gut! Was steht auf der Speisekarte?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824884
    m_Localized: "Alles M\xF6gliche! Vorkriegs Dosen-Nahrung, Obst und Gem\xFCse
      von den Bauernh\xF6fen, Fleisch, sogar Geb\xE4ck..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824885
    m_Localized: Fleisch!? Ihr esst hier Fleisch?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824886
    m_Localized: "Warum \xFCberrascht dich das? Ich dachte, jedes Pony isst Fleisch.
      Aber sicher, ist das nicht das leckerste Gericht \xFCberhaupt, au\xDFerdem
      wenn es kein Essen gibt, bist du bereit, deinen eigenen Schweif zu kauen. Warst
      du schon einmal so richtig hungrig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824887
    m_Localized: "Also sch\xF6n ich habs kapiert. Du hast aber auch etwas von Bauernh\xF6fen
      gesagt. Gibt es hier Bauernh\xF6fe?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824888
    m_Localized: "Hier... nein. Aber es gibt weiter drau\xDFen Ponys, die dort ihre
      H\xF6fe haben. Es gibt nur wenige, und noch weniger Land auf denen sie etwas
      anbauen k\xF6nnen. Daher sind Produkte vom Bauernhof in der Regel nicht billig.
      Aber sie sind schmackhafter und ges\xFCnder! Ich habe Hafer, Kartoffeln, Gurken,
      Milch und Butter von den Brahmins der Bauern, und Getreide zum Brotbacken.
      Manchmal bringen sie auch etwas anderes mit."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824889
    m_Localized: Das klingt schon viel besser! Wenn ich Hunger habe, kaufe ich auf
      jeden Fall etwas vom Bauernhof.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824890
    m_Localized: "Hey. Geh\xF6rst du auch zur St\xE4hlernen Bruderschaft?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824891
    m_Localized: Positiv. Schreiberin Amaranth unter dem Befehl des Star Paladin
      Stahlhufe. Da du dich bei uns hier aufhalten darfst, nehme ich an dass ihr
      euch schon kennengelernt habt. Bitte nichts anfassen.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824892
    m_Localized: "Schreiberin.. ist das dein Rang? Ich dachte alle von der St\xE4hlernen
      Bruderschaft w\xE4ren Erdponys mit R\xFCstungen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824893
    m_Localized: "Irrtum. Einh\xF6rner k\xF6nnen sich auch der Bruderschaft anschlie\xDFen,
      werden aber in der Regel zu Schriftgelehren. Im Gegensatz zu den Rittern und
      Paladinen k\xFCmmern wir uns um verschiedene Dinge, au\xDFerhalb des Kampfes.
      Wir k\xFCmmern uns um alle Wirtschaftlichen und organisatorischen Probleme,
      Wartungsarbeiten, wissenschaftliche Forschung und so weiter."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824894
    m_Localized: "Deshalb tragen wir an Stelle einer Power R\xFCstung die Kleidung
      der Schriftgelehrten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824895
    m_Localized: "In diesem Lager bin ich pers\xF6nlich daf\xFCr verantwortlich,
      die Gruppe mit Rationen, Munition, Kommunikation mit der Kommandozentrale,
      Reparaturen von Waffen, R\xFCstungen und Ausr\xFCstung zu versorgen. Die giftige
      Luft in Canterlot setzt schnell die beste Power R\xFCstung au\xDFer Gefecht.
      Da f\xE4llt eine Menge Arbeit an. Hast du sonst noch Fragen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824896
    m_Localized: "Fragen..? Fragen! .. Ja, k\xF6nnen wir Handeln?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824897
    m_Localized: "Das k\xF6nnen wir tun. Ich pers\xF6nlich glaube dass der Handel
      mit den Einwohnern des \xD6dlands allen von Nutzen sein wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824898
    m_Localized: "Wie sieht es mit einer Power R\xFCstung aus? Kannst du mir eine
      verkaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824899
    m_Localized: "Negativ. Erstens, haben nur angeh\xF6rige der Bruderschaft das
      Recht Power-R\xFCstungen zu tragen. Zweitens hat jeder Ritter seine eigene
      R\xFCstung, es gibt also keine Zus\xE4tzlichen. Und drittens sind sie sowieso
      nicht f\xFCr Einh\xF6rner geeignet."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824900
    m_Localized: "Aber ich kann dir Waffen und \xFCbersch\xFCssige Munition verkaufen
      und deine Ausr\xFCstung bei Bedarf reparieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824901
    m_Localized: Impulsbombe
    m_Metadata:
      m_Items: []
  - m_Id: 2737824902
    m_Localized: "Sag nichts. Ich habe dein Gespr\xE4ch mit dem Kommandanten mitbekommen.
      Du m\xF6chtest den Bunker infiltrieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824903
    m_Localized: "Zu deiner Information, ich finde das nicht gut. Es w\xE4re nicht
      gut f\xFCr jemanden wie dich Angeh\xF6rige der Bruderschaft zu t\xF6ten und
      ihre Technologie zu stehlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824904
    m_Localized: "Aber da sie sich nunmal in den Hufen unseres Feindes befindet,
      und der Schaden den du anrichtest zu unseren Vorteil w\xE4re, werde ich dir
      helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824905
    m_Localized: "Was sollte ich \xFCber diesen Bunker wissen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824906
    m_Localized: "Es ist das am besten gesch\xFCtze Objekt dass ich jemals gesehen
      habe. Und dabei geht es nicht einmal um die Wachen. Am Eingang m\xFCsstest
      du die m\xE4chtigsten Tore des Bunkers \xFCberwinden, und selbst wenn dir das
      gelingt wartet im Inneren die zweite Stufe der Verteidigung. Ein Kraftfeld,
      dass mit brachialer Gewalt kaum zu durchbrechen ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824907
    m_Localized: "Das Feld ist jedoch recht anf\xE4llig. Es kann mit einem starken
      elektromagnetischen Impuls auf die Steuerelemente vor\xFCbergehend au\xDFer
      Kraft gesetzt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824908
    m_Localized: Wie eine Impulsgranate?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824909
    m_Localized: "Ganz sicher nicht. Da brauchst du schon etwas st\xE4rkeres - eine
      Impuls-Bombe. Meine eigene Entwicklung, nur f\xFCr F\xE4lle wie diese. Ich
      kann dir ein paar davon verkaufen. Aber denke daran... das Kraftfeld wird nur
      kurz ausgeschaltet und baut sich gleich danach wieder auf. Du kommst nicht
      auf die gleiche Art wieder herraus. Ist das klar?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824910
    m_Localized: Jawohl.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824911
    m_Localized: "Das nennst du eine Powerr\xFCstung?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824912
    m_Localized: "Ein sehr wertvoller Schl\xFCssel"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824913
    m_Localized: "Hey, psst. Komm mal auf ein Wort hier r\xFCber."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824914
    m_Localized: "Was gibts? Du hast bis jetzt kein Interesse an einem Gespr\xE4chen
      gehabt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824915
    m_Localized: "Naja, Ich war mir nur nicht sicher, ob man dir trauen kann. Aber
      jetzt ist klar, dass du zu uns geh\xF6rst, deshalb kann ich dir ein Geheimnis
      offenbaren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824916
    m_Localized: "Kurz gesagt, ich habe etwas f\xFCr dich. Einen Schl\xFCssel."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824917
    m_Localized: "Einen Schl\xFCssel? Was soll der \xF6ffnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824918
    m_Localized: "Einen Keller in Canterlot. Ich wei\xDF mit Sicherheit dass dort
      etwas sehr wertvolles eingeschlossen ist. Du musst es dir nur dort holen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824919
    m_Localized: Wirklich? Und warum gehst du nicht und holst dir diese wertvolle
      Sache selbst?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824920
    m_Localized: "Was glaubst du denn? Ich h\xE4nge an meinem Leben, ich habe doch
      nicht den Verstand verloren nach Canterlot zu gehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824921
    m_Localized: Und denkst du etwa dass ich dort hin gehe?
    m_Metadata:
      m_Items: []
  - m_Id: 2737824922
    m_Localized: "Oh ja, da bin ich mir so gar sicher, keine Sorge. Also lass uns
      das so machen. Ich verkaufe dir den Schl\xFCssel, und du wirst diese wertvolle
      Sache aus dem Keller holen und sie aufbewahren. Wie siehts aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824923
    m_Localized: "N\xF6! Ist doch offensichtlich das du versuchst mich reinzulegen!
      Glaubst etwa du dass ich f\xFCr diesen Schl\xFCssel aus reiner Neugier bezahle?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824924
    m_Localized: Ja.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824925
    m_Localized: "*St\xF6hnen* Nein! Mich interessiert nicht was sich in dem Keller
      befindet oder ob er \xFCberhaupt existiert! Verstehst du das??!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824926
    m_Localized: Was auch immer, die Neugier wird am Ende siegen und ich werde darauf
      warten.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824927
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 2737824928
    m_Localized: Test test test
    m_Metadata:
      m_Items: []
  - m_Id: 2737824929
    m_Localized: "Vollst\xE4ndig Teil 1"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824930
    m_Localized: "Vollst\xE4ndig Teil 2"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824931
    m_Localized: "Vollst\xE4ndig Teil 3"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824932
    m_Localized: Zum Ausgang
    m_Metadata:
      m_Items: []
  - m_Id: 2737824933
    m_Localized: "Du befindest dich alleine und ohne Ausr\xFCstung in einem verlassenen
      Hilfstunnel, und das Wichtigste ist: Du hast keine Ahnung, wie du hier gelandet
      bist. Finde einen Weg zur\xFCck an die Oberfl\xE4che und versuche in der Zwischenzeit,
      diesen Ort nach n\xFCtzlichen Dingen zu durchsuchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824934
    m_Localized: "Finde den Ausweg zur Oberfl\xE4che"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824935
    m_Localized: "Finde alle Zahnr\xE4der"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824936
    m_Localized: "Zahnr\xE4der gefunden:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824937
    m_Localized: Den Kontakt herstellen
    m_Metadata:
      m_Items: []
  - m_Id: 2737824938
    m_Localized: "Irgendwo in Equestria sollen friedliche Siedlungen existieren.
      Sie k\xF6nnten dir als Basislager f\xFCr deine Operationen dienen. Finde eine
      solche Siedlung und stelle den Kontakt zu den einheimischen Ponys her."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824939
    m_Localized: "Erreiche die n\xE4chstgelegene Siedlung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824940
    m_Localized: Sammle Informationen
    m_Metadata:
      m_Items: []
  - m_Id: 2737824941
    m_Localized: Chosen-24
    m_Metadata:
      m_Items: []
  - m_Id: 2737824942
    m_Localized: "Ein paar Monate zuvor wurde \"Chosen-24\" mit der gleichen Mission
      beauftragt wie du. Aber das Signal von ihrem PipBuck ging vor 72 Tagen verloren.
      Deine Aufgabe ist es nun \"Chosen-24\" zu finden und in Erfahrung zu bringen
      warum der Kontakt zu ihr verloren ging. Dann gehe den Umst\xE4nden entsprechen
      vor."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824943
    m_Localized: "Bringe Informationen \xFCber \"Chosen-24\" in Erfahrung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824944
    m_Localized: Untersuche das Lager in der Kanalisation
    m_Metadata:
      m_Items: []
  - m_Id: 2737824945
    m_Localized: "Rette \"Chosen-24\" vor den Sklavenh\xE4ndlern"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824946
    m_Localized: Finde "Chosen-24"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824947
    m_Localized: Der Weg zum Regenbogen
    m_Metadata:
      m_Items: []
  - m_Id: 2737824948
    m_Localized: "Irgendwo in der N\xE4he deines Startortes muss sich die ManeTec
      Fabrik befinden, oder das was noch davon \xFCbrig ist.Dein Hauptziel ist der
      Zentralrechner der Fabrik welcher Informationen enth\xE4lt die wir ben\xF6tigen.
      Schlie\xDFe einfach deinen PipBuck, alles andere erledigen die darauf installieren
      Programme. Gegenw\xE4rtig ist das alles was ich dir sagen kann. Achtung! Verliere
      blos deinen PipBuck nicht! Der Erfolg der Mission h\xE4ngt davon ab, und vielleicht
      auch dein Leben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824949
    m_Localized: Finde heraus wo sich die MainTec Fabrik befindet
    m_Metadata:
      m_Items: []
  - m_Id: 2737824950
    m_Localized: Finde und studiere den Lageplan der Fabrik
    m_Metadata:
      m_Items: []
  - m_Id: 2737824951
    m_Localized: "Bekomme den Sicherheitsschl\xFCssel"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824952
    m_Localized: "Verschaffe dir Zutritt f\xFCr die Abteilung f\xFCr Spezialforschungen"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824953
    m_Localized: Verbinde deinen PipBuck mit dem Zentralrechner
    m_Metadata:
      m_Items: []
  - m_Id: 2737824954
    m_Localized: Der Quanten Kogitator
    m_Metadata:
      m_Items: []
  - m_Id: 2737824955
    m_Localized: "Dein n\xE4chstes Hauptziel ist es nun den Quanten Kogitator zu
      beschaffen. Es ist ein \xE4u\xDFerst leistungsf\xE4higer aber dennoch sehr
      kompakter Prozessor der k\xFCnstliche Intelligenzen erster Klasse unterst\xFCtzt.
      Nach unseren Informationen ist der einzige Ort wo man so etwas bekommen kann
      Stable 88, der f\xFCr seine Entwicklungen auf dem Gebiet der Robotik bekannt
      ist. Der Eingang zum Stable befindet sich irgendwo bei Falls Springs."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824956
    m_Localized: Frage Daiquiri nach dem Standort von Falls Springs
    m_Metadata:
      m_Items: []
  - m_Id: 2737824957
    m_Localized: Verschaffe dir Zutritt zum Stable 88
    m_Metadata:
      m_Items: []
  - m_Id: 2737824958
    m_Localized: Finde den Quanten Kogitator
    m_Metadata:
      m_Items: []
  - m_Id: 2737824959
    m_Localized: Berichte dem Mentor von deinem Erfolg
    m_Metadata:
      m_Items: []
  - m_Id: 2737824960
    m_Localized: Befreie die Gefangenen
    m_Metadata:
      m_Items: []
  - m_Id: 2737824961
    m_Localized: "Banditen halten ihre Gefangenen in K\xE4figen. Finde einen Weg
      um die frei zu lassen. Brich die Schl\xF6sser auf oder finde den Schl\xFCssel."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824962
    m_Localized: 'Gefangene befreit:'
    m_Metadata:
      m_Items: []
  - m_Id: 2737824963
    m_Localized: Das Treffen
    m_Metadata:
      m_Items: []
  - m_Id: 2737824964
    m_Localized: "\xDCbergib den Quanten Kogitator an den Sprite-Bot unserer Vertrauensperson.
      Der Treffpunkt ist bei den Hankey Garagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824965
    m_Localized: Begib dich zum Treffpunkt
    m_Metadata:
      m_Items: []
  - m_Id: 2737824966
    m_Localized: "\xDCbergib den Quanten Kogitator an den Sprite-Bot"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824967
    m_Localized: "Untersuche die \xDCberreste des Sprite-Bots"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824968
    m_Localized: Alihorn Amulett
    m_Metadata:
      m_Items: []
  - m_Id: 2737824969
    m_Localized: Die neue Hauptaufgabe besteht darin, das Alihorn-Amulett zu finden,
      das irgendwo in den Ruinen von Manehattan versteckt ist.
    m_Metadata:
      m_Items: []
  - m_Id: 2737824970
    m_Localized: "Frage Daiquiri nach der Stra\xDFe in Richung Manehattan"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824971
    m_Localized: "Begib dich auf das Dach, einer der noch stehenden Wolkenkratzer
      und verschaffe dir einen \xDCberblick."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824972
    m_Localized: Begib dich zum Eingang des M.A.S. Turms
    m_Metadata:
      m_Items: []
  - m_Id: 2737824973
    m_Localized: "Triff dich mit dem Anf\xFChrer der Alih\xF6rner"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824974
    m_Localized: Finde das Alihorn Amulett
    m_Metadata:
      m_Items: []
  - m_Id: 2737824975
    m_Localized: Das Schwarze Buch
    m_Metadata:
      m_Items: []
  - m_Id: 2737824976
    m_Localized: "Das neue Hauptziel besteht darin das Schwarze Buch zu beschaffen,
      ein Artefakt der Zebra-Nekromanten. Der letzte bekannte Aufenthaltsort des
      Buches ist das Hauptb\xFCro des Ministeriums f\xFCr Prestige in Canterlot."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824977
    m_Localized: Frage Calamity nach dem Weg nach Canterlot
    m_Metadata:
      m_Items: []
  - m_Id: 2737824978
    m_Localized: Begib dich nach Canterlot
    m_Metadata:
      m_Items: []
  - m_Id: 2737824979
    m_Localized: Finde das Schwarte Buch
    m_Metadata:
      m_Items: []
  - m_Id: 2737824980
    m_Localized: Bringe das schwarze Buch in einen Besitz
    m_Metadata:
      m_Items: []
  - m_Id: 2737824981
    m_Localized: "Der Weg zur\xFCck nach Hause"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824982
    m_Localized: "Nachdem du alle ben\xF6tigten Gegenst\xE4nde gesammelt hast, musst
      du nun einen Weg zur\xFCck nach hause zum Stable Pi finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824983
    m_Localized: "Versuche den Mentor \xFCber die Kommunikationseinheit zu kontaktieren"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824984
    m_Localized: Finde einen anderen Weg
    m_Metadata:
      m_Items: []
  - m_Id: 2737824985
    m_Localized: "Besch\xE4ftige dich mit der Bedrohung durch die Enklave"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824986
    m_Localized: Sprich mit Velvet und den Beobachter
    m_Metadata:
      m_Items: []
  - m_Id: 2737824987
    m_Localized: Frage den Beobachter nach dem Weg Nachhause
    m_Metadata:
      m_Items: []
  - m_Id: 2737824988
    m_Localized: "Kehre zur\xFCck zum Stable Pi"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824989
    m_Localized: "Die St\xE4hlerne Bruderschaft"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824990
    m_Localized: "Es scheint ganz so als ob sich der \xC4lteste der lokalen St\xE4hlernen
      Bruderschaft Division sich mit ANh\xE4ngern der LEgion verschworen hat und
      einen Angriff auf den Stable Pi plant! Du musst sofort Ma\xDFnahmen dagegen
      ergreifen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824991
    m_Localized: Sprich mit Stahlhufe in seinem Lager
    m_Metadata:
      m_Items: []
  - m_Id: 2737824992
    m_Localized: "Informiere dich bei Oak Stalwort \xFCber die neue R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824993
    m_Localized: "Dringe in die Basis der St\xE4hlernen Bruderschaft ein"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824994
    m_Localized: "T\xF6te Coldsight"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824995
    m_Localized: Berichte Stahlhufe
    m_Metadata:
      m_Items: []
  - m_Id: 2737824996
    m_Localized: "Warne die Bewohner des \"T\xE4nzelnden Ponys\" vor der drohenden
      Gefahr"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824997
    m_Localized: Sprich mit Oak Stalwart
    m_Metadata:
      m_Items: []
  - m_Id: 2737824998
    m_Localized: Warne die Bewohner des "Verdeckten Zeichen" vor der drohenden Gefahr
    m_Metadata:
      m_Items: []
  - m_Id: 2737824999
    m_Localized: "Unterst\xFCtzung f\xFCr das \"T\xE4nzelnde Pony\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825000
    m_Localized: "Ernste Gespr\xE4che erfordern ernste Argumente, wie ein paar gro\xDFkalibrige
      Waffen. Es sollten Ma\xDFnahmen ergriffen werden, um sicherzustellen, dass
      sich das \"T\xE4nzelnde Pony\" -Lager gegen die St\xE4hlerne Bruderschaft verteidigen
      kann"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825001
    m_Localized: "Sprich mit Oak \xFCber die Mission"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825002
    m_Localized: Finde und erkunde die Mane-Tech Waffenfabrik
    m_Metadata:
      m_Items: []
  - m_Id: 2737825003
    m_Localized: Berichte Oak was du gefunden hast
    m_Metadata:
      m_Items: []
  - m_Id: 2737825004
    m_Localized: "Unterst\xFCtzung f\xFCr \"Verdecktes Zeichen\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825005
    m_Localized: "\"Verdecktes Zeichen\" hat nichts, was dir helfen k\xF6nnte, der
      Macht der Legion zu widerstehen. Askari beschloss, einen Gemeinderat einzuberufen,
      um die Situation zu besprechen und eine L\xF6sung zu finden"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825006
    m_Localized: Warte bis sich der Gemeinderat versammelt hat
    m_Metadata:
      m_Items: []
  - m_Id: 2737825007
    m_Localized: Triff dich mit dem Gemeinderat
    m_Metadata:
      m_Items: []
  - m_Id: 2737825008
    m_Localized: Frage Stahlhufe nach dem Standort des lokalen Hauptquartiers Legion
    m_Metadata:
      m_Items: []
  - m_Id: 2737825009
    m_Localized: Infiltriere das lokale Hauptquartier der Legion
    m_Metadata:
      m_Items: []
  - m_Id: 2737825010
    m_Localized: Beseitige den Centurio
    m_Metadata:
      m_Items: []
  - m_Id: 2737825011
    m_Localized: Finde die Geheimdokumente
    m_Metadata:
      m_Items: []
  - m_Id: 2737825012
    m_Localized: Berichte Askari von deinem Erfolg
    m_Metadata:
      m_Items: []
  - m_Id: 2737825013
    m_Localized: Sieh nach Velvet
    m_Metadata:
      m_Items: []
  - m_Id: 2737825014
    m_Localized: Der Schatten der Enklave
    m_Metadata:
      m_Items: []
  - m_Id: 2737825015
    m_Localized: "Finde heraus, was die Pegasus-Enklave an der Oberfl\xE4che verloren
      hat, was ihre Ziele sind und was ihre Pr\xE4senz f\xFCr uns alle bedeutet"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825016
    m_Localized: Besuche die Enklavebasis und versuche mit ihnen zu verhandeln
    m_Metadata:
      m_Items: []
  - m_Id: 2737825017
    m_Localized: Erreiche die Kommandozentrale
    m_Metadata:
      m_Items: []
  - m_Id: 2737825018
    m_Localized: Befrage den Basiskommandanten
    m_Metadata:
      m_Items: []
  - m_Id: 2737825019
    m_Localized: Ein Sturm zieht auf
    m_Metadata:
      m_Items: []
  - m_Id: 2737825020
    m_Localized: "Der Mentor weigerte sich, an dem Krieg an der Oberfl\xE4che teilzunehmen.
      Aber du kannst deine neuen Freunde nicht einfach im Stich lassen, w\xE4hrend
      du dich im sicheren Stable versteckst. Du musst zur\xFCck ins \xD6dland."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825021
    m_Localized: "Berichte Velvet von den j\xFCngsten Ereignissen"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825022
    m_Localized: "Triff Stahlhufe im Kl\xE4rwerk"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825023
    m_Localized: Infiltriere Fort Rocks
    m_Metadata:
      m_Items: []
  - m_Id: 2737825024
    m_Localized: Schalte die Artillerie aus
    m_Metadata:
      m_Items: []
  - m_Id: 2737825025
    m_Localized: Sprich mit Stahlhufe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825026
    m_Localized: Das letzte Gefecht
    m_Metadata:
      m_Items: []
  - m_Id: 2737825027
    m_Localized: "Die Enklave greift dein Zuhause an, Stable Pi. Besch\xFCtze es
      um jeden Preis!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825028
    m_Localized: "Kehre zum Stable Pi zur\xFCck und finde Mentor"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825029
    m_Localized: "Hole die \"Alihorn R\xFCstung\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825030
    m_Localized: Stoppe die invasion
    m_Metadata:
      m_Items: []
  - m_Id: 2737825031
    m_Localized: "Zerst\xF6re die Thunderhead"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825032
    m_Localized: "\xDCberlebe"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825033
    m_Localized: Hey!!! Wo willst du denn hin???
    m_Metadata:
      m_Items: []
  - m_Id: 2737825034
    m_Localized: Was zum Heuhaufen ist das?!!!???
    m_Metadata:
      m_Items: []
  - m_Id: 2737825035
    m_Localized: "(t\xF6dliche Stimme) Ich werde deine Seele aufsaugen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825036
    m_Localized: Aaah!
    m_Metadata:
      m_Items: []
  - m_Id: 2737825037
    m_Localized: Dieser Gegner kann nicht besiegt werden! Lauf, @lp, lauf!
    m_Metadata:
      m_Items: []
  - m_Id: 2737825038
    m_Localized: "Schlie\xDFe Freundschaft mit einem Balefire Ph\xF6nix"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825039
    m_Localized: "Der Balefire Ph\xF6nix hat scheinbar keine Angst vor dir und ist
      offenbar auch nicht agressiv. Ger\xFCchten zufolge sind diese V\xF6gel ungew\xF6hnlich
      intelligent und k\xF6nnen bei guter Behandlung zu treuen Freunden werden. Versuche,
      dich mit einem anzufreunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825040
    m_Localized: 'Verstrahlte Kekse anbieten:'
    m_Metadata:
      m_Items: []
  - m_Id: 2737825041
    m_Localized: Sprechen
    m_Metadata:
      m_Items: []
  - m_Id: 2737825042
    m_Localized: "Balefire Ph\xF6nix"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825043
    m_Localized: "*** Der Balefire Ph\xF6nix, dreht seinen Kopf und schaut dich mit
      einem Auge an ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825044
    m_Localized: "Wei\xDFt du ... du bist die wundervollste Kreatur die ich jemals
      in meinem Leben gesehen habe."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825045
    m_Localized: "*** Der Balefire Ph\xF6nix sieht sehr erfreut aus, er kr\xE4uselt
      das Gefieder auf seinem Kopf und dreht sich, um dir zuerst eine Seite von sich,
      dann eine andere zu zeigen ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825046
    m_Localized: Du... verstehst mich?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825047
    m_Localized: "*** Der Balefire Ph\xF6nix nickt, und gibt ein Ger\xE4usch von
      sich, anscheinend als Best\xE4tigung. Dann breitet er seine Fl\xFCgel aus und
      gibt eine Reihe neuer melodischer Kl\xE4nge von sich ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825048
    m_Localized: "Das ist wirklich befremdlich, aber ich habe den Eindruck, als ob
      ich dich auch verstehe. Sagst du gerade, dass du mich begleiten m\xF6chtest?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825049
    m_Localized: "*** Der Ph\xF6nix nickt erneut, hebt ab und macht sich bereit,
      dir zu folgen ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825050
    m_Localized: "\xDCber Gef\xE4hrten"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825051
    m_Localized: "Es k\xF6nnte gef\xE4hrlich werden, mit mir zu kommen, aber wenn
      du wirklich zusammen reisen m\xF6chtest, dann macht mir deine Gesellschaft
      nichts aus."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825052
    m_Localized: "*** Der Balefire Ph\xF6nix schwebt neben dir, du f\xFChlst die
      w\xE4rme, die von ihm ausgeht. Jetzt f\xFChlst du dich nicht so einsam ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825053
    m_Localized: "Der [Balefire Ph\xF6nix] ist nun dein Begleiter. Er wird dir folgen
      und dir im Kampf helfen.\n\t\t\t\t\tDer Balefire Ph\xF6nix hat feurigen Atem,
      der durch R\xFCstungen brennt. Er wird die Feinde angreifen, die er sieht und
      gegen welche seine Waffen wirksam sind. Wenn er im Kampf stirbt, wird er einige
      Zeit sp\xE4ter mit unvollst\xE4ndiger Gesundheit wiederbelebt.\n\t\t\t\t\t[Verstrahlte
      Kekse] heilen ihn (Sie k\xF6nnen wie jeder andere Gegenstand im Inventar verwendet
      werden), au\xDFerdem wird seine Gesundheit jedes mal wiederhergestellt wenn
      ihr beide Strahlung ausgesetzt seid."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825054
    m_Localized: "Zum rufen oder entlassen des Ph\xF6nix, benutze [pfeifen] aus deinem
      Inventar.\n\t\t\t\t\tVerwende die Kommunikationstaste deines Begleiters @1
      um ihn Anweisungen zu geben. Ein einziges Tippen gibt den Befehl, zum angegebenen
      Punkt gehen oder den angegebenen Feind angreifen. Wenn du die Taste gedr\xFCckt
      h\xE4lst, gibst du einen Befehl, um zu dir zur\xFCckzukehren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825055
    m_Localized: Ob ich das mal ausprobieren sollte?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825056
    m_Localized: '*** inhalieren ***'
    m_Metadata:
      m_Items: []
  - m_Id: 2737825057
    m_Localized: "*Hust* -*Hust* ... Wow, was f\xFCrn schei\xDF! Scheint nichts zu
      passieren.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825058
    m_Localized: "Ich sp\xFCre nichts..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825059
    m_Localized: Ow...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825060
    m_Localized: O-o-oh...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825061
    m_Localized: A-a-ah...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825062
    m_Localized: We-e-e...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825063
    m_Localized: Alles ist irgendwie ... so flach...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825064
    m_Localized: Oh, Ich glaube es ist vorbei. Oh, nein ... wohl noch nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825065
    m_Localized: Jetzt, ist alles wieder normal. Jaahh, naja, das war echt seltsam...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825066
    m_Localized: Also... was haben wir denn hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825067
    m_Localized: Hm....
    m_Metadata:
      m_Items: []
  - m_Id: 2737825068
    m_Localized: Hmmmm....
    m_Metadata:
      m_Items: []
  - m_Id: 2737825069
    m_Localized: "Nun, was soll ich sagen? Dieses Ding ist definitiv kaputt. Aber
      ich habe keine Idee wie es repariert werden k\xF6nnte..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825070
    m_Localized: "Jaaa, also was reparaturen angeht bin ich eine komplette Null.
      Ich k\xF6nnte es nur noch v\xF6llig kaputt machen. Ich sollte zumindest erst
      einmal ein Buch dar\xFCber lesen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825071
    m_Localized: "Na mal sehen... Ja, dieser AutoDoc hat schon einmal bessere Zeiten
      erlebt. Einige Teile m\xFCssen eindeutig ausgetauscht werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825072
    m_Localized: "Und was ist mit der Mechanik? Der Motor ist unbrauchbar... eine
      gebrochene Feder... die Lager sind trocken. Das hier m\xFCsste geklebt werden,
      und das machen wir mit Klebeband fest..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825073
    m_Localized: Die Elektronik ist auch das reinste Chaos. Die Batterie ist ausgelaufen,
      Kondensatoren sind durchgebrannt, und der Prozessor sollte ebenfalls ausgewechselt
      werden.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825074
    m_Localized: "Und was ist das?, Ein Diagnosemodul? Der Ultraschallscanner sollte
      ausgetauscht werden, der Alte ist komplett tot. Der F\xFChrungslaser arbeitet
      nicht, und die magnetischen Klemmen sind auch au\xDFer Funktion."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825075
    m_Localized: "Sch\xF6\xF6nnn... Wir haben hier einiges zu tun, so viele Teile
      die ersetzt werden m\xFCssen... Ein Wunder, dass dieses Ger\xE4t \xFCberhaupt
      mal funktioniert hat. Ich werde eine Liste der notwendigen Teile erstellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825076
    m_Localized: "Teile zum reparieren des AutoDoc:\n\t- Wunderkleber (3 St\xFCck)\n\t-
      Klebeband (3 St\xFCck)\n\t- Gummiband (2 St\xFCck)\n\t- Industrielle Batterie
      (1 St\xFCck)\n\t- Elektromotor (1 St\xFCck)\n\t- Feder (2 St\xFCck)\n\t- Kondensator
      (1 St\xFCck)\n\t- IC Mikrochip (1 St\xFCck)\n\t- Elektronische Komponenten
      (10 St\xFCck)\n\t- Ultraschallscanner (1 St\xFCck)\n\t- Laserpointer (1 St\xFCck)"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825077
    m_Localized: "Wir m\xFCssen den AutoDoc reparieren so viel steht fest. Nur, habe
      ich noch nicht alle notwendigen Teile und ohne die werde ich wahrscheinlich
      nichts erreichen. Vielleicht hat Winry ja etwas von der Liste."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825078
    m_Localized: Dann wollen wir mal versuchen dieses Wrack zu reparieren.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825079
    m_Localized: "So das w\xE4rs... das kommt hier dran.. und das hier werden wir
      dort anbringen... *Schraube anziehen* ...  und das noch zusammenkleben. Und
      was ist das hier f\xFCr ein Extrateil? Unn\xF6tig, funktioniert bestimmt auch
      ohne das."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825080
    m_Localized: Geschafft! Alles funktioniert. War ja gar nicht so schwer.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825081
    m_Localized: "So eine einfache Maschine reparieren? Kein Problem f\xFCr mich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825082
    m_Localized: "Wollen doch mal sehen... Hey, dieses Ding ist gar nicht wirklich
      kaputt! Alles was sie braucht ist ein wenig liebevolle F\xFCrsorge. Eine kleine
      Drehung hier... ein Hufgriff dort, und jetzt schalten wir sie aus und wieder
      ein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825083
    m_Localized: "Und los gehts! Funktioniert doch super. Du h\xE4ttest mich fr\xFCher
      fragen sollen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825084
    m_Localized: Heile das kranke Zebra
    m_Metadata:
      m_Items: []
  - m_Id: 2737825085
    m_Localized: "Ein Zebra namens Zira ist schwer krank und Velvet kann ihr nicht
      helfen. Deine medizinischen Kenntnisse k\xF6nnten sehr hilfreich sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825086
    m_Localized: Stelle eine Diagnose
    m_Metadata:
      m_Items: []
  - m_Id: 2737825087
    m_Localized: "Beschaffe einen Impfstoff f\xFCr das Staubfieber"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825088
    m_Localized: Verabreiche Zira den Impfstoff
    m_Metadata:
      m_Items: []
  - m_Id: 2737825089
    m_Localized: "Komme Sp\xE4ter wieder und frage Velvet nach dem Patienten"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825090
    m_Localized: Bunker
    m_Metadata:
      m_Items: []
  - m_Id: 2737825091
    m_Localized: "Der Lagerbunker der St\xE4hlernen Bruderschaft enth\xE4lt viele
      wertvolle Dinge. Sie wollten euer Zuhause angreifen und es pl\xFCndern, daf\xFCr
      werden sie den gleichen Preis bezahlen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825092
    m_Localized: "Sprich mit Amaranth \xFCber den Bunker"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825093
    m_Localized: Gelange in den Bunker
    m_Metadata:
      m_Items: []
  - m_Id: 2737825094
    m_Localized: Erreiche den Lagerraum
    m_Metadata:
      m_Items: []
  - m_Id: 2737825095
    m_Localized: "Finde Pl\xE4ne f\xFCr die geheime R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825096
    m_Localized: "Du musst die Pl\xE4ne f\xFCr eine geheime R\xFCstung finden, die
      irgendwo in der zerst\xF6rten Fabrik versteckt sind. Ich nehme an, sie sich
      im B\xFCro des Fabrikchefs befinden. Meinst du nicht auch? Wo sonst, wenn nicht
      dort?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825097
    m_Localized: "Hole die Pl\xE4ne aus dem Tresor des Fabrikchefs."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825098
    m_Localized: "Liefere die Pl\xE4ne ab und hole dir deine Belohung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825099
    m_Localized: "Pl\xE4ne f\xFCr die Spezialr\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825100
    m_Localized: "Suchst du nach Arbeit? Hier w\xE4re was f\xFCr dich. Warst du schon
      in der zerst\xF6rten Fabrik? Zur Zeit ist es dort ziemlich gef\xE4hrlich, aber
      man kann dort auch alle m\xF6glichen guten Sachen finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825101
    m_Localized: Ich sehe schon, bist du an etwas ganz bestimmten interessiert?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825102
    m_Localized: "Richtig. Ich habe von dort schon selbst eine ganze Menge leckerer
      Bonbons mitgenommen aber eine Sache konnte ich nie finden. In einem der Terminals
      stie\xDF ich auf Informationen \xFCber eine geheime Entwicklung der Fabrik.
      Soweit ich wei\xDF handelte es sich dabei um eine spezielle R\xFCstung, aber
      es gab keine detaillierten Informationen. Mein Gesch\xE4ft erfordert es dass
      ich \xFCber solche Dinge bescheid wei\xDF."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825103
    m_Localized: "Und du m\xF6chtest diese R\xFCstung haben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825104
    m_Localized: "Genau. Obwohl ich bezweifle, dass du die R\xFCstung selbst finden
      wirst. Soweit ich das verstanden habe haben die es damals nicht geschafft ein
      funktionierendes Modell herzustellen. Aber \xFCber die Pl\xE4ne und die technischen
      Unterlagen w\xFCrde ich mich freuen. Du wirst sowieso keine Verwendung f\xFCr
      sie finden, und ich werde nicht nur gut daf\xFCr bezahlen, sondern... wer wei\xDF,
      vielleicht k\xF6nnte ich diese R\xFCstung sogar anfertigen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825105
    m_Localized: Hier, ist das hier wonach du gesucht hast?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825106
    m_Localized: Lass mich mal sehen...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825107
    m_Localized: "Hmm... Genau, es ist schwer das sofort sagen zu k\xF6nnen, aber
      es scheinen die Pl\xE4ne zu sein, nach denen ich gesucht habe."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825108
    m_Localized: "Kannst du die R\xFCstung damit nachbauen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825109
    m_Localized: "M\xF6glicherweise. Zuerst muss ich mir die Pl\xE4ne im Detail ansehen
      und dann die Lagerbest\xE4nde auf notwendige Materialien oder mehr oder weniger
      geeignete \xFCberpr\xFCfen. Aber sei dir sicher, wenn ich Erfolg habe, wirst
      du es als Erstes erfahren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825110
    m_Localized: "Power R\xFCstung - ben\xF6tigte Komponenten"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825111
    m_Localized: "Sag mal, verkaufst du vielleicht Power R\xFCstungen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825112
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825113
    m_Localized: "Wie kommst du darauf dass ich Power R\xFCstungen verkaufen k\xF6nnte?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825114
    m_Localized: "Du bist ein R\xFCstungsverk\xE4ufter, richtig? Und eine Power R\xFCstung
      ist auch eine R\xFCstung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825115
    m_Localized: "Du machst schon wieder Witze, oder? Wenn du mir etwas sagen m\xF6chtest
      dann komm gleich zu Sache."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825116
    m_Localized: "Also sch\xF6n, ich verstehe. War eine bl\xF6de Frage."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825117
    m_Localized: "Hmm... ja, das war sie. Nur die St\xE4hlerne Bruderschaft hat Power
      R\xFCstungen. Und selbst wenn ich w\xFCsste wie das Exoskelett dieser Dinger
      funktioniert w\xE4re das Wissen alleine ohne die erforderlichen Komponenten
      nutzlos."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825118
    m_Localized: "Das hei\xDFt man kann nur bei der St\xE4hlernen Bruderschaft eine
      bekommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825119
    m_Localized: "Hmm, wenn ich so dar\xFCber nachdenke nein. Die St\xE4hlerne Bruderschaft
      hat diese R\xFCstung nicht erfunden. Die gab es schon vor den Mega-Zaubern.
      Daher k\xF6nnte man so eine R\xFCstung noch auf alten Milit\xE4rbasen oder
      bei verschollenen Patrouillen gefunden werden. Du k\xF6nntest der St\xE4hlernen
      Bruderschaft auch eine abnehmen wenn du es schaffst. Wenn du wirklich eine
      brauchst w\xE4ren das deine Optionen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825120
    m_Localized: "Also w\xE4re es m\xF6glich? Gro\xDFartig! Ich werde sehen was ich
      bekommen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825121
    m_Localized: "Ich k\xF6nnte eine Power R\xFCstung speziell f\xFCr dich entwerfen.
      Du besorgst mir die Teile, ich passe sie an deine K\xF6rpergr\xF6\xDFe an und
      modifiziere den Helm so dass ihn auch ein Einhorn tragen kann. Aber das w\xFCrde
      dich auch etwas kosten.... sagen wir... 20.000 Kronkorken."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825122
    m_Localized: "Die Pionier-R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825123
    m_Localized: "Herzlichen Gl\xFCckwunsch @lp - du hast dich als guter Partner
      erwiesen. Erinnerst du dich an die Pl\xE4ne, die mir mitgebracht hast? Sie
      enthielten wirklich alle Informationen, die ich brauchte. Ich habe alles in
      Erfahrung gebracht und werde anfangen, die neue R\xFCstung herzustellen. Normalerweise
      w\xFCrde ich solche Angebote nicht machen, aber f\xFCr dich als Finder dieser
      Pl\xE4ne bin ich bereit, dir einen ordentlichen Rabatt daf\xFCr zu gew\xE4hren."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825124
    m_Localized: "Oh, und was das so f\xFCr eine neue R\xFCstung??"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825125
    m_Localized: "In dem Dokumentation wurde sie als \"Pionier R\xFCstung\" bezeichnet.
      Sie soll ihren Besitzer vor Schockwellen, Flammen, Splittern und \xDCberdruck
      sch\xFCtzen, die durch die Explosion von Minen und Granaten in unmittelbarer
      N\xE4he entstehen. Nat\xFCrlich hatte ich nicht alle ben\xF6tigten Materialien
      und musste mit dem was ich hatte improvisieren. Und mit der Ausr\xFCstung in
      meiner Werkstatt l\xE4sst sich nicht das richtige Ma\xDF an Panzerungsabdeckung
      und isolierung erreichen ... Aber sie ist sowieso das Beste, was ich jemanden
      anbieten kann, der gerne mit Sprengstoff spielt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825126
    m_Localized: "Power R\xFCstung - in Arbeit"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825127
    m_Localized: "So.. reichen diese Fragmente hier aus um eine funktionierende R\xFCstung
      herzustellen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825128
    m_Localized: "Ich glaube ja, das m\xFCssten genug sein. Gib sie mal her.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825129
    m_Localized: Und wielange wird es dauern bis sie fertig ist?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825130
    m_Localized: "Keine Ahnung! Das k\xF6nnte einen Tag dauern, oder eine Woche.
      M\xF6glicherweise fehlt noch ein Teil dass du dann besorgen musst. Sowas habe
      ich vorher noch nie gemacht. Schaue von Zeit zu Zeit vorbei und ich werde dich
      wissen lassen wenn sie fertig ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825131
    m_Localized: "Und.. w\xE4re es denn m\xF6glich unter dem Exoskelett auch meine
      normale R\xFCstung zu Tragen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825132
    m_Localized: NEIN!
    m_Metadata:
      m_Items: []
  - m_Id: 2737825133
    m_Localized: "Power R\xFCstung - fertig!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825134
    m_Localized: "Deine Power R\xFCstung ist fertig. Du kannst den vereinbarten Betrag
      bezahlen und sie mitnehmen. So eine Auftragsarbeit ist ein Unikat. Au\xDFer
      dir passt keinem Pony eine R\xFCstung dieser Gr\xF6\xDFe. Deshalb hoffe ich
      auch dass du es dir leisten kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825135
    m_Localized: "Wow! Ist sie genau so toll wie die der St\xE4hlernen Bruderschaft?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825136
    m_Localized: "Ganz sicher nicht. Ich habe nicht die notwendige Ausr\xFCstung,
      und viele der Teile die du mitgebracht hattest wiesen Sch\xE4den auf, deshalb
      musste ich bei den Funktionen abstriche machen. Wie auch immer, was \xFCbrig
      war reicht um ihren Besitzer vor Angriffen zu sch\xFCtzen. Ich habe sie in
      einem herausfordernden Orange lackiert, was deinen Feinden klar machen soll
      dass du dich nicht verstecken musst. Sie werden schon bald lernen dir aus dem
      Weg zu gehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825137
    m_Localized: "Power R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825138
    m_Localized: "Wenn du eine Power R\xFCstung haben m\xF6chtest, die speziell f\xFCr
      dich angefertigt wurde, besorge mir ein paar Fragmente davon. Es ist mir egal
      woher du sie nimmst, aber die elektronischen Komponenten m\xFCssen in einwandfreiem
      Zustand sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825139
    m_Localized: "Beschaffe Fragmente von Power R\xFCstungen"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825140
    m_Localized: "Gib Oak Stalwart die Materialien f\xFCr die R\xFCstung und warte
      auf den Abschluss seiner Arbeit"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825141
    m_Localized: "T\xF6te Mad Fox"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825142
    m_Localized: "Hast du schon von der Bande von Mad Fox geh\xF6rt? Es hei\xDFt
      ihr Versteck sei irgendwo in der alten Fabrik. Wer auch immer diese Degenerierten
      findet und ausschaltet, hat meine ewige Dankbarkeit."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825143
    m_Localized: "T\xF6te Mad Fox"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825144
    m_Localized: Hole deine Belohnung bai Oak Stalwart ab.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825145
    m_Localized: Finde Farben
    m_Metadata:
      m_Items: []
  - m_Id: 2737825146
    m_Localized: "Ich bin auf der Suche nach Spr\xFChdosen in unterschiedlichen Farbt\xF6nen.
      F\xFCr den Anfang w\xFCrden mir die \xDCblichen reichen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825147
    m_Localized: Rote Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825148
    m_Localized: "Gr\xFCne Farbe"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825149
    m_Localized: Blaue Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825150
    m_Localized: Gelbe Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825151
    m_Localized: Weisse Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825152
    m_Localized: Liefere die Farben ab und hole dir deine Belohnung.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825153
    m_Localized: Finde Farben #2
    m_Metadata:
      m_Items: []
  - m_Id: 2737825154
    m_Localized: "Ich bin erneut auf der Suche nach Spr\xFChfarben, aber diesmal
      ben\xF6tige ich Farbt\xF6ne die schon seltener zu finden sind."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825155
    m_Localized: Graue Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825156
    m_Localized: Lila Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825157
    m_Localized: Orange Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825158
    m_Localized: Braune Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825159
    m_Localized: Hellblaue Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825160
    m_Localized: Khaki Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825161
    m_Localized: "Dunkelgr\xFCne Farbe"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825162
    m_Localized: Liefere die Farben ab und hole dir deine Belohnung.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825163
    m_Localized: Finde Farben #3
    m_Metadata:
      m_Items: []
  - m_Id: 2737825164
    m_Localized: "Eine weitere Jagd nach Farben. Ich brauche Sonderfarben, siehe
      die Liste im Anhang. Wie \xFCblich, du bringst mir Farben, ich zahle Kronkorken,
      aber dieses Mal f\xE4llt die Belohnung noch h\xF6her aus."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825165
    m_Localized: Cyanblaue Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825166
    m_Localized: Rosa Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825167
    m_Localized: Burgunderne Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825168
    m_Localized: Hochrote Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825169
    m_Localized: Limone Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825170
    m_Localized: Feurige Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825171
    m_Localized: Beige Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825172
    m_Localized: Liefere die Farben ab und hole dir deine Belohnung..
    m_Metadata:
      m_Items: []
  - m_Id: 2737825173
    m_Localized: "Amateurk\xFCnstler"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825174
    m_Localized: "Wozu hast du die ganzen Farben \xFCberhaupt gebraucht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825175
    m_Localized: "Was k\xFCmmert es dich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825176
    m_Localized: Ich frage nur interessehalber!
    m_Metadata:
      m_Items: []
  - m_Id: 2737825177
    m_Localized: "Ich lerne malen. Man k\xF6nnte sagen es ist mein Steckenpferd.
      Wenn du mal schauen m\xF6chtest... hier, nimm den Schl\xFCssel f\xFCr das Hinterzimmer
      und schaue es dir an, aber nichts anfassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825178
    m_Localized: "Und wie l\xE4uft es so?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825179
    m_Localized: "K\xF6nnte besser sein. Es ist schwer, aus Erfahrung zu lernen,
      und es gibt keine B\xFCcher f\xFCr K\xFCnstler, auch nicht in der Bibliothek
      von Nebula."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825180
    m_Localized: "Vielleicht k\xF6nnte ich versuchen, etwas N\xFCtzliches f\xFCr
      dich zu finden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825181
    m_Localized: "Du bist lustig, @lp, hat dir schon mal jemand gesagt? In den alten
      Ruinen l\xE4sst sich nicht alles finden, was jemand braucht. Nein, danke, ist
      schon gut so."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825182
    m_Localized: "Zerst\xF6re den Bloatsprites Bau"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825183
    m_Localized: "Bloatsprites, die in den Ruinen der Fabrik leben, haben vor kurzem
      angefangen, sich unkontrolliert zu vermehren. Es ist Zeit, dem ein Ende zu
      machen! Ich bezahle jeden, der den Bloatsprites Bau findet und sie ein f\xFCr
      alle Mal verbrennt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825184
    m_Localized: Finde den Bloatsprites Bau
    m_Metadata:
      m_Items: []
  - m_Id: 2737825185
    m_Localized: "Zerst\xF6re die Nester"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825186
    m_Localized: Hole deine Belohnung bei Brass Buckshot ab.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825187
    m_Localized: Finde einen neuen Fokussierkristall
    m_Metadata:
      m_Items: []
  - m_Id: 2737825188
    m_Localized: "Der Fokussierkristall in meiner Lieblings Plasmapistole ist gesprungen.
      Ich ben\xF6tige einen neuen. Den gr\xF6\xDFten und Reinsten nat\xFCrlich. Aber
      wenn mir wieder jemand versuchen sollte ein St\xFCck Glas anzudrehen kann er
      sich darauf gefasst machen einen Schuss in sein Hinterteil zu bekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825189
    m_Localized: Finde einen Fokussierkristall
    m_Metadata:
      m_Items: []
  - m_Id: 2737825190
    m_Localized: Bringe Brass den Kristall und erhalte die Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2737825191
    m_Localized: "Bringe die Pistole zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825192
    m_Localized: "Wenn irgendein Pony meine verlorene Pistole findet soll es sie
      bitte zu mir zur\xFCck bringen, eine Belohnung wird garantiert."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825193
    m_Localized: "Finde die Pistole namens \"Loyalit\xE4t\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825194
    m_Localized: "Bringe die Pistole zu ihrem Besitzer zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825195
    m_Localized: Sternenblaster
    m_Metadata:
      m_Items: []
  - m_Id: 2737825196
    m_Localized: "Hast du jemals die Geschichte \xFCber eine Waffe geh\xF6rt die
      von den Sternen gefallen sein soll? Nat\xFCrlich ist das nur ein M\xE4rchen!
      Nat\xFCrlich ist diese Waffe nicht einfach aus dem nichts gekommen aber ich
      glaube es gibt sie wirklich, denn ich habe einen Beweis - die Munition, die
      ich in den in den Ruinen von Manehattan gefunden habe. Diese Munition passt
      zu keinem bekannten Waffenmodell, das von Ponys oder Zebras hergestellt wurde,
      und das ich kenne."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825197
    m_Localized: Finde den Sternenblaster
    m_Metadata:
      m_Items: []
  - m_Id: 2737825198
    m_Localized: Zeige Brass Buckshot den Sternenblaster
    m_Metadata:
      m_Items: []
  - m_Id: 2737825199
    m_Localized: Die wertvolle Pistole
    m_Metadata:
      m_Items: []
  - m_Id: 2737825200
    m_Localized: Wie hast du deine Pistole verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825201
    m_Localized: Das ist nicht so einfach. In Wahrheit geht es um mehr als nur die
      Waffe.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825202
    m_Localized: "Als ich das letzte mal gesch\xE4ftlich in Manehattan unterwegs
      war, hatte ich Pech. Die Sklavenh\xE4ndler nahmen mich gefangen. Sie steckten
      mich in einen ihrer K\xE4fige zu den anderern Sklaven. Nat\xFCrlich haben sie
      mir alles abgenommen, auch die Waffe. Eine gro\xDFartige Pistole nebenbei bemerkt,
      aber sie war mehr als das. Sie war ein Familienerbst\xFCck dass ich von meinem
      Vater bekommen habe."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825203
    m_Localized: "Es ist schwer mich mit blo\xDFen Hufen so einfach niederzuschlagen
      daher konnte ich entkommen. Obwohl ich nat\xFCrlich auch sehr viel Gl\xFCck
      hatte. Aber alle meine Sachen musste ich dort zur\xFCck lassen, mir blieb keine
      Zeit mehr sie mir zu holen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825204
    m_Localized: "Die Sklavenh\xE4ndler sind bestimmt l\xE4ngst nicht mehr dort."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825205
    m_Localized: "Oh nein, sie sind schon noch dort. Da w\xFCrde ich mir keine Sorgen
      machen. Als ich im K\xE4fig sa\xDF habe ich ein paar von ihnen belauscht. Der
      Ort an dem sie mich festgehalten hatten diente als Durchgangslager und sie
      hatten sich dort bereits seit mehreren Jahren niedergelassen. Die Sklavenh\xE4ndler
      benutzen diesen Ort als Ausgangsbasis f\xFCr \xDCberfalle auf nahegelegene
      Siedlungen und Handelswege. Wenn du ihr Lager zerst\xF6rst untergr\xE4bst du
      damit ihre Aktivit\xE4ten f\xFCr Wochen, wenn ich gar Monate."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825206
    m_Localized: "Kannst du mir sonst noch etwas dar\xFCber sagen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825207
    m_Localized: "Ihr Anf\xFChrer hei\xDFt - Chopper. Bestimmt hat er sich meine
      Pistole unter dem Huf gerissen. Wenn du ihn t\xF6test.. durchsuche seine Taschen,
      m\xF6glicherweise ist meine Pistole immer noch bei ihm. So seltene Sachen verkaufen
      die in der Regel nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825208
    m_Localized: "Die Pistole zur\xFCckbringen"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825209
    m_Localized: Hier, Ist das deine Pistole?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825210
    m_Localized: Ja, das ist sie! Ich hatte nicht geglaubt sie noch einmal wieder
      zu sehen. Hast du Chopper angetroffen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825211
    m_Localized: "Jep. Wir hatten ein kleines Gespr\xE4ch."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825212
    m_Localized: Und was hat er getan?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825213
    m_Localized: "Ich f\xFCrchte er f\xFChlt sich jetzt nicht mehr besonders gut."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825214
    m_Localized: "Geschieht ihm recht! H\xF6re mal, es w\xE4re ungerecht wenn ich
      diese gute Waffe nehmen w\xFCrde ohne dir etwas entsprechendes daf\xFCr zu
      geben.  \"Loyalit\xE4t\" soll dir geh\xF6ren. Nimm sie bitte, ist \xFCberhaupt
      nicht schlimm."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825215
    m_Localized: Der Sternenblaster
    m_Metadata:
      m_Items: []
  - m_Id: 2737825216
    m_Localized: "Nun rate mal was ich hier habe. Es ist die Waffe von der du getr\xE4umt
      hast, der Sternenblaster!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825217
    m_Localized: Oh, bei meiner Mutterstute! Ist das wirklich diese Waffe? Ja, eindeutig. 
      Die gleiche Technologie wie die Energiezellen die ich gefunden habe.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825218
    m_Localized: Funktioniert sie? Hast du sie ausprobiert?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825219
    m_Localized: "Sicher, habe ich! Ich habe noch nie eine so starke Waffe gesehen.
      Sie \xE4hnelt einer gew\xF6hnlichen Laserpistole, aber ist 10 mal besser!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825220
    m_Localized: "Da gibt es nur ein Problem... die Munition. Normale Batterien passen
      nicht. Du sagtest du hast Energiezellen daf\xFCr? Kann ich sie dir abkaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825221
    m_Localized: "Du kannst sie umsonst haben. Ich brauche sie sowieso nicht. Schon
      einen Blick auf ein solches Wunder zu werfen hat sich f\xFCr mich gelohnt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825222
    m_Localized: Dank dir vielmals, Ich werde sie gut gebrauchen. Glaubst du dieser
      Blaster ist wirklich von den Sternen gefallen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825223
    m_Localized: "Keine Ahnung. Vielleicht war er ein ein Geheimprojekt von fr\xFCher,
      oder die Pegasi haben ihn verloren. Wer wei\xDF schon was die dort in den Wolken
      treiben. Aber wenn sie dort solche Waffen haben... h\xE4tten wir ein riesen
      Problem. Wir werden sehen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825224
    m_Localized: "T\xF6te Lucerne"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825225
    m_Localized: "Viele von euch erinnern sich wahrscheinlich noch an ein Pony namens
      Lucerne. Fr\xFCher war sie ein guter, anst\xE4ndiger Ghul, aber jetzt, so scheint
      es wohl hat der Verfallsprozess ihr Gehirn erreicht und sie in einen wilden
      Ghul verwandelt.. Sie soll in der Kanalisation bei der \"Kl\xE4rgrube\" gesehen
      worden sein, in Gesellschaft einer ganzen Herde dieser Wilden. Es w\xE4re sch\xF6n,
      wenn sich jemand entschlie\xDFen w\xFCrde, ihre Zeit auf Erden zu beenden -
      im gegenw\xE4rtigen Zustand stellt sie eine erhebliche Gefahr f\xFCr uns alle
      dar."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825226
    m_Localized: "T\xF6te Lucerne"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825227
    m_Localized: Bekomme von Brass Buckshot die Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2737825228
    m_Localized: Hilfe bei Dynamitherstellung
    m_Metadata:
      m_Items: []
  - m_Id: 2737825229
    m_Localized: "Ich werde bald anfangen Dynamit zu produzieren, und es an die Ponys
      zu verteilen. Ich k\xF6nnte Hilfe bem Beschaffen der Komponenten gebrauchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825230
    m_Localized: "Finde oder produziere etwas S\xE4ure."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825231
    m_Localized: Finde einen Kanister mit Glyzerin.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825232
    m_Localized: "\xDCberbringe die Komponenten Smoky Pit und hole dir deine Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825233
    m_Localized: "Zerst\xF6re die Ameisennester"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825234
    m_Localized: "Ich sage es noch einmal... diese Ameisen werden und alle noch in
      den Arsch beissen. Wenn euch das einen Schei\xDF interessiert werde ich selbst
      ein Pony finden dass diese verfickten Nester in die Luft jagt. Ich stelle so
      gar das Dynamit daf\xFCr.|Ich sage es noch einmal... diese Ameisen werden und
      alle noch in die Flanken beissen. Wenn euch das nicht k\xFCmmert werde ich
      selbst ein Pony finden dass diese vedammten Nester in die Luft jagt. Ich stelle
      so gar Dynamit daf\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825235
    m_Localized: "Alle Nester zerst\xF6ren"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825236
    m_Localized: Hole deine Belohnung bei Smoky Pit ab.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825237
    m_Localized: Ameisen-Probleme
    m_Metadata:
      m_Items: []
  - m_Id: 2737825238
    m_Localized: "Die Kurzform, das ist mein Vorschlag... Ameisen, riesig wie Hunde,
      sind in der Fabrik aufgetaucht. Und die kleinen Mistst\xFCcke haben etwas vor,
      die wollen sich einen Durchgang graben.|Die Kurzform, das ist mein Vorschlag...
      Ameisen, riesig wie Hunde, sind in der Fabrik aufgetaucht. Und die Viecher
      haben etwas vor, die wollen sich einen Durchgang graben."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825239
    m_Localized: Hast du etwa Angst vor Ameisen?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825240
    m_Localized: "Du wei\xDFt nicht, wovon du da redest, ich schei\xDFe auf normale
      Ameisen. Aber die Leute sagen, es gibt dort auch die Sorte, die Feuer spuckt,
      im Ernst! Und hier habe ich ... Nun, das ist vermutlich die Idee. Feuer k\xF6nnen
      wir hier nicht gebrauchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825241
    m_Localized: Du hast hier Kisten voller Sprengstoff?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825242
    m_Localized: "Das sagte ich doch gerade. Wenn das zeug hier zur H\xF6lle geht,
      glaube mir, dieses Feuerwerk wird keinem Pony gefallen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825243
    m_Localized: Und was kann man gegen diese Ameisen tun?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825244
    m_Localized: Na, was glaubst du? Finde ihre verdammten Nester und sprenge sie
      nach Tartarus. Hier, nimm das Dynamit ... | Na, was glaubst du? Finde ihre
      Nester und jage sie in die Luft. Hier, nimm das Dynamit ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737825245
    m_Localized: Du kannst dich auf meinen Teil des Handels verlassen, aus meiner
      Sicht ist es auch in deinem Interesse.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825246
    m_Localized: Kryotechnologie
    m_Metadata:
      m_Items: []
  - m_Id: 2737825247
    m_Localized: "Es gibt bald eine neue Art von Sprengstoffen! Ernsthaft! Da w\xE4re
      nur noch eine Kleinigkeit zu erledigen, besorge die Materialien, baue sie zusammen
      und teste sie im Kampf."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825248
    m_Localized: Erhalte Kryo-Zellen aus den Laboren des Aufgegebenen Stable
    m_Metadata:
      m_Items: []
  - m_Id: 2737825249
    m_Localized: Baue eine Kryogranate
    m_Metadata:
      m_Items: []
  - m_Id: 2737825250
    m_Localized: Baue eine Kryomine
    m_Metadata:
      m_Items: []
  - m_Id: 2737825251
    m_Localized: "T\xF6te Feinde mit einer Kryogranate"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825252
    m_Localized: "T\xF6te Feinde mit einer Kryomine"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825253
    m_Localized: "Berichte Smoky Pit \xFCber die Ergebnisse der Feldversuche"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825254
    m_Localized: Eine neue Art von Sprengstoff
    m_Metadata:
      m_Items: []
  - m_Id: 2737825255
    m_Localized: "@lp! Lass und ein wenig plaudern. H\xF6r mal, Bist du gut im Herstellen
      von Sprengstoffen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825256
    m_Localized: Ganz passabel. Wieso?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825257
    m_Localized: "Ich habe da so eine Idee. Ich m\xF6chte eine v\xF6llig neue Art
      von Granaten herstellen. Wie w\xE4rs? M\xF6chtest du die Feldversuche daf\xFCr
      durchf\xFChren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825258
    m_Localized: "Klingt interessant, erz\xE4hl mal!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825259
    m_Localized: "Diese Granaten explodieren nicht auf gew\xF6hliche Weise, oder
      stecken deine Feinde in Brand, Sondern sie frieren sie ein. Stelle dir das
      mal vor! Ich habe bereits ein paar Zeichnungen angefertigt, nicht nur f\xFCr
      Granaten sondern auch f\xFCr Minen. Es gibt nur ein Problem."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825260
    m_Localized: "Um so einen K\xE4lteschock zu erzeugen braucht man Kryo-Zellen.
      Und rate mal: Ich habe weder welche da, noch bin ich scharf darauf nach welchen
      zu suchen. Also musst du deinen Hintern bewegen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825261
    m_Localized: Wie immer... und wo kann man die Dinger finden?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825262
    m_Localized: Die sind ziemlich selten. Normalerweise kann man sie in alten Laboren
      finden. In einem der alten Stable kann man bestimmt auch welche finden. Hier,
      nimm die Zeichnungen. Versuche beides herzustellen, Granaten und Minen und
      dann teste sie an irgendeinem Pony. Ich erwarte die Resultate.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825263
    m_Localized: Kryo-Sprengstoff
    m_Metadata:
      m_Items: []
  - m_Id: 2737825264
    m_Localized: "Wegen deiner Idee einer K\xE4lte-Explosion... Die Tests waren erfolgreich,
      beides, die Granaten und die Minen sind hoch gegangen wie erwartet. Alles in
      der N\xE4he befindliche wurde schlagartig mit Eis bedeckt und das hat nicht
      sehr angenehm ausgesehen muss ich sagen. Diejenigen die gleich t\xF6dlichen
      Schaden genommen haben sind in St\xFCcke zerfallen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825265
    m_Localized: "Genial! Ich wette meine Kunden werden es lieben. Hervorragende
      Arbeit, @lp. Hier, ein paar Funkminen f\xFCr dich. Echt hei\xDFes Zeug, ohne
      Schei\xDF."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825266
    m_Localized: "Pl\xE4ne f\xFCr die Weltunter. Granate"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825267
    m_Localized: "Wie w\xE4re es mit einen kleinen Handel? Das Pony welches mir die
      Pl\xE4ne f\xFCr eine Weltuntergangs-Granate besorgen kann, die aus Sparkle-Cola
      herstellt wird, bekommt von mir Zeichnungen f\xFCr meine ganze eigene Kreation
      einer noch schmackhafteren Mine."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825268
    m_Localized: "Finde Pl\xE4ne f\xFCr eine Sparkle-Granate"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825269
    m_Localized: "Gib eine Kopie der Pl\xE4ne Smoky Pit und erhalte deine Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825270
    m_Localized: Raucher Utensilien
    m_Metadata:
      m_Items: []
  - m_Id: 2737825271
    m_Localized: Ich habe es satt, immer diese Mistzigaretten zu rauchen. Wer mir
      etwas besseres zum Rauchen besorgen kann, bekommt einen Haufen Kronkorken.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825272
    m_Localized: Joint aus magischen Gras
    m_Metadata:
      m_Items: []
  - m_Id: 2737825273
    m_Localized: Blatttabak
    m_Metadata:
      m_Items: []
  - m_Id: 2737825274
    m_Localized: Bong
    m_Metadata:
      m_Items: []
  - m_Id: 2737825275
    m_Localized: Pfeife
    m_Metadata:
      m_Items: []
  - m_Id: 2737825276
    m_Localized: Geschmuggelte Zigarren
    m_Metadata:
      m_Items: []
  - m_Id: 2737825277
    m_Localized: Repariere den AutoDoc
    m_Metadata:
      m_Items: []
  - m_Id: 2737825278
    m_Localized: "Sieht so aus als ob der AutoDoc letztlich deinen Sch\xF6pfer gegen\xFCber
      getreten ist. Repariert ihn doch bitte irgendein Pony! Es ist in eurem eigenen
      Interesse!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825279
    m_Localized: Repariere den AutoDoc
    m_Metadata:
      m_Items: []
  - m_Id: 2737825280
    m_Localized: Berichte Doktor Sepsis und erhalte deine Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2737825281
    m_Localized: Der kaputte AutoDoc
    m_Metadata:
      m_Items: []
  - m_Id: 2737825282
    m_Localized: "Hey, Dok! Was ist das f\xFCr ein seltsamer Roboter da in der Ecke?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825283
    m_Localized: "Das ist der AutoDoc - der ist noch von vor dem Krieg. Eine vollautomatische
      medizinische Station. Er ist ausgestattet mit einem Diagnosemodul und einer
      ganzen Bandbreite an Instrumenten. Er kann viele Krankheiten und Verletzungen
      behandeln ohne dass ein Arzt dazu ben\xF6tigt wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825284
    m_Localized: Wie es aussieht scheint er nicht mehr zu funktionieren oder?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825285
    m_Localized: "Korrekt. Er hat schon fr\xFCher Macken gehabt und vor einem Jahr
      dann ist er dann v\xF6llig ausgefallen. Winry wei\xDF nicht wie man ihn repariert
      und es ist wohl auch besser wenn es niemand versucht der nicht wei\xDF wie
      es geht. Ich habe es einmal versucht und hier siehst du das Ergebnis. Seit
      dem dient er hier als Staubf\xE4nger."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825286
    m_Localized: Vielleicht kennst du dich mit Technik besser als mit Medizin?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825287
    m_Localized: "Ich kann es versuchen... was bekomme ich daf\xFCr, wenn ich das
      Problem behebe?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825288
    m_Localized: "Ich lasse dich den AutoDoc umsonst benutzen. Auch wenn es mich
      ein wenig \xE4rgert denn er kann im funktionierenden Zustand so gar mit meinen
      F\xE4higkeiten mithalten. Du wirst es also nicht bereuen. Nur eine Sache -
      er ben\xF6tigt so genanntes Biogel um zu arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825289
    m_Localized: Was ist Biogel?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825290
    m_Localized: "Es ist eine komplexe biochemische Zusammensetzung, die die Geweberegeneration
      beschleunigt. Der AutoDoc verwendet es, um Wunden zu heilen und Schnitte nach
      der Operation zu schlie\xDFen, ohne zu n\xE4hen, und um stimulierende Biomasse
      zu synthetisieren, die in ihren Eigenschaften Heiltr\xE4nken entspricht. Ohne
      Biogel k\xF6nnte der AutoDoc nur deinen Magen aufschneiden und m\xFCsste ihn
      dann so belassen. Ich habe noch etwas Biogel \xFCbrig dass ich dir geben kann,
      wenn du den AutoDoc wieder zum Leben erweckt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825291
    m_Localized: In Ordnung, ich werde sehen was ich tun kann.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825292
    m_Localized: Der AutoDoc funktioniert wieder
    m_Metadata:
      m_Items: []
  - m_Id: 2737825293
    m_Localized: Es ist vollbracht, Dok, Dein Assistent ist wieder im Dienst und
      arbeitet so gut wie neu.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825294
    m_Localized: "Ich wei\xDF schon. Was soll ich sagen... Sagen wir einfach, dass
      ich die ganze Zeit, die du an der Maschine gebastelt hast, im selben Raum sa\xDF,
      neben dir. In einem Abstand von einem halben Meter. Verstehst du, worauf ich
      hinaus will?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825295
    m_Localized: "Aber dank dir daf\xFCr, wirklich gut. Der reparierte AutoDoc ist
      ein bedeutender Beitrag zum Betrieb meiner Klinik. Wie versprochen hast du
      ab sofort das Recht, den AutoDoc absolut kostenlos zu nutzen und nicht einmal
      f\xFCr den Stromverbrauch zu bezahlen. Au\xDFerdem sind hier alle 5 Liter Biogel,
      die ich noch \xFCbrig habe. Wenn du mehr brauchst, kannst du versuchen, in
      den Ruinen von Vorkriegskliniken oder pharmazeutischen Fabriken danach zu suchen,
      andere Quellen f\xFCr Biogel gibt es leider noch nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825296
    m_Localized: "Und was ist mit einem kleinen Rabatt f\xFCr medizinische Leistungen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825297
    m_Localized: "Nun, nein, das war kein Teil der Abmachung. Ich habe die gleichen
      Preise f\xFCr alle, da f\xFChrt kein Weg dran vorbei."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825298
    m_Localized: "Dann zumindest ein Teil des Biogels, das du erh\xE4lst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825299
    m_Localized: "Ich kann nicht sagen, ob ich jemals wieder Biogel bekommen werde.
      Und falls doch, dann muss ich etwas davon f\xFCr meine Kunden aufsparen, richtig?
      Au\xDFerdem bekomme ich es auch nicht umsonst, also nein. H\xF6chstens verkaufe
      ich dir etwas davon, aber rechne nicht damit."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825300
    m_Localized: "Sammle 20 Portionen Fisch \xD6l"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825301
    m_Localized: "Ich habe in einer alten Fachzeitschrift etwas \xFCber die wohltuende
      Wirkung von Fisch\xF6l gelesen und m\xF6chte das einmal nachzupr\xFCfen. Das
      Problem ist nur, dass der n\xE4chste Fluss Hunderte von Meilen entfernt ist.
      Deshalb bin ich bereit, das \xD6l zum dreifachen des normalen Preises zu kaufen.
      Aber diejenigen, die versuchen sollten, mir geschmolzenes Maulwurfsratten-Fett
      anstelle von Fisch\xF6l zu verkaufen, werden meine Testpersonen f\xFCr die
      \xDCberpr\xFCfung der Tr\xE4nke ohne Etiketten, die in der Fabrik gefunden
      wurden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825302
    m_Localized: "Sammle Fisch \xD6l"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825303
    m_Localized: "Liefere das gesammelte Fisch \xD6l ab und hole dir deine Belohnung"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825304
    m_Localized: Finde einen Medizin Talisman
    m_Metadata:
      m_Items: []
  - m_Id: 2737825305
    m_Localized: "Ich bin auf der Suche nach einen intakten Medizin Talisman. Ich
      wei\xDF, dass diese sehr wertvoll und selten sind und verspreche daher eine
      entsprechende Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825306
    m_Localized: Finde einen Medizin Talisman
    m_Metadata:
      m_Items: []
  - m_Id: 2737825307
    m_Localized: Bringe dem Doktor den Talisman und erhalte die Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2737825308
    m_Localized: "Finde Rezepte f\xFCr starke Medikamente"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825309
    m_Localized: "Ich biete den Ponys, die mir Rezepte f\xFCr Party Mint-als, Stampede
      und Ultra-Dash geben k\xF6nnen, eine finanzielle Belohnung. Eine spezielle
      Information noch f\xFCr diejenigen, die Witze \xFCber \xC4rzte und Drogenhandel
      m\xF6gen: Die Doktor Sepsis Praxis bietet Patienten, deren Verletzungen w\xE4hrend
      eines Konflikts mit dem Eigent\xFCmer der Klinik entstanden sind, keine Rabatte
      an."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825310
    m_Localized: "Finde ein Rezept f\xFCr Ultra-Dash"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825311
    m_Localized: "Finde ein Rezept f\xFCr Stampede"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825312
    m_Localized: "Finde ein Rezept f\xFCr Party Mint-als"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825313
    m_Localized: "\xDCbergib dem Dok Kopien der Rezepte und nimm deine Belohnung
      entgegen"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825314
    m_Localized: Finde Werkzeug
    m_Metadata:
      m_Items: []
  - m_Id: 2737825315
    m_Localized: "Ich kaufe seltenes Werkzeug. Ich ben\xF6tige: Messschieber, einen
      Hydraulischen Bolzenschneider und ein Oszilloskop. Ich w\xFCrde gut daf\xFCr
      bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825316
    m_Localized: Besorge einen Messschieber
    m_Metadata:
      m_Items: []
  - m_Id: 2737825317
    m_Localized: Besorge einen hydraulischen Bolzenschneider
    m_Metadata:
      m_Items: []
  - m_Id: 2737825318
    m_Localized: Besorge ein Oszilloskop
    m_Metadata:
      m_Items: []
  - m_Id: 2737825319
    m_Localized: "\xDCber Werkzeuge"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825320
    m_Localized: "Eine Menge Ger\xE4te hast du hier."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825321
    m_Localized: "Selbstverst\xE4ndlich, das ist eine Werkstatt. Aber in Wahrheit...
      fehlen mir hier viele der Ger\xE4te die ich am meisten brauche."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825322
    m_Localized: "Was f\xFCr welche genau? M\xF6glicherweise k\xF6nnte ich irgendwo
      welche finden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825323
    m_Localized: "Wenn du welche findest gebe ich dir eine nette Belohnung. Aber
      glaub blos nicht dass die Werkzeuge, die ich brauche, in jedem Schrank zu finden
      sind. Das sind nicht irgendwelche Schraubenzieher von denen wir hier reden.
      Zuh\xF6ren jetzt:\nAls erstes, brauche ich einen Messschieber."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825324
    m_Localized: "Ist das ein Werkzeug zur genauen Gr\xF6\xDFenmessung?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825325
    m_Localized: "Korrekt. Damit kann man beispielsweise den Durchmesser einer Schraube
      oder einer Mutter genau bestimmen. Versuche es in einer verlassenen Fabrik.
      Ich bin mir sicher, dass diese Werkzeuge dort weit verbreitet waren. Aber bisher
      hat noch niemand eins f\xFCr mich gefunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825326
    m_Localized: "Zweitens, ben\xF6tige ich einen hydraulischen Bolzenschneider.
      Mit so einem Ding kann man beispielzweise einen dicken Metallstab leicht durchscheiden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825327
    m_Localized: "Scheint ein n\xFCtzliches Teil zu sein. Wo kann ich sowas finden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825328
    m_Localized: "Nun, du k\xF6nntest es wahrscheinlich in der Fabrik finden. Aber
      es gibt aber noch eine Option. Vor vielen Jahren geh\xF6rte diese Werkstatt
      einem anderen Mechaniker. Ich wei\xDF mit Sicherheit, dass er einen hydraulischen
      Bolzenschneider hatte. Einmal nahm er ihn mit zu den alten Abwasserkan\xE4len,
      Keine Ahnung warum, vielleicht wollte er damit eine Art Gitter \xF6ffnen. Auf
      jeden Fall ist er nie von dort zur\xFCckgekehrt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825329
    m_Localized: "Ich kann nichts versprechen, irgendwie habe ich keine Lust darauf
      dass mir das gleiche widerf\xE4hrt."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825330
    m_Localized: "Kann ich gut verstehen, ich selbst habe auch kein Verlangen danach.
      Zum Schluss brauche ich noch ein Oszilloskop. Wei\xDFt du, ein Instrument zur
      Messung verschiedener Parameter eines elektrischen Signals."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825331
    m_Localized: "Ja, wir hatten sowas in unserem Stable. Wenn ich auf ein funktionierendes
      sto\xDFe, bringe ich es sofort zu dir."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825332
    m_Localized: "Wenn du etwas findest, bringen es mir bitte sofort. Nat\xFCrlich
      bezahle ich gut f\xFCr jedes Ger\xE4t, das du findest."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825333
    m_Localized: Suche nach Maulwurfsratten-fett
    m_Metadata:
      m_Items: []
  - m_Id: 2737825334
    m_Localized: "Ich kaufe Maulwurfsrattenfett zu einem guten Preis, um es als Schmiermittel
      f\xFCr diverse Mechanismen zu verwenden."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825335
    m_Localized: Gesammeltes Fett
    m_Metadata:
      m_Items: []
  - m_Id: 2737825336
    m_Localized: '"Cyberpony" Magazin'
    m_Metadata:
      m_Items: []
  - m_Id: 2737825337
    m_Localized: "Ich suche nach Vorkriegsmagazinen von \"Cyberpony\". Sie sind sehr
      selten, weil sie nur w\xE4hrend eines Jahres und in kleinen Mengen erschienen
      sind. Ich bezahle f\xFCr jeden, aber derjenige, der mir alle zw\xF6lf Ausgaben
      bringt, erh\xE4lt eine besondere Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825338
    m_Localized: Liefere die gefundenen Magazine ab.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825339
    m_Localized: "Sammle alte Elektronikger\xE4te"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825340
    m_Localized: "Achtung an alle, die sich in den alten Ruinen und auf Schrottpl\xE4tzen
      herumtreiben! Ich brauche alte Elektroger\xE4te, die f\xFCr Ersatzteilzwecke
      zerlegt werden sollen. Etwas kaputte reicht mir schon, aber bitte keinen kompletten
      M\xFCll."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825341
    m_Localized: Tischventelator
    m_Metadata:
      m_Items: []
  - m_Id: 2737825342
    m_Localized: Schreibtischlampe
    m_Metadata:
      m_Items: []
  - m_Id: 2737825343
    m_Localized: Kaffemaschine
    m_Metadata:
      m_Items: []
  - m_Id: 2737825344
    m_Localized: Bringe alle gefundenen Sachen zu Winry.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825345
    m_Localized: Schrauben und Muttern
    m_Metadata:
      m_Items: []
  - m_Id: 2737825346
    m_Localized: "Ich bin es leid, rostige Schrauben und Muttern aus alten Ventelatoren
      auszubauen, und ich bin bereit, f\xFCr Neue etwas zu bezahlen. Aber denkt nicht
      einmal daran, sie einzeln hier anzuschleppen, ich brauche eine ganze Kiste.
      Theoretisch m\xFCsste dieses Zeug irgendwo in der alten Fabrik zu finden sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825347
    m_Localized: Finde eine Kiste mit neuen Schrauben.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825348
    m_Localized: Finde eine Kiste mit neuen Muttern.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825349
    m_Localized: Schaffe alles zu Winry und erhalte deinen Lohn.
    m_Metadata:
      m_Items: []
  - m_Id: 2737825350
    m_Localized: Wertvolle Informationen
    m_Metadata:
      m_Items: []
  - m_Id: 2737825351
    m_Localized: "Ich bin auf der Suche nach technischen Dokumenten von Equidroids.
      F\xFCr denjenigen, der mutig genug ist, sich in den Datenspeicherraum des verlassenen
      Stable zu schleichen wird sich die M\xFChe lohnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825352
    m_Localized: Finde den Datenspeicher Raum
    m_Metadata:
      m_Items: []
  - m_Id: 2737825353
    m_Localized: Finde das Passwort zur Datenbank
    m_Metadata:
      m_Items: []
  - m_Id: 2737825354
    m_Localized: Baue ein Hacker-Modul
    m_Metadata:
      m_Items: []
  - m_Id: 2737825355
    m_Localized: Hacke den Server und lade die Equidroid-Daten herunter
    m_Metadata:
      m_Items: []
  - m_Id: 2737825356
    m_Localized: Bringe die Daten CD Winry und erhalte deine Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2737825357
    m_Localized: Faszination Roboter
    m_Metadata:
      m_Items: []
  - m_Id: 2737825358
    m_Localized: Sag mal, @lp, wie gut bist du eigentlich im Hacken von Terminals?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825359
    m_Localized: Ganz gut, wieso?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825360
    m_Localized: "Die Sache ist so, Ich interessiere mich ein wenig f\xFCr alles
      was mit Robotern zutun hat. Und bin daher besonders neugierig auf Equidroids.
      Hast du mal von denen geh\xF6rt? Das sind Roboter die wie echte Ponys aussehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825361
    m_Localized: "Erz\xE4hle weiter."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825362
    m_Localized: "Sie verhalten sich meistens ziemlich aggressiv, aber es ist nicht
      ihre Schuld. Anfangs waren sich nicht so. Hast du gewusst dass ihre Software
      urspr\xFCnglich die Pers\xF6nlichkeit von Ponys simulieren sollte?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825363
    m_Localized: Nein habe ich nicht, ist das wirklich wahr?
    m_Metadata:
      m_Items: []
  - m_Id: 2737825364
    m_Localized: "Ja. Die sind heutzutage unwahrscheinlich selten geworden, aber
      vor dem Krieg gab es einige Orte wo sie ziemlich h\xE4ufig verwendet wurden.
      Ich habe geh\xF6rt dass du vor hast den verlassenen Stable zu betreten der
      ger\xFCchten zufolge voller Roboter sein soll. Vielleicht begegnest du dort
      auch Equidroids."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018048
    m_Localized: "W\xE4re es m\xF6glich dass diese Roboter die Bewohner dort get\xF6tet
      haben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018049
    m_Localized: "Durchaus m\xF6glich, aber nach so vielen Jahren kann das keiner
      mehr genau sagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018050
    m_Localized: "Auf jeden Fall m\xF6chte ich mehr dar\xFCber erfahren. Was auch
      immer die Leute dar\xFCber denken m\xF6gen aber die sind ein echtes Wunder
      der Technik. Wenn wir nur herausfinden k\xF6nnten wie man sie umprogrammiert..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018051
    m_Localized: "W\xE4re das m\xF6glich? Und was br\xE4uchtest du dazu von mir?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018052
    m_Localized: "Die Technische Dokumentation der Equidroids und allgemeine Informationen.
      Wenn der Stable 88 an ihrer Entwicklung beteiligt gewesen ist m\xFCssen die
      Daten dort im Speicher vorhanden sein. Nat\xFCrlich wird das System gesch\xFCtzt
      sein. Deswegen habe ich nach deinen Hacker F\xE4higkeiten gefragt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018053
    m_Localized: "Nun, ich werde es auf jedenfall versuchen... Aber ich kann nichts
      versprechen. Es besteht die M\xF6glichkeit dass ich es nicht schaffe das System
      zu knacken."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018054
    m_Localized: "Ich habe etwas was dir dabei helfen kann. Diese Pl\xE4ne f\xFCr
      ein PipBuck Modul, welches dich beim Hacken unterst\xFCtzen kann. Hier hast
      du es! Ich glaube du wirst kein Problem damit haben das zusammen zu bauen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018055
    m_Localized: Wow, das ist klasse! Vielen Dank!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018056
    m_Localized: "Behalte deinen Dank, ich erwarte die Dokumente f\xFCr die Roboter!
      Viel Gl\xFCck dort drau\xDFen, @lp. Halte dich von \xC4rger fern."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018057
    m_Localized: Equidroid Unterlagen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018058
    m_Localized: "Hier, nimm die CD. Das ist alles was ich \xFCber den Aufbau von
      Equidroids herausfinden konnte."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018059
    m_Localized: Dank dir vielmals! War es schwierig da heran zu kommen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018060
    m_Localized: Habe schon schlimmeres erlebt, was machst du mit den Daten?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018061
    m_Localized: "Ich werde sie nat\xFCrlich sorgf\xE4ltig studieren. Und dann herausfinden
      wie ich sie sinnvoll einsetzen kann. Entschuldigung lass uns sp\xE4ter reden
      ich kann es kaum erwarten zu sehen was da drauf ist!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018062
    m_Localized: Sammle Edelsteine
    m_Metadata:
      m_Items: []
  - m_Id: 2742018063
    m_Localized: "Ich suche besonders seltene Edelsteine. Sie sind gr\xF6\xDFer als
      Gew\xF6hnliche und haben magische F\xE4higkeiten. Ich w\xFCrde gro\xDFz\xFCgig
      daf\xFCr bezahlen. Au\xDFerdem brauche ich noch Normale."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018064
    m_Localized: Beschaffe Smaragde
    m_Metadata:
      m_Items: []
  - m_Id: 2742018065
    m_Localized: Beschaffe Saphire
    m_Metadata:
      m_Items: []
  - m_Id: 2742018066
    m_Localized: Beschaffe Rubine
    m_Metadata:
      m_Items: []
  - m_Id: 2742018067
    m_Localized: Finde einen seltenen Marine Smaragd
    m_Metadata:
      m_Items: []
  - m_Id: 2742018068
    m_Localized: Finde einen seltenen Eis Saphir
    m_Metadata:
      m_Items: []
  - m_Id: 2742018069
    m_Localized: Finde einen seltenen Feuer Rubin
    m_Metadata:
      m_Items: []
  - m_Id: 2742018070
    m_Localized: "\xDCberbringe alle Edelsteine an Dusty Nebula und erhalte deine
      Belohnung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018071
    m_Localized: Bibliothek
    m_Metadata:
      m_Items: []
  - m_Id: 2742018072
    m_Localized: "Ich kaufe intakte B\xFCcher aus der Vorkriegszeit zu besten Preisen.
      Jeder tut das, sofern sie noch lesbar sind. Wer mir die Meisten bringt, bekommt
      eine besondere Belohnung. Lesen ist Magie, yay!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018073
    m_Localized: "Vorkriegsb\xFCcher besorgt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018074
    m_Localized: "Finde alle f\xFCnf B\xE4nde von \"Himmelsmechaniken\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018075
    m_Localized: "Sprich mit Dusty \xFCber die Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018076
    m_Localized: Bibliothek
    m_Metadata:
      m_Items: []
  - m_Id: 2742018077
    m_Localized: Ich sehe, du hast hier eine ganze Bibliothek!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018078
    m_Localized: "Ich w\xFCnschte ich h\xE4tte... mehrere Regale mit B\xFCchern,
      aber das hier ist alles. Heutzutage werden B\xFCcher nicht mehr ver\xF6ffentlicht,
      es gibt keine M\xF6glichkeit mehr, das zu tun. Ponys verloren das Interesse
      an allem, was ihnen nicht hilft, hier und jetzt zu \xFCberleben. Und fast alle
      Vorkriegsb\xFCcher sind entweder verbrannt oder vor Feuchtigkeit verfault oder
      einfach mit der Zeit und mangelnder F\xFCrsorge auseinandergefallen. Die Zeit
      in der wir leben ist nicht wissensfreundlich, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018079
    m_Localized: "Aber manchmal kann man auf fast v\xF6llig intakte Exemplate sto\xDFen.
      Ich betrachte es als meine Pflicht, diese zu bewahren. Lass uns einen Handel
      machen, wenn du unbesch\xE4digte B\xFCcher aus der Vorkriegszeit findest, bringst
      du sie zu mir. Ich werde dir mehr daf\xFCr zahlen, als du sonst von jemandem
      bekommest."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018080
    m_Localized: "Einverstanden! Ich durchsuche jedes B\xFCcherregal und jeden Schreibtisch,
      den ich finde. Interessierst du dich vielleicht f\xFCr etwas Besonderes?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018081
    m_Localized: "Gegenw\xE4rtig, ja. Ich wollte schon lange einmal die f\xFCnf B\xE4nde
      von \"Himmelsmechaniken\" lesen. Das sind wundervolle B\xFCcher, Scarlett Shine
      selbst hat alles aufgeschrieben, was sie \xFCber die Bewegung von Himmelsk\xF6rpern
      wusste! Man kann sich nur vorstellen, welchen Wert sie vor dem Krieg hatten
      und welchen jetzt ...! Ich kenne jedoch nur Ger\xFCchte und Referenzen, die
      ich in anderen B\xFCchern gefunden habe. Wenn du sie findest, erh\xE4lst du
      f\xFCr jeden Band einen Sonderpreis."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018082
    m_Localized: "Au\xDFerdem habe ich ein seltenes Buch, das du sicherlich interessant
      finden wirst. Eigentlich zwei Exemplare. Ich werde eines davon dem Pony geben,
      das den gr\xF6\xDFten Beitrag zur Erweiterung meiner Bibliothek leistet. Nat\xFCrlich
      k\xF6nntest du dieses Pony sein! Ist das nicht wunderbar?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018083
    m_Localized: "Dein Beitrag zur Erweiterung der Bibliothek ist von unsch\xE4tzbarem
      Wert, @lp. Wie versprochen, ist hier dein Sonderpreis. Ich hoffe, du wirst
      es n\xFCtzlich finden."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018084
    m_Localized: Sammle Trank-Zutaten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018085
    m_Localized: "Ich bin auf der Suche nach den Zutaten f\xFCr einen besonderen
      Trank. Wer mir dabei hilft bekommt das Rezept als Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018086
    m_Localized: Sammle magischen Staub
    m_Metadata:
      m_Items: []
  - m_Id: 2742018087
    m_Localized: Finde Feuerkristalle
    m_Metadata:
      m_Items: []
  - m_Id: 2742018088
    m_Localized: Gib Dusty die Zutaten und erhalte das Rezept
    m_Metadata:
      m_Items: []
  - m_Id: 2742018089
    m_Localized: "\xDCber \xC4pfel"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018090
    m_Localized: "Was wei\xDFt du \xFCber \xC4pfel, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018091
    m_Localized: "\xC4pfel? Hmm... Au\xDFer dass ich sie fast mein ganzes Leben lang
      gegessen habe?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018092
    m_Localized: "Meinst du \xC4pfel, die unter der Erde gewachsen sind? Vergiss
      diesen erb\xE4rmlichen Abklatsch! Diese Dinger haben weder Geschmack noch den
      gleichen Geruch, nur den Namen. Ich spreche von richtigen \xC4pfeln, gewachsen
      an frischer Luft, unter der Sonne. Hast du gewusst dass die Ponys fr\xFCher
      fast alles daraus gemacht haben? Alles was du dir vorstellen kannst: Apfelschaumwein,
      Apfelwein, Apfel Whiskey, Apfel Vodka, Apfellik\xF6r, Apfel Bitter..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018093
    m_Localized: "Warte, halt mal... sind das alles alkoholische Getr\xE4nke aus
      \xC4pfeln? Ist es das was du hier verkaufst?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018094
    m_Localized: "Nun ja, ich bin ein Barpony. Wovon sollte ich sonst reden, Apfelkuchen?
      H\xF6re zu, ich sammle seltene Vorkriegsgetr\xE4nke aus \xC4pfeln, und bin
      bereit einen guten Preis daf\xFCr zu zahlen. Bringe mir alles was du findest,
      aber komm blos nicht auf die Idee es selbst zu trinken! Du bist wahrscheinlich
      sowieso nicht in der Lage, ihren Geschmack und ihr Bouquet zu sch\xE4tzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018095
    m_Localized: "Gro\xDFe Worte... Ich bin zu mehr f\xE4hig als du denkst!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018096
    m_Localized: Seltener Alkohol
    m_Metadata:
      m_Items: []
  - m_Id: 2742018097
    m_Localized: "Ich kaufe seltenen Vorkriegsalkohol aus \xC4pfeln. Ich interessiere
      mich f\xFCr die ganz besonderen Tropfen, auf dein Wohl."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018098
    m_Localized: Apfelwein "Alter Bauernhof"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018099
    m_Localized: Apfelwein "Pink Sunset"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018100
    m_Localized: "Apfellik\xF6r \"Summer Flavors\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018101
    m_Localized: Apfel Whiskey "Wild Pegasus"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018102
    m_Localized: Apfel Wodka "Crystal"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018103
    m_Localized: Granny Smiths Apfel bitter
    m_Metadata:
      m_Items: []
  - m_Id: 2742018104
    m_Localized: Apfelbalsam "Ein Geschenk der Natur"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018105
    m_Localized: Hydroponische Daten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018106
    m_Localized: "Ich ben\xF6tige die Daten \xFCber die Hydrokultur Farmen aus dem
      Canterlot Stable-Tec-B\xFCro"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018107
    m_Localized: "Finde das Canterlot Stable-Tec B\xFCro"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018108
    m_Localized: "Lade die Daten \xFCber die Hydrokulturfarmen herunter"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018109
    m_Localized: "\xDCbergib die Daten an Schreiberin Amaranth und erhalte eine Belohnung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018110
    m_Localized: Canterlot Alchemie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018111
    m_Localized: "Ich ben\xF6tige Zutaten f\xFCr meine Tinkturen, bekommen kann man
      die nur von Canterlot-Kreaturen. Ich wei\xDF, diese Arbeit ist riskant, daher
      w\xE4re dies Rezept mein Dank. - Elixier der Intuition"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018112
    m_Localized: Rosa Schleim
    m_Metadata:
      m_Items: []
  - m_Id: 2742018113
    m_Localized: Dunkle Seele
    m_Metadata:
      m_Items: []
  - m_Id: 2742018114
    m_Localized: Horn einer Hexe
    m_Metadata:
      m_Items: []
  - m_Id: 2742018115
    m_Localized: Bringe die Zutaten Zambezi und erhalte deine Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2742018116
    m_Localized: Wasser Talisman
    m_Metadata:
      m_Items: []
  - m_Id: 2742018117
    m_Localized: "Verdecktes Zeichen braucht sauberes Wasser, sonst sich die Situation
      hier nicht verbessert. Ein Wassertalisman k\xF6nnte helfen, doch die sind ziemlich
      selten. Wir wissen, dass einer in Canterlot zu finden ist, doch dieser von
      Alih\xF6rnern wird besch\xFCtzt. Jener, der es schaft ihn zu erringen, w\xFCrde
      uns einen gro\xDFen Dienst vollbringen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018118
    m_Localized: Bringe den Wassertalisman in deinen Besitz
    m_Metadata:
      m_Items: []
  - m_Id: 2742018119
    m_Localized: "\xDCbergib Zambezi den Wassertalisman und erhalte deine Belohnung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018120
    m_Localized: Die Daten des Stealth-Buck M2 beschaffen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018121
    m_Localized: "Im Hauptb\xFCro des Ministeriums f\xFCr Prestige dass in der Vergangenheit
      den Stealth-Buck entwickelt hat, sind m\xF6glicherweise noch Daten \xFCber
      den Prototypen des Stealth-Buck M2 (Das Nachfolgermodell, welches viel weiter
      fortgeschritten sein soll als das Erste) zu finden. Ich bezahle gut, f\xFCr
      alle gefundenen Informationen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018122
    m_Localized: Beschaffte die Daten des Stealth-buck M2
    m_Metadata:
      m_Items: []
  - m_Id: 2742018123
    m_Localized: RX-47 Motivatoren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018124
    m_Localized: "Wir ben\xF6tigen dringend Ersatzteile f\xFCr Roboter, es handelt
      sich um RX-47 Motivatoren. Sie k\xF6nnen aus jedem Roboter der \"Guderian\"
      Klasse bezogen werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018125
    m_Localized: Sammle Motivatoren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018126
    m_Localized: Balefire-Batterie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018127
    m_Localized: Da wir uns jetzt im Krieg mit den Mitgliedern der Neighara Division
      befinden, brauchen wir eine starke Energiequelle, um unsere Basis richtig auszustatten.
      Eine der Balefire-Batterien aus dem Lager des Bunkers sollte ausreichen.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018128
    m_Localized: Beschaffe eine Balefire-Batterie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018129
    m_Localized: Tausche die Balefire-Batterie gegen die Belohnung
    m_Metadata:
      m_Items: []
  - m_Id: 2742018130
    m_Localized: Technologien der Zukunft
    m_Metadata:
      m_Items: []
  - m_Id: 2742018131
    m_Localized: "Wenn irgendeine Fraktion Technologien besitzt, die weiter fortgeschritten
      sind als die der St\xE4hlernen Bruderschaft, dann ist es zweifellos die Pegasus-Enklave.
      Exemplare dieser Technologie werden teuer gehandelt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018132
    m_Localized: Magnetresonanz-Horsgregator
    m_Metadata:
      m_Items: []
  - m_Id: 2742018133
    m_Localized: Ultra-Quadruponifikator
    m_Metadata:
      m_Items: []
  - m_Id: 2742018134
    m_Localized: Baryonen Neuralisierer
    m_Metadata:
      m_Items: []
  - m_Id: 2742018135
    m_Localized: Superlumineszierendes Quasistabilitron
    m_Metadata:
      m_Items: []
  - m_Id: 2742018136
    m_Localized: Hyperbeam Twilifuser
    m_Metadata:
      m_Items: []
  - m_Id: 2742018137
    m_Localized: "Enclave Power-R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018138
    m_Localized: "Die Powerr\xFCstung der Enklave ist ein beeindruckendes Beispiel
      f\xFCr moderne Technologie. Ich h\xE4tte gerne mindestens ein intaktes Probest\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018139
    m_Localized: "Finde eine intakte Power-R\xFCstung der Enklave"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018140
    m_Localized: "\xDCberbringe die R\xFCstung Amaranth"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018141
    m_Localized: Technologie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018142
    m_Localized: "K\xF6nnte ich dich etwas fragen? Die St\xE4hlerne Bruderschaft
      sieht ihre Aufgabe darin, Vorkriegstechnologien zu sammeln und zu bewahren.
      Habe ich das richtig verstanden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018143
    m_Localized: Das ist korrekt.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018144
    m_Localized: Und wie stellt ihr das genau an?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018145
    m_Localized: "Wir schicken regelm\xE4\xDFig Suchtrupps in die Ruinen alter St\xE4dte
      und bezahlen auch Stalker, H\xE4ndler und Aasfresser, wenn sie uns wertvolle
      Gegenst\xE4nde bringen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018146
    m_Localized: "Und was macht ihr mit diesen Gegenst\xE4nden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018147
    m_Localized: Wir untersuchen sie, weisen ihnen Bestandsnummern zu und schicken
      sie in eines unserer Lager.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018148
    m_Localized: "Was, das ist alles? Ihr benutzt sie nicht? Versucht ihr niemals,
      sie zu reproduzieren oder in Betrieb zu nehmen? Ehrlich gesagt kann ich das
      immer noch nicht verstehen. Gibt es nicht genug Ponys im \xD6dland, die von
      diesen Technologien profitieren k\xF6nnten?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018149
    m_Localized: "Glaube nicht, dass du der erste bist, der diese Frage stellt, @lp.
      Es gibt viele in der Bruderschaft, die deine Sichtweise unterst\xFCtzen w\xFCrden.
      Die Mehrheit ist jedoch der Ansicht, dass das Teilen von Technologie mit den
      \"Wilden\" nicht nur nicht ratsam, sondern sogar gef\xE4hrlich f\xFCr jedes
      Pony w\xE4re. Angeblich sollten wir uns um zuk\xFCnftige Generationen k\xFCmmern
      und Technologie f\xFCr sie erhalten, anstatt zu versuchen, die Welt um uns
      herum zu retten."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018150
    m_Localized: "Nicht voreilig, kein Grund emp\xF6rt zu sein. Ich wei\xDF, wie
      zynisch das klingt ... aber kein Pony k\xFCmmert sich um meine Meinung und
      noch viel weniger um deine."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018151
    m_Localized: "Hmm... sch\xF6n. Du sagst, ihr bezahlt f\xFCr wertvolle Technik.
      Gibt es etwas, das du besonders gerne haben w\xFCrden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018152
    m_Localized: "Ja gn\xE4digste. Eine Enklave Power-R\xFCstung. Hast du jemals
      eine gesehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018153
    m_Localized: "Nein. Ich wei\xDF garnichts \xFCber die Enklave. Wer sind die?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018154
    m_Localized: "Die Enklave sind eine milit\xE4rorische Oranisation der Pegasi.
      Wir haben keinen Kontakt zu ihnen und wissen wenig \xFCber sie. Wir wissen
      nur, dass sie sehr viele Technologien aus der Vor- und Nachkriegszeit besitzen,
      die vielleicht die fortschrittlichsten der Welt sind. Und ihre Soldaten verwenden,
      wie unsere Ritter, Power-R\xFCstungen. Es ist uns jedoch nie gelungen, eine
      einzige intakte zu erhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018155
    m_Localized: Wenn ich eine finde werde ich sie dir auf jeden Fall zeigen.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018156
    m_Localized: "Gut. Obwohl ich mir nicht vorstellen kann, wie du das schaffen
      willst. Denke daran, ich brauche eine intakte... ohne Einschussl\xF6cher. Versuche
      also nicht einmal, mir eine R\xFCstung zu bringen, aus der du die Leiche des
      Enklave Soldaten geholt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018157
    m_Localized: "Noch etwas ... ein kostenloser Rat f\xFCr unsere Verb\xFCndeten..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018158
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018159
    m_Localized: "Die Enklave ist ein gewaltiger Feind. Komme ihnen niemals in die
      Quere, au\xDFer es ist absolut notwendig."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018160
    m_Localized: "Enklave R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018161
    m_Localized: "Schau mal, was ich hier habe. Eine Enklave-Power-R\xFCstung. Ganz
      neu und kein Kratzer."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018162
    m_Localized: Wow, das ist wirklich...!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018163
    m_Localized: "\xC4hm... Ich meine..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018164
    m_Localized: "Positiv. Das ist die Powerr\xFCstung der Enklave, allerdings nur
      in ihrer einfachsten Grundkonfiguration. Kein Fl\xFCgelschutz, kein Skorpionstachel
      und keine fortschrittliche Zaubermatrix."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018165
    m_Localized: Aber dennoch, gib es zu, du bist beeindruckt.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018166
    m_Localized: "Ein bisschen \xFCberrascht. Wo hast du die her, aus der Umkleidekabine
      der Enklave? Ist mir aber egal. Ich bin berechtigt, dir eine Belohnung zu geben.
      Wie viel m\xF6chtest du daf\xFCr?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018167
    m_Localized: "Tut mir leid, aber ich k\xF6nnte diese R\xFCstung selbst gebrauchen.
      Ich verkaufe sie nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018168
    m_Localized: "Sei nicht dumm, das ist eine Pegasus R\xFCstung! Du kannst wegen
      deines Horns nicht einmal den Helm tagen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018169
    m_Localized: "Oh, Ich bin mir sicher dass die R\xFCstung modifiziert werden kann.
      Ich denke nicht, dass das so schwierig sein sollte. Lass uns einen Handel machen
      - ich werde sie dir f\xFCr eine Weile zum untersuchen geben. Und du passt sie
      daf\xFCr f\xFCr mich an. Einverstanden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018170
    m_Localized: "In Ordnung. Eigentlich glaube ich nicht, dass eine solche R\xFCstung
      f\xFCr einen unserer Ritter oder Eingeweihten geeignet w\xE4re, da sie zu schwach
      daf\xFCr ist, und es w\xE4re nicht sehr nutzbringend, sie ins Lager zu schicken.
      Die Untersuchung wird f\xFCr mich ausreichen. Komm sp\xE4ter wieder, dann wird
      alles erledigt sein."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018171
    m_Localized: "Enklave R\xFCstung fertig"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018172
    m_Localized: "Nun, wie siehts mit meiner R\xFCstung aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018173
    m_Localized: "Es gelang mir sie genau zu untersuchen. Sehr interessante Technologie.
      Die R\xFCstung ist viel leichter als unsere, sehr flexibel und schr\xE4nkt
      die Bewegungen nicht so stark ein. Aber dadurch ist sie auch viel weniger haltbar.
      Tats\xE4chlich ist sie kaum in der Lage, vor einer Gewehrkugel zu sch\xFCtzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018174
    m_Localized: "Diese R\xFCstung ist eindeutig f\xFCr den Schutz vor magischer
      Energieeinwirkung konzipiert. Und ich muss zugeben, sie ist wirklich gut. Die
      Zaubermatrix ist sehr komplex mit vielen Schutzstufen und..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018175
    m_Localized: Ja ja... was ist mit der Modifikation?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018176
    m_Localized: "Ich musste f\xFCr das Horn ein Loch in den Helm bohren. Und sie
      nat\xFCrlich an deine K\xF6rpergr\xF6\xDFe anpassen. Im \xDCbrigen sollte es
      f\xFCr dich einfach sein, dich mit dieser R\xFCstung vertraut zu machen, da
      sie sehr... adaptiv ist. Sie passt sich dem Besitzer an. Offensichtlich haben
      die Enklave Wissenschaftler in den letzten zweihundert Jahren nicht auf ihren
      Hufen gesessen. Ein Krieg mit ihnen k\xF6nnte schwierig werden..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018177
    m_Localized: Oh ich danke dir! Ich kann es nicht abwarten sie auszuprobieren!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018178
    m_Localized: "Falls ich es noch nicht erw\xE4hnt habe. Du bist ein wertvoller
      Verb\xFCndeter f\xFCr uns. Indem wir dir helfen, helfen wir uns gegenseitig."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018179
    m_Localized: Hey, das war mein Zimmer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018180
    m_Localized: "Wow, es hat sich kein bisschen ver\xE4ndert. So grau wie mein fr\xFCheres
      Leben..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018181
    m_Localized: "Man stelle sich vor, wenn ich nicht f\xFCr die Mission an der Oberfl\xE4che
      ausgew\xE4hlt worden w\xE4re, w\xFCrde ich hier immer noch leben. Tag f\xFCr
      Tag, Jahr f\xFCr Jahr, ohne zu wissen, was drau\xDFen passiert. Sicher und..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018182
    m_Localized: nutzlos...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018183
    m_Localized: "Sehr geehrter Leser! Wenn Sie dieses Werk in Ihren Hufen halten,
      bedeutet dies, dass Sie beschlossen haben, den ersten Schritt zu tun, um die
      subtile Kunst der Schimpfworte zu beherrschen. Die F\xE4higkeit, fest und kunstvoll
      zu schw\xF6ren, ist tats\xE4chlich ein wichtiger und wesentlicher Bestandteil
      intelligenter Sprache, und es ist absolut nichts Sch\xE4ndliches daran, wenn
      sie richtig verwendet wird. In den meisten F\xE4llen reicht es nicht aus, Ihrer
      Rede nur ein Schimpfwort hinzuzuf\xFCgen, um das Publikum zu beeindrucken und
      Ihre Gef\xFChle voll auszudr\xFCcken, und viele verbessern ihre F\xE4higkeiten,
      Emotionen w\xE4hrend des gesamten Lebens farbenfroh zu vermitteln. Leider wird
      unser W\xF6rterbuch wahrscheinlich nicht ausreichen, um Sie zu echten Meistern
      dieser Kunst zu machen, denn das wirklich meisterhafte Fluchen sollte intuitiv
      und von Herzen kommen. Aber dank dieses Buches k\xF6nnen Sie auf jeden Fall
      einen Ausgangspunkt finden, der Sie bei der weiteren Verbesserung Ihrer Talente
      in diesem Bereich unterst\xFCtzt.\nDieses Buch ist in drei Hauptabschnitte
      unterteilt, abh\xE4ngig von der Schmutzigkeit und St\xE4rke der Schimpfw\xF6rter.
      Wenn Sie noch nie zuvor Umgang mit unh\xF6flichen Ausdr\xFCcken hatten, raten
      wir dringend den ersten Abschnitt zu lesen. Alle hier aufgef\xFChrten Ausdr\xFCcke
      sind universell und k\xF6nnen in jeder Situation angewendet werden, um \xC4rger,
      Ressentiments oder Bewunderung auszudr\xFCcken.\n1. Leichtes Fluchen\nIn diesem
      Abschnitt finden Sie Beispiele f\xFCr die am h\xE4ufigsten verwendeten Fl\xFCche,
      die in der Gesellschaft als relativ zivilisiert anerkannt und auch f\xFCr die
      Verwendung mit Fohlen akzeptabel sind. Sie erm\xF6glichen es Ihnen weiterhin,
      dem Empf\xE4nger Ihre Gedanken und Ihre Stimmung klar und deutlich auszudr\xFCcken.\nOh,
      Celestia verfluche dich(sie)!\nLuna verflucht!\nOh, bei Celestias Schweif!\nDiscords
      Werk!\nOh G\xF6ttinnen!\nM\xF6gest du(sie) dran ersticken!\nM\xF6ge Luna deinen
      dummen Kopf zerschmettern!\nM\xF6ge Celestia dich(sie) verbrennen!\nM\xF6gen
      Celestia und Luna dich(sie) verfluchen!\nM\xF6gen dich deine Freunde verlassen!\nDiscord
      soll dich holen!\nS\xFC\xDFe Celestia!\nFliegende Federn!\nM\xF6gen die G\xF6ttinnen
      dich verdammen!\nPferde\xE4pfel!\nPegasus H\xF6rner!\nWas zum Heuhaufen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018184
    m_Localized: "2. Profanit\xE4t.\nDieser Abschnitt enth\xE4lt Beispiele f\xFCr
      Fl\xFCche, die in der Gesellschaft als tabu gelten. In den meisten F\xE4llen
      enth\xE4lt es missbr\xE4uchliche W\xF6rter, um einer Phrase mehr Nachdruck
      und Sch\xE4rfe zu verleihen. Wir empfehlen, nur in Gegenwart von Ihnen bekannten
      Ponys auf sie zur\xFCckzugreifen, die von einem solchen Gef\xFChlsausdruck
      nicht beleidigt werden, und sie kategorisch nicht in der N\xE4he von Fohlen,
      Strafverfolgungsbeamten oder Aufsehern zu verwenden.\nFuck!\nFuckity-fuck!\nFick
      dich mit deinem Horn!\nVerfickt nochmal!\nHalt dein verdammtes Maul!\nFick
      dich(euch) selbst!\nFick deinen(euren) Arsch mit dem Huf!\n(richtet sich gegen
      Hengste) J\xE4mmerlicher Drachenficker!\nParasprite P\xFCmmel!\nJ\xE4mmerliche
      Schlampe!\nSohn einer Schlampe!\nJ\xE4mmerliche Fotze!\n(richtet sich gegen
      Fohlen) Verdammte Hure!\n(gilt f\xFCr Einhorn / Hengste) Setz dich auf mein
      Horn und drehe dich!\nMutterficker schwanzlutscher!\nBis zur Unkenntlichkeit
      beschissen!\nK\xFCss meinen Arsch, du beschissener kleiner Mutterficker-Bastard!\nHufe
      mir die verfickten Schl\xFCssel r\xFCber, du Schwanzlutscher, was bei Tartarus?\n3.
      Blasphemie.\nDieser Teil enth\xE4lt h\xE4ssliche und schmutzige Fl\xFCche,
      die bis zu einem gewissen Grad die g\xF6ttlichen Prinzessinnen Celestia und
      Luna mit einschlie\xDFen. Viele glauben, dass es eine S\xFCnde an sich ist,
      sie auf solch h\xE4ssliche und unh\xF6fliche Weise zu erw\xE4hnen, und unsere
      himmlischen G\xF6nner dulden eine solche Einstellung zu sich selbst m\xF6glicherweise
      nicht. Verwenden Sie sie daher nur auf eigenes Risiko.\nOh fick mich mit Celestias
      Hufen!\nLuna soll dich(sie) mit ihren Horn vergewaltigen!\nLuna fick mich mit
      dem Mond.\nLuna schei\xDFt Mondsteine!\nSteck dein Horn dort hin wo bei Celestia
      keine Sonne scheint!\nSonneneruptions-Orgasmus von Celestia!\nLuna schiebe
      meine Fotze voll mit Mondstein und schick mich nach Hause.\nCelestia stopft
      meinen ***** voll mit einem Huf Sonnenfeuer!\nLunas Euter!\nCelestia blase
      mir einen!\nCelestias Sonneneruptions-Euter!\nLuna besorgs mir mit deinen Fl\xFCgeln.\nOh
      G\xF6ttin fick mich dreimal verflucht!\nCelestias Sonnen-Euter libido!\nLuna-finsterer
      Orgasms!\nHeilig hei\xDFer sex mit Celestia!\n\nFazit.\nEs spielt keine Rolle,
      welche Art von Fl\xFCchen Sie verwenden und wie sie miteinander interagieren.
      Denken Sie daran, dass das Wichtigste bei jedem Schimpfwort seine Relevanz
      ist. Die F\xE4higkeit, zu wissen, wo und wann Sie k\xF6nnen und wo und wann
      Sie nicht Schimpfen sollten, hilft Ihnen, Ihre Kultur zu bewahren und wird
      nicht als vulg\xE4r angesehen, und schafft gleichzeitig das Bild eines harten
      und z\xE4hen Ponys. Daher ist es am besten, wenn Sie vor Beginn der Demonstration
      des Wissens aus Ihrem Buch beurteilen k\xF6nnen, unter welchen Bedingungen
      Ihre Gespr\xE4chsteilnehme das Fluchen f\xFCr angemessen halten und welche
      Arten von Schimpfw\xF6rtern unter ihnen am h\xE4ufigsten vorkommen.\nViel Gl\xFCck
      mit dieser schwierigen, aber edlen Kunst!\nBonusmaterial.\nAls unser Autorenteam
      an diesem Buch arbeitete, hatten wir tats\xE4chlich nicht damit gerechnet,
      nach dem Abschluss zus\xE4tzliches Material hinzuzuf\xFCgen. Das im Folgenden
      vorgestellte Werk ist jedoch ohne Zweifel aufgrund seiner bedingungslosen Einzigartigkeit
      und au\xDFerordentlichen Relevanz lediglich verpflichtet, auf diesen Seiten
      zu erscheinen. Dieser Text wurde freundlicherweise von einem Vertreter der
      Bibliothek unseres Stable zur Verf\xFCgung gestellt, der anonym bleiben wollte,
      und ist eine gut dokumentierte Tirade eines hohen Beamten, der viele Jahrhunderte
      vor dem Krieg lebte. Ihre Einzigartigkeit liegt in der Tatsache, dass sie vom
      Autor mit ihrer eindrucksvollen L\xE4nge und unglaublichen Wortvielfalt ohne
      Vorbereitung und ohne Absicht zum Ausdruck gebracht wurde, um in die Geschichte
      einzutreten, jedoch nur um die eingeschlafene k\xF6nigliche Garde zu tadeln.
      Durch die Bem\xFChungen der Adjutantin von Prinzessin Celestia wurde dieses
      Impromptu in seiner urspr\xFCnglichen Form erhalten und aufgezeichnet, und
      trotz der F\xFClle von \xFCberholten W\xF6rtern ist es heute sicherlich ein
      Beispiel f\xFCr un\xFCbertroffene Meisterschaft in der Kunst des Schmutzigen,
      aber so farbenfrohen und erstaunliches Fluchen (und die erstaunliche Kraft
      der Lunge).\nDu miserabler Bastard, blutiger, hosenpissender Trottel, Mutterficker-Idiot,
      Arschfick von einem Timberwolf, furzend riechende Made, eierleckender Wichser,
      eiskalter Hurensohn, Zebra-Buckel-insektenfressendes Arschloch, Discord`s Hodensack,
      Tireks Schwanzlutscher Entschuldigung f\xFCr eine Wache, cyka blyat, wenn ich
      dich jemals wieder an deinem verdammten Posten schlafen sehe, dann werde ich,
      um celestias willen, meinen Huf so weit in deinen Arsch schieben, dass das
      Wasser auf meinem Knie deinen Durst stillt Bevor du \xFCberhaupt Schei\xDFe
      sagen kannst, verstehst du das verdammt noch mal ?!\n| * Die folgenden Abschnitte
      enthalten Beispiele f\xFCr so unh\xF6fliches und unanst\xE4ndiges Schimpfen,
      dass selbst ein erfahrener Bandit sein Vokabular mit mehr als einem neuen Satz
      bereichern k\xF6nnte *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018185
    m_Localized: Todeszone
    m_Metadata:
      m_Items: []
  - m_Id: 2742018186
    m_Localized: "Achtung!\nDu betrittst die Todeszone. Hier musst du ohne Kontrollpunkte
      auskommen, ohne zur Basis zur\xFCckkehren zu k\xF6nnen, ohne H\xE4ndler und
      \xC4rzte. Bevor du weiter machst, stelle sicher, dass du bereit bist, \xFCber
      volle Gesundheit, gen\xFCgend Munition, Medikamente und Sprengstoff f\xFCr
      verschlossene T\xFCren verf\xFCgst und ob deine Ausr\xFCstung repariert und
      kampfbereit ist.\nZum Betreten ben\xF6tigst du eine elektromagnetische Impuls-Bombe.
      Eine Bombe gew\xE4hrt dir einen Eintritt. Wenn du das Bewusstsein verlierst
      oder zur Basis zur\xFCckkehrst, wird der Eingang wieder geschlossen und du
      musst eine weitere Bombe verwenden.\nDer Durchlauf bis zum Ende kann mehr als
      eine Stunde dauern.\nObwohl du die Beute und die gesammelte Erfahrung beh\xE4lst,
      wird der Fortschritt nicht gespeichert! Du kannst diese Zone so oft durchlaufen,
      wie du m\xF6chtest, jedoch jedes Mal von Anfang an.\nIm letzten Raum erh\xE4lst
      du eine wertvolle Belohnung. Viel Gl\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018187
    m_Localized: Ghule
    m_Metadata:
      m_Items: []
  - m_Id: 2742018188
    m_Localized: "Ghule.\nDas erste Mal dass ich einen Ghul sah war etwa eine Woche
      nachdem ich meine erinnerung verloren hatte. Um ehrlich zu sein habe ich gar
      nicht verstanden was ich da gesehen habe. Ein f\xFCrchterlich aussehendes Pony
      st\xFCrzte direkt auf mich zu und knurrte wie ein wildes Tier. Ich hatte es
      kaum geschafft zu entkommen. Dann dachte ich dass es vielleicht nur mit einer
      seltsamen Krankheit befallen war. Wie auch immer, ein paar Tage sp\xE4ter hatte
      ich die gelegenheit so eine Kreatur genauer zu untersuchen. Ich befand mich
      im zweiten Sockwerk eines alten Geb\xE4udes und in einem der Zimmer war ein
      riesiges Loch im Boden. Durch dieses Loch konnte ich zwei von ihnen sehen.
      Ich schlich mich leise an den Rand und studierte ihr Aussehen. Es waren Leichen,
      tats\xE4chlich halb verfallene Leichen! Sie atmeten nicht, bewegten sich nicht
      und starrten einfach nur apatisch auf die Wand vor ihnen. Seit dem habe ich
      versucht diesen Kreaturen aus dem Weg zu gehen. Bis ich dann auf ein Lager
      voller lebendiger und freundlicher Ponys stie\xDF.\nNachdem ich mich dort eingelebt
      hatte begann ich die Bewohner dort nach der Welt um mich herum zu fragen. Ich
      habe dort viel gelernt, aber was wirklich wichtig ist ist dass ich herausgefunden
      habe das Ghule tats\xE4chlich eine Art Leben in sich tragen. Ja wirklich, sie
      sind nur wie Marionetten, die durch Magie kontrolliert werden aber sie leben!
      Es ist seltsam, wirklich seltsam. Wie kann ein Organismus der derartig verst\xFCmmelt
      ist noch leben? Leider konnten mir die Ponys im Lager darauf keine ANtwort
      geben. Ich beschloss die Fragen dar\xFCber in meine Aufgabenliste mit aufzunehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018189
    m_Localized: "Nachdem ich etwas \xFCber das Rainbow Projekt in Erfahrung gebracht
      und die Daten diesen verr\xFCckten \"Mentor\" geschickt hatte. Widmete ich
      mich wieder meinen Fragen. Leider konnte ich von den K\xF6rpern der Ghule nur
      so viel lernen: Das K\xF6rpergewebe bleibt nach dem Tod des besitzers tot und
      zeigt keine Lebenszeichen... Ich erkannte dass ich mit Testsubjekten unter
      Laborbedingungen arbeiten musste, um brauchbare Ergebnisse zu erhalten. Ich
      glaube nicht dass die Ponys im Lager dar\xFCber erfreut w\xE4ren wenn ich eine
      stinkende Leiche mitbringe und sie seziere. Es sieht so aus als m\xFCsste ich
      mir einen Abgeschiedeneren Ort daf\xFCr suchen.\nIch habe mir z\xFCgig einen
      Platz f\xFCr meine Experimente gesucht. Die alten Abwasserkan\xE4le sind voll
      mit Testsubjekten f\xFCr meine Forschungen. Au\xDFerdem ist es leicht sich
      weiter oben vor ihnen zu verstecken, da die Ghule nicht dort hin gehen. - Dort
      oben lauert die gr\xF6\xDFte Gefahr von allem. Wirklich, ich habe keine Ahnung
      warum diese Ponys dort oben so grausam sind.\nNaja, im T\xE4nzelnden Pony l\xE4uft
      alles gut, ich hoffe dass ich dort in der n\xE4chsten Zeit nicht gebraucht
      werde. Das sind gute Ponys dort, die werden schon mal eine Weile ohne mich
      zurecht kommen. Nur f\xFCr den Fall habe ich Calamity informiert dass ich f\xFCr
      eine Woche weg bin, damit sie mich finden falls mir etwas passiert."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018190
    m_Localized: "Und nun bin ich hier. Bei Celestia, was f\xFCr ein Gestank! Aber
      ich hatte Gl\xFCck nach nur wenigen Sunden einen so abgelegenen Ort gefunden
      zu haben. Hier oben werden die mich nicht mitbekommen und falls doch k\xF6nnen
      diese Zombies sowieso nicht so hoch springen. Ich habe meine Sachen ausgepackt
      und das Feldlabor vorbereitet. Es ist nun Zeit wissenschaftlich vorzugehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018191
    m_Localized: "Ich habe einen von ihnen gefangen. Ihn leben zu erwischen (falls
      man das \xFCberhaupt so nennen kann) erwies sich leider als unm\xF6glich. Ich
      brachte ihn in mein Labor und bedeckte ihn mit einer Decke damit sich der Gestank
      nicht so sehr ausbreiten konnte. Zuerst habe ich das Gewebe auf aktive Prozesse
      untersucht. Eine detailierte Analyse ergab das gleiche Ergebnis wie zuvor.
      Kurzgesagt: Die aktiven biologischen Prozesse des K\xF6rpers haben schon vor
      sehr langer Zeit aufgeh\xF6rt. Dies betrifft nicht nur lebenswichtige Funktionen
      sondern auch das K\xF6rpergewebe. Parasiten und Pilze sind im K\xF6rper jedoch
      nicht vorhanden. So gar Spuren von Mikroorganismen die totes Fleisch zersetzen
      sind fast nicht auszumachen! Offenbar zerst\xF6rt etwas au\xDFerst methodeisch
      den K\xF6rper als dass es versucht das Fleisch zu fressen. Irgendetwas..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018192
    m_Localized: "Die anschlie\xDFende Untersuchung verschiedener Gewebeproben einschlie\xDFlich
      des Gehirns ergab keine biochemischen Unterschiede zu normalen toten Gewebe.
      Geist und Seele haben dieser traurigen Kreatur haben den K\xF6rper schon lange
      verlassen. Die interessanteren Ergebnisse stammen jedoch aus einem Experiment
      dass ich schon viel fr\xFCher durchf\xFChren wollte: Der K\xF6rper enth\xE4lt
      Reste von Magie. Leider ist sie auf Grund des Alters der Leiche fast vollst\xE4ndig
      verschwunden und ich kann nicht feststellen um welche Art Magie es sich handelt
      und was f\xFCr ein b\xF6ses Pony das getan hat. Tatsache ist dass es ein ziemlich
      b\xF6sartiges Pony gewesen sein muss. Nur ein Monster k\xF6nnte sich so \xFCber
      die Natur lustig machen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018193
    m_Localized: "Ich habe es geschafft einen lebenden Ghul zu fangen! Es war schwierig
      aber das war es Wert. Und obwohl ich hier vor Ort meine Beobachtungen am lebenden
      K\xF6rper anstellen musste habe ich alles herausgefunden was ich brauchte.
      Ich habe die magischen Str\xF6me die den K\xF6rper des Ghuls bewegen gr\xFCndlich
      studiert. Es ist mir v\xF6llig unbekannt um welche Art von Pony-Magie es sich
      dabei handelt. Der K\xF6rper scheint von einem dunklen Netz umspannt zu sein,
      dessen Zentrum sich im Kopf befindet. Dieses Netzwerk spricht die Gliedma\xDFen
      an, weckt das Muskelged\xE4chtnis und zwingt sie sich zu bewegen. Leider gibt
      es keine h\xF6here Gehirnaktivit\xE4t, nur tierische Instinkte. Und dennoch,
      vielleicht gibt es irgendwo Ghule in denen die Magie so stark ist, dass sie
      ihren Geist wiederbelebt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018194
    m_Localized: "Ich vergrub mich in den B\xFCchern die ich mitgebracht hatte um
      Hinweise auf diese seltsame Magie zu finden.Und ich habe etwas herausgefunden!
      Solche Hexerei ist nichts anderes als uralte Zebramagie - framdartige Ponys
      gegen die laut Calamity, unsere Vorfahren vor fast 200 Jahren krieg gef\xFChrt
      haben, wobei die ganze Welt verbrannte. Aber ich verstehe ehrlich gesagt nicht
      woher das kommt. Gehen die Zebras immer noch umher und verfluchen tote Ponys?
      No, Das ist dumm, warum sollten sie das tun? Wie auch immer, sieht so aus als
      ob ich jetzt etwas \xFCber diesen Krieg herausfinden sollte. In den B\xFCchern
      werde ich wohl kaum etwas dar\xFCber finden. Ich bleibe noch ein wenig hier,
      vielleicht kann ich ja noch etwas herausfinden. Irgendwas wichtiges."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018195
    m_Localized: "Notiz 1\nMein Psychologe empfiehlt dringend, dass ich mir jedes
      Mal Notizen zu machen, wenn mir etwas Sorgen bereitet. Ich wei\xDF nicht, wie
      diese Technik meine Nerven beruhigen soll, aber im Moment mache ich mir Sorgen
      um zwei Dinge. Erstens ist es verboten, in unserer Abteilung pers\xF6nliche
      Notizen zu machen, damit wir keine \"Ideen stehlen\" k\xF6nnen. Und Zweitens
      ist es uns untersagt, auf unseren eigenen Terminals ein Passwort festzulegen.
      Vielleicht sind diese Sachen Grund genug, um besorgt zu sein und die ersten
      Aufzeichnungen dar\xFCber zu machen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018196
    m_Localized: "Notiz 2\nIch w\xFCrde nicht behaupten, dass wir sonst wenig zu
      tun haben, aber die letzten Tage waren einfach schrecklich! Ich bin jeden Tag
      erst sp\xE4t nach Hause gekommen! Diese Auftr\xE4ge des M.A.S. treiben mich
      in den Wahnsinn! Wenn wir die Entwicklung dieses Prozessors innerhalb der n\xE4chsten
      Tage nicht abgeschlossen haben, werde ich meinen Urlaub fr\xFCher nehmen und
      mich zu Hause mit Kistenweise Alkohol einschlie\xDFen. Sie w\xFCrden mich nat\xFCrlich
      nicht lassen, aber vielleicht hilft Bloom, wir kennen uns schon lange, er wird
      meine Situation sicherlich verstehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018197
    m_Localized: "Notize 3\nEs gibt einen neuen f\xFChrenden Wissenschaftler in unserer
      Abteilung, Morning Star. Und sie ist ein s\xFC\xDF, ein hei\xDFe-Flanke Erdpony.
      Aber es ist nicht einmal ihr Aussehen, worauf es mir ankommt. Sie hat so eine
      Leidenschaft bei der Arbeit, so einen Funken in ihren Augen ... An ihr ist
      etwas, das ist sicher. Und um die Wahrheit zu sagen, ich habe das Gef\xFChl,
      dass ich sie mag. Ich muss etwas unternehmen. Was ist, wenn das unsere Chance
      ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018198
    m_Localized: "Notiz 4\nIch habe mich entschieden. Heute werde ich zu Morning
      gehen und sie zum Abendessen einladen. Ich bin m\xFCde von diesen ganzen Andeutungen
      in Gespr\xE4chen und kleinen Seitenblicken. Ich muss nur den Mut aufbringen.
      Ja, ich schaffe das. Ich war schon immer mutig, ich kann das. Ich muss es nur
      versuchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018199
    m_Localized: "Notiz 5\nIch habe beunruhigende Ger\xFCchte in der Abteilung vernommen.
      Sie sagen, es k\xF6nnte zur Mobilisierung von Fabrikarbeitern an die Front
      kommen. Und nicht nur einfache Angestellte, sondern auch Ingenieure. Das ist
      umso seltsamer, weil in den Nachrichten von der Front keine gr\xF6\xDFeren
      Niederlagen gemeldet wurden. Sie w\xFCrden uns doch nicht anl\xFCgen, oder?
      Ich muss mit Morning dar\xFCber sprechen. Wenn es soweit ist, dass einer von
      uns beiden weggebracht wird, muss ich mir etwas einfallen lassen. Wir sind
      nun ein Paar geworden, und wollen nicht getrennt werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018200
    m_Localized: "Notiz 6\nDie Aufseher hat mein Tagebuch gelesen. Und darin schrieb
      ich zu viele Dinge auf, die niemand wissen sollten. \xDCber Bloom, zum Beispiel.
      Unter anderen Umst\xE4nden h\xE4tte kein Pony aus diesem \"freiwillige Helfer\"
      Zeug ein gro\xDFes Ding gemacht, aber jetzt suchen sie nach Ponys, die sie
      an die Front schicken k\xF6nnen, anstatt ihre eigenen kostbaren \xC4rsche zu
      riskieren. Kurz gesagt, sie haben mit den Untersuchungen begonnen, und ich
      sitze jetzt hier und bei\xDFe mir in die Hufe. Zumindest hat Bloom schon vorher
      aufgeh\xF6rt, er ist also in Sicherheit. Wenn ich nur hier rauskommen k\xF6nnte..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018201
    m_Localized: "Notiz 7\nIch f\xFCrchte, das ist mein letzter Eintrag hier. Offiziell
      ergaben die Untersuchungen keine Ergebnisse. Aber mein Name wurde auf die Liste
      der Angestellten gesetzt, die in einer Woche ins Milit\xE4rlager geschickt
      werden. Sie sagten, mir wird nichts wird passieren, ich solle ganz ruhig bleiben.
      Nur ein paar Wochen dort Marschieren und mit der Waffen Schie\xDFen \xFCben.
      Aber habe geh\xF6rt, dass Ponys aus der Trottingham-Fabrik ebenfalls wie wir
      \"ausgew\xE4hlt\" und, zwei Wochen sp\xE4ter in den Krieg geschickt wurden.
      Sie versprachen mir, dass mein Arbeitsplatz nicht ber\xFChrt w\xFCrde, bis
      ich zur\xFCckkehre.\nAber das ist nicht mal alles, was mich jetzt qu\xE4lt.
      Sobald Morning herausfindet, dass sie mich eingezogen haben, meldete sie sich
      sofort freiwillig. Das w\xFCrde jedes Pony schockieren, weil sie eine der besten
      f\xFChrenden Wissenschaftlerinnen in der Geschichte der Abteilung ist. Aber
      sie bestand fest darauf. Ich wei\xDF nicht, was ich jetzt denken soll. Auf
      der einen Seite w\xE4re sie bei mir und auf der anderen Seite - was passiert,
      wenn wir in die Schlacht geschickt werden? Celestia sch\xFCtze uns."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018202
    m_Localized: "*Von: Scarlet Stone\nNachricht empfangen: Vor 75 073 Tagen.\nBetreff:
      neue bestellung*\n\"Hallo, Morning Ich hoffe ich st\xF6re dich nicht bei etwas.
      Ich habe einen Anruf vom Ministerium f\xFCr Kriegstechnologie bekommen. Nichts
      Ernstes, nein, mach dir blos keine Sorgen! Im Gegenteil, sie wollen eine neue
      Bestellung aufgeben. Um ehrlich zu sein wollen sie, dass wir sofort damit anfangen.
      Zwar wurden mir keine konkreten Termine genannt, aber wenn wir in zwei Monaten
      den Prototypen erstellen und testen k\xF6nnen, w\xE4ren die Ponys aus dem Ministerium
      sehr erfreut.\nIch bringe die technischen Unterlagen dann pers\xF6nlich mit,
      die Idee ist folgende: Das M.W.T. und das M.A.S. fangen jetzt damit an, aktiv
      an neuen Schutzma\xDFnahmen f\xFCr unsere Soldaten an der Front zu arbeiten.
      Applejack pers\xF6nlich gab den Befehl. Das Projekt ist ungeheuer ehrgeizig
      und komplex, aber wenn es gut l\xE4uft, werden wir am Schluss nicht nur eine
      R\xFCstung haben die einen Soldaten perfekt sch\xFCtzt, sondern ihn auch noch
      die M\xF6glichkeit gibt diese wie eine zweite Haut zu tragen. Der grundlegende
      Aufbau der R\xFCstung wurde bereits entwickelt, und jetzt ist jedes an dem
      Projekt beteiligte Unternehmen damit beauftragt worden eines der Komponenten
      zu fertigen. Unserer Einrichtung hat man einen sehr wichtigen Teil anvertraut:
      Wir m\xFCssen das Material herstellen aus dem die Schutzplatten gegossen werden.
      Die Anforderungen sind sehr streng aber wir bekommen das hin. Ich komme gleich
      nach dem Mittagessen zu dir also gehe nirgendwo anders hin.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018203
    m_Localized: "*An: Scarlet Stone\nNachricht gesendet: Vor 75 073 Tagen.\nBetreff:
      (Re) neue bestellung*\n\"Hey Chef, as sind Hervorragende Neuigkeiten, unsere
      Abteilung hat gerade den letzten Teil des aktuellen Projekts abgeschlossen
      und macht gerade einige Qualit\xE4tstests. Ich werde da sein, kein Problem,
      ich bringe mein Essen sowieso von zu Hause mit. Und was die Bestellung betrifft,
      ich nehme dich beim Wort, wir schaffen das in einer Woche. Wir haben Unmengen
      an Materialdaten von den Roboterauftr\xE4gen, ich wette, wir m\xFCssen nicht
      einmal viel machen, nur die Legierung ein wenig \xE4ndern, das ist alles\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018204
    m_Localized: "*Von: Scarlet Stone\nNachricht empfangen: Vor 75 011 Tagen.\nBetreff:
      material*\n\"Guten Morgen, Es tut mir leid Morning, dass ich nicht selbst zu
      dir kommen konnte, ich wei\xDF, dass du solche Dinge lieber pers\xF6nlich besprichst,
      aber ich musste f\xFCr eine dringende Angelegenheit weg. Es ist jetzt zwei
      Monate her, dass deine Abteilung den Auftrag f\xFCr das Material des Stahl-Pony
      Projekts erhalten hat. Ich wei\xDF, dass du die ganze Zeit \xFCber dein Bestes
      gegeben hast, aber die Ponys aus dem Ministerium interessieren sich nunmal
      nur f\xFCr Ergebnisse. Ich habe den Bericht \xFCber die neuesten Entwicklungen
      gelesen, den du mir vor drei Tagen gebracht hast. Du hast gute Arbeit geleistet,
      und ich bin sehr stolz auf dich. Aber ich muss wissen, was ich dem M.W.T. sagen
      soll. Wie lange wird es noch dauern, bis das Projekt abgeschlossen ist? Bitte
      glaub blos nicht, dass ich hier Druck auf dich aus\xFCbe, das w\xFCrde ich
      nie tun, du kennst mich\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018205
    m_Localized: "*An: Scarlet Stone\nNachricht gesendet: Vor 75 011 Tagen.\nBetreff:
      (Re) material*\n\"Hallo. Sicher Chef, Das verstehe ich alles. Aber die Anspr\xFCche
      des Ministeriums sind einfach zu hoch! So etwas haben wir noch nie gemacht,
      wei\xDFt du? Wir brauchen noch mindestens eine Woche, um das Material zu testen,
      und zwei weitere, falls etwas schief geht. Frage sie also mal ob sie mit einem
      Monat, einverstanden sind\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018206
    m_Localized: "*Von: Scarlet Stone\nNachricht empfangen: Vor 74 975 Tagen.\nBetreff:
      frist*\n\"Guten Morgen, Bitte vergib mir, dass ich dir das jetzt schreiben
      muss. Aber ich habe gerade einen Anruf vom M.W.T. bekommen. Die k\xF6nnen nicht
      mehr l\xE4nger warten. Alle Fristen sind verstrichen. Wir haben ein Ultimatum
      erhalten: Wir m\xFCssen die Arbeit in drei Tagen abschlie\xDFen, andernfalls
      werden alle Daten des Projekts eingezogen und an ein anderes Unternehmen \xFCbergeben.
      Bitte sag mir, dass wir das schaffen!\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018207
    m_Localized: "*An: Scarlet Stone\nNachricht gesendet: Vor 74 975 Tagen.\nBetreff:
      (Re) frist*\n\"Hey meine Beste, mach dir nicht so viele Sorgen! Beruhige dich,
      kein Grund zur Panik, uns geht es gro\xDFartig! Ich mache gerade die letzten
      Hufgriffe in der Dokumentation und komme dann zu dir, um Bericht zu erstatten.
      Es ist alles bereit! Das Material erf\xFCllt die Anforderungen von A bis Z.
      Du kannst diese Bigwigs sofort anrufen und sie hier her einladen, um unser
      Baby zu untersuchen, denn wenn ich das tue, kriechen sie auf Knien zu dir,
      um sich zu entschuldigen! Ich kann sie erschrecken wenn du m\xF6chtest! Ich
      komme in einer Stunde vorbei, keine Sorge\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018208
    m_Localized: "Proud Pie`s Labor-Tagebuch\nIch habe die Sonne nicht mehr zu gesicht
      bekommen seit die Zebras mit dem Mega-Zauber angegriffen haben und wir hier
      eingeschlossen worden. So eine Kleinigkeit, nat\xFCrliches Licht. Jeden Monat
      sehne ich mich mehr nach der Oberfl\xE4che. Wir haben hier nur ein paar kleine
      Obstg\xE4rten und ohne die Magie unseres Einhorn-Personals w\xE4ren wir vermutlich
      nicht einmal in der Lage etwas anzubauen. Und das nennt sich Technologie-Stable.
      Keiner glaubt daran dass die Ponys hier viele Jahre oder gar Jahrzehnte \xFCberleben
      m\xFCssten. Nein... so lange bleiben wir bestimmt nicht hier, das kann nicht
      sein..\nSo oder so muss die Arbeit weiter gehen. Wir m\xFCssen vorerst im Untergrund
      bleiben, dann k\xF6nnen wir Equestria zur\xFCckerobern! Wenn wir das schaffen
      wollen haben wir viel zutun. Nichts ist erfrischender als die Anerkennung f\xFCr
      die Leistungen und die Qualit\xE4t meiner hervorragenden Arbeit. Ich muss einfach
      Tag f\xFCr Tag hart arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018209
    m_Localized: "Wir haben signifikante Fortschritte im Projekt gemacht. Hier im
      Stable sind die Ressourcen sehr begrenzt aber trotz der Umst\xE4nde geht es
      mir gut. Ich habe es geschafft die Lernf\xE4higkeit der Equidroids zu steigern.
      Durch eine einfache erh\xF6hung des Kurzzeichtspeichers wurde es m\xF6glich
      der Maschine beizubringen, einen fast bewussten Dialog mit einem echten Pony
      zu f\xFChren und sich an seine Vorlieben zu erinnern. Das Abspeichern erfolgt
      nicht immer korrekt aber die Behebung dieses ungl\xFCcklichen Fehlers ist nur
      eine Frage der Zeit.\nWie auch immer, nicht jedes Pony hier ist so produktiv
      wie ich. Nach so langer Zeit konnte unsere Kommunikationsabteilung immer noch
      keinen Kontakt zu einem der Institute an der Oberfl\xE4che herstellen. Mit
      den anderen Stablen kein Problem, aber nicht mit Equestria. Ich wei\xDF dass
      eine gro\xDFe Anzahl an Mega-Zaubern auf die Oberfl\xE4che getroffen ist aber
      es kann nicht sein dass alles zerst\xF6rt sein soll. Das ist Unsinn! Das ist
      verschenktes Heu."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018210
    m_Localized: "Ein weiterer Monat vergebens. Die Parasiten der Kommunikationsabteilung
      konnten \xFCblich kein Pony erreichen, und der Overmare lehnt alle meine Anfragen
      ab, Sp\xE4her nach Oben zu schicken. Warum, frage ich mich? Ich pers\xF6nlich
      kann keine logischen Gr\xFCnde daf\xFCr sehen es nicht zu tun.\nEs ist mir
      gelungen, alle Equidroids mit einer gemeinsamen Stable-Datenbank zu verbinden.
      Dazu haben wir ein paar Komponenten der Ultra-Wachbots nehmen m\xFCssen aber
      wir brauchten ja sowieso nicht so viele von diesen ungeschickten Dingern. In
      den engen Mauern des Stable w\xFCrden sie ohnehin mehr schaden als n\xFCtzen.
      Durch den Zugriff der Equidroids erhalten sie alle n\xF6tigen Informationen
      die sie brauchen. Eine unbezahlbare Verbesserung!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018211
    m_Localized: "Hier im Stable ist eine Verschw\xF6rung im Gange! Diese wertlosen
      Dummk\xF6pfe sind eifers\xFCchtig auf die wenigen talentierten Ponys die hier
      eingesperrt sind und werfen den anderen Sand ins Getriebe. Sie l\xE4cheln einen
      an und versprechen ihr \"bestes\" zu geben, w\xE4hrend sie hinter ihrem R\xFCcken
      Sabotage planen, und planen und planen. Wieso habe ich das nicht gleich erkannt?\nWenn
      ein Pony wertlos ist ist alles wertlos. Trotz ihrer Bem\xFChungen konnten mich
      diese Blutsauger nicht daran hindern meine Arbeit fortzusetzen. Leider ist
      es unter diesen Umst\xE4nden unm\xF6glich eine v\xF6llig autarke k\xFCnstliche
      Intelligenz zu erschaffen. Es gelang mir jedoch ein Programm zu schreiben welches
      das Bewusstsein und die Identit\xE4t eines Ponys zu fast hundert Prozent nachahmt.
      Ich habe die Sweetie Cake genannt, und sie wird meine erste und einzige vertrauensw\xFCrdige
      Assistentin sein. Wie niemals zuvor brauchte ich jetzt ein Pony dass dieses
      L\xFCgengeflecht entwirren kann. Deshalb gabe ich Sweetie die Pers\xF6nlichkeit
      eines der herausragensden Spionageabwehr-Ponys unserer Zeit. Der Leiterin des
      Ministeriums f\xFCr Moral - Pinkie Pie. Gl\xFCcklicherweise befanden sich alle
      Daten die ich dazu brauchte in der Datenbank. Mal sehen was sie jetzt sagt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018212
    m_Localized: "Die Stunde der Abrechung ist gekommen! Sweety Cake leistet gute
      Arbeit, sie studiert alle Bewohner von Stable 88, und wird bald ihr Urteil
      f\xE4llen. Wer ein Saboteur ist und wer ein ehrlicher B\xFCrger. Wer ein Spion
      ist und wer Equestria teu. Alle Equidroids erhalten eine Liste und f\xFChren
      Kontrollen und SIcherheits\xFCberpr\xFCfungen durch. Ich bin ja kein Tier,
      deswegen wird niemand hingerichtet oder gefoltert. Sobald jedoch alle Saboteure
      ausgemacht und in einer Zelle eingesperrt sind, k\xF6nnen die wahren Patrioten
      Equestrias aufatmen und diese Metallkiste endlich verlassen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018213
    m_Localized: "Bla-bla. Bla-bla-bla. Gut, Gut Gut.\nAlles aufzuschreiben hilft
      mir wenn ich nicht wei\xDF was ich tun soll. Aber ich lasse es niemanden lesen,
      es muss einfach nur mal alles raus.\nIn letzter Zeit ist so viel passiert.
      Aber nur eines z\xE4hlt jetzt, n\xE4mlich dass wir unser Zuhause verloren haben.
      Wir haben Equestria verloren. Jedes Pony in diesem Stable lebt nun mit diesem
      Gedanken. Einige haben es gut aufgenommen und andere nicht. Der arme Apple
      Sugar hatte einen Nervenzusammenbruch und hat versucht hier heraus zu kommen.
      Jetzt liegt er tot vor der T\xFCr, das bricht mir am meisten das Herz.\nIrgendwann
      willst du schreien und nach zehn Minuten liegst du nur noch im Bett und starrst
      ohne einen Gedanken die Wand an. Es gibt hier keine Motivation irgendwas zutun.
      Ich zwinge mich zu arbeiten damit die schreckliche Erkenntnis des Weltuntergangs
      in den Hintergrund r\xFCckt.\nF\xFCr mich ist es noch einfacher weil dort drau\xDFen
      kein Pony war das wir wirklich am Herzen lag. Mein Bruder und mein bester Freund
      sind hier. Aber wir reden nicht. Niemand redet. Anfangs haben wir versucht
      Spa\xDF zu haben, Lieder zu singen und Spiele zu spielen aber das hat alles
      nur noch schlimmer gemacht.\nWir schauen diese Metallw\xE4nde an und fragen
      uns ob dies alles ist was von der Welt noch \xFCbrig ist. Alles was ich jemals
      gekannt habe ist weg. Alles ist verschwunden, verbrannt und hinterlie\xDF nur
      schwarze Asche und verkohlte Skelette. Celestia? Luna? Wer wei\xDF ob sie \xFCberhaupt
      noch leben. Warum haben sie uns nicht besch\xFCtzt? Haben wir Ponys es so auf
      die Spitze getrieben dass selbst die Prinzessinin machtlos waren?\nIch hatte
      eben einen Wutanfall und habe einen Stuhl gegen die Wand geworfen. Das hat
      mir auch nicht geholfen. Ach, schei\xDF drauf."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018214
    m_Localized: "Autorisierung vollst\xE4ndig. Guten Tag, Overmare."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018215
    m_Localized: Overmare? Was hat das Terminal blos.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018216
    m_Localized: Oh, Hier ist eine Aufnahme!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018217
    m_Localized: "\xD6ffne Audiodatei \"Audioaufnahme Rede der Vizepr\xE4sidentin
      von Stable-Tec\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018218
    m_Localized: "Hallo. Hier spricht die Gr\xFCnderin und Vizepr\xE4sidentin der
      Stable-Tec Corporation. Mein Name ist Scootaloo."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018219
    m_Localized: "Sie wurden zum Overmare von Stable-Tecs Stable 88 gew\xE4hlt, was
      in jeder Hinsicht etwas ganz Besonderes ist. Man hat sie ausgew\xE4hlt, wegen
      ihrer Loyalit\xE4t und ihrem Pflichtbewusststein sowohl gegen\xFCber ihren
      mit-Ponys als auch unserem Unternehmen. Und obwohl die Hauptzentrale von Stable-Tec...
      m\xF6glicherweise schon in Tr\xFCmmern liegt, so bleiben unsere Ideale doch
      unersch\xFCtterlich."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018220
    m_Localized: Das besondere an ihrem Stable ist dass er vielleicht die einzige
      Forschungseinrichtung ist die noch bleibt wenn wir... wir alle...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018221
    m_Localized: "Wenn es wirklich... so weit kommen sollte... k\xF6nnen sie sich
      nicht auf Hilfe von au\xDFen verlassen. Nach unseren Berechnungen w\xE4re ein
      gegenseitiger Mega-Zauber Angriff zwischen den Zebras und uns so verheerend
      dass kein Kontrollzentrum an der Oberfl\xE4che \xFCbrig bleiben wird. Ausgenommen
      die Stable."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018222
    m_Localized: "Deshalb ist ihr Stable nicht nur mit allem zum \xDCberleben notwenigen
      ausgestattet, sondern auch dazu um die Forschungen auf v\xF6llig autonome Weise
      fortzusetzen. Und von nun an tragen sie die B\xFCrde alle unsere Fohlen zu
      retten... alle die... die \xFCbrig geblieben sind. Verflixt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018223
    m_Localized: Tut mir Leid.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018224
    m_Localized: "Aber ihr Stable sollte genug sein. Die Projekte ihres Stable sind
      gro\xDFartig und selbst wenn es zum Schlimmsten kommen sollte k\xF6nnen wir
      Equestria damit aus der Asche wieder aufbauen. Eine neue Welt, die besser ist
      als die in die wir uns verwandelt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018225
    m_Localized: "Viel Gl\xFCck. Danke f\xFCr alles was sie bisher erreicht haben
      und f\xFCr alles was sie noch erreichen werden. M\xF6ge das allm\xE4chtige
      Pony sie alle segnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018226
    m_Localized: "Sunrise, du fragst dich jetzt bestimmt wer in deinem Tresor gewesen
      ist und deine Robo-Eule ausgeschlachtet hat. Ich war es, Ruby Glow. Ich bitte
      dich daf\xFCr tausendmal um Entschuldigung, ich werde alles sp\xE4ter erkl\xE4ren
      aber wenn du mal ein paar Minuten dar\xFCber nachdenkst kannst du vielleicht
      erraten f\xFCr WELCHES Projekt ich mir lieber deine Eulen-Innereien ausleihen
      w\xFCrde anstatt ins Lager zu gehen. Du wei\xDFt was hier in letzter Zeit so
      passiert ist und wer dahinter steckt, und wie das alles enden k\xF6nnte. Mein
      Verstand sagt mir dass wir jetzt handeln m\xFCssen wenn wir etwas dagegen tun
      wollen. Sobald du mit dem Lesen fertig bist gehe zu Abschnitt D-5X, ich warte
      dort auf dich. \xDCbrigens bin ich mir sehr wohl dar\xFCber bewusst dass dieser
      Roboter seit ein paar Monaten in deinem Tresor liegt. Sei also nicht all zu
      ver\xE4rgert dar\xFCber."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018227
    m_Localized: "Dr\xFCcken sie die gr\xFCne Taste links neben dem Terminal, um
      den Flugzauber zu aktivieren. ACHTUNG: Die Benutzung dieses Zaubers ist nur
      befugtem Personal gestattet. Die pers\xF6nliche Verwendung dieses Ger\xE4ts
      ist untersagt, Verst\xF6\xDFe werden mit Verwaltungsstrafen geahndet."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018228
    m_Localized: "Wei\xDFt du was f\xFCr die Ewigkeit gemacht ist? Die Entwicklungen
      von M.A.S. Denke nur mal daran: Zwanzig Jahre sind nun vergangen, und nicht
      nur ist dieser Turm nicht eingest\xFCrzt, Auch die Energiequelle funktioniert
      noch! Ich bin so Stolz auf meine Arbeit!\nIch h\xE4tte die gedacht dass ich
      eines Tages nach Manehatten zur\xFCckkehren w\xFCrde. Warum nicht? Nach dem
      Krieg hatte es bestimmt 5 Jahre lang nichts von seinem Glanz verloren. Au\xDFerdem
      gab es hier einige hei\xDFe Stuten. Vielleicht haben die Ghule hier ja nicht
      ihre ganze Sch\xF6nheit eingeb\xFC\xDFt. Das war nat\xFCrlich nur ein Witz.
      Aber was w\xE4re wenn? Vielleicht finde ich hier eine Braut f\xFCr Cherry Strudel,
      sie w\xE4ren ein perfektes Paar.\nIn Ordnung, Spa\xDF bei Seite. Vorerst werde
      ich dieses Geb\xE4ude als Feldlager nutzen. Der Ort ist daf\xFCr perfekt. Wenn
      die Suche erfolgreich verl\xE4uft, kann m\xF6glicherweise unsere ganze Gemeinschaft
      hierher ziehen. Ich kenne zuf\xE4llig ein paar schicke Cafes in der N\xE4he.
      Ich werde auf jeden Fall meinen Schotter zu Crystal Hay bringen. Vielleicht
      hat sich an der Wand, nach der denkw\xFCrdigen Schl\xE4gerei damals der Abdruck
      meiner Stirn immer noch erhalten.\nIch muss sagen, die Stadt hat sich ver\xE4ndert.
      Es f\xFChlt sich irgendwie alles melanchonischer an. Vielleicht kommt mir das
      alles wegen dem Mangel an Sonne so vor. Oder ich kann mich nicht an die leeren
      Stra\xDFen gew\xF6hnen. Die waren hier nie ganz leer, auch nicht in den sp\xE4ten
      Abendstunden. Andererseits sind leere Stra\xDFen besser als Stra\xDFen voll
      mit Banditen und Zombies.\nIch werde besser anfangen zu suchen. Ich habe eine
      Menge Arbeit vor mir."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018229
    m_Localized: "Nichts! Leer, wie das Innere eines Donuts. Es sieht aus als w\xE4re
      bereits eine ganze Armee an Aasfressern hier vorbeigekommen und h\xE4tte alles
      mitgenommen was nicht niet und Nagelfest gewesen ist."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018230
    m_Localized: "Das gibt es nicht. Ernsthaft. Das M.A.S. Geb\xE4ude ist noch bewohnt!
      Ich w\xFCrde es nicht glauben wenn ich es nicht gesehen h\xE4tte! Es scheint
      als h\xE4tten die Schilde den Mega-Zaubern stand gehalten und die Ponys hier
      vor der Explosion gesch\xFCtzt. Jedenfalls habe ich am Eingang zwei Wachleute
      angetroffen. Harte Burschen, mit denen m\xF6chte man sich nicht anlegen. Die
      haben mich hinein gelassen. Barmherzige Celestia dort ist alles wie vorher!
      Ich brach fast in Tr\xE4nen aus mich pl\xF6tzlich in einer anderen Welt wiederzufinden!
      Aber ich bliebt nicht lange dort. Die Bewohner haben mich angeh\xF6rt und mich
      dann rausgeschmissen. Dass ich einmal ein angesehener Angestellter hier gewesen
      bin, und die Fohlen und alten Ponys in unserer Gemeinschaft Schutz brauchen
      war denen egal. Die wollen uns hier nicht. \nSieht ganz so aus als w\xE4re
      ich vergebens hier her gekommen. Ich habe nur alte Wunden wieder aufgerissen.
      Au\xDFerdem habe ich k\xFCrzlich eine Herde Ghule unten gesehen. Hier zu bleiben
      ist nicht mehr sicher und es lohnt sich auch nicht. Ich werde zu meinen Leuten
      zur\xFCckkehren.\nIch k\xF6nnte dieses Terminal nat\xFCrlich mitnehmen, aber
      ich lasse es lieber hier. Es ist sowieso nichts besonderes. Vielleicht liest
      ja noch jemand mein kleines Tagebuch. Wie du! Ja, du da am Tisch! Glaubst du,
      ich wei\xDF nicht dass du da gerade sitzt und diese Zeilen auf dem Bildschirm
      liest? Glaubst du ich kenne deinen Namen nicht, @lp? Das ist richtig Kumpel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018231
    m_Localized: "Was, dein name ist nicht @lp? Aber stell dir mal vor wie sich jemand
      namens @lp an deiner Stelle f\xFChlen w\xFCrde wenn er das liest! Urkomisch
      nicht wahr? Gut, in Ordnung, weiter machen Reisender. M\xF6ge Celestia deine
      Hufe leiten."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018232
    m_Localized: "ACHTUNG: Dieses Material ist nur f\xFCr Mitarbeiter des Ministeriums
      f\xFCr Prestige bestimmt und obligatorisch. Der unbefugte Zugriff auf dieses
      Dokument wird nach dem Kriegsrecht geahndet.\nAktualisierung des Protokolls
      zur Kontrolle unzuverl\xE4ssiger Informationen Nr. 253:\nInfolge des j\xFCngsten
      Vorfalls in Zebratown, hat das Ministerium beschlossen, eine strenge Kontrolle
      aller Informationen in Bezug auf Zebra Einwohner in Equestria zu verh\xE4ngen.
      Autoren und Herausgeber von Nachrichten, historischen und popul\xE4rwissenschaftlichen
      Artikeln, sowie Zensoren hostorischer und kultureller Materialien werden nachdr\xFCcklich
      aufgefordert, die folgenden Punkte zu beachten:\n- Neuigkeiten \xFCber Veranstaltungen,
      an denen Zebras teilgenommen haben;\n- Historische Dokumente, in denen der
      Einfluss von Zebras auf Ereignisse in Equestria erw\xE4hnt wird;\n- Materialien
      zu kulturellen Besonderheiten von Zebras in Equestria;\n- Biographien ber\xFChmter
      Zebras die jemals in Equestria gelebt haben.\nBeim Umgang mit den oben genannten
      Materialien, m\xFCssen folgende Anforderungen erf\xFCllt sein:\n- Vermeiden
      sie positive Bewertungen von Zebras in Verbindung mit Handlungen, Ereignissen
      oder Ph\xE4nomenen;\n- Beseitigen sie alle Informationen \xFCber den positiven
      Einfluss von Zebras auf den Wohlstand von Equestria;\n- F\xFChren sie alle
      historischen Errungenschaften der Equestria Zebras auf Vertreter der Ponys
      zur\xFCck;\n- Erzeugen sie ein negatives und st\xF6rendes Bild von Zebras;"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018233
    m_Localized: "Anmerkung des Herausgebers:\nMeine Freunde, wir haben alle die
      tragischen Ereignisse mitbekommen, die letzte Nacht in Zebratown stattgefunden
      haben. Die Ungerechtigkeit und Grausamkeit dieses Verbrechens verbittert mich,
      aber als Pony mit gro\xDFer Verantwortung muss ich zuerst \xFCber unser gemeinsames
      Bestreben nachdenken - den Schutz von Equestria. Und jetzt ist es mehr als
      offensichtlich, dass unserer Heimatland eine neue Bedrohung gegen\xFCber steht.
      Unser Feind ist unbarmherzig und unehrenhaft, und jetzt hat er einen neuen
      Hebel gefunden, um Druck auf unsere Zivilbev\xF6lkerung auszu\xFCben: Von nun
      an wird er alles tun, um den Willen der Ponys zu brechen, mit unseren Nachbarn
      zu k\xE4mpfen - durch Zebras, die nebeneinander gelebt haben. Seite an Seite
      mit uns seit vielen Jahrzehnten. Der Feind versucht, bei uns Mitleid und Mitgef\xFChl
      f\xFCr ihn zu erregen und ersch\xFCttert unsere Standhaftigkeit, indem er seine
      abscheulichen Taten verurteilt, die aus der b\xF6sartigen Natur der Zebras
      hervorgegangen sind. Und obwohl unsere Zebrauntertanen, zweifellos von unserem
      Beispiel gelernt haben und gr\xF6\xDFtenteils seri\xF6s und vertrauensw\xFCrdig
      sind, werden nicht alle Ponys den Unterschied zwischen unseren Zebras und Feinden
      verstehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018234
    m_Localized: "Meine Freunde, aus unserer Situation kann sich nur eines der folgenden
      Szenarien entwickeln. Erstens werden wir dem Feind erlauben, seine subversiven
      Aktivit\xE4ten fortzusetzen und gute Ponys zum Konformismus und Verrat zu neigen,
      und der Tag wird kommen, an dem die verwirrten Untertanen unserer sch\xF6nen
      Prinzessin Luna die Tore ihrer eigenen St\xE4dte f\xFCr Zebraterroristen und
      Saboteure \xF6ffnen werden. Zweitens werden wir als wahre Patrioten und Besch\xFCtzer
      Equestrias alle Anstrengungen unternehmen, um den Feind seiner Waffen und seines
      Giftes zu berauben und die Wurzel des Problems zu beseitigen. Kein Pony hat
      Zweifel, wie genau unsere Ministerien, handeln sollen. Und obwohl dies bedeutet,
      dass die Zebramotive in der \xD6ffentlichkeit m\xF6glicherweise ungerechtfertigt
      angelaufen sind, sollten Sie als vern\xFCnftige Ponys verstehen, dass diese
      Ma\xDFnahmen in erster Linie die Zebras selbst sch\xFCtzen und die schmutzigen
      Hufe unserer Feinde von ihnen fernhalten. Von nun an werden wir mit aller Sorgfalt
      daran arbeiten, die giftigen Z\xE4hne der tr\xFCgerischen Schlange zu zerbrechen,
      die unsere wehrlosen Mitb\xFCrger bedroht. Und wenn jeder von uns alle Anstrengungen
      unternimmt und sich darauf konzentriert, gef\xE4hrliches Wissen auszurotten,
      wird sich unser Mutterland durchsetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018235
    m_Localized: "*Von: Morning Rain\nNachricht empfangen vor: 73594 Tagen\nBetreff:
      Diebstahl*\n\"Ich muss Ihnen leider mitteilen, dass das Ereignis vor einer
      Woche, das urspr\xFCnglich einmalig durchgef\xFChrt werden sollte, offensichtlich
      nur das erste in einer Reihe systematischer subversiver Aktivit\xE4ten gegen
      unser Ministerium ist. Dar\xFCber hinaus besteht die M\xF6glichkeit, dass Ponys
      aus dem Ministerium f\xFCr Moral selbst dahinter stecken.\nLetzte Nacht hat
      eine unbekannte Person das Lager des Ministeriums in der Stadt Manehattan unrechtm\xE4\xDFig
      infiltriert. Das Ziel des Eindringlings war erneut die Verbreitung von Plakaten,
      die dem j\xFCngsten Sieg unserer Truppen \xFCber Zebras auf den Grizley-Inseln
      gewidmet waren. Der gesamte Umlauf wurde abgenommen, andere Wertsachen, die
      im Lager aufbewahrt wurden, blieben unber\xFChrt. In derselben Nacht fanden
      die Wachen Dutzende von Graffiti \"In Erinnerung an das Massaker auf den Grizzlyinseln!\".
      Angestellte meiner Abteilung mussten aus den Betten um aufzur\xE4umen, Ger\xFCcht
      in der Bev\xF6lkerung wurden vermieden. Ein entsprechendes Gespr\xE4ch wurde
      mit den Wachen gef\xFChrt.\nDas Hauptmerkmal dieses Vorfalls ist, dass nur
      Ponys aus unserem Ministerium und dem Ministerium f\xFCr Moral von der Wiedervorlage
      der Plakate wussten, die sich mit dem Problem der Ereignisse auf den Grizley-Inseln
      befasst haben. Ich kann ihnen versichern, dass keiner meiner Mitarbeiter in
      dieses Verbrechen verwickelt ist. Daher sind Schl\xFCsse, die daraus gezogen
      werden k\xF6nnten, \xE4u\xDFerst beunruhigend.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018236
    m_Localized: "*An: Morning rain\nNachricht gesendet vor: 73594 Tagen\nBetreff:
      (Re) Diebstahl*\n\"Wir haben noch nicht gen\xFCgend Informationen um solche
      Schlussfolgerungen zu ziehen, Morning. Ich verstehe jedoch ihre Besorgnis.
      Wenn es im Ministerium f\xFCr Moral Verr\xE4ter gibt, kann dies katastrophale
      Folgen haben. Ein Verschulden des Vorsitzenden des MoM ist undenkbar, aber
      man sollte auch die M\xF6glichkeit nicht au\xDFer Acht lassen, dass niederrangige
      Angestellte an den Vorf\xE4llen der letzten Zeit beteiligt waren.\nIch empfehle,
      auf das Standardarbeitsschema zur\xFCckzugreifen: Informieren Sie den mit Ihnen
      kooperierenden Mitarbeiter des Innenministeriums \xFCber den Erhalt der dritten
      Ausgabe der Plakate im Lager innerhalb von zwei Tagen und halten Sie zum festgelegten
      Zeitpunkt eine Abfangeinheit bereit. Ich rate zu einer zus\xE4tzlichen R\xFCckversicherung,
      um die Verbreitung von Informationen \xFCber die Neuauflage unter den Ponys
      Ihrer Abteilung zu vermeiden. Meinerseits werde ich Pinky Pie pers\xF6nlich
      kontaktieren, um die \xDCberwachung aller Mitarbeiter zu arrangieren, bei denen
      es sich m\xF6glicherweise um den T\xE4ter handeln k\xF6nnte\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018237
    m_Localized: "*Von: Morning Rain\nNachricht empfangen vor: 73592 Tagen\nBetreff:
      (Re(2)) Diebstahl*\n\"Unsere Bef\xFCrchtungen haben sich best\xE4tigt. Der
      Dieb erschien genau an dem Tag im Lager, an dem wir es dem Ministerium mitgeteilt
      hatten. Leider gelang es ihm zu entkommen, aber die Ponys des Abfang-Teams
      konnten einige charakteristischen Merkmale des Erscheinungsbildes des Saboteurs
      zuverl\xE4ssig bestimmen: Ein Pony mittleren Alters mit einem blassgelben Fell
      und einer kurzen M\xE4hne, deren Farbe nicht bestimmt werden konnte. Der Sch\xF6nheitsfleck
      und die Augen waren durch einen Umhang bedeckt, wodurch eine Identifizierung
      war unm\xF6glich\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018238
    m_Localized: "*To: Morning rain\nNachricht gesendet vor: 73592 Tagen\nBetreff:
      (Re(3)) Diebstahl*\n\"Trotz des Scheiterns der \xDCberwachungsmission ist Ihre
      Operation mit Sicherheit erfolgreich. Ponys vom Ministerium f\xFCr Moral haben
      eine \xDCberwachung aller an der Arbeit an dem Vorfall auf den Inseln Beteiligten
      Mitarbeitern eingerichtet, aber keines von ihnen hat w\xE4hrend des gesamten
      Beobachtungszeitraums etwas Verd\xE4chtiges begangen und damit ein Alibi sichergestellt.
      Dies bedeutet, dass das Spektrum der verd\xE4chtigen Ponys viel breiter war
      als n\xF6tig. Wenn Ihre Beobachtungen korrekt sind, k\xF6nnen Sie den Verd\xE4chtigen
      mit den Erscheinungsmerkmalen in k\xFCrzester Zeit finden\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018239
    m_Localized: "*Von: Morning Rain.\nNachricht gesendet vor: 73591 Tagen\nBetreff:
      (Re(4)) Diebstahl*\n\"Ich freue mich, Ihnen mitteilen zu k\xF6nnen, dass der
      Saboteur, den wir in den letzten Tagen zu fangen versuchten, erfolgreich von
      Agenten des MoM gefangen genommen wurde. Es war eine junge Angestellte in einer
      ihrer Abteilungen, Mrs. Gray Shore. Nach einem kurzen Verh\xF6r erkl\xE4rte
      sie sich zur Mitarbeit bereit und nannte den Grund f\xFCr ihre Handlungen.
      Es hat sich herausgestellt, dass ihr Bruder einer der Soldaten war, die bei
      den tragischen Ereignissen auf den Grizzly-Inseln ums Leben kamen und deren
      Tod, zusammen mit dem Tod vieler anderer Ponys und Informationen \xFCber den
      gesamten Vorfall, wir der \xD6ffentlichkeit nicht preisgegeben haben, um die
      Moral zu wahren der Armee und der Bev\xF6lkerung. Mit diesen Diebst\xE4hlen
      und Graffitis habe sie versucht, \"die Ehre\" des verstorbenen Verwandten zu
      sch\xFCtzen und \"sich von d\xFCsteren Gedanken abzulenken\". Momentan befindet
      sie sich in der Ermittlungsabteilung des Ministeriums f\xFCr Moral\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018240
    m_Localized: "*An: Morning rain\nNachricht gesendet vor: 73591 Tagen\nBetreff:
      (Re(5)) Diebstahl*\n\"Herzlichen Gl\xFCckwunsch zum erfolgreichen Abschluss
      der Untersuchung. Ich wurde bereits von den Vertretern des Ministeriums f\xFCr
      Moral informiert. Ich empfehle Ihnen, Gray Shore heute in der Ermittlungsabteilung
      zu besuchen und einen Vortrag \xFCber die Wichtigkeit der Aufrechterhaltung
      einer hohen Moral der Bev\xF6lkerung und des Ortes pers\xF6nlicher Gef\xFChle
      im Leben der B\xFCrger w\xE4hrend des Krieges zu halten. Das Schicksal dieses
      Ponys bleibt in den Hufen seines Ministeriums, das ist nicht mehr unser Problem.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018241
    m_Localized: "Snails, hier ist Snips. Verzeih mir, mein Freund, aber ich muss
      jetzt gehen. Und ich bin mir nicht sicher, wann ich zur\xFCckkehren kann.\nEs
      geht um das Projekt, um das Mrs. Rarity uns gebeten hat. Ja, genau um dieses
      Projekt. Ich habe in den letzten Tagen viel dar\xFCber nachgedacht und bin
      zu dem Schluss gekommen, dass das Ritual ohne zus\xE4tzliche magische Verst\xE4rker
      unm\xF6glich w\xE4re. Leider lieferte meine Recherche nicht den geringsten
      Hinweis darauf, was genau uns helfen k\xF6nnte. Ich musste auf zus\xE4tzliche
      Techniken zur\xFCckgreifen, von denen ich dir sp\xE4ter erz\xE4hlen werde,
      und heute hat eine von ihnen Fr\xFCchte getragen. Leider sieht es danach aus,
      dass ich keine Minute Zeit habe, mich mit dir zu treffen und \xFCber alles
      zu diskutieren. Ich muss dich um einen Gefallen bitten: Morgen wirst du mit
      Madam Rarity f\xFCr mich sprechen und ihr einen detaillierten Bericht dar\xFCber
      geben, was wir bisher herausgefunden haben. Du wei\xDFt, wo du meine Notizen
      findest, lies sie unbedingt durch, bevor du dich mit Mrs. Rarity triffst. Und
      glaub nicht, ich h\xE4tte die Gelegenheit genutzt, alles auf deine Schultern
      zu legen! Das w\xE4re zu unversch\xE4mt von dir!\nEine Sache noch: Bitte l\xF6sche
      diese Nachricht von deinem Terminal, sobald du sie gelesen hast. Du verstehst."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018242
    m_Localized: Und was ist das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018243
    m_Localized: Aufzeichnung von Anruf #1 abspielen;
    m_Metadata:
      m_Items: []
  - m_Id: 2742018244
    m_Localized: Shiny, nimm ab, es ist dringend!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018245
    m_Localized: Bitte, Liebling, sag etwas!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018246
    m_Localized: "Wir werden angegriffen, Shiny! Die Zebras greifen uns an! Die Stadt
      wird bombardiert, es ist furchtbar! Die Prinzessinnen haben ein Kraftfeld erzeugt
      und besch\xFCtzen uns, aber mit jeder Minute wird alles schlimmer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018247
    m_Localized: "Ein seltsames Gas breitet sich in den Stra\xDFen aus. Ich habe
      so etwas noch nie gesehen, es ist schrecklich! Ich verstecke mich im Keller
      des Ministeriums, im Raum mit der Kommunikationseinheit. Im ganzen Geb\xE4ude
      gibt es kein einziges Pony! Wo sind sie? Wo sind die alle hin? Ich wei\xDF
      es nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018248
    m_Localized: "Shiny, wenn du m\xF6ch h\xF6ren kannst dann renne aus der Stadt!
      Lauf weg! Wenn die Zebras angreifen, dann werden sie auch bald bei dir sein.
      Verschwende keine Sekunde, lauf!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018249
    m_Localized: "Shiny, h\xF6rst du mich? Shiny?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018250
    m_Localized: "Ich m\xF6chte so nicht sterben, Shiny! Ich will bei dir sein! Wir
      werden bald zusammen sein, richtig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018251
    m_Localized: '*Schluchzen*'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018252
    m_Localized: "Das kann doch nicht wirklich passieren! Das ist nicht wahr! Ich
      muss tr\xE4umen! Ich tr\xE4ume, richtig?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018253
    m_Localized: "Shiny, h\xF6rst du mich? Shiny, sag etwas! Shiny!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018254
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018255
    m_Localized: "Ich h\xE4tte es nicht abspielen sollen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018256
    m_Localized: "Kategorie: Bekannte Stables, Kurz-Informationen. Alphabetisch sortiert.\nStable
      0, Fillidelphia: Nicht funktionsf\xE4hig. Unter Kontrolle der St\xE4hlernen
      Bruderschaft der Fillidelphia Division;\nStable 1, Canterlot: Unbekannt. Vermutliich
      gepl\xFCndert;\nStable 2, Ponyville: Versiegelt. Vermutlich erloschen;\nStable
      3, Zebratown: Nicht funktionsf\xE4hig. Gepl\xFCndert;\nStable 6, Kristallberge:
      Status unbekannt. Vermutliich gepl\xFCndert;\nStable 12, Trottingham: Nicht
      funktionsf\xE4hig. Intakt;\nStable 20, Neu Pegasus: Nicht funktionsf\xE4hig.
      Von Banditen gepl\xFCndert und besetzt;\nStable 29, Fetlock: Versiegelt. Erloschen;\nStable
      40, Staliongrad: Status unbekannt. Vermutlich erloschen;\nStable 49, Vanhoover:
      Nicht funktionsf\xE4hig. Gepl\xFCndert;\nStable 55, An der Grenze zum Greifen
      K\xF6nigreich:\nStable 65, Neighara falls: Nicht funktionsf\xE4hig. Unter Kontrolle
      der St\xE4hlernen Bruderschaft der Neighara Division;\nStable 67, Fillidelphia:
      Nicht funktionsf\xE4hig. Gepl\xFCndert;\nStable 77, Coltchester: Versiegelt.
      Vermutlich erloschen;\nStable 88, Falls Springs: Nicht funktionsf\xE4hig. Intakt;\nStable
      93, Fillidelphia: Unbekannt. Vermutlich gepl\xFCndert;\nStable 96, N\xF6rdliches
      \xD6dland: Nicht funktionsf\xE4hig. Vermutliich gepl\xFCndert;"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018257
    m_Localized: "Stable 99, Hoofington: Versiegelt. Vermutlich erloschen.;\nStable
      102, Caledonia: Unbekannt. Vermutlich erloschen.\nStable Pi, Standort unbekannt:
      Vermutlich ge\xF6ffnet. Vermutlich bewohnt.\nStable Solaris, Stra\xDFe 52:
      Unbekannt. Vermutlich erloschen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018258
    m_Localized: 'Eine nicht gesendete E-Mail, die anscheinend von einem der Abteilungsingenieure
      einige Tage vor dem Fall der Bomben geschrieben wurde:'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018259
    m_Localized: "\"Ratet mal, was diese dummen Esel von der wissenschaftlichen Abteilung
      gemacht haben!!\nWei\xDFt du noch, wie ich dir vor anderthalb Monaten diese
      ungew\xF6hnlichen Kristalle gezeigt habe? Die selbst haben sie mir gegeben
      als Dank f\xFCr die magnetisch leitenden Spulen. Sie wussten nicht, was sie
      mit diesen Kristallen anfangen sollten, und sie gaben sie mir, nur f\xFCr den
      Fall, dass ich eine Verwendung daf\xFCr finden k\xF6nnte. Und bei Celestia,
      das habe ich! Es stellte sich heraus, dass diese Kristalle auf ein bestimmtes
      Spektrum magischer Strahlung reagieren und dabei ihre Eigenschaften ver\xE4ndern.\nWie
      w\xE4re es damit? Ich kann dir die Details bei unserem Treffen mitteilen, aber
      die Sache ist, dass dies eine m\xE4chtige Waffe werden k\xF6nnte. Nicht nur
      eine Art lascher Laserstrahl. Meine \"Harmoniestrahlen\" k\xF6nnten nach den
      ersten Berechnungen eine R\xFCstung wie Papier durchtrennen.\nAls diese Dummk\xF6pfe
      das Potential pl\xF6tzlich erkann hatten, hatte ich die vorl\xE4ufigen Pl\xE4ne
      schon fertig. Ich wei\xDF nicht, wer ihnen gesagt hat, dass es sich bei diesen
      Kristallen nicht nur um gl\xE4nzende Schmuckst\xFCcke handelt. Jetzt erz\xE4hlen
      sie mir, dass die Kristalle das geistige Eigentum ihrer Abteilung sind, die
      \xFCbrigens zur\xFCckgegeben werden m\xFCssen.\nNat\xFCrlich habe ich sie dort
      hin gebracht, wo keine Sonne scheint. Bis ich ein Patent f\xFCr mein Freindschaftsgewehr
      (Arbeitstitel, hehe) bekomme, kriegen die garnichts von mir. Sie haben gedroht,
      Sicherheitskr\xE4fte einzusetzen, um sie mir mit Gewalt abzunehmen. Also habe
      ich die Kristalle an verschiedenen Orten in der Werkstatt versteckt. Sollen
      sie kommen, wir werden ja sehen, wie sie mir etwas abnehmen werden.\nWundere
      dich nicht, wenn mein \"Freundschaftsgewehr\" vor Kriegsende Laser ersetzt.
      Vielleicht bringt es uns sogar den Sieg. Wir werden die gestreiften Bastarde
      zum Weinen bringen!\nHey, glaubst du, sie werden mir eine Auszeichnung verleihen?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018260
    m_Localized: "* Ereignisbericht \u2116215\nZeitpunkt des Vorfalls: 12:47 Uhr\nDatum:
      15:04:1074 *\n\"Heute ist der erste Arbeitstag f\xFCr Cold Dew, unseren neuen
      Installateur. Anf\xE4nger sind beim ersten Mal nat\xFCrlich immer am Arsch,
      deshalb haben wir uns um sie gek\xFCmmert. Aber ich habe nicht damit gerechnet,
      dass unser neuer Mitarbeiter es schafft, derart in Schwierigkeiten zu geraten.
      Auf dem Weg zur\xFCck zum Arbeitsplatz beschloss sie, ihre Hufe am n\xE4chsten
      Waschbecken zu waschen und schaffte es, einen industriellen Wasserschneider
      f\xFCr das Waschbecken zu halten. \"Ein Wassertropfen auf dem Ger\xE4t bedeutet
      Waschen. richtig? \"Es war schmerzhaft, ihre Hufe nur anzusehen, aber sie hatte
      gro\xDFes Gl\xFCck, dass das Ger\xE4t noch nicht auf vollem Druck war. Die
      \xC4rzte sagen, dass sie sie flicken werden, es wird nicht einmal eine Narbe
      bleiben. Aber die Versicherung muss bezahlt werden. Und wir m\xFCssen dar\xFCber
      nachdenken, die Kennzeichnungen an den Produktionsmitteln zu \xE4ndern.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018261
    m_Localized: "* Ereignisbericht \u2116227\nZeitpunkt des Vorfalls: 17:12 Uhr\nDatum:
      10:11:1074 *\n\"Der Vorfall auf der Walzpressenstra\xDFe. Aufgrund eines Zeitgeber-Einstellfehlers
      w\xE4hrend der morgendlichen Wartung war die Steuerung der W\xE4rmebehandlungszeit
      ausgeschaltet: Nach jedem Zyklus wurde dem Zeitgeber ein kleiner Sekundenbruchteil
      hinzugef\xFCgt. Da das Aufsichtspersonal nichts unternahm, bis eine \xDCberhitzung
      des Materials mit blo\xDFem Auge sichtbar wurde begann die Anh\xE4ufung von
      Verl\xE4ngerung gef\xE4hrliche Ausma\xDFe anzunehmen. Es stellte sich heraus,
      dass Woodpicker, der f\xFCr die technische Kontrolle verantwortlich ist, die
      St\xF6rung sofort feststellte, diese jedoch nicht beachtete und den AZ-5 auch
      nicht aktivierte, in der Hoffnung zu warten, bis das F\xF6rderband am Ende
      der Schicht angehalten wird. Ihm zufolge: \"Es war keine gro\xDFe Sache, alles
      nicht so schlimm.\" Ich beschlossen, mich mit meinem Protokolleintrag auf einen
      Verweis zu beschr\xE4nken.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018262
    m_Localized: "*Ereignisbericht \u2116244\nZeitpunkt des Vorfalls: 09:51 Uhr\nDatum:
      07:03:1075 *\n\"Ich denke, Sie sind sich bereits bewusst, dass das von der
      Verwaltung beauftragte Experiment gescheitert ist und nur dank eines Wunders
      und der Professionalit\xE4t meiner Mitarbeiter konnte ein schwerer Unfall vermieden
      werden. Ponys, die vorerst erfolgreich vom Ministerium kontrolliert wurden,
      kontrollierten das experimentieren mit ihrem bl\xF6den schwarzen stein, doch
      ihre methode zur steuerung der energieerzeugung scheiterte im ung\xFCnstigsten
      moment. die \xFCberlastung der Stromversorgung f\xFChrte zum v\xF6lligen Ausfall
      aller Werkstatt-Sicherheitssysteme und verursachte an mehreren Stellen einen
      brand.\nMeine Ponys haben alle Br\xE4nde erfolgreich gel\xF6scht und die Maschine
      der Vier\xE4ugigen buchst\xE4blich vom Netz getrennt. Wenn sie nur eine Minute
      gez\xF6gert h\xE4tten, m\xFCssten wir den gesamten Sektor evakuieren und den
      FD-Werksservice anrufen. Bitte, lassen Sie diese Freaks das n\xE4chste Mal
      nicht ohne guten Grund in unsere Produktion.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018263
    m_Localized: "Ereignisbericht \u2116245\nZeitpunkt des Vorfalls: 11:36\nDatum:
      14:03:1075 *\n\"Nach einer vollst\xE4ndigen Evakuierung wurde die Werkstatt
      gem\xE4\xDF der Verhaltensanweisung f\xFCr den Notfall der dritten Klasse versiegelt.
      Weil ich hier keine verdammte niedrigere Klasse anwenden kann! Du kannst mir
      Hunderte von Anweisungen geben, aber DIESES VERDAMMTE DING verl\xE4sst meine
      Werkstatt nur \xFCber meine Leiche! Ponys sind gestorben, Twitch, wei\xDFt
      du das?! Viele Ponys! Und alles nur, weil du nach einer M\xF6glichkeit suchst,
      den Chefs in den Arsch zu kriechen, du St\xFCck Schei\xDFe! Ich habe dir gesagt,
      du sollst diese Schwachk\xF6pfe von den Laboratorien fernhalten und ich habe
      dir erkl\xE4rt, dass die da oben trotz der Gefahrenlage keine Experimente durchf\xFChren.
      Aber du wolltest ja eine Gehaltserh\xF6hung! Du wirst hier nicht mehr der Boss
      sein, Twitch, daf\xFCr werde ich sorgen\"\n|*Ereignisbericht \u2116245\nZeitpunkt
      des Vorfalls: 11:36\nDatum: 14:03:1075 *\n\"Nach einer vollst\xE4ndigen Evakuierung
      wurde die Werkstatt gem\xE4\xDF der Reihenfolge des Verhaltens im Notfall der
      dritten Klasse versiegelt. Weil ich hier keine geringere Klasse anwenden kann!
      Du kannst mir Hunderte von Anweisungen schreiben, aber DIESES DING verl\xE4sst
      meine Werkstatt nur \xFCber meine Leiche! Ponys starben, Twitch, wei\xDFt du
      das?! Viele Ponys! Und alles nur, weil du nach einer Gelegenheit suchst, dich
      bei den Bossen einzuschmeicheln, du dummer Idiot! Ich habe dir gesagt, du sollst
      diese Dummk\xF6pfe von den Laboratorien fernhalten und ich habe dir erkl\xE4rt,
      dass diese Wasserk\xF6pfe an der Spitze trotz der Gefahren keine Experimente
      machen, aber du wolltest ja eine Gehaltserh\xF6hung. Du wirst hier nicht mehr
      der Boss sein, Twitch, daf\xFCr werde ich sorgen\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018264
    m_Localized: "*Ereignisbericht \u2116246\nZeitpunkt des Vorfalls: 14.07\nDatum:
      05:06:1075 *\n\"Mr. Twitch, bitte verzeihen Sie mir, dass ich Sie st\xF6re,
      aber ich muss Ihnen mitteilen, dass das F\xF6rderband derzeit wegen eines Arbeiterstreiks
      vor\xFCbergehend ausgesetzt ist. Bitte verzeihen Sie mir, was passiert ist.
      Ich habe bereits alle erforderlichen Ma\xDFnahmen ergriffen, um das Problem
      zu l\xF6sen In der n\xE4chsten Stunde wird die Produktion wieder aufgenommen
      und ich verspreche, dass morgen alle Tests zusammen mit den Mitarbeitern des
      Ministeriums genau und p\xFCnktlich durchgef\xFChrt werden\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018265
    m_Localized: "\"Mein Schicksal geh\xF6rt Caesar, und meine Seele geh\xF6rt dem
      Stamm.\nDiese Wahrheit hilft mir immer in schwierigen Zeiten. Und sie wird
      hier helfen. In diesen Gegenden mag es kalt sein, aber das Vertrauen in die
      Richtigkeit unserer Sache w\xE4rmt mich auch in den h\xE4rtesten N\xE4chten.
      Nach so vielen Monaten der Ausbildung habe ich nun die Gelegenheit, mich in
      Aktion zu beweisen. Ich werde meine Familie nicht im Stich lassen!\"\n\n\"Mein
      Schicksal geh\xF6rt Caesar, und meine Seele geh\xF6rt dem Stamm.\nViele von
      den Sternen verdammten sind in den letzten Monaten durch Sch\xFCsse aus meinem
      Gewehr gefallen. Und mit jedem neuen Opfer f\xFChle ich, wie dieses Land gereinigt
      wird. Die Nachkommen der M\xF6rder, Entweihten und Sklaven des B\xF6sen sind
      dieselben Inkarnationen des Schmutzes der Sterne wie diejenigen, die diese
      Welt vor zweihundert Jahren zerst\xF6rt haben. Wahrhaftig, es gibt kein Zur\xFCck
      f\xFCr jene, die beschlossen haben, der Sternstute zu dienen. Wir werden beenden,
      was unsere Vorfahren begonnen haben, und diese Welt wieder befreien\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018266
    m_Localized: "\"Mein Schicksal geh\xF6rt Caesar, und meine Seele geh\xF6rt dem
      Stamm.\nEs gehen Ger\xFCchte um, dass unser Anf\xFChrer im Begriff ist, mit
      einem der Ponys einen Waffenstillstand abzuschlie\xDFen. Ich habe denjenigen,
      der mir davon erz\xE4hlte, dazu gebracht, sich buchst\xE4blich die schmutzige
      Zunge abzubei\xDFen. Von den Sternen verw\xF6hnte Hufe zu sch\xFCtteln bedeutet,
      sich vom Dreck verzehren zu lassen. Das wei\xDF jedes Fohlen. Was f\xFCr ein
      Dummkopf muss man sein, wenn man denkt, dass der Legat Caesarius so offensichtlichen
      Dinge nicht wei\xDF?\"\n\n\"Mein Schicksal geh\xF6rt der Ehre, und meine Seele
      geh\xF6rt dem Stamm.\nWeder ich noch eine meiner Gruppen werden Idioten dienen,
      die Gesch\xE4fte mit den \"von den Sternen verfluchten\" machen. Ich fordere
      jeden, der noch nicht mit Dreck beschmutzt wurde, auf, unserem Beispiel zu
      folgen und diese verr\xE4terische Versammlung zu verlassen. Versucht im \xDCbrigen
      nicht, diese Nachricht zu l\xF6schen oder uns zu folgen, da wir als die Diener
      der Nacht euch in jeder Lage besiegt werden. Zittere vor Angst, denn die Reinigung
      ist nahe.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018267
    m_Localized: "*Protokollarchiv \xFCber Sitzungen und Anweisungen des F\xFChrungs-Stabes
      der \"Epsilon\" Basis.\nEintrag \u2116 57\nDatum: 28.03.187\nTitel: \"Eine
      Sitzung \xFCber die Interaktion mit den Einheimischen\"\nVorsitzender: Oberst
      Windflow (OW)\nRedner: Lieutenant Sammrer Leaf (LSL)\nOpposition: Sergeant
      Thunder (ST), Major Saffer (MS)\nSekret\xE4r: Adjutant Fair Play*"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018268
    m_Localized: "(OW): Ich denke, jedes Pony ist mit der heutigen Sitzungsagenda
      bereits vertraut. Bitte verschwenden wir keine Zeit. Leutenant, Sie haben das
      Wort.\nLeutenant Summer Leaf liest den Text seiner Rede (der Text der Nachricht
      entspricht dem angegebenen Betreff).\n(MS): Freut mich das zu h\xF6ren, Leutnant.
      Zumindest einer der in diesem Loch eine n\xFCchterne Sicht auf die Welt hat.\n(OW):
      Ich m\xF6chte Sie bitten, von abf\xE4lligen Kommentaren abzusehen, Major.\n(MS):
      Oder was, Pipsqueak? Sie schreiben eine Beschwerde an den Chef?\n(ST): Beruhige
      dich, Coke! Wie kannst du untergeordneter es wagen, dich einzumischen? Gegebenenfalls
      erinnere ich dich daran, wenn du sprichst.\n(MS): Ich zeige eine Unterordnung,
      du Arschloch.\n(OW): H\xF6rt sofort auf! Sie sind Kommandeure, und nicht in
      der Kneipe von Neighvarro! Was f\xFCr ein besch\xE4mendes Verhalten!\n(LSL):
      Ich schlage vor sie warten mit dem K\xE4mpfen, Gentelponys. Wir m\xFCssen immer
      noch die Sache mit den Wilden kl\xE4ren.\n(MS): Was gibt es zu kl\xE4ren? Sie
      haben uns in dieser Sache doch bereits alles erz\xE4hlt. Wir verwenden sie
      f\xFCr Experimente, das ist alles.\n(ST): Wir sollten dich f\xFCr Experimente
      verwenden, Saffer.\n(MS): Kalt die Klappe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018269
    m_Localized: "(OW): Muss ich euch schon wieder zur Ordnung rufen! Sergeant, so
      wie ich das verstehe, sind Sie gegen den Vorschlag von Summer Leaf. M\xF6chten
      Sie Ihren Standpunkt erl\xE4utern?\n(ST): Sie diskutieren \xFCber die Verwendung
      gefangener Einheimischer als Laborratten, als h\xE4tten Sie vergessen, dass
      sie einmal so waren wie wir!\n(LSL): Das Schl\xFCsselwort ist \"waren\" Thunder.
      Sie haben immer wieder selbst gesehen, was aus den Einheimischen geworden ist.
      Die haben kein Recht mehr, als intelligente Wesen zu gelten, nur weil sie in
      der Lage sind, Schusswaffen zu benutzen.\n(ST): Das ist kein Grund zum Snob
      zu werden. Ja, viele von ihnen rennen wild durch die Gegend, aber das bedeutet
      nicht, dass sie mit Tieren gleichgesetzt werden sollten.\n(OW): Ich verstehe
      Ihr Mitgef\xFChl f\xFCr Kreaturen, die wie wir aussehen, Sergeant. Ich m\xF6chte
      Sie jedoch darauf hinweisen, dass die Weigerung, die intelligenten Einheimischen
      zu ber\xFCcksichtigen, nicht auf Snobismus, sondern auf wissenschaftlichen
      Forschungen und Fakten beruht. Zweihundert Jahre der Erniedrigung und Wildheit
      in einer extrem feindlichen Umgebung beraubten sie jeglicher F\xE4higkeit des
      Zivilisiertseins. Sie haben nicht die gleichen F\xE4higkeiten wie wir, sie
      haben nicht die gleiche Verantwortung wie wir. Dementsprechend k\xF6nnen sie
      nicht dieselben Rechte haben wie wir.\n(MS): Sei einfach ruhig.\n(LSL): Mr.
      Major, bei allem Respekt finde auch ich Ihr Verhalten unangemessen.\n(ST):
      Ich werde nicht ruhig sein! Ja richtig du bist der, Oberst, und sie sind schmutzig.
      Aber das ist einfach nur unmoralisch! Liegt es nicht in der Verantwortung zivilisierter
      Pegasi, die Wilden des \xD6dlands zur\xFCck in eine gesunde Gesellschaft zu
      f\xFChren? Sollten wir nicht, nachdem wir die Oberfl\xE4che erobert haben,
      ihr fr\xFCheres Aussehen wiederherstellen? Das wurde uns doch zu Hause so gesagt,
      oder?\n(MS): Bhahah! Du bist ein Dummkopf, Thunder"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018270
    m_Localized: "(LSL): Sergeant Thunder hat Recht, das war genau der Grund warum
      wir hier sind. Unsere Forschung an der Oberfl\xE4che hat unsere Sicht auf die
      Dinge jedoch Stark ver\xE4ndert. In Anbetracht der neuen Umst\xE4nde k\xF6nnen
      wir jetzt noch nicht einmal sagen, ob eine erneute Besiedlung der Oberfl\xE4che
      \xFCberhaupt genehmigt wird. Ich schlage vor, die Experimente an den Einheimischen
      nicht nur aus Neugier, sondern auch zum Schutz der Ponys zu genehmigen. Wir
      k\xF6nnen keinen Weg finden finden, lokale Krankheiten und Gebrechen zu behandeln,
      ohne ihre K\xF6rper im Detail zu untersuchen.\n(OW): Letztendlich wird es den
      Einheimischen selbst zugute kommen.\n(ST): Sie alle verstehen ihre \xC4ngste
      und ihre Gleichg\xFCltigkeit. Es k\xF6nnte aber auch andere Wege geben, um
      Medikamente herzustellen.\n(LSL): Welche da w\xE4ren, Sergeant?\n(ST): Woher
      soll ich das wissen?! Wir heilen uns doch auch selbst, ohne Experimente an
      Pegasi durchzuf\xFChren!\n(MS): Das ist eine Farce. Warum h\xF6ren wir \xFCberhaupt
      auf einem Sergeant?\n(OW): Solche Aussagen k\xF6nnen wir nicht ernst nehmen,
      Sergeant. Bisher sehe ich keine Argumente die gegen den Vorschlag von Leutnant
      Summer Leaf sprechen.\n(ST): So oder so. Aber fr\xFCher oder sp\xE4ter wird
      die Gesellschaft von dem erfahren was hier passiert!\n(MS): Soll das eine Drohung
      sein, du Bastard? Komm her du!..\nEs Folgt ist eine kurze Schl\xE4gerei zwischen
      Sergeant Thunder und Major Saffer. Beide Teilnehmer wurden von den \xFCbrigen
      Anwesenden nach einigen Minuten erfolgreich beruhigt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018271
    m_Localized: "(OW): Das ist eine Unversch\xE4mtheit! Herr Major, Ihr Verhalten
      wird den Beh\xF6rden gemeldet werden! Ich ermahne Sie mit einer pers\xF6nlichen
      Aufzeichnung!\n(MS): Die kannst du dir wohin stecken!\n(LSL): Genug! Herr.
      Oberst Sir, angesichts der Umst\xE4nde schlage ich vor, von einer f\xF6rmlichen
      Abstimmung abzusehen.\n(OW): Einverstanden. Ich erkl\xE4re hiermit, dass der
      Vorschlag von Leutnant Summer Leaf, Experimente an gefangenen Einheimischen
      zuzulassen, genehmigt wurde und die Grundlage f\xFCr die nachfolgenden Anweisungen
      bilden wird. Obligatorisch f\xFCr alle Basismitarbeiter, Sergeant!\n(ST): Sie
      werden diese Entscheidung sp\xE4ter bereuen, Oberst. Nicht wegen mir, ich bedrohe
      sie nicht. Aber die Geschichte wird ihre Sache tun.\n(OW): Diese Sitzung ist
      hiermit beendet."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018272
    m_Localized: "*An den 3. Feldkommandeur der ersten Expeditionsgruppe\nMajor-General
      von RAS \nSilent Cloud\nBERICHT\nHiermit informiere ich Sie dar\xFCber, dass
      ich Ergebnisse der vorl\xE4ufigen Untersuchung des aktuellen Zustands der Oberfl\xE4che
      und der oberfl\xE4chennahen Bodenschichten erhalten habe. Der vollst\xE4ndige
      Text \xFCber die Forschungsarbeit wird Ihnen innerhalb von drei Tagen nach
      Absendung dieser Nachricht \xFCbermittelt. Ich muss Sie jedoch auch dar\xFCber
      informieren, dass die Ergebnisse alles andere als ermutigend sind. Nach den
      Sch\xE4tzungen unserer Forschungsmissionen entspricht der derzeitige Verschmutzungsgrad
      nicht den im Projekt festgelegten Anforderungen. Die Lebensbedingungen sind
      ung\xFCnstig, ein komfortables Leben erfordert einen hohen Aufwand an Filtrationsger\xE4ten
      und Isolationssystemen. Dar\xFCber hinaus passte sich fast die gesammte Flora
      und Fauna an das Leben unter diesen extremen Bedingungen an, einschlie\xDFlich
      der einst intelligenten Arten von Erdponys und Einh\xF6rnern, die zu einem
      r\xE4uberischen Lebensstil \xFCbergingen und eine st\xE4ndige Bedrohung f\xFCr
      zuk\xFCnftige Kolonisten darstellen w\xFCrden. Unseren Berechnungen zufolge
      scheinen die Kosten f\xFCr die Gew\xE4hrleistung ihrer Sicherheit unangemessen
      hoch und selbst wenn die M\xF6glichkeit best\xFCnde, alle uns zur Verf\xFCgung
      stehenden Ressourcen zu nutzen scheint eine Verringerung der Umweltverschmutzung
      vollkommen unm\xF6glich."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018273
    m_Localized: "Ein positives Ergebnis wird jedoch durch die Exploration von Ressourcen
      mannulogener Herkunft erzielt, und zwar hochlegierte Metalle, Ausr\xFCstung,
      Langzeitlagerprodukte und andere Produkte aus industrieller Produktion und
      Verarbeitung. Angesichts der fast vollst\xE4ndigen Zerst\xF6rung der Verbraucher
      f\xFCr diese Produkte infolge der Megazauber-Angriffe ist ein erheblicher Teil
      dieser Reserven noch unber\xFChrt und befindet sich weiterhin in zufriedenstellendem
      Zustand. Von besonderem Interesse sind milit\xE4rische Einrichtungen und Stable-Tech-Einrichtungen,
      Stables, die vor dem j\xFCngsten Tag errichtet wurden. Ein detaillierter Bericht
      \xFCber die zu diesen Objekten gesammelten Informationen wird dem Text der
      Forschungsarbeit beigef\xFCgt.\nWir freuen uns auf weitere Instruktionen.\n06.14.187\nOberst
      Windflow*"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018274
    m_Localized: "Allm\xE4hlich gew\xF6hne ich mich an meinen ersten Arbeitsplatz.
      Juniorlaborant der Abteilung Elektrotechnik. Schon eine Leistung. Seit meiner
      Kindheit habe ich davon getr\xE4umt, Wissenschaftler zu sein, Dinge zu studieren
      und zu erfinden. Also, woran ich bis jetzt noch nicht gearbeitet habe, aber
      ich habe noch einen so langen Weg vor mir! Ich habe Angst, mir vorzustellen,
      was passieren w\xFCrde, wenn ich zum Beispiel ein Junior-PipBuck-Techniker
      w\xFCrde.\n\n***\nIch habe weniger als sechs Monate gebraucht, um das Funktionsprinzip
      aller in unserem Labor vorhandenen elektrischen Ger\xE4te gr\xFCndlich zu untersuchen.
      Vom Mikroskop bis zum Toaster. Leider habe ich, obwohl ich nur f\xFCr die Vorbereitung,
      den Betrieb und die Wartung der Ausr\xFCstung zust\xE4ndig bin, kaum noch Zugang
      zu etwas anderem. Der Laborleiter bemerkte meine Begeisterung, aber ich kann
      keine zus\xE4tzlichen Aufgaben \xFCbernehmen, bis einer der anderen Mitarbeiter
      in den Ruhestand geht. Es gibt zu wenige Stellen im Stable.\n\n***\nMentor
      ist besorgt wegen meiner Selbsternennung zum zweiten Bibliothekar-Assistent.
      Bisher habe ich mit all meinen Aufgaben Erfolg gehabt, aber er bef\xFCrchtet,
      dass ich anfangen k\xF6nnte, mich zu \xFCberarbeiten und Fehler mache. Vielleicht
      sollte ich auf ihn h\xF6ren, aber bis jetzt sp\xFCre ich keine Anspannung oder
      Ersch\xF6pfung.\n\n***\nIch war so froh \xFCber meine Ernennung zum leitenden
      Laborassistenten. Nachdem Rosie beschlossen hatte, ihre Stelle als Physiklehrerin
      niederzulegen, wurde ich als die am besten geeignete Kandidatin ausgew\xE4hlt.
      Tats\xE4chlich mag ich die neuen Aufgaben nicht so sehr, wie ich dachte. Die
      Verantwortung f\xFCr die Kontrolle der Junior-Laborassistenten f\xFChrte zu
      Konflikten mit Shad. Nicht dass ich jemans mit diesem Faulenzer sympathisiert
      h\xE4tte, aber wenn seine schwache Motivation zum Problem wird, \xE4ndern sich
      die Dinge. Dar\xFCber hinaus kommt eine neue Verpflichtung dazu - das Ausf\xFCllen
      der Buchhaltungsunterlagen - schnell als Zeitverschwendung, sobald Sie anfangen,
      das selbst zu tun. Dies ist jedoch die einzige M\xF6glichkeit, sich zu einem
      echten Forscher zu entwickeln.\n\n***\nDer vielleicht beste Teil der Arbeit
      als leitender Laborassistent ist die F\xE4higkeit, direkt an neuen Experimenten
      teilzunehmen, die f\xFCr die Forschung notwendig sind. Man kann so viel f\xFCr
      sich selbst lernen! K\xFCrzlich haben wir Labortests mit einem magischen Energieger\xE4t
      durchgef\xFChrt, das theoretisch das Alihorn-Amulett im \"Sun\" -Projekt ersetzen
      kann. Dann lie\xDFen Sie das Experiment (wie immer) scheitern, aber zumindest
      die Daten, die wir w\xE4hrend des Experiments erhalten haben, werden dazu beitragen,
      das experimentelle Design zu verbessern. Professor Brownie lud mich ein, ihm
      ein wenig bei den Berechnungen zu helfen. Ich hoffe, diese Aufgabe wird lange
      dauern.\n\n***\nHeute bin ich zu meiner Position als Junior Lab Assistant zur\xFCckgekehrt.
      Der Leiter war nat\xFCrlich nicht erfreut, von meinem Wunsch zu erfahren, meine
      derzeitigen Aufgaben aufzugeben, aber als sich herausstellte, dass Rose nur
      froh war, von \"diesen verdammten Fohlen\" in die Abteilung zur\xFCckzukehren,
      verschwanden die Probleme von selbst. Vermutlich werde ich jetzt nicht so bald
      einen Termin f\xFCr eine Forschungsstelle bekommen, aber zumindest habe ich
      die organisatorischen Probleme beseitigt. Im Allgemeinen ist das sogar das
      Beste. Au\xDFerdem werde ich jetzt mehr Zeit haben, Professor Brownie zu helfen.\n\n***\nHeute
      wurde ein weiterer Auserw\xE4hlter aus dem Stable geschickt. Diesmal war es
      Velvet. Schade, dieses Pony hat uns alle immer aufgeheitert. Aber sie hat sich
      freiwillig f\xFCr diese Mission gemeldet, und in gewisser Weise verstehe ich
      sie auch sogar. Je l\xE4nger ich hier lebe, desto weniger sehe ich einen Sinn
      in unserer Arbeit. Die Basis unserer Forschung ist hier das \"Sun\" -Projekt,
      aber wir scheitern st\xE4ndig, versuchen, ohne die notwendigen Komponenten
      zu arbeiten und senden immer neue Ponys aus, die niemals zur\xFCckkehren. In
      der Tat scheint es mir, dass jede Pony hier schon lange die Hoffnung verloren
      hat. Auch wenn sie es nicht zeigen.\n\n***\nDer lustige Vorfall endete fast
      mit ernsten Konsequenzen. Shad hat es geschafft, unsere Hauptstromgeneratoren
      mit nur einer Kaffeetasse zu deaktivieren. Ich habe keine Ahnung wie, aber
      der Stable lebte fast eine Woche lang von Batterien, bis unsere Techniker einen
      Weg fanden, die Stromversorgung wiederherzustellen. Es ist schrecklich zu \xFCberlegen,
      was passieren w\xFCrde, wenn sie es nicht geschafft h\xE4tten, sie zu reparieren.
      Der arme Kerl wurde beauftragt, den erweiterten Kurs von WS bei der Arbeit
      mit Elektroger\xE4ten umzubilden und zu erraten, wer zu seinem Ausbilder ernannt
      wurde. Als ob ich nirgendwo Energie stecken k\xF6nnte. Nun, das ist in Ordnung,
      ich werde es versuchen, damit Shadow von nun an WS wie seinen Hufr\xFCcken
      kennt.\n\n***\nMentor k\xFCndigte Vorbereitungen an, um einen neuen Auserw\xE4hlten
      an die Oberfl\xE4che zu schicken. Nach nur wenigen Monaten! Wir werden nie
      \xFCber Einzelheiten dar\xFCber informiert, was mit ihnen geschieht, aber normalerweise
      wird der n\xE4chste Auserw\xE4hlte einige Jahre nach dem vorherigen gesendet.
      Anscheinend ging es mit Velvet wirklich schief. Ich frage mich, ob sie noch
      lebt?\nIch habe mich noch nicht entschieden, aber vielleicht sollte ich mich
      freiwillig melden. Das ist wirklich be\xE4ngstigend, weil noch nie ein Pony
      von dieser Mission zur\xFCckgekehrt ist und ich keine Ahnung habe, wo ich hinkomme
      und was mich dort erwarten wird. Und dann noch dieses L\xF6schen der Erinnerung.
      Aber immer noch... Ich habe schon lange den Wunsch verloren, hier zu arbeiten,
      und es ist sinnlos, mein Leben f\xFCr Dinge zu vergeuden, die sich schon vor
      mir seit vielen Generationen im Kreis gedreht haben. Mit der Zeit f\xFChle
      ich mich immer schrecklicher und habe immer weniger Lust, meine Arbeit zu machen.
      Vielleicht ist es wirklich der Ausweg, an die Oberfl\xE4che zu gehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018275
    m_Localized: "Die Chroniken von Stable Pi.\nDieses Dokument enth\xE4lt Informationen
      zu allen wichtigen Ereignissen in unserer Geschichte. Auf dass es nur mit guten
      Meilensteinen gef\xFCllt sein m\xF6ge.\nTag 0\nVersiegeln des Stable Pi nach
      Empfang eines Signals \xFCber den Beginn von UK-Klassenveranstaltungen. Komplette
      Abholung des gesamten Personals, gefolgt von der Versiegelung des Stable. In
      den folgenden Monaten wurde versucht, neue Lebensbedingungen zu schaffen und
      Kontakt zu anderen Zentren aufzunehmen.\n\nJahr 3.\nNach langen Diskussionen
      wurde Equestria f\xFCr endg\xFCltig verloren erkl\xE4rt. Es wurde beschlossen,
      Pl\xE4ne f\xFCr die Organisation von Rettungseins\xE4tzen zugunsten der Geheimhaltung
      und der Sicherheit des Stable aufzugeben. Es wurde auch beschlossen, mit der
      Suche nach M\xF6glichkeiten f\xFCr einen Ersatz der fehlenden Komponenten f\xFCr
      das \"Sun\" -Projekt zu beginnen.\n\nJahr 5.\nDie Geburt des ersten Fohlen
      im Untergrund, Sunny Shine, markierte die endg\xFCltige Stabilisierung der
      Stable Gemeinschaft und den \xDCbergang zu einer neuen Lebensweise. Ein notwendiges
      Ziel, denn selbst nach den optimistischsten Prognosen wird die Oberfl\xE4che
      fr\xFChestens nach 60 Jahren wieder sicher sein.\n\nJahr 12.\nDer Empfang eines
      Signals von der Oberfl\xE4che l\xF6ste heftige Debatten aus und f\xFChrte fast
      zu der Entscheidung, den Stable zu entriegeln. Rechtzeitige Daten \xFCber die
      T\xE4uschung dieses Signals verhinderten jedoch eine m\xF6gliche Katastrophe.\n\nJahr
      13.\nNachfolgende Untersuchungen von Informationen, die von der Oberfl\xE4che
      kommen, haben den Erhalt intelligenten Lebens best\xE4tigt. Es wurden jedoch
      auch Beweise f\xFCr seine au\xDFergew\xF6hnliche Feindseligkeit sowie die Ungeeignetheit
      des bestehenden \xD6kosystems f\xFCr das \xDCberleben eines Ponys best\xE4tigt.
      Dieses Paradoxen muss in Zukunft noch gel\xF6st werden.\n\nJahr 25.\nErster
      Tod im Stable Pi. Der Tod von Long Grass aufgrund einer magischen Energieanomalie
      wurde zum ersten Verlust des Stable. Es hat auch ein bestehende Problem \xFCber
      die Kontrolle der Eind\xE4mmung untersuchter Artefakte aufgedeckt.\n\nJahr
      37.\nKontroversen zwischen Mitgliedern der Stable-F\xFChrung f\xFChrten zu
      Konflikten. Eine Gruppe von Bewohnern unter dem Kommando der Hauptwache Fire
      Grind trat in eine gewaltsame Auseinandersetzung mit den \xFCbrigen Leitern
      ein, um die Kontrolle \xFCber Stable Pi zu \xFCbernehmen. Nachdem der Aufstand
      erfolgreich unterdr\xFCckt worden war, wurde beschlossen, die Stableverwaltung
      neu zu organisieren.\n\nJahr 60.\nEs wurde ein st\xE4ndiger Kontakt mit einem
      Vertreter der Oberfl\xE4che hergestellt, der sich selbst \"Beobachter\" nennt.
      Mit seiner unsch\xE4tzbaren Hilfe bei der Untersuchung der Oberfl\xE4che verdiente
      er sich das teilweise Vertrauen der Stablebewohner, verweigerte jedoch jegliche
      Auskunft \xFCber sich.\n\nJahr 66.\nEine schwerwiegende St\xF6rung im Bel\xFCftungssystem
      wurde fast zum Grund f\xFCr eine Evakuierung des Stable.\n\nJahr 68.\nZwei
      Jahre nach dem Vorfall wurden die Gr\xFCnde f\xFCr den Ausfall der L\xFCftungsanlage
      nun endlich gekl\xE4rt. Eine extrem gro\xDFe und aggressive Unterart heimischer
      Kakerlaken drang in den Stable ein. Ihre Herkunft ist nicht genau bekannt.
      Der l\xE4ngste Sch\xE4dlingskrieg in der Geschichte von Stable Pi beginnt.\n\nJahr
      73.\nDie Zerst\xF6rung des letzten RAD-Kakerlaken Nestes im Stable markiert
      den endg\xFCltigen Sieg der Sicherheitskr\xE4fte \xFCber die Chitin-Bedrohung.\n\nJahr
      87, month 1.\nDer zweite Fall eines bewaffneten Konflikts zwischen den Bewohnern
      von Stable Pi. Interne Widerspr\xFCche f\xFChren zur Aufteilung der Stablebewohner
      in zwei Lager, von denen keines ihre \xDCberlegenheit behaupten kann. Das Territorium
      des Stable ist eigentlich in zwei verschiedene \"Staaten\" unterteilt.\n\nJahr
      87, month 4.\nDer Konflikt wurde dank Diplomatie und gesundem Ponyverstand
      beigelegt. Derzeit wird eine neue endg\xFCltige Verwaltungsreform durchgef\xFChrt,
      um \xE4hnliche Situationen in Zukunft zu vermeiden.\n\nJahr 95.\nDer Tod des
      \"Beobachters\" beraubt Stable Pi seiner einzig verl\xE4sslichen Informationsquelle
      dar\xFCber, was an der Oberfl\xE4che geschieht. Die gewonnenen Erkenntnisse
      reichen jedoch aus, um \xFCber die v\xF6llige Ablehnung von Kontakten zu seinen
      Bewohnern und die Wahrung des Geheimhaltungsstatus zu entscheiden.\n\nJahr
      99.\nEs wurde beschlossen, Ponys an die Oberfl\xE4che zu schicken, um die fehlenden
      Komponenten des \"Sun\" -Projekts zu beschaffen. Praised Sun wurde zur Auserw\xE4hlten
      erkl\xE4rt und nach herbeif\xFChrung einer vorl\xE4ufigen Amnesie an die Oberfl\xE4che
      teleportiert.\n\nJahr 103.\nNach langer Diskussion wurde beschlossen, einen
      zweiten Auserw\xE4hlten an die Oberfl\xE4che zu schicken. Anschlie\xDFend wurde
      regelm\xE4\xDFig ein neuer Freiwilliger zu dieser Mission ernannt, mit Unterbrechungen
      von etwa vier Jahren.\n\nJahr 127.\nMiss Charming Smile entdeckte ein neues
      Backrezept, das die magere Ern\xE4hrung der Bewohner von Stable Pi deutlich
      bereichert hat. Daf\xFCr wurde sie mit dem Titel \"Heldin von Stable Pi\" ausgezeichnet.\n\nJahr
      143.\nNach jahrelangen Forschungen und Vorbereitungen hat Professor Rainy Night
      den Durchbruch geschafft, um eine Alternative zum Alihorn-Amulett zu finden.
      Trotz der Tatsache, dass die gewonnenen Erkenntnisse es nicht erm\xF6glichen,
      auf dieses Artefakt zu verzichten, erm\xF6glichten sie die Reorganisation des
      Stromversorgungssystems des Stable, wodurch die Effizienz und Sicherheit der
      Energieversorgung erheblich gesteigert wurden.\n\nJahr 152.\nDas Signal, mit
      dem der Auserw\xE4hlten-12 irrt\xFCmlicher Weise versucht hatte Kontakt nach
      Hause aufzunehmen, wurde von der Abteilung f\xFCr elektronische Ausr\xFCstung
      detailliert aufgezeichnet und untersucht. Es wurde festgestellt, dass eine
      bestimmte Gruppe von Ponys versucht, Stable zu finden, indem sie ein Notsignal
      f\xE4lschten. Zus\xE4tzliche Ma\xDFnahmen f\xFCr die Sicherheit von Stable
      Pi wurden ergriffen, ein Plan f\xFCr den Fall der Entdeckung durch feindliche
      Organisationen wurde entwickelt.\n\nJahr 171.\nDie Diskussion \xFCber das Vers\xE4umnis
      des Stable, das \"Sun\" -Projekt abzuschlie\xDFen, f\xFChrte zur Entwicklung
      des Umstrukturierungsplans der Forschung. Es wurden spezielle Abteilungen eingerichtet,
      um in k\xFCrzester Zeit Ergebnisse zu erzielen. Leider hat sich die Arbeit
      dieser Abteilungen nach zehn Jahren als zu ineffizient erwiesen.\n\nJahr 189.\nDer
      Vorfall im Hauptgeneratorraum f\xFChrte zu einem ernsten Stromausfall. Ein
      Pony namens Shadow Drop versch\xFCttete Kaffee auf dem Bedienfeld, was infolge
      einer Reihe unwahrscheinlicher Ereignisse dazu f\xFChrte, dass die Generatoren
      gleichzeitig mit dem Ausfall automatischer Notabschaltsysteme \xFCber sichere
      Werte beschleunigten. Die Stromerzeugung wurde erst fast eine Woche sp\xE4ter
      wiederhergestellt.\n\nJahr 190.\nDer intergalaktische Omegatron-Y-Roboter hat
      den Planeten erobert und fordert bedingungslose Unterwerfung! Die Leistung
      von Stable Pi schickt das mutigste, kl\xFCgste und sch\xF6nste Pony - Gusty
      Trot -, um den Eindringling zu bek\xE4mpfen! Wenn mein Vater diese Aufnahme
      sieht, wird er stolz auf mich sein! Ich werde Equestria besch\xFCtzen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018276
    m_Localized: "Hier findest du n\xFCtzliche Tipps zum Spiel. Verwenden die linke
      und rechte Maustaste, um den n\xE4chsten oder vorherigen Tipp anzuzeigen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018277
    m_Localized: "Sammle die goldenen Hufeisen, die in den R\xE4umen verstreut sind,
      um Erfahrungen zu bekommen. Das letzte Hufeisen gibt einen zus\xE4tzlichen
      Bonus, und wenn du alle sammelst, bevor du von Feinden entdeckt wurdest, erh\xE4lst
      du auch einen Schleichen-Bonus."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018278
    m_Localized: "Vergiss nach Erhalt einer neuen Stufe nicht, die F\xE4higkeitspunkte
      zu verteilen und ein neues Talent auszuw\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018279
    m_Localized: "Mit Sicherheitsterminals kannst du alle elektronischen Sicherheitssysteme
      (z. B. Gesch\xFCtz\xFCrme) im Raum deaktivieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018280
    m_Localized: "Mit Zugangsterminals kannst du T\xFCren und Wandtresore im Raum
      entriegeln, sofern du es schaffst sie zu hacken."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018281
    m_Localized: "Wenn deine Schlossknacken-Fertigkeit unter der Schloss-Stufe liegt,
      kann ein erfolgloser Entsperrversuch zum Blockieren f\xFChren. Solch eine T\xFCr
      kann dann nicht mehr ge\xF6ffnet werden, es sei denn, du hast einen Schl\xFCssel
      daf\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018282
    m_Localized: "Wenn dein Wissen \xFCber Sprengstoffe unter dem Niveau der Sprengladung
      liegt, kann diese explodieren, w\xE4hrend du versuchst, sie zu entsch\xE4rfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018283
    m_Localized: "Das meiste Wasser im \xD6dland ist radioaktiv. Wenn du in solchem
      Wasser schwimmst oder dich in der N\xE4he von radioaktiven Quellen befindest,
      wird Strahlung auf dich abgegeben."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018284
    m_Localized: "Sch\xE4den durch magische Strahlung k\xF6nnen nicht durch gew\xF6hnliche
      Medizin geheilt werden. Verwende RadAway, um die Strahlung aus dem K\xF6rper
      zu entfernen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018285
    m_Localized: "Du kannst deine Waffe h\xF6her schweben lassen, und so schie\xDFen,
      w\xE4hrend du dich hunter einer Kante befindest. Halte dazu [W] gedr\xFCckt.
      Halte gleichzeitig [S] und [W] gedr\xFCckt, um dasselbe im liegen zu tun."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018286
    m_Localized: "Die meisten deiner Feinde k\xF6nnen dich h\xF6ren. Du machst beim
      Schie\xDFen und beim schnellen Laufen Ger\xE4usche was sie h\xF6ren werden
      und sie h\xF6chstwahrscheinlich alarmiert wenn sie kommen um nach der Quelle
      daf\xFCr zu suchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018287
    m_Localized: "Selbst-Levitation kann dir helfen, an Orte zu gelangen, die du
      sonst nicht erreichen k\xF6nntest, indem du auf Leitern springst und diese
      dann besteigst, aber es erfordert eine Menge magische Energie. Dr\xFCcken und
      halte dazu beim Springen die [Leertaste], um die Selbstlevitation zu verwenden."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018288
    m_Localized: "Du kannst dich hinter Kisten, M\xF6beln und in Wandnischen verstecken.
      Dies wird dir helfen, dich vor Feinden zu verstecken und dich vor Kugeln zu
      sch\xFCtzen. Um in Deckung zu gehen, stelle dich vor das Versteck und dr\xFCcke
      [W]."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018289
    m_Localized: "Mit dem Mausrad kannst du zwischen den Waffen wechseln. Zus\xE4tzliche
      Informationen werden ebenfalls angezeigt. Kaputte Waffen, die ohne Munition
      oder mit zu hohen Anforderungen, werden nicht angezeigt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018290
    m_Localized: "Du erleidest zus\xE4tzliche Verletzungen, wenn du das Bewusstsein
      verlierst und zum Kontrollpunkt zur\xFCckkehrst, was die Behandlungskosten
      erh\xF6ht. Es ist besser, deinen Gesundheitszustand zu beobachten und zur gegebenen
      Zeit Heiltr\xE4nke einzunehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018291
    m_Localized: "Telekinese kann dir im Kampf helfen. Du kannst beispielsweise einen
      schweren Gegenstand auf einen Feind fallen lassen. Und mit Hilfe eines Talents
      auch Gegenst\xE4nde und sogar Feinde selbst werfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018292
    m_Localized: "Du kannst verschiedene Arten von Munition finden, die in verschiedenen
      Situationen unterschiedlich effektiv sind. Zum Beispiel sind Panzerbrechende
      Kugeln gegen gepanzerte Ziele effektiver und noch weitaus gef\xE4hrlicher f\xFCr
      Ziele ohne Panzerung. Du kannst den Munitionstyp im Inventar oder durch Drehen
      am Mausrad bei gedr\xFCckter [Umschalttaste] wechseln."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018293
    m_Localized: "Zerbrechliche W\xE4nde und T\xFCren k\xF6nnen mit einem Vorschlaghammer,
      Sprengstoff oder Plasma zerbrochen werden. Stahlw\xE4nde k\xF6nnen nicht zerst\xF6rt
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018294
    m_Localized: "R\xFCstungen sch\xFCtzen vor physischen Sch\xE4den - Kugeln, Schl\xE4ge,
      Schnitte und fliegende Tr\xFCmmer. Kugeln mit geringem Kaliber und schwache
      Schl\xE4ge verursachen keinen Schaden bei gepanzerten Gegnern."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018295
    m_Localized: "Magische R\xFCstungen sch\xFCtzen vor Energiesch\xE4den wie Feuer,
      Laser und Plasma."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018296
    m_Localized: "Du kannst Schl\xF6sser, alleine mit einem Schraubenzieher \xF6ffnen.
      Es ist jedoch besser, immer ein paar M\xE4hnenklammern zur Verf\xFCgung zu
      haben. Wenn du einen Schraubenzieher zusammen mit M\xE4hnenklammern verwendest,
      \xF6ffnest du das Schloss viel sorgf\xE4ltiger, wodurch du weitere Versuche
      hast, bevor es klemmt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018297
    m_Localized: "Du kannst \xFCber das leuchtende MAS-Terminal oder mit einer Rune
      der R\xFCckkehr zum Basislager zur\xFCckkehren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018298
    m_Localized: "Bloatsprites sind sehr schwer mit Kugeln zu t\xF6ten, aber sie
      sind anf\xE4llig f\xFCr Feuer- und Energiewaffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018299
    m_Localized: "Roller sind anf\xE4llig f\xFCr Explosionen und panzerbrechende
      Waffen. Au\xDFerdem vertragen Walzen sind anf\xE4llig f\xFCr Explosionen und
      panzerbrechende Waffen. Au\xDFerdem vertragen sie absolut kein Wasser."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018300
    m_Localized: "Waffen, die du selten verwendest, k\xF6nnen durch Klicken mit der
      rechten Maustaste im Inventar ausgeblendet werden. Versteckte Waffen werden
      in der Liste und in der Waffenauswahl nicht angezeigt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018301
    m_Localized: "Laserwaffen sind genau, aber relativ schwach. Plasma hingegen verursacht
      gro\xDFen Schaden, vor dem es fast keinen Schutz gibt, aber es ist schwieriger,
      damit das Ziel zu treffen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018302
    m_Localized: "Angriffe mit Hieb und Stichwaffen im Nahkapf Nahkampfwaffe k\xF6nnen
      einen Blutungen hervorrufen, jedoch nur bei Kreaturen mit Blut. Verwende Wundverb\xE4nde,
      um die Blutung zu stoppen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018303
    m_Localized: "Du kannst von jeder Waffe nur ein Exemplar mit dir f\xFChren. Wenn
      du eine Waffe findest, die du bereits hst, wird sie f\xFCr Ersatzteile verwendet."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018304
    m_Localized: "Jede Waffe kann eine bestimmte Anzahl von Malen benutzt werden,
      bevor sie zerbricht. F\xFCr die Reparatur musst du eine andere Waffe desselben
      Modells finden, die f\xFCr Ersatzteile verwendet werden kann, eine Reparaturausr\xFCstung
      verwenden oder sie mit Waffenfragmenten auf einer Werkbank reparieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018305
    m_Localized: Von vielen Waffen gibt es einzigartige Modelle, die besser sind
      als das Standardmodell. Wenn du eine einzigartige Waffe findest oder kaufst,
      diese die normale.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018306
    m_Localized: "Schwere Waffen verlangsamen deine Laufgeschwindigkeit, wenn sie
      ausger\xFCstet sind. Nachdem du jedoch die F\xE4higkeit \"Auf die Gr\xF6\xDFe
      kommt es an!\" erlernt hast, f\xE4llt dieser Effekt weg."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018307
    m_Localized: "Du kannst jederzeit mit der Taste [G] eine Granate werfen oder
      eine Mine platzieren, auch wenn du gerade eine andere Waffe verwendest. Die
      zuletzt ausger\xFCstete Granate oder Mine wird dann verwendet."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018308
    m_Localized: "Feindliche Minen sind nur aus n\xE4chster N\xE4he sichtbar. Bewegen
      dich vorsichtig, sonst k\xF6nntest du sie eine Sekunde zu sp\xE4t bemerken."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018309
    m_Localized: "Alle Roboter sind anf\xE4llig f\xFCr Impulswaffen - sie richten
      gro\xDFen Schaden an und k\xF6nnen die Roboter einen kurzen Augenblick lahm
      legen. Bei lebenden Feinden hingegen, haben sie keine Wirkung."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018310
    m_Localized: "Radskorpione haben einen gef\xE4hrlichen Giftstachel. Vermeiden
      es von ihm gestochen zu werden, und nimm in diesem Fall ein Gegenmittel. Das
      Gift f\xFCgt der Gesundheit Schaden zu."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018311
    m_Localized: "Die Reichweite zum Werfen einer Granate h\xE4ngt von der Position
      des Mauszeigers zum Spieler ab. Mit Telekinese kannst du sowohl deine eigenen
      als auch feindliche Granaten bewegen. Vorausgesetzt, du bist schnell genug."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018312
    m_Localized: "Mit Hilfe von Telekinese kannst du Objekte \xFCbereinander stapeln
      und so h\xF6her klettern."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018313
    m_Localized: "Du kannst Telekinese verwenden, um so zu versuchen, deine Feinde
      zu bewegen. Sie werden jedoch versuchen, sich von deinem telekinetischen Zugriff
      zu befreien. Je h\xF6her deine Telekinese-F\xE4higkeiten sind, desto schwerer
      wird es f\xFCr sie, zu entkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018314
    m_Localized: "Nachdem du deine Telekinese F\xE4higkeit erh\xF6ht hast, kannst
      du damit platzierte Minen bewegen. Denke jedoch daran, dass der Sensor dabei
      ausgel\xF6st werden und eine Z\xFCndung verursachen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018315
    m_Localized: "Wenn deine Telekinese-F\xE4higkeiten hoch genug sind, kannst du
      damit Gesch\xFCtzt\xFCrme aus ihrer Verankerung rei\xDFen und sie so deaktivieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018316
    m_Localized: "Ein StealthBuck kann dich f\xFCr kurze Zeit fast unsichtbar machen.
      Aber Feinde k\xF6nnen dich immer noch h\xF6ren und auf das Ger\xE4usch schie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018317
    m_Localized: "B\xFCcher und Ged\xE4chtniskugeln enthalten wertvolle Informationen,
      mit denen deine F\xE4higkeiten verbessern werden k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018318
    m_Localized: Mit C-4-Sprengstoff kannst du selbst die festesten Beton- oder Steinmauern
      sprengen. Du kannst auch eine Hufgemachte Bombe verwenden, aber sie ist viel
      weniger stark.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018319
    m_Localized: "Du wirst dein Ziel nicht immer treffen. Die Wahrscheinlichkeit
      eines Treffers h\xE4ngt von der Art der Waffe und deinem K\xF6nnen ab. Um einen
      Feind mit einer Waffe wie etwa einer abges\xE4gten Schrotflinte zu erschie\xDFen,
      muss man sehr nahe heran."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018320
    m_Localized: "Mit [Umschalt] + [Linke Maustaste] auf einen Produktnamen im Handelsfenster
      wird die maximal verf\xFCgbare Menge des Artikels zum Kauf oder Verkauf ausgew\xE4hlt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018321
    m_Localized: "Waffen, die von Banditen benutzt werden, sind immer schlecht und
      in einem schrecklichen Zustand, nur zur Ersatzteilgewinnung zu gebrauchen.
      Gute Waffen findet man in nicht gepl\xFCnderten Arsenalen und manchmal in Tresoren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018322
    m_Localized: "Besch\xE4digte Waffen sind ungenauer, richten weniger Schaden an
      und k\xF6nnen auch Fehlz\xFCndungen haben oder gar blockieren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018323
    m_Localized: "Tresore sind immer verschlossen und manchmal durch Sprengstoff
      oder einen Alarm gesch\xFCtzt. Du ben\xF6tigst F\xE4higkeiten zum Hacken, Sprengen
      oder Schlossknacken, um sicher an ihren Inhalt zu gelangen. Normalerweise lohnt
      es sich, denn je besser das Schloss ist, desto h\xF6her ist die Wahrscheinlichkeit,
      dass der Tresor etwas Wertvolles enth\xE4lt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018324
    m_Localized: "Schusswaffen verwenden verschiedene Arten von Munition. Das kann
      ein gro\xDFes Problem sein - auch wenn du eine tolle Waffe hast, gibt es m\xF6glicherweise
      nichts, zum verschie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018325
    m_Localized: Wilde Ghule graben sich gern unter der Erde ein. Nichts wird ihre
      Anwesenheit verraten, bis sie sich ausgraben und angreifen.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018326
    m_Localized: "Hat dich ein schrecklicher Schleim erwischt? Verbrenne ihn mit
      Feuer, und wenn das nicht m\xF6glich ist, trete zumindest nicht darauf!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018327
    m_Localized: "Elektrische Entladungen verursachen viel weniger Schaden, wenn
      du den Boden nicht ber\xFChrst, und viel mehr, wenn du nass bist."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018328
    m_Localized: "Leuchtende Ghule sind radioaktiv! Wenn sie dich angreifen, verursachen
      sie nicht nur k\xF6rperlichen Schaden, sondern verabreichen dir auch eine Dosis
      Strahlung."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018329
    m_Localized: "Metallpanzerungen sch\xFCtzen gut vor physischen Sch\xE4den und
      Laser, sind aber sehr schwer und erh\xF6hen au\xDFerdem deine Anf\xE4lligkeit
      f\xFCr Elektrizit\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018330
    m_Localized: "S\xE4ure f\xFCgt nicht nur der Gesundheit Schaden zu, sondern zerst\xF6rt
      auch schnell R\xFCstungen, sowohl bei dir, als auch die deiner Gegner."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018331
    m_Localized: "Wenn du beim Laufen schie\xDFt oder hinter dich zielst, verringert
      sich deine Genauigkeit. Wenn du beim Zielen still stehen bleibst, erh\xF6ht
      sich die Genauigkeit. Es hat keine Auswirkung auf das Schie\xDFen im S.A.T.S.
      Modus."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018332
    m_Localized: "Wenn du das Schloss eines Beh\xE4lters blockiert hast oder du es
      einfach nicht \xF6ffnen kannst, kannst du versuchen, es mit der Brechstange
      aufzubrechen. Dabei werden sowohl die Dinge aus dem Beh\xE4lter als auch die
      Brechstange selbst besch\xE4digt."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018333
    m_Localized: "Tresore, die nicht mehr auf andere Weise ge\xF6ffnet werden k\xF6nnen,
      k\xF6nnen mit Hilfe einer Bombe oder mehreren Dynamitladungen aufgesprengt
      werden. Es ist jedoch wahrscheinlich, dass der Inhalt dabei besch\xE4digt wird."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018334
    m_Localized: "Du kannst versuchen, Kraftfelder abzuschalten. Im Fehlerfall kannst
      du dabei einen elektrischen Schlag bekommen. Die Erfolgswahrscheinlichkeit
      h\xE4ngt von der Stufe der \"Reparatur\" F\xE4higkeit ab."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018335
    m_Localized: "Wenn du die Fertigkeit \"Handel\" verbesserst, senkst du nicht
      nur die Preise f\xFCr Waren von H\xE4ndlern, sondern erweiterst auch die Auswahl
      ihrer verf\xFCgbaren Waren."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018336
    m_Localized: "Fast jede Waffe hat eine F\xE4higkeitsanforderung. Bei ungen\xFCgender
      Fertigkeit verliert die Waffe an Wirksamkeit. Die Angriffsgeschwindigkeit,
      Pr\xE4zision und Schaden werden verringert."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018337
    m_Localized: "Die meisten Arten von R\xFCstungen k\xF6nnen verbessert werden.
      Dazu musst du das Talent \"R\xFCstungsverbesserung\" erlernen, und geeignete
      Materialien sowie eine Werkbank zur Verf\xFCgung haben."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018338
    m_Localized: "Finde oder kaufe Baupl\xE4ne f\xFCr benutzerdefinierte Waffen.
      Du kannst sie auf einer Werkbank zusammenbauen, wenn du das n\xF6tige Material
      daf\xFCr hast. Die Wirksamkeit von Hufgemachten Waffen, h\xE4ngt von deiner
      \"Reparatur\" F\xE4higkeit ab."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018339
    m_Localized: "Ein gepanzertes Gesch\xFCtz ist durch eine Panzerung und ein Kraftfeld
      perfekt gesch\xFCtzt, jedoch nur von einer Seite. Es ist sehr leicht zu zerst\xF6ren,
      wenn man es von hinten angreift."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018340
    m_Localized: "Wachbots sind t\xF6dlich gef\xE4hrlich! Sie sind mit starken R\xFCstungen
      und verschiedenen Arten schwerer Waffen ausger\xFCstet. K\xE4mpfe nicht gegen
      sie wenn du keine Waffen hast, die Panzerungen durchdringen oder Impulse abgeben
      k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018341
    m_Localized: "Du kannst die ausger\xFCstete Waffe entladen, in dem du die Nachladen-Taste
      [R] einige Sekunden lang gedr\xFCckt h\xE4lst."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018342
    m_Localized: "Schutzzauber sind im Kampf sehr n\xFCtzlich. R\xFCste einen gew\xFCnschten
      Zauberspruch aus dem Inventar oder mit einer Zifferntaste aus und wende ihn
      dann mit [C] an."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018343
    m_Localized: "Du kannst den Zifferntasten [1] - [0] Waffen, R\xFCstungen, Zauber
      oder Ausr\xFCstungsgegenst\xE4nde zuweisen. Bewege dazu den Mauszeiger im Inventarmen\xFC
      auf das Objekt und dr\xFCcke die gew\xFCnschte Zifferntaste."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018344
    m_Localized: "Wenn du Schleich-Taktiken anwendest, achte auf Gegner, die mit
      einem (\u0298) neben ihrem Namen gekennzeichnet sind. Diese Gegner sind besonders
      aufmerksam und werden dich schneller entdecken."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018345
    m_Localized: "Verwenden den Waffenst\xE4nder, um alle deine Waffen, Magie, R\xFCstungen
      und Artefakte anzuzeigen. Leere Felder kennzeichnen Objekte, die du noch nicht
      hast. Sammle sie alle!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018346
    m_Localized: "Heroische Feinde, welche mit einem goldenen Stern markiert sind,
      sind viel st\xE4rker und gef\xE4hrlicher als gew\xF6hnlich. Wenn du sie jedoch
      besiegst, erh\xE4lst du eine einzigartige Waffe oder seltene Gegenst\xE4nde."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018347
    m_Localized: "Spezielle Gegner in roter Farbe richten erh\xF6hten Schaden an,
      Blau - besserer Schutz vor physischen Schaden, Lila - vor Magie und Gr\xFCn
      - erh\xF6hte Geschwindigkeit und Wahrnehmung."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018348
    m_Localized: "Tr\xE4nke mit permanenter Wirkung verbessern einige deiner Eigenschaften
      dauerhaft. du kannst nicht mehr als f\xFCnf Tr\xE4nke der gleichen Sorte trinken,
      danach hat jeder zus\xE4tzliche Trank keine Wirkung mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018349
    m_Localized: "Roboterzellen werden durch ein Funksignal aktiviert, wenn du mit
      anderen Robotern k\xE4mpfst. Sie k\xF6nnen jedoch im Voraus deaktiviert werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018350
    m_Localized: "Die F\xE4higkeit \"Schleichen\" kann dir helfen Alarmsysteme auszuschalten.
      Wenn der Alarm ausgel\xF6st wird, zieht er neue Feinde an."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018351
    m_Localized: "Durch St\xFCrmen kannst du den Angriffen von Gegnern ausweichen
      und Hindernisse \xFCberwinden. Halte zum St\xFCrmen die [Gro\xDFschreibtaste]
      gedr\xFCckt, und dr\xFCcke jeweils zweil mal [A] oder [D]."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018352
    m_Localized: "Du kannst schwebende Kisten als Schutzschild verwenden. Schwere
      Metallkisten sch\xFCtzen besser als leichte Holzkisten. Du kannst auch versuchen
      den K\xF6rper eines toten Feindes zu verwenden."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018353
    m_Localized: "Mit der F\xE4higkeit \"\xDCberleben\" erh\xE4lst du Zugriff auf
      Zebratr\xE4nke. Einfachere Tr\xE4nke k\xF6nnen in einer K\xFCche zubereitet
      werden. Komplexere erfordern Laborger\xE4te."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018354
    m_Localized: "Mit der Fertigkeit \"\xDCberleben\" haben Sie Zugriff auf Zebratrankrezepte.
      Tr\xE4nke k\xF6nnen vor\xFCbergehend oder dauerhaft wirken. Das Zubereiten
      von Tr\xE4nken erfordert einen Labortisch."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018355
    m_Localized: "Tr\xE4nke mit dauerhafter Wirkung (Elixiere) verleihen dir bestimmte
      F\xE4higkeiten. Solche F\xE4higkeiten haben nur 5 Stufen, so dass du nicht
      mehr als f\xFCnf der gleichen Elixiere trinken kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018356
    m_Localized: Verletzungen reduzieren deine Eigenschaften erheblich. - Schnelligkeit,
      Ausdauer, Genauigkeit, Magie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018357
    m_Localized: "Wenn deine magische Kraft um mehr als die H\xE4lfte verringert
      wird, verringert sich die Wirksamkeit deiner Zauber"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018358
    m_Localized: "Mit einem Rezept und den richtigen Zutaten kannst du auf dem Herd
      kochen. Essen gibt dir langfristige Boni f\xFCr verschiedene Eigenschaften,
      jedoch bekommst du nur die Boni der letzten Mahlzeit, die du gegessen hast."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018359
    m_Localized: "Du kannst Gegenst\xE4nde, die du nicht ben\xF6tigst, aber nicht
      verkaufen m\xF6chtest, in das Lager legen. Gegenst\xE4nde aus dem Lager k\xF6nnen
      direkt zum Verarbeiten an einer Werkbank oder einem Labortisch im Basislager
      verwendet werden. Du musst sie daf\xFCr nicht zur\xFCck in dein Inventar holen."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018360
    m_Localized: "Wasche deinen Schweif regelm\xE4\xDFig!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018361
    m_Localized: Aua!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018362
    m_Localized: Autsch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018363
    m_Localized: Oahh, das tut weh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018364
    m_Localized: Oh nein, oh nein!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018365
    m_Localized: Ich bin verletzt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018366
    m_Localized: Verdammt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018367
    m_Localized: Die Schweine haben mich erwischt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018368
    m_Localized: Oh, fick dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018369
    m_Localized: Fuuuck!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018370
    m_Localized: Hah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018371
    m_Localized: Jetzt gehts!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018372
    m_Localized: Erledigt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018373
    m_Localized: War doch garnicht so schwer
    m_Metadata:
      m_Items: []
  - m_Id: 2742018374
    m_Localized: Kinderleicht
    m_Metadata:
      m_Items: []
  - m_Id: 2742018375
    m_Localized: Jeah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018376
    m_Localized: Einfach!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018377
    m_Localized: Geschafft!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018378
    m_Localized: Gute Arbeit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018379
    m_Localized: Niedlich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018380
    m_Localized: Kein Schloss kann mich aufhalten!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018381
    m_Localized: Nimm das, dummes Schloss!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018382
    m_Localized: "Solche Schl\xF6sser sind gerade mal gut f\xFCr Toiletten"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018383
    m_Localized: Kein verdammtes Schloss kann mir widerstehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018384
    m_Localized: Vielleicht "ABC123"? Komm schon!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018385
    m_Localized: Noobs!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018386
    m_Localized: Schlechtes Passwort...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018387
    m_Localized: Das war Passwort "penis123"?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018388
    m_Localized: Verflixt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018389
    m_Localized: Was zur?!..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018390
    m_Localized: Nicht schon wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018391
    m_Localized: Es Nervt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018392
    m_Localized: Es ist schwerer als es aussieht
    m_Metadata:
      m_Items: []
  - m_Id: 2742018393
    m_Localized: Pech!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018394
    m_Localized: Kein Problem
    m_Metadata:
      m_Items: []
  - m_Id: 2742018395
    m_Localized: Ich probiere es noch einmal
    m_Metadata:
      m_Items: []
  - m_Id: 2742018396
    m_Localized: Oh nein, so leicht gebe ich nicht auf!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018397
    m_Localized: Ich schaffe das!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018398
    m_Localized: Arrrgh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018399
    m_Localized: Fahr zu Tartarus...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018400
    m_Localized: Oh, Luna hat mich verflucht!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018401
    m_Localized: Wieso ist das Leben so ungerecht?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018402
    m_Localized: Wie kann das so schwierig sein?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018403
    m_Localized: Celestia, hasst mich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018404
    m_Localized: Oh, man.. Discord!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018405
    m_Localized: Das ist heute nicht mein Tag!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018406
    m_Localized: Warum geht das nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018407
    m_Localized: Oh, zum Heuhaufen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018408
    m_Localized: Oh du kleines...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018409
    m_Localized: Was zum Teufel!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018410
    m_Localized: Heute sitze ich irgendwie auf meinem Horn!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018411
    m_Localized: Oh um Celestias Willen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018412
    m_Localized: Echt, das ist beschissen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018413
    m_Localized: Luna vergewaltigt mich mit ihren Horn!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018414
    m_Localized: Sieht gut aus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018415
    m_Localized: Prima, aber Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018416
    m_Localized: Jawohl!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018417
    m_Localized: Oh wow!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018418
    m_Localized: Toll!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018419
    m_Localized: Das war es wert!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018420
    m_Localized: Grr... und?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018421
    m_Localized: Ist das alles?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018422
    m_Localized: Willst du mich verarschen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018423
    m_Localized: "Verflucht! Nur M\xFCll"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018424
    m_Localized: Wieso ist das leer?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018425
    m_Localized: Mir spielt jemand einen Streich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018426
    m_Localized: "Ich k\xF6nnte t\xF6ten f\xFCr etwas zu Rauchen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018427
    m_Localized: Verdammte Kopfschmerzen...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018428
    m_Localized: Gibt es an diesen verdammten Ort etwas zu Essen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018429
    m_Localized: Hey du Flasche!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018430
    m_Localized: Ich muss pissen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018431
    m_Localized: "Ein Bier w\xFCrde mir jetzt den Tag vers\xFC\xDFen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018432
    m_Localized: Willst du mir eine verpassen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018433
    m_Localized: Willst du dass ich dir die Eier zerquetsche?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018434
    m_Localized: "Was f\xFCr ein Wichser!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018435
    m_Localized: Buhuu...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018436
    m_Localized: Verdammt bin ich high!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018437
    m_Localized: Fahr zu Tartarus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018438
    m_Localized: "Pferde\xE4pfel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018439
    m_Localized: Was schaust du so Arschloch??
    m_Metadata:
      m_Items: []
  - m_Id: 2742018440
    m_Localized: "Bl\xF6dmann!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018441
    m_Localized: Wir sind nicht fehlerfrei... lala..!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018442
    m_Localized: "Ich habe diese Pferdeschei\xDFe satt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018443
    m_Localized: Ich bin mit dem ganzen Mist fertig
    m_Metadata:
      m_Items: []
  - m_Id: 2742018444
    m_Localized: "Zur G\xF6ttin verdammt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018445
    m_Localized: '* pfeifen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018446
    m_Localized: '* spucken *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018447
    m_Localized: '* fluchen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018448
    m_Localized: "* g\xE4hnen *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018449
    m_Localized: "* verr\xFCcktes Lachen *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018450
    m_Localized: '* leerer Blick *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018451
    m_Localized: Zeit zu sterben!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018452
    m_Localized: Stirb!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018453
    m_Localized: Attacke!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018454
    m_Localized: Ich mach dich fertig!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018455
    m_Localized: Ich kriege dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018456
    m_Localized: "Das macht gleich doppelt so viel Spa\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018457
    m_Localized: Geil! Geil! Geil!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018458
    m_Localized: Ich erschlage dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018459
    m_Localized: Ich lass dir die Luft raus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018460
    m_Localized: Vergewaltigungszeit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018461
    m_Localized: Arschloch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018462
    m_Localized: Bringt alle um!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018463
    m_Localized: "Komm her, du Bl\xF6dmann!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018464
    m_Localized: Mu-ha-ha-ha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018465
    m_Localized: Aha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018466
    m_Localized: Bu-ha-ha-ha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018467
    m_Localized: Blut!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018468
    m_Localized: Fleisch!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018469
    m_Localized: Du bist erledigt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018470
    m_Localized: Sag lebwohl, Fotze!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018471
    m_Localized: Ich sehe dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018472
    m_Localized: Da ist sie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018473
    m_Localized: Alle Ponys, hier her!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018474
    m_Localized: "T\xF6ten!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018475
    m_Localized: Stirb, Schlampe!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018476
    m_Localized: "T\xF6ten, t\xF6ten, t\xF6teeennn!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018477
    m_Localized: Ich brenne!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018478
    m_Localized: Wollt ihr sie roh oder gut durchgebraten?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018479
    m_Localized: Feuer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018480
    m_Localized: Steck sie in brand!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018481
    m_Localized: Gebratenes Fleisch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018482
    m_Localized: "Hier wirds gleich hei\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018483
    m_Localized: Ich mag den Geruch von Napalm am Morgen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018484
    m_Localized: Fritten umsonst, alle Ponys!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018485
    m_Localized: Erwischt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018486
    m_Localized: Jeehaa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018487
    m_Localized: Lunte brennt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018488
    m_Localized: Ein Knall und du bist Staub!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018489
    m_Localized: Feuerwerk!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018490
    m_Localized: Achtung Granate!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018491
    m_Localized: Ich jage deine Welt in die Luft!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018492
    m_Localized: Buuum!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018493
    m_Localized: Was war das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018494
    m_Localized: Wer ist da?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018495
    m_Localized: "Ist ein Pony dort drau\xDFen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018496
    m_Localized: Huh? Wha?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018497
    m_Localized: Mmm?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018498
    m_Localized: Was zum Heuhaufen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018499
    m_Localized: "Hast du das geh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018500
    m_Localized: Wo?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018501
    m_Localized: Was bei Tartarus geht hier vor?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018502
    m_Localized: "Waren das Sch\xFCsse?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018503
    m_Localized: War da eben was?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018504
    m_Localized: "Ich habe etwas geh\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018505
    m_Localized: Da ist es wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018506
    m_Localized: Wo ist sie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018507
    m_Localized: Findet sie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018508
    m_Localized: Ich finde dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018509
    m_Localized: Vor mir kannst du dich nicht verstecken, kleine Fotze!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018510
    m_Localized: Wo bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018511
    m_Localized: Ich kann sie nicht mehr sehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018512
    m_Localized: Sie ist hier irgendwo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018513
    m_Localized: Findet sie, Jungs!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018514
    m_Localized: Wo ist sie hin?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018515
    m_Localized: Verdammt, wo bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018516
    m_Localized: Wo versteckst du dich?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018517
    m_Localized: "H\xF6r auf dich zu verstecken, s\xFC\xDFe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018518
    m_Localized: Das macht das Ganze um einiges interessanter!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018519
    m_Localized: Komm raus, dann mache ich es schmerzlos
    m_Metadata:
      m_Items: []
  - m_Id: 2742018520
    m_Localized: Komm raus, du Feigling!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018521
    m_Localized: "Ohh, verdammte Schei\xDFe..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018522
    m_Localized: Lass sie verrecken
    m_Metadata:
      m_Items: []
  - m_Id: 2742018523
    m_Localized: Ja, lauf nur, Schlampe!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018524
    m_Localized: "Pferde\xE4pfel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018525
    m_Localized: "Die holen wir uns sp\xE4ter"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018526
    m_Localized: Sie kann nicht weit weg sein
    m_Metadata:
      m_Items: []
  - m_Id: 2742018527
    m_Localized: Verdammter Mist
    m_Metadata:
      m_Items: []
  - m_Id: 2742018528
    m_Localized: Ich vergewaltige dich zu tode!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018529
    m_Localized: Muss ich mir eingebildet haben
    m_Metadata:
      m_Items: []
  - m_Id: 2742018530
    m_Localized: Ist nur der Wind
    m_Metadata:
      m_Items: []
  - m_Id: 2742018531
    m_Localized: Sauber... denke ich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018532
    m_Localized: "Ich war mir sicher ich h\xE4tte etwas geh\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018533
    m_Localized: Ach.., da ist nichts
    m_Metadata:
      m_Items: []
  - m_Id: 2742018534
    m_Localized: Wieder nur Ratten...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018535
    m_Localized: Nah, drauf geschissen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018536
    m_Localized: Wer zum Heuhaufen war das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018537
    m_Localized: Ich habe doch gesagt dass hier ein verficktes Pony ist
    m_Metadata:
      m_Items: []
  - m_Id: 2742018538
    m_Localized: Ich will dich bluten sehen...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018539
    m_Localized: Ich werde dich langsam umbringen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018540
    m_Localized: OH.. FUCK!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018541
    m_Localized: Autsch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018542
    m_Localized: Uaahh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018543
    m_Localized: Ich bin verletzt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018544
    m_Localized: Die haben mich erwischt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018545
    m_Localized: Die bringen mich um!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018546
    m_Localized: AAAAAH!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018547
    m_Localized: Sei mein Zeuge...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018548
    m_Localized: Das wars...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018549
    m_Localized: Ich bin fertig
    m_Metadata:
      m_Items: []
  - m_Id: 2742018550
    m_Localized: '* keuchen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018551
    m_Localized: '* tot *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018552
    m_Localized: Was verfickt nochmal ist das???
    m_Metadata:
      m_Items: []
  - m_Id: 2742018553
    m_Localized: Waa???
    m_Metadata:
      m_Items: []
  - m_Id: 2742018554
    m_Localized: Lass mich runter!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018555
    m_Localized: Verfickte Magie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018556
    m_Localized: Granate!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018557
    m_Localized: Runter!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018558
    m_Localized: Aufgepasst!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018559
    m_Localized: Schafft euer Flanken hier weg!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018560
    m_Localized: Schaut mal da!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018561
    m_Localized: Seht euch das an!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018562
    m_Localized: "Heilige Schei\xDFe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018563
    m_Localized: Whaa!..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018564
    m_Localized: "Verfickte.. Schei\xDFe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018565
    m_Localized: Was zur ..?!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018566
    m_Localized: "Wieviel wir f\xFCr die wohl bekommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018567
    m_Localized: "Wielange m\xFCssen wir hier noch bleiben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018568
    m_Localized: Ich bin so hungrig!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018569
    m_Localized: Ich sag dir, sie kommt nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018570
    m_Localized: Wir sollten uns jemand anderen suchen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018571
    m_Localized: Ist denn kein Pony hier!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018572
    m_Localized: Ich sags dir, das Ziel war zuletzt hier!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018573
    m_Localized: Wielange denn noch?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018574
    m_Localized: Hast du eine Zigarette?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018575
    m_Localized: Kontrolliert eure Waffen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018576
    m_Localized: Macht euch bereit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018577
    m_Localized: "Hier ist es gef\xE4hrlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018578
    m_Localized: "Lohnt sich das \xFCberhaupt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018579
    m_Localized: "Mit gef\xE4llt es hier nicht"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018580
    m_Localized: Das ist es!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018581
    m_Localized: Hat jemand lust Karten zu spielen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018582
    m_Localized: Ich habe es so satt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018583
    m_Localized: "Ein schei\xDF Leben!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018584
    m_Localized: Ich zerschmettern alles!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018585
    m_Localized: '* pfeifen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018586
    m_Localized: '* spucken *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018587
    m_Localized: '* fluchen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018588
    m_Localized: "* g\xE4hnen *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018589
    m_Localized: '* bwak bwak *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018590
    m_Localized: '* kratzen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018591
    m_Localized: Achtung! Ziel entdeckt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018592
    m_Localized: "Feuer er\xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018593
    m_Localized: Ziel auf 12 Uhr!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018594
    m_Localized: Eliminieren!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018595
    m_Localized: Wir haben auf dich gewartet!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018596
    m_Localized: Da bist du ja!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018597
    m_Localized: Ziel ausschalten!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018598
    m_Localized: Bringt sie um!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018599
    m_Localized: Lasst sie uns fertig machen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018600
    m_Localized: "Es ist nichts pers\xF6nliches!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018601
    m_Localized: "Es geht nur ums Gesch\xE4ft"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018602
    m_Localized: Ich brauche nur deinen Kopf
    m_Metadata:
      m_Items: []
  - m_Id: 2742018603
    m_Localized: Besser du wehrst dich nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018604
    m_Localized: Bleib wo du bist!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018605
    m_Localized: Lauf nicht weg, sonst wird es nur noch schmerzhafter
    m_Metadata:
      m_Items: []
  - m_Id: 2742018606
    m_Localized: Jetzt, alle hier her!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018607
    m_Localized: Eine Kugel zwischen die Augen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018608
    m_Localized: Ich tue nur meine Pflicht
    m_Metadata:
      m_Items: []
  - m_Id: 2742018609
    m_Localized: Ich tue nur meine Arbeit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018610
    m_Localized: "F\xFCr dich gibts ein fettes Kopfeld!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018611
    m_Localized: Was war das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018612
    m_Localized: Wer ist da?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018613
    m_Localized: Ist irgendein Pony hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018614
    m_Localized: Ah? Wha?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018615
    m_Localized: "Verd\xE4chtiges Ger\xE4usch!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018616
    m_Localized: Hey! Findet heraus was da ist!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018617
    m_Localized: "Hast du das geh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018618
    m_Localized: Wo?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018619
    m_Localized: "Waren da Sch\xFCsse?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018620
    m_Localized: War da was?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018621
    m_Localized: "Ich habe etwas geh\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018622
    m_Localized: Da, schon wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018623
    m_Localized: Wo ist sie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018624
    m_Localized: Findet sie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018625
    m_Localized: Ich fnde dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018626
    m_Localized: "H\xF6re auf dich zu verstecken!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018627
    m_Localized: Wo ist sie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018628
    m_Localized: Ich kann sie nicht sehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018629
    m_Localized: Sie ist hier irgendwo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018630
    m_Localized: Ich habe das Ziel aus den Augen verloren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018631
    m_Localized: Wo versteckst du dich?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018632
    m_Localized: Seht oben mal nach
    m_Metadata:
      m_Items: []
  - m_Id: 2742018633
    m_Localized: Ich finde dich schon noch
    m_Metadata:
      m_Items: []
  - m_Id: 2742018634
    m_Localized: Sucht den Boden ab!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018635
    m_Localized: Ich kann sie nicht finden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018636
    m_Localized: Suche einstellen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018637
    m_Localized: Teilt euch auf um sie zu suchen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018638
    m_Localized: Oh ahh, unsere Kronkorken sind weg...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018639
    m_Localized: "Wir erwischen sie sp\xE4ter"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018640
    m_Localized: Weit wird sie nicht kommen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018641
    m_Localized: Du kannst nicht ewig vor uns davon laufen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018642
    m_Localized: Egal.. wir bringen jemand anderen um
    m_Metadata:
      m_Items: []
  - m_Id: 2742018643
    m_Localized: Meine Ohren spielen mir nur einen Streich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018644
    m_Localized: War wohl nur der Wind
    m_Metadata:
      m_Items: []
  - m_Id: 2742018645
    m_Localized: Nichts...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018646
    m_Localized: "Ich war sicher ich h\xE4tte etwas geh\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018647
    m_Localized: Nein, falscher Alarm
    m_Metadata:
      m_Items: []
  - m_Id: 2742018648
    m_Localized: "M\xFCssen Ratten gewesen sein..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018649
    m_Localized: Jeah, immer drauf
    m_Metadata:
      m_Items: []
  - m_Id: 2742018650
    m_Localized: Irgendpony hat geschossen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018651
    m_Localized: Das kann nicht sein, da ist definitiv jemand!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018652
    m_Localized: Wir sollten Patrouillen aussenden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018653
    m_Localized: "Sch\xFCsse.."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018654
    m_Localized: Ich bin verletzt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018655
    m_Localized: Nur ein Kratzer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018656
    m_Localized: Autsch! Mir fehlt nichts!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018657
    m_Localized: Ich habe Schmerzen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018658
    m_Localized: Die haben mich erwischt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018659
    m_Localized: "Die schie\xDFen auf mich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018660
    m_Localized: AAAAH!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018661
    m_Localized: Ich bin in Ordnung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018662
    m_Localized: "R\xE4cht mich..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018663
    m_Localized: Vergebt mir...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018664
    m_Localized: Ich kann nichts sehen...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018665
    m_Localized: Nicht mein Tag...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018666
    m_Localized: Ich habe versagt...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018667
    m_Localized: Ich kann immer noch schi...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018668
    m_Localized: "* r\xF6cheln *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018669
    m_Localized: '* tot *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018670
    m_Localized: Granate!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018671
    m_Localized: Alle runter!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018672
    m_Localized: Passt auf!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018673
    m_Localized: Eine Granate!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018674
    m_Localized: Da!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018675
    m_Localized: Passt auf!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018676
    m_Localized: Was ist da?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018677
    m_Localized: Was zum Teufel!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018678
    m_Localized: Gefahr!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018679
    m_Localized: "Erschie\xDFen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018680
    m_Localized: Weiter patrouillieren...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018681
    m_Localized: "Ich sollte meine R\xFCstung mal wieder schmieren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018682
    m_Localized: "Wann werde ich endlich mal bef\xF6rdert?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018683
    m_Localized: Technologie ist die Zukunft
    m_Metadata:
      m_Items: []
  - m_Id: 2742018684
    m_Localized: Unser Weg ist gerecht
    m_Metadata:
      m_Items: []
  - m_Id: 2742018685
    m_Localized: Dumme Barbaren!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018686
    m_Localized: Wielange sitzen wir hier noch fest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018687
    m_Localized: Irgendwelche neuen Befehle?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018688
    m_Localized: Besser mal die Batterien wechseln
    m_Metadata:
      m_Items: []
  - m_Id: 2742018689
    m_Localized: "Waffen pr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018690
    m_Localized: Seid bereit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018691
    m_Localized: "Wir sind die Gr\xF6\xDFten!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018692
    m_Localized: Wir verhelfen Equestria zu altem Glanz!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018693
    m_Localized: "Die haben die Rationen schon wieder gek\xFCrzt..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018694
    m_Localized: "Unserer Gesch\xE4ft ist hart"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018695
    m_Localized: "Wann r\xFCcken wir aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018696
    m_Localized: Die Warterei langweilt mich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018697
    m_Localized: Lasst sie nur kommen, wenn sie sich trauen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018698
    m_Localized: Wieder ein langweiliger Tag...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018699
    m_Localized: Porom-pom-pom...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018700
    m_Localized: Was sagen unsere Vorgesetzten?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018701
    m_Localized: Keine Disziplin, was sonst...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018702
    m_Localized: Ich sollte die Filter mal auswechseln...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018703
    m_Localized: Technologie ist besser als Magie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018704
    m_Localized: Eindringling!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018705
    m_Localized: "Feuer er\xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018706
    m_Localized: Diese Wilden greifen an!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018707
    m_Localized: Schaltet das Ziel aus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018708
    m_Localized: Knallt sie ab!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018709
    m_Localized: Feuer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018710
    m_Localized: "Ich er\xF6ffne das Feuer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018711
    m_Localized: Angreifer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018712
    m_Localized: Sichert das Gebiet!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018713
    m_Localized: "Order 47 ausf\xFChren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018714
    m_Localized: In Verteidigungsposition gehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018715
    m_Localized: Raketenwerfer bereit machen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018716
    m_Localized: Keine Verhandlungen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018717
    m_Localized: Gefechtsbereit machen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018718
    m_Localized: Angriff!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018719
    m_Localized: "Habe etwas verd\xE4chtiges geh\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018720
    m_Localized: "Feind in der N\xE4he!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018721
    m_Localized: Achtung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018722
    m_Localized: Kampfformation einnehmen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018723
    m_Localized: Alle in Position
    m_Metadata:
      m_Items: []
  - m_Id: 2742018724
    m_Localized: Ich werde nachsehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018725
    m_Localized: Macht euch bereit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018726
    m_Localized: Vorsicht!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018727
    m_Localized: Wir sind hier nicht alleine!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018728
    m_Localized: Was war das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018729
    m_Localized: Halt! Wer ist da?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018730
    m_Localized: Verfolge das Ziel
    m_Metadata:
      m_Items: []
  - m_Id: 2742018731
    m_Localized: "Suchen und Zerst\xF6ren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018732
    m_Localized: Ziel verloren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018733
    m_Localized: Sichtkontakt verloren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018734
    m_Localized: "Durchk\xE4mmt den Bereich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018735
    m_Localized: Stiillgestanden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018736
    m_Localized: Wegtreten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018737
    m_Localized: Bleiben Sie auf der Hut
    m_Metadata:
      m_Items: []
  - m_Id: 2742018738
    m_Localized: "Der Feind hat sich zur\xFCckgezogen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018739
    m_Localized: Hier ist nichts
    m_Metadata:
      m_Items: []
  - m_Id: 2742018740
    m_Localized: Alles sauber
    m_Metadata:
      m_Items: []
  - m_Id: 2742018741
    m_Localized: Patrouilliere weiter
    m_Metadata:
      m_Items: []
  - m_Id: 2742018742
    m_Localized: Falscher Alarm
    m_Metadata:
      m_Items: []
  - m_Id: 2742018743
    m_Localized: Keine feindlichen Ziele
    m_Metadata:
      m_Items: []
  - m_Id: 2742018744
    m_Localized: Keine Bedrohung entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018745
    m_Localized: "Nichts ungew\xF6hnliches"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018746
    m_Localized: "H\xF6chste Wachsamkeit!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018747
    m_Localized: "Der Feind ist in der N\xE4he"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018748
    m_Localized: Alle Ponys in Alarmbereitschaft!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018749
    m_Localized: Deckt eure Flanken
    m_Metadata:
      m_Items: []
  - m_Id: 2742018750
    m_Localized: "Sie m\xFCssen hier irgendwo sein"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018751
    m_Localized: "Panzerung besch\xE4digt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018752
    m_Localized: "Ich k\xE4mpfe weiter"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018753
    m_Localized: Kein kritischer Schaden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018754
    m_Localized: Nur eine leichte Wunde
    m_Metadata:
      m_Items: []
  - m_Id: 2742018755
    m_Localized: Stehe unter Beschuss!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018756
    m_Localized: Ich bin getroffen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018757
    m_Localized: Zustand stabil
    m_Metadata:
      m_Items: []
  - m_Id: 2742018758
    m_Localized: Ich bin in Ordnung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018759
    m_Localized: Ist dies das Ende?..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018760
    m_Localized: Nein, nicht so...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018761
    m_Localized: Begrabt mich mit Ehre...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018762
    m_Localized: Nein! Nicht heut...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018763
    m_Localized: Ich habe versagt...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018764
    m_Localized: Ich habe euch alle im stich gelass...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018765
    m_Localized: Argh!...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018766
    m_Localized: '* sterben *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018767
    m_Localized: Lang lebe die Enklave!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018768
    m_Localized: "Pegasi sind die \xFCberlegene Rasse"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018769
    m_Localized: Du willst und schon verlassen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018770
    m_Localized: "Wahrheit und ST\xE4rke sind auf unserer Seite"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018771
    m_Localized: "Die Oberfl\xE4che ist so eine M\xFCllkippe"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018772
    m_Localized: Hier unten gibt es nur Dreck und Wildnis
    m_Metadata:
      m_Items: []
  - m_Id: 2742018773
    m_Localized: Wielange denn noch?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018774
    m_Localized: Irgendwelche Befehle?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018775
    m_Localized: "Meine R\xFCstung muss kalibriert werden"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018776
    m_Localized: "Waffen pr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018777
    m_Localized: Seid Bereit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018778
    m_Localized: "Fliegt gleichm\xE4\xDFig!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018779
    m_Localized: Ich kann es nicht abwarten nach Hause zu kommen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018780
    m_Localized: Ich will hier unbedingt raus
    m_Metadata:
      m_Items: []
  - m_Id: 2742018781
    m_Localized: "Die Zukunft geh\xF6rt uns"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018782
    m_Localized: "Der Kommandant hat seine Gr\xFCnde"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018783
    m_Localized: Sollte alles in Ordnung sein
    m_Metadata:
      m_Items: []
  - m_Id: 2742018784
    m_Localized: "Meine Fl\xFCgel sind schon ganz taub"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018785
    m_Localized: Wir sitzen hier schon seit einem Monat...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018786
    m_Localized: Wann fliegen wir los?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018787
    m_Localized: Ich bin froh wenn ich hier heraus komme
    m_Metadata:
      m_Items: []
  - m_Id: 2742018788
    m_Localized: Eindringling entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018789
    m_Localized: "Feuer er\xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018790
    m_Localized: Die Wilden greifen uns an!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018791
    m_Localized: Ziel eliminieren!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018792
    m_Localized: Knallt ihn ab!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018793
    m_Localized: "Ich befehle das Feuer zu er\xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018794
    m_Localized: "Er\xF6ffne das Feuer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018795
    m_Localized: Fremdling!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018796
    m_Localized: "S\xE4ubert die Umgebung!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018797
    m_Localized: Befehl 56
    m_Metadata:
      m_Items: []
  - m_Id: 2742018798
    m_Localized: Befolgt meine Anweisungen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018799
    m_Localized: Greift sie aus der Luft an!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018800
    m_Localized: Keine Verhandlungen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018801
    m_Localized: Feuer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018802
    m_Localized: "Ich h\xF6re etwas"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018803
    m_Localized: "Feind ganz in der N\xE4he!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018804
    m_Localized: Achtung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018805
    m_Localized: Angriffsformation
    m_Metadata:
      m_Items: []
  - m_Id: 2742018806
    m_Localized: Die Waffen bereit machen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018807
    m_Localized: Lagebericht sofort
    m_Metadata:
      m_Items: []
  - m_Id: 2742018808
    m_Localized: Seid bereit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018809
    m_Localized: Fokus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018810
    m_Localized: Wir sind hier nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 2742018811
    m_Localized: Was war das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018812
    m_Localized: Halt! Wer ist da?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018813
    m_Localized: Ich suche ihn
    m_Metadata:
      m_Items: []
  - m_Id: 2742018814
    m_Localized: "Suchen und zerst\xF6ren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018815
    m_Localized: Ziel verloren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018816
    m_Localized: "Feind au\xDFer Sicht"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018817
    m_Localized: Sucht aus der Luft!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018818
    m_Localized: Verfolgung einstellen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018819
    m_Localized: Suche abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018820
    m_Localized: Alle Ponys, seid auf der Hut!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018821
    m_Localized: Der Feind ist entkommen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018822
    m_Localized: Da ist nichts
    m_Metadata:
      m_Items: []
  - m_Id: 2742018823
    m_Localized: Weitermachen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018824
    m_Localized: Weiter mit der Routine
    m_Metadata:
      m_Items: []
  - m_Id: 2742018825
    m_Localized: Alles sauber
    m_Metadata:
      m_Items: []
  - m_Id: 2742018826
    m_Localized: Sensoren sind alle ruhig
    m_Metadata:
      m_Items: []
  - m_Id: 2742018827
    m_Localized: Keine Bedrohung
    m_Metadata:
      m_Items: []
  - m_Id: 2742018828
    m_Localized: Nicht wichtig
    m_Metadata:
      m_Items: []
  - m_Id: 2742018829
    m_Localized: Besondere Wachsamkeit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018830
    m_Localized: Der Feind ist hier irgendwo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018831
    m_Localized: Seid vorsichtig!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018832
    m_Localized: Passt auf eure Flanken auf!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018833
    m_Localized: "Sie m\xFCssen hier sein"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018834
    m_Localized: "R\xFCstung besch\xE4digt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018835
    m_Localized: "Ich kann noch weiterk\xE4mpfen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018836
    m_Localized: Mildly wounded
    m_Metadata:
      m_Items: []
  - m_Id: 2742018837
    m_Localized: "Sch\xE4den noch verkraftbar"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018838
    m_Localized: Stehe unter Feuer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018839
    m_Localized: Ich bin getroffen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018840
    m_Localized: Zustand stabil
    m_Metadata:
      m_Items: []
  - m_Id: 2742018841
    m_Localized: Ich bin in Ordnung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018842
    m_Localized: Das ist...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018843
    m_Localized: Ist das wirklich das Ende?..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018844
    m_Localized: "Verliere an H\xF6he!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018845
    m_Localized: Bin am Ende!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018846
    m_Localized: Auftrag fehlgeschlagen...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018847
    m_Localized: Habs vermasselt...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018848
    m_Localized: Aaaah!...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018849
    m_Localized: '* Tot *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018850
    m_Localized: Beep-beep
    m_Metadata:
      m_Items: []
  - m_Id: 2742018851
    m_Localized: Analysiere Umgebung...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018852
    m_Localized: Datei Fehler
    m_Metadata:
      m_Items: []
  - m_Id: 2742018853
    m_Localized: "N\xE4chste Anweisung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018854
    m_Localized: Technische Inspektion ist erforderlich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018855
    m_Localized: Achtung, Fehler erkannt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018856
    m_Localized: Lese Lizenzvereinbarung
    m_Metadata:
      m_Items: []
  - m_Id: 2742018857
    m_Localized: "\xD6lverlust - Fehler"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018858
    m_Localized: "Anweisung ausf\xFChren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018859
    m_Localized: Piep..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018860
    m_Localized: Fortfahren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018861
    m_Localized: Aufgabe beendet
    m_Metadata:
      m_Items: []
  - m_Id: 2742018862
    m_Localized: System update
    m_Metadata:
      m_Items: []
  - m_Id: 2742018863
    m_Localized: Wie gehts?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018864
    m_Localized: "Sch\xF6nen Tag"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018865
    m_Localized: Patrouille das Gebiet ab
    m_Metadata:
      m_Items: []
  - m_Id: 2742018866
    m_Localized: Bereich sichern
    m_Metadata:
      m_Items: []
  - m_Id: 2742018867
    m_Localized: Befehl eingeben
    m_Metadata:
      m_Items: []
  - m_Id: 2742018868
    m_Localized: "Paket\xFCberfluss"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018869
    m_Localized: Batterie aufladen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018870
    m_Localized: '* piep.. *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018871
    m_Localized: '* Lichter Aufleuchten *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018872
    m_Localized: '* summen *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018873
    m_Localized: "Bitte treten sie zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018874
    m_Localized: "Sch\xF6nes Wetter, nicht wahr?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018875
    m_Localized: "Es ist nichts pers\xF6nliches"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018876
    m_Localized: Ich bin programmiert sie zu vernichten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018877
    m_Localized: Bitte, senken sie ihre Waffe und ergeben sie sich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018878
    m_Localized: Entschuldigung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018879
    m_Localized: "Es tut mir leid, ich bin gezwungen das Feuer zu er\xF6ffnen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018880
    m_Localized: Das ist traurig
    m_Metadata:
      m_Items: []
  - m_Id: 2742018881
    m_Localized: Bitte, bleiben die stehen damit ich sie eliminieren kann
    m_Metadata:
      m_Items: []
  - m_Id: 2742018882
    m_Localized: Es tut mir Leid, ich bin gezwungen sie zu eliminieren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018883
    m_Localized: "Kapitulieren sie damit sie eliminiert werden k\xF6nnen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018884
    m_Localized: Ich bin autorisiert Gewalt anzuwenden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018885
    m_Localized: "Bleiben sie ruhig, wir werden uns um die k\xFCmmern"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018886
    m_Localized: "Ich f\xFCrchte, sie m\xFCssen eliminiert werden"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018887
    m_Localized: "Meine Anweisungen verlangen dass ich das Feuer er\xF6ffne"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018888
    m_Localized: Bitte laufen sie nicht weg!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018889
    m_Localized: Ich tute das nicht gern
    m_Metadata:
      m_Items: []
  - m_Id: 2742018890
    m_Localized: Was war das?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018891
    m_Localized: Eindringling?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018892
    m_Localized: "Verd\xE4chtiges Ger\xE4usch entdeckt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018893
    m_Localized: "Initialisiere Pr\xFCfvorgang"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018894
    m_Localized: Seien sie sich bewusst dass sie gefunden werden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018895
    m_Localized: Bitte, zeigen sie sich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018896
    m_Localized: Wo sind sie, sir?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018897
    m_Localized: Kommen sie herraus und zeigen sie mir ihre Hufe
    m_Metadata:
      m_Items: []
  - m_Id: 2742018898
    m_Localized: Bitte zeigen sie sich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018899
    m_Localized: Ich kann sie nicht sehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018900
    m_Localized: "Sie sind hier irgendwo, dass kann ich sp\xFCren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018901
    m_Localized: Leite Such prozedur ein
    m_Metadata:
      m_Items: []
  - m_Id: 2742018902
    m_Localized: Wo sind sie hingegangen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018903
    m_Localized: Bitte kommen sie herraus, damit ich sie eliminieren kann
    m_Metadata:
      m_Items: []
  - m_Id: 2742018904
    m_Localized: Sie wurden entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018905
    m_Localized: Verstecke dich nicht vor dem Sicherheitspersonal
    m_Metadata:
      m_Items: []
  - m_Id: 2742018906
    m_Localized: Vielen Dank. Kommen die bald wieder
    m_Metadata:
      m_Items: []
  - m_Id: 2742018907
    m_Localized: Warum laufen sie davon?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018908
    m_Localized: Suchprotokoll abgebrochen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018909
    m_Localized: Ich werde sie ein anderes mal ausschalten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018910
    m_Localized: "Bitte kommen sie zur\xFCck! Der Vorgeng ist noch nicht abgeschlossen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018911
    m_Localized: In Bereitschaft
    m_Metadata:
      m_Items: []
  - m_Id: 2742018912
    m_Localized: Niemand hier, bedauerlich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018913
    m_Localized: Sehr gut, wir werden und wiedersehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018914
    m_Localized: Schaden festgestellt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018915
    m_Localized: "Geh\xE4use besch\xE4digt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018916
    m_Localized: Kraftstoffverlust
    m_Metadata:
      m_Items: []
  - m_Id: 2742018917
    m_Localized: Feindliche Aktionen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018918
    m_Localized: Aber wieso?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018919
    m_Localized: "Gewalt ist keine L\xF6sung"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018920
    m_Localized: beep-beep-beep
    m_Metadata:
      m_Items: []
  - m_Id: 2742018921
    m_Localized: Systemabstur...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018922
    m_Localized: Garante ist abgel...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018923
    m_Localized: Laufzeitfehler in a...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018924
    m_Localized: Systemausfa...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018925
    m_Localized: Oh nei...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018926
    m_Localized: Was tun si...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018927
    m_Localized: Bitte, st...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018928
    m_Localized: System Herunterf...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018929
    m_Localized: Kritischer Feh...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018930
    m_Localized: Ich bin s...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018931
    m_Localized: Ihre Handeln ist nicht akzeptabel
    m_Metadata:
      m_Items: []
  - m_Id: 2742018932
    m_Localized: Bitte, lassen sie mich gehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018933
    m_Localized: Fehler, unangemessenes Verhalten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018934
    m_Localized: Magie erkannt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018935
    m_Localized: "Wir sch\xFCtzen und dienen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018936
    m_Localized: Bitte gehen Sie weiter
    m_Metadata:
      m_Items: []
  - m_Id: 2742018937
    m_Localized: Recht und Ordnung
    m_Metadata:
      m_Items: []
  - m_Id: 2742018938
    m_Localized: Patrouillen Modus
    m_Metadata:
      m_Items: []
  - m_Id: 2742018939
    m_Localized: Objekt gesichert
    m_Metadata:
      m_Items: []
  - m_Id: 2742018940
    m_Localized: "Anwendung milit\xE4rischer Gewalt genehmigt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018941
    m_Localized: Rechtswidrige Handlungen werden bestraft
    m_Metadata:
      m_Items: []
  - m_Id: 2742018942
    m_Localized: Antisoziales Verhalten ist inakzeptabel
    m_Metadata:
      m_Items: []
  - m_Id: 2742018943
    m_Localized: "Milit\xE4rangelegenheiten, nicht einmischen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018944
    m_Localized: Wir folgen dem Gesetz
    m_Metadata:
      m_Items: []
  - m_Id: 2742018945
    m_Localized: Diebstahl ist ein schweres Verbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018946
    m_Localized: Situation unter Kontrolle
    m_Metadata:
      m_Items: []
  - m_Id: 2742018947
    m_Localized: Keine ungesetzlichen Handlungen gemeldet
    m_Metadata:
      m_Items: []
  - m_Id: 2742018948
    m_Localized: Meldung der Sicherheitseinheit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018949
    m_Localized: Patrouillen parameter, sauber
    m_Metadata:
      m_Items: []
  - m_Id: 2742018950
    m_Localized: "Wir sch\xFCtzen das Gesetz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018951
    m_Localized: Alles ruhig
    m_Metadata:
      m_Items: []
  - m_Id: 2742018952
    m_Localized: Anwendung von Kriegsgesetzen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018953
    m_Localized: Alle Ponys wieder an ihre Arbeit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018954
    m_Localized: Weitergehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018955
    m_Localized: Hier gibt es nichts zu sehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018956
    m_Localized: Kein Zutritt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018957
    m_Localized: Sperrgebiet
    m_Metadata:
      m_Items: []
  - m_Id: 2742018958
    m_Localized: "Feuer er\xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018959
    m_Localized: Feind angreifen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018960
    m_Localized: "Neutralisierungsprotokoll f\xFCr unbefugte Personen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018961
    m_Localized: Alle Zivilisten, sofort evakuieren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018962
    m_Localized: "Keine Sorge, die Sicherheit wird in K\xFCrze wiederhergestellt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018963
    m_Localized: Widerstand wird als Verbrechen angesehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018964
    m_Localized: Es ist in ihrem Interesse
    m_Metadata:
      m_Items: []
  - m_Id: 2742018965
    m_Localized: Lassen sie ihre Waffen fallen und ergeben sie sich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018966
    m_Localized: Feuern wenn bereit
    m_Metadata:
      m_Items: []
  - m_Id: 2742018967
    m_Localized: Lassen sie ihre Waffe fallen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018968
    m_Localized: Nicht autorisierter Zutritt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018969
    m_Localized: Rechtswidrige Handlungen gemeldet
    m_Metadata:
      m_Items: []
  - m_Id: 2742018970
    m_Localized: Stehenbleiben!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018971
    m_Localized: Bedrohung ausschalten
    m_Metadata:
      m_Items: []
  - m_Id: 2742018972
    m_Localized: Feindliches Ziel entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018973
    m_Localized: Sie haben das Recht auf einen schnellen Tod
    m_Metadata:
      m_Items: []
  - m_Id: 2742018974
    m_Localized: Initialisiere Suchprotokoll
    m_Metadata:
      m_Items: []
  - m_Id: 2742018975
    m_Localized: Rechtswidrige Handlungen gemeldet
    m_Metadata:
      m_Items: []
  - m_Id: 2742018976
    m_Localized: Unbefugter Zutritt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018977
    m_Localized: Suche nach Feinden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018978
    m_Localized: Kommen sie herraus und identifizieren sie sich
    m_Metadata:
      m_Items: []
  - m_Id: 2742018979
    m_Localized: Suche nach Gesetzesbrechern
    m_Metadata:
      m_Items: []
  - m_Id: 2742018980
    m_Localized: Versuchen sie sich nicht zu verstecken
    m_Metadata:
      m_Items: []
  - m_Id: 2742018981
    m_Localized: Sich der Verhaftung zu widersetzen ist ein Verbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018982
    m_Localized: "\xDCbert\xE4ter geflohen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018983
    m_Localized: Feind entkommen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018984
    m_Localized: Suche abgeschlossen, keine Feinde entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018985
    m_Localized: Verfolgungsprotokoll abgeschlossen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018986
    m_Localized: Falscher Alarm
    m_Metadata:
      m_Items: []
  - m_Id: 2742018987
    m_Localized: Patrouillenprotokoll fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018988
    m_Localized: Anweisung abgebrochen
    m_Metadata:
      m_Items: []
  - m_Id: 2742018989
    m_Localized: Schaden erkannt
    m_Metadata:
      m_Items: []
  - m_Id: 2742018990
    m_Localized: "Normaler Systembetrieb kann nicht gew\xE4hrleistet werden"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018991
    m_Localized: Schwerer Schaden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018992
    m_Localized: Systemfehler
    m_Metadata:
      m_Items: []
  - m_Id: 2742018993
    m_Localized: Widerstand gegen die Verhaftung
    m_Metadata:
      m_Items: []
  - m_Id: 2742018994
    m_Localized: "Sch\xFCtzen unm\xF6g..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018995
    m_Localized: Alarm! Rufe sicherheitsd...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018996
    m_Localized: Fataler Systemfeh...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018997
    m_Localized: Alle Systeme heruntergefahren
    m_Metadata:
      m_Items: []
  - m_Id: 2742018998
    m_Localized: Sicherheit kann nicht her...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018999
    m_Localized: Fehler beim sichern vo...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019000
    m_Localized: Ihre Taten sind illegal
    m_Metadata:
      m_Items: []
  - m_Id: 2742019001
    m_Localized: Verbotene magische Anwendung
    m_Metadata:
      m_Items: []
  - m_Id: 2742019002
    m_Localized: Ordnungswidrigkeit
    m_Metadata:
      m_Items: []
  - m_Id: 2742019003
    m_Localized: Inakzeptables Verhalten
    m_Metadata:
      m_Items: []
  - m_Id: 2742019004
    m_Localized: "Ein weiterer ruhmreicher Tag f\xFCr die Equestria Armee!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019005
    m_Localized: Unsere Feinde werden fallen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019006
    m_Localized: Huzzah Patrioten!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019007
    m_Localized: "Schmerz ist nur eine Schw\xE4che des K\xF6rpers!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019008
    m_Localized: "Alles f\xFCr den Sieg!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019009
    m_Localized: Equestria hat Vorrang!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019010
    m_Localized: Niemand kann unseren Geist brechen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019011
    m_Localized: Unsere Feinde werden vor Verzweiflung weinen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019012
    m_Localized: "Ich w\xFCrde gemacht um zu k\xE4mpfen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019013
    m_Localized: "Die herrlichste Augabe ist - unser Zuhause zu besch\xFCtzen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019014
    m_Localized: "Schlie\xDFt euch der Equestria Armee an!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019015
    m_Localized: "Angst ist Schw\xE4che!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019016
    m_Localized: Hey ihr, Zivilisten!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019017
    m_Localized: Erstens - Zebras bekampfen, zweitens - ..., drittens - Profit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019018
    m_Localized: "Hey DU! Zehn Liegest\xFCtze!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019019
    m_Localized: "R\xFChren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019020
    m_Localized: So machen wir das in der Armee!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019021
    m_Localized: Danke General, ich bin Stolz ein Equestrianer zu sein!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019022
    m_Localized: "R\xE4cht unsere gefallenen Br\xFCder!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019023
    m_Localized: Equestrianer kapitulieren niemals!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019024
    m_Localized: Ein guter Tag zum sterben!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019025
    m_Localized: "Bereit f\xFCr dein Land zu sterben, Streifen-gesicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019026
    m_Localized: "Leite, erschie\xDFt den Bastard!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019027
    m_Localized: Triff die Equestria Armee!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019028
    m_Localized: "Heute f\xFChle ich mich gut!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019029
    m_Localized: "Es wird hei\xDF hier!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019030
    m_Localized: Friss Metall, Zebra!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019031
    m_Localized: Lasst sie bezahlen, Jungs!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019032
    m_Localized: "Wie m\xF6gt ihr eure \xC4pfel? Gestreift und entartet?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019033
    m_Localized: Lasst niemanden am Leben!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019034
    m_Localized: Ich werde dein Fell als Dekoration verwenden!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019035
    m_Localized: Alles klar, jetzt bin ich sauer!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019036
    m_Localized: Du wirst es bereuen gebohren worden zu sein, Schwachkopf!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019037
    m_Localized: Gestreifte Invasoren!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019038
    m_Localized: "Ich verpasse dir ein paar L\xF6cher!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019039
    m_Localized: "T\xF6tet alle, Die G\xF6ttinnen werden wissen wer wer ist"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019040
    m_Localized: "Glaubst du, ich h\xF6re dich nicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019041
    m_Localized: "Dort drau\xDFen ist jemand, fordere Unterst\xFCtzung an!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019042
    m_Localized: "Der Feind n\xE4hert sich. Bleibt wachsam!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019043
    m_Localized: Haltet eure Position jungs, ich werde nachsehen
    m_Metadata:
      m_Items: []
  - m_Id: 2742019044
    m_Localized: Komm herraus und identifiziere dich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019045
    m_Localized: Spielst du Spielchen mit uns du Flasche?!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019046
    m_Localized: Wir werden dich finden und auf Pinkie Pie Art befragen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019047
    m_Localized: Glaubst du du kannst dich vor mir verstecken?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019048
    m_Localized: Zwecklos, sich vor der Equestria Armee zu verstecken!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019049
    m_Localized: Typische feige Zebra Taktik
    m_Metadata:
      m_Items: []
  - m_Id: 2742019050
    m_Localized: Komm her, Zebra Abschaum!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019051
    m_Localized: Hast du Angst vor mir? Das solltest du!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019052
    m_Localized: Wir haben sie verloren Jungs!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019053
    m_Localized: "Der Spa\xDF ist vorbei"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019054
    m_Localized: "Das Schlachtfeld geh\xF6rt uns!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019055
    m_Localized: Diese Feiglinge sind abgehauen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019056
    m_Localized: Verfolgung einstellen. Alle wieder auf Position
    m_Metadata:
      m_Items: []
  - m_Id: 2742019057
    m_Localized: Um so besser!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019058
    m_Localized: Alarm abschalten!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019059
    m_Localized: Die verstecken sich, Bastarde!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019060
    m_Localized: Oh, wars das schon???
    m_Metadata:
      m_Items: []
  - m_Id: 2742019061
    m_Localized: Nur ein Kratzer
    m_Metadata:
      m_Items: []
  - m_Id: 2742019062
    m_Localized: "Ha, meine Gro\xDFmutter k\xE4mpft besser!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019063
    m_Localized: "Das habe ich kaum gesp\xFCrt!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019064
    m_Localized: Meine Panzerung wird halten!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019065
    m_Localized: Nennst du das einen Kampf?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019066
    m_Localized: Bring mich nicht zum lachen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019067
    m_Localized: Ist das alles was du kannst?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019068
    m_Localized: "Das macht mich nur noch w\xFCtender!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019069
    m_Localized: Oh, das wars also dann?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019070
    m_Localized: Ich sehe nur Dunkelheit...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019071
    m_Localized: Sagt meiner Mutter, ich habe getan was ich konnte...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019072
    m_Localized: Bitte sagt meiner Familie...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019073
    m_Localized: Das ist nicht das Ende...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019074
    m_Localized: Begrabt mich in Equestria...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019075
    m_Localized: Nein! Wir werden nicht verlieren...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019076
    m_Localized: Wir sehen uns in Tartarus...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019077
    m_Localized: "Du bist niedlich kleine, Magie ist nichts f\xFCr mich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019078
    m_Localized: "Ein erb\xE4rmlicher Versuch, Kreatur"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019079
    m_Localized: Du kannst mich nicht fangen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019080
    m_Localized: So, und was nun?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019081
    m_Localized: Wollen wir spielen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019082
    m_Localized: "Bringe mir etwas \xFCber Freundschaft bei!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019083
    m_Localized: "Wollen wir ein bisschen Spa\xDF haben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019084
    m_Localized: Letzten Endes...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019085
    m_Localized: Schau was ich kann!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019086
    m_Localized: "Sch\xF6n, Hallo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019087
    m_Localized: "\xDCberraschung!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019088
    m_Localized: Es ist Partyzeit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019089
    m_Localized: Yaaay!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019090
    m_Localized: Ui! Was haben wir denn hier?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019091
    m_Localized: "Haben wir G\xE4ste?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019092
    m_Localized: "Ich kann dich h\xF6reenn!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019093
    m_Localized: Warte! Ich flehe dich an!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019094
    m_Localized: Hallooo! wo bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019095
    m_Localized: Lauf nicht weg!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019096
    m_Localized: Willst du verstecken spielen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019097
    m_Localized: Wir haben gerade erst angefangen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019098
    m_Localized: Irgendwie finde ich dich schon
    m_Metadata:
      m_Items: []
  - m_Id: 2742019099
    m_Localized: "Dabei hatte es so viel spa\xDF gemacht..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019100
    m_Localized: Ist das wieder langweilig
    m_Metadata:
      m_Items: []
  - m_Id: 2742019101
    m_Localized: Und wieder ganz alleine
    m_Metadata:
      m_Items: []
  - m_Id: 2742019102
    m_Localized: Ist denn kein Pony hier...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019103
    m_Localized: Autsch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019104
    m_Localized: Das kitzelt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019105
    m_Localized: Autsch! Was zum?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019106
    m_Localized: "Warum so unh\xF6flich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019107
    m_Localized: "H\xF6r auf damit du Rabauke!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019108
    m_Localized: "Ich dachte wir w\xE4ren Freunde..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019109
    m_Localized: Ist in Ordnung, Ich habe eine extr...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019110
    m_Localized: Adieu!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019111
    m_Localized: Oh neeeiiinnn!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019112
    m_Localized: Ich kann dich doch nicht einfach verlassen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019113
    m_Localized: "Oh! Was f\xFCr ein harter Tag!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019114
    m_Localized: Oh wow!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019115
    m_Localized: Ich kann fliegen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019116
    m_Localized: Jeah! Wie toll!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019117
    m_Localized: "So viel Spa\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019118
    m_Localized: 'Waffenstatus: Bereit'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019119
    m_Localized: "Gefahrenstufe - Gr\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019120
    m_Localized: Bereich sauber
    m_Metadata:
      m_Items: []
  - m_Id: 2742019121
    m_Localized: 'Umgebungsstatus: Schlachtfeld'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019122
    m_Localized: Objekt gesichert
    m_Metadata:
      m_Items: []
  - m_Id: 2742019123
    m_Localized: 'Batteriestatus: Aufgeladen'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019124
    m_Localized: 'Systemstatus: Geplanter Wartung erforderlich'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019125
    m_Localized: "Betreten f\xFCr Zivilisten verboten"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019126
    m_Localized: "Aktuelles Protokoll: Sch\xFCtzen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019127
    m_Localized: 'Aktuelles Protokoll: Patrouille.'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019128
    m_Localized: Analysiere Umgebung... Keine Gegner gefunden
    m_Metadata:
      m_Items: []
  - m_Id: 2742019129
    m_Localized: System arbeitet in normalen Modus
    m_Metadata:
      m_Items: []
  - m_Id: 2742019130
    m_Localized: 'Autorisierung brutaler Gewalt: Positiv'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019131
    m_Localized: "Fahre mit n\xE4chster Anweisung fort"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019132
    m_Localized: Gefahrenstufe - Rot
    m_Metadata:
      m_Items: []
  - m_Id: 2742019133
    m_Localized: Neues Ziel erfasst
    m_Metadata:
      m_Items: []
  - m_Id: 2742019134
    m_Localized: "Festlegen des Ziels mit h\xF6chster Priorit\xE4t"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019135
    m_Localized: Alle Zivilisten, Bereich sofort Evakuieren
    m_Metadata:
      m_Items: []
  - m_Id: 2742019136
    m_Localized: Leite Zielterminierung ein
    m_Metadata:
      m_Items: []
  - m_Id: 2742019137
    m_Localized: Greife Feind an
    m_Metadata:
      m_Items: []
  - m_Id: 2742019138
    m_Localized: Alle Zivilisten, bleibt in sicherer Entfernung
    m_Metadata:
      m_Items: []
  - m_Id: 2742019139
    m_Localized: Alarm. Gegner entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742019140
    m_Localized: Alarm. Feind entdeckt
    m_Metadata:
      m_Items: []
  - m_Id: 2742019141
    m_Localized: Leite Feind-Vernichtungs Prozedue ein
    m_Metadata:
      m_Items: []
  - m_Id: 2742019142
    m_Localized: "Ziel erfasst. Er\xF6ffne Feuer"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019143
    m_Localized: "Schie\xDFen und T\xF6ten Protokolle aktiviert"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019144
    m_Localized: "Die Sicherheit der Zivilbev\xF6lkerung kann nicht garantiert werden"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019145
    m_Localized: Verteidigungssysteme aktiviert
    m_Metadata:
      m_Items: []
  - m_Id: 2742019146
    m_Localized: "Ziel identifiziert. Aktion: Zerst\xF6ren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019147
    m_Localized: Programm zur beseitigung von Gefahren aktiv
    m_Metadata:
      m_Items: []
  - m_Id: 2742019148
    m_Localized: Alle Waffen bereit
    m_Metadata:
      m_Items: []
  - m_Id: 2742019149
    m_Localized: 'Achtung: Feuere auf Sicht'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019150
    m_Localized: "\xDCberwachungsprotokoll wird eingeleitet"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019151
    m_Localized: Alle Systeme, bereit zum Kampf
    m_Metadata:
      m_Items: []
  - m_Id: 2742019152
    m_Localized: "Suche Ziel mit h\xF6chster Priorit\xE4t"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019153
    m_Localized: Gefahrenstufe - Gelb
    m_Metadata:
      m_Items: []
  - m_Id: 2742019154
    m_Localized: Bereich absuchen
    m_Metadata:
      m_Items: []
  - m_Id: 2742019155
    m_Localized: "Ziel verloren. Hauptziel - Suchen und Zerst\xF6ren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019156
    m_Localized: "Ziel wurde nicht zerst\xF6rt. Leite Suchprotokoll ein"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019157
    m_Localized: "Gefahrenstufe - Gr\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019158
    m_Localized: Keine Bedrohungen gefunden
    m_Metadata:
      m_Items: []
  - m_Id: 2742019159
    m_Localized: Suche abgeschlossen. Keine Feinde gefunden
    m_Metadata:
      m_Items: []
  - m_Id: 2742019160
    m_Localized: Programmablauf zur Patrouille fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 2742019161
    m_Localized: Reinitialisiere Patrouille
    m_Metadata:
      m_Items: []
  - m_Id: 2742019162
    m_Localized: "Panzerung besch\xE4digt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019163
    m_Localized: "Systemkern besch\xE4digt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019164
    m_Localized: "Normale Funktionsweise weiterhin m\xF6glich"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019165
    m_Localized: "H\xFCllenintegit\xE4t beeintr\xE4chtigt"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019166
    m_Localized: Schalte um auf Reservesystem
    m_Metadata:
      m_Items: []
  - m_Id: 2742019167
    m_Localized: Hauptsystem unterbrochen, fu...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019168
    m_Localized: Fataler Systemfeh...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019169
    m_Localized: Kritischer Schad...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019170
    m_Localized: Programmabstur...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019171
    m_Localized: "Rufe nach verst\xE4..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019172
    m_Localized: Wir nehmen Bares oder auf Kredit!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019173
    m_Localized: Sag was du brauchst, wir haben es bestimmt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019174
    m_Localized: "T\xE4glich niedrige Preise!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019175
    m_Localized: Waffen, Sprengstoffe, Munition...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019176
    m_Localized: Brauchst du Munition, Partner?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019177
    m_Localized: Hier bekommst du alles was du brauchst!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019178
    m_Localized: Hey, hier her, Partner!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019179
    m_Localized: "Das ehrlichste Gesch\xE4ft im \xD6dland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019180
    m_Localized: "F\xF6rdert den Handel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019181
    m_Localized: "Die Beste Ware im \xD6dland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019182
    m_Localized: Lebenslange Garantie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019183
    m_Localized: Gib dein Geld klug aus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019184
    m_Localized: Ich verkaufe gutes Zeug!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019185
    m_Localized: "Rabatte f\xFCr Veteranen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019186
    m_Localized: Dank dir, komm bald wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019187
    m_Localized: "Es war mir ein Vergn\xFCgen, Gesch\xE4fte mit dir zu machen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019188
    m_Localized: Wenn du mich brauchst, findest du mich hier
    m_Metadata:
      m_Items: []
  - m_Id: 2742019189
    m_Localized: Komm wieder wenn du noch ein Paar Kronkorken hast
    m_Metadata:
      m_Items: []
  - m_Id: 2742019190
    m_Localized: Hey, nicht anfassen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019191
    m_Localized: Wo tut es weh?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019192
    m_Localized: Brauchst du etwas um dich wieder auf Trab zu bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019193
    m_Localized: "Heiltr\xE4nke..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019194
    m_Localized: Ich werde dir schon wieder auf die Hufe helfen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019195
    m_Localized: Ist ein Pony hier verletzt?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019196
    m_Localized: Brauchst du einen Arzt?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019197
    m_Localized: Erstklassige magische Heilung!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019198
    m_Localized: "F\xFChlst du dich schlecht?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019199
    m_Localized: Wir behandeln Krankheiten, Wunden, Verletzungen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019200
    m_Localized: Absolut schmerzfreie Behandlungen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019201
    m_Localized: "Wenn du stirbst, bekommst du dein Geld zur\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019202
    m_Localized: "Die beste medizinische Versorgung im \xD6dland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019203
    m_Localized: Wo habe ich nur mein Skalpell hingetan?..
    m_Metadata:
      m_Items: []
  - m_Id: 2742019204
    m_Localized: Kostenlose Tollwutspritzen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019205
    m_Localized: "Jeden Tag ein Apfel... w\xE4re was feines *seufzen*"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019206
    m_Localized: Hot euch einen Rabatt auf Bluttransfusionen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019207
    m_Localized: Behandlung von Geschlechtskrankheiten zum halben Preis!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019208
    m_Localized: "F\xFChlst du dich besser?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019209
    m_Localized: "Alles fertig! Bis zum n\xE4chsten Mal!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019210
    m_Localized: "Sei beim n\xE4chsten Mal vorsichtiger, in Ordnung?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019211
    m_Localized: Bleib gesund!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019212
    m_Localized: Hier, und da, das wird schon wieder
    m_Metadata:
      m_Items: []
  - m_Id: 2742019213
    m_Localized: Mach dir keine Sorgen, das wird wieder nachwachsen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019214
    m_Localized: Vergiss nicht deine Medizin zu nehmen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019215
    m_Localized: Hilfe...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019216
    m_Localized: Hilf mir!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019217
    m_Localized: Lass mich raus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019218
    m_Localized: Bitte, Hilfe...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019219
    m_Localized: Irgendein Pony...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019220
    m_Localized: Bitte, Wasser...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019221
    m_Localized: Was haben die mit mir vor?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019222
    m_Localized: Wasser......
    m_Metadata:
      m_Items: []
  - m_Id: 2742019223
    m_Localized: Ich brauche Hilfe...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019224
    m_Localized: Danke!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019225
    m_Localized: Vielen Dank!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019226
    m_Localized: Du hast mich gerettet!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019227
    m_Localized: "Die G\xF6ttin soll dich segnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019228
    m_Localized: Ich bin endlich da raus!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019229
    m_Localized: Ich bin frei!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019230
    m_Localized: Lass uns von hier verschwinden!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019231
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019232
    m_Localized: Wie gehts?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019233
    m_Localized: Nah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019234
    m_Localized: "Jeah, zu bl\xF6d..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019235
    m_Localized: Diese Ponys reden zu viel...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019236
    m_Localized: Was gibts neues?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019237
    m_Localized: Du bist nicht von hier, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019238
    m_Localized: Was denkst du gerade?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019239
    m_Localized: Irgend ein Pony brauch immer Hilfe...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019240
    m_Localized: Das geht mich nichts an...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019241
    m_Localized: Das ist dein Problem, nicht meins
    m_Metadata:
      m_Items: []
  - m_Id: 2742019242
    m_Localized: "Wir m\xFCssen von vorne beginnen..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019243
    m_Localized: "Was erz\xE4hlt man sich so?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019244
    m_Localized: Und was jetzt?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019245
    m_Localized: "Ich bin all dessen so m\xFCde..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019246
    m_Localized: Wie immer...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019247
    m_Localized: Seufz...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019248
    m_Localized: Sie konnte auf sich aufpassen...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019249
    m_Localized: Sie tun es schon wieder...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019250
    m_Localized: Das geht ihn eindeutig nichts an...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019251
    m_Localized: Wieso ich?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019252
    m_Localized: Zeit sich an die Arbeit zu machen
    m_Metadata:
      m_Items: []
  - m_Id: 2742019253
    m_Localized: Diese Wand muss gemalert werden...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019254
    m_Localized: Wo ist mein Schraubenzieher?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019255
    m_Localized: Ich glaube es nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019256
    m_Localized: Manno...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019257
    m_Localized: Schon wieder?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019258
    m_Localized: Wann beginnt deine Schicht??
    m_Metadata:
      m_Items: []
  - m_Id: 2742019259
    m_Localized: "Ist das Mittagessen heute p\xFCnktlich?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019260
    m_Localized: Ich habe es satt...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019261
    m_Localized: "Dieser Ort ist ein von der g\xF6ttin verlassenes Loch..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019262
    m_Localized: Die Kabel funken...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019263
    m_Localized: Ein neuer verdammter Tag...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019264
    m_Localized: Beschissenes Leben...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019265
    m_Localized: Celestia zuliebe...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019266
    m_Localized: Was nun?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019267
    m_Localized: Alles so langweilig...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019268
    m_Localized: Im selben Alter...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019269
    m_Localized: Nun, ja...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019270
    m_Localized: Was hast du erwartet?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019271
    m_Localized: Jetzt machen die es schon wieder...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019272
    m_Localized: Es stinkt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019273
    m_Localized: Wieso mich?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019274
    m_Localized: Da tropft etwas auf meinen Kopf
    m_Metadata:
      m_Items: []
  - m_Id: 2742019275
    m_Localized: "Gut dass du hier bist und nicht drau\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019276
    m_Localized: Das Experiment war erfolgreich
    m_Metadata:
      m_Items: []
  - m_Id: 2742019277
    m_Localized: Hier ist schon wieder Schimmel
    m_Metadata:
      m_Items: []
  - m_Id: 2742019278
    m_Localized: Wo ist dieses beschissene teil hin?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019279
    m_Localized: Ich hasse sauber machen
    m_Metadata:
      m_Items: []
  - m_Id: 2742019280
    m_Localized: Mein PipBuck spinnt
    m_Metadata:
      m_Items: []
  - m_Id: 2742019281
    m_Localized: Oh yeah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019282
    m_Localized: "Ich f\xFChle mich nicht gut"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019283
    m_Localized: Oh, @lp, lange nicht gesehen!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019284
    m_Localized: Es ist lange her, @lp!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019285
    m_Localized: '@lp, ich habe dich schon eine Weile nicht mehr gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019286
    m_Localized: Bist du, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019287
    m_Localized: "Hi @lp, bist du zur\xFCck?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019288
    m_Localized: "Du bist zur\xFCck, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019289
    m_Localized: Wie ist es dort oben so?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019290
    m_Localized: "Ist es wahr, dass drau\xDFen nur Monster und Strahlung gibt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019291
    m_Localized: Hast du ein paar Monster gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019292
    m_Localized: Oh... @lp ist wieder da...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019293
    m_Localized: Wow!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019294
    m_Localized: Sieh dich nur an!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019295
    m_Localized: Wann hast du das letzte mal geduscht?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019296
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019297
    m_Localized: Hallo, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019298
    m_Localized: Wie geht es dir, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019299
    m_Localized: "Wann wirst du deine Schulden zur\xFCckzahlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019300
    m_Localized: PipBuck schon wieder kaputt. Kannst du ihn reparieren?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019301
    m_Localized: Oh-wei!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019302
    m_Localized: "L\xE4uft jedes Pony drau\xDFen so herum wie du?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019303
    m_Localized: Brauchst du deine Sachen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019304
    m_Localized: "Ich dachte du w\xFCrdest niemals zur\xFCckkehren"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019305
    m_Localized: "Wenn das nicht die gro\xDFe \"Chosen-25\" h\xF6chstselbst ist..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019306
    m_Localized: "Hast du etwas \xFCber Velvet herausgefunden?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019307
    m_Localized: "Du bist schon wieder zur\xFCck?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019308
    m_Localized: Wollen wir eine Party veranstalten?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019309
    m_Localized: Komm her, trinken wir etwas Mondschein!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019310
    m_Localized: Hey, hier ist besetzt!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019311
    m_Localized: Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019312
    m_Localized: Was ist los?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019313
    m_Localized: Wollen wir etwas spielen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019314
    m_Localized: Piu-piu
    m_Metadata:
      m_Items: []
  - m_Id: 2742019315
    m_Localized: Du wirst bald sterben...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019316
    m_Localized: Oh, das ist so toll!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019317
    m_Localized: Erstaunlich!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019318
    m_Localized: "Hey, das geh\xF6rt mir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019319
    m_Localized: Meins ist besser!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019320
    m_Localized: Piu! Buumm
    m_Metadata:
      m_Items: []
  - m_Id: 2742019321
    m_Localized: La-la-la
    m_Metadata:
      m_Items: []
  - m_Id: 2742019322
    m_Localized: Wollen wir verstecken spielen?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019323
    m_Localized: "Was f\xFCr ein dummie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019324
    m_Localized: Nuh-huh
    m_Metadata:
      m_Items: []
  - m_Id: 2742019325
    m_Localized: "Bleib zur\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019326
    m_Localized: Na-na-na
    m_Metadata:
      m_Items: []
  - m_Id: 2742019327
    m_Localized: Kann ich ein paar Kronkorken haben?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019328
    m_Localized: Manno!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019329
    m_Localized: Hey, schau mal hier!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019330
    m_Localized: Ich mache nichts!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019331
    m_Localized: Es war schon kaputt als ich es gefunden habe!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019332
