  - m_Id: 2729435941
    m_Localized: "Sauerstoffs\xE4ttigung"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435942
    m_Localized: Du ringst um Luft!
    m_Metadata:
      m_Items: []
  - m_Id: 2729435943
