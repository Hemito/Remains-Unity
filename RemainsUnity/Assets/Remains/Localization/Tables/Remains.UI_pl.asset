  - m_Id: 1501148733440
    m_Localized: "\n\nOchrona po za\u0142o\u017Ceniu \xB7 podstawowy poziom\n"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051107
  - m_Id: 1501148733441
    m_Localized: "podatno\u015B\u0107 {0:0.#}%"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051108
  - m_Id: 1501148733442
    m_Localized: "Poch\u0142anianie obra\u017Ce\u0144 fizycznych: {0:0.##}\nPoch\u0142anianie
      obra\u017Ce\u0144 energetycznych: {1:0.##}\n"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051109
  - m_Id: 1501148733443
    m_Localized: "Szansa poch\u0142oni\u0119cia: {0:0.#}%\n"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051110
  - m_Id: 3325251543040
    m_Localized: "Nie uda\u0142o si\u0119 ponownie uruchomi\u0107 d\u017Awi\u0119ku. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051111
  - m_Id: 3325348012032
    m_Localized: "Urz\u0105dzenie audio odrzuci\u0142o zmian\u0119 bufora DSP."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051112
  - m_Id: 3325348012033
    m_Localized: " Zachowano poprzedni\u0105 konfiguracj\u0119."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051113
  - m_Id: 3325352206336
    m_Localized: "Nie uda\u0142o si\u0119 wznowi\u0107 zap\u0119tlonego d\u017Awi\u0119ku. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051114
  - m_Id: 3325352206337
    m_Localized: "Nie uda\u0142o si\u0119 przywr\xF3ci\u0107 poprzedniej konfiguracji
      d\u017Awi\u0119ku. Sprawd\u017A urz\u0105dzenie lub uruchom gr\u0119 ponownie."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051115
  - m_Id: 3325352206338
    m_Localized: "Rozmiar bufora DSP musi wynosi\u0107 256, 512 lub 1024 pr\xF3bki."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051116
  - m_Id: 3325352206339
    m_Localized: "Urz\u0105dzenie audio nie zastosowa\u0142o wybranego bufora bez
      zmiany innych ustawie\u0144."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051117
  - m_Id: 3325352206340
    m_Localized: "Nie uda\u0142o si\u0119 odczyta\u0107 konfiguracji urz\u0105dzenia
      audio. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051118
  - m_Id: 3325352206341
    m_Localized: "Nie uda\u0142o si\u0119 przywr\xF3ci\u0107 konfiguracji d\u017Awi\u0119ku. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051119
  - m_Id: 3325352206342
    m_Localized: "Nie uda\u0142o si\u0119 zapisa\u0107 ustawie\u0144 d\u017Awi\u0119ku. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051120
  - m_Id: 3325352206343
    m_Localized: " Przywr\xF3cono poprzedni bufor DSP."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051121
  - m_Id: 3325352206344
    m_Localized: " Nie uda\u0142o si\u0119 przywr\xF3ci\u0107 poprzedniego bufora
      DSP; sprawd\u017A urz\u0105dzenie lub uruchom gr\u0119 ponownie."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051122
  - m_Id: 1501148733444
    m_Localized: "Nie uda\u0142o si\u0119 zapisa\u0107 ustawie\u0144. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051123
  - m_Id: 1501148733445
    m_Localized: "Bufor DSP: {0} pr\xF3bek \xB7 256 \u2014 mniejsze op\xF3\u017Anienie,
      1024 \u2014 wi\u0119ksza stabilno\u015B\u0107"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051124
  - m_Id: 1501148733446
    m_Localized: "Zmiany g\u0142o\u015Bno\u015Bci s\u0142ycha\u0107 od razu. \u201EZapisz\u201D
      stosuje bufor DSP z kr\xF3tkim restartem d\u017Awi\u0119ku. Tylko na tym komputerze."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051125
  - m_Id: 3325352206345
    m_Localized: "Obecna regu\u0142a telekinezy nie obs\u0142uguje przenoszenia postaci."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051126
  - m_Id: 1501148733447
    m_Localized: "Posta\u0107 \u201E{0}\u201D: zmieni\u0142a si\u0119 wersja gry
      lub zestaw mod\xF3w."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051127
  - m_Id: 1501148733449
    m_Localized: Oczy
    m_Metadata:
      m_Items:
      - rid: 4666841079933051128
  - m_Id: 1501148733450
    m_Localized: "Tworzenie postaci\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051129
  - m_Id: 1501148733452
    m_Localized: "Nie uda\u0142o si\u0119 utworzy\u0107 postaci: "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051130
  - m_Id: 1501148733453
    m_Localized: "Kolor: sze\u015B\u0107 cyfr szesnastkowych RGB, np. 2382BA."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051131
  - m_Id: 1501148733455
    m_Localized: "Kszta\u0142t g\u0142owy\n"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051132
  - m_Id: 1501148733457
    m_Localized: Fryzura {0} / {1}
    m_Metadata:
      m_Items:
      - rid: 4666841079933051133
  - m_Id: 1501148733458
    m_Localized: Oczy {0} / {1}
    m_Metadata:
      m_Items:
      - rid: 4666841079933051134
  - m_Id: 1501148733459
    m_Localized: "Utw\xF3rz pierwsz\u0105 posta\u0107."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051135
  - m_Id: 1501148733460
    m_Localized: "Wybierz posta\u0107 do w\u0142asnej gry lub do\u0142\u0105czenia
      do znajomego."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051136
  - m_Id: 1501148733461
    m_Localized: Na pewno?
    m_Metadata:
      m_Items:
      - rid: 4666841079933051137
  - m_Id: 1501148733462
    m_Localized: "Usuwanie postaci\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051138
  - m_Id: 1501148733463
    m_Localized: "Nie uda\u0142o si\u0119 usun\u0105\u0107 postaci: "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051139
  - m_Id: 1501148733464
    m_Localized: "Nie uda\u0142o si\u0119 odczyta\u0107 postaci: "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051140
  - m_Id: 1501148733465
    m_Localized: '{0}: {1} godz. {2:00} min'
    m_Metadata:
      m_Items:
      - rid: 4666841079933051141
  - m_Id: 1501148733466
    m_Localized: W grze
    m_Metadata:
      m_Items:
      - rid: 4666841079933051142
  - m_Id: 1501148733467
    m_Localized: "B\u0142\u0105d profilu \xB7 dziennik gry"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051143
  - m_Id: 1501148733468
    m_Localized: "Odczytywanie postaci\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051144
  - m_Id: 1501148733469
    m_Localized: "Czas nie zosta\u0142 jeszcze zapisany"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051145
  - m_Id: 1501148733470
    m_Localized: "Usun\u0105\u0107 posta\u0107 \u201E{0}\u201D? Kopia pozostanie
      w folderze DeletedCharacters; \u015Bwiaty nie zmieni\u0105 si\u0119."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051146
  - m_Id: 1501148733471
    m_Localized: Zarejestrowano
    m_Metadata:
      m_Items:
      - rid: 4666841079933051147
  - m_Id: 1501148733472
    m_Localized: "Usu\u0144"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051148
  - m_Id: 1501148733473
    m_Localized: "Uszkodzone profile s\u0105 niedost\u0119pne. Szczeg\xF3\u0142y
      w dzienniku gry."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051149
  - m_Id: 3325360594944
    m_Localized: Wylot lufy jest zablokowany.
    m_Metadata:
      m_Items:
      - rid: 4666841079933051150
  - m_Id: 1501148733474
    m_Localized: "Nieprzytomny \xB7 potrzebna pomoc"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051151
  - m_Id: 1501148733475
    m_Localized: "{0} \xB7 Granaty: {1}"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051152
  - m_Id: 1501148733476
    m_Localized: Mana  {0:0} / 100
    m_Metadata:
      m_Items:
      - rid: 4666841079933051153
  - m_Id: 1501148733477
    m_Localized: '{0}/{1}  rad {2}'
    m_Metadata:
      m_Items:
      - rid: 4666841079933051154
  - m_Id: 1501148733478
    m_Localized: "\nPierwotna kopia zostanie zachowana; mody nie s\u0105 instalowane
      ani porz\u0105dkowane automatycznie."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051155
  - m_Id: 1501148733479
    m_Localized: SZYBKIE SLOTY
    m_Metadata:
      m_Items:
      - rid: 4666841079933051156
  - m_Id: 1501148733480
    m_Localized: "DZIA\u0141ANIA"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051157
  - m_Id: 1501148733481
    m_Localized: "Naci\u015Bnij klawisz dla \u201E{0}\u201D. Esc anuluje."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051158
  - m_Id: 1501148733482
    m_Localized: "Nie uda\u0142o si\u0119 zapisa\u0107 ustawie\u0144. "
    m_Metadata:
      m_Items:
      - rid: 4666841079933051159
  - m_Id: 1501148733483
    m_Localized: ' Wybierz inny klawisz.'
    m_Metadata:
      m_Items:
      - rid: 4666841079933051160
  - m_Id: 1501148733484
    m_Localized: "Naci\u015Bnij nowy klawisz menu. Esc mo\u017Cna przypisa\u0107
      ponownie."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051161
  - m_Id: 1501148733487
    m_Localized: "Przywr\xF3cono domy\u015Blne klawisze. Naci\u015Bnij \u201EZapisz\u201D,
      aby zastosowa\u0107."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051162
  - m_Id: 1501148733489
    m_Localized: "Zmieniono przypisanie. Naci\u015Bnij \u201EZapisz\u201D, aby zastosowa\u0107."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051163
  - m_Id: 1501148733491
    m_Localized: "Naci\u015Bnij\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051164
  - m_Id: 1501148733493
    m_Localized: "Pokazano {0} z {1} \xB7 LPM \u2014 1 \xB7 Shift+LPM \u2014 {2}"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051165
  - m_Id: 1501148733494
    m_Localized: "Pojemnik nie jest ju\u017C dost\u0119pny."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051166
  - m_Id: 1501148733495
    m_Localized: "Potwierdzanie podniesienia\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051167
  - m_Id: 1501148733496
    m_Localized: "Lu\u017Any przedmiot podnosi si\u0119 w ca\u0142o\u015Bci akcj\u0105
      interakcji."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051168
  - m_Id: 3325360594945
    m_Localized: Nie potwierdzono chwycenia granatu.
    m_Metadata:
      m_Items:
      - rid: 4666841079933051169
  - m_Id: 1501148733497
    m_Localized: "{0} \xB7 Pojemnik \xB7 Przymocowany"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051170
  - m_Id: 1501148733498
    m_Localized: "{0} \xB7 Podnie\u015B przedmiot"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051171
  - m_Id: 1501148733499
    m_Localized: "Naprawa przycisku jest na razie niedost\u0119pna"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051172
  - m_Id: 1501152927744
    m_Localized: "{0} (przytrzymaj) \xB7 Naprawa: {1:P0}"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051173
  - m_Id: 1501152927745
    m_Localized: "{0} \xB7 Rozbr\xF3j min\u0119"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051174
  - m_Id: 1501152927746
    m_Localized: "Przytrzymaj {0} \xB7 Podnie\u015B sojusznika"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051175
  - m_Id: 1501152927747
    m_Localized: "{0} (przytrzymaj) \xB7 Napraw przycisk"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051176
  - m_Id: 1501152927748
    m_Localized: "{0} \xB7 Przeszukaj cia\u0142o"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051177
  - m_Id: 1501152927749
    m_Localized: "Potwierdzanie interakcji\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051178
  - m_Id: 1501152927750
    m_Localized: Zamknij drzwi
    m_Metadata:
      m_Items:
      - rid: 4666841079933051179
  - m_Id: 1501152927751
    m_Localized: "Potwierdzanie rozbrojenia\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051180
  - m_Id: 1501152927752
    m_Localized: "Otw\xF3rz drzwi"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051181
  - m_Id: 1501152927753
    m_Localized: "{0} \xB7 Pojemnik \xB7 {1:0.#} kg"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051182
  - m_Id: 1501152927754
    m_Localized: "Potwierdzanie podniesienia wybranego przedmiotu\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051183
  - m_Id: 1501152927755
    m_Localized: "Potwierdzanie dzia\u0142ania\u2026"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051184
  - m_Id: 1501152927756
    m_Localized: "{0} \xB7 Uruchom platform\u0119"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051185
  - m_Id: 3325364789248
    m_Localized: "Za\u0142\xF3\u017C"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051186
  - m_Id: 3325364789249
    m_Localized: "Szybki klawisz nie jest przypisany lub przedmiot si\u0119 sko\u0144czy\u0142."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051187
  - m_Id: 3325364789251
    m_Localized: "Ekwipunek przedmiot\xF3w nie jest jeszcze gotowy."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051188
  - m_Id: 3325364789252
    m_Localized: "Brak napromieniowania \u2014 lek nie jest potrzebny."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051189
  - m_Id: 3325364789253
    m_Localized: "To nie jest zwyk\u0142y przedmiot do trzymania."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051190
  - m_Id: 3325364789254
    m_Localized: "Schowaj bro\u0144"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051191
  - m_Id: 3325364789255
    m_Localized: "Posta\u0107 nie jest po\u0142\u0105czona."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051192
  - m_Id: 3325364789256
    m_Localized: "Trzymany przedmiot si\u0119 sko\u0144czy\u0142. Wybierz inny."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051193
  - m_Id: 3325364789257
    m_Localized: "B\u0142\u0105d dzia\u0142ania przedmiotu. Szczeg\xF3\u0142y w dzienniku."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051194
  - m_Id: 3325364789259
    m_Localized: "Przedmiot si\u0119 sko\u0144czy\u0142 lub jest zarezerwowany."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051195
  - m_Id: 3325364789260
    m_Localized: "Tego przedmiotu nie mo\u017Cna wyposa\u017Cy\u0107."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051196
  - m_Id: 3325364789262
    m_Localized: "Nie mo\u017Cna u\u017Cywa\u0107 przedmiot\xF3w, b\u0119d\u0105c
      nieprzytomnym."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051197
  - m_Id: 3325364789263
    m_Localized: "Obszar jest wstrzymany. Dzia\u0142ania s\u0105 chwilowo niedost\u0119pne."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051198
  - m_Id: 3325364789264
    m_Localized: Przedmiot zarezerwowano do przekazania.
    m_Metadata:
      m_Items:
      - rid: 4666841079933051199
  - m_Id: 3325368983552
    m_Localized: "Przej\u015Bcie do innego obszaru jeszcze si\u0119 nie zako\u0144czy\u0142o."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051200
  - m_Id: 3325368983553
    m_Localized: "Wygl\u0105d tego przedmiotu nie jest pod\u0142\u0105czony."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051201
  - m_Id: 3325368983555
    m_Localized: Zdejmij
    m_Metadata:
      m_Items:
      - rid: 4666841079933051202
  - m_Id: 3325368983556
    m_Localized: "Przedmiot si\u0119 sko\u0144czy\u0142 lub go nie ma."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051203
  - m_Id: 3325368983557
    m_Localized: "Dzia\u0142anie przedmiotu nie jest pod\u0142\u0105czone. Szczeg\xF3\u0142y
      w dzienniku."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051204
  - m_Id: 3325368983558
    m_Localized: Lewy Alt
    m_Metadata:
      m_Items:
      - rid: 4666841079933051205
  - m_Id: 3325368983559
    m_Localized: "W g\xF3r\u0119 / wsta\u0144"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051206
  - m_Id: 3325368983561
    m_Localized: "Rzu\u0107 granat"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051207
  - m_Id: 3325368983565
    m_Localized: Prawy Shift
    m_Metadata:
      m_Items:
      - rid: 4666841079933051208
  - m_Id: 3325368983567
    m_Localized: "W d\xF3\u0142 / kucnij"
    m_Metadata:
      m_Items:
      - rid: 4666841079933051209
  - m_Id: 3325368983568
    m_Localized: "Nie mo\u017Cna przypisa\u0107 tego klawisza."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051210
  - m_Id: 3325368983569
    m_Localized: Prawy Ctrl
    m_Metadata:
      m_Items:
      - rid: 4666841079933051211
  - m_Id: 3325368983571
    m_Localized: "Plik sterowania jest uszkodzony lub niedost\u0119pny. Wczytano
      domy\u015Blne klawisze."
    m_Metadata:
      m_Items:
      - rid: 4666841079933051212
  - m_Id: 3325368983573
    m_Localized: "Klawisz {0} jest ju\u017C przypisany do czynno\u015Bci \u201E{1}\u201D."
