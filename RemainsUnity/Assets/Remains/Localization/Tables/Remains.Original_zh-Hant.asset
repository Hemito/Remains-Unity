    m_Localized: "\u8A72\u786C\u789F\u5305\u542B\u8A2D\u8A08\u85CD\u5716\uFF0C\u914D\u7DDA\u5716\u548C\u5176\u4ED6\u6709\u52A9\u65BC\u4E86\u89E3\u6A5F\u5668\u5C0F\u99AC\u5982\u4F55\u5DE5\u4F5C\u7684\u8A0A\u606F.
