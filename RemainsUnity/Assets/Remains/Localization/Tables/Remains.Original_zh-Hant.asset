  - m_Id: 2737824259
    m_Localized: "\u59B3\u5728\u8AAA\u4EC0\u9EBC\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824260
    m_Localized: "\u6211\u662F\u8AAA\u7576\u907F\u96E3\u5EC4 Pi \u6700\u7D42\u5411\u5EE2\u571F\u958B\u653E\u7684\u6642\u5019\uFF0C\u5EE2\u571F\u7684\u5C45\u6C11\u53EF\u4EE5\u6307\u671B\u59B3."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824261
    m_Localized: "\u9664\u975E\u5B83\u5F88\u5FEB\u5C31\u6703\u88AB\u6575\u4EBA\u9055\u80CC\u6211\u5011\u7684\u610F\u9858\u628A\u5B83\u6253\u958B.
      \u7B2C\u4E00\u6B21\u4E5F\u662F\u6700\u5F8C\u4E00\u6B21."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824262
    m_Localized: "\u6211\u5011\u4ECD\u7136\u6709\u6A5F\u6703\u4EE5\u66F4\u597D\u7684\u65B9\u5F0F\u89E3\u51B3\u5C40\u52E2."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824263
    m_Localized: "\u7576\u59B3\u5075\u5BDF\u82F1\u514B\u96F7\u57FA\u5730\u6642\uFF0C\u6211\u6703\u53BB\u795E\u79D8\u6751\u838A\u5E6B\u52A9\u6591\u99AC\u5011\u7684\u6E96\u5099\u5DE5\u4F5C.
      \u800C\u5B88\u671B\u8005\u5C07\u76E1\u6700\u5927\u52AA\u529B\u5206\u6790\u8A72\u5340\u57DF\u7684\u73FE\u6642\u72C0\u6CC1.
      \u6211\u5011\u5FC5\u9808\u70BA\u4EFB\u4F55\u767C\u5C55\u505A\u597D\u6E96\u5099."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824264
    m_Localized: "\u8207\u5B88\u671B\u8005\u7684\u5C0D\u8A71"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824265
    m_Localized: "\u5B88\u671B\u8005\uFF0C\u662F\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824266
    m_Localized: "\u662F\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824267
    m_Localized: "\u6211\u9084\u4E0D\u592A\u660E\u767D... \u4F60\u70BA\u4EC0\u9EBC\u8981\u5E6B\u52A9\u907F\u96E3\u5EC4
      Pi\uFF1F \u4F60\u4E0D\u662F\u6211\u5011\u4E2D\u7684\u4E00\u54E1\uFF0C\u4E0D\u662F\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824268
    m_Localized: "\u4E0D\uFF0C\u800C\u4E14\u6211\u5F9E\u4F86\u6C92\u6709\u53BB\u904E\u90A3\u88E1.\n\u6BD4\u65B9\u8AAA\uFF0C\u6211\u4E00\u76F4\u5728\u95DC\u6CE8\u59B3\u8A66\u5716\u627E\u5230\u9019\u4E9B\u53E4\u795E\u5668\u5DF2\u7D93\u6709\u4E00\u6BB5\u6642\u9593\u4E86.
      \u800C\u4E14\u6211\u65E9\u5C31\u548C\u59B3\u7684\u9867\u554F\u806F\u7E6B\u904E\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824269
    m_Localized: "\u70BA\u4EC0\u9EBC\uFF0C\u4F60\u7576\u6642\u6C92\u6709\u81EA\u5DF1\u5F04\u5230\uFF1F
      \u9019\u5C07\u62EF\u6551\u8A31\u591A\u524D\u5929\u9078\u4E4B\u99AC."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824270
    m_Localized: "\u6A5F\u68B0\u7CBE\u9748\u5F88\u96E3\u88AB\u8996\u70BA\u80FD\u6DF1\u5165\u5B58\u653E\u6B64\u985E\u7269\u9AD4\u5340\u57DF\u7684\u597D\u5DE5\u5177\uFF0C\u800C\u6211\u4E5F\u6C92\u6709\u5176\u4ED6\u50CF\u6A23\u7684\u5DE5\u5177.
      \u611F\u8B1D\u59B3\u81F3\u5C11\u627E\u5230\u9019\u4E9B\u53E4\u795E\u5668\u7684\u5927\u81F4\u4F4D\u7F6E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824271
    m_Localized: "\u662F\u4F60\u767C\u73FE\u7684\uFF1F \u9867\u554F\u8AAA\u6709\u95DC\u5B83\u5011\u7684\u8CC7\u8A0A\u662F\u5F9E\u6A94\u6848\u4E2D\u7372\u53D6\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824272
    m_Localized: "\u597D\u50CF\u6230\u524D\u7684\u5C0F\u99AC\u90FD\u60F3\u8981\u5728\u4E00\u4E9B\u96A8\u6A5F\u6A94\u6848\u4E2D\u653E\u7F6E\u9019\u4E9B\u79D8\u5BC6.
      \u9664\u4E86\u76F4\u63A5\u76F8\u95DC\u7684\u8077\u54E1\uFF0C\u9802\u591A\u53EA\u6709\u6700\u9AD8\u6307\u63EE\u90E8\u7684\u6210\u54E1\u624D\u77E5\u9053\u9019\u7A2E\u5F37\u529B\u5371\u96AA\u7269\u54C1\u7684\u4F4D\u7F6E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824273
    m_Localized: "\u4F60\u6C92\u6709\u56DE\u7B54\u6211\u7684\u554F\u984C. \u4F60\u70BA\u4EC0\u9EBC\u8981\u5E6B\u52A9\u6211\u5011\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824274
    m_Localized: "\u54E6\uFF0C\u9019\u662F\u500B\u597D\u554F\u984C. \u4F46\u73FE\u5728\u56DE\u7B54\u9084\u70BA\u6642\u904E\u65E9.
      \u6211\u6703\u5728\u5FC5\u8981\u6642\u544A\u8A34\u59B3\u6211\u7684\u76EE\u6A19\uFF0C\u800C\u4E0D\u662F\u73FE\u5728."
