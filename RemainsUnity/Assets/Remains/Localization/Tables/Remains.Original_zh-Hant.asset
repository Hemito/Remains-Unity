  - m_Id: 2729435853
    m_Localized: "\u65B0\u624B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435854
    m_Localized: "\u5728\u65B0\u624B\u6A21\u5F0F\u4E2D\u4F60\u4E0D\u9700\u8981\u64D4\u5FC3\u592A\u591A.\n\u4F60\u958B\u59CB\u904A\u6232\u7684\u6642\u5019\u6709200\u9EDE\u7684\u751F\u547D\u503C\uFF0C\u4E26\u4E14\u6BCF\u4E00\u7B49\u7D1A\u589E\u52A025\u9EDE\u7684\u751F\u547D\u503C\u4E0A\u9650.\n\u6575\u99AC\u7684\u751F\u547D\u503C\u6E1B\u5C1160%.\n\u89D2\u8272\u5E7E\u4E4E\u4E0D\u6703\u53D7\u5230\u5275\u50B7.\n\u53D7\u5230\u81F4\u547D\u50B7\u5BB3\u88AB\u50B3\u9001\u5230\u8A18\u9304\u9EDE\u5F8C\u4E0D\u6703\u53D7\u5230\u984D\u5916\u640D\u50B7.\n\u6575\u99AC\u5F88\u96E3\u6CE8\u610F\u5230\u4F60\u7684\u52D5\u975C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435855
    m_Localized: "\u7C21\u55AE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435856
    m_Localized: "\u7C21\u55AE\u6A21\u5F0F\u9069\u5408\u7B2C\u4E00\u6B21\u73A9\u7684\u73A9\u5BB6.\n\u4F60\u958B\u59CB\u904A\u6232\u7684\u6642\u5019\u6709150\u9EDE\u7684\u751F\u547D\u503C\uFF0C\u6BCF\u589E\u52A0\u4E00\u7B49\u7D1A\u63D0\u9AD825\u9EDE\u7684\u751F\u547D\u503C\u4E0A\u9650.\n\u6575\u99AC\u7684\u751F\u547D\u503C\u6E1B\u5C1130%.\n\u5FF5\u529B\u548C\u81EA\u6211\u61F8\u6D6E\u4E0D\u6703\u6D88\u8017\u9B54\u529B\u503C.\n\u89D2\u8272\u53D7\u5230\u7684\u5275\u50B7\u6E1B\u5C11\u5169\u500D.\n\u53D7\u5230\u81F4\u547D\u50B7\u5BB3\u88AB\u50B3\u9001\u5230\u8A18\u9304\u9EDE\u5F8C\u4E0D\u6703\u53D7\u5230\u984D\u5916\u640D\u50B7.\n\u6575\u99AC\u5F88\u96E3\u6CE8\u610F\u5230\u4F60\u7684\u52D5\u975C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435857
    m_Localized: "\u666E\u901A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435858
    m_Localized: "\u666E\u901A\u6A21\u5F0F\u9069\u5408\u90A3\u4E9B\u5DF2\u7D93\u66F4\u6709\u7D93\u9A57\u7684\u73A9\u5BB6.\n\u4F60\u958B\u59CB\u904A\u6232\u7684\u6642\u5019\u6709100\u9EDE\u7684\u751F\u547D\u503C\uFF0C\u6BCF\u589E\u52A0\u4E00\u7B49\u7D1A\u63D0\u9AD820\u9EDE\u7684\u751F\u547D\u503C\u4E0A\u9650.\n\u89D2\u8272\u5728\u81F4\u547D\u50B7\u5BB3\u5F8C\u56DE\u5230\u8A18\u9304\u9EDE\u6703\u53D7\u5230\u984D\u5916\u640D\u50B7.\n\u96E3\u5EA6\u6216\u591A\u6216\u5C11\u662F\u5E73\u8861\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435859
    m_Localized: "\u56F0\u96E3"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435860
    m_Localized: "\u5728\u56F0\u96E3\u6A21\u5F0F\u4E0B\u4F60\u5F97\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u884C\u52D5\u4F86\u751F\u5B58.\n\u4F60\u958B\u59CB\u904A\u6232\u7684\u6642\u5019\u670970\u9EDE\u7684\u751F\u547D\u503C\uFF0C\u6BCF\u589E\u52A0\u4E00\u7B49\u7D1A\u7372\u5F9715\u9EDE\u7684\u751F\u547D\u503C\u4E0A\u9650\u63D0\u5347.\n\u89D2\u8272\u5728\u53D7\u5230\u81F4\u547D\u50B7\u5BB3\u5F8C\u56DE\u5230\u8A18\u9304\u9EDE\u5F8C\u6703\u53D7\u5230\u66F4\u591A\u7684\u984D\u5916\u640D\u50B7.\n\u91AB\u751F\u7684\u6CBB\u7642\u6703\u8017\u8CBB\u66F4\u591A\u9322.
      \u6D41\u8840\u548C\u4E2D\u6BD2\u72C0\u614B\u7684\u6642\u9577\u589E\u52A0\u5169\u500D.\n\u7121\u6CD5\u5F9E\u8A18\u9304\u9EDE\u50B3\u9001\u56DE\u57FA\u5730.\n\u6575\u99AC\u66F4\u52A0\u5F37\u5927."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435861
    m_Localized: "\u5669\u5922"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435862
    m_Localized: "\u5669\u5922\u6A21\u5F0F\u9069\u5408\u90A3\u4E9B\u9858\u610F\u6311\u6230\u7684\u5C08\u5BB6\u7D1A\u73A9\u5BB6.\n\u4F60\u958B\u59CB\u904A\u6232\u7684\u6642\u5019\u64C1\u670940\u9EDE\u7684\u751F\u547D\u503C\uFF0C\u6BCF\u589E\u52A0\u4E00\u7B49\u7D1A\u7372\u5F9710\u9EDE\u7684\u751F\u547D\u503C\u4E0A\u9650\u63D0\u5347.\n\u89D2\u8272\u5728\u5931\u53BB\u610F\u8B58\u56DE\u5230\u6AA2\u67E5\u9EDE\u5F8C\u6703\u53D7\u5230\u56B4\u91CD\u640D\u50B7.\n\u4F60\u5728\u5404\u7A2E\u5BB9\u5668\u88E1\u9762\u5F97\u5230\u7684\u74F6\u84CB\u548C\u9322\u5E63\u6703\u66F4\u5C11.\n\u6575\u99AC\u6703\u66F4\u52A0\u6975\u7AEF\u5730\u5F37\u5927."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435863
    m_Localized: "---\u96E3\u5EA6\u9078\u9805---"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435864
    m_Localized: "\u7565\u904E\u6559\u5B78"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435865
    m_Localized: "\u4F60\u6703\u5F9E\u71DF\u5730\u958B\u59CB\u904A\u6232\uFF0C\u65B0\u624B\u6559\u5B78\u5730\u9EDE\u5C07\u7121\u6CD5\u4F7F\u7528.\n\u5982\u679C\u4F60\u662F\u7B2C\u4E00\u6B21\u73A9\uFF0C\u8ACB\u4E0D\u8981\u52FE\u9078\u6B64\u9078\u9805\uFF0C\u4F60\u4E0D\u6703\u5E0C\u671B\u932F\u904E\u4E00\u4E9B\u6545\u4E8B\u7684\u95DC\u9375\u7247\u6BB5\u7684\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435866
    m_Localized: "\u4E00\u547D\u552F\u4E00"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435867
    m_Localized: "\u5728\u904A\u6232\u4E2D\uFF0C\u5982\u679C\u89D2\u8272\u53D7\u50B7\u56B4\u91CD\uFF0C\u56DE\u5230\u6AA2\u67E5\u9EDE\u6216\u57FA\u5730\u9032\u884C\u6062\u5FA9\u5DF2\u88AB\u7981\u7528.\n\u89D2\u8272\u6B7B\u4EA1\u5F8C\u4E0D\u53EF\u5FA9\u6D3B\uFF0C\u6B7B\u4EA1\u5373\u662F\u7D50\u675F.\n\u904A\u6232\u53EA\u6709\u4E00\u500B\u5B58\u6A94\u69FD."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435868
    m_Localized: "\u5FEB\u901F\u5347\u7D1A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435869
    m_Localized: "\u5347\u7D1A\u6240\u9700\u7684\u7D93\u9A57\u503C\u6E1B\u5C1140."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435870
    m_Localized: "\u96A8\u6A5F\u6280\u80FD"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435871
    m_Localized: "\u5347\u7D1A\u7684\u6642\u5019\uFF0C\u80FD\u529B\u548C\u6280\u80FD\u5C07\u96A8\u6A5F\u7372\u5F97.\n\u4EE5\u4E0D\u78BA\u5B9A\u6027\u4F86\u6AA2\u9A57\u4F60\u751F\u5B58\u7684\u80FD\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435872
    m_Localized: "\u6020\u6162\u7FD2\u8005"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435873
    m_Localized: "\u4F60\u6BCF\u5347\u4E00\u7D1A\u53EA\u6703\u7372\u5F973\u500B\u6280\u80FD\u9EDE\uFF0C\u800C\u4E0D\u662F5\u500B.\n\u5347\u5230\u6BCF\u500B\u6280\u80FD\u7684\u6700\u5927\u503C\u5C07\u6703\u66F4\u52A0\u56F0\u96E3.\n\u4F60\u9700\u8981\u66F4\u8B39\u614E\u5730\u5206\u914D\u81EA\u5DF1\u7684\u6280\u80FD\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435874
    m_Localized: "\u6709\u9650\u5EAB\u5B58"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435875
    m_Localized: "\u5728\u6709\u9650\u5EAB\u5B58\u6A21\u5F0F\u4E0B\uFF0C\u5927\u591A\u6578\u7269\u54C1\u90FD\u6709\u91CD\u91CF.\n\u60A8\u5C07\u80FD\u5920\u651C\u5E36\u548C\u4F7F\u7528\u6578\u91CF\u6709\u9650\u7684\u7269\u54C1\u548C\u6B66\u5668.\n\u6B64\u6A21\u5F0F\u50C5\u63A8\u85A6\u7D66\u4E0D\u662F\u7B2C\u4E00\u6B21\u73A9\u4E14\u6709\u7D93\u9A57\u7684\u73A9\u5BB6."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435876
    m_Localized: "\u5916\u89C0\u81EA\u8A02"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435877
    m_Localized: "\u819A\u8272"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435878
    m_Localized: "\u9B03\u6BDB\u984F\u8272\u4E00\u53CA\u9AEE\u578B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435879
    m_Localized: "\u9B03\u6BDB\u984F\u8272\u4E8C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435880
    m_Localized: "\u773C\u775B\u984F\u8272\u53CA\u5F62\u72C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435881
    m_Localized: "\u9B54\u6CD5\u984F\u8272"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435882
    m_Localized: "---\u5F88\u4E45\u5F88\u4E45\u4EE5\u524D\uFF0C\u5728\u5C0F\u99AC\u570B\u9019\u7247\u795E\u5947\u7684\u571F\u5730\u4E0A......\n...\u6709\u4E00\u500B\u4EE5\u5FCC\u5992,\u81EA\u79C1,\u8CAA\u5A6A\u8207\u6B98\u5FCD\uFF0C\u5C07\u53CB\u8ABC\u7684\u7406\u5FF5\u541E\u98DF\u6B86\u76E1\u7684\u6642\u4EE3\u4F86\u81E8\u4E86.
      \u5728\u5C0F\u99AC\u570B\u8207\u6591\u99AC\u570B\u4E4B\u9593\uFF0C\u7206\u767C\u4E86\u4EE5\u81EA\u7136\u8CC7\u6E90\u70BA\u9996\u7684\u5927\u6230\uFF0C\u5728\u9019\u4E4B\u9593\u6C92\u6709\u4EFB\u4F55\u8D0F\u5BB6.
      \u5728\u5C0F\u99AC\u8E44\u7684\u653B\u64CA\u4E0B\uFF0C\u9B54\u6CD5\u8FC5\u901F\u7206\u767C\u5931\u63A7\uFF0C\u6574\u500B\u4E16\u754C\u90FD\u88AB\u6230\u706B\u541E\u566C.
      \u9F8D\u706B\u548C\u9ED1\u9B54\u6CD5\u7D50\u5408\u800C\u6210\u7684\u6BC0\u6EC5\u6027\u6B66\u5668\uFF0C\u5E7E\u4E4E\u7121\u60C5\u5730\u7D50\u675F\u4E86\u5C0F\u99AC\u570B\u4E0A\u7684\u6240\u6709\u751F\u547D.
      \u571F\u58E4,\u6C34\u548C\u7A7A\u6C23\u90FD\u56E0\u8F3B\u5C04\u800C\u906D\u6C59\u67D3\uFF0C\u57CE\u5E02\u6BC0\u6EC5,\u6587\u660E\u5D29\u6F70.
      \u7121\u8AD6\u662F\u5C0F\u99AC\u9084\u662F\u6591\u99AC\uFF0C\u5E7E\u4E4E\u90FD\u5728\u5730\u8868\u4E0A\u88AB\u6BBA\u6B7B\u4E86.
      \u760B\u72C2\u7684\u5148\u77E5\u6240\u9810\u8A00\u7684\u4E16\u754C\u672B\u65E5\uFF0C\u5E7E\u4E4E\u90FD\u6C92\u6709\u5C0F\u99AC\u9CE5\u5B83\uFF0C\u76F4\u5230\u90A3\u5929\u6CE8\u5B9A\u7684\u65E5\u5B50\u5230\u4F86......\n...\u4F46\u9019\u4E26\u4E0D\u662F\u7D50\u5C40\uFF0C\u9084\u662F\u6709\u8A31\u591A\u5C0F\u99AC\u50E5\u5016\u6D3B\u4E86\u4E0B\u4F86\uFF0C\u5176\u4E2D\u4E00\u4E9B\u8EB2\u5728\u5927\u578B\u7684\u907F\u96E3\u5EC4\uFF0C\u4E00\u4E9B\u5247\u662F\u795E\u5947\u5730\u9069\u61C9\u4E86\u65B0\u74B0\u5883.
      \u5148\u77E5\u7684\u9810\u8A00\u53EA\u4E0D\u904E\u662F\u5C0F\u99AC\u6B77\u53F2\u4E0A\u53E6\u4E00\u500B\u8840\u8165\u7AE0\u7BC0\u7684\u5E8F\u5E55.
      \u5728\u88AB\u71D2\u7126\u548C\u6BD2\u5BB3\u7684\u5EE2\u571F\u4E0A\uFF0C\u66B4\u529B\u548C\u6B98\u5FCD\u8B8A\u5F97\u4E0D\u50C5\u50C5\u662F\u88AB\u5141\u8A31\u7684,\u800C\u662F\u4ED6\u5011\u73FE\u5728\u751F\u5B58\u7684\u8E44\u6BB5......\n...\u5F9E\u90A3\u5929\u5C0F\u99AC\u570B\u7684\u4E16\u754C\u672B\u65E5\u8D77\uFF0C\u5169\u767E\u591A\u5E74\u5DF2\u7D93\u904E\u53BB\u4E86......"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435883
    m_Localized: "\u5728\u907F\u96E3\u5EC4 Pi \u9644\u8FD1\u64CA\u6557\u82F1\u514B\u96F7\u90E8\u968A\u4E26\u5931\u53BB\u4E00\u8258\u96F7\u9706\u4E4B\u9996\u7684\u640D\u5931\u5C0D\u5929\u99AC\u793E\u5340\u4F86\u8AAA\u662F\u4E00\u500B\u9707\u64BC\u3002\u70BA\u4E86\u633D\u56DE\u5C40\u52E2\u4E26\u6062\u5FA9\u8072\u8B7D\uFF0C\u82F1\u514B\u96F7\u5728\u5730\u8868\u9032\u884C\u4E86\u5E7E\u6B21\u65B0\u7684\u653B\u64CA\uFF0C\u4F46\u6C92\u6709\u4E00\u6B21\u662F\u6210\u529F\u7684\u3002\u65B0\u806F\u76DF\u7684\u806F\u5408\u529B\u91CF\u5728\u6BCF\u5834\u6230\u9B25\u4E2D\u6210\u529F\u64CA\u9000\u4E86\u82F1\u514B\u96F7\u7684\u90E8\u968A\uFF0C\u7372\u5F97\u4E86\u4E4B\u524D\u5206\u6563\u5B9A\u5C45\u9EDE\u6240\u4E0D\u80FD\u9054\u5230\u7684\u6210\u529F\u3002\u6700\u7D42\uFF0C\u96A8\u8457\u5C45\u6C11\u4E4B\u9593\u95DC\u65BC\u5730\u8868\u5C0F\u99AC\u6587\u660E\u7684\u50B3\u64AD\uFF0C\u9019\u5C0E\u81F4\u4E86\u5927\u5929\u99AC\u82F1\u514B\u96F7\u9818\u5C0E\u5C64\u5730\u4F4D\u7684\u5B8C\u5168\u5931\u4FE1\u3002\u958B\u59CB\u65BC\u793E\u6703\u4E2D\u4E0D\u5B89\u5B9A\u7684\u5C40\u52E2\u6F14\u8B8A\u6210\u70BA\u4E00\u5834\u516C\u958B\u7684\u53DB\u4E82\u548C\u63A8\u7FFB\u73FE\u653F\u5E9C\u7684\u4F01\u5716\u3002\u7531\u65BC\u90A3\u4E9B\u72AF\u4E0B\u6230\u722D\u7F6A\u884C\u7684\u9818\u5C0E\u5C64\u548C\u8ECD\u968A\u4E4B\u9593\u7684\u5167\u6230\u8FC5\u901F\u800C\u8840\u8165\uFF0C\u5016\u5B58\u7684\u6D41\u4EA1\u8005\u88AB\u8FEB\u9003\u5230\u5730\u8868\u4E0A\u3002\u4ED6\u5011\u5C45\u4F4F\u5728\u5E7E\u500B\u5148\u524D\u88AB\u907A\u68C4\u7684\u57FA\u5730\u548C\u71DF\u5730\uFF0C\u65E2\u4E0D\u5C0D\u5929\u99AC\u4E5F\u4E0D\u5C0D\u5730\u8868\u5C45\u6C11\u69CB\u6210\u81F4\u547D\u5A01\u8105\uFF0C\u6210\u70BA\u7B49\u5F85\u6D88\u6EC5\u7684\u5EE2\u571F\u5A01\u8105\u4E4B\u4E00\u3002\n\u5118\u7BA1\u9020\u6210\u4E86\u53EF\u6015\u7684\u640D\u5BB3\u548C\u91CD\u5927\u640D\u5931\uFF0C\u907F\u96E3\u5EC4
      Pi \u7684\u5C45\u6C11\u4ECD\u7136\u80FD\u5920\u5728\u65B0\u4E16\u754C\u4E2D\u751F\u5B58\u548C\u9069\u61C9\u3002\u9019\u4E3B\u8981\u6B78\u529F\u65BC\u9A30\u98DB\u5C0F\u99AC\u7684\u5C45\u6C11\u548C\u9435\u8E44\u53CA\u5176\u9435\u9A0E\u885B\u7684\u5E6B\u52A9\u548C\u4FDD\u8B77\u3002
      \u800C\u907F\u96E3\u5EC4\u5C45\u6C11\u7528\u6280\u8853\u548C\u7A00\u6709\u8CC7\u6E90\u4F86\u6295\u6843\u5831\u674E\u3002\u6709\u8457\u91AB\u7642\u8A2D\u5099\u548C\u7528\u54C1\uFF0C\u98DF\u7269\u5132\u5099\uFF0C\u6230\u524D\u690D\u7269\u7A2E\u5B50\u7684\u5E6B\u52A9\uFF0C\u9A30\u98DB\u5C0F\u99AC\u71DF\u5730\u548C\u96B1\u5BC6\u6751\u838A\u7684\u5C45\u6C11\u9032\u5165\u65B0\u7684\u589E\u9577\u548C\u767C\u5C55\u6642\u4EE3\u3002\u4E0D\u4E45\u4E4B\u5F8C\uFF0C\u6240\u8B02\u7684\u201C\u63F4\u52A9\u4EA4\u6D41\u201D\u6F38\u6F38\u767C\u5C55\u6210\u70BA\u7DCA\u5BC6\u7684\u5408\u4F5C\u548C\u8CBF\u6613\uFF0C\u5C07\u9019\u4E9B\u5B9A\u5C45\u9EDE\u8B8A\u6210\u4E86\u5EE2\u571F\u4E2D\u7E41\u69AE\u7684\u5CF6\u5DBC\u3002\n\u7576\u6230\u722D\u7D50\u675F\u6642\uFF0C\u96B1\u5BC6\u6751\u838A\u7684\u6591\u99AC\u5011\u7D42\u65BC\u80FD\u5920\u9AD4\u9A57\u5230\u4ED6\u5011\u591A\u5E74\u4F86\u6240\u7F3A\u5C11\u7684\u611F\u89BA\u2014\u2014\u5B89\u5168\u611F\u3002\u5728\u963F\u65AF\u5361\u7406\u7684\u5E36\u9818\u4E0B\uFF0C\u4EE5\u53CA\u8587\u8587\u7684\u5E6B\u52A9\uFF0C\u5C45\u6C11\u5011\u514B\u670D\u4E86\u98E2\u9913\u3001\u75BE\u75C5\u548C\u8CA7\u56F0\u3002\u5118\u7BA1\u5C0F\u99AC\u570B\u5EE2\u571F\u4ECD\u7136\u5A01\u8105\u8457\u4ED6\u5011\uFF0C\u6709\u63A0\u596A\u8005\u3001\u5974\u96B8\u4E3B\u548C\u5371\u96AA\u7684\u63A0\u98DF\u8005\uFF0C\u4F46\u662F\uFF0C\u88AB\u653E\u9010\u7684\u8ECD\u5718\u6210\u54E1\u4E0D\u518D\u5BB3\u6015\u4ED6\u5011\u5FA9\u4EC7\u5FC3\u5207\u540C\u80DE\u7121\u6240\u4E0D\u5728\u7684\u773C\u775B\u3002\u51F1\u6492\u91CE\u5FC3\u52C3\u52C3\u5F81\u670D\u9019\u7247\u571F\u5730\u7684\u8A08\u5283\u88AB\u9435\u8E44\u7684\u7834\u58DE\u548C\u6230\u722D\u7684\u5931\u6557\u6240\u6467\u6BC0\uFF0C\u800C\u88AB\u547D\u904B\u9078\u4E2D\u7684\u99AC\u4E5F\u88AB\u8FEB\u5C07\u76EE\u5149\u8F49\u5411\u66F4\u5BB9\u6613\u5F81\u670D\u7684\u5730\u65B9\u3002\u8ECD\u5718\u548C\u82F1\u514B\u96F7\u5A01\u8105\u7684\u6D88\u5931\u610F\u5473\u8457\u96B1\u5BC6\u6751\u838A\u7684\u548C\u5E73\u6642\u671F\u7D42\u65BC\u5230\u4F86\u4E86\u3002\n\u9A30\u98DB\u5C0F\u99AC\u71DF\u5730\u4E00\u76F4\u662F\u9019\u7247\u571F\u5730\u4E0A\u6700\u5927\u7684\u548C\u5E73\u5B9A\u5C45\u9EDE\uFF0C\u5373\u4F7F\u5728
      @lp \u88AB\u9001\u5230\u5730\u8868\u4E4B\u524D\u4E5F\u662F\u5982\u6B64\u3002\u73FE\u5728\uFF0C\u6191\u85C9\u8457\u65B0\u7684\u76DF\u53CB\u548C\u6280\u8853\uFF0C\u5B83\u958B\u59CB\u770B\u8D77\u4F86\u50CF\u4E00\u500B\u771F\u6B63\u7684\u57CE\u5E02\uFF0C\u985E\u4F3C\u65BC\u6230\u524D\u6751\u838A\u7684\u5C45\u6C11\u6578\u91CF\u3002\u8A31\u591A\u5C0F\u99AC\u4F86\u5230\u9019\u88E1\u5C0B\u6C42\u548C\u5E73\u7684\u751F\u6D3B\uFF0C\u751A\u81F3\u4E00\u4E9B\u4F86\u81EA\u907F\u96E3\u5EC4\u548C\u96B1\u5BC6\u6751\u838A\u7684\u672C\u5730\u99AC\u4E5F\u642C\u5230\u9019\u500B\u65E5\u76CA\u589E\u9577\u7684\u71DF\u5730\u5C45\u4F4F\u3002\u707D\u5384\u6210\u70BA\u76DF\u8ECD\u5B9A\u5C45\u9EDE\u4E8B\u52D9\u7684\u4E3B\u8981\u8AC7\u5224\u99AC\uFF0C\u4E5F\u70BA\u4ED6\u5BB6\u9109\u7684\u7E41\u69AE\u505A\u51FA\u4E86\u76F8\u7576\u7684\u52AA\u529B\u3002\u9A30\u98DB\u5C0F\u99AC\u7684\u5C45\u6C11\u53EF\u4EE5\u5B89\u5FC3\u5165\u7761\uFF0C\u56E0\u70BA\u4ED6\u5011\u4E0D\u50C5\u88AB\u5DE1\u908F\u968A\u7684\u69CD\u652F\u8B77\u885B\u8457\uFF0C\u9084\u6709\u4ED6\u5011\u8207\u9435\u9A0E\u885B\u7684\u5BC6\u5207\u53CB\u8ABC\u3002\u96B1\u5BC6\u6751\u838A\u7684\u6591\u99AC\u662F\u5929\u751F\u7684\u5075\u5BDF\u54E1\uFF0C\u7E3D\u662F\u63D0\u524D\u8B66\u544A\u4ED6\u5011\u53EF\u80FD\u7684\u5A01\u8105\uFF0C\u800C\u4F86\u81EA\u907F\u96E3\u5EC4
      Pi \u7684\u79D1\u5B78\u5BB6\u548C\u6280\u8853\u99AC\u54E1\u70BA\u9A30\u98DB\u5C0F\u99AC\u71DF\u5730\u63D0\u4F9B\u4E86\u6700\u65B0\u7684\u81EA\u52D5\u70AE\u5854\u7CFB\u7D71\u3002\u7576\u71DF\u5730\u5F97\u5230\u76DF\u53CB\u7684\u652F\u63F4\u6642\uFF0C\u4E5F\u7E3D\u6703\u56DE\u5831\u5E6B\u52A9\u76DF\u53CB\u5011\u3002\n\u5728\u6D88\u6EC5\u4E86\u82F1\u514B\u96F7\u7684\u5A01\u8105\u4E4B\u5F8C\uFF0C\u9435\u8E44\u81F4\u529B\u65BC\u4FDD\u8B77\u548C\u78BA\u4FDD\u4ED6\u7684\u65B0\u76DF\u53CB\u7684\u5B89\u5168\u3002\u4F5C\u70BA\u56DE\u5831\uFF0C\u201C\u9A30\u98DB\u5C0F\u99AC\u71DF\u5730\u201D\u7D93\u5E38\u5411\u9435\u8E44\u904B\u9001\u7269\u8CC7\uFF0C\u800C\u9435\u9A0E\u885B\u7684\u5144\u5F1F\u6703\u6A94\u6848\u4E2D\u4E5F\u5145\u6EFF\u4E86\u907F\u96E3\u5EC4
      Pi \u79D1\u5B78\u5BB6\u7684\u79D8\u5BC6\u3002\u5728\u9577\u671F\u800C\u75B2\u618A\u7684\u6230\u722D\u4E4B\u5F8C\uFF0C\u9700\u8981\u88DC\u5145\u65B0\u7684\u6210\u54E1\uFF0C\u5176\u4E2D\u8A31\u591A\u5C0F\u99AC\u4EE5\u524D\u8207\u9A0E\u58EB\u5011\u4E00\u8D77\u5C0D\u6297\u82F1\u514B\u96F7\u3002\u5118\u7BA1\u9019\u7247\u571F\u5730\u4ECD\u7136\u5145\u6EFF\u4E86\u5371\u96AA\uFF0C\u4F46\u5E0C\u671B\u958B\u59CB\u6EAB\u6696\u8457\u8001\u99AC\u7684\u5FC3\u3002\u5C07\u5E0C\u671B\u5EE2\u571F\u6642\u4EE3\u4E0D\u6703\u662F\u5C0F\u99AC\u6B77\u53F2\u7684\u6700\u5F8C\u4E00\u7AE0\uFF0C\u800C\u65B0\u793E\u6703\u7684\u840C\u82BD\u5C07\u80FD\u5920\u6210\u9577\u70BA\u5982\u540C\u53E4\u4EE3\u5C0F\u99AC\u570B\u7684\u6587\u660E\n\u5373\u4F7F\u5728\u5176\u4ED6\u5730\u65B9\u6709\u5F88\u591A\u4E8B\u60C5\u9700\u8981\u8655\u7406\uFF0C\u5B88\u671B\u8005\u4E5F\u5F9E\u672A\u5FD8\u8A18\u5EE2\u571F\u4E0A\u4E00\u500B\u65B0\u548C\u5E73\u7684\u89D2\u843D\u3002\u4E0D\u50C5\u56E0\u70BA\u4ED6\u8A8D\u70BA\u81EA\u5DF1\u6709\u7FA9\u52D9\u4FDD\u8B77\u5B83\uFF0C\u9084\u56E0\u70BA\u4ED6\u5E0C\u671B\u5728\u9019\u88E1\u627E\u5230\u9069\u5408\u4ED6\u795E\u79D8\u76EE\u7684\u7684\u5C0F\u99AC\u3002\u4F46\u4ED6\u7E3D\u662F\u7279\u5225\u95DC\u6CE8\u4E00\u4F4D\u4ED6\u7A31\u70BA\u670B\u53CB\u7684\u5C0F\u99AC\u3002\u5B88\u671B\u8005\u548C
      @lp \u5728\u8207\u82F1\u514B\u96F7\u6230\u722D\u671F\u9593\u548C\u4E4B\u5F8C\u4E92\u76F8\u5E6B\u52A9\u904E\u5F88\u591A\u6B21\u3002\n\u96D6\u7136
      @lp \u53EF\u80FD\u6C38\u9060\u4E0D\u6703\u627F\u8A8D\uFF0C\u751A\u81F3\u53EF\u80FD\u5979\u81EA\u5DF1\u90FD\u6C92\u6709\u60F3\u904E\uFF0C\u4F46\u5979\u6210\u70BA\u4E86\u5F15\u767C\u6240\u6709\u90A3\u4E9B\u4E8B\u4EF6\u7684\u50AC\u5316\u5291\u3002\u9019\u4E0D\u50C5\u662F\u901A\u904E\u5B8C\u6210\u5C0E\u5E2B\u7684\u4F7F\u547D\uFF0C\u4E5F\u4E0D\u50C5\u662F\u901A\u904E\u5176\u5C0D\u8A72\u5730\u5340\u653F\u6CBB\u5C40\u52E2\u7684\u5F71\u97FF\u3002\u5C31\u50CF\u6D41\u661F\u4E00\u6A23\uFF0C\u5979\u7A7F\u904E\u4E86\u8A31\u591A\u5C0F\u99AC\u7684\u751F\u6D3B\uFF0C\u6539\u8B8A\u4E86\u4ED6\u5011\uFF0C\u63A8\u52D5\u4E86\u4ED6\u5011\u524D\u9032\u3002\u5982\u679C\u4E0D\u662F\u56E0\u70BA\u5979\u60F3\u8981\u56DE\u5831\u4E4B\u524D\u5F97\u5230\u7684\u652F\u6301\u4F86\u5E6B\u52A9\u5979\u7684\u5BB6\u5712\uFF0C\"\u9A30\u98DB\u5C0F\u99AC\"\u7684\u5C45\u6C11\u6C38\u9060\u4E0D\u6703\u5728\u6062\u5FA9\u907F\u96E3\u5EC4
      Pi \u4E0A\u6295\u5165\u9019\u9EBC\u591A\u7684\u7CBE\u529B\u3002\u5982\u679C\u4E0D\u662F\u56E0\u70BA\u5979\u9B6F\u83BD\u52C7\u6562\u7684\u4F8B\u5B50\uFF0C\u96B1\u5BC6\u6751\u838A\u7684\u6591\u99AC\u6C38\u9060\u4E0D\u6703\u627E\u5230\u505C\u6B62\u751F\u6D3B\u5728\u5730\u4E0B\u7684\u529B\u91CF\u3002\u5982\u679C\u4E0D\u662F\u56E0\u70BA\u5979\u5C0D\u6297\u5EE2\u571F\u6240\u6709\u6050\u61FC\u548C\u58AE\u843D\u7684\u6C7A\u5FC3\u6240\u5E36\u4F86\u7684\u5E0C\u671B\uFF0C\u9435\u8E44\u5C31\u4E0D\u6703\u6293\u4F4F\u6062\u5FA9\u5C0F\u99AC\u570B\u904E\u53BB\u7684\u4E00\u7D72\u6A5F\u6703\u3002\n\u7136\u800C\uFF0C
      @lp \u672C\u4EBA\u4E26\u4E0D\u611F\u5230\u4EFB\u4F55\u9A55\u50B2\u3002\u70BA\u4E86\u5E6B\u52A9\u5979\u7684\u670B\u53CB\uFF0C\u4E26\u8D16\u56DE\u5979\u5728\u904E\u53BB\u6D41\u8840\u4E8B\u4EF6\u4E2D\u7684\u7F6A\u60E1\u611F\uFF0C\u4E0D\u7BA1\u662F\u771F\u5BE6\u7684\u9084\u662F\u60F3\u50CF\u7684\uFF0C\u5979\u4E0D\u77E5\u75B2\u5026\u5730\u8207\u82F1\u514B\u96F7\u4F5C\u6230\uFF0C\u52DD\u5229\u4E4B\u5F8C\uFF0C\u5979\u958B\u59CB\u5C0D\u6297\u66F4\u5C0F\u7684\u5A01\u8105\u3002\u4E5F\u8A31\u3000@lp\u3000\u8A8D\u70BA\u9019\u662F\u5979\u6700\u64C5\u9577\u7684\u4E8B\u60C5\u3002\u4E5F\u8A31\u5979\u53EA\u662F\u4E0D\u559C\u6B61\u904E\u8457\u5E73\u975C\u7684\u751F\u6D3B\u3002\u7136\u800C\uFF0C
      @lp \u5B78\u5230\u4E86\u8A31\u591A\u5EE2\u571F\u7684\u6559\u8A13\u3002\u5176\u4E2D\u7B2C\u4E00\u500B\u6559\u8A13\u662F\uFF0C\u6211\u5011\u6C38\u9060\u4E0D\u61C9\u8A72\u5FD8\u8A18\u4EC0\u9EBC\u662F\u5340\u5206\u65BC\u602A\u7269\u7684\u672C\u8CEA\n\u540C\u60C5\u5FC3."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435884
    m_Localized: "\u6709\u8457\u9A30\u98DB\u5C0F\u99AC\u3001\u9435\u8E44\u53CA\u5176\u9435\u9A0E\u885B\u548C\u96B1\u5BC6\u6751\u838A\u6591\u99AC\u7684\u806F\u5408\uFF0C\u6210\u529F\u5730\u64CA\u9000\u4E86\u5171\u540C\u7684\u6575\u4EBA\uFF0C\u4FDD\u885B\u4E86\u907F\u96E3\u5EC4
      Pi \u3002 @lp \u53EF\u80FD\u5C0D\u7834\u58DE\u5929\u99AC\u7A7A\u4E2D\u5821\u58D8\u505A\u51FA\u4E86\u6700\u5927\u7684\u8CA2\u737B\u3002\u7136\u800C\uFF0C\u9019\u500B\u806F\u76DF\u6CE8\u5B9A\u7121\u6CD5\u9577\u4E45\u5B58\u5728\uFF1A\u865B\u5F31\u4F46\u4ECD\u7136\u6975\u5177\u81F4\u547D\u5A01\u8105\u7684\u82F1\u514B\u96F7\uFF0C\u8A8D\u6E05\u4E86\u65B0\u7684\u6575\u4EBA\uFF0C\u4E26\u5C0D\u4ED6\u5011\u767C\u52D5\u4E86\u8ECD\u4E8B\u884C\u52D5\u3002\u6C92\u6709\u4E00\u500B\u80FD\u5920\u7DAD\u6301\u76F8\u4E92\u4FE1\u4EFB\u7684\u7D71\u4E00\u4E2D\u5FC3\uFF0C\u806F\u5408\u5B9A\u5C45\u9EDE\u7684\u5C45\u6C11\u66F4\u9858\u610F\u96C6\u4E2D\u529B\u91CF\u4FDD\u885B\u81EA\u5DF1\uFF0C\u9019\u6700\u7D42\u5C0D\u6575\u4EBA\u6709\u5229\u3002\u5728\u53D7\u5230\u5730\u9762\u91CE\u883B\u99AC\u7684\u53EF\u6015\u6253\u64CA\u4E4B\u5F8C\uFF0C\u82F1\u514B\u96F7\u5931\u53BB\u4E86\u5E73\u6C11\u7684\u4FE1\u4EFB\u548C\u6B0A\u5A01\uFF0C\u4E14\u9700\u8981\u597D\u6D88\u606F\u3002\u597D\u6D88\u606F\u662F\u4E00\u7CFB\u5217\u7684\u52DD\u5229\u4F86\u81EA\u9435\u8E44\u53CA\u5176\u9435\u9A0E\u885B\u88AB\u8FEB\u540C\u6642\u9632\u79A6\u5929\u99AC\u548C\u51B7\u7738\u90E8\u968A\u7684\u6B98\u9918\u52E2\u529B\u3002\u7531\u65BC\u7F3A\u4E4F\u5916\u529B\u652F\u63F4\uFF0C\u9435\u8E44\u70BA\u4E86\u4FDD\u6301\u9818\u5730\u9032\u800C\u5206\u6563\u4E86\u4ED6\u7684\u529B\u91CF\uFF0C\u7136\u800C\u4ED6\u5011\u7684\u9818\u5730\u88AB\u5FEB\u901F\u800C\u7121\u60C5\u7684\u8972\u64CA\u6467\u6BC0\uFF0C\u9019\u6210\u70BA\u82F1\u514B\u96F7\u53EF\u4EE5\u70AB\u8000\u7684\u52DD\u5229\u4E26\u7DAD\u6301\u5176\u5728\u5929\u99AC\u793E\u6703\u9818\u5C0E\u5730\u4F4D\u7684\u6A5F\u6703\uFF0C\u5C0D\u6297\u4F86\u81EA\u5730\u9762\u4E0A\u7684\u4E00\u5834\u6301\u4E45\u6230\u722D\uFF0C\u4ECD\u7136\u7121\u60C5\uFF0C\u4F46\u5C0D\u75B2\u618A\u548C\u61F7\u6068\u7684\u793E\u6703\u4F86\u8AAA\u4E0D\u518D\u5982\u6B64\u898F\u6A21\u9F90\u5927\u548C\u4EE3\u50F9\u9AD8\u6602\u3002\n\u96A8\u8457\u6230\u722D\u7684\u7E7C\u7E8C\uFF0C\u907F\u96E3\u5EC4
      Pi \u7684\u5C45\u6C11\u88AB\u8FD1\u671F\u7684\u76DF\u53CB\u62CB\u68C4\uFF0C\u4ED6\u5011\u66F4\u64D4\u5FC3\u81EA\u5DF1\u7684\u751F\u5B58\u3002\u53EA\u6709\u4ED6\u5011\u66FE\u7D93\u7684\u6230\u53CB\u201C\u5929\u9078\u4E4B\u99AC\u201D
      \u8587\u8587 \u548C @lp \u7559\u4E0B\u4F86\u5E6B\u5FD9\uFF0C\u4F46\u5979\u5011\u7684\u529B\u91CF\u4E0D\u5920\u3002\u5728\u6062\u5FA9\u5F80\u65E5\u751F\u6D3B\u7684\u6A21\u6A23\u5F8C\uFF0C\u65B0\u7684\u907F\u96E3\u5EC4\u9818\u5C0E\u5C64\u6C7A\u5B9A\u518D\u6B21\u5C01\u9396\u5927\u9580\u3002\u4F46\u9019\u4E00\u6B21\u4ED6\u5011\u5C07\u6E96\u5099\u597D\u9996\u5148\u653B\u64CA\u4EFB\u4F55\u81BD\u6562\u5371\u53CA\u4ED6\u5011\u751F\u6D3B\u65B9\u5F0F\u7684\u5C0F\u99AC\u3002\u800C\u907F\u96E3\u5EC4
      Pi \u7684\u5C0F\u99AC\u6C38\u9060\u4E0D\u6703\u8B93\u81EA\u5DF1\u518D\u6B21\u4FE1\u4EFB\u5EE2\u571F\u7684\u91CE\u883B\u99AC\u3002\n\u6216\u8A31\u96B1\u5BC6\u6751\u838A\u662F\u6700\u5E78\u904B\u7684\u5730\u65B9\uFF1A\u4ED6\u5011\u7684\u5C0F\u5B9A\u5C45\u9EDE\u5F88\u96E3\u88AB\u767C\u73FE\uFF0C\u800C\u4ED6\u5011\u7684\u524D\u76DF\u53CB\u201C\u9A30\u98DB\u5C0F\u99AC\u201D\u71DF\u5730\u548C\u9435\u8E44\u53CA\u5176\u9435\u9A0E\u885B\u662F\u82F1\u514B\u96F7\u66F4\u512A\u5148\u8003\u616E\u7684\u76EE\u6A19\u3002\u6191\u85C9\u9577\u671F\u4FEE\u7149\u7684\u751F\u5B58\u96B1\u853D\u6280\u80FD\uFF0C\u4ED6\u5011\u6210\u529F\u907F\u958B\u4E86\u6575\u99AC\u4E0D\u5FC5\u8981\u7684\u6CE8\u610F\u3002\u7136\u800C\uFF0C\u5118\u7BA1\u8587\u8587\u70BA\u62EF\u6551\u6591\u99AC\u505A\u51FA\u4E86\u6240\u6709\u52AA\u529B\uFF0C\u4F46\u4ED6\u5011\u7684\u751F\u6D3B\u5F88\u80AF\u5B9A\u6C92\u6709\u597D\u8F49\u3002\n\u5929\u7A7A\u4E2D\u6301\u7E8C\u5B58\u5728\u7684\u5A01\u8105\uFF0C\u8FEB\u4F7F\u201C\u9A30\u98DB\u5C0F\u99AC\u201D\u71DF\u5730\u9677\u5165\u570D\u57CE\u72C0\u614B\u3002\u7136\u800C\u5176\u5C45\u6C11\u5F9E\u672A\u653E\u68C4\u6B66\u5668\uFF0C\u9632\u79A6\u7CFB\u7D71\u4E5F\u4FDD\u6301\u5B8C\u7F8E\u72C0\u614B\uFF0C\u5145\u8DB3\u7761\u7720\u5DF2\u88AB\u907A\u5FD8\u70BA\u904E\u53BB\u7684\u5962\u4F88\u3002\u96EA\u4E0A\u52A0\u971C\u7684\u662F\uFF0C\u5929\u99AC\u91C7\u7528\u4E86\u8B93\u5C45\u6C11\u6328\u9913\u7684\u5C01\u9396\u6230\u7B56\u7565\uFF0C\u8B93\u5C0F\u578B\u72E9\u7375\u5C0F\u968A\u641C\u7D22\u4E26\u6467\u6BC0\u6BCF\u4E00\u5339\u8A66\u5716\u4F7F\u7528\u53E4\u8001\u7684\u65B9\u6CD5\u524D\u5F80\u6230\u524D\u907A\u5740\u70BA\u71DF\u5730\u7372\u53D6\u98DF\u7269\u548C\u5F48\u85E5\u7684\u5C0F\u99AC\u3002\u5118\u7BA1\u5982\u6B64\uFF0C\u71DF\u5730\u5C45\u6C11\u7684\u97CC\u6027\u548C\u8DB3\u667A\u591A\u8B00\u8B93\u4ED6\u5011\u5C07\u82F1\u514B\u96F7\u7684\u5A01\u8105\u64CB\u5728\u4E86\u9580\u5916\uFF0C\u6210\u70BA\u9632\u79A6\u9818\u8896\u7684\u707D\u5384\u4E0D\u65B7\u5617\u8A66\u53CD\u64CA\u6575\u99AC\u3002\n\u5728\u7D93\u6B77\u4E86\u907F\u96E3\u5EC4
      Pi \u7684\u6230\u9B25\u4EE5\u53CA\u82F1\u514B\u96F7\u7684\u8972\u64CA\u5F8C\uFF0C\u9435\u8E44\u5931\u53BB\u4E86\u5927\u90E8\u5206\u90E8\u968A\uFF0C\u88AB\u8FEB\u4E0B\u4EE4\u653E\u68C4\u4ED6\u9435\u9A0E\u885B\u63A7\u5236\u7684\u5927\u90E8\u5206\u9818\u571F\uFF0C\u5C08\u6CE8\u65BC\u4FDD\u885B\u5F7C\u6B64\u9644\u8FD1\u7684\u95DC\u9375\u5730\u9EDE\u3002\u9019\u7D66\u4E86\u4ED6\u7684\u6575\u4EBA\u4E00\u500B\u5598\u606F\u7684\u6A5F\u6703\uFF0C\u51B7\u7738\u5269\u4E0B\u7684\u90E8\u968A\u6293\u4F4F\u4E86\u9019\u500B\u6A5F\u6703\u3002\u5728\u65B0\u6307\u63EE\u5B98\u8056\u7130\u7684\u5E36\u9818\u4E0B\u91CD\u65B0\u7D44\u7E54\u8D77\u4F86\uFF0C\u958B\u59CB\u4E86\u5927\u898F\u6A21\u7684\u9032\u653B\u3002\u5F9E\u90A3\u4E00\u523B\u8D77\uFF0C\u9435\u8E44\u4E0D\u5F97\u4E0D\u653E\u68C4\u64CA\u6557\u4ED6\u5011\u7684\u5FF5\u982D\uFF0C\u91CD\u65B0\u56DE\u5230\u4E86\u4E00\u5834\u75DB\u82E6\u7684\u9663\u5730\u6230\u3002\n\u5118\u7BA1\u5B88\u671B\u8005\u4E0D\u907A\u9918\u529B\u5730\u52AA\u529B\u7DAD\u8B77\u806F\u76DF\uFF0C\u4F46\u4ED6\u5011\u4E00\u6B21\u53C8\u4E00\u6B21\u5730\u906D\u53D7\u5931\u6557\u3002\u7576\u4ED6\u5011\u767C\u73FE\u4FE1\u4EFB\u548C\u4E92\u52A9\u7684\u5E7C\u82D7\u6700\u7D42\u5DF2\u7D93\u51CB\u96F6\u6642\uFF0C\u4ED6\u958B\u59CB\u5C07\u81EA\u5DF1\u7684\u52AA\u529B\u96C6\u4E2D\u5728\u5E6B\u52A9\u5176\u4ED6\u672A\u77E5\u7684\u5C0F\u99AC\u548C\u5C0F\u99AC\u570B\u5176\u4ED6\u5730\u65B9\u7684\u52E2\u529B\u4E0A\u3002\u7136\u800C\uFF0C\u4ED6\u6C92\u6709\u5FD8\u8A18\u65E9\u5148\u6CE8\u610F\u5230\u7684\u5169\u500B\u907F\u96E3\u5EC4
      Pi \u5C45\u6C11\u3002 @lp \u548C Velvet Remedy \u4ECD\u8207\u5B88\u671B\u8005\u4FDD\u6301\u806F\u7E6B\uFF0C\u4ED6\u5E6B\u52A9\u4ED6\u5011\u61C9\u5C0D\u5EE2\u571F\u4E2D\u6B98\u9177\u4E14\u6BEB\u7121\u610F\u7FA9\u7684\u6230\u722D\u6240\u5E36\u4F86\u7684\u8003\u9A57\u3002\n@lp
      \u76E1\u529B\u5E6B\u52A9\u806F\u76DF\u62B5\u6297\u82F1\u514B\u96F7\u3002\u5979\u5C0D\u6BCF\u500B\u76DF\u53CB\u7684\u9632\u79A6\u505A\u51FA\u4E86\u5BF6\u8CB4\u7684\u8CA2\u737B\uFF0C\u7D93\u5E38\u6BEB\u4E0D\u754F\u61FC\u5730\u6295\u5165\u5230\u524D\u7DDA\u3002\u7136\u800C\uFF0C\u9019\u6A23\u4E00\u500B\u660E\u4EAE\u4F46\u77ED\u66AB\u7684\u806F\u76DF\u7684\u74E6\u89E3\u5C0D\u5979\u7684\u5FC3\u9748\u9020\u6210\u4E86\u5DE8\u5927\u7684\u6253\u64CA\u3002\u5979\u539F\u672C\u5E0C\u671B\uFF0C\u6B63\u5982\u707D\u5384\u6240\u9810\u8A00\u7684\uFF0C\u5979\u7684\u4F8B\u5B50\u80FD\u5920\u6210\u70BA\u806F\u76DF\u4E4B\u9593\u53CB\u8ABC\u7684\u57FA\u790E\uFF0C\u540C\u6642\u4E5F\u5E0C\u671B\u80FD\u5920\u62EF\u6551\u8A31\u591A\u5728\u5C0D\u6297\u5929\u99AC\u6642\u6B7B\u4EA1\u7684\u5C0F\u99AC\u3002\u610F\u8B58\u5230\u81EA\u5DF1\u7121\u529B\u963B\u6B62\u7531\u81EA\u5DF1\u5F15\u8D77\u7684\u5C60\u6BBA\u548C\u5E6B\u52A9\u81EA\u5DF1\u7684\u5BB6\u5712\u4E4B\u4E0B\uFF0C
      @lp \u7684\u9748\u9B42\u9010\u6F38\u9677\u5165\u4E86\u6CAE\u55AA\u548C\u7D55\u671B\u4E4B\u4E2D\u3002\u7136\u800C\u5979\u4E0D\u6703\u8F15\u6613\u653E\u68C4\u3002\u5145\u6EFF\u4E86\u53AD\u4E16\u7684\u6C7A\u5FC3\u548C\u82E6\u6F80\u7684\u6ECB\u5473\uFF0C
      @lp \u7E7C\u7E8C\u8207\u6575\u4EBA\u4F5C\u6230\uFF0C\u4E0D\u7BA1\u662F\u5929\u99AC\u3001\u5974\u96B8\u8CA9\u5B50\u9084\u662F\u9435\u9A0E\u885B\u3002\u5373\u4F7F\u662F\u5979\u81EA\u5DF1\uFF0C\u4E5F\u7121\u6CD5\u8AAA\u51FA\u70BA\u4EC0\u9EBC\uFF1A\u662F\u70BA\u4E86\u8D16\u7F6A\uFF0C\u9084\u662F\u70BA\u4E86\u64B2\u6EC5\u5979\u5167\u5FC3\u6B63\u5728\u6ECB\u9577\u7684\u61A4\u6012\u4E4B\u706B\uFF0C\u70BA\u9019\u500B\u6B98\u9177\u3001\u4E0D\u516C\u548C\u7D55\u671B\u7684\u4E16\u754C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435885
    m_Localized: "\u5118\u7BA1 @lp \u8868\u73FE\u51FA\u5805\u5B9A\u7684\u52C7\u6C23\u548C\u7531\u907F\u96E3\u5EC4
      Pi \u79D1\u5B78\u5BB6\u5275\u9020\u7684\u76D4\u7532\u7684\u529B\u91CF\uFF0C\u4F46\u5979\u6700\u7D42\u5728\u8207\u82F1\u514B\u96F7\u58EB\u5175\u7684\u4E0D\u5E73\u7B49\u6230\u9B25\u4E2D\u589C\u843D\u3002\u5979\u5728\u907F\u96E3\u5EC4
      Pi \u7684\u6230\u9B25\u4E2D\u9663\u4EA1\uFF0C\u6C7A\u5B9A\u4E86\u6574\u5834\u6230\u722D\u7684\u7D50\u5C40\u3002\u6C92\u6709\u5979\u5728\u8207\u96F7\u9706\u4E4B\u9996\u6230\u9B25\u4E2D\u7684\u5E6B\u52A9\uFF0C\u76DF\u53CB\u5011\u6C92\u6709\u8DB3\u5920\u7684\u5BE6\u529B\u596A\u53D6\u7A7A\u4E2D\u8981\u585E\uFF0C\u6700\u7D42\u88AB\u5929\u99AC\u7684\u58D3\u5012\u6027\u706B\u529B\u6467\u6BC0\u3002\n\u4F46\u9019\u4E0D\u50C5\u50C5\u610F\u5473\u8457\u5931\u53BB\u4E86\u907F\u96E3\u5EC4
      Pi \u3002\u7531\u65BC\u7814\u7A76\u8A2D\u65BD\u7684\u6BC0\u6EC5\u800C\u5F15\u767C\u7684\u5831\u5FA9\u6027\u884C\u52D5\u201C\u5FA9\u4EC7\u201D\uFF0C\u5728\u5EE2\u571F\u7684\u5730\u8868\u8086\u8650\uFF0C\u6467\u6BC0\u4E86\u6240\u6709\u986F\u8457\u7684\u65B0\u8208\u6587\u660E\u5CF6\u5DBC\u3002
      \u201C\u9A30\u98DB\u5C0F\u99AC\u71DF\u5730\u201D\u5316\u70BA\u7070\u71FC\uFF0C\u9435\u8E44\u9435\u9A0E\u885B\u7684\u57FA\u5730\u548C\u5821\u58D8\u5728\u6FC0\u70C8\u800C\u77ED\u66AB\u7684\u62B5\u6297\u4E4B\u5F8C\u4E00\u500B\u63A5\u4E00\u500B\u5012\u4E0B\u3002\u5728\u5E7E\u767E\u82F1\u91CC\u5167\u7684\u5176\u4ED6\u4E3B\u8981\u805A\u5C45\u5730\u4E5F\u90FD\u906D\u53D7\u4E86\u5927\u5929\u99AC\u82F1\u514B\u96F7\u7121\u60C5\u7684\u61A4\u6012\uFF0C\u4ED6\u5011\u7684\u5C45\u6C11\u751A\u81F3\u4E0D\u660E\u767D\u662F\u4EC0\u9EBC\u5C0E\u81F4\u4E86\u9019\u7A2E\u5831\u5FA9\u884C\u52D5\u3002\u7576\u5929\u99AC\u5011\u56DE\u5230\u96F2\u5C64\u5F8C\uFF0C\u5EE2\u571F\u4E2D\u6C92\u6709\u4EFB\u4F55\u4E00\u5339\u5C0F\u99AC\u80FD\u5920\u5718\u7D50\u5016\u5B58\u8005\uFF0C\u800C\u865B\u5F31\u800C\u5206\u6563\u7684\u5C0F\u99AC\u7FA4\u9AD4\u4E00\u500B\u63A5\u4E00\u500B\u88AB\u63A0\u596A\u8005\u3001\u5974\u96B8\u4E3B\u548C\u66F4\u7CDF\u7684\u751F\u7269\u6495\u88C2\u958B\u4F86\u3002\n\u904E\u4E86\u5E7E\u5E74\u5F8C\uFF0C\u5C0F\u99AC\u570B\u7684\u9019\u500B\u5730\u5340\u5E7E\u4E4E\u5B8C\u5168\u6C92\u6709\u667A\u6167\u751F\u7269\u3002\u9664\u4E86\u96B8\u5C6C\u65BC\u76E4\u8E1E\u5728\u9019\u88E1\u9032\u884C\u524D\u6230\u6642\u57FA\u5730\u548C\u5009\u5EAB\u7814\u7A76\u548C\u63A0\u596A\u7684\u5929\u99AC\uFF0C\u6C92\u6709\u5176\u4ED6\u751F\u7269\u5C45\u4F4F\u5728\u9019\u4E9B\u5730\u65B9\u4E86..."
    m_Metadata:
      m_Items: []
