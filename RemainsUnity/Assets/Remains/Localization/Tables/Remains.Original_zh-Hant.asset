    m_Localized: "\u9019\u662F\u4E00\u5834\u5C60\u6BBA\uFF0C@lp. \u53EF\u6015\u7684\u5C60\u6BBA.
      \u4E5F\u8A31\u5929\u99AC\u5C0D\u4F60\u61F7\u6709\u6575\u610F\uFF0C\u4F46\u662F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824312
    m_Localized: "\u6211\u5011\u4E0D\u80FD\u8CAC\u602A\u5979\u7684\u6240\u4F5C\u6240\u70BA\uFF0C\u8587\u8587\uFF01
      \u4E00\u5207\u90FD\u8868\u660E\u8AC7\u5224\u662F\u4E0D\u53EF\u80FD\u7684. \u5728\u7D93\u6B77\u4E86\u5EE2\u571F\u7684\u6050\u6016\u4E4B\u5F8C\uFF0C\u7279\u5225\u5728\u5979\u5E79\u7684\u90A3\u4E9B\u4E8B\u5F8C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824313
    m_Localized: "\"\u7279\u5225\u5728\u5979\u5E79\u7684\u90A3\u4E9B\u4E8B\u5F8C\"\u552F\u4E00\u9700\u8981\u7684\u5C31\u662F\u8B39\u614E\uFF01
      \u4F60\u4E0D\u660E\u767D\u5F8C\u679C\u55CE\uFF1F \u9019\u9EBC\u591A\u5C0F\u99AC\u7684\u6B7B\u4E0D\u8B93\u4F60\u64D4\u5FC3\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824314
    m_Localized: "\u6211\u5DF2\u7D93\u770B\u5230\u4E86\u8DB3\u5920\u591A\u66F4\u7CDF\u7684\u884C\u52D5\u4E26\u53EF\u4EE5\u5C0D\u5F62\u52E2\u505A\u51FA\u5408\u7406\u7684\u4F30\u8A08\uFF0C\u5C0F\u59D0\uFF01
      \u5979\u7684\u6C7A\u5B9A\u662F\u6709\u9053\u7406\u7684\uFF01 \u6211\u5011\u6C92\u6709\u9810\u6E2C\u5F8C\u679C\u662F\u6211\u5011\u7684\u932F.
      \u73FE\u5728\u4E0D\u662F\u6495\u6389\u4F60\u7684\u9B03\u6BDB\u7684\u6642\u5019.\u662F\u6642\u5019\u884C\u52D5\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824315
    m_Localized: "\u62DC\u8A17... \u6211\u77E5\u9053\u6211\u505A\u4E86\u4EC0\u9EBC.
      \u6211\u72AF\u4E86\u4E00\u500B\u932F\u8AA4\uFF0C\u8D70\u5F97\u592A\u9060\u4E86.
      \u4F46... \u6211\u5C31\u662F\u4E0D\u80FD\u9019\u6A23\u505A.\n\u5B88\u671B\u8005\u662F\u5C0D\u7684.
      \u6211\u5011\u9700\u8981\u63A1\u53D6\u884C\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824316
    m_Localized: "\u6211\u5011\u5FC5\u9808\u628A\u767C\u751F\u7684\u4E8B\u901A\u77E5\u6240\u6709\u5C0F\u99AC.
      \u96C6\u5408\u6240\u6709\u5C0F\u99AC\u5C31\u80FD. \u6230\u722D\u5373\u5C07\u4F86\u81E8\uFF0C\u6211\u5011\u7684\u6642\u9593\u4E0D\u591A\u4E86.\n\u5728\u90A3\u88E1\uFF0C\u4F60\u5728\u57FA\u5730\u6BBA\u6B7B\u7684\u5C0F\u99AC\u6BD4\u5341\u5E7E\u500B\u82F1\u514B\u96F7\u58EB\u5175\u591A\u5F97\u591A\uFF0C@lp.
      \u591A\u7206\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824317
    m_Localized: "\u8587\u8587\uFF01 \u59B3\u4E0D\u61C9\u8A72\u505A\u51FA\u9019\u6A23\u7684\u6307\u8CAC.\n\u6211\u5DF2\u7D93\u5728\u52AA\u529B\u901A\u77E5\u5730\u8868\u5B9A\u5C45\u9EDE\u4E86.
      \u800C\u59B3\uFF0C@lp\uFF0C\u5FC5\u9808\u8B66\u544A\u9867\u554F. \u4E26\u7D66\u4ED6\u795E\u5668.
      \u6216\u8A31\u4ED6\u5C31\u80FD\u5920\u5B8C\u6210 \"\u592A\u967D\" \u548C \"\u5F69\u8679\"
      \u9805\u76EE. \u4E5F\u8A31\u4ED6\u751A\u81F3\u6703\u540C\u610F\u5E6B\u52A9\u6211\u5011."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824318
    m_Localized: "\u5C0D\u4E0D\u8D77@lp\uFF0C\u4F46\u6211\u6703\u7559\u4E0B\u4F86\u5E6B\u52A9\u5B88\u671B\u8005.
      \u4E0D\u7BA1\u6211\u591A\u9EBC\u60F3\u548C\u4F60\u4E00\u8D77\u56DE\u5BB6\uFF0C\u4F46\u6211\u7684\u80FD\u529B\u5728\u9019\u88E1\u66F4\u91CD\u8981."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824319
    m_Localized: "\u597D\u7684. \u90A3\u6211\u99AC\u4E0A\u51FA\u767C.\n...\n\u539F\u8AD2\u6211\uFF0C\u8587\u8587.
      \u6211... \u6211\u8A66\u8457\u548C\u5E73\u76F8\u8655\u904E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824320
    m_Localized: "\u6C92\u5FC5\u8981\u5411\u6211\u9053\u6B49. \u59B3\u6703\u5C0D\u81EA\u5DF1\u8CA0\u8CAC\u4EFB.
      \u5F9E\u4F86\u90FD\u6C92\u6709\u54EA\u5339\u5C0F\u99AC\u80FD\u50CF\u59B3\u4E00\u6A23\u56B4\u683C\u8981\u6C42\u904E\u81EA\u5DF1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824321
    m_Localized: "\u7136\u800C\uFF0C@lp\uFF0C\u5373\u4F7F\u59B3\u5C60\u6BBA\u4E86\u57FA\u5730\u88E1\u7684\u6BCF\u4E00\u5339\u5C0F\u99AC\uFF0C\u59B3\u9084\u662F\u9952\u904E\u6295\u964D\u7684\u6307\u63EE\u5B98."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824322
    m_Localized: "\u662F\u7684\uFF0C\u6211\u9952\u4E86\u4ED6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824323
    m_Localized: "\u5728\u767C\u751F\u4E86\u9019\u4E00\u5207\u4E4B\u5F8C\uFF0C\u53EA\u5411\u524D\u9081\u51FA\u4E86\u4E00\u6B65.
      \u4F46\u9019\u4E00\u6B65\u633D\u6551\u4E86\u4E00\u5339\u5C0F\u99AC\u7684\u547D.
      \u4E5F\u8A31\u4E0D\u53EA\u662F\u4E00\u500B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824324
    m_Localized: "\u59B3\u53EF\u80FD\u72AF\u4E86\u4E00\u500B\u932F\u8AA4\uFF0C@lp\uFF0C\u4F46\u9019\u500B\u52D5\u4F5C\u8AAA\u660E\u4E86\u5F88\u591A\u95DC\u65BC\u59B3\u7684\u4E8B\u60C5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824325
    m_Localized: "\u59B3\u6BBA\u6B7B\u7684\u6307\u63EE\u5B98... \u4ED6\u6295\u964D\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824326
    m_Localized: "\u662F\u7684. \u6211\u6BBA\u4E86\u4ED6\u662F\u56E0\u70BA... \u6211\u4E0D\u77E5\u9053.
      \u6211\u4EE5\u70BA\u5B83\u6703\u89E3\u6C7A\u4E00\u4E9B\u554F\u984C. \u6211\u7576\u6642\u4E0D\u592A\u660E\u767D\u6211\u5728\u505A\u4EC0\u9EBC.
      \u800C\u6211\u4E0D\u76F8\u4FE1\u4ED6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824327
    m_Localized: "\u7576\u5B88\u671B\u8005\u8AAA\u4F60\u6709\u9019\u7A2E\u66B4\u529B\u7684\u539F\u56E0\u6642,\u6211\u4E0D\u76F8\u4FE1\u4ED6\u662F\u5C0D\u7684.
      \u4F46\u662F\uFF0C\u4ECD\u7136\u6709\u59B3\u4E0D\u61C9\u8A72\u8DE8\u8D8A\u7684\u754C\u7DDA."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824328
    m_Localized: "\u56DE\u5BB6"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824329
    m_Localized: "\u6211\u600E\u6A23\u624D\u80FD\u56DE\u5230\u907F\u96E3\u5EC4 Pi
      \u5462\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824330
    m_Localized: "\u9019\u6BD4\u59B3\u60F3\u50CF\u7684\u8981\u5BB9\u6613\u5F97\u591A.
      MAS \u7DCA\u6025\u6551\u63F4\u7CFB\u7D71\u7D42\u7AEF\u5167\u7F6E\u7684\u50B3\u9001\u7CFB\u7D71\u5C07\u5E36\u59B3\u56DE\u5BB6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824331
    m_Localized: "MAS\u7DCA\u6025\u6551\u63F4\u7CFB\u7D71\u7D42\u7AEF\uFF1F \u90A3\u9EBC\u7C21\u55AE\uFF1F\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824332
    m_Localized: "\u5443... \u4E5F\u8A31\u4E0D\u662F\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824333
    m_Localized: "\u6211\u53EA\u80FD\u50B3\u9001\u5230\u6211\u4E4B\u524D\u6240\u5728\u7684\u5730\u65B9.
      \u6211\u5B8C\u5168\u4E0D\u77E5\u9053\u6211\u7684\u5BB6\u5728\u54EA\u88E1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824334
    m_Localized: "\u59B3\u4E0D\u9700\u8981\u5B83\u7684\u5750\u6A19\u624D\u80FD\u56DE\u5BB6.
      \u59B3\u6240\u9700\u8981\u7684\u53EA\u662F\u4E00\u500B\u771F\u6B63\u6301\u6709\u8005\u7684
      PipBuck\uFF0C\u5B83\u5167\u7F6E\u907F\u96E3\u5EC4 Pi \u7684\u5B58\u53D6\u4EE3\u78BC.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824335
    m_Localized: "\u6211\u6709\u9019\u4E9B\u4EE3\u78BC\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824336
    m_Localized: "\u4E0D. \u4F46\u6211\u6709. \u73FE\u5728\uFF0C\u5B83\u5011\u6B63\u88AB\u8F49\u79FB\u5230\u59B3\u7684
      PipBuck. \u518D\u7B49\u4E00\u6703\u5152... \u53EF\u4EE5\u4E86. \u73FE\u5728\u60A8\u53EF\u4EE5\u4F7F\u7528
      PipBuck \u5730\u5716\u56DE\u5BB6\u4E86. \u4E5F\u8A31\u6211\u5011\u9084\u6703\u518D\u898B\u9762\uFF0C@lp"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824337
    m_Localized: "\u7B49\u4E00\u4E0B\uFF01 \u4F60\u5F9E\u4F86\u6C92\u6709\u544A\u8A34\u6211\u4F60\u7684\u771F\u5BE6\u8EAB\u4EFD.
      \u5982\u679C\u60A8\u4E0D\u662F\u907F\u96E3\u5EC4 Pi \u7684\u5C45\u6C11\uFF0C\u90A3\u9EBC\u4F60\u8207\u907F\u96E3\u5EC4\u6709\u4EC0\u9EBC\u95DC\u4FC2\uFF1F
      \u4F60\u548C\u9867\u554F\u53C8\u662F\u4EC0\u9EBC\u95DC\u4FC2\uFF0C\u4F60\u662F\u5F9E\u54EA\u88E1\u7372\u5F97\u5B58\u53D6\u4EE3\u78BC\u4EE5\u53CA\u60A8\u544A\u8A34\u6211\u7684\u6240\u6709\u4FE1\u606F\uFF1F
      \u6211\u6709\u6B0A\u77E5\u9053\uFF0C\u4F60\u4E0D\u89BA\u5F97\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824338
    m_Localized: "\u662F\u7684\uFF0C\u6211\u5011\u771F\u7684\u61C9\u8A72\u77E5\u9053.
      \u4FE1\u4EFB\u5FC5\u9808\u662F\u76F8\u4E92\u7684\uFF0C\u5C0D\u5427\uFF1F \u4F60\u5C0D\u6211\u5011\u5F88\u4E86\u89E3\uFF0C\u4F46\u6211\u4E0D\u80FD\u8AAA\u6211\u5011\u5C0D\u4F60\u4E00\u7121\u6240\u77E5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824339
    m_Localized: "*** \u6A5F\u68B0\u7CBE\u9748\u767C\u51FA\u5947\u602A\u7684\u8072\u97F3.
      \u597D\u50CF\u5C0D\u8A71\u90A3\u982D\u7684\u67D0\u500B\u5C0F\u99AC\u6DF1\u5438\u4E86\u4E00\u53E3\u6C23
      ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824340
    m_Localized: "\u90A3\u597D.. \u59B3\u5011\u662F\u5C0D\u7684\uFF0C\u6211\u6703\u544A\u8A34\u59B3\u5011\u95DC\u65BC\u6211\u81EA\u5DF1\u7684\u4E8B.
      \u5C31\u4E00\u9EDE\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824341
    m_Localized: "\u95DC\u65BC\u6211\u59B3\u5011\u61C9\u8A72\u77E5\u9053\u7684\u6700\u4E0D\u5C0B\u5E38\u7684\u4E8B\u60C5\u662F\u6211\u662F\u4E00\u689D\u9F8D."
    m_Metadata:
      m_Items: []
