    m_Localized: "\u8A18\u61B6\u9B54\u6CD5\uFF1F \u6211\u600E\u9EBD\u6703\u540C\u610F\u9019\u6A23\uFF1F
      \u4F46\u9304\u97F3\u4E0A\u78BA\u5BE6\u662F\u6211\u7684\u8072\u97F3\uFF0C\u5982\u679C\u6211\u5C0D\u8457\u9019...\u9867\u554F\u76F8\u7576\u6709\u4FE1\u5FC3\uFF0C\u90A3\u9EBD\u4E00\u5B9A\u6709\u500B\u9069\u7576\u7684\u7406\u7531."
