    m_Localized: "[\u907F\u96E3\u5EC4] - \u5C08\u70BA\u9577\u671F\u4F7F\u7528\u800C\u8A2D\u8A08\u7684\u5168\u81EA\u52D5\u5730\u4E0B\u5E87\u8B77\u6240.
