  - m_Id: 2737824389
    m_Localized: "\u7576\u7136\uFF0C\u9019\u662F\u6211\u7684\u5C08\u9577\uFF0C\u6211\u9084\u80FD\u505A\u4EC0\u9EBC\u5462\uFF1F
      \u6211\u7B49\u4E0D\u53CA\u53EF\u4EE5\u958B\u59CB\u4F7F\u7528\u91CF\u5B50\u88DC\u511F\u5668.
      \u9019\u662F\u771F\u6B63\u7684\u5947\u8E5F\uFF0C\u662F\u79D1\u6280\u7684\u52DD\u5229.
      \u7576\u5C0E\u5E2B\u544A\u8A34\u6211\u5011\u4F60\u6210\u529F\u7372\u5F97\u4E86\u5B83\u6642\uFF0C\u6211\u5E7E\u4E4E\u8981\u760B\u4E86\uFF01
      \u5766\u767D\u5730\u8AAA\uFF0C\u6211\u6839\u672C\u4E0D\u76F8\u4FE1\u4F60\u7684\u6210\u529F\uFF0C\u6839\u64DA\u6211\u7684\u8A08\u7B97\uFF0C\u5B83\u7684\u6210\u529F\u7387\u662F3720\u5230..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824390
    m_Localized: "\u95DC\u65BC\u6A5F\u7387\u7684\u8A0E\u8AD6\u5DF2\u7D93\u5920\u591A\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824391
    m_Localized: "\u563F\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824392
    m_Localized: "\u66F4\u597D\u5730\u89E3\u91CB\u88DC\u511F\u5668\u5728 \"\u592A\u967D\"
      \u9805\u76EE\u4E2D\u626E\u6F14\u7684\u89D2\u8272\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824393
    m_Localized: "\u59B3\u4EC0\u9EBC\u610F\u601D\uFF0C\u4EC0\u9EBC\u89D2\u8272\uFF1F
      \u9019\u6709\u52A9\u65BC\u5C07 \"\u5F69\u8679\" \u5916\u9AA8\u9ABC\u7684\u4F7F\u7528\u8005\u8B8A\u6210\u8D85\u7D1A\u58EB\u5175.
      \u5B83\u80FD\u8A55\u4F30\u6230\u5834\u4E0A\u7684\u60C5\u51B5\uFF0C\u76F4\u81F3\u6BCF\u9846\u5B50\u5F48\u7684\u53EF\u80FD\u8ECC\u8DE1\u548C\u6BCF\u500B\u6575\u99AC\u7684\u5F31\u9EDE.
      \u5B83\u5C07\u8A08\u7B97\u5982\u4F55\u79FB\u52D5\uFF0C\u5982\u4F55\u7784\u6E96\uFF0C\u5982\u4F55\u63A7\u5236\u5730\u9762\u548C\u7A7A\u4E2D\u7684\u6BCF\u500B\u52D5\u4F5C\uFF0C\u4E26\u9810\u6E2C\u6BCF\u500B\u6575\u99AC\u7684\u79FB\u52D5.
      \u5B83\u5C31\u50CF S.A.T.S. \u4E00\u6A23\uFF0C\u53EA\u6709\u4E00\u5343\u500D\u7684\u9177\uFF0C\u4E00\u5207\u90FD\u662F\u5BE6\u6642\u5DE5\u4F5C\u7684\uFF01
      \u6211\u5011\u5DF2\u7D93\u64C1\u6709\u4E86\u6240\u6709\u7684\u7B97\u6CD5\uFF0C\u6211\u5011\u53EA\u9700\u8981\u4E00\u500B\u975E\u5E38\u5F37\u5927\u7684\u8655\u7406\u5668."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824394
    m_Localized: "\u4E0D\u7981\u60F3\u5230\u8207\u9019\u6A23\u7684\u6575\u99AC\u4F5C\u6230\u662F\u4EC0\u9EBC\u611F\u89BA\uFF0C\u6211\u4E0D\u5BD2\u800C\u6144\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824395
    m_Localized: "\u55EF... \u53EA\u6709\u4E00\u500B\u91CF\u5B50\u88DC\u511F\u5668\u7684\u4EFF\u88FD\u54C1\uFF0C\u4EFB\u4F55\u5730\u65B9\u90FD\u4E0D\u5B58\u5728\u9019\u6A23\u7684\u4EFF\u88FD\u54C1.
      \u5B83\u5C31\u50CF\u4F60\u53E3\u888B\u88E1\u6709\u4E00\u500B\u5B8C\u6574\u7684\u4E3B\u6A5F\uFF01
      \u73FE\u5728\u6211\u5011\u6709\u4E86\u5B83\uFF0C\u6240\u4EE5\u4F60\u4E0D\u61C9\u8A72\u64D4\u5FC3\u5B83\u6703\u88AB\u6575\u99AC\u4F7F\u7528."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824396
    m_Localized: "\u5B83\u771F\u7684\u90A3\u9EBC\u7368\u7279\u55CE\uFF1F \u4E26\u8A8D\u70BA\u53EF\u4EE5\u5C07\u5B83\u7528\u4F5C\u6211
      PipBuck \u7684\u64F4\u5C55\u6A21\u7D44."
    m_Metadata:
      m_Items: []
