    m_Metadata:
      m_Items: []
  - m_Id: 2729436476
    m_Localized: "\u5728 S.A.T.S. \u4E2D\u4F7F\u7528\u4EFB\u4F55\u6B66\u5668\u9032\u884C\u653B\u64CA\u7684\u884C\u52D5\u9EDE\u6578."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436477
    m_Localized: "\u5DF2\u5B58\u6A94"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436478
    m_Localized: "\u89D2\u8272\u6B7B\u4EA1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436479
    m_Localized: "\u7E2E\u653E 100%"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436480
    m_Localized: "\u555F\u7528\u6B64\u9078\u9805\u5C07\u5728\u904A\u6232\u958B\u59CB\u6642\u5C07\u7E2E\u653E\u8A2D\u7F6E\u70BA
      100%. \u5982\u679C\u7981\u7528\uFF0C\u5247\u6BD4\u4F8B\u5C07\u8A2D\u7F6E\u70BA\u9069\u5408\u87A2\u5E55\u4E0A\u7684\u6574\u500B\u756B\u9762.
      \n\u5982\u679C\u60A8\u7684\u986F\u793A\u5668\u89E3\u6790\u5EA6\u70BA Full HD
      (1920x1080) \u6216\u66F4\u9AD8\uFF0C\u8ACB\u555F\u7528\u6B64\u9078\u9805. \n\u5C0D\u65BC\u8F03\u4F4E\u7684\u89E3\u6790\u5EA6\uFF0C\u5EFA\u8B70\u7981\u7528\u6B64\u9078\u9805\u4EE5\u6E1B\u5C11\u8655\u7406\u5668\u7684\u8CA0\u8F09.\u4E26\u63D0\u9AD8\u6027\u80FD.
      \n\u60A8\u53EF\u4EE5\u96A8\u6642\u4F7F\u7528 @1 \u9375\u66F4\u6539\u904A\u6232\u653E\u5927\u500D\u7387.
      \u5982\u679C\u756B\u9762\u4E0D\u80FD\u5BB9\u7D0D\u6574\u500B\u87A2\u5E55\uFF0C\u60A8\u53EF\u4EE5\u5728\u6309\u4F4F
      @2 \u7684\u540C\u6642\u79FB\u52D5\u756B\u9762."
    m_Metadata:
      m_Items: []
