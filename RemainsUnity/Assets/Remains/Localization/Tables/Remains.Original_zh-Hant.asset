      m_Items: []
  - m_Id: 2729435518
    m_Localized: "\u4F60\u5DF2\u7D93\u7FD2\u6163\u65BC\u88AB\u91CD\u64CA\uFF0C\u73FE\u5728\u5B83\u5011\u5C0D\u4F60\u4F86\u8AAA\u53EA\u662F\u6493\u7662\u7662\u4E86.
      \u5C0D\u920D\u5668\u7684\u50B7\u5BB3\u6297\u6027\u589E\u52A0."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435519
    m_Localized: "\u5805\u97CC\u9AD4\u819A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435520
    m_Localized: "\u4F60\u7D93\u5E38\u88AB\u5B50\u5F48\u64CA\u4E2D. \u9019\u8B93\u4F60\u66F4\u52A0\u5805\u97CC\uFF0C\u4F60\u5C0D\u5B50\u5F48\u7684\u6297\u6027\u589E\u52A0\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435521
    m_Localized: "\u5DE8\u70AE\u8001\u8E44"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435522
    m_Localized: "\u4F60\u559C\u6B61\u5927\u69CD\u5DE8\u70AE\uFF0C\u4F60\u975E\u5E38\u7FD2\u6163\u65BC\u4F7F\u7528\u5B83\u5011\u4EE5\u81F3\u65BC\u8B93\u5FFD\u7565\u4E86\u4ED6\u5011\u7684\u91CD\u91CF."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435523
    m_Localized: "\u5FEB\u901F\u88DD\u5F48"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435524
    m_Localized: "\u4F60\u88DD\u5F48\u7684\u901F\u5EA6\u6BD4\u4EE5\u524D\u5FEB\u5169\u500D\u4E86.
      \u9019\u662F\u4E00\u500B\u975E\u5E38\u5927\u7684\u512A\u52E2\uFF01 \u4F60\u88DD\u5F48\u8D8A\u5FEB\u88AB\u6BBA\u7684\u5E7E\u7387\u8D8A\u5C0F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435525
    m_Localized: "\u6DD8\u91D1\u8005"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435526
    m_Localized: "\u4F60\u6709\u4E00\u500B\u611B\u597D\uFF0C\u7E3D\u8981\u641C\u522E\u8DEF\u4E0A\u7684\u6BCF\u4E00\u500B\u5783\u573E\u6876\uFF0C\u56E0\u6B64\u4F60\u7E3D\u80FD\u627E\u5230\u66F4\u591A\u7684\u74F6\u84CB\u548C\u4E00\u4E9B\u6230\u524D\u8CA8\u5E63."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435527
    m_Localized: "\u5FC3\u7D30\u5982\u91DD"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435528
    m_Localized: "\u4F60\u61C2\u5F97\u5728\u958B\u9396\u7684\u6642\u5019\u8981\u842C\u5206\u5C0F\u5FC3.
      \u4EE5\u9632\u5931\u6557\uFF0C\u4F60\u958B\u9396\u65B7\u91DD\u7684\u6A5F\u7387\u6E1B\u5C11\u5169\u6B21\uFF0C\u4E26\u4E14\u9396\u82AF\u88AB\u7834\u58DE\u7684\u6B21\u6578\u6E1B\u5C11
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435529
    m_Localized: "\u8D85\u7D1A\u9ED1\u5BA2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435530
    m_Localized: "\u4F60\u662F\u4E00\u500B\u975E\u5E38\u9177\u7684\u9ED1\u5BA2\uFF0C\u9023\u5B89\u4FDD\u7CFB\u7D71\u90FD\u70BA\u4F60\u591A\u63D0\u4F9B\u4E86\u5BC6\u78BC\u5617\u8A66\u7684\u6A5F\u6703\uFF08#1
      \u800C\u4E0D\u662F#2\uFF09\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435531
    m_Localized: "\u5FEB\u901F\u4EE3\u8B1D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435532
    m_Localized: "\u4F60\u8EAB\u9AD4\u5C0D\u5316\u5B78\u85E5\u54C1\u7684\u5438\u6536\u901F\u5EA6\u8D85\u904E\u5E73\u5747\u6C34\u5E73.
      \u56E0\u6B64\u63D0\u9AD8\u6CBB\u7642\u85E5\u6C34\u5C0D\u4F60\u7684 #1 \u6548\u679C\u8207
      #2 \u500D\u7684\u6062\u5FA9\u901F\u5EA6."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435533
    m_Localized: "\u7279\u52E4\u5C0F\u99AC"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435534
    m_Localized: "\u4F60\u5F9E\u4E0D\u7336\u8C6B\uFF0C\u7E3D\u662F\u5F9E\u5BB9\u884C\u52D5.
      \u4F60\u6BCF\u4E00\u7B49\u7D1A\u6B64\u6280\u80FD\u80FD\u5728S.A.T.S.\u7372\u5F97\u984D\u5916\u7684
      #1 \u9EDE\u884C\u52D5\u9EDE\u6578( #2 \u7684\u521D\u59CB\u503C)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435535
    m_Localized: "\u6606\u87F2\u5B78\u5BB6"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435536
    m_Localized: "\u4F60\u7E3D\u662F\u5C0D\u6606\u87F2\uFF0C\u8718\u86DB\u548C\u5176\u4ED6\u7BC0\u80A2\u52D5\u7269\u975E\u5E38\u611F\u8208\u8DA3\uFF0C\u4F60\u4E5F\u4E86\u89E3\u4ED6\u5011\u7684\u5F31\u9EDE.
      \u589E\u52A0\u4F60 #1 \u5C0D\u8F3B\u5C04\u87D1\u8782\uFF0C\u8F3B\u5C04\u880D\uFF0C\u8089\u98DF\u9748\u7B49\u985E\u4F3C\u751F\u7269\u7684\u50B7\u5BB3."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435537
    m_Localized: "\u5F31\u9EDE\u89E3\u6790"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435538
    m_Localized: "\u4F60\u975E\u5E38\u4E86\u89E3\u5C0F\u99AC\u89E3\u5256\u5B78\uFF0C\u7E3D\u662F\u7784\u6E96\u8981\u5BB3.
      \u4F60\u5C0D\u52AB\u63A0\u8005\u548C\u5176\u4ED6\u99AC\u578B\u6575\u65B9\u9020\u6210\u7684\u50B7\u5BB3\u589E\u52A0
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435539
    m_Localized: "\u6A5F\u5668\u5C08\u5BB6"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435540
    m_Localized: "\u4F60\u6E05\u695A\u4EFB\u4F55\u6A5F\u5668\u99AC\u7684\u7D50\u69CB\u5716\uFF0C\u800C\u4E14\u7E3D\u662F\u7784\u6E96\u5B83\u5011\u7684\u5F31\u9EDE.
      \u4F60\u5C0D\u6A5F\u5668\u99AC\u548C\u70AE\u5854\u7684\u50B7\u5BB3\u589E\u52A0
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435541
    m_Localized: "\u6E05\u9053\u592B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435542
    m_Localized: "\u4F60\u5805\u4FE1\u5EE2\u571F\u4E0A\u7684\u602A\u7269\u548C\u8B8A\u7570\u91CE\u7378\u5FC5\u9808\u88AB\u6D88\u6EC5.
      \u4F60\u5C0D\u91CE\u751F\u98DF\u5C4D\u9B3C\u548C\u7A81\u8B8A\u751F\u7269\u7684\u50B7\u5BB3\u589E\u52A0
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435543
    m_Localized: "\u79FB\u52D5\u9776\u8E44"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435544
    m_Localized: "\u4F60\u5DF2\u7D93\u5B78\u6703\u4E86\u5373\u4F7F\u5728\u8DD1\u6B65\u6216\u8005\u4E0D\u7A69\u5B9A\u7684\u4F4D\u7F6E\u4E0B\u4E5F\u80FD\u6E96\u78BA\u7784\u6E96\u5C04\u64CA.
      \u5728\u5954\u8DD1\u6642\u5C04\u64CA\u7684\u6E96\u78BA\u5EA6\u964D\u4F4E\u5230
      #1\uFF08\u57FA\u672C\u964D\u4F4E\u503C #2\uFF09\uFF0C\u8DF3\u8E8D\u6216\u722C\u6A13\u68AF\u6642\u5C04\u64CA\u7684\u6E96\u78BA\u5EA6\u964D\u4F4E\u5230
      #3\uFF08\u57FA\u672C\u964D\u4F4E\u503C #4\uFF09. \u4F46\u5728S.A.T.S\u4E2D\u4E0D\u5F71\u97FF."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435545
    m_Localized: "\u6C88\u8457\u51B7\u975C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435546
    m_Localized: "\u4F60\u5728\u6230\u9B25\u4E2D\u4FDD\u6301\u51B7\u975C\uFF0C\u66F4\u559C\u6B61\u6709\u7CFB\u7D71\u7684\u5C04\u64CA\u6216\u6230\u8853\u64A4\u9000\uFF0C\u800C\u4E0D\u662F\u5306\u5FD9\u624E\u9032\u6230\u9B25.
      \u975C\u6B62\u6642\u5C04\u64CA\u6642\u7684\u6E96\u78BA\u5EA6\u52A0\u6210 #1\uFF08\u9810\u8A2D\u70BA#2\uFF09\uFF0C\u5F9E\u80CC\u5F8C\u5C04\u64CA\u7684\u6E96\u78BA\u5EA6\u640D\u5931\u6E1B\u5C11\u5230
      #3\uFF08\u9810\u8A2D\u70BA #4\uFF09. \u4F46\u5728S.A.T.S\u4E2D\u4E0D\u5F71\u97FF."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435547
    m_Localized: "\u6578\u5B78\u908F\u8F2F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435548
    m_Localized: "\u4F60\u6821\u6E96\u4E86\u4F60\u7684Pipbuck\uFF0C\u4EE5\u4FBF\u73FE\u5728
      S.A.T.S. \u4E2D\u7684\u4EFB\u4F55\u653B\u64CA. \u6D88\u8017 #1 \u66F4\u5C11\u7684\u884C\u52D5\u9EDE\u6578\uFF0C\u4E26\u4E14\u5728\u7B2C\u4E8C\u7D1A\u80FD\u529B\u4E0A\u6D88\u8017 
      - #2 \u6216\u66F4\u5C11."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435549
    m_Localized: "\u5E78\u904B\u661F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435550
    m_Localized: "\u6230\u9B25\u4E2D\u597D\u904B\u7E3D\u662F\u8207\u4F60\u76F8\u4F34.
      \u6280\u80FD\u6BCF\u5347\u4E00\u7D1A\uFF0C\u4F60\u7684\u66B4\u64CA\u50B7\u5BB3\u589E\u52A0
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435551
    m_Localized: "\u81F4\u547D\u4E00\u64CA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435552
    m_Localized: "\u4F60\u5728\u6230\u9B25\u4E2D\u88AB\u5E78\u904B\u7737\u9867\u6642\uFF0C\u4F60\u7684\u6575\u99AC\u7121\u7591\u80FD\u611F\u89BA\u5230\u4E0D\u540C\u4E4B\u8655\u7684\uFF01
      \u4F60\u4F7F\u7528\u4EFB\u4F55\u6B66\u5668\u7684\u66B4\u64CA\u50B7\u5BB3\u52A0
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435553
    m_Localized: "\u6C7A\u9B25\u8005"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435554
    m_Localized: "\u4F60\u4E0D\u559C\u6B61\u91CD\u6B66\u5668. \u4F60\u7684\u512A\u9078\u662F\u8E44\u69CD\u548C\u5DE6\u8F2A\u8E44\u69CD\uFF0C\u4E26\u4E14\u4F60\u80FD\u719F\u7DF4\u7684\u4F7F\u7528\u5B83\u5011.
      \u4F60\u6240\u6709\u7684\u8E44\u69CD(\u5305\u62EC\u81EA\u52D5\u7684)\u7CBE\u5EA6\u589E\u52A0\uFF0C\u4E26\u4E14\u5728S.A.T.S\u4E2D\u6D88\u8017
      #1 \u66F4\u5C11\u7684\u884C\u52D5\u9EDE\u6578."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435555
    m_Localized: "\u760B\u72C2\u8FB2\u5834\u4E3B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435556
    m_Localized: "\u4F60\u6700\u559C\u6B61\u7684\u6B66\u5668\u662F\u9730\u5F48\u69CD\uFF0C\u4F60\u65E9\u5DF2\u6E96\u5099\u4FDD\u8B77\u81EA\u5DF1\u548C\u81EA\u5DF1\u7684\u8CA1\u7522\u4E86\uFF0C\u7121\u8AD6\u4F86\u7684\u662F\u52AB\u63A0\u8005\uFF0C\u5F37\u76DC\uFF0C\u9084\u662F\u4E00\u968A\u7531\u9F8D\u7D44\u6210\u7684\u8ECD\u5718\uFF01
      \u4F60\u6240\u6709\u9730\u5F48\u69CD\u7372\u5F97\u7834\u7532\u6548\u679C\u4E26\u589E\u52A0\u64CA\u9000\u6548\u679C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435557
    m_Localized: "\u7A81\u64CA\u5C0F\u99AC"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435558
    m_Localized: "\u4F60\u78BA\u4FE1\u6C92\u6709\u4EFB\u4F55\u6B66\u5668\u6BD4\u7A81\u64CA\u6B65\u69CD\u66F4\u597D.
      \u4E26\u4E14\u4F60\u80FD\u5920\u719F\u7DF4\u7684\u4F7F\u7528\u5B83\u5011. \u4F60\u7684\u7A81\u64CA\u6B65\u69CD\u548C\u52A0\u7279\u6797\u7684\u5B50\u5F48\u50B7\u5BB3\u6BCF\u9846\u589E\u52A02\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435559
    m_Localized: "\u4E00\u69CD\u4E00\u500B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435560
    m_Localized: "\u4F60\u662F\u4E00\u540D\u795E\u69CD\u5C0F\u99AC\uFF0C\u7D55\u4E0D\u6703\u6D6A\u8CBB\u4E00\u9846\u5B50\u5F48.
      \u4F60\u6240\u6709\u7684\u7375\u69CD\u548C\u72D9\u64CA\u6B65\u69CD\u7684\u66B4\u64CA\u50B7\u5BB3\u589E\u52A0."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435561
    m_Localized: "\u96F7\u5C04\u8868\u6F14"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435562
    m_Localized: "\u96F7\u5C04\u6B66\u5668\u662F\u4F60\u6700\u559C\u6B61\u7684. \u4F60\u77E5\u9053\u5982\u4F55\u66F4\u597D\u7684\u4F7F\u7528\u5B83\uFF0C\u4E26\u4F7F\u5B83\u589E\u52A015%\u7684\u50B7\u5BB3."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435563
    m_Localized: "\u7B49\u96E2\u5B50\u554F\u5019"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435564
    m_Localized: "\u4F60\u559C\u6B61\u7528\u7B49\u96E2\u5B50\u6B66\u5668\u5C07\u6575\u99AC\u8B8A\u6210\u4E00\u7058\u9ECF\u7CCA.
      \u4F60\u751A\u81F3\u89E3\u6C7A\u4E86\u5B83\u7684\u7F3A\u9677\uFF0C\u6240\u4EE5\u73FE\u5728\u4F60\u4F7F\u7528\u7684\u7B49\u96E2\u5B50\u6B66\u5668\u7CBE\u5EA6\u589E\u52A0\uFF0C\u7B49\u96E2\u5B50\u5B50\u5F48\u521D\u901F\u589E\u52A0
      #1 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435565
    m_Localized: "\u7E31\u706B\u72C2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435566
    m_Localized: "\u4F60\u5F9E\u5C0F\u5C31\u559C\u6B61\u9EDE\u706B\uFF0C\u4F60\u6700\u559C\u6B61\u7684\u6C23\u5473\u662F\u77F3\u6CB9\u5473\uFF0C\u4F60\u6700\u559C\u6B61\u7684\u611B\u597D\u5C31\u662F\u770B\u8457\u6575\u99AC\u88AB\u71D2\u6210\u7070.
      \u4EFB\u4F55\u80FD\u5920\u9020\u6210\u706B\u7130\u50B7\u5BB3\u7684\u6B66\u5668(\u5305\u62EC\u8E44\u96F7)\u90FD\u6703\u8B8A\u5F97\u66F4\u5F37\u5927."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435567
    m_Localized: "\u88C2\u89E3"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435568
    m_Localized: "\u4F60\u6240\u6709\u7684\u96F7\u5C04\u548C\u7B49\u96E2\u5B50\u6B66\u5668\u90FD\u6709
      #1 \u7684\u5E7E\u7387\u5206\u89E3\u76EE\u6A19 \u2014 \u4E5F\u5C31\u662F\u8AAA\uFF0C\u5373\u4E00\u6B21\u653B\u64CA\u5B8C\u5168\u6D88\u6EC5\u76EE\u6A19(\u9019\u8B93\u6B66\u5668\u66F4\u52A0\u70AB\u9177\u4E86
      #2 )\uFF0C\u53EA\u8981\u76EE\u6A19\u751F\u547D\u503C\u6C92\u6709\u8D85\u904E\u6B66\u5668\u50B7\u5BB3\u768410\u500D."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435569
    m_Localized: "\u6B66\u5668\u4FDD\u990A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435570
    m_Localized: "\u4F60\u7E3D\u662F\u6E05\u6D17\u4E26\u7D66\u4F60\u7684\u6B66\u5668\u4E0A\u6CB9\uFF0C\u4F5C\u70BA\u56DE\u5831\uFF0C\u9019\u8B93\u4F60\u7684\u6B66\u5668\u5728\u95DC\u9375\u6642\u523B\u4E0D\u6703\u8B93\u4F60\u5931\u671B.
      \u4F60\u7834\u640D\u7684\u6B66\u5668\u7CBE\u6E96\u5EA6\u6703\u63D0\u9AD8 #1
      \u500D\uFF0C\u5373\u4F7F\u5B83\u7684\u50B7\u5BB3\u548C\u7CBE\u5EA6\u5DF2\u7D93\u964D\u4F4E\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435571
    m_Localized: "\u9069\u61C9\u6027\u4EE3\u8B1D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435572
    m_Localized: "\u4EE4\u99AC\u9A5A\u8A1D\u7684\u662F\uFF0C\u4F60\u5C45\u7136\u5F88\u597D\u5730\u9069\u61C9\u4E86\u6709\u6BD2\u4E26\u88AB\u8F3B\u5C04\u904E\u7684\u5EE2\u571F.
      \u4F60\u7372\u5F97\u4E86\u984D\u5916\u7684\u8F3B\u5C04\u6297\u6027\uFF0C\u6BD2\u7D20\u6297\u6027\u548C\u8150\u8755\u6027\u7269\u8CEA\u6297\u6027."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435573
    m_Localized: "\u8352\u91CE\u751F\u5B58"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435574
    m_Localized: "\u4F60\u77E5\u9053\u5982\u4F55\u5728\u602A\u7269\u8207\u91CE\u751F\u52D5\u7269\u4E2D\u751F\u5B58.
      \u4F60\u5C0D\u53EE\u54AC\uFF0C\u6293\u50B7\uFF0C\u5C16\u523A\uFF0C\u523A\u50B7\u548C\u6BD2\u7D20\u589E\u52A0\u4E86\u984D\u5916\u7684\u50B7\u5BB3\u6297\u6027\uFF0C\u4E26\u4E14\u6E1B\u5C11\u53D7\u50B7\u548C\u4E2D\u6BD2\u7684\u75DB\u82E6."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435575
    m_Localized: "\u8B77\u7532\u6539\u88DD"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435576
    m_Localized: "\u4F60\u77E5\u9053\u5982\u4F55\u5347\u7D1A\u4F60\u7684\u8B77\u7532\u4E26\u8B93\u5B83\u66F4\u52A0\u5B8C\u7F8E\u8CBC\u5408\uFF0C\u5F9E\u800C\u63D0\u9AD8\u5176\u6230\u9B25\u54C1\u8CEA.
      \u70BA\u6B64\u4F60\u53EA\u9700\u8981\u5DE5\u4F5C\u53F0\u548C\u5408\u9069\u7684\u6750\u6599.
      \u6BCF\u4E00\u7B49\u7D1A\u7684\u8B77\u7532\u6539\u88DD\u5141\u8A31\u4F60\u5347\u7D1A\u66F4\u9AD8\u7B49\u7D1A\u7684\u8B77\u7532."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435577
    m_Localized: "\u5FF5\u529B\u5927\u5E2B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435578
    m_Localized: "\u4F60\u5FF5\u529B\u65BD\u653E\u7684\u7BC4\u570D\u589E\u52A0\uFF0C\u4E26\u4E14\u53EF\u4EE5\u5C0D\u4F60\u8996\u91CE\u4E4B\u5916\u7684\u7269\u9AD4\u4F7F\u7528."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435579
    m_Localized: "\u62FE\u8352\u8005"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435580
    m_Localized: "\u4F60\u4EC0\u9EBD\u6771\u897F\u90FD\u820D\u4E0D\u5F97\u6254\u6389\uFF0C\u4EE5\u81F3\u65BC\u4F60\u623F\u9593\u5168\u662F\u5783\u573E\uFF0C\u5982\u679C\u4E0D\u6253\u65B7\u817F\u5C31\u5F88\u96E3\u9032\u5165.
      \u4F60\u73FE\u5728\u6BCF\u6B21\u627E\u5230\u60A8\u5DF2\u7D93\u64C1\u6709\u7684\u6B66\u5668\u6642\uFF0C\u60A8\u90FD\u6703\u7372\u5F97\u984D\u5916\u7684\u6B66\u5668\u4FEE\u7406\u96F6\u4EF6\uFF0C\u4EE5\u53CA\u66F4\u591A\u6709\u7528\u7684\uFF08\u5C0D\u4F60\u81EA\u5DF1\u6709\u7528\uFF09\u7684\u5783\u573E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435581
    m_Localized: "\u6295\u5F48\u8005"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435582
    m_Localized: "\u60A8\u5B78\u6703\u4E86\u70BA\u6240\u6709\u8E44\u96F7\u914D\u5099\u5148\u9032\u7684\u50B3\u611F\u5668\uFF0C\u73FE\u5728\u5B83\u5011\u5728\u547D\u4E2D\u6575\u99AC\u7684\u6642\u5019\u5C31\u6703\u7206\u70B8.
      (\u5982\u679C\u60F3\u4F7F\u7528\u666E\u901A\u8E44\u96F7,\u5728\u6295\u64F2\u7684\u6642\u5019\u6309\u4F4F@1)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435583
    m_Localized: "\u7A7F\u900F\u6253\u64CA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435584
    m_Localized: "\u4EFB\u4F55\u76D4\u7532\u90FD\u6709\u5F31\u9EDE\uFF0C\u4F60\u5F88\u6E05\u695A.
      \u73FE\u5728\u4F60\u4EFB\u4F55\u7528\u65BC\u5207\u5272\u7684\u6B66\u5668(\u5200\uFF0C\u528D\uFF0C\u65A7\u982D\uFF0C\u9577\u77DB\u7B49)\u90FD\u6703\u9020\u6210\u984D\u5916\u7684\u7834\u7532\u6548\u679C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435585
    m_Localized: "\u7729\u6688\u91CD\u64CA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435586
    m_Localized: "\u73FE\u5728\u4F60\u7684\u4EFB\u4F55\u920D\u5668(\u68D2\u7403\u68CD\uFF0C\u64AC\u68CD\uFF0C\u5927\u9318\u7B49)\u90FD\u6709\u6A5F\u6703\u5C0D\u6575\u99AC\u9020\u6210
      #1 \u79D2\u7684\u64CA\u6688\u6548\u679C\uFF0C\u4E26\u4E14\u589E\u5F37\u4E86\u64CA\u9000\u6548\u679C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435587
    m_Localized: "\u96F6\u9EDE\u9B54\u6CD5\u529B\u5834\u5927\u5E2B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435588
    m_Localized: "\u73FE\u5728\u4F60\u4E0D\u50C5\u80FD\u5920\u4F7F\u7528\u5FF5\u529B\u4F86\u79FB\u52D5\u7269\u9AD4\uFF0C\u9084\u53EF\u4EE5\u5C07\u7269\u9AD4\u7838\u5411\u6575\u99AC\uFF01
      \u5728\u4F7F\u7528\u5FF5\u529B\u7684\u6642\u5019\u6309\u4F4F@1\uFF0C\u4F60\u53EF\u4EE5\u7528\u91CD\u8CEA\u7BB1\u653B\u64CA\u6575\u99AC\u6216\u8005\u628A\u6575\u99AC\u649E\u5728\u7246\u4E0A.
      \u7B2C\u4E8C\u7B49\u7D1A\u53EF\u4EE5\u8B93\u4F60\u66F4\u5FEB\uFF0C\u66F4\u9060\u5730\u6295\u64F2\u7269\u9AD4.
      \u6CE8\u610F\uFF0C\u5FEB\u901F\u8F49\u79FB\u6C88\u91CD\u7684\u7269\u9AD4\u6703\u5927\u91CF\u6D88\u8017\u4F60\u7684\u9B54\u529B\u503C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435589
    m_Localized: "\u9583\u73FE\u8853"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435590
    m_Localized: "\u4F60\u53EF\u4EE5\u7ACB\u5373\u5728\u4E0D\u540C\u5730\u9EDE\u4E4B\u9593\u79FB\u52D5.
      \u8ACB\u5728\u50B3\u9001\u9B54\u6CD5\u5145\u80FD\u6642\u6309\u4F4F@1\u4F7F\u7528\uFF0C\u7136\u5F8C\u9B06\u958B\u4EE5\u57F7\u884C\u50B3\u9001.
      \u8981\u53D6\u6D88\u5DF2\u5145\u80FD\u7684\u6CD5\u8853\uFF0C\u8ACB\u6309@2.
      \u4F60\u5FC5\u9808\u80FD\u5920\u770B\u5230\u50B3\u9001\u76EE\u6A19\uFF0C\u6B64\u6280\u80FD\u6703\u6D88\u8017\u5927\u91CF\u9B54\u6CD5\u80FD\u91CF."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435591
    m_Localized: "\u85E5\u54C1\u5E2B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435592
    m_Localized: "\u7528\u4E00\u500B\u5927\u934B\uFF0C\u4E00\u500B\u84B8\u993E\u5668\u548C\u4E00\u500B\u6E6F\u584A\u82B1\u8CBB\u4E86\u7121\u6578\u500B\u5C0F\u6642\uFF0C\u7D42\u65BC\u5E36\u4F86\u4E86\u679C\u5BE6\uFF01.
      \u73FE\u5728\u4F60\u5236\u4F5C\u85E5\u6C34\u7684\u6642\u5019\u53EF\u4EE5\u7372\u5F97\u5169\u4EFD\u800C\u4E0D\u662F\u4E00\u4EFD.
      \u5C0D\u65BC\u6C38\u4E45\u6027\u6548\u679C\u7684\u85E5\u6C34\u7121\u6548."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435593
    m_Localized: "\u5F37\u529B\u8E22\u64CA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435594
    m_Localized: "\u4F60\u8D64\u8E44\u5B50\u7684\u8E22\u64CA\u529B\u5EA6\u589E\u52A0
      #1. \u73FE\u5728\u4F60\u80FD\u7528\u5F8C\u817F\u8E22\u788E\u5F37\u5316\u7684\u9580\u548C\u5805\u56FA\u7684\u9580\u4E26\u5728\u77ED\u6642\u9593\u5167\u64CA\u6688\u6575\u99AC."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435595
    m_Localized: "\u8F3B\u5C04\u4E4B\u5B50"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435596
    m_Localized: "\u8F3B\u5C04\u4E0D\u6703\u6BBA\u6B7B\u4F60\uFF0C\u53EA\u6703\u4F7F\u4F60\u66F4\u5F37\u58EF.
      \u8F3B\u5C04\u6C34\u5E73\u8D8A\u9AD8\uFF0C\u4F60\u53D7\u5230\u7684\u50B7\u5BB3\u8D8A\u5C11.
      \u6B64\u5916\uFF0C\u8F3B\u5C04\u4E0D\u6703\u5C07\u4F60\u7684\u751F\u547D\u503C\u6E1B\u5C11\u523080%\u4EE5\u4E0B."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435597
    m_Localized: "\u5B89\u4FDD\u5C08\u5BB6"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435598
    m_Localized: "\u4F60\u5C0D\u81EA\u52D5\u5B89\u4FDD\u7CFB\u7D71\u4E86\u5982\u6307\u638C.
      \u5C0D\u90A3\u4E9B\u63A7\u5236\u70AE\u5854\u7684\u7D42\u7AEF\uFF0C\u4F60\u4E0D\u50C5\u80FD\u95DC\u6389\u5B83\u5011\uFF0C\u9084\u80FD\u91CD\u65B0\u8A2D\u7F6E\u5B83\u5011\uFF0C\u4F7F\u70AE\u5854\u958B\u59CB\u653B\u64CA\u4F60\u7684\u6575\u65B9\u76EE\u6A19.
      \u70AE\u5854\u6BBA\u6B7B\u76EE\u6A19\u7372\u5F97\u7684\u7D93\u9A57\u503C\u4E5F\u662F\u4F60\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435599
    m_Localized: "\u5371\u96AA\u5730\u5E36"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435600
    m_Localized: "\u4F60\u4F7F\u7528\u7684\u4EFB\u4F55\u7206\u70B8\u7269\u7684\u7206\u70B8\u534A\u5F91\u589E\u52A0
      #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435601
    m_Localized: "\u5DE5\u5175\u5C08\u5BB6"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435602
    m_Localized: "\u8AAA\u5230\u5730\u96F7\u548C\u96F7\u5340\uFF0C\u4F60\u662F\u51FA\u985E\u62D4\u8403\u7684.
      \u4F60\u5B89\u7F6E\u7684\u5730\u96F7\u50B7\u5BB3\u589E\u52A0 #1\uFF0C\u6B64\u5916\uFF0C\u4F60\u7684\u5730\u96F7\u4E0D\u6703\u88AB\u9644\u8FD1\u7684\u7206\u70B8\u5F15\u7206."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435603
    m_Localized: "\u8FD1\u6230\u5927\u5E2B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435604
    m_Localized: "\u4F60\u5C0D\u51B7\u5175\u5668\u638C\u63E1\u5F97\u7210\u706B\u7D14\u9752.
      \u4EFB\u4F55\u8FD1\u6230\u6B66\u5668 (\u96FB\u92F8\u548C\u985E\u4F3C\u6B66\u5668\u9664\u5916)
      \u7684\u653B\u64CA\u901F\u5EA6\u589E\u52A0 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435605
    m_Localized: "\u6230\u9B25\u6CD5\u5E2B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435606
    m_Localized: "\u4F60\u5F88\u64C5\u9577\u5728\u6230\u9B25\u4E2D\u4F7F\u7528\u653B\u64CA\u9B54\u6CD5\uFF0C\u5B83\u5E7E\u4E4E\u4E0D\u6703\u8B93\u4F60\u611F\u5230\u75B2\u5026.
      \u9019\u6280\u80FD\u6BCF\u589E\u52A0\u4E00\u7D1A\uFF0C\u4F60\u5728\u653B\u64CA\u9B54\u6CD5\u4E0A\u82B1\u8CBB\u7684\u9B54\u529B\u6D88\u8017\u5C31\u6703\u6E1B\u5C11."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435607
    m_Localized: "\u53CB\u5584\u4E4B\u706B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435608
    m_Localized: "\u60A8\u7E3D\u662F\u77E5\u9053\u5982\u4F55\u6295\u64F2\u8E44\u96F7\u6216\u4F7F\u7528\u69B4\u5F48\u767C\u5C04\u5668\uFF0C\u540C\u6642\u8B93\u81EA\u5DF1\u907F\u514D\u7206\u70B8\u7684\u6CE2\u53CA.
      \u6709\u4E86\u9019\u6280\u80FD,\u4F60\u53EA\u53D7\u81EA\u5DF1\u7206\u70B8\u726925%\u7684\u50B7\u5BB3\uFF0C\u5305\u62EC\u7279\u6B8A\u7A2E\u985E\u7684\u7206\u70B8\u7269."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435609
    m_Localized: "\u9577\u671F\u6548\u679C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435610
    m_Localized: "\u4F60\u7684\u91AB\u5B78\u77E5\u8B58\u8B93\u4F60\u6B63\u78BA\u4F7F\u7528\u6230\u9B25\u85E5\u7269.
      \u73FE\u5728\u5404\u7A2E\u85E5\u7269\u7684\u6301\u7E8C\u6642\u9593\u589E\u52A0
      #1 \u500D."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435611
    m_Localized: "\u6230\u9B25\u6FC0\u60C5"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435612
    m_Localized: "\u4F60\u64C5\u9577\u91AB\u5B78\uFF0C\u800C\u4F60\u77E5\u9053\u5982\u4F55\u5728\u5316\u5B78\u85E5\u7269\u7684\u5E6B\u52A9\u4E0B\u5C07\u81EA\u5DF1\u8B8A\u70BA\u4E00\u53F0\u6B7B\u4EA1\u6A5F\u5668.
      \u654F\u9054,\u5927\u529B\u4E38\uFF0C\u72C2\u6012\u85E5\u54C1\uFF0C\u93AE\u75DB\u5291\u7B49\u85E5\u7269\u7684\u5F71\u97FF\u88AB\u653E\u5927.
      \u540C\u6642\u5C0D\u5B83\u5011\u7684\u4E0A\u766E\u6A5F\u7387\u6E1B\u5C0F #1
      \u500D."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435613
    m_Localized: "\u5EE2\u571F\u7D93\u6FDF"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435614
    m_Localized: "\u60A8\u4F5C\u70BA\u7D93\u6FDF\u5B78\u5BB6\u7684\u624D\u80FD\u70BA\u8CBF\u6613\u7684\u767C\u5C55\u505A\u51FA\u4E86\u8CA2\u737B.
      \u6240\u6709\u7684\u8CBF\u6613\u5546\u958B\u59CB\u9032\u8CA8\u66F4\u591A\u7684\u5F48\u85E5\uFF0C\u85E5\u7269\u548C\u5176\u4ED6\u71B1\u9580\u5546\u54C1.
      \u6B64\u5916\uFF0C\u4E00\u500B\u51FA\u552E\u7A00\u6709\u5546\u54C1\u7684\u96F2\u904A\u5546\u99AC\u6703\u958B\u59CB\u62DC\u8A2A\"\u9A30\u98DB\u5C0F\u99AC\"
      \u71DF\u5730."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435615
    m_Localized: "\u5FC3\u9748\u5171\u9CF4"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435616
    m_Localized: "\u4F60\u8207\u4F60\u7684\u5925\u4F34\u6709\u7A2E\u7279\u6B8A\u7684\u5FC3\u7406\u806F\u7CFB\uFF0C\u80FD\u7D66\u4E88\u4ED6\u529B\u91CF.
      \u9019\u6280\u80FD\u6BCF\u589E\u52A0\u4E00\u7D1A\uFF0C\u4F60\u7684\u5925\u4F34\u7684\u653B\u64CA\u529B\u548C\u9632\u79A6\u529B\u986F\u8457\u589E\u52A0."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435617
    m_Localized: "\u6301\u4E45\u8010\u529B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435618
    m_Localized: "\u5728\u6B98\u9177\u7684\u5EE2\u571F\u4E0A\u7684\u751F\u6D3B\u63D0\u9AD8\u4E86\u4F60\u7684\u8010\u529B.
      \u73FE\u5728\u5728\u6230\u9B25\u4E2D\uFF0C\u60A8\u53EF\u4EE5\u8DD1\u5F97\u66F4\u9060\uFF0C\u8DF3\u5F97\u66F4\u9060\u800C\u4E0D\u6703\u611F\u5230\u75B2\u52DE.
      \u6230\u9B25\u4E2D\u5954\u8DD1\u548C\u8DF3\u8E8D\u7684\u9AD4\u529B\u6D88\u8017\u6E1B\u5C11
      #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435619
    m_Localized: "\u7262\u7262\u7DCA\u63E1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435620
    m_Localized: "\u4F60\u5B78\u6703\u4E86\u5982\u4F55\u4F7F\u7528\u5FF5\u529B\u63E1\u7262\u6B66\u5668\uFF0C\u9019\u6A23\u5F8C\u5750\u529B\u7684\u5F71\u97FF\u5C31\u66F4\u5C0F\u4E86.\u60A8\u53EF\u4EE5\u66F4\u9577\u6642\u9593\u5730\u627F\u53D7\u9023\u767C\u706B\u529B\uFF0C\u800C\u4E0D\u5FC5\u64D4\u5FC3\u5931\u53BB\u76EE\u6A19.
      \u9019\u4E5F\u589E\u52A0\u4E86\u4F60\u7A81\u64CA\u6B65\u69CD\u7684\u7CBE\u6E96\u5EA6."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435621
    m_Localized: "\u6253\u5B54\u6A5F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435622
    m_Localized: "\u8B93\u6211\u5011\u5728\u4ED6\u5011\u8EAB\u4E0A\u6253\u4E00\u4E9B\u6D1E\u5427\uFF01\u4F60\u7684\u91CD\u6A5F\u69CD\u7372\u5F97\u4E86\u984D\u5916\u7684\u7A7F\u900F\u6027\uFF0C\u5B50\u5F48\u767C\u6563\u7BC4\u570D\u6E1B\u5C11
      #1 \u500D."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435623
    m_Localized: "\u7D55\u7DE3\u9AD4"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435624
    m_Localized: "\u7531\u65BC\u4F60\u81EA\u8EAB\u6A5F\u9AD4\u7684\u67D0\u4E9B\u7279\u6027\uFF0C\u96FB\u548C\u96F7\u64CA\u5C0D\u4F60\u7684\u50B7\u5BB3\u6E1B\u5C1120%."
