    m_Localized: "\u4E00\u672C\u5152\u7AE5\u6307\u5357\uFF0C\u4F5C\u8005\u60F3\u5E74\u8F15\u7684\u8B80\u8005\u4ECB\u7D39\u8A0A\u606F\u6280\u8853\u7684\u57FA\u790E\uFF0C\u4E26\u4E14\u5206\u4EAB\u4E86\u4E00\u4E9B\u4E0D\u70BA\u719F\u77E5\u7684\u95DC\u65BC\u7D42\u7AEF\u6A5F\u548C\u5176\u4ED6\u8A0A\u606F\u7CFB\u7D71\u5DEE\u7570\u7684\u77E5\u8B58.\u63D0\u9AD8\u4F60\u79D1\u5B78\u982D\u8166\u7684\u80FD\u529B."
