  - m_Id: 2733629681
    m_Localized: "\u907F\u96E3\u5EC4 Pi"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629682
    m_Localized: "\u4E00\u500B\u5B8C\u5168\u81EA\u4E3B\u7684\u79D8\u5BC6\u907F\u96E3\u5EC4\uFF0C\u5EFA\u65BC\u6230\u722D\u521D\u671F\uFF0C\u65E8\u5728\u62EF\u6551\u6700\u512A\u79C0\u7684\u5C0F\u99AC\u79D1\u5B78\u5BB6\u548C\u5DE5\u7A0B\u5E2B.
      \u4F60\u7684\u5BB6."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629683
    m_Localized: "\u5CA9\u77F3\u5821"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629684
    m_Localized: "\u5C0F\u99AC\u570B\u6700\u5805\u4E0D\u53EF\u6467\u7684\u5821\u58D8\u4E4B\u4E00.
      \u5B83\u64C1\u6709\u5F37\u5927\u7684\u706B\u7832\u548C\u9632\u7A7A\u7CFB\u7D71."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629685
    m_Localized: "\u907F\u96E3\u5EC4 Pi"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629686
    m_Localized: "\u907F\u96E3\u5EC4 Pi \u5165\u53E3"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629687
    m_Localized: "\u96F7\u9706\u4E4B\u9996"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629688
    m_Localized: "\u5728\u907F\u96E3\u5EC4 Pi \u9644\u8FD1\u7684\u67D0\u500B\u5730\u65B9"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629689
    m_Localized: "\u4F60\u7684\u65C5\u9014\u958B\u59CB\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629690
    m_Localized: "\u9054\u5230\u65B0\u7684\u7B49\u7D1A."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629691
    m_Localized: "\u6CE8\u610F\uFF01 \u7528\u6236\u7684\u5065\u5EB7\u5DF2\u7D93\u56B4\u91CD\u53D7\u640D\uFF0C\u4E0D\u53EF\u80FD\u7E7C\u7E8C\u57F7\u884C\u4EFB\u52D9.
      [br]\u958B\u59CB\u7DCA\u6025\u5411\u71DF\u5730\u50B3\u9001."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629692
    m_Localized: "\u4F60\u7684\u5065\u5EB7\u72C0\u614B\u5DF2\u7D93\u975E\u5E38\u5371\u96AA\uFF0C\u4E0D\u53EF\u80FD\u7E7C\u7E8C\u57F7\u884C\u4EFB\u52D9.
      [br]\u61C9\u5C0B\u6C42\u91AB\u7642\u6551\u52A9."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629693
    m_Localized: "\u4F60\u651C\u5E36\u7684\u91CD\u7269\u8D85\u91CD\u4E86\uFF01 [br]\u4E00\u4E9B\u6B66\u5668\u7559\u5728\u6B66\u5668\u67B6\u4E0A\uFF0C\u4E26\u5C07\u5099\u7528\u7269\u54C1\u653E\u5165\u73A9\u5BB6\u5009\u5EAB."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629694
    m_Localized: "\u6309 @1 \u6216 @2 \u4F86\u5411\u5DE6\u6216\u5411\u53F3\u79FB\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629695
    m_Localized: "\u6309 @1 \u4F86\u8DF3\u8E8D. [br]\u6309\u4F4F\u6309\u9375\u4E0D\u653E\u80FD\u8DF3\u5F97\u66F4\u9AD8."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629696
    m_Localized: "\u6309 @1 \u4F86\u722C\u68AF."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629697
    m_Localized: "\u6309 @1 \u4F86\u4E0B\u68AF."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629698
    m_Localized: "\u6309 @1 \u4F86\u8E72\u4E0B\uFF0C\u6309 @2 \u4F86\u7AD9\u8D77.
      [br]\u722C\u904E\u9019\u500B\u72F9\u7A84\u7684\u901A\u9053."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629699
    m_Localized: "\u6309 @1+@2 \u4F86\u8DF3\u4E0B\u53BB."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629700
    m_Localized: "\u6AA2\u67E5\u4F60\u5728\u65C5\u9014\u4E2D\u53EF\u80FD\u9047\u5230\u7684\u4EFB\u4F55\u5BB9\u5668.
      \u9019\u500B\u6AC3\u6AE5\u53EF\u80FD\u88DD\u8457\u6709\u8DA3\u7684\u6771\u897F.
      [br]\u9760\u8FD1\u5B83\uFF0C\u5C07\u4F60\u7684\u6E38\u6A19\u79FB\u5230\u5B83\u4E0A\u9762\u7136\u5F8C\u6309
      @1 \u4F86\u6AA2\u67E5\u5167\u90E8."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629701
    m_Localized: "\u4F7F\u7528\u5FF5\u529B\u4F86\u8209\u8D77\u4E26\u79FB\u52D5\u7269\u9AD4.
      \u8981\u9019\u6A23\u505A\uFF0C\u5C07\u4F60\u7684\u6E38\u6A19\u79FB\u5230\u8A72\u7269\u9AD4\u4E0A\u6309
      @1. \u8981\u4E1F\u4E0B\u7269\u9AD4\u518D\u6309\u4E00\u6B21 @2."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629702
    m_Localized: "\u9019\u901A\u9053\u76E1\u982D\u7684\u6728\u7246\u770B\u4E0A\u53BB\u8150\u8755\u56B4\u91CD.
      \u4E5F\u8A31\u4E00\u4E9B\u5F37\u529B\u7684\u8E22\u64CA\u80FD\u64CA\u7834\u5B83.
      \u9760\u8FD1\u7136\u5F8C\u6309 @1 \u4F86\u64CA\u6253.[br]\u5982\u8981\u7528\u4F60\u7684\u5F8C\u817F\u4F7F\u51FA\u66F4\u5F37\u529B\u7684\u8E39\u64CA\uFF0C\u6309
      @2 + @3."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629703
    m_Localized: "\u770B\u4E0A\u53BB\u4F60\u5728\u4E0A\u65B9\u90A3\u80FD\u5F97\u5230\u4E00\u4E9B\u6709\u7528\u7684\u5DE5\u5177."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629704
    m_Localized: "\u4F60\u767C\u73FE\u4E86\u85E5\u54C1. \u7528\u5B83\u4F86\u6CBB\u7642\u4F60\u5728\u6230\u9B25\u4E2D\u7684\u50B7\u53E3.
      \u4F7F\u7528\u85E5\u54C1\u7684\u5FEB\u6377\u9375 - @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629705
    m_Localized: "\u9019\u9762\u7246\u770B\u4E0A\u53BB\u6EFF\u662F\u88C2\u7D0B\uFF0C\u4E26\u4E0D\u50CF\u5176\u4ED6\u7246\u4E00\u6A23\u5805\u56FA.
      \u4F60\u4E5F\u8A31\u80FD\u7528\u4E00\u500B\u64AC\u68CD\u64CA\u788E\u5B83. \u5C07\u6E38\u6A19\u79FB\u5230\u7246\u58C1\u4E0A\uFF0C\u6309
      [\u6ED1\u9F20\u5DE6\u9375] \u4F86\u6572\u64CA."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629706
    m_Localized: "\u4E00\u6247\u4E0A\u9396\u7684\u9580\uFF1F \u4E0D\u662F\u554F\u984C.
      \u5617\u8A66\u64AC\u958B\u5B83\u7684\u9396\uFF0C\u5982\u679C\u5931\u6557\u4E86
      - \u5C31\u7528\u4E00\u500B\u64AC\u68CD\u6253\u788E\u5B83."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629707
    m_Localized: "\u4F7F\u7528\u5FF5\u529B\uFF0C\u5C07\u4E00\u4E9B\u7BB1\u5B50\u653E\u5728\u5404\u81EA\u7684\u9802\u90E8\u4E0A\u4F86\u62B5\u9054\u4E0A\u65B9\u7684\u901A\u9053.
      [br]\u9810\u8A2D\u4E0B\u4F60\u80FD\u6309\u9F20\u6A19\u53F3\u9375\u4F86\u4F7F\u7528\u5FF5\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629708
    m_Localized: "\u64AC\u68CD\u4E0D\u50C5\u80FD\u7528\u4F86\u6467\u6BC0\u7246\u58C1\uFF0C\u9084\u80FD\u75DB\u64CA\u6575\u99AC.
      \u4E0B\u65B9\u6709\u4E00\u4E9B\u8F3B\u5C04\u87D1\u8782. \u5728\u5B83\u5011\u8EAB\u4E0A\u7DF4\u7FD2\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629709
    m_Localized: "\u6309 @1 \u4F86\u4F7F\u7528Pipbuck. \u9019\u8A2D\u5099\u6709\u591A\u7A2E\u529F\u80FD
      - \u5F9E\u67E5\u770B\u7576\u524D\u7684\u5065\u5EB7\u503C\u5230\u700F\u89BD\u5EAB\u5B58."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629710
    m_Localized: "\u8981\u66F4\u5BB9\u6613\u7784\u6E96\uFF0C\u4F60\u53EF\u4EE5\u4F7F\u7528\u907F\u96E3\u5EC4\u8F14\u52A9\u7784\u6E96\u9B54\u6CD5
      (S.A.T.S.). [br] \u8981\u555F\u52D5\u5B83\u6309 @1 (\u6216\u6309\u9F20\u6A19\u6EFE\u8F2A)."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629711
    m_Localized: "\u4F60\u53EF\u4EE5\u4F7F\u7528Pipbuck\uFF0C\u5FEB\u6377\u9375\u6216\u6EFE\u52D5\u9F20\u6A19\u6EFE\u8F2A\u4F86\u5207\u63DB\u6B66\u5668."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629712
    m_Localized: "\u4E00\u500B\u64AC\u68CD\uFF01 \u4F60\u80FD\u5C07\u5B83\u7528\u4F5C\u6B66\u5668\uFF0C\u4E5F\u80FD\u7528\u4F86\u6253\u788E\u6771\u897F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629713
    m_Localized: "\u4E00\u500B\u87BA\u7D72\u5200\uFF01 \u76F8\u7576\u6709\u7528\u7684\u5DE5\u5177.
      \u5B83\u80FD\u5E6B\u52A9\u4F60\u6253\u958B\u7C21\u55AE\u7684\u9396. \u5728\u90A3\u6AC3\u5B50\u4E0A\u7528\u7528\u5B83\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629714
    m_Localized: "\u5145\u80FD\u8E44\u69CD - \u4E00\u500B\u5E78\u904B\u734E. \u5B83\u5C6C\u65BC\u9B54\u80FD\u6B66\u5668\uFF0C\u4E0D\u9700\u8981\u706B\u82B1\u96FB\u6C60.
      \u96FB\u91CF\u6703\u96A8\u6642\u9593\u81EA\u52D5\u6062\u5FA9."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629715
    m_Localized: "\u69CD\u68B0 - \u9019\u4E9B\u6C38\u9060\u90FD\u4E0D\u5ACC\u591A.
      \u6309 @1 \u4F86\u63DB\u5F48."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629716
    m_Localized: "\u4F60\u767C\u73FE\u4E00\u672C\u5C01\u9762\u5BEB\u8457 \"\u5FF5\u529B\u6C96\u64CA\"
      \u7684\u66F8. \u8981\u4F7F\u7528\u5B83\uFF0C\u5F97\u5148\u50CF\u666E\u901A\u6B66\u5668\u4E00\u6A23\u88DD\u5099\u4E0A\u53BB.
      \u6CD5\u8853\u4E0D\u9700\u8981\u5F48\u85E5\uFF0C\u4F46\u6D88\u8017\u4F60\u7684\u9B54\u529B\u503C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629717
    m_Localized: "\u4E0D\u8981\u7121\u8996\u7D42\u7AEF. \u5B83\u5011\u5176\u4E2D\u4E00\u4E9B\u53EF\u80FD\u5305\u542B\u8CB4\u91CD\u6587\u4EF6\uFF0C\u800C\u5176\u4ED6\u7684\u80FD\u8A2A\u554F\u9580\u9396\uFF0C\u5668\u68B0\u548C\u5B89\u4FDD\u7CFB\u7D71.
      \u9396\u5B9A\u7684\u7D42\u7AEF\u80FD\u88AB\u7834\u89E3."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629718
    m_Localized: "\u4F60\u767C\u73FE\u4E00\u500B\u8E44\u5DE5\u6B66\u5668\u7684\u8A2D\u8A08\u5716.
      \u5982\u679C\u4F60\u6709\u5168\u90E8\u7684\u5FC5\u9700\u7D44\u4EF6\uFF0C\u4F60\u80FD\u5617\u8A66\u5728\u5DE5\u4F5C\u53F0\u4E0A\u5275\u9020\u9019\u4EF6\u6B66\u5668."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629719
    m_Localized: "\u4F60\u80FD\u8DF3\u904E\u9019\u500B\u5751\uFF0C\u4F46\u4F60\u5FC5\u9808\u5954\u8DD1\u4F86\u7372\u5F97\u901F\u5EA6\u4E26\u5411\u53F3\u8DF3\u5230\u908A\u7DE3\u8655.
