      m_Items: []
  - m_Id: 2725242149
    m_Localized: "\u4F60\u5F88\u5E78\u904B\u5730\u5F97\u5230\u4E86\u4E00\u628A\u81EA\u52D5\u88DD\u586B\u8E44\u69CD.\u5B83\u5C6C\u65BC\u90A3\u7A2E\u4E0D\u9700\u8981\u96FB\u6C60\u7684\u9B54\u80FD\u6B66\u5668.\u4ED6\u7684\u5F48\u593E\u5132\u5B58\u6703\u96A8\u8457\u6642\u9593\u81EA\u6211\u88DD\u586B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242150
    m_Localized: "\u69CD\u68B0\u6B66\u5668"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242151
    m_Localized: "\u69CD\u68B0\u6B66\u5668\u662F\u90A3\u4E9B\u4F7F\u7528\u5404\u7A2E\u5B50\u5F48\u958B\u706B\u7684\u6B66\u5668.\u6309@1\u4F86\u88DD\u586B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242152
    m_Localized: "\u653B\u64CA\u9B54\u6CD5"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242153
    m_Localized: "\u4F60\u627E\u5230\u4E86\u4E00\u672C\u4ECB\u7D39\u9B54\u80FD\u5149\u5F48\u9B54\u6CD5\u7684\u66F8.\u53EF\u4EE5\u6309\u7167\u88DD\u5099\u4E00\u822C\u6B66\u5668\u7684\u65B9\u6CD5\u4F86\u4F7F\u7528\u5B83.\u9019\u500B\u9B54\u6CD5\u4E0D\u9700\u8981\u5B50\u5F48\uFF0C\u4F46\u662F\u6703\u6D88\u8017\u4F60\u7684\u9B54\u6CD5\u503C.\u6B64\u5916\uFF0C\u653B\u64CA\u9B54\u6CD5\u53EF\u4EE5\u6309@1\u4F86\u8207\u5176\u4ED6\u6B66\u5668\u540C\u6642\u4F7F\u7528."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242154
    m_Localized: "\u9632\u79A6\u9B54\u6CD5"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242155
    m_Localized: "\u60F3\u8981\u4F7F\u7528\u9632\u79A6\u9B54\u6CD5\uFF0C\u9996\u5148\u4F60\u5F97\u5728\u5EAB\u5B58\u4E2D\u88DD\u5099\u5B83([\u6D88\u8017\u54C1]\u90E8\u5206).\u5728\u9019\u4E4B\u5F8C\uFF0C\u4F60\u53EF\u4EE5\u901A\u904E\u6309@1\u4F86\u4F7F\u7528\u5B83"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242156
    m_Localized: "\u690D\u5165\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242157
    m_Localized: "\u690D\u5165\u6A21\u7D44\u662F\u88AB\u88DD\u597D\u4E14\u555F\u7528\u7684.\u4E0D\u9700\u8981\u5176\u5B83\u64CD\u4F5C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242158
    m_Localized: "Pipbuck\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242159
    m_Localized: "\u9019\u500B\u6A21\u7D44\u662F\u8207Pipbuck\u93C8\u63A5\u4E26\u555F\u7528\u7684.\u4E0D\u9700\u8981\u5176\u4ED6\u64CD\u4F5C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242160
    m_Localized: "\u76AE\u819A\u589E\u5F37\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242161
    m_Localized: "\u4E00\u500B\u5C6C\u65BC\"\u96FB\u5B50\u5C0F\u99AC\"\u9805\u76EE\u958B\u767C\u7684\u7684\u79D8\u5BC6\u6280\u8853.\u5728\u4F60\u7684\u76AE\u4E0B\u690D\u5165\u805A\u5408\u7269\u7D44\u7E54\u4F86\u5F37\u5316\u76AE\u819A\uFF0C\u589E\u52A0\u4F60\u81F3\u5C11
      #1 \u9EDE\u7684\u50B7\u5BB3\u6E1B\u5C11.\u690D\u5165\u8CBB\u7528\u5DF2\u5305\u542B\u5728\u7269\u54C1\u552E\u50F9."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242162
    m_Localized: "\u518D\u751F\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242163
    m_Localized: "\u4E00\u500B\u5FA9\u96DC\u4E26\u4E14\u73CD\u8CB4\u7684\u79FB\u690D\u9AD4\uFF0C\u7D50\u5408\u4E86\u5148\u9032\u7684\u9B54\u6CD5\u548C\u7D0D\u7C73\u6280\u8853.\u80FD\u5920\u81EA\u52D5\u6062\u5FA9\u7528\u6236\u6BCF\u79D2
      #1 \u9EDE\u7684\u5065\u5EB7\uFF0C\u4E0D\u9700\u8981\u984D\u5916\u7684\u8CC7\u6E90\uFF0C\u4F46\u6062\u5FA9\u91CF\u4E0D\u8D85\u904E\u5065\u5EB7\u6700\u5927\u503C\u7684
      #2 ."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242164
    m_Localized: "\u9B54\u6CD5\u5132\u5B58\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242165
    m_Localized: "\u5C08\u9580\u70BA\u5584\u7528\u9B54\u6CD5\u7684\u5C0F\u99AC\u6E96\u5099\u7684.\u6C38\u9060\u4E0D\u8981\u8B93\u4F60\u7684\u9B54\u6CD5\u529B\u91CF\u5230\u96F6\uFF0C\u9632\u6B62\u8B93\u81EA\u5DF1\u9B54\u529B\u67AF\u7AED."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242166
    m_Localized: "\u908F\u8F2F\u8655\u7406\u5668"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242167
    m_Localized: "\u4E00\u500B\u76F4\u63A5\u690D\u5165\u5927\u8166\u7684\u5C0F\u82AF\u7247.\u80FD\u63D0\u9AD8\u8A18\u61B6\u80FD\u529B,\u6709\u52A9\u63D0\u9AD8\u6578\u5B78\u8A08\u7B97\uFF0C\u63D0\u9AD8\u4E86\u5FF5\u529B\u7CBE\u5EA6.\u4E00\u822C\u4F86\u8AAA\u9019\u80FD\u63D0\u9AD8
      #1 \u9EDE\u958B\u9396\u5927\u5E2B\u8207 #2 \u9EDE\u79D1\u5B78\u982D\u8166\u7684\u80FD\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242168
    m_Localized: "\u91D1\u5C6C\u63A2\u6E2C\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242169
    m_Localized: "\u4E00\u500B\u9023\u63A5Pipbuck\u7684\u7C21\u55AE\u88DD\u7F6E.\u8A2D\u7F6E\u63A2\u6E2C\u5C0F\u91D1\u5C6C\u7269\uFF0C\u53EF\u4EE5\u5728\u4F60\u610F\u60F3\u4E0D\u5230\u7684\u5730\u65B9\u627E\u5230\u74F6\u84CB\u548C\u5F48\u85E5."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242170
    m_Localized: "\u6230\u8853\u5206\u6790\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242171
    m_Localized: "PipBuck \u7684\u9032\u968E\u6A21\u7D44\uFF0C\u5141\u8A31\u6383\u63CF\u4F86\u5224\u65B7\u6575\u99AC\u7684\u5F37\u5F31\u4F4D\u7F6E.
      \u5728 S.A.T.S.\u60A8\u5C07\u770B\u5230\u6709\u95DC\u6575\u99AC\u7684\u5065\u5EB7\u548C\u76D4\u7532\u7684\u78BA\u5207\u8A0A\u606F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242172
    m_Localized: "\u6A19\u8A18\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242173
    m_Localized: "\u4E00\u500B\u5FA9\u96DC\u7684\u88DD\u7F6E\uFF0C\u5B83\u9023\u63A5\u5230Pipbuck.
      \u5728\u6230\u9B25\u4E2D\u5B83\u6703\u6307\u51FA\u6575\u99AC\u6C92\u6709\u88AB\u88DD\u7532\u5FA9\u84CB\u7684\u90E8\u4F4D\u4E26\u6A19\u8A18\u4E0A.
      \u4F60\u6709\u6A5F\u6703\u4F86\u653B\u64CA\u4ED6\u5011\u7684\u5F31\u9EDE\uFF0C\u7121\u8996\u4EFB\u4F55\u88DD\u7532.\u4F7F\u7528\u8E44\u69CD\u6216\u8005\u6B65\u69CD\u7684\u6642\u5019\u6A5F\u6703\u6703\u66F4\u5927."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242174
    m_Localized: "\u5168\u606F\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242175
    m_Localized: "\u4E00\u500BPipbuck\u7684\u5FA9\u96DC\u9B54\u6CD5\u79D1\u6280\u6A21\u7D44\uFF0C\u88DD\u5099\u6709\u5E7B\u8853\u9B54\u6CD5.\u4F5C\u70BA\u4E00\u500B\u4E3B\u52D5\u7684\u507D\u88DD\u7CFB\u7D71\uFF0C\u9019\u8B93\u66F4\u96E3\u4EE5\u88AB\u5075\u6E2C\u5230.
      \u5728\u6230\u9B25\u4E2D\u80FD\u767C\u51FA\u8A98\u990C\u566A\u97F3\uFF0C\u64FE\u4E82\u6575\u99AC\u9663\u8173.
      \u589E\u52A0#1\u7684\u96B1\u8EAB\u548C\u9583\u907F\u734E\u52F5."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242176
    m_Localized: "\u4FEE\u5FA9\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242177
    m_Localized: "\u4E00\u500BPipbuck\u7684\u91AB\u7642\u6A21\u584A\u7684\u9644\u52A0\u6A21\u7D44.\u5B83\u6703\u4E00\u76F4\u76E3\u8996\u4F60\u7684\u5065\u5EB7\u72C0\u614B\u4E26\u5728\u6709\u81F4\u547D\u5371\u96AA\u7684\u60C5\u6CC1\u4E2D\u81EA\u52D5\u4F7F\u7528\u91AB\u7642\u9B54\u6CD5\uFF0C\u80FD\u8B93\u4F7F\u7528\u8005\u5728\u53D7\u5230\u56B4\u91CD\u50B7\u5BB3\u7684\u6642\u5019\u4E5F\u5B58\u6D3B\u4E26\u4FDD\u6301\u826F\u597D\u72C0\u614B.\u4F46\u6BCF\u6B21\u4F7F\u7528\u5F8C\u90FD\u9700\u8981\u9577\u6642\u9593\u7684\u5145\u80FD."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242178
    m_Localized: "\u9ED1\u5BA2\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242179
    m_Localized: "\u8B93\u4F60\u7684Pipbuck\u5C0F\u90E8\u5206\u81EA\u52D5\u7372\u5F97\u5BC6\u78BC.\u63D0\u9AD8\u4F60
      #1 \u9EDE\u7684\u5165\u4FB5\u7D42\u7AEF\u6A5F\u7684\u80FD\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242180
    m_Localized: "\u6A5F\u68B0\u8C93\u982D\u9DF9\u589E\u5F37\u578B\u96F7\u5C04"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242181
    m_Localized: "\u6539\u9032\u4E86\u6A5F\u68B0\u8C93\u982D\u9DF9\u7684\u96F7\u5C04\uFF0C\u589E\u52A0\u4E86\u4E09\u5206\u4E4B\u4E00\u7684\u50B7\u5BB3."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242182
    m_Localized: "\u6A5F\u68B0\u8C93\u982D\u9DF9\u4E3B\u52D5\u9632\u79A6"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242183
    m_Localized: "\u589E\u5F37\u4E86\u6A5F\u68B0\u8C93\u982D\u9DF9\u7684\u672C\u9AD4\uFF0C\u63D0\u9AD8\u4E86\u5B83\u7684\u751F\u5B58\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242184
    m_Localized: "\u6A5F\u68B0\u8C93\u982D\u9DF9\u5916\u6BBC"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242185
    m_Localized: "\u53EA\u662F\u4E00\u500B\u6C92\u6709\u4EFB\u4F55\u586B\u5145\u7269\u7684\u5916\u6BBC."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242186
    m_Localized: "\u91CF\u5B50\u8655\u7406\u5668"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242187
    m_Localized: "\u4E00\u500B\u5C0F\u578B\u4F46\u662F\u975E\u5E38\u5F37\u5927\u7684\u8655\u7406\u5668.\u901A\u5E38\u8207\u4F60\u7684Pipbuck\u76F8\u9023\u53EF\u4EE5\u63D0\u9AD8\u4F60
      #1 \u7684\u958B\u9396\u548C\u7834\u89E3\u7D42\u7AEF\u7684\u80FD\u529B\uFF0C\u540C\u6642\u4E5F\u589E\u52A0\u4F60\u5728S.A.T.S\u6A21\u5F0F\u4E0B
      #2 \u884C\u52D5\u9EDE\u6578\u4E0A\u9650."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242188
    m_Localized: "\u4F60\u73FE\u5728\u8E44\u5B50\u4E0A\u62FF\u8457\u7684\u88DD\u7F6E\u662F\u524D\u5C0F\u99AC\u570B\u79D1\u6280\u7684\u9802\u5C16\u5091\u4F5C.\u4E00\u500B\u975E\u5E38\u5C0F\u578B\u7684\u6BD4\u666E\u901A\u7684\u8655\u7406\u5668\u5F37\u5927\u5343\u500D\u7684\u8655\u7406\u5668.\u4F7F\u7528\u4E86\u4F60Pipbuck\u6280\u5E2B\u7684\u77E5\u8B58\uFF0C\u4F60\u628A\u9019\u500B\u8655\u7406\u5668\u8207\u4F60\u7684Pipbuck\u9023\u63A5\u4E0A\u4E86.\u7576\u7136\uFF0C\u9019\u4E26\u4E0D\u80FD\u5C55\u73FE\u51FA\u9019\u500B\u795E\u5947\u79D1\u6280\u7684\u6240\u6709\u6F5B\u80FD\uFF0C\u4F46\u662F\uFF0C\u88DD\u4E86\u5B83\uFF0C\u4F60\u7684Pipbuck\u80FD\u5920\u904B\u4F5C\u5F97\u66F4\u5FEB\u66F4\u597D.\u60A8\u958B\u9396\u200B\u200B\u548C\u7834\u89E3\u7D42\u7AEF\u7684\u6280\u80FD\u6C34\u5E73\uFF0C\u4EE5\u53CA
      S.A.T.S. \u4E2D\u7684\u884C\u52D5\u9EDE\u6578\u589E\u52A0."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242189
    m_Localized: "\u6676\u9AD4\u7BA1\u6A21\u7D44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242190
    m_Localized: "PipBuck \u7684\u64F4\u5C55\u6A21\u7D44\uFF0C\u53EF\u63D0\u9AD8\u5176\u8A08\u7B97\u80FD\u529B.
      \u5C07\u60A8\u7684\u958B\u9396\u548C\u9ED1\u5BA2\u653B\u64CA\u7B49\u7D1A\u63D0\u9AD8
      #1\uFF0C\u4EE5\u53CA\u63D0\u9AD8 S.A.T.S. \u4E2D #2 \u7684\u884C\u52D5\u9EDE\u6578."
    m_Metadata:
      m_Items: []
