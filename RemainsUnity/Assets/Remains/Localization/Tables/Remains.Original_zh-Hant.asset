    m_Metadata:
      m_Items: []
  - m_Id: 2729435328
    m_Localized: "\u770B\u8D77\u4F86\u50CF\u662F\u9ED1\u9B54\u6CD5\u5177\u9AD4\u5316\u7684\u6771\u897F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435329
    m_Localized: "\u8108\u885D\u8E44\u96F7"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435330
    m_Localized: "\u5730\u7344\u72AC\u722A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435331
    m_Localized: "\u66FE\u7D93\u5C6C\u65BC\u5927\u578B\u5730\u7344\u72AC\u7684\u7279\u5225\u9577\u800C\u92D2\u5229\u7684\u722A\u5B50.
      \u4F60\u53EF\u4EE5\u7528\u5B83\u4F86\u88FD\u9020\u6B66\u5668\u6216\u8CE3\u500B\u597D\u50F9\u9322."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435332
    m_Localized: "\u5F48\u85E5\u888B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435333
    m_Localized: "\u7531\u9EC3\u9285\u925B\u5F48\u7279\u6B8A\u8A2D\u8A08\u7684\u539A\u9632\u6C34\u6CB9\u5E03\u88FD\u6210\u7684\u5C0F\u888B.
      \u6709\u4E86\u5B83\uFF0C\u60A8\u53EF\u4EE5\u651C\u5E36\u66F4\u591A\u5F48\u85E5\uFF0C\u96FB\u6C60\u6216\u70B8\u85E5\uFF0C\u800C\u4E0D\u6703\u5931\u53BB\u6A5F\u52D5\u6027."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435334
    m_Localized: "\u5927\u578B\u5F48\u85E5\u888B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435335
    m_Localized: "\u7531\u9435\u9A0E\u885B\u5C08\u5BB6\u8A2D\u8A08\u7684\u8010\u7528\u5408\u6210\u7E54\u7269\u888B.
      \u6709\u4E86\u5B83\uFF0C\u60A8\u53EF\u4EE5\u651C\u5E36\u66F4\u591A\u5F48\u85E5\uFF0C\u96FB\u6C60\u6216\u70B8\u85E5\uFF0C\u800C\u4E0D\u6703\u5931\u53BB\u6A5F\u52D5\u6027."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435336
    m_Localized: "\u5FC3\u9748\u64F4\u5F35\u85E5\u6C34"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435337
    m_Localized: "\u4E00\u7A2E\u6975\u5176\u7A00\u6709\u7684\u9748\u4E39\u5999\u85E5\uFF0C\u5176\u914D\u65B9\u4F3C\u4E4E\u6C38\u9060\u4E1F\u5931\u4E86.
      \u589E\u5F37\u9B54\u6CD5\u5929\u8CE6\uFF0C\u4F7F\u7368\u89D2\u7378\u80FD\u5920\u540C\u6642\u5728\u8A18\u61B6\u4E2D\u4FDD\u5B58\u66F4\u591A\u7684\u6CD5\u8853.
      \u6548\u679C\u662F\u6C38\u4E45\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435338
    m_Localized: "\u548C\u8AE7\u6C34\u6676"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435339
    m_Localized: "\u4E0D\u898F\u5247\u5F62\u72C0\u7684\u85CD\u8272\u6676\u9AD4. \u5176\u76EE\u7684\u4E0D\u660E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435340
    m_Localized: "\u78C1\u5171\u632F\u99AC\u5206\u96E2\u5668 Magnetic resonance horsgregator"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435341
    m_Localized: "\u4F7F\u7528\u78C1\u5171\u632F\u9032\u884C\u99AC\u5339\u5206\u96E2
      - \u4F60\u4E0D\u9700\u8981\u662F\u79D1\u5B78\u5BB6\u4E5F\u80FD\u7406\u89E3\u9019\u4E00\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435342
    m_Localized: "\u8D85\u7D1A\u56DB\u91CD\u589E\u5E45\u5668 Ultra-quadruponificator"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435343
    m_Localized: "\u6BD4\u666E\u901A\u7684\u56DB\u91CD\u589E\u5E45\u5668\u66F4\u5F37\u5927.
      \u662F\u56DB\u91CD\u589E\u5E45\u6280\u8853\u4E2D\u7684\u771F\u6B63\u7A81\u7834\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435344
    m_Localized: "\u91CD\u5B50\u4E2D\u548C\u5668 Baryon neighralyzer"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435345
    m_Localized: "\u53EF\u4EE5\u4EE5\u4EFB\u4F55\u65B9\u5F0F\u4E2D\u548C\u60A8\u60F3\u8981\u7684\u4EFB\u4F55\u4E8B\u7269
      - \u9019\u6B3E\u8A2D\u5099\u7684\u529F\u80FD\u9060\u52DD\u65BC\u5176\u985E\u4F3C\u7522\u54C1\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435346
    m_Localized: "\u8D85\u8F3B\u5C04\u6E96\u7A69\u5B9A\u5B50 Superluminescent quasistabilitron"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435347
    m_Localized: "\u5B83\u53EF\u4EE5\u6839\u64DA\u91CF\u5B50\u5834\u7684\u72C0\u614B\u767C\u51FA\u4E0D\u540C\u984F\u8272\u7684\u5149\u6216\u6574\u6D41\u96FB\u6D41."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435348
    m_Localized: "\u8D85\u5149\u675F\u8584\u66AE\u878D\u5408\u5668 Hyperbeam twilifuser"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435349
    m_Localized: "\u4F7F\u7528\u6B64\u88DD\u7F6E\u6642\uFF0C\u6700\u91CD\u8981\u7684\u662F\u8A18\u4F4F\u63D2\u982D\u61C9\u8A72\u63D2\u5165\u7684\u4F4D\u7F6E.
      \u4E0D\u6B63\u78BA\u7684\u63D2\u5165\u53EF\u80FD\u6703\u5C0E\u81F4\u56B4\u91CD\u5F8C\u679C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435350
    m_Localized: "\u82F1\u514B\u96F7\u52D5\u529B\u88DD\u7532"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435351
    m_Localized: "\u82F1\u514B\u96F7\u52D5\u529B\u88DD\u7532. \u5982\u679C\u4E0D\u9032\u884C\u4E00\u4E9B\u4FEE\u6539\uFF0C\u60A8\u5C07\u7121\u6CD5\u6B63\u78BA\u7A7F\u6234."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435352
    m_Localized: "\u9AD2\u8A71\u5B57\u5178"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435353
    m_Localized: "\u89AA\u611B\u7684\u8B80\u8005\uFF01\u5982\u679C\u4F60\u628A\u9019\u90E8\u4F5C\u54C1\u653E\u5728\u4F60\u7684\u8E44\u5B50\u88E1\uFF0C\u90A3\u610F\u5473\u8457\u4F60\u5DF2\u7D93\u6C7A\u5B9A\u9081\u51FA\u638C\u63E1\u7C97\u4FD7\u8A9E\u8A00\u5FAE\u5999\u85DD\u8853\u7684\u7B2C\u4E00\u6B65.
      \u53E3\u9F52\u4F36\u4FD0\uFF0C\u53E3\u9F52\u4F36\u4FD0\uFF0C\u5176\u5BE6\u662F\u667A\u6167\u8A9E\u8A00\u7684\u91CD\u8981\u7D44\u6210\u90E8\u5206\u53EA\u8981\u904B\u7528\u5F97\u7576\uFF0C\u7D55\u5C0D\u6C92\u6709\u4EC0\u9EBC\u4E1F\u4EBA\u7684\u5730\u65B9.
      \u5728\u5927\u591A\u6578\u60C5\u6CC1\u4E0B\uFF0C\u50C5\u50C5\u5728\u4F60\u7684\u6F14\u8B1B\u4E2D\u6DFB\u52A0\u4E00\u500B\u9AAF\u9AD2\u7684\u8A5E\u4E0D\u8DB3\u4EE5\u6253\u52D5\u807D\u773E\u4E26\u5145\u5206\u8868\u9054\u4F60\u7684\u611F\u53D7\uFF0C\u8A31\u591A\u4EBA\u5728\u6574\u500B\u73FE\u5834\u90FD\u63D0\u9AD8\u4E86\u4ED6\u5011\u8C50\u5BCC\u591A\u5F69\u7684\u60C5\u611F\u8868\u9054\u6280\u5DE7.
      \u53EF\u60B2\u7684\u662F\uFF0C\u6211\u5011\u7684\u5B57\u5178\u4E0D\u592A\u53EF\u80FD\u8DB3\u4EE5\u5C07\u60A8\u63D0\u5347\u5230\u8A72\u85DD\u8853\u771F\u6B63\u5927\u5E2B\u7684\u6C34\u5E73\uFF0C\u56E0\u70BA\u771F\u6B63\u9AD8\u8D85\u7684\u5492\u7F75\u61C9\u8A72\u4F86\u81EA\u60A8\u7684\u76F4\u89BA\u548C\u767C\u81EA\u5167\u5FC3.
      \u4F46\u662F\u591A\u8667\u4E86\u9019\u672C\u66F8\uFF0C\u4F60\u7D55\u5C0D\u53EF\u4EE5\u5F97\u5230\u4E00\u500B\u8D77\u9EDE\u4F86\u6307\u5C0E\u4F60\u9032\u4E00\u6B65\u63D0\u9AD8\u4F60\u5728\u9019\u500B\u9818\u57DF\u7684\u624D\u80FD."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435354
    m_Localized: "\u8B8A\u8EAB\u85E5\u6C34"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435355
    m_Localized: "\u8B93\u4F60\u5728\u77ED\u6642\u9593\u5167\u8B8A\u6210\u4E00\u96BB\u5C0F\u52D5\u7269.
