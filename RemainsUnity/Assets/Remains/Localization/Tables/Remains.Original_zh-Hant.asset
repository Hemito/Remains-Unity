    m_Localized: "\u6211\u5011\u53EF\u4EE5\u5E36\u4F60\u53BB\u898B\u5979\uFF0C\u964C\u751F\u4EBA\uFF0C\u4F46\u6211\u5011\u6C7A\u4E0D\u5141\u8A31\u4F60\u50B7\u5BB3\u5979."
    m_Metadata:
