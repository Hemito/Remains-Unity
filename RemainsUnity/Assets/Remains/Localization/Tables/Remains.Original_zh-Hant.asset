  - m_Id: 2737824020
    m_Localized: "\"\u592A\u967D\"\u9805\u76EE\u548CPi\u907F\u96E3\u5EC4\u5C6C\u65BC\u4F60\u4E86\uFF0C\u9577\u8001.
      \u4F5C\u70BA\u4F60\u51FA\u5175\u7684\u56DE\u5831. \u7279\u4F7F\u51F1\u745F\u7559\u65AF\u76F8\u4FE1\u4F60\u7684\u6307\u63EE\u80FD\u529B\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824021
    m_Localized: "\u6709\u4EC0\u9EBD\u611F\u60F3\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824022
    m_Localized: "\u9019\u662F...\u51B7\u7738\u9577\u8001\u7684\u8072\u97F3\uFF0C\u54EA\u88E1\u4F86\u7684\u9304\u97F3\uFF1F\u9577\u8001\u5728\u548C\u8AB0\u8AAA\u8A71."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824023
    m_Localized: "\u7B49\u4E00\u4E0B\uFF0C\u6211\u5148\u554F.\n\u4F60\u5011\u9577\u8001\u548C\u6591\u99AC\u8ECD\u5718\u6709\u5BC6\u8B00\u8A08\u756B\uFF0C\u96E3\u9053\u4F60\u4E0D\u61C9\u8A72\u544A\u8A34\u6211\u4E8B\u60C5\u7684\u4F86\u9F8D\u53BB\u8108\u55CE\uFF1F\u62FF\u51FA\u9EDE\"\u5408\u4F5C\"\u7684\u8AA0\u610F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824024
    m_Localized: "\u6211\u4E26\u4E0D\u77E5\u9053\uFF0C @lp. \u662F\u9019\u6A23\uFF0C\u6211\u5011\u65E9\u5C31\u548C\u51B7\u7738\u9577\u8001\u79C1\u4E0B\u5C0D\u5CD9\u4E86\uFF0C\u6211\u6839\u672C\u4E0D\u77E5\u9053\u4ED6\u7684\u8A08\u756B\uFF0C\u56E0\u70BA\u4ED6\u4E0D\u4FE1\u4EFB\u6211."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824025
    m_Localized: "\u96E3\u9053\u4F60\u4E0D\u662F\u4ED6\u7684\u90E8\u4E0B\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824026
    m_Localized: "\u7576\u521D\u5728\u4E2D\u5FC3\u57CE\u4F60\u9762\u5C0D\u7684\u662F\u6211\u5011\u56DB\u500B\uFF0C\u73FE\u5728\u4F60\u9762\u5C0D\u6574\u500B\u71DF\u5730\u7684\u9435\u9A0E\u885B.
      \u5982\u679C\u6211\u662F\u51B7\u7738\u7684\u4EBA\uFF0C\u4F60\u89BA\u5F97\u6211\u6703\u653E\u4EFB\u6BBA\u5BB3\u8594\u8587\u548C\u947D\u77F3\u7684\u5147\u8E44\u4E0D\u7BA1\u55CE\uFF1F\u6703\u653E\u4EFB\u4F60\u77E5\u66C9\u9577\u8001\u7684\u8A08\u756B\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824027
    m_Localized: "\u597D\u5427\uFF0C\u6709\u9053\u7406."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824028
    m_Localized: "\u73FE\u5728\u544A\u8A34\u6211\u9019\u6BB5\u9304\u97F3\u662F\u54EA\u5152\u4F86\u7684\uFF0C\u5982\u679C\u9304\u97F3\u5C6C\u5BE6\uFF0C\u90A3\u9EBD\u51B7\u7738\u56B4\u91CD\u9055\u53CD\u4E86\u5144\u5F1F\u6703\u7684\u898F\u77E9."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824029
    m_Localized: "\u6211\u5728\u5370\u8C61\u90E8\u9047\u5230\u4E86\u4E00\u500B\u6591\u99AC\u8ECD\u5718\u7684\u5DEB\u5E2B.
      \u5979\u7D93\u5E38\u901A\u904E\u5370\u8C61\u90E8\u901A\u4FE1\u4E2D\u5FC3\u806F\u7D61\u4F60\u5011\u9577\u8001\uFF0C\u9019\u6BB5\u9304\u97F3\u5C31\u662F\u7D42\u7AEF\u6A5F\u88E1\u9762\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824030
    m_Localized: "\u6211\u6700\u64D4\u5FC3\u7684\u4E8B\u60C5\u767C\u751F\u4E86. \u51B7\u7738\u9577\u8001\u4E00\u76F4\u662F\u6211\u5011\u5206\u90E8\u7684\u5FB7\u9AD8\u671B\u91CD\u7684\u7D71\u5E25.
      \u4F46\u4ED6\u5C0D\u9435\u9A0E\u885B\u7684\u5FE0\u8AA0\u9084\u6709\u5F85\u78BA\u8A8D\uFF0C\u4F46\u5C31\u7B97\u4ED6\u8FFD\u96A8\u7684\u9435\u9A0E\u885B\u4FE1\u5FF5\u4E0D\u4E00\u6A23\uFF0C\u4ED6\u4E5F\u4E0D\u8A72\u52FE\u7D50\u6591\u99AC\uFF0C\u5C24\u5176\u662F\u6591\u99AC\u8ECD\u5718.\n\u5C31\u7B97\u6211\u548C\u4ED6\u89C0\u5FF5\u4E0D\u5408\uFF0C\u9019\u7A2E\u884C\u70BA\u7684\u5F8C\u679C\u4E5F\u592A\u56B4\u91CD\u4E86.
      \u6211\u76F8\u4FE1\u4E8B\u51FA\u6709\u56E0\uFF0C\u6211\u6703\u4E0B\u4EE4\u7ACB\u523B\u5C0B\u627E\u51B7\u7738\u9577\u8001."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824031
    m_Localized: "\u5C0B\u627E\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824032
    m_Localized: "\u662F\u7684\uFF0C\u6211\u7684\u968A\u4F0D\u8207\u5176\u4F59\u9435\u9A0E\u885B\u523B\u610F\u4FDD\u6301\u4E86\u4E00\u6BB5\u8DDD\u96E2.
      \u9CF4\u99AC\u5206\u90E8\u5927\u90E8\u5206\u9435\u9A0E\u885B\u90FD\u662F\u5FE0\u65BC\u51B7\u7738\u7684.
      \u56E0\u6B64\uFF0C\u6211\u5011\u5C0D\u65BC\u5175\u529B\u90E8\u7F72\u8CC7\u6599\u7684\u4E86\u89E3\u5341\u5206\u6709\u9650.
      \u9577\u8001\u53EF\u80FD\u4E5F\u4E0D\u5B8C\u5168\u6E05\u695A. \u4F46\u6709\u5E7E\u500B\u9A0E\u58EB\u548C\u8056\u9A0E\u58EB\u79D8\u5BC6\u652F\u6301\u6211\uFF0C\u63E1\u6703\u806F\u7CFB\u4ED6\u5011\u7372\u5F97\u60C5\u5831."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824033
    m_Localized: "\u8981\u82B1\u591A\u9577\u6642\u9593."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824034
    m_Localized: "\u4E00\u5929\u4E4B\u5167\uFF0C\u6211\u5011\u90E8\u4E0B\u8CA0\u8CAC\u6062\u5FA9\u901A\u8A0A\uFF0C\u904B\u6C23\u597D\u7684\u8A71\uFF0C\u6211\u5011\u80FD\u7DAD\u6301\u8F03\u9577\u6642\u9593\u7684\u907F\u96E3\u5EC4\u7121\u7DDA\u901A\u8A0A\uFF0C\u78BA\u5B9A\u51B7\u7738\u7684\u65B9\u4F4D\u5F8C\uFF0C\u6211\u53BB\u7576\u9762\u8CEA\u554F\u4ED6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824035
    m_Localized: "\u6211\u548C\u4F60\u4E00\u8D77\u53BB."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824036
    m_Localized: "\u95DC\u4F60\u4EC0\u9EBD\u4E8B\uFF1F\u9019\u662F\u9435\u9A0E\u885B\u5167\u90E8\u554F\u984C.
      \u4F60\u4E4B\u524D\u5C0D\u6211\u5011\u4E00\u7121\u6240\u77E5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824037
    m_Localized: "\u4F46\u73FE\u5728\u6211\u5011\u6709\u5171\u540C\u5229\u76CA\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824038
    m_Localized: "\u554A\uFF0C\u6211\u660E\u767D\u4E86. Pi\u907F\u96E3\u5EC4\u662F\u4F60\u7684\u5BB6\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F\u4F60\u4E7E\u51C8\u7684\u8863\u670D\u548CPipbuck\u5DF2\u7D93\u8B49\u660E\u4E86\u4F60\u4E0D\u662F\u4F86\u81EA\u5EE2\u571F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824039
    m_Localized: "\u6211\u6C92\u6709..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824040
    m_Localized: "\u4F60\u5230\u5E95\u5E36\u4E0D\u5E36\u6211\u53BB\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824041
    m_Localized: "\u5982\u679C\u4F60\u662FPi\u907F\u96E3\u5EC4\u7684\u5C0F\u99AC\uFF0C\u5C31\u8AAA\u5F97\u901A\u4E86.
      \u4F60\u80AF\u5B9A\u4E0D\u5E0C\u671B\u51B7\u7738\u9577\u8001\u5360\u9818\u81EA\u5DF1\u7684\u5BB6\uFF0C\u6216\u8A31\u4ED6\u4E26\u975E\u51FA\u65BC\u8CAA\u5A6A\uFF0C\u4F60\u9084\u6709\u53EF\u80FD\u548C\u4ED6\u4EA4\u6D89\uFF0C\u627E\u5230\u4E0D\u6D41\u8840\u7684\u65B9\u6848\uFF0C\u6211\u5011\u9084\u6709\u6A5F\u6703\u548C\u5E73\u89E3\u6C7A\u9019\u4EF6\u4E8B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824042
    m_Localized: "\u8B1D\u8B1D\u4F60\u76F8\u4FE1\u6211\uFF0C\u9435\u8E44.\n\u65E2\u7136\u4F60\u77E5\u9053\u4E86\u6211\u7684\u79D8\u5BC6\uFF0C\u6211\u4E5F\u60F3\u554F\u4F60\u4E00\u500B\u554F\u984C.
      \u4F60\u548C\u51B7\u7738\u9577\u8001\u5230\u5E95\u6709\u4EC0\u9EBD\u5206\u6B67\u5462\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824043
    m_Localized: "\u51B7\u7738\u662F\u90A3\u7A2E\u5C0D\u5EE2\u571F\u6C92\u6709\u7D72\u6BEB\u540C\u60C5\u5FC3\u7684\u5C0F\u99AC\uFF0C\u4ED6\u6C92\u6709\u611F\u60C5\uFF0C\u6C38\u9060\u628A\u9435\u9A0E\u885B\u7684\u5229\u76CA\u653E\u5728\u7B2C\u4E00\u4F4D.
      \u9019\u7A2E\u884C\u70BA\u5FB9\u5E95\u9055\u80CC\u4E86\u860B\u679C\u5091\u514B\u5EFA\u7ACB\u9435\u9A0E\u885B\u7684\u521D\u8877.
      \u53EF\u4ED6\u5FB7\u9AD8\u671B\u91CD\uFF0C\u5DF2\u7D93\u6709\u4E86\u5F88\u591A\u8FFD\u96A8\u8005\uFF0C\u53CD\u5C0D\u4ED6\u5C31\u610F\u5473\u8457\u5167\u6230.
      \u6211\u6700\u8A0E\u53AD\u7684\u4E8B\u60C5\u5C31\u662F\u7AA9\u88E1\u9B25\uFF0C\u6240\u4EE5\u6211\u7684\u968A\u4F0D\u523B\u610F\u4FDD\u6301\u8DDD\u96E2\u4EE5\u514D\u767C\u751F\u885D\u7A81."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824044
    m_Localized: "\u53EF\u60DC\u51B7\u7738\u751F\u6027\u591A\u7591\uFF0C\u77E5\u9053\u6211\u6703\u5F71\u97FF\u4ED6\u7684\u90E8\u4E0B\uFF0C\u6240\u4EE5\u4ED6\u8996\u6211\u70BA\u6B0A\u529B\u7AF6\u722D\u8005\uFF0C\u76EE\u524D\u6211\u5728\u76E1\u529B\u5316\u89E3\u77DB\u76FE\uFF0C\u5C31\u7B97\u6211\u5011\u7406\u60F3\u4E0D\u540C\uFF0C\u6211\u4E5F\u5E0C\u671B\u672A\u4F86\u4E0D\u8981\u767C\u751F\u885D\u7A81."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824045
    m_Localized: "\u884C\u4E86\uFF0C\u4E0D\u8AAA\u9592\u8A71\u4E86. \u65E2\u7136\u4F60\u60F3\u548C\u6211\u4E00\u8D77\u53BB\uFF0C\u6700\u597D\u5E36\u4E0A\u4E00\u6D41\u88DD\u5099.
      \u5C24\u5176\u662F\u8B77\u7532. \u96D6\u7136\u6211\u5E0C\u671B\u548C\u5E73\u89E3\u6C7A\uFF0C\u4F46\u4E5F\u8981\u505A\u597D\u6700\u58DE\u6253\u7B97."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824046
    m_Localized: "\u6C92\u554F\u984C\uFF0C\u6211\u6703\u7576\u5FC3\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824047
    m_Localized: "\u627E\u5230\u51B7\u7738\u4E86\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824048
    m_Localized: "\u627E\u5230\u4E86\uFF0C\u64DA\u53EF\u9760\u6D88\u606F\u7A31\uFF0C\u4ED6\u5728\u9644\u8FD1\u7684\u820A\u8ECD\u4E8B\u57FA\u5730\u88E1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824049
    m_Localized: "\u90A3\u73FE\u5728\u51FA\u767C\u5427\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824050
    m_Localized: "\u59B3\u6E96\u5099\u7684\u9084\u4E0D\u5920\u5145\u5206\uFF0C\u4F46\u6211\u5011\u4E0D\u80FD\u518D\u6D6A\u8CBB\u6642\u9593\u4E86
      - \u5982\u679C\u51B7\u7738\u8F49\u79FB\u5230\u9CF4\u99AC\u6307\u63EE\u90E8\uFF0C\u8FFD\u8E64\u4ED6\u5C31\u66F4\u96E3\u4E86.
      \u7ACB\u523B\u51FA\u767C\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824051
    m_Localized: "\u8207\u9435\u9A0E\u885B\u5C0D\u6297"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824052
    m_Localized: "\u5225\u52D5\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824053
    m_Localized: "\u628A\u69CD\u653E\u4E0B\uFF0C\u8B0E\u8A9E. \u662F\u6211\u5011."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824054
    m_Localized: "\u661F\u5149\u8056\u9A0E\u58EB\u9435\u8E44\uFF01\u51B7\u7738\u9577\u8001\u8AAA\u4F60\u80CC\u53DB\u4E86\u6211\u5011\uFF0C\u6211\u5011\u63A5\u5230\u547D\u4EE4\u8981\u69CD\u6583\u4F60."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824055
    m_Localized: "\u4E00\u6D3E\u80E1\u8A00\uFF01\u8B93\u6211\u898B\u4ED6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824056
    m_Localized: "\u6211\u5011\u4E0D\u548C\u53DB\u5F92\u8AC7\u689D\u4EF6. \u958B\u706B\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824057
    m_Localized: "\u95DC\u65BC\u80CC\u53DB"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824058
    m_Localized: "\u525B\u624D\u4EC0\u9EBD\u60C5\u6CC1\uFF0C\u4ED6\u5011\u600E\u9EBD\u53EB\u4F60\u53DB\u5F92\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824059
    m_Localized: "\u8A3B\u5B9A\u5982\u6B64\uFF0C\u51B7\u7738\u4E3B\u52D5\u6311\u8D77\u885D\u7A81\uFF0C\u6B3A\u4EBA\u592A\u751A.
      \u51B7\u7738\u53EF\u80FD\u4EE5\u70BA\u662F\u6211\u6BBA\u4E86\u4ED6\u7684\u90E8\u4E0B\uFF0C\u4E5F\u8A31\u6709\u5225\u7684\u539F\u56E0\uFF0C\u5167\u6230\u5DF2\u7D93\u6253\u97FF\uFF0C\u6211\u5011\u5FC5\u9808\u7ACB\u523B\u884C\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824060
    m_Localized: "\u51B7\u7738\u6436\u4E86\u5148\u6A5F\uFF0C\u9019\u610F\u5473\u8457\u652F\u6301\u6211\u7684\u6230\u53CB\u5011\u6709\u5371\u96AA.
      \u6211\u5FC5\u9808\u7ACB\u523B\u8FD4\u56DE\u57FA\u5730\u8A08\u756B\u4E0B\u4E00\u6B65\u884C\u52D5\uFF0C\u59B3\u53EA\u80FD\u9760\u81EA\u5DF1\u4E86\uFF0C\u4FDD\u8B77\u907F\u96E3\u5EC4\u8207\u5426\u7531\u4F60\u6C7A\u5B9A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824061
    m_Localized: "\u6211\u80FD\u53C3\u52A0\u6230\u9B25\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824062
    m_Localized: "\u96D6\u7136\u6211\u5E0C\u671B\u59B3\u5408\u4F5C\uFF0C\u4F46\u6211\u4E26\u975E\u5B8C\u5168\u4FE1\u4EFB\u59B3\uFF0C\u6211\u7684\u6230\u53CB\u6C92\u6709\u548C\u8F15\u7532\u6B65\u5175\u5171\u540C\u6230\u9B25\u7684\u7D93\u9A57\uFF0C\u59B3\u5F88\u6709\u53EF\u80FD\u6703\u53D7\u50B7.
      \u6700\u597D\u4E0D\u8981\u53C3\u6230."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824064
    m_Localized: "\u8207\u51B7\u7738\u6703\u9762"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824065
    m_Localized: "\u53EF\u60E1\u7684\u91CE\u883B\u99AC\uFF0C\u7ADF\u6562\u5165\u4FB5\u9435\u9A0E\u885B\u57FA\u5730\u6BBA\u5BB3\u6211\u7684\u58EB\u5175."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824066
    m_Localized: "\u4F60\u81EA\u627E\u7684\uFF0C\u4F60\u4E0D\u8A72\u6253\u907F\u96E3\u5EC4
      Pi \u7684\u4E3B\u610F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824067
    m_Localized: "\u9019\u5C31\u662F\u59B3\u7684\u7406\u7531\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824068
    m_Localized: "\u59B3\u6BBA\u4E86\u591A\u5C11\u5C0F\u99AC\uFF1F\u72AF\u4E86\u591A\u5C11\u7F6A\u5B7D\uFF1F\u6211\u5011\u53EA\u60F3\u4FDD\u8B77\u81EA\u5DF1\u7684\u5BB6\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824069
    m_Localized: "\u6240\u4EE5\u4F60\u60F3\u6467\u6BC0\u6211\u7684\u5BB6\uFF1F\u5225\u627E\u501F\u53E3\u4E86"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824070
    m_Localized: "\u907F\u96E3\u5EC4 Pi \u7684\u79D1\u6280\u53EF\u4EE5\u62EF\u6551\u7121\u6578\u5C0F\u99AC\uFF01\u59B3\u9019\u8CAA\u5A6A\u81EA\u79C1\u7684\u7B28\u86CB\uFF0C\u90A3\u4E9B\u79D1\u6280\u672C\u4F86\u5C31\u4E0D\u5C6C\u65BC\u59B3\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824071
    m_Localized: "\u5EE2\u8A71\u5C11\u8AAA...\u53EA\u6709\u4F60\u6B7B\u624D\u80FD\u63DB\u6211\u5BB6\u5712\u5B89\u5168."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824072
    m_Localized: "\u6536\u5230\u9435\u8E44\u7684\u8A0A\u606F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824073
    m_Localized: "\u59B3\u597D @lp. \u770B\u4F86\u6211\u4F4E\u4F30\u59B3\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824074
    m_Localized: "\u600E\u9EBD\u8AAA\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824075
    m_Localized: "\u79D8\u5BC6\u652F\u6301\u6211\u7684\u9435\u9A0E\u885B\u525B\u525B\u901A\u77E5\u6211\u59B3\u6BBA\u4E86\u51B7\u7738\uFF0C\u59B3\u9019\u884C\u70BA\u5341\u5206\u5371\u96AA\u554A\uFF01\n\u5728\u90A3\u4E4B\u524D\uFF0C\u9435\u9A0E\u885B\u4E4B\u524D\u6839\u672C\u4E0D\u62FF\u59B3\u7576\u4E00\u56DE\u4E8B\u5152\uFF0C\u4F46\u59B3\u6BBA\u4E86\u51B7\u7738\u9577\u8001\u5F8C\uFF0C\u4ED6\u7684\u8FFD\u96A8\u8005\u4E0D\u6703\u653E\u904E\u59B3\u7684.
      \u5F9E\u73FE\u5728\u958B\u59CB\uFF0C\u59B3\u8981\u591A\u52A0\u5C0F\u5FC3\u65C5\u884C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824076
    m_Localized: "\u8FFD\u96A8\u8005\uFF1F\u4ED6\u6B7B\u4E86\u885D\u7A81\u4E0D\u5C31\u7D50\u675F\u4E86\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824077
    m_Localized: "\u4E26\u975E\u5982\u6B64. \u885D\u7A81\u53EA\u6703\u9032\u4E00\u6B65\u767C\u9175.
      \u9019\u662F\u4E0D\u53EF\u907F\u514D\u7684. \u552F\u4E00\u963B\u6B62\u8840\u6D41\u6210\u6CB3\u7684\u8FA6\u6CD5\u5C31\u662F\u6211\u4E0B\u53F0\uFF0C\u9000\u51FA\u9435\u9A0E\u885B.
      \u4E5F\u8A31\u6211\u61C9\u8A72\u9019\u6A23\u505A\uFF0C\u5DF2\u7D93\u6709\u592A\u591A\u6230\u53CB\u56E0\u51B7\u7738\u800C\u6B7B\uFF0C\u672A\u4F86\u9084\u6703\u6709\u66F4\u591A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824078
    m_Localized: "\u6211\u60F3\u59B3\u9700\u8981\u77E5\u9053\u4E00\u4E9B\u4E8B\u60C5.
      \u65E2\u7136\u59B3\u4E5F\u5805\u5B9A\u4E0D\u79FB\u5730\u53CD\u5C0D\u51B7\u7738\u7684\u4E3B\u5F35\uFF0C\u6211\u6C7A\u5B9A\u4FE1\u4EFB\u59B3.
      \u6211\u8A8D\u70BA\u662F\u6642\u5019\u70BA\u60A8\u63D0\u4F9B\u53EF\u4EE5\u5E6B\u52A9\u60A8\u7684\u60C5\u5831."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824079
    m_Localized: "\u9996\u5148\uFF0C\u51B7\u7738\u548C\u6591\u99AC\u8ECD\u5718\u4F3C\u4E4E\u84C4\u8B00\u5DF2\u4E45.
      \u4E0A\u5230\u6307\u63EE\u90E8\u4E0B\u5230\u666E\u901A\u58EB\u5175\u90FD\u63A5\u53D7\u4E86\u7D50\u76DF\u9019\u4E00\u4E8B\u5BE6.
      \u4ED6\u5011\u672A\u4F86\u9084\u6703\u7E7C\u7E8C\u5408\u4F5C\uFF0C\u4E0D\u6392\u9664\u6591\u99AC\u8ECD\u5718\u52A0\u5165\u6230\u9B25\u7684\u53EF\u80FD\u6027.
      \u7D50\u76DF\u539F\u56E0\u4E0D\u5F97\u800C\u77E5\uFF0C\u6211\u7684\u90E8\u4E0B\u6B63\u5728\u52AA\u529B\u641C\u96C6\u5FC5\u8981\u7684\u60C5\u5831."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824080
    m_Localized: "\u5176\u6B21\uFF0C\u51B7\u7738\u64C1\u6709\u5BE6\u9A57\u6027\u6230\u9B25\u5916\u9AA8\u9ABC\u8A2D\u8A08\u5716\uFF0C\u6B63\u7531\u59B3\u7684\u907F\u96E3\u5EC4\u9032\u884C\u958B\u767C.
      \u6240\u4EE5\u4ED6\u624D\u5C0D\u907F\u96E3\u5EC4 Pi \u611F\u8208\u8DA3. \u9019\u7A2E\u88DD\u5099\u65E2\u662F\u8B77\u7532\u4E5F\u662F\u6B66\u5668.
      \u64C1\u6709\u5F37\u5927\u7684\u6230\u9B25\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824081
    m_Localized: "\u4F46\u662F\u751F\u7522\u6709\u4E00\u500B\u5148\u6C7A\u689D\u4EF6\uFF1A\u9700\u8981\u4E00\u4EF6\u53F2\u524D\u795E\u5668\uFF0C\u9019\u65B9\u9762\u6211\u4E0D\u4E86\u89E3\uFF0C\u5176\u5BE6\u6211\u62FF\u5230\u8A2D\u8A08\u5716\u5F8C\u624D\u77E5\u9053\u6709\u9019\u7A2E\u6771\u897F.
      \"\u592A\u967D\" \u9805\u76EE\u548C \"\u5F69\u8679\" \u9805\u76EE\u90FD\u9700\u8981\u9019\u53E4\u795E\u5668.
      \u6211\u60F3\u59B3\u96E2\u958B\u907F\u96E3\u5EC4\u5C31\u662F\u70BA\u4E86\u5C0B\u627E\u5B83\u5011\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824082
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824083
    m_Localized: "\u6211\u4E0D\u6703\u6436\u8D70\u6216\u8005\u653B\u64CA\u59B3\u7684\u907F\u96E3\u5EC4\uFF0C\u6211\u4EE5\u8056\u9A0E\u58EB\u7684\u540D\u8B7D\u64D4\u4FDD.
      \u6575\u99AC\u7684\u6575\u99AC\u5C31\u662F\u670B\u53CB. \u59B3\u5E6B\u4E86\u6211\uFF0C\u6211\u4E5F\u5E6B\u59B3.
      \u5982\u679C\u9CF4\u99AC\u548C\u6591\u99AC\u5175\u5718\u8972\u64CA\u907F\u96E3\u5EC4
      Pi \uFF0C\u6211\u5011\u6703\u5354\u52A9\u9632\u5B88."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824084
    m_Localized: "\u90A3\u771F\u662F\u592A\u597D\u4E86\uFF0C\u8B1D\u8B1D\u4F60. \u6211\u5E0C\u671B\u6211\u7684\u907F\u96E3\u5EC4\u5E73\u5B89\u7121\u4E8B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824085
    m_Localized: "\u5E0C\u671B\u662F\u4E0D\u53EF\u9760\u7684. \u6211\u5011\u7684\u6575\u99AC\u5F88\u5F37\u5927\uFF0C\u60F3\u8981\u4FDD\u8B77\u81EA\u5DF1\u514D\u53D7\u4ED6\u5011\u7684\u50B7\u5BB3\u5C31\u5FC5\u9808\u8981\u505A\u597D\u6E96\u5099.
      \u5FE0\u65BC\u6211\u7684\u5144\u5F1F\u6703\u9A0E\u58EB\u5DF2\u7D93\u53C3\u6230\uFF0C\u5305\u62EC\u9632\u5B88\u91CD\u8981\u64DA\u9EDE\u548C\u89E3\u6551\u88AB\u7B2C\u4E00\u6CE2\u653B\u64CA\u4FD8\u865C\u7684\u9435\u9A0E\u885B.
      \u4E5F\u8A31\u672A\u4F86\u6703\u6709\u66F4\u591A\u65B0\u53C3\u8207\u8005\u52A0\u5165\u6211\u5011\uFF0C\u7121\u8AD6\u662F\u81EA\u9858\u9084\u662F\u53CD\u5C0D."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824086
    m_Localized: "\u4E0D\u50C5\u50C5\u662F\u6211\u5011\u548CPi\u907F\u96E3\u5EC4\uFF0C\u5F88\u591A\u5C0F\u99AC\u90FD\u6709\u5371\u96AA.
      \u6211\u771F\u662F\u592A\u81EA\u79C1\u4E86. \u6211\u5FC5\u9808\u7ACB\u5373\u96E2\u958B\u8B66\u544A\u9644\u8FD1\u5169\u500B\u805A\u843D\u5373\u5C07\u5230\u4F86\u7684\u5A01\u8105\uFF0C\u9632\u6B62\u4ED6\u5011\u88AB\u9435\u9A0E\u885B\u6216\u8005\u6591\u99AC\u8ECD\u5718\u5077\u8972\uFF0C\u6253\u5F97\u63AA\u8E44\u4E0D\u53CA."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824087
    m_Localized: "\u6211\u7406\u89E3. \u59B3\u53BB\u8B66\u544A\u4ED6\u5011\u5427\uFF0C\u6211\u5728\u9019\u5152\u7B49\u59B3\uFF0C\u6211\u5011\u53EF\u80FD\u9700\u8981\u4F60\u7684\u5E6B\u52A9."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824088
    m_Localized: "\u5730\u5821"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824089
    m_Localized: "\u9644\u8FD1\u6709\u51B7\u7738\u9435\u9A0E\u885B\u7684\u6230\u7565\u8981\u5730\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824090
    m_Localized: "\u6709\uFF0C\u6771\u5357\u908A\u6709\u4E00\u5EA7\u6230\u524D\u5730\u5821\uFF0C\u662F\u6211\u5011\u5206\u90E8\u7684\u4E00\u8655\u4E3B\u8981\u57FA\u5730\uFF0C\u4F46\u9632\u5B88\u68EE\u56B4\uFF0C\u6211\u4E0D\u5EFA\u8B70\u59B3\u53BB."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824091
    m_Localized: "\u90A3\u53EF\u4E0D\u4E00\u5B9A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824092
    m_Localized: "\u9019\u4E0D\u4E00\u6A23\uFF0C@lp. \u90A3\u5EA7\u5730\u5821\u5C08\u9580\u662F\u61C9\u5C0D\u5C0F\u578B\u8ECD\u968A\u653B\u64CA\u7684.
      \u95DC\u9589\u72C0\u614B\u4E0B\u7684\u5730\u5821\u5C31\u9023\u70FD\u706B\u70B8\u5F48\u4E5F\u9632\u5F97\u4F4F\uFF0C\u60F3\u8981\u5FB9\u5E95\u4F54\u9818\u7684\u8A71\uFF0C\u9700\u8981\u570D\u653B\u597D\u5E7E\u500B\u6708\u624D\u884C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824093
    m_Localized: "\u5360\u9818\u8981\u82B1\u5E7E\u500B\u6708\uFF0C\u90A3\u6F5B\u5165\u5462\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824094
    m_Localized: "\u6211\u4E0D\u662F\u4F60\u7684\u4E0A\u7D1A\uFF0C@lp. \u4F46\u6211\u8A8D\u70BA\u59B3\u4E0D\u503C\u5F97\u53BB\u5192\u9019\u500B\u96AA.
      \u6211\u5011\u6709\u66F4\u8981\u7DCA\u7684\u4E8B\u60C5\u8981\u505A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824095
    m_Localized: "\u5982\u679C\u59B3\u4F9D\u7136\u8981\u53BB...\u7D66\u59B3\u500B\u5EFA\u8B70
      - \u53BB\u898B\u4E00\u4E0B\u7D05\u83A7\u83DC\u5B78\u58EB. \u5979\u6216\u8A31\u80FD\u5E6B\u59B3\u9032\u5165\u5730\u5821.
      \u6211\u8981\u53BB\u5FD9\u5225\u7684\u4E8B\u60C5\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824096
    m_Localized: "\"\u9A30\u98DB\u5C0F\u99AC\" \u71DF\u5730\u7684\u5A01\u8105"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824097
    m_Localized: "@lp\uFF01 \u59B3\u56DE\u4F86\u4E86\uFF1F\u592A\u597D\u4E86\uFF01\u4E2D\u5FC3\u57CE\u90A3\u6A01\u4E8B\u5152\u89E3\u6C7A\u4E86\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824098
    m_Localized: "\u90FD\u89E3\u6C7A\u4E86\uFF0C\u4F46\u6211\u5011\u73FE\u5728\u6709\u66F4\u56B4\u91CD\u7684\u60C5\u6CC1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824099
    m_Localized: "\"\u6211\u5011\"\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824100
    m_Localized: "\u58DE\u6D88\u606F\u4F86\u4E86\uFF0C\u96DE\u5C3E\u9152. \u60C5\u6CC1\u5F88\u56B4\u91CD.\n\u9CF4\u99AC\u5206\u90E8\u7684\u9435\u9A0E\u885B\u548C\u6591\u99AC\u8ECD\u5718\u52FE\u642D\u5230\u4E86\u4E00\u8D77.
      \u5927\u5BB6\u90FD\u4E0D\u559C\u6B61\u9019\u6A23. \u5317\u908A\u5F88\u5FEB\u5C31\u8981\u6253\u5167\u6230\u4E86.
      \u6050\u6015\u9019\u88E1\u4E5F\u6703\u906D\u5230\u6CE2\u53CA."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824101
    m_Localized: "\"\u6211\u5011\u7684\u71DF\u5730\"\uFF0C\u554A..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824102
    m_Localized: "\u60C5\u6CC1\u7684\u78BA\u56B4\u5CFB.  @lp\uFF0C\u59B3\u80AF\u5B9A\u662F\u8A8D\u771F\u7684\u624D\u6703\u4F86\u901A\u77E5\u6211\u5011.
      \u65E2\u7136\u9019\u6A23\uFF0C\u6211\u5011\u78BA\u5BE6\u8981\u505A\u597D\u6E96\u5099."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824103
    m_Localized: "\u6211\u6703\u5B89\u6392\u65B0\u7684\u54E8\u5175\uFF0C\u885B\u968A\u9577\u548C\u6211\u4E5F\u6703\u52A0\u500D\u7A7A\u4E2D\u5DE1\u908F.
      \u8AB0\u4E5F\u904E\u4E0D\u4F86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824104
    m_Localized: "\u9084\u9700\u8981\u66F4\u591A\u5927\u69CD\uFF0C\u4E00\u822C\u6B65\u69CD\u53EF\u6253\u4E0D\u7A7F\u90A3\u7FA4\u9435\u7F50\u982D.
      \u771F\u662F\u592A\u96E3\u8FA6\u4E86..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824105
    m_Localized: "\u6211\u80FD\u5E6B\u4E0A\u5FD9\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824106
    m_Localized: "\u6C92\u95DC\u4FC2\u7684\uFF0C\u6211\u5011\u6709\u5145\u5206\u7684\u9632\u79A6\u7D93\u9A57\uFF0C\u4F46\u59B3\u60F3\u5E6B\u5FD9\u7684\u8A71\u66F4\u597D."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824107
    m_Localized: "\u8A71\u8AAA\u59B3\u53EF\u4EE5\u5E6B\u52A9\u6211\u5011\u7684\u8B77\u7532\u5546\u5805\u6BC5\u6A61\u6728."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824108
    m_Localized: "\u707D\u5384\u8AAA\u5F97\u5C0D\uFF0C\u4E00\u822C\u4EBA\u6211\u4E0D\u544A\u8A34\u4ED6\uFF0C\u4F46\u6211\u76F8\u4FE1\u59B3.
      \u6A61\u6728\u4E4B\u524D\u662F\u9435\u9A0E\u885B\uFF0C\u6211\u4E0D\u77E5\u9053\u4ED6\u9000\u51FA\u7684\u539F\u56E0.
      \u4ED6\u5F9E\u4F86\u4E5F\u4E0D\u8B1B. \u4F46\u4ED6\u95DC\u65BC\u9435\u9A0E\u885B\u7684\u77E5\u8B58\u80FD\u6D3E\u4E0A\u7528\u5834\uFF0C\u5982\u679C\u4ED6\u9700\u8981\u4EC0\u9EBD\uFF0C\u59B3\u76E1\u91CF\u66FF\u4ED6\u5B8C\u6210."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824109
    m_Localized: "\u6211\u6703\u8DDF\u4ED6\u8AAA\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824110
    m_Localized: "\u563F @lp. \u4F60\u770B\u8D77\u4F86\u5FC3\u4E8B\u91CD\u91CD\u7684\uFF0C\u600E\u9EBD\u4E86\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824111
    m_Localized: "\u563F\uFF0C\u96DE\u5C3E\u9152\u8AAA\u4F60\u4E4B\u524D\u662F\u9435\u9A0E\u885B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824112
    m_Localized: "\u5443...\u6C92\u932F\uFF0C\u6211\u662F.\n\u885B\u968A\u9577\u4E0D\u6703\u5E73\u767D\u7121\u6545\u544A\u8A34\u59B3\u7684\uFF0C\u8AAA\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824113
    m_Localized: "\u9CF4\u99AC\u5206\u90E8\u7684\u9435\u9A0E\u885B\u5728\u4E92\u76F8\u6B98\u6BBA.
      \u5176\u4E2D\u4E00\u908A\u8DDF\u6591\u99AC\u8ECD\u5718\u806F\u8E44\uFF0C\u6211\u5011\u5F88\u53EF\u80FD\u88AB\u88AB\u6CE2\u53CA."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824114
    m_Localized: "\u554A\uFF0C\u6211...\u771F\u7684\u6C92\u60F3\u5230\uFF0C\u9019\u662F\u600E\u9EBD\u56DE\u4E8B\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824115
    m_Localized: "\u9577\u8A71\u77ED\u8AAA\uFF0C\u9435\u9A0E\u885B\u9577\u8001\u91CE\u5FC3\u81A8\u8139\u56DB\u8655\u6A39\u6575."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824116
    m_Localized: "\u51B7\u7738\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824117
    m_Localized: "\u6C92\u932F\uFF0C\u5C31\u662F\u4ED6\uFF0C\u4F60\u8A8D\u8B58\u4ED6\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824118
    m_Localized: "\u7576\u7136\u8A8D\u8B58\uFF0C\u5148\u4E0D\u8AC7\u904E\u53BB\uFF0C\u59B3\u5E0C\u671B\u6211\u505A\u4EC0\u9EBD\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824119
    m_Localized: "\u6B63\u78BA\u7684\u554F\u984C\u662F\uFF1A\u4F60\u60F3\u8B93\u6211\u505A\u4EC0\u9EBC.
      \u4F60\u662F\u9435\u9A0E\u885B\u5C08\u5BB6\uFF0C\u4F60\u61C9\u8A72\u77E5\u9053\u5982\u4F55\u624D\u80FD\u4FDD\u8B77\u5927\u5BB6\u5427\uFF01
      \u5982\u679C\u60A8\u9700\u8981\u5E6B\u52A9\uFF0C\u6211\u96A8\u6642\u6E96\u5099\u63D0\u4F9B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824120
    m_Localized: "\u90A3\u597D\u5427\uFF0C\u6211\u7576\u7136\u4E0D\u80FD\u99AC\u4E0A\u60F3\u51FA\u4E00\u500B\u5B8C\u6574\u7684\u8A08\u756B.
      \u4F46\u6211\u5C0D\u9019\u500B\u8A08\u756B\u6709\u4E00\u4E9B\u60F3\u6CD5......"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824121
    m_Localized: "\u795E\u79D8\u6751\u838A\u7684\u5A01\u8105"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824122
    m_Localized: "\u518D\u6B21\u76F8\u9047\u771F\u597D @lp. \u6709\u6C92\u6709\u4EC0\u9EBD\u6D88\u606F\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824123
    m_Localized: "\u4E0D\u5E78\u7684\u662F\uFF0C\u7684\u78BA\u6709\u4E00\u500B\u58DE\u6D88\u606F.\n\u6700\u8FD1\u6211\u9677\u5165\u4E86\u7121\u5948\u7684\u60C5\u6CC1\uFF0C\u6211\u9084\u6709\u8A31\u591A\u9A5A\u609A\u7684\u6D88\u606F\u8981\u544A\u8A34\u4F60."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824124
    m_Localized: "\u4E2D\u5FC3\u57CE\u767C\u751F\u4EC0\u9EBC\u4E8B\u4E86\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824125
    m_Localized: "\u9060\u9060\u4E0D\u6B62. \u6211\u5011\u8AC7\u8AD6\u7684\u4E0D\u50C5\u50C5\u662F\u53E4\u8001\u7684\u5EE2\u589F.\n         
      \u6211\u7121\u610F\u9593\u767C\u73FE\u9435\u9A0E\u885B\u9CF4\u99AC\u5206\u90E8\u548C\u6591\u99AC\u8ECD\u5718\u52FE\u7D50\uFF0C\u539F\u56E0\u4E0D\u5F97\u800C\u77E5.
      \u4F46\u73FE\u5728\u9435\u9A0E\u885B\u958B\u59CB\u4E86\u5167\u6230\uFF0C\u898F\u6A21\u9010\u6F38\u5347\u7D1A.
      \u8003\u616E\u5230\u4ED6\u5011\u7684\u8A31\u591A\u76EE\u6A19\u90FD\u76F8\u5C0D\u9760\u8FD1\u96B1\u79D8\u6751\u838A\uFF0C\u6211\u5F88\u64D4\u5FC3\u4F60\u5011\u53EF\u80FD\u6703\u8655\u65BC\u5371\u96AA\u4E4B\u4E2D\uFF0C\u4E0D\u7BA1\u662F\u9435\u9A0E\u885B\u9084\u662F\u6591\u99AC\u8ECD\u5718\u90FD\u5F88\u5371\u96AA."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824126
    m_Localized: "\u5F88\u68D8\u8E44\u554A\uFF0C\u592A\u68D8\u8E44\u4E86. \u59B3\u5C0D\u81EA\u5DF1\u7684\u8A71\u6709\u4FE1\u5FC3\uFF1F
      @lp\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824127
    m_Localized: "\u7D55\u5C0D\u6709."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824128
    m_Localized: "\u90A3\u770B\u4F86\u6211\u5011\u53EA\u80FD\u88AB\u8FEB\u52A0\u5F37\u5DE1\u908F\u4E86.
      \u672C\u4F86\u5C0B\u627E\u88DC\u7D66\u7684\u6591\u99AC\u5C31\u4E0D\u5920\uFF0C\u9019\u4E0B\u96EA\u4E0A\u52A0\u971C\u4E86.
      \u6211\u8981\u5EFA\u7ACB\u71DF\u5730\u8B70\u6703\uFF0C\u5171\u540C\u6C7A\u5B9A\u672A\u4F86\u8A08\u756B\uFF0C\u6211\u5011\u5F88\u53EF\u80FD\u9700\u8981\u4F60\u7684\u5E6B\u52A9.
      @lp. \u5982\u679C\u4F60\u9858\u610F\u5C31\u597D\u4E86\uFF0C\u96D6\u7136\u6211\u5011\u7121\u4EE5\u56DE\u5831\uFF0C\u4F46\u9EDE\u6EF4\u5E6B\u52A9\u5C31\u80FD\u8D77\u5F88\u5927\u4F5C\u7528."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824129
    m_Localized: "\u6211\u6703\u76E1\u529B\u800C\u70BA."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824130
    m_Localized: "\u6211\u5011\u6703\u8B70\u5C07\u505A\u51FA\u5C0D\u6211\u5011\u6975\u70BA\u91CD\u8981\u7684\u6C7A\u5B9A.
      \u6C92\u6709\u6211\u5011\u7684\u9996\u5E2D\u5075\u5BDF\u5175\uFF0C\u6211\u5011\u7121\u6CD5\u6C7A\u5B9A\u793E\u5340\u7684\u547D\u904B\uFF0C\u800C\u4E14\u4ED6\u5011\u88DC\u7D66\u9084\u6C92\u56DE\u4F86.
      \u7576\u4ED6\u5011\u56DE\u4F86\u7684\u6642\u5019\u6211\u6703\u901A\u77E5\u59B3\uFF0C\u6211\u5011\u6703\u8A08\u756B\u6211\u5011\u9032\u4E00\u6B65\u7684\u884C\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824131
    m_Localized: "\u7559\u610F\u4F60\u7684\u500B\u99AC\u7269\u54C1\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824132
    m_Localized: "\u8271\u96E3\u6642\u671F\u5373\u5C07\u5230\u4F86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824133
    m_Localized: "\u5354\u9632 \"\u9A30\u98DB\u5C0F\u99AC\" \u71DF\u5730"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824134
    m_Localized: "\u597D\u5427\uFF0C\u70BA\u4E86\u62B5\u79A6\u9435\u9A0E\u885B\u9019\u6A23\u7684\u5F37\u6575...\n\u6211\u5011\u7D55\u5C0D\u9700\u8981\u91CD\u6B66\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824135
    m_Localized: "\u6211\u6709\u4E00\u4E9B\u53EF\u9760\u7684\u6D88\u606F\u4F86\u6E90..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824136
    m_Localized: "\u4E0D\uFF0C@lp. \u91CD\u6B66\u529B.\n\u5982\u679C\u6211\u5011\u80FD\u7528\u53CD\u5668\u6750\u6B65\u69CD\u6B66\u88DD\u81EA\u5DF1\uFF0C\u6211\u5011\u4E5F\u8A31\u80FD\u5920\u8207\u52D5\u529B\u88DD\u7532\u9032\u884C\u4E00\u5834\u5E73\u5206\u79CB\u8272\u7684\u6230\u9B25.
      \u4F46\u8ACB\u76F8\u4FE1\u6211: \u51B7\u7738\u7684\u9435\u9A0E\u885B\u4E26\u4E0D\u5BB3\u6015\u5E73\u7B49\u6230\u9B25.
      \u5982\u679C\u4ED6\u5011\u6C7A\u5B9A\u7C89\u788E\u6211\u5011\uFF0C\u4ED6\u5011\u4E0D\u6703\u505C\u6B62\uFF0C\u5373\u4F7F\u6211\u5011\u8D0F\u4E86\uFF0C\u6211\u5011\u4E5F\u6703\u70BA\u9019\u6A23\u7684\u52DD\u5229\u4ED8\u51FA\u592A\u591A\u4EE3\u50F9."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824137
    m_Localized: "\u5982\u679C\u6211\u5011\u4E0D\u80FD\u8B93\u9435\u9A0E\u885B\u5BB3\u6015\u6211\u5011\uFF0C\u90A3\u9EBC\u6211\u5011\u81F3\u5C11\u5FC5\u9808\u63A8\u9072\u4ED6\u5011\u5C0D\u71DF\u5730\u7684\u8972\u64CA.
      \u800C\u9019\u53EA\u6709\u5728\u653B\u6253\"\u9A30\u98DB\u5C0F\u99AC\"\u71DF\u5730\u5929\u50F9\u6210\u672C\u7684\u60C5\u6CC1\u4E0B\u624D\u80FD\u5BE6\u73FE."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824138
    m_Localized: "\u8001\u5BE6\u8AAA\uFF0C\u6211\u4E0D\u78BA\u5B9A\u5982\u4F55\u505A\u5230\u9019\u4E00\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824139
    m_Localized: "\u5E78\u904B\u7684\u662F\uFF0C\u6211\u78BA\u5B9A\u5920\u7528\u4E86.
      \u807D\u8457.\n\u7576\u6211\u5728\u9435\u9A0E\u885B\u6642\uFF0C\u6211\u5011\u53EF\u4EE5\u5B58\u53D6\u5305\u542B\u6211\u5011\u5DE5\u5EE0\u8A73\u7D30\u5730\u5716\u7684\u6A94\u6848.
      \u5F9E\u90A3\u88E1\u6211\u5011\u4E86\u89E3\u4E86\u7528\u65BC\u88FD\u9020\u6D77\u8ECD\u706B\u7832\u548C\u5F48\u85E5\u7684\u914D\u7DDA\u5716\uFF0C\u9019\u4E9B\u914D\u7DDA\u5716\u653E\u7F6E\u5728\u5730\u4E0B\u6A13\u5C64.
      \u78BA\u5207\u5730\u8AAA\uFF0C\u662F\u9A45\u9010\u8266\u7684\u706B\u7832. \u8239\u7528\u5C0F\u53E3\u5F91\u706B\u7832\uFF0C\u5C0D\u6211\u5011\u4F86\u8AAA\u8DB3\u5920\u5927\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824140
    m_Localized: "\u6211\u5011\u9435\u9A0E\u885B\u65E9\u5C31\u8A72\u8655\u7406\u5B83\u5011\u4E86\uFF0C\u4F46\u5B83\u5011\u5728\u5EE2\u571F\u4E0A\u7528\u8655\u4E0D\u5927\uFF0C\u800C\u4E14\u6211\u5011\u7E3D\u662F\u6709\u66F4\u91CD\u8981\u7684\u4E8B\u60C5\u8981\u505A.
      \u73FE\u5728\u5B83\u5728\u6211\u5011\u7684\u8E44\u5B50\u88E1\u767C\u63EE\u4F5C\u7528\u4E86\uFF0C\u5C31\u5728\"\u9A30\u98DB\u5C0F\u99AC\"
      \u7684\u8E44\u5B50."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824141
    m_Localized: "\u6240\u4EE5\u6211\u5FC5\u9808\u63A2\u7D22\u90A3\u4E9B\u751F\u7522\u7DDA\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824142
    m_Localized: "\u5982\u679C\u59B3\u771F\u7684\u9858\u610F\u5E6B\u5FD9\uFF0C\u90A3\u6C92\u932F.
      \u6211\u6703\u544A\u8A34\u59B3\u8981\u5230\u5730\u623F\u9593\u7684\u78BA\u5207\u4F4D\u7F6E\uFF0C\u7136\u5F8C\u59B3\u9700\u8981\u53BB\u78BA\u8A8D\u5009\u5EAB\u88E1\u662F\u5426\u81F3\u5C11\u6709\u5E7E\u500B\u9019\u6A23\u7684\u6B66\u5668\u7CFB\u7D71.
      \u4E26\u78BA\u4FDD\u7576\u6211\u5011\u7684\u62FE\u8352\u968A\u5230\u4F86\u6642\uFF0C\u4ED6\u5011\u4E0D\u6703\u906D\u5230\u4F86\u81EA\u5B89\u4FDD\u7832\u5854\u7684\u706B\u529B\u653B\u64CA.
      \u9019\u5C0D\u59B3\u4F86\u8AAA\u53EF\u662F\u770B\u5BB6\u672C\u9818."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824143
    m_Localized: "\"\u9A30\u98DB\u5C0F\u99AC\" \u71DF\u5730\u5B89\u5168\u4E86"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824144
    m_Localized: "\u641E\u5B9A\uFF0C\u6A61\u6A39. \u5009\u5EAB\u9084\u662F\u653E\u6EFF\u4E86\u5F88\u591A\u7832\u5F48\uFF0C\u7121\u8AD6\u662F\u6A5F\u5668\u99AC\u9084\u662F\u7832\u5854\u5728\u4E5F\u4E0D\u6703\u653B\u64CA\u4EFB\u4F55\u5728\u90A3\u88E1\u62FE\u8352\u7684\u5C0F\u99AC\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824145
    m_Localized: "\u975E\u5E38\u597D. \u8AAA\u5BE6\u8A71\uFF0C\u5373\u4F7F\u53EA\u6301\u6709\u9019\u6A23\u4E00\u7A2E\u6B66\u5668\uFF0C\u4E5F\u8DB3\u4EE5\u8B93\u51B7\u7738\u7684\u8ECD\u968A\u5728\u653B\u64CA\u6211\u5011\u4E4B\u524D\u518D\u4E09\u601D\uFF0C\u4F46\u64C1\u6709\u984D\u5916\u7684\u6B66\u5668\u4E5F\u7121\u59A8.\n\u6211\u5011\u4E0D\u80FD\u628A\u8F2A\u5B50\u88DD\u5728\u4E0A\u9762\u7576\u4F5C\u9032\u653B\u6027\u6B66\u5668\uFF0C\u4F46\u4F5C\u9632\u79A6\u6B66\u5668\u5C31\u7DBD\u7DBD\u6709\u9918\u4E86.
      \u73FE\u5728\u6211\u5011\u6709\u5F88\u591A\u5DE5\u4F5C\u8981\u505A\uFF0C\u6211\u53EA\u5E0C\u671B\u6211\u5011\u9084\u4E0D\u7B97\u592A\u665A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824146
    m_Localized: "\u5982\u679C\u54EA\u88E1\u51FA\u73FE\u554F\u984C\uFF0C\u6211\u5E0C\u671B\u6211\u548C\u9435\u8E44\u7684\u9435\u9A0E\u885B\u80FD\u8DB3\u5920\u63A5\u8FD1\u4EE5\u9032\u884C\u63F4\u52A9."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824147
    m_Localized: "\u9435\u8E44\uFF1F \u5982\u679C\u662F\u4ED6\u53CD\u5C0D\u51B7\u7738\uFF0C\u90A3\u60A8\u4E0D\u5FC5\u64D4\u5FC3.
      \u90A3\u96BB\u8001\u72D0\u72F8\u5230\u8655\u90FD\u6709\u8033\u6735. \u51B7\u7738\u771F\u7684\u4E0D\u8A72\u8E29\u904E\u4ED6\u7684\u5E95\u7DDA:
      \u6055\u6211\u76F4\u8A00\uFF0C\u4ED6\u6839\u672C\u7121\u6CD5\u64CA\u6557\u4E00\u500B\u64C1\u6709\u8FD1\u5169\u767E\u5E74\u7D93\u9A57\u7684\u6307\u63EE\u5B98."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824148
    m_Localized: "\u64C1\u6709\u591A\u5C11\u5E74\u7D93\u9A57\uFF1F\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824149
    m_Localized: "\u59B3\u4E0D\u77E5\u9053\uFF1F \u9435\u8E44\u662F\u500B\u4E2D\u5FC3\u57CE\u5C4D\u9B3C.
      \u4ED6\u66FE\u7D93\u6B77\u904E\u90A3\u5834\u5927\u6230. \u59B3\u65E9\u8A72\u544A\u77E5\u6211\u4ED6\u662F\u6211\u5011\u7684\u76DF\u53CB.
      \u4ED6\u5728\u9435\u9A0E\u885B\u4E2D\u64C1\u6709\u5F88\u5927\u7684\u6B0A\u5A01.
      \u800C\u4E14\u4ED6\uFF0C\u4E0D\u540C\u65BC\u51B7\u7738\uFF0C\u4ED6\u5C0D\u5F85\u5EE2\u571F\u5C0F\u99AC\u8DB3\u5920\u53CB\u5584.
      \u5982\u679C \"\u9A30\u98DB\u5C0F\u99AC\" \u771F\u7684\u88AB\u6372\u5165\u6230\u722D\uFF0C\u6211\u5011\u61C9\u8A72\u6975\u529B\u722D\u53D6\u5C0D\u4ED6\u7684\u652F\u6301."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824150
    m_Localized: "\u6211\u6C92\u6599\u5230\u662F\u9019\u6A23\uFF0C\u771F\u7684. \u4F46\u4F60\u662F\u5C0D\u7684:
      \u5982\u679C\u51B7\u7738\u7684\u8ECD\u968A\u8972\u64CA\u548C\u5E73\u7684\u64DA\u9EDE\uFF0C\u4ED6\u6703\u963B\u6B62.\n\u8001\u5BE6\u8AAA\uFF0C\u81F3\u5C11\u9084\u6709\u4E00\u500B\u64DA\u9EDE\u80AF\u5B9A\u9700\u8981\u5E6B\u52A9.
      \u6240\u4EE5\u9664\u975E\u9019\u88E1\u9084\u9700\u8981\u6211\uFF0C\u6211\u6700\u597D\u5FEB\u9EDE\u8D95\u53BB\u90A3\u88E1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824151
    m_Localized: "\u6B72\u4E0D\u8207\u6211\uFF0C\u662F\u5427\uFF1F \u597D\uFF0C\u53BB\u5427\uFF01
      \u63A5\u4E0B\u4F86\u6211\u5011\u81EA\u5DF1\u4F86\u5C31\u53EF\u4EE5\u4E86\uFF01.\n\u5982\u679C\u60A8\u9047\u5230\u9435\u8E44\uFF0C\u8ACB\u5411\u6211\u554F\u597D.
      \u800C\u4E14\u4E5F\u8B1D\u8B1D\u59B3\u544A\u8A34\u6211\u5011\u95DC\u65BC\u4ED6\u7684\u4E8B.
      \u4E5F\u8A31\u9019\u662F\u6211\u5011\u8FD1\u671F\u5F97\u5230\u904E\u6700\u597D\u7684\u6D88\u606F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824152
    m_Localized: "\u7F8E\u597D\u7684\u4E00\u5929\uFF0C@lp. \u59B3\u4F86\u5F97\u6B63\u662F\u6642\u5019:
      \u6211\u5011\u8B70\u6703\u7684\u6240\u6709\u6210\u54E1\u90FD\u5DF2\u7D93\u5B8C\u6210\u4E86\u63A2\u96AA.
      \u4ECA\u665A\u6211\u5011\u5C07\u958B\u6703\u8A0E\u8AD6\u6211\u5011\u7684\u4E0B\u4E00\u6B65\u884C\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824153
    m_Localized: "\u5F88\u597D. \u5C07\u6703\u6709\u5F88\u591A\u8981\u8A0E\u8AD6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824154
    m_Localized: "\u96B1\u5BC6\u6751\u838A\u6703\u8B70"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824155
    m_Localized: "\u6211\u5011\u90FD\u77E5\u9053\u70BA\u4EC0\u9EBC\u6211\u5011\u6703\u5728\u9019\u88E1.
      \u6211\u5011\u5C31\u4E0D\u6D6A\u8CBB\u6642\u9593: @lp\uFF0C\u8A73\u7D30\u544A\u8A34\u6211\u5011\u4EC0\u9EBC\u6A23\u7684\u5A01\u8105\u8FEB\u5728\u7709\u776B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824156
    m_Localized: "\u6211\u8B1B\u5B8C\u4E86\uFF0C\u6C92\u4EC0\u9EBC\u8981\u88DC\u5145\u7684\u4E86.
      \u6591\u99AC\u8ECD\u5718\u548C\u9CF4\u99AC\u9435\u9A0E\u885B\u7D50\u76DF. \u70BA\u4EC0\u9EBC\u548C\u53CD\u5C0D\u4EC0\u9EBC
      - \u6211\u4E0D\u77E5\u9053. \u7136\u800C\uFF0C\u4ED6\u5011\u6B63\u8A08\u756B\u8972\u64CA...
      \u6211\u7684\u5BB6. \u9019\u500B\u806F\u76DF\u5C0E\u81F4\u4E86\u9435\u9A0E\u885B\u7684\u5167\u9B28.
      \u4E00\u5834\u516C\u958B\u7684\u6B66\u88DD\u885D\u7A81\u73FE\u5728\u6B63\u5728\u7206\u767C\uFF0C\u76F4\u5230\u5176\u4E2D\u4E00\u65B9\u5FB9\u5E95\u6BC0\u6EC5\u624D\u53EF\u80FD\u7D50\u675F.
      \u9019\u610F\u5473\u8457\uFF0C\u5F88\u53EF\u80FD\uFF0C\u90A3\u4E9B\u8207\u6591\u99AC\u8ECD\u5718\u7D50\u76DF\u7684\u9435\u9A0E\u885B\u80AF\u5B9A\u6703\u8ACB\u6C42\u65B0\u670B\u53CB\u7684\u652F\u6301."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824157
    m_Localized: "\u9019\u8207\u6211\u5011\u6709\u4EC0\u9EBC\u95DC\u4FC2\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824158
    m_Localized: "\u64DA\u6211\u6240\u77E5\uFF0C\u9435\u9A0E\u885B\u7FD2\u6163\u6253\u9663\u5730\u6230.
      \u4ED6\u5011\u5C07\u70BA\u91CD\u8981\u7684\u57FA\u5730\u548C\u5009\u5EAB\u4EE5\u53CA\u5468\u570D\u7684\u9818\u5730\u800C\u6230.
      \u800C\u5176\u4E2D\u4E00\u500B\u57FA\u5730\u76F8\u5C0D\u9760\u8FD1\u9019\u88E1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824159
    m_Localized: "\u9019\u610F\u5473\u8457\u6211\u5011\u90E8\u968A\u751A\u81F3\u662F\u64DA\u9EDE\u672C\u8EAB\u9047\u5230\u767C\u751F\u610F\u5916\u7684\u98A8\u96AA.
      \u96D6\u7136\u6211\u5011\u53EF\u4EE5\u8655\u7406\u9435\u9A0E\u885B\u7684\u554F\u984C\uFF0C\u4F46\u6591\u99AC\u8ECD\u5718\u5C07\u4E0D\u5047\u601D\u7D22\u5730\u90E8\u5C6C\u90E8\u968A\u6BB2\u6EC5\u6211\u5011."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824160
    m_Localized: "\u9019\u5834\u6230\u722D\u4E0D\u592A\u53EF\u80FD\u6301\u7E8C\u592A\u4E45.
      \u5982\u679C\u6211\u5011\u56E4\u7A4D\u8DB3\u5920\u7684\u7269\u8CC7\u4E26\u5317\u4E0A\u5E7E\u500B\u6708\uFF0C\u6211\u5011\u53EF\u4EE5\u7B49\u5F85\u9019\u5834\u98A8\u66B4\u7D50\u675F\u7136\u5F8C\u518D\u56DE\u4F86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824161
    m_Localized: "\u7B49\u7B49\uFF0C\u73FE\u5728\u5224\u65B7\u9084\u70BA\u6642\u904E\u65E9.
      @lp\uFF0C\u4F60\u662F\u600E\u9EBC\u77E5\u9053\u9019\u4E00\u5207\u7684\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824162
    m_Localized: "\u6211\u66FE\u53BB\u904E\u90A3\u88E1.\n\u9996\u5148\uFF0C\u6211\u8A8D\u8B58\u9019\u5834\u885D\u7A81\u4E00\u65B9\u7684\u9818\u5C0E\u99AC.
      \u53CD\u5C0D\u8207\u8ECD\u5718\u7D50\u76DF\u7684\u90A3\u500B. \u7B2C\u4E8C...
      \u5728\u4E2D\u5FC3\u57CE\uFF0C\u6211\u78B0\u5DE7\u9047\u5230\u4E86\u4E00\u4F4D\u8ECD\u5718\u5DEB\u5E2B.
      \u5979\u7684\u540D\u5B57\u662F\u9EA5\u67E5\u7DAD."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824163
    m_Localized: "\u9019\u5F88\u7CDF..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824164
    m_Localized: "\u5982\u679C\u6591\u99AC\u8ECD\u5718\u6D3E\u6B7B\u9748\u6CD5\u5E2B\u5230\u9019\u500B\u5730\u5340\uFF0C\u90A3\u6211\u5011\u5DF2\u7D93\u8655\u65BC\u5371\u96AA\u4E4B\u4E2D.
      \u4ED6\u5011\u4E2D\u7684\u8A31\u591A\u6591\u99AC\u90FD\u6709\u9810\u8996\u7684\u5929\u8CE6.
      \u767C\u73FE\u6211\u5011\u73FE\u5728\u53EA\u662F\u6642\u9593\u7684\u554F\u984C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824165
    m_Localized: "...\u800C\u4E14\u5373\u4FBF\u6211\u5011\u73FE\u5728\u5317\u4E0A\uFF0C\u5982\u679C\u6591\u99AC\u8ECD\u5718\u7372\u52DD\uFF0C\u6211\u5011\u4E5F\u7121\u6CD5\u56DE\u4F86.
      \u5982\u679C\u6B7B\u9748\u6CD5\u5E2B\u5728\u9019\u88E1\uFF0C\u9019\u610F\u5473\u8457\u51F1\u6492\u5C07\u6253\u7B97\u6C38\u9060\u5B9A\u5C45\u5728\u9019\u4E9B\u5730\u65B9.\n\u6211\u5011\u5FC5\u9808\u9032\u653B.
      \u5C31\u662F\u73FE\u5728\uFF0C\u5728\u4ED6\u5011\u627E\u5230\u6211\u5011\u4E4B\u524D.
      \u6211\u5011\u6709\u6230\u58EB\uFF0C\u9A5A\u559C\u5C31\u5728\u6211\u5011\u8EAB\u908A.
      \u6211\u53AD\u5026\u4E86\u8EB2\u85CF\uFF01 \u653B\u64CA\u6575\u65B9\uFF0C\u5229\u7528\u9019\u4E00\u523B\u4E26\u5354\u52A9\u9435\u9A0E\u885B\u6253\u6557\u4ED6\u5011\uFF01
      \u6211\u5DF2\u7D93\u53AD\u5026\u9003\u8DD1\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824166
    m_Localized: "... \u767D\u7661"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824167
    m_Localized: "\u9019\u662F\u81EA\u6BBA\u884C\u52D5\uFF0C\u59C6\u7D39\u88E1. \u7A81\u8972\u53EA\u80FD\u6210\u529F\u4E00\u6B21.
      \u4E00\u65E6\u6591\u99AC\u8ECD\u5718\u767C\u73FE\u4E86\u6211\u5011\uFF0C\u6211\u5011\u5C31\u5B8C\u86CB\u4E86.
      \u6211\u5011\u9072\u65E9\u90FD\u6703\u88AB\u8FFD\u6355\u548C\u5C60\u6BBA. \u5728\u9019\u5834\u885D\u7A81\u4E2D\u6211\u5011\u751A\u81F3\u90FD\u4E0D\u77E5\u9053\u78BA\u5207\u5730\u5BE6\u529B\u5E73\u8861.
      \u5230\u76EE\u524D\u70BA\u6B62\uFF0C\u59C6\u7D39\u88E1\u7684\u63D0\u8B70\u807D\u8D77\u4F86\u6700\u5408\u4E4E\u908F\u8F2F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824168
    m_Localized: "\u6211\u5E6B\u4F60\u5011\u600E\u9EBC\u6A23\uFF1F \u5373\u4F7F\u6591\u99AC\u8ECD\u5718\u767C\u73FE\u662F\u8AB0\u8972\u64CA\u4E86\u4ED6\u5011\uFF0C\u6211\u4E5F\u53EA\u662F\u55AE\u8EAB\u4E00\u5339\u5C0F\u99AC\uFF0C\u6211\u7684\u884C\u52D5\u4E0D\u6703\u66B4\u9732\u4F60\u5011\u7684\u5B58\u5728."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824169
    m_Localized: "\u55AE\u6191\u4E00\u5DF1\u4E4B\u529B\u662F\u5F88\u96E3\u505A\u5230\u7684.
      \u4F60\u9700\u8981\u77E5\u9053\u78BA\u5207\u7684\u6253\u64CA\u9EDE. \u5373\u4F7F\u5728\u9019\u7A2E\u60C5\u6CC1\u4E0B\uFF0C\u53EF\u80FD\u6027\u4E5F\u4E0D\u662F\u7279\u5225\u9AD8."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824170
    m_Localized: "\u4F46\u5979\u7684\u4E3B\u610F\u78BA\u5BE6\u53EF\u4EE5\u4FDD\u8B77\u6211\u5011\u81EA\u5DF1.
      \u5373\u4F7F\u9019\u5339\u5C0F\u99AC\u5931\u6557\u4E86\uFF0C\u6591\u99AC\u8ECD\u5718\u4E5F\u4E0D\u592A\u53EF\u80FD\u6D3B\u6349\u5979\uFF0C\u9019\u4E0D\u662F\u4ED6\u5011\u7684\u98A8\u683C.\n\u4F46\u6211\u5011\u4E0D\u80FD\u4F9D\u8CF4\u6210\u529F.
      \u7121\u8AD6\u5982\u4F55\uFF0C\u6211\u5011\u5FC5\u9808\u958B\u59CB\u6E96\u5099\u9003\u96E2."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824171
    m_Localized: "\u4EC0\u9EBC\u53EB\"\u4E0D\u662F\u4ED6\u5011\u7684\u98A8\u683C\"\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824172
    m_Localized: "\u5118\u7BA1\u6591\u99AC\u8ECD\u5718\u6709\u7A2E\u7A2E\u7F3A\u9EDE\uFF0C\u4F46\u4ED6\u5011\u4E0D\u5141\u8A31\u6298\u78E8\u90A3\u4E9B\u52C7\u6562\u9762\u5C0D\u4ED6\u5011\u7684\u6591\u99AC.
      \u9019\u662F\u4E00\u500B\u975E\u5E38\u53E4\u8001\u7684\u50B3\u7D71\uFF0C\u4E00\u7A2E\u656C\u610F:
      \u4E00\u500B\u52C7\u6562\u7684\u6575\u99AC\u61C9\u8A72\u6B7B\u5728\u6230\u5834\u4E0A\uFF0C\u800C\u4E0D\u662F\u6B7B\u5728\u9396\u93C8\u4E0A.
      \u751A\u81F3\u662F\u4E00\u5339\u5C0F\u99AC. \u4E00\u500B\u5D07\u9AD8\u7684\u50B3\u7D71...
      \u5982\u6B64\u4E0D\u7406\u6027."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824173
    m_Localized: "\u5269\u4E0B\u7684\u53EA\u6709\u4E00\u4EF6\u5C0F\u4E8B - \u52C7\u6562\u5730\u6B7B\u53BB\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824174
    m_Localized: "...\n      \u6211\u5BE7\u9858\u4E0D\u6B7B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824175
    m_Localized: "\u7136\u800C\uFF0C\u6211\u5011\u7121\u6CD5\u544A\u8A34\u4F60\u54EA\u88E1\u53EF\u4EE5\u627E\u5230\u8ECD\u5718\u7279\u5DE5.
      \u800C\u6211\u5011\u4E5F\u4E0D\u6703\u53BB\u627E\u4ED6\u5011. \u98A8\u96AA\u592A\u9AD8\u4E86.\n\u5317\u4E0A\u7684\u6E96\u5099\u5DE5\u4F5C\u9700\u8981\u5F88\u9577\u6642\u9593.
      \u5982\u679C\u60A8\u80FD\u4EE5\u67D0\u7A2E\u65B9\u5F0F\u6210\u529F\u70BA\u6211\u5011\u722D\u53D6\u4E86\u4E00\u4E9B\u6642\u9593\u7684\u8A71\uFF0C\u6211\u5011\u5C07\u4E0D\u52DD\u611F\u6FC0.
      \u4F46\u6211\u5011\u4E0D\u80FD\u5728\u7B49\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824176
    m_Localized: "\u6211\u60F3\u6211\u77E5\u9053\u6709\u8AB0\u80FD\u52A9\u6211\u4E00\u81C2\u4E4B\u529B\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824177
    m_Localized: "\u90A3\u9EBC\u5C31\u9019\u6A23\u5427\uFF01 @lp\uFF0C\u6211\u5011\u90FD\u975E\u5E38\u611F\u8B1D\u60A8\u7684\u6C7A\u5FC3\u548C\u5E6B\u52A9.
      \u5982\u679C\u60A8\u6539\u8B8A\u4E3B\u610F\uFF0C\u6211\u5011\u6703\u7406\u89E3\uFF0C\u4E26\u8A18\u4F4F\uFF0C\u8207\u5176\u9054\u5230\u76EE\u6A19\u4E26\u6B7B\u53BB\u4E0D\u5982\u62EF\u6551\u4F60\u7684\u751F\u547D\uFF0C\u56E0\u70BA\u4F60\u7684\u6B7B\u4EA1\u5C07\u662F\u66F4\u5927\u7684\u640D\u5931."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824178
    m_Localized: "\u5354\u9632\u96B1\u5BC6\u6751\u838A"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824179
    m_Localized: "\u9435\u8E44\u4F60\u597D. \u6211\u6709\u4E00\u500B\u80FD\u8B93\u6211\u5011\u5404\u5F97\u5176\u6240\u7684\u63D0\u8B70."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824180
    m_Localized: "\u6211\u6B63\u5728\u807D\uFF0C@lp"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824181
    m_Localized: "\u4F60\u7684\u5075\u5BDF\u5175\u5F97\u77E5\u6591\u99AC\u8ECD\u5718\u884C\u8E64\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824182
    m_Localized: "\u6B63\u5982\u51B7\u7738\u7684\u8FFD\u96A8\u8005\u6240\u77E5\u9053\u7684\u90A3\u6A23.
      \u6211\u7684\u7DDA\u99AC\u773C\u7DDA\u5F88\u591A\uFF0C\u4F46\u6D3E\u5DE1\u908F\u968A\u76E3\u8996\u6591\u99AC\u592A\u4E0D\u5408\u7406\u4E86.\n\u5C31\u76EE\u524D\uFF0C\u6591\u99AC\u8ECD\u5718\u7684\u91CD\u9EDE\u5728\u5E6B\u52A9\u6211\u4EE5\u524D\u7684\u540C\u80DE.
      \u5B83\u5011\u8DB3\u4EE5\u61C9\u4ED8\u4E00\u5834\u6230\u9B25\uFF0C\u4F46\u537B\u66F4\u559C\u6B61\u7528\u4F0F\u64CA\u548C\u7834\u58DE\u4F86\u963B\u7919\u6211\u7684\u90E8\u968A\u7684\u884C\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824183
    m_Localized: "\u4ED6\u5011\u7684\u7B56\u7565\u662F\u5426\u7121\u61C8\u53EF\u64CA\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824184
    m_Localized: "\u5F88\u96E3\u8AAA. \u4E5F\u8A31\u6467\u6BC0\u4ED6\u5011\u5728\u8A72\u5340\u57DF\u7684\u6230\u6642\u7E3D\u90E8\u53EF\u80FD\u6703\u5C0E\u81F4\u4ED6\u5011\u7684\u884C\u52D5\u6DF7\u4E82\u4E26\u8FEB\u4F7F\u4ED6\u5011\u66AB\u6642\u6E1B\u5C11\u6D3B\u52D5.
      \u7136\u800C\uFF0C\u6591\u99AC\u6B63\u5728\u5BC6\u5207\u95DC\u6CE8\u6211\u90E8\u968A\u7684\u6BCF\u4E00\u6B65\uFF0C\u6D3E\u9063\u7A81\u64CA\u968A\u53EF\u80FD\u6703\u5931\u6557.
      \u4ED6\u5011\u53EA\u6703\u8F49\u79FB\u9663\u5730."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824185
    m_Localized: "\u59B3\u4E0D\u662F\u7D14\u7CB9\u51FA\u65BC\u597D\u5947\u624D\u9019\u9EBC\u554F\u7684\uFF0C\u5C0D\u5427\uFF1F
      \u5982\u679C\u59B3\u6253\u7B97\u62DC\u8A2A\u6591\u99AC\u53F8\u4EE4\u90E8\uFF0C\u6211\u53EF\u4EE5\u544A\u8A34\u59B3\u4ED6\u5011\u7576\u524D\u7684\u4F4D\u7F6E.
      \u6467\u6BC0\u91CE\u5340\u8ECD\u5718\u7684\u9818\u5C0E\u5C64\u5C07\u70BA\u6211\u5011\u7684\u9032\u653B\u63D0\u4F9B\u4F5C\u6230\u7A7A\u9593\uFF0C\u800C\u4F60\u5728\u7368\u7ACB\u4F5C\u6230\u4E2D\u7684\u6280\u80FD\u70BA\u6211\u5011\u7684\u6210\u529F\u63D0\u4F9B\u4E86\u5DE8\u5927\u7684\u6A5F\u6703.
      \u771F\u8070\u660E\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824186
    m_Localized: "\u8B1D\u4E86\uFF01 \u7576\u7136\uFF0C\u6211\u5F88\u5FEB\u5C31\u6703\u62DC\u8A2A\u8ECD\u5718\u6307\u63EE\u5B98.
      \u9806\u4FBF\u8AAA\u4E00\u4E0B\uFF0C\u6709\u4E00\u5339\u5C0F\u99AC\u5E36\u6211\u5411\u4F60\u554F\u597D.
      \u5805\u6BC5\u6A61\u6A39."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824187
    m_Localized: "\u6A61\u6A39\uFF1F \u6211\u8A18\u5F97\u4ED6. \u597D\u50A2\u4F19.
      \u9084\u771F\u65B0\u5947\u963F\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824188
    m_Localized: "\u96B1\u5BC6\u6751\u838A\u5B89\u5168\u4E86"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824189
    m_Localized: "\u597D\u6D88\u606F\uFF0C\u963F\u65AF\u5361\u7406. \u6211\u627E\u5230\u4E86\u8ECD\u5718\u7684\u5730\u5340\u7E3D\u90E8\uFF0C\u6BBA\u6B7B\u4E86\u4ED6\u5011\u7684\u6307\u63EE\u5B98
      \u62FF\u8D70\u4E86\u6211\u80FD\u627E\u5230\u7684\u6240\u6709\u6587\u4EF6. \u4E0D\u904E\u6211\u4E0D\u61C2\u6591\u99AC\u8A9E.
      \u4F60\u80FD\u770B\u4E00\u4E0B\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824190
    m_Localized: "\u7576\u7136"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824191
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824192
    m_Localized: "\u9019\u4E9B\u662F\u547D\u4EE4\u548C\u5831\u544A. \u883B\u591A\u7684.
      \u4F46\u6C92\u6709\u63D0\u5230\u6211\u5011\u6216\u5176\u4ED6\u88AB\u653E\u9010\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824193
    m_Localized: "\u9019\u5C0D\u6211\u5011\u4F86\u8AAA\u662F\u500B\u597D\u6D88\u606F\uFF0C@lp.
      \u6211\u77E5\u9053\u8ECD\u5718\u662F\u5982\u4F55\u904B\u4F5C\u7684. \u53F8\u4EE4\u90E8\u88AB\u7834\u58DE\u5C0D\u4ED6\u5011\u4F86\u8AAA\u662F\u4E00\u500B\u5927\u554F\u984C\uFF0C\u800C\u4E14\u4ED6\u5011\u4E0D\u6703\u5F88\u5FEB\u6062\u5FA9\u904E\u4F86.
      \u5982\u679C\u6591\u99AC\u8ECD\u5718\u4EE5\u67D0\u7A2E\u65B9\u5F0F\u767C\u73FE\u4E86\u6211\u5011\uFF0C\u5B83\u61C9\u8A72\u5C31\u6703\u5BEB\u5728\u9019\u88E1\u9762.\n\u6211\u5011\u73FE\u5728\u53EF\u4EE5\u78BA\u5B9A\u6211\u5011\u662F\u5B89\u5168\u7684.
      \u81F3\u5C11\u6211\u5011\u53EF\u4EE5\u82B1\u66F4\u591A\u7684\u6642\u9593\u4F86\u6536\u96C6\u548C\u6E96\u5099\u7269\u8CC7.
      \u4E5F\u8A31\u6211\u5011\u751A\u81F3\u4E0D\u5FC5\u96E2\u958B. \u60A8\u7684\u5E6B\u52A9\u5C0D\u6211\u5011\u4F86\u8AAA\u662F\u7121\u50F9\u7684\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824194
    m_Localized: "\u6211\u4E5F\u6709\u6D88\u606F\u8981\u544A\u8A34\u60A8. \u7576\u4F60\u4E0D\u5728\u7684\u6642\u5019\uFF0C\u4E00\u500B\u6A5F\u68B0\u7CBE\u9748\u62DC\u8A2A\u4E86\u59B3\u7684\u670B\u53CB.
      \u6211\u77E5\u9053\u9019\u807D\u8D77\u4F86\u53EF\u80FD\u5F88\u5947\u602A\uFF0C\u6211\u77E5\u9053\uFF0C\u4F46\u5B83\u53EA\u662F\u98DB\u9032\u4F86\u8A62\u554F\u5979.
      \u5B83\u9084\u8AAA\u5B83\u9700\u8981\u548C\u4F60\u8AC7\u8AC7. \u73FE\u5728\u6A5F\u68B0\u7CBE\u9748\u548C\u8587\u8587\u5728\u90A3\u68DF\u6A13\u88E1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824195
    m_Localized: "\u8207\u5B88\u671B\u8005\u6703\u9762"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824196
    m_Localized: "\u59B3\u597D @lp. \u5E78\u597D\u4F60\u4F86\u5F97\u6B63\u662F\u6642\u5019."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824197
    m_Localized: "\u5443... \u4F60\u597D\uFF1F \u6211\u4E0D\u8A8D\u70BA\u6211\u5011\u5F7C\u6B64\u8A8D\u8B58\uFF0C\u4E5F\u8A31\u4F60\u6700\u597D\u81EA\u6211\u4ECB\u7D39\u4E00\u4E0B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824198
    m_Localized: "\u662F\u7684\uFF0C\u7576\u7136\uFF0C\u8ACB\u539F\u8AD2\u6211\u7684\u7C97\u9B6F.
      \u6211\u7684\u771F\u540D\u4E0D\u6703\u544A\u8A34\u4F60\u4EFB\u4F55\u4E8B\u60C5\uFF0C\u6240\u4EE5\u5C31\u53EB\u6211\u5B88\u671B\u8005\u5427.\n\u5982\u679C\u4F60\u9084\u8A18\u5F97\u7684\u8A71\uFF0C\u4F60\u5728
      88 \u865F\u907F\u96E3\u53A9\u53D6\u5F97\u6210\u529F\u5F8C\u9867\u554F\u8981\u6C42\u4F60\u5C07\u88DC\u511F\u5668\u5E36\u5230\u6F22\u57FA\u8ECA\u5EAB.
      \u6211\u662F\u4F60\u61C9\u8A72\u898B\u5230\u7684\u90A3\u500B\u4EBA. \u4E0D\u5E78\u7684\u662F\uFF0C\u6211\u5011\u88AB\u6253\u65B7\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824199
    m_Localized: "\u4F60\u662F\u600E\u9EBC\u627E\u5230\u6211\u7684\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824200
    m_Localized: "\u662F\u59B3\u5011\u5169\u500B. \u5E78\u904B\u7684\u662F\uFF0C\u6211\u627E\u5230\u4E86\u59B3\u548C\u5929\u9078\u4E4B\u99AC24\u865F.
      \u9019\u53EF\u4E0D\u5BB9\u6613. \u8587\u8587\u548C\u6211\u5DF2\u7D93\u8A0E\u8AD6\u4E86\u5F88\u591A\uFF0C\u73FE\u5728\u6211\u5011\u9700\u8981\u548C\u4F60\u8AC7\u8AC7."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824201
    m_Localized: "\u7B49\u4E00\u4E0B. \u8587\u8587\uFF0C\u53EF\u4EE5\u4FE1\u4EFB\u4ED6\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824202
    m_Localized: "\u53EF\u4EE5\uFF0C\u6211\u60F3\u662F\u7684. \u4ED6\u544A\u8A34\u6211\u7684\u8DB3\u4EE5\u8B93\u6211\u76F8\u4FE1\u4ED6."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824203
    m_Localized: "\u5F88\u597D. \u6211\u4E0D\u50C5\u627E\u5230\u4E86\u88DC\u511F\u5668\uFF0C\u9084\u627E\u5230\u4E86\u5929\u89D2\u7378\u8B77\u7B26\uFF01 
      \u9084\u6709\u90A3\u672C\u6697\u9ED1\u4E4B\u66F8. \u9867\u554F\u662F\u5426\u544A\u8A34\u904E\u60A8\u5B83\u5011\u5C0D\u9805\u76EE\u4E5F\u5F88\u91CD\u8981\uFF1F
      \u6211\u60F3\u4ED6\u5011\u61C9\u8A72\u76E1\u5FEB\u8F49\u79FB\uFF0C\u56E0\u70BA..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824204
    m_Localized: "...\u9CF4\u99AC\u9435\u9A0E\u885B\u8207\u6591\u99AC\u8ECD\u5718\u806F\u8E44\uFF0C\u6B63\u8A08\u756B\u5C0D\u907F\u96E3\u5EC4
      Pi \u767C\u8D77\u653B\u64CA. \u6211\u5011\u6709\u610F\u8B58\u5230\u9019\u4E00\u9EDE\uFF0C@lp.\n\u6240\u4EE5\u4E0D\u884C\uFF0C\u9019\u4E9B\u53E4\u795E\u5668\u5FC5\u9808\u548C\u4F60\u5728\u4E00\u8D77.
      \u6050\u6015\u4F60\u6703\u66F4\u9700\u8981\u5B83\u5011. \u6211\u6703\u89E3\u91CB\u539F\u56E0.
      \u4F46\u9996\u5148\u8B93\u6211\u544A\u8A34\u59B3\u95DC\u65BC\u4F60\u81EA\u5DF1\u7684\u4E8B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824205
    m_Localized: "\u9867\u554F\u5DF2\u7D93\u544A\u8A34\u59B3\uFF0C\u59B3\u88AB\u6D3E\u53BB\u6536\u96C6\u5B8C\u6210
      \"\u592A\u967D\" \u548C \"\u5F69\u8679\" \u9805\u76EE\u6240\u9700\u7684\u7F3A\u5931\u96F6\u4EF6.
      \u4EE5\u53CA\u59B3\u81EA\u9858\u540C\u610F\u66AB\u6642\u5C01\u9396\u59B3\u7684\u8A18\u61B6\u4EE5\u78BA\u4FDD\u59B3\u5BB6\u5712\u7684\u5B89\u5168.\u9019\u9805\u6280\u8853\u6709\u4E00\u500B\u660E\u986F\u7684\u7F3A\u9EDE:
      \u60A8\u8A18\u61B6\u4E2D\u7684\u5716\u50CF\u88AB\u8996\u70BA\u6574\u9AD4\u5C0D\u8C61\u4F86\u9032\u884C\u5C01\u9396\uFF0C\u4F46\u4E26\u4E0D\u662F\u6BCF\u500B\u55AE\u7368\u7684\u90E8\u5206.
      \u9019\u610F\u5473\u8457\u5982\u679C\u60A8\u6062\u5FA9\u90E8\u5206\u8A18\u61B6\uFF0C\u60A8\u5C07\u8A18\u4F4F\u8207\u6062\u5FA9\u90E8\u5206\u76F4\u63A5\u76F8\u95DC\u7684\u6240\u6709\u5167\u5BB9.
      \u807D\u8457: \u9867\u554F\u6709\u4E00\u982D\u9280\u7070\u8272\u7684\u9B03\u6BDB..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824206
    m_Localized: "...\u548C\u6DFA\u7D2B\u8272\u7684\u5916\u5957. \u4ED6\u6709\u4E00\u500B\u66F2\u68CD\u7403\u68D2\u53EF\u611B\u6A19\u8A18\uFF0C\u4ED6\u6234\u8457\u773C\u93E1\u800C\u4E14\u771F\u7684\u5F88\u559C\u6B61\u4ED6\u7684\u5DE5\u4F5C\uFF01
      \u9084\u6709\u860B\u679C\u91AC.\n\u54E6\uFF0C\u5929\u54EA\uFF0C\u6211\u771F\u7684\u8A18\u5F97\u4ED6\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824207
    m_Localized: "\u770B\u5230\u4E86\u55CE\uFF1F \u7136\u800C\uFF0C\u73FE\u5728\u5C0D\u59B3\u4F86\u8AAA\u66F4\u91CD\u8981\u7684\u662F\u8A18\u4F4F\u4ED6\u6B63\u5728\u5F9E\u4E8B\u7684\u8A08\u756B\u7D30\u7BC0."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824208
    m_Localized: "\u4ED6\u662F\u5C0D\u7684\uFF0C@lp.  \u73FE\u5728\u6211\u5011\u6709\u8CAC\u4EFB\u4FDD\u8B77\u6211\u5011\u7684\u5BB6\u5712.
      \u800C\u4E14\u7121\u8AD6\u6211\u591A\u9EBC\u96E3\u4EE5\u627F\u8A8D\uFF0C\u9867\u554F\u8A66\u5716\u5B8C\u6210\u7684\u6B66\u5668\u53EF\u80FD\u662F\u6211\u5011\u7684\u5931\u6557-\u4FDD\u96AA\uFF0C\u4EE5\u9632\u51FA\u73FE\u554F\u984C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824209
    m_Localized: "\"\u592A\u967D\" \u548C \"\u5F69\u8679\" \u9805\u76EE\u662F\u76F8\u4E92\u95DC\u806F\u7684.
      \"\u5F69\u8679\" \u662F\u4E00\u500B\u5F3A\u5927\u7684\u5916\u9AA8\u9ABC\uFF0C\u88DD\u5099\u4E86\u5E7E\u4E4E\u7121\u6CD5\u7A7F\u900F\u7684\u76D4\u7532\u548C\u7FC5\u8180\u53EF\u4EE5\u5C07\u5EE2\u571F\u4E0A\u7684\u5C0F\u99AC\u6216\u7368\u89D2\u7378\u62AC\u5230\u7A7A\u4E2D.
      \u800C \"\u592A\u967D\" \u662F\u4E00\u500B\u6975\u5176\u8907\u96DC\u7684\u57FA\u65BC\u5F69\u8679\u7684\u7CFB\u7D71\uFF0C\u5176\u76EE\u7684\u662F\u99AC\u5DE5\u589E\u5F37\u88DD\u5099\u8005\u7684\u751F\u5B58\u80FD\u529B\u548C\u9B54\u6CD5\u80FD\u529B.
      \u4ED6\u5011\u4E00\u8D77\u80FD\u5920\u8CE6\u4E88\u7684\u529B\u91CF\u50C5\u6B21\u65BC\u585E\u62C9\u65AF\u8482\u5A6D\u548C\u9732\u5A1C\u7684\u50B3\u5947\u529B\u91CF.
      \u4F46\u53EA\u6709\u6BC0\u6EC5\u80FD\u529B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824210
    m_Localized: "\u662F\u7684\uFF0C\u6211\u8A18\u5F97. \u9019\u4E9B\u7CFB\u7D71\u7684\u64CD\u4F5C\u6975\u5176\u8907\u96DC\uFF0C\u662F\u771F\u6B63\u7684\u6280\u8853\u5947\u8E5F.
      \u9867\u554F\uFF0C\u548C\u4ED6\u7684\u524D\u8F29\u4E00\u6A23\uFF0C\u76F8\u4FE1\u53EA\u6709\u5B83\u5011\u80FD\u5920\u5B8C\u5168\u5728\u5C0D\u5730\u8868\u958B\u653E\u6642\u78BA\u4FDD\u907F\u96E3\u5EC4Pi\u7684\u5B89\u5168.
      \u9084\u6709\u4ED6\u5011... \u6211\u5011\u6700\u7D42\u90FD\u60F3\u7D50\u675F\u6211\u5011\u7684\u9694\u96E2.
      \u4F46\u4ED6\u5011\u5BB3\u6015\u5728\u6C92\u6709\u4FDD\u8B77\u7684\u60C5\u51B5\u4E0B\u958B\u653E\u907F\u96E3\u5EC4."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824211
    m_Localized: "\u7576\u6211\u5011\u8737\u7E2E\u5728\u9AD8\u79D1\u6280\u7684\u5916\u6BBC\u5167\u6642\uFF0C\u5730\u8868\u5C0F\u99AC\u4E00\u4EE3\u53C8\u4E00\u4EE3\u5730\u906D\u53D7\u75DB\u82E6\u548C\u6B7B\u4EA1\uFF0C\u7B49\u5230\u6211\u5011\u7D44\u88DD\u51FA\u8DB3\u5920\u5927\u7684\u69CD\u4EE5\u5728\u9047\u5230\u554F\u984C\u6642\u5C07\u5B83\u5011\u5168\u90E8\u5C04\u6BBA.
      \u9019\u6A23\u6253\u62DB\u547C\u5C31\u4E0D\u6703\u592A\u5687\u4EBA\u4E86."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824212
    m_Localized: "\u8587\u8587\uFF0C\u5730\u8868\u4E0A\u5168\u90FD\u662F\u53EA\u6703\u770B\u4F60\u7684\u69CD\u679D\u5927\u5C0F\u4F86\u6C7A\u5B9A\u64FA\u4EC0\u9EBC\u81C9\u8272\u7684\u5C0F\u99AC.
      \u5B83\u53EA\u6703\u8B93\u5730\u8868\u751F\u6D3B\u8B8A\u5F97\u66F4\u597D\uFF0C\u66F4\u5B89\u5168."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824213
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824214
    m_Localized: "\u4E0D\u7BA1\u662F\u597D\u662F\u58DE\uFF0C\u4E8B\u60C5\u90FD\u662F\u9019\u6A23\u767C\u5C55\u7684.
      \u5169\u767E\u5E74\u4F86\uFF0C\u907F\u96E3\u5EC4 Pi \u548C\u5EE2\u571F\u8207\u4E16\u9694\u7D55\uFF0C\u751F\u6D3B\u5728\u5176\u4E2D\u7684\u5C0F\u99AC\u62EF\u6551\u4E86\u5C0F\u99AC\u570B\u7684\u5927\u90E8\u5206\u6280\u8853\u6B77\u53F2.
      @lp\uFF0C\u4F60\u6709\u6C92\u6709\u60F3\u904E\u70BA\u4EC0\u9EBC\u4F60\u53EF\u4EE5\u5B58\u53D6
      M.A.S.\u7D42\u7AEF\u7684\u5168\u90E8\u529F\u80FD\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824215
    m_Localized: "\u56E0\u70BA\u5B83\u5011\u8FA8\u8B58\u51FA\u4E86\u6211 PipBuck
      \u7684\u8A8D\u8B49\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824216
    m_Localized: "\u6C92\u932F. \u53EA\u6709\u907F\u96E3\u5EC4\u5C45\u6C11\u7684
      PipBucks \u4ECD\u7136\u64C1\u6709\u7D42\u7AEF\u8B58\u5225\u6240\u9700\u7684\u7A0B\u5F0F\uFF0C\u4EE5\u53CA\u8A31\u591A\u5176\u4ED6M.A.S.\u8A2D\u5099.
      \u7F55\u898B\u7684\u5E78\u904B\u5730\u8868\u5C0F\u99AC\u4F7F\u7528\u7684\u8A18\u61B6\u5DF2\u7D93\u88AB\u62B9\u53BB\u4E86\u5F88\u591A\u6B21.
      \u4F46\u9019\u8207\u59B3\u7684\u907F\u96E3\u5EC4\u5728\u6700\u5F8C\u4E00\u5929\u5230\u4F86\u4E4B\u524D\u6240\u5F9E\u4E8B\u7684\u8A31\u591A\u8A08\u756B\u76F8\u6BD4\u7C21\u76F4\u662F\u5FAE\u4E0D\u8DB3\u9053.
      \u9019\u7576\u4E2D\u4E5F\u5305\u62EC \"\u592A\u967D\" \u548C \"\u5F69\u8679\"
      \u9805\u76EE."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824217
    m_Localized: "\u6B63\u662F\u9019\u4E9B\u5438\u5F15\u4E86\u51B7\u7738. \u4F46\u73FE\u5728\uFF0C\u4ECD\u7136\u6709\u6A5F\u6703\u89E3\u51B3\u4E00\u5207... 
      \u6216\u591A\u6216\u5C11\uFF0C\u548C\u5E73\u5730..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824218
    m_Localized: "\u6211\u5011\u7684\u907F\u96E3\u5EC4\u6709\u88AB\u5165\u4FB5\u7684\u5371\u96AA.
      \u6211\u5011\u600E\u6A23\u624D\u80FD \"\u548C\u5E73\u5730\" \u89E3\u51B3\u9019\u500B\u554F\u984C\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824219
    m_Localized: "\u6709\u4E00\u7A2E\u65B9\u6CD5. \u4F46\u4E0D\u80FD\u4FDD\u8B49."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824220
    m_Localized: "\u6211\u4E0D\u6703\u7121\u7DE3\u7121\u6545\u7A31\u81EA\u5DF1\u70BA\u5B88\u671B\u8005\uFF0C@lp.
      \u901A\u904E\u4F7F\u7528\u6A5F\u68B0\u7CBE\u9748\u7DB2\u7D61\uFF0C\u6211\u77AD\u89E3\u4E86\u5F88\u591A\u5EE2\u571F\u4E0A\u767C\u751F\u7684\u4E8B\u60C5.
      \u9867\u554F\u6B63\u662F\u5F9E\u6211\u9019\u88E1\u5B78\u5230\u4E86\u9019\u4E00\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824221
    m_Localized: "\u6211\u77E5\u9053\u51B7\u7738\u70BA\u4EC0\u9EBC\u51B3\u5B9A\u8972\u64CA\u907F\u96E3\u5EC4
      Pi\uFF0C\u4EE5\u53CA\u70BA\u4EC0\u9EBC\u4ED6\u8207\u51F1\u6492\u5229\u4E9E\u7D50\u76DF\u6210\u70BA\u53EF\u80FD. 
      \u9019\u7247\u5EE2\u571F\u4E0A\u51FA\u73FE\u4E86\u4E00\u7A2E\u5A01\u8105\uFF0C\u751A\u81F3\u53EF\u4EE5\u8FEB\u4F7F\u52E2\u4E0D\u5169\u7ACB\u7684\u6575\u4EBA\u806F\u5408\u8D77\u4F86\u53CD\u5C0D\u4ED6\u5011.
      \u82F1\u514B\u96F7.\n\u672B\u65E5\u4F86\u81E8\u4E4B\u969B\uFF0C\u5C0F\u99AC\u570B\u5929\u99AC\u62CB\u68C4\u4E86\u4ED6\u5011\u5782\u6B7B\u7684\u570B\u5EA6\u4E26\u906E\u853D\u4E86\u5929\u7A7A.
      \u5F9E\u90A3\u4EE5\u5F8C\uFF0C\u5EE2\u571F\u4E0A\u5728\u4E5F\u6C92\u6709\u4E00\u500B\u6674\u5929.
      \u5929\u99AC\u81EA\u5DF1\u5DF2\u7D93\u5728\u96F2\u969C\u4E4B\u4E0A\u751F\u6D3B\u4E86\u5169\u767E\u5E74.
      \u6211\u4E0D\u77E5\u9053\u90A3\u88E1\u767C\u751F\u4E86\u4EC0\u9EBC\uFF0C\u4F46\u6700\u8FD1\u81F3\u5C11\u4ED6\u5011\u4E2D\u7684\u4E00\u4E9B\u5C0F\u99AC\u5F97\u51FA\u4E86\u4E00\u500B\u7D50\u8AD6\uFF0C\u5373\u61C9\u8A72\u7D50\u675F\u81EA\u884C\u5B64\u7ACB.
      \u5927\u7D04\u56DB\u500B\u6708\u524D\uFF0C\u4E00\u652F\u81EA\u7A31\u5927\u5929\u99AC\u82F1\u514B\u96F7\u7684\u5929\u99AC\u5927\u5206\u968A\u964D\u843D\u5230\u5730\u8868\u4E26\u5EFA\u7ACB\u4E86\u4E00\u500B\u8ECD\u4E8B\u57FA\u5730\uFF0C\u537B\u4E0D\u8B93\u4EFB\u4F55\u5C0F\u99AC\u9760\u8FD1."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824222
    m_Localized: "\u6211\u719F\u6089\u4E00\u96BB\u5929\u99AC. \u4ED6\u7684\u540D\u5B57\u53EB\u707D\u5384.
      \u59B3\u8A8D\u8B58\u4ED6\u55CE\uFF1F \u4ED6\u548C\u9019\u4EF6\u4E8B\u7121\u95DC\uFF0C\u5C0D\u5427\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824223
    m_Localized: "\u4ED6\u6709\u4E00\u500B\u8907\u96DC\u7684\u6545\u4E8B. \u4F46\u6C92\uFF0C\u4ED6\u8207\u6B64\u7121\u95DC."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824224
    m_Localized: "\u51B7\u7738\u7684\u9435\u9A0E\u885B\u8A66\u5716\u8207\u82F1\u514B\u96F7\u53D6\u5F97\u806F\u7E6B\uFF0C\u4F46\u6C92\u6709\u6536\u5230\u4EFB\u4F55\u56DE\u61C9.
      \u5C0D\u820A\u5929\u99AC\u80CC\u53DB\u7684\u8A18\u61B6\u548C\u5C0D\u8001\u9577\u8001\u7684\u61F7\u7591\u4F7F\u4ED6\u610F\u8B58\u5230\u65B0\u7684\u529B\u91CF\u5C0D\u9435\u9A0E\u885B\u4F86\u8AAA\u662F\u4E00\u7A2E\u5A01\u8105\uFF0C\u5C24\u5176\u662F\u5C0D\u4ED6\u81EA\u5DF1\u7684\u5A01\u8105.
      \u5118\u7BA1\u7F3A\u4E4F\u82F1\u514B\u96F7\u5C0D\u5730\u8868\u5C0F\u99AC\u61F7\u6709\u6575\u610F\u7684\u8B49\u64DA\uFF0C\u4ED6\u9084\u662F\u958B\u59CB\u70BA\u6230\u722D\u505A\u6E96\u5099.
      \u5C31\u50CF\u4E00\u96BB\u504F\u57F7\u7684\u8718\u86DB\uFF0C\u4ED6\u5728\u9CF4\u99AC\u5206\u652F\u4E2D\u7DE8\u7E54\u4E86\u81EA\u5DF1\u7684\u7DB2\uFF0C\u5C07\u4ED6\u4FE1\u4EFB\u7684\u5C0F\u99AC\u8207\u5176\u4ED6\u5C0F\u99AC\u5206\u958B\uFF0C\u4E26\u5C07\u4ED6\u5011\u5949\u737B\u7D66\u4ED6\u653B\u64CA\u82F1\u514B\u96F7\u57FA\u5730\u7684\u8A08\u756B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824225
    m_Localized: "\u4F46\u4ED6\u8DB3\u5920\u8070\u660E\uFF0C\u80FD\u5920\u51B7\u975C\u7684\u5C0D\u81EA\u5DF1\u7684\u5175\u529B\u548C\u53EF\u80FD\u7684\u6575\u4EBA\u5175\u529B\u505A\u51FA\u4F30\u8A08.
      \u4ED6\u660E\u767D\u9019\u500B\u57FA\u5730\u53EF\u80FD\u53EA\u662F\u51B0\u5C71\u4E00\u89D2:
      \u7562\u7ADF\uFF0C\u4ED6\u4E0D\u77E5\u9053\u5929\u99AC\u5728\u904E\u53BB\u7684\u5169\u767E\u5E74\u88E1\u662F\u5982\u4F55\u751F\u5B58\u4E0B\u4F86\u7684\uFF0C\u4E5F\u4E0D\u77E5\u9053\u4ED6\u5011\u8A2D\u6CD5\u4FDD\u7559\u4E86\u591A\u5C11\u6230\u524D\u8ECD\u4E8B\u529B\u91CF.
      \u4ED6\u4EE5\u51F1\u6492\u7684\u5F62\u5F0F\u96C6\u7D50\u4E86\u81EA\u5DF1\u7684\u76DF\u53CB\uFF0C\u4E5F\u770B\u5230\u4E86\u4E00\u80A1\u65B0\u52E2\u529B\u5728\u5EE2\u571F\u4E0A\u51FA\u73FE\u7684\u5DE8\u5927\u5A01\u8105."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824226
    m_Localized: "\u56E0\u6B64\u4ED6\u8A08\u756B\u8972\u64CA\u907F\u96E3\u5EC4 Pi\uFF0C@lp.
      \u4ED6\u77E5\u9053\u9019\u4E9B\u8A08\u756B\uFF0C\u4E26\u8A08\u756B\u7528\u5B83\u5011\u4F86\u8D0F\u5F97\u5373\u5C07\u5230\u4F86\u7684\u6230\u722D.\u5982\u679C\u6C92\u6709\u6230\u722D..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824227
    m_Localized: "...\u6211\u5011\u7684\u5BB6\u5712\u5C31\u4E0D\u6703\u53D7\u5230\u5A01\u8105.
      \u9867\u554F\u77E5\u9053\u9019\u4E00\u5207\u55CE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824228
    m_Localized: "\u662F\u7684. \u4ED6\u8B93\u6211\u7D66\u4F60\u4E00\u500B\u65B0\u7684\u4EFB\u52D9:
      \u8ABF\u67E5\u51FA\u70BA\u4F55\u82F1\u514B\u96F7\u8981\u4F86\u5230\u5730\u8868\u4EE5\u53CA\u4F7F\u4ED6\u5011\u96E2\u958B\u96F2\u969C\u7684\u539F\u56E0."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824229
    m_Localized: "\u73FE\u5728\u9435\u9A0E\u885B\u548C\u6591\u99AC\u8ECD\u5718\u6B63\u5728\u5C55\u958B\u4E00\u5834\u6FC0\u70C8\u7684\u6230\u9B25.
      \u5982\u679C\u82F1\u514B\u96F7\u6D88\u5931\uFF0C\u5B83\u4E5F\u5C07\u5931\u53BB\u610F\u7FA9.
      \u9451\u65BC\u51B7\u7738\u7684\u6B7B\uFF0C\u53CD\u5C0D\u8005\u751A\u81F3\u53EF\u80FD\u5750\u5728\u8AC7\u5224\u684C\u524D.
      \u6240\u4EE5\u9019\u4E0D\u50C5\u662F\u5C0D\u9435\u9A0E\u885B Pi \u7684\u795D\u798F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824230
    m_Localized: "\u4F46... \u6709\u53EF\u80FD\u55CE\uFF1F \u6211\u5011\u5982\u4F55\u624D\u80FD\u505A\u5230\u9019\u4E00\u9EDE\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824231
    m_Localized: "\u6211\u4E0D\u77E5\u9053. \u82F1\u514B\u96F7\u4E5F\u62D2\u7D55\u806F\u7E6B\u6211.
      \u4ED6\u5011\u64CA\u6BC0\u4E86\u6211\u767C\u9001\u7684\u6BCF\u4E00\u53F0\u6A5F\u68B0\u7CBE\u9748.
      \u5728\u4F60\u63A1\u53D6\u884C\u52D5\u4E4B\u524D\uFF0C\u4F60\u5FC5\u9808\u66F4\u591A\u5730\u77AD\u89E3\u4ED6\u5011\u548C\u4ED6\u5011\u7684\u76EE\u6A19.
      \u6B63\u5982\u8587\u8587\u6240\u8AAA\uFF0C\u9019\u4E0D\u80FD\u4FDD\u8B49\u6703\u594F\u6548.
      \u4F46\u5C31\u73FE\u6642\u800C\u8A00\uFF0C\u9019\u662F\u6700\u597D\u7684\u9078\u64C7."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824232
    m_Localized: "\u5982\u679C\u5B83\u5931\u6557\u4E86\uFF0C\u6211\u5011\u5C07\u4E0D\u5F97\u4E0D\u70BA\u4FDD\u885B\u907F\u96E3\u5EC4
      Pi \u505A\u6E96\u5099."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824233
    m_Localized: "\u6211\u53EF\u4EE5\u6F5B\u5165\u57FA\u5730\u4E26\u627E\u51FA\u5929\u99AC\u5728\u5C0B\u627E\u4EC0\u9EBC\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824234
    m_Localized: "\u4E5F\u8A31\u6211\u5011\u5225\u7121\u9078\u64C7. \u4F46\u662F\uFF0C@lp\uFF0C\u8ACB\u52D9\u5FC5\u5617\u8A66\u627E\u5230\u4E00\u500B\u548C\u5E73\u7684\u89E3\u6C7A\u65B9\u6848.
      \u6211\u5011\u4E0D\u9700\u8981\u898B\u66F4\u591A\u7684\u7D05."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824235
    m_Localized: "\u5982\u679C\u548C\u5E73\u806F\u7E6B\u5931\u6557\uFF0C\u59B3\u5C07\u6210\u70BA\u907F\u96E3\u5EC4
      Pi \u7684\u7B2C\u4E00\u9053\u9632\u7DDA. \u56E0\u6B64\uFF0C\u9019\u4E9B\u53E4\u795E\u5668\u7559\u5728\u4F60\u8EAB\u908A.
      \u59B3\u5FC5\u9808\u751F\u5B58\u548C\u6210\u529F\uFF0C\u800C\u5B83\u5011\u6703\u589E\u52A0\u59B3\u7684\u6A5F\u6703."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824236
    m_Localized: "\u4F3C\u4E4E\u69CD\u652F\u751F\u7522\u7DDA\u5C31\u5728\u9019\u88E1.
      \u6211\u5E0C\u671B\u6211\u4E0D\u6703\u9047\u5230\u6BD4\u5E7E\u5EA7\u7832\u5854\u66F4\u5371\u96AA\u7684\u6771\u897F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824237
    m_Localized: "\u96D6\u7136\u5F88\u5947\u602A\u9019\u500B\u5730\u65B9\u9084\u6C92\u6709\u88AB\u62FE..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824238
    m_Localized: "(\u63DA\u8072\u5668\u7684\u8072\u97F3) \u6CE8\u610F\uFF01 \u6AA2\u6E2C\u5230\u672A\u7D93\u6388\u6B0A\u7684\u9032\u5165.
      \u555F\u52D5 144-F \u5B89\u5168\u5354\u8B70.\n\u96FB\u570D\u6B04\u555F\u7528.\n\u53CD\u98DB\u884C\u6CD5\u8853\u555F\u7528.\n\u53CD\u50B3\u9001\u5492\u555F\u7528"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824239
    m_Localized: "\u8207\u585E\u62C9\u65AF\u8482\u4E9E\u7684\u71B1\u8FA3\u6027\u611B\u963F\uFF01|\u4ED6\u5ABD\u8A72\u6B7B\u7684..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824240
    m_Localized: "\u96FB\u570D\u6B04"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824241
    m_Localized: "\u96FB\u570D\u6B04... \u6211\u8A18\u5F97\u6211\u5011\u907F\u96E3\u53A9\u88E1\u4E5F\u6709\u985E\u4F3C\u7684\u6771\u897F.
      \u5F88\u8CED\u721B... \u5F88\u9760\u676F\uFF01 \u9019\u610F\u5473\u8457\u9019\u500B\u623F\u9593\u88E1\u7684\u6BCF\u4E00\u500B\u91D1\u5C6C\u7269\u9AD4\u90FD\u6703\u8B8A\u5F97\u81F4\u547D.
      \u6211\u4E0D\u80FD\u8E29\u91D1\u5C6C\u5730\u677F\uFF0C\u63A5\u89F8\u91D1\u5C6C\u7246\uFF0C\u9580\u548C\u50A2\u4FF1\uFF0C\u5426\u5247\u653E\u96FB\u6703\u56B4\u91CD\u640D\u5BB3\u6211\u7684\u5065\u5EB7.
      \u800C\u4E14\u6211\u751A\u81F3\u4E0D\u80FD\u7528\u5FF5\u529B\u4F86\u89F8\u78B0\u5B83\u5011
      - \u5FF5\u529B\u5C07\u5145\u7576\u5C0E\u9AD4\u800C\u6211\u6703\u53D7\u5230\u5B83\u5168\u9762\u7684\u53CD\u64CA\uFF0C\u751A\u81F3\u66F4\u7CDF."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824242
    m_Localized: "\u53EA\u6709\u6DF7\u51DD\u571F\uFF0C\u6728\u6750\u548C\u5851\u81A0\u662F\u76F8\u5C0D\u5B89\u5168\u7684.
      \u9019\u4E9B\u6750\u6599\u4E0D\u5C0E\u96FB ; \u6211\u53EF\u4EE5\u8E29\u5230\u5B83\u5011\u6216\u901A\u904E\u5FF5\u529B\u79FB\u52D5\u5B83\u5011."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824243
    m_Localized: "\u4F46\u53EF\u80FD\u6703\u6709\u597D\u6D88\u606F\uFF01 \u5982\u679C\u9019\u500B\u7CFB\u7D71\u8207\u6211\u5011\u7684\u7CFB\u7D71\u76F8\u4F3C\uFF0C\u90A3\u9EBC\u61C9\u8A72\u6709\u63A7\u5236\u7D42\u7AEF\u53EF\u4EE5\u505C\u7528\u96FB\u570D\u6B04.
      \u6211\u78BA\u4FE1\u6211\u53EF\u4EE5\u7834\u89E3\u5B83\u5011. \u4EE5\u6211\u7D2F\u7A4D\u7684\u6240\u6709\u7D93\u9A57\uFF0C\u6211\u600E\u9EBC\u53EF\u80FD\u5931\u6557\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824244
    m_Localized: "\u90A3\u9EBC\uFF0C\u8B93\u6211\u5011\u770B\u770B\u6211\u5011\u5728\u9019\u88E1\u6709\u4EC0\u9EBC.
      \u898F\u683C... \u8266\u70AE\uFF0C\u578B\u865F 8210 \"\u63A0\u596A\". \u65E8\u5728\u6467\u6BC0\u9B5A\u96F7\u8247\u548C\u5176\u4ED6\u5C0F\u578B\u8239\u96BB.
      \u5B83\u53EF\u4EE5\u5B89\u88DD\u5728\u4EFB\u4F55\u985E\u578B\u7684\u8239\u8236\u4E0A\uFF0C\u4E5F\u53EF\u4EE5\u7528\u4F86\u88DD\u5099\u5730\u9762\u706B\u529B\u9EDE.
      \u6280\u8853\u7279\u9EDE: \u53E3\u5F91 - 75 \u6BEB\u7C73; \u69CD\u7BA1\u9577\u5EA6
      - 3.8 \u7C73; \u91CD\u91CF - 790 \u516C\u65A4; \u5F48\u4E38\u91CD\u91CF - 8.7
      \u516C\u65A4; \u521D\u59CB\u901F\u5EA6 - 750 \u516C\u5C3A/\u79D2; \u5C04\u901F
      - \u6BCF\u5206\u9418 15 \u767C; \u6700\u5927\u5C04\u7A0B - 6.1 \u516C\u91CC."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824245
    m_Localized: "\u6C34\u5594\uFF01 \u5982\u679C\u6211\u5011\u5728\u71DF\u5730\u9644\u8FD1\u81F3\u5C11\u5B89\u88DD\u5E7E\u9580\u9019\u6A23\u7684\u8266\u70AE\uFF0C\u5C31\u6C92\u6709\u4E00\u500B\u9435\u9A0E\u885B\u6562\u9760\u8FD1\u4E86.
      \u898B\u9B3C\uFF0C\u8B93\u4ED6\u5011\u5E36\u8457\u5766\u514B\u4F86\u5427\uFF01
      \u73FE\u5728 \"\u9A30\u98DB\u5C0F\u99AC\" \u80AF\u5B9A\u6703\u6210\u70BA\u8A72\u5340\u57DF\u6700\u5805\u56FA\u7684\u5B9A\u5C45\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824246
    m_Localized: "\u4E5F\u8A31\u53E3\u5F91\u6709\u9EDE\u592A\u5927\u4E86\uFF0C\u751A\u81F3...
      \u597D\u5427\uFF0C\u9019\u4E0D\u518D\u662F\u6211\u7684\u554F\u984C\u4E86\uFF0C\u71DF\u5730\u88E1\u7684\u5C0F\u99AC\u6703\u60F3\u8FA6\u6CD5\u89E3\u51B3\u7684."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824247
    m_Localized: "\u8ACB\u6CE8\u610F: \u96FB\u6C23\u4FDD\u8B77\u65E8\u5728\u4FDD\u8B77\u91CD\u8981\u7684\u6230\u7565\u76EE\u6A19.
      \u4E3B\u8981\u4EFB\u52D9\u662F\u9632\u6B62\u6575\u65B9\u7279\u5DE5\u6EF2\u900F\u548C\u7ACA\u53D6\u5305\u542B\u8ECD\u4E8B\u6A5F\u5BC6\u7684\u91CD\u8981\u6587\u4EF6.
      \u6B21\u8981\u4EFB\u52D9\u662F\u500B\u99AC\u9632\u8B77. \u57FA\u65BC\u6B64\uFF0C\u6BCF\u500B\u8077\u54E1\u90FD\u9700\u8981\u77AD\u89E3\u96FB\u529B\u570D\u6B04\u555F\u52D5\u671F\u9593\u7684\u884C\u70BA\u898F\u5247:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824248
    m_Localized: "\u807D\u5230\u8B66\u5831\u5F8C\uFF0C\u7ACB\u5373\u96E2\u958B\u91D1\u5C6C\u5730\u677F;
      \u8ACB\u52FF\u89F8\u6478\u91D1\u5C6C\u7246\u58C1\uFF0C\u6A13\u68AF\uFF0C\u9580\uFF0C\u5BB6\u5177\u548C\u8A2D\u5099.
      \u5728\u6DF7\u51DD\u571F\u5730\u677F\u4E0A\u79FB\u52D5\uFF0C\u5982\u679C\u6C92\u6709\uFF0C\u722C\u4E0A\u6728\u88FD\u6216\u5851\u81A0\u684C\u5B50\uFF0C\u6C99\u767C\u6216\u76D2\u5B50.
      \u5446\u5728\u90A3\u88E1\u76F4\u5230\u570D\u6B04\u65B7\u96FB."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824249
    m_Localized: "\u6240\u6709\u5929\u99AC\u90FD\u88AB\u7981\u6B62\u98DB\u5230\u7A7A\u4E2D\uFF0C\u6240\u6709\u7368\u89D2\u7378
      - \u7528\u5FF5\u529B\u548C\u50B3\u9001\u63A5\u89F8\u91D1\u5C6C\u7269\u9AD4.
      \u7576\u96FB\u5B50\u570D\u6B04\u88AB\u555F\u7528\u6642\uFF0C\u6B64\u985E\u884C\u70BA\u53EF\u80FD\u662F\u81F4\u547D\u7684.
      \u9084\u8ACB\u8A18\u4F4F\uFF0C\u6A61\u81A0\u978B\u6216\u9632\u8B77\u670D\u4E0D\u6703\u4F7F\u60A8\u514D\u65BC\u89F8\u96FB\uFF0C\u5118\u7BA1\u5B83\u5011\u6703\u524A\u5F31\u5176\u6548\u679C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824250
    m_Localized: "\u5728\u96FB\u570D\u6B04\u555F\u7528\u671F\u9593\uFF0C\u5B89\u4FDD\u6A5F\u5668\u99AC\u9032\u5165\u8B66\u6212\u72C0\u614B.
      \u4E0D\u8981\u5728\u5B89\u4FDD\u6A5F\u5668\u99AC\u9762\u524D\u7A81\u7136\u79FB\u52D5\uFF0C\u4E26\u4FDD\u6301\u60A8\u7684
      \"ID \u8EAB\u5206\u8B58\u5225\u5361\" \u5728\u8996\u7DDA\u7BC4\u570D\u5167.
