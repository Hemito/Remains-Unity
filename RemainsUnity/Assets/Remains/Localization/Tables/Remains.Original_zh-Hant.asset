      m_Items: []
  - m_Id: 2725241479
    m_Localized: "\u9019\u500B\u5730\u96F7\u7684\u7206\u70B8\u6703\u662F\u5468\u570D\u7A7A\u6C23\u6EAB\u5EA6\u964D\u5230\u6975\u4F4E\uFF0C\u5C0D\u751F\u7269\u6703\u9020\u6210\u56B4\u91CD\u7684\u4F4E\u6EAB\u640D\u50B7."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241480
    m_Localized: "\u91CE\u706B\u5730\u96F7"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241481
    m_Localized: "\u4F7F\u7528\u91CE\u706B\u6838\u5F48\u5236\u6210\u7684\u5730\u96F7.\u53EA\u6709\u771F\u6B63\u7684\u70B8\u85E5\u5927\u5E2B\u624D\u80FD\u5920\u5236\u9020\u4E26\u4F7F\u7528\u9019\u7A2E\u5371\u96AA\u7684\u5730\u96F7."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241482
    m_Localized: "\u6591\u99AC\u5730\u96F7"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241483
    m_Localized: "\u9019\u7A2E\u5730\u96F7\u6BD4\u901A\u5E38\u7684\u788E\u7247\u5730\u96F7\u548C\u7B49\u96E2\u5B50\u5730\u96F7\u66F4\u5F37\u5927\uFF0C\u800C\u4E14\u7531\u65BC\u5B83\u7684\u507D\u88DD\u5716\u6848\uFF0C\u5B83\u66F4\u96E3\u88AB\u767C\u73FE.
      \u6B64\u5916\uFF0C\u6591\u99AC\u7D93\u5E38\u5C0D\u6B64\u985E\u5730\u96F7\u65BD\u4EE5\u8A5B\u5492\uFF0C\u4F7F\u5B83\u5011\u66F4\u52A0\u5371\u96AA."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241484
    m_Localized: "X-37\u9059\u63A7\u70B8\u5F48"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241485
    m_Localized: "\u4E00\u500B\u88DD\u6709\u7121\u7DDA\u5F15\u7206\u88DD\u7F6E\u7684\u5851\u81A0\u70B8\u85E5\uFF0C\u7CBE\u5DE7\u4F46\u4E5F\u5177\u6709\u6975\u5F37\u7684\u6C96\u64CA\u5A01\u529B.\u4F60\u53EF\u4EE5\u90E8\u7F72\u591A\u500B\u70B8\u5F48\u7136\u5F8C\u4F7F\u7528\u6309\u9375\u4F86\u540C\u6642\u5F15\u7206.\u6309\u88DD\u586B\u9375[R]\u4F86\u5F15\u7206.\u53EA\u6709\u540C\u4E00\u500B\u623F\u9593\u5167\u7684\u70B8\u5F48\u624D\u6703\u88AB\u5F15\u7206."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241486
    m_Localized: "\u70B8\u85E5\u5305"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241487
    m_Localized: "\u4E00\u6346\u7528\u81A0\u5E36\u5305\u8D77\u4F86\u7684\u70B8\u85E5\u68D2.\u6BD4\u666E\u901A\u70B8\u85E5\u66F4\u597D\u5C0D\u4ED8\u7246\u58C1\uFF0C\u4F46\u662F\u5C0D\u6DF7\u51DD\u571F\u7246\u4E0D\u6703\u9020\u6210\u592A\u5927\u50B7\u5BB3."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241488
    m_Localized: "\u571F\u5236\u70B8\u5F48"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241489
    m_Localized: "\u53EF\u4EE5\u7528\u65BC\u6467\u6BC0\u8106\u5F31\u7684\u7246\u58C1.\u66F4\u5805\u56FA\u7684\u7246\u53EF\u80FD\u9700\u8981\u66F4\u591A\u9019\u7A2E\u70B8\u85E5."
    m_Metadata:
      m_Items: []
