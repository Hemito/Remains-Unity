    m_Localized: "\u4E00\u7A2E\u7528\u860B\u679C\uFF0C24\u7A2E\u8349\u85E5\u53CA\u91AB\u7528\u9152\u7CBE\u5236\u6210\u7684\"\u6CBB\u7642\"\u5229\u53E3\u9152."
