    m_Localized: "\u554A\u554A\u554A\uFF01\u4E0D\u884C\uFF01\u6211\u624D\u4E0D\u611F\u8208\u8DA3.
      \u4E0D\u7BA1\u6709\u6C92\u6709\u9019\u500B\u5730\u4E0B\u5BA4\uFF01\u59B3\u660E\u767D\u55CE\uFF1F\uFF1F\uFF01\uFF01"
