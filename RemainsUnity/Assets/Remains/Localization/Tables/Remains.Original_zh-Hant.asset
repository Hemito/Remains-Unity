  - m_Id: 2729435983
    m_Localized: "\u7B49\u7D1A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435984
    m_Localized: "\u7D93\u9A57(\u8DDD\u4E0B\u4E00\u7B49\u7D1A)"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435985
    m_Localized: "\u96E3\u5EA6\u7B49\u7D1A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435986
    m_Localized: "\u751F\u547D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435987
    m_Localized: "\u4F60\u7684\u4E00\u822C\u751F\u547D\u72C0\u6CC1\uFF0C\u6C7A\u5B9A\u4E86\u4F60\u5728\u5931\u53BB\u610F\u8B58\u4E26\u9001\u56DE\u8A18\u9304\u9EDE\u524D\uFF0C\u6240\u53D7\u7684\u6700\u5927\u50B7\u5BB3\u503C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435988
    m_Localized: "\u8F3B\u5C04"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435989
    m_Localized: "\u8F3B\u5C04\u75C5\u6703\u8B93\u4F60\u7684\u5065\u5EB7\u6C34\u5E73\u964D\u4F4E\uFF0C\u4F7F\u7528\u6D88\u8F3B\u5BE7\u4F86\u6D88\u9664\u9AD4\u5167\u7684\u8F3B\u5C04."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435990
    m_Localized: "\u6BD2\u7D20"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435991
    m_Localized: "\u4F60\u9AD4\u5167\u6B98\u7559\u7684\u6BD2\u7D20\u6703\u6E1B\u5C11\u4F60\u7684\u6700\u5927\u751F\u547D\u503C\uFF0C\u76F4\u5230\u4F60\u4F7F\u7528\u89E3\u6BD2\u5291\u6216\u4E2D\u6BD2\u6548\u679C\u96A8\u6642\u9593\u6D88\u9000."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435992
    m_Localized: "\u5916\u50B7"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435993
    m_Localized: "\u5916\u50B7\u6703\u8B93\u4F60\u6301\u7E8C\u5931\u8840\uFF0C\u96D6\u7136\u6700\u7D42\u6703\u505C\u6B62\uFF0C\u4F46\u6700\u597D\u7ACB\u5373\u4F7F\u7528\u6B62\u8840\u5E36."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435994
    m_Localized: "\u5168\u8EAB\u72C0\u6CC1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435995
    m_Localized: "\u986F\u793A\u4F60\u7684\u8EAB\u9AD4\uFF0C\u982D\u90E8\u548C\u817F\u90E8\u7684\u72C0\u6CC1.
      \u50B7\u53E3\u5728\u6230\u5834\u4E0A\u9760\u6CBB\u7642\u85E5\u6C34\u662F\u96E3\u4EE5\u6062\u5FA9\u7684\uFF0C\u53D7\u50B7\u7684\u90E8\u4F4D\u5FC5\u9808\u6709\u5C08\u696D\u7684\u91AB\u751F\uFF0C\u6216\u7279\u6B8A\u7684\u91AB\u7642\u88DD\u5099\u548C\u8DB3\u5920\u7684\u80FD\u529B\u624D\u80FD\u6062\u5FA9.
      \u982D\u90E8\u53D7\u50B7\u6703\u5F71\u97FF\u4F60\u7684\u7CBE\u6E96\u5EA6\uFF0C\u653B\u64CA\u901F\u5EA6\u548C\u9B54\u6CD5.
      \u8EAB\u9AD4\u53D7\u50B7\u6703\u964D\u4F4E\u4F60\u7684\u8010\u529B. \u817F\u90E8\u53D7\u50B7\u5F71\u97FF\u5954\u8DD1\u901F\u5EA6.
      \u56B4\u91CD\u5931\u8840\u4E5F\u6703\u9020\u6210\u8A31\u591A\u7684\u8CA0\u9762\u5F71\u97FF."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435996
    m_Localized: "\u982D\u90E8"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435997
    m_Localized: "\u72C0\u614B: \u5B8C\u7F8E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435998
    m_Localized: "\u6C92\u6709\u4EFB\u4F55\u554F\u984C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435999
    m_Localized: "\u72C0\u614B: \u826F\u597D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436000
    m_Localized: "\u8A3A\u65B7: \u9664\u4E86\u8F15\u5FAE\u51FA\u8840\uFF0C\u8033\u6735\u64E6\u50B7\u548C\u9ED1\u773C\u5708\u5916\uFF0C\u4E26\u4E0D\u9700\u8981\u64D4\u5FC3\u591A\u5C11."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436001
    m_Localized: "\u72C0\u614B: \u5DEE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436002
    m_Localized: "\u8A3A\u65B7: \u982D\u90E8\u8F15\u50B7. \u53EF\u80FD\u5C0E\u81F4\u982D\u75BC\uFF0C\u982D\u6688\u548C\u60E1\u5FC3.
      \u5728\u9019\u7A2E\u72C0\u6CC1\u4E0B\u4F60\u96E3\u4EE5\u7528\u9B54\u6CD5\u4F86\u63A7\u5236\u6B66\u5668\u7784\u6E96.
      \u5EFA\u8B70\u76E1\u65E9\u5C31\u91AB."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436003
    m_Localized: "\u72C0\u614B: \u5371\u96AA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436004
    m_Localized: "\u8A3A\u65B7: \u982D\u90E8\u56B4\u91CD\u53D7\u50B7\uFF0C\u807D\u529B\u8996\u529B\u53D7\u640D.
      \u53EF\u80FD\u6709\u8A18\u61B6\u4E1F\u5931\uFF0C\u5E7B\u89BA\uFF0C\u53CD\u61C9\u9072\u920D\u7B49\u60C5\u6CC1.
      \u9B54\u6CD5\u4E0A\u9650\u503C\u6E1B\u5C11. \u5DF2\u7D93\u5A01\u8105\u5230\u751F\u547D\uFF0C\u5EFA\u8B70\u7ACB\u5373\u5C31\u91AB."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436005
    m_Localized: "\u8EAB\u9AD4"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436006
    m_Localized: "\u72C0\u614B: \u5B8C\u7F8E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436007
    m_Localized: "\u4F60\u7684\u8EAB\u9AD4\u5DF2\u6574\u88DD\u5F85\u767C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436008
    m_Localized: "\u72C0\u614B: \u826F\u597D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436009
    m_Localized: "\u8A3A\u65B7:\u6709\u4E00\u4E9B\u7600\u50B7\uFF0C\u71D2\u50B7\u548C\u5272\u50B7.
      \u8ACB\u66F4\u52A0\u5C0F\u5FC3\u4E00\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436010
    m_Localized: "\u72C0\u614B: \u5DEE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436011
    m_Localized: "\u8A3A\u65B7: \u6709\u4E9B\u8A31\u9AA8\u6298\uFF0C\u90E8\u5206\u5167\u81DF\u53D7\u50B7.
      \u6703\u964D\u4F4E\u4F60\u7684\u8010\u529B\uFF0C\u53EF\u80FD\u5F15\u8D77\u547C\u5438\u56F0\u96E3\uFF0C\u75BC\u75DB.
      \u5EFA\u8B70\u81E5\u5E8A\u4F11\u606F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436012
    m_Localized: "\u72C0\u614B: \u5371\u96AA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436013
    m_Localized: "\u8A3A\u65B7:\u591A\u8655\u9AA8\u6298\uFF0C\u591A\u8655\u5167\u50B7.
      \u53EF\u80FD\u6709\u810A\u690E\u53D7\u640D. \u6709\u5FC3\u529B\u8870\u7AED\u7684\u5371\u96AA.
      \u5DF2\u7D93\u5A01\u8105\u5230\u751F\u547D. \u9700\u8981\u7ACB\u5373\u5C31\u91AB."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436014
    m_Localized: "\u817F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436015
    m_Localized: "\u72C0\u614B: \u5B8C\u7F8E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436016
    m_Localized: "\u6C92\u6709\u53D7\u5230\u4EFB\u4F55\u50B7\u5BB3."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436017
    m_Localized: "\u72C0\u614B: \u826F\u597D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436018
    m_Localized: "\u8A3A\u65B7: \u8E1D\u95DC\u7BC0\u626D\u50B7. \u4E00\u5468\u5167\u4E0D\u8981\u4F7F\u7528\u9019\u689D\u817F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436019
    m_Localized: "\u72C0\u614B: \u5DEE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436020
    m_Localized: "\u8A3A\u65B7: \u81F3\u5C11\u65B7\u4E86\u4E00\u689D\u817F\uFF0C\u53E6\u4E00\u689D\u817F\u591A\u8655\u8F15\u50B7.
      \u5728\u9019\u7A2E\u72C0\u6CC1\u4E0B\u4F60\u7121\u6CD5\u6B63\u5E38\u5954\u8DD1.
      \u5EFA\u8B70\u7ACB\u5373\u8E44\u8853\u6062\u5FA9\uFF0C\u907F\u514D\u4EFB\u4F55\u5287\u70C8\u6D3B\u52D5."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436021
    m_Localized: "\u72C0\u614B: \u5371\u96AA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436022
    m_Localized: "\u8A3A\u65B7: \u591A\u8655\u958B\u653E\u6027\u9AA8\u6298\uFF0C\u8E1D\u95DC\u7BC0\u97CC\u5E36\u65B7\u88C2\uFF0C\u819D\u95DC\u7BC0\u9AA8\u6298.
      \u4EE4\u99AC\u9A5A\u8A1D\u4F60\u5728\u9019\u72C0\u6CC1\u4E0B\u4ECD\u7136\u53EF\u4EE5\u79FB\u52D5.
      \u4F46\u8ACB\u7ACB\u5373\u806F\u7CFB\u6700\u8FD1\u7684\u548C\u5E73\u90E8\u91AB\u7642\u7D44\u7E54."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436023
    m_Localized: "\u8840\u6DB2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436024
    m_Localized: "\u72C0\u614B: \u5B8C\u7F8E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436025
    m_Localized: "\u4F60\u5145\u6EFF\u4E86\u529B\u91CF."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436026
    m_Localized: "\u72C0\u614B: \u826F\u597D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436027
    m_Localized: "\u8A3A\u65B7:\u4F60\u6709\u9EDE\u5931\u8840\uFF0C\u4F46\u662F\u6C92\u95DC\u4FC2.
      \u826F\u597D\u7684\u4F11\u606F\u548C\u71DF\u990A\u6703\u8B93\u4F60\u6062\u5FA9\u6B63\u5E38."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436028
    m_Localized: "\u72C0\u614B: \u5DEE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436029
    m_Localized: "\u8A3A\u65B7: \u4F60\u5DF2\u7D93\u56B4\u91CD\u5931\u8840. \u6709\u7A81\u767C\u6027\u4E4F\u529B\uFF0C\u982D\u6688\uFF0C\u55AA\u5931\u610F\u8B58\u7684\u53EF\u80FD\u6027.
      \u5EFA\u8B70\u9032\u884C\u8F38\u8840."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436030
    m_Localized: "\u72C0\u614B: \u5371\u96AA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436031
    m_Localized: "\u8A3A\u65B7: \u4F60\u5C07\u56E0\u5931\u8840\u904E\u591A\u800C\u6B7B\u4EA1.
      \u4E0D\u60F3\u6B7B\u5C31\u7ACB\u99AC\u91C7\u53D6\u6CBB\u7642\u63AA\u65BD."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436032
    m_Localized: "\u9B54\u529B\u503C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436033
    m_Localized: "\u72C0\u614B: \u5B8C\u7F8E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436034
    m_Localized: "\u4F60\u64C1\u6709\u6700\u5927\u7684\u9B54\u529B\u503C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436035
    m_Localized: "\u72C0\u614B: \u826F\u597D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436036
    m_Localized: "\u4F60\u5DF2\u7D93\u6709\u9EDE\u75B2\u52DE\u4E86\uFF0C\u4F46\u662F\u9B54\u529B\u503C\u4ECD\u7136\u8DB3\u5920."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436037
    m_Localized: "\u72C0\u614B: \u5DEE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436038
    m_Localized: "\u4F60\u9700\u8981\u56DE\u5FA9\u9B54\u6CD5. \u73FE\u5728\u4F60\u7684\u5FF5\u529B\u548C\u9B54\u6CD5\u5492\u8A9E\u6BD4\u5E73\u6642\u6703\u7A0D\u5DEE\u4E00\u9EDE."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436039
    m_Localized: "\u72C0\u614B: \u5371\u96AA"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436040
    m_Localized: "\u4F60\u7684\u9B54\u6CD5\u5C07\u8981\u8017\u76E1. \u9B54\u6CD5\u5492\u8A9E\u548C\u5FF5\u529B\u80FD\u529B\u5927\u5927\u6E1B\u5F31.
      \u5F37\u70C8\u5EFA\u8B70\u4F11\u606F\u4E00\u4E0B\uFF0C\u4E26\u4F7F\u7528\u9B54\u6CD5\u6062\u5FA9\u54C1.
      \u7AED\u529B\u907F\u514D\u5728\u9019\u7A2E\u60C5\u6CC1\u4E0B\u4F7F\u7528\u5FA9\u96DC\u7684\u9B54\u6CD5\u5492\u8A9E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436041
    m_Localized: "\u72C0\u614B: \u67AF\u7AED"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436042
    m_Localized: "\u4F60\u5DF2\u7D93\u8017\u76E1\u4E86\u9B54\u6CD5. \u7121\u6CD5\u7528\u9B54\u6CD5\u8209\u8D77\u4EFB\u4F55\u6771\u897F\uFF0C\u66F4\u4E0D\u53EF\u80FD\u4F7F\u7528\u5176\u4ED6\u9B54\u6CD5\u5492\u8A9E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436043
    m_Localized: "\u6C92\u6709\u4E0A\u766E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436044
    m_Localized: "\u7B2C\u4E00\u7B49\u7D1A - \u8F15\u5FAE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436045
    m_Localized: "\u7B2C\u4E8C\u7B49\u7D1A - \u4E2D\u7B49"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436046
    m_Localized: "\u7B2C\u4E09\u7B49\u7D1A - \u5F37\u70C8"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436047
    m_Localized: "\u6709\u8F15\u5FAE\u7684\u6688\u7729"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436048
    m_Localized: "\u9169\u914A\u5927\u9189"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436049
    m_Localized: "\u9152\u7CBE\u5F8C\u907A\u75C7\u72C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436050
    m_Localized: "\u9152\u7CBE\u4E2D\u6BD2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436051
    m_Localized: "\u9152\u7CBE"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436052
    m_Localized: "\u751F\u547D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436053
    m_Localized: "\u6E1B\u50B7\u6578\u503C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436054
    m_Localized: "\u9019\u500B\u6307\u6A19\u6578\u503C\u6703\u5F9E\u4F60\u53D7\u5230\u7684\u4EFB\u4F55\u50B7\u5BB3\u4E2D\u6E1B\u53BB(\u4E0D\u5305\u62EC\u72C0\u614B\u6548\u679C.
      \u4F8B\u5982\uFF0C\u5B83\u4E0D\u6703\u6E1B\u53BB\u71C3\u71D2\uFF0C\u6D41\u8840\uFF0C\u4E2D\u6BD2\u72C0\u614B\u4E0B\u7684\u50B7\u5BB3)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436055
    m_Localized: "\u8B77\u7532\u4FDD\u8B77"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436056
    m_Localized: "\u5982\u679C\u5B50\u5F48\u6216\u8FD1\u6230\u6B66\u5668\u64CA\u4E2D\u8B77\u7532\uFF0C\u4F60\u53D7\u5230\u7684\u7269\u7406\u50B7\u5BB3\u53D6\u6C7A\u65BC\u4F60\u7684\u9632\u8B77\u6C34\u5E73.
      \u9632\u8B77\u503C\u53EA\u5F71\u97FF\u4F60\u53D7\u5230\u7684\u7269\u7406\u50B7\u5BB3\uFF0C\u5982\u5B50\u5F48\uFF0C\u8FD1\u6230\u6B66\u5668\uFF0C\u7206\u70B8.
      \u6E1B\u50B7\u591A\u5C11\u53D6\u6C7A\u65BC\u4F60\u7684\u8B77\u7532\u985E\u578B\u548C\u72C0\u614B.
      \u5982\u679C\u8010\u4E45\u5EA6\u4F4E\u65BC50%\uFF0C\u4FDD\u8B77\u80FD\u529B\u6703\u964D\u4F4E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436057
    m_Localized: "\u9B54\u6CD5\u6297\u6027"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436058
    m_Localized: "\u5982\u679C\u9B54\u6CD5\u5149\u675F\u6216\u985E\u4F3C\u7269\u64CA\u4E2D\u8B77\u7532\uFF0C\u9019\u6307\u6A19\u6703\u62B5\u6D88\u4F60\u53D7\u5230\u7684\u9B54\u80FD\u50B7\u5BB3
      . \u6E1B\u50B7\u985E\u578B\u6709\u706B\u7130\uFF0C\u96F7\u5C04\uFF0C\u7B49\u96E2\u5B50\uFF0C\u9583\u96FB\u6216\u51B0\u971C\u9020\u6210\u7684\u9B54\u6CD5\u50B7\u5BB3.
      \u6E1B\u50B7\u591A\u5C11\u53D6\u6C7A\u65BC\u4F60\u7684\u8B77\u7532\u985E\u578B\u548C\u72C0\u614B.
      \u5982\u679C\u8010\u4E45\u5EA6\u4F4E\u65BC50%\uFF0C\u4FDD\u8B77\u80FD\u529B\u6703\u964D\u4F4E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436059
    m_Localized: "\u8B77\u7532\u5FA9\u84CB\u7387"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436060
    m_Localized: "\u9019\u6307\u6A19\u80FD\u986F\u793A\u4F60\u7684\u8EAB\u9AD4\u88AB\u8B77\u7532\u5FA9\u84CB\u4E86\u591A\u5C11.
      \u4E8B\u5BE6\u4E0A\uFF0C\u9019\u662F\u4E00\u500B\u5B50\u5F48\u6216\u70AE\u5F48\u64CA\u4E2D\u4F60\u8B77\u7532\u5F8C\u964D\u4F4E\u50B7\u5BB3\u7684\u53EF\u80FD\u6027\u6578\u503C.
      \u9632\u8B77\u6027\u80FD\u53D6\u6C7A\u65BC\u4F60\u7684\u8B77\u7532\u985E\u578B\u548C\u72C0\u614B.
      \u5982\u679C\u8010\u4E45\u5EA6\u4F4E\u65BC50%\uFF0C\u4FDD\u8B77\u80FD\u529B\u6703\u964D\u4F4E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436061
    m_Localized: "\u9583\u907F\u52A0\u6210"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436062
    m_Localized: "\u9019\u500B\u52A0\u6210\u8D8A\u9AD8\uFF0C\u9060\u7A0B\u6B66\u5668\u7684\u6575\u99AC\u8D8A\u5BB9\u6613\u5931\u8E44.
      \u64CA\u4E2D\u4F60\u7684\u6A5F\u7387\u9664\u4EE5\u9583\u907F\u7684\u7D55\u5C0D\u503C.
      \u4F8B\u5982\uFF0C\u201C+ 20%\u201D\u7684\u52A0\u6210\u610F\u5473\u8457\u64CA\u4E2D\u4F60\u7684\u6A5F\u7387\u9664\u4EE5
      1.2 ."
