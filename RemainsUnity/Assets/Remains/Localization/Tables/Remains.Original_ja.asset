  - m_Id: 2729436480
    m_Localized: "\u30BA\u30FC\u30E0\u500D\u7387100%\u306E\u72B6\u614B\u3067\u30B2\u30FC\u30E0\u3092\u958B\u59CB\u3059\u308B\u3002\u30AA\u30D5\u306B\u3057\u305F\u5834\u5408\u306F\u90E8\u5C4B\u5168\u4F53\u304C\u753B\u9762\u5185\u306B\u6620\u308B\u3088\u3046\u306B\u7E2E\u5C0F\u3055\u308C\u308B\u3002\n\u30E2\u30CB\u30BF\u30FC\u306E\u89E3\u50CF\u5EA6\u304C\u30D5\u30EBHD\uFF081920x1080\uFF09\u4EE5\u4E0A\u306E\u5834\u5408\u306F\u30AA\u30F3\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u89E3\u50CF\u5EA6\u304C\u4F4E\u3044\u5834\u5408\u306F\u30B2\u30FC\u30E0\u4E2D\u306E\u51E6\u7406\u843D\u3061\u3092\u6E1B\u3089\u3059\u305F\u3081\u306B\u30AA\u30D5\u63A8\u5968\u3067\u3059\u3002\t\n\u30B2\u30FC\u30E0\u4E2D\u3067\u3082@1\u3067\u30BA\u30FC\u30E0\u500D\u7387\u3092\u5909\u66F4\u3059\u308B\u3053\u3068\u304C\u51FA\u6765\u307E\u3059\u3002\u753B\u9762\u5185\u306B\u90E8\u5C4B\u304C\u6620\u308A\u304D\u3089\u306A\u3044\u3068\u304D\u306F@2\u3092\u62BC\u3057\u306A\u304C\u3089\u30DE\u30A6\u30B9\u30AB\u30FC\u30BD\u30EB\u3092\u52D5\u304B\u3059\u3068\u30AB\u30E1\u30E9\u3092\u52D5\u304B\u305B\u307E\u3059\u3002"
