  - m_Id: 2729435457
    m_Localized: "\u300C\u8FD1\u63A5\u6B66\u5668\u300D\u30B9\u30AD\u30EB\u306F\u8FD1\u63A5\u6B66\u5668\u306B\u3088\u308B\u6226\u95D8\u6280\u80FD\u3092\u5F37\u5316\u3059\u308B\u3002
      [br]\u2026\u30B9\u30AD\u30EB\u30DD\u30A4\u30F3\u30C8\u3092\u5272\u308A\u632F\u308B\u3054\u3068\u306B\u8FD1\u63A5\u6B66\u5668\u306B\u3088\u308B\u30C0\u30E1\u30FC\u30B8\u304C#1\u305A\u3064\u4E0A\u6607\u3002[br]\u2026\u30B9\u30AD\u30EB\u30EC\u30D9\u30EB\u304C\u4E0A\u6607\u3059\u308B\u3054\u3068\u306B\u3088\u308A\u5F37\u529B\u306A\u8FD1\u63A5\u6B66\u5668\u3092\u4F7F\u7528\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u308B\u3002\u30B9\u30AD\u30EB\u30EC\u30D9\u30EB\u304C\u8DB3\u308A\u306A\u3044\u5834\u5408\u3001\u653B\u6483\u901F\u5EA6\u304C\u4F4E\u4E0B\u3057S.A.T.S.\u306E\u6D88\u8CBBAP\u304C\u5897\u5927\u3059\u308B\u3002"
