    m_Localized: "\u30DA\u30C3\u30AF\u3001\u4FFA\u3060\u3002\u30B9\u30C6\u30A3\u30F3\u30AB\u30FC\u3060\u3002\u7C21\u5358\u306B\u72B6\u6CC1\u3092\u8AAC\u660E\u3059\u308B\u3002\u4FFA\u9054\u306E\u30B0\u30EB\u30FC\u30D7\u306F\u30CF\u30F3\u30BF\u30FC\u5171\u306E\u63F4\u8B77\u3068\u3001\u4F8B\u306E\u533A\u57DF\u304C\u304A\u524D\u306E\u624B\u306B\u6E21\u3063\u305F\u304B\u3069\u3046\u304B\u3092\u76E3\u8996\u3059\u308B\u5F79\u76EE\u3092\u4EFB\u3055\u308C\u305F\u3002\u6B8B\u5FF5\u306A\u304C\u3089\u304A\u524D\u3092\u63A2\u3057\u3066\u3044\u308B\u6687\u306F\u306A\u3044\u304B\u3089\u3001\u3053\u3046\u3057\u3066\u30E1\u30E2\u3092\u6B8B\u3059\u3053\u3068\u306B\u3057\u305F\u3002\u3044\u3044\u304B\u3001\u4ECA\u3059\u3050\u5168\u3066\u3092\u307B\u3063\u307D\u308A\u51FA\u3057\u3066\u672C\u90E8\u306B\u884C\u3051\u3002\u305D\u3057\u3066\u3042\u306E\u5973\u3092\u30C8\u30A6\u30A3\u30FC\u30AF\u306B\u898B\u305B\u308B\u3093\u3060\u3002\u305D\u3046\u3059\u308A\u3083\u300C\u53CD\u6297\u300D\u306E\u7F70\u3067\u304A\u524D\u304C\u3042\u3044\u3064\u306B\u30B1\u30C4\u3092\u8E74\u3063\u98DB\u3070\u3055\u308C\u308B\u306E\u3092\u89B3\u5BDF\u3067\u304D\u3066\u4FFA\u304C\u697D\u3057\u3081\u308B\u3002\u2026\u5197\u8AC7\u3060\u3088\u76F8\u68D2\u3002\u672C\u984C\u306B\u5165\u308B\u305E\u3002\n\u304A\u524D\u306F\u5F8C\u885B\u90E8\u968A\u306E\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0\u306F\u3044\u306A\u304B\u3063\u305F\u3088\u306A\uFF1F\u3060\u304B\u3089\u305D\u306E\u5185\u5BB9\u3092\u624B\u77ED\u306B\u4F1D\u3048\u308B\u3002\u3053\u3053\u306B\u8AB0\u3082\u6765\u308B\u3068\u306F\u601D\u308F\u306D\u3048\u304C\u3001\u5FF5\u306E\u70BA\u3042\u306E\u30B9\u30C1\u30FC\u30EB\u306E\u30AF\u30BD\u91CE\u90CE\u5171\u3092\u8B66\u6212\u3057\u3066\u304A\u3051\u3002\u3042\u306E\u5175\u5668\u30D5\u30A7\u30C1\u5171\u306F\u4FFA\u3089\u306E\u5143\u306B\u30B9\u30D1\u30A4\u3092\u9001\u308A\u305F\u304C\u308B\u3093\u3060\u3002\u5225\u306B\u4FFA\u306F\u3069\u3046\u3067\u3082\u3044\u3044\u3093\u3060\u304C\u3001\u3053\u306E\u624B\u306E\u76E3\u8996\u304C\u3042\u308B\u3068\u96C7\u7528\u8005\u30B5\u30DE\u3082\u4E0D\u5B89\u306B\u306A\u308B\u304B\u3089\u306A\u3002\u30B9\u30D1\u30A4\u3092\u898B\u5206\u3051\u308B\u65B9\u6CD5\u3060\u304C\u3001\u3042\u306E\u9244\u30AF\u30BA\u5171\u306F\u30D4\u30C3\u30D7\u30D0\u30C3\u30AF\u3092\u7D76\u5BFE\u306B\u624B\u653E\u305D\u3046\u3068\u3057\u306A\u3044\u7656\u304C\u3042\u308B\u3002\u5974\u3089\u306E\u4FE1\u6761\u3068\u3084\u3089\u306B\u53CD\u3059\u308B\u3093\u3060\u3068\u3088\u3002\u3060\u304B\u3089\u3042\u306E\u88C5\u7F6E\u3092\u811A\u306B\u3064\u3051\u305F\u5974\u304C\u3044\u305F\u3089\u8FF7\u308F\u305A\u7A74\u3060\u3089\u3051\u306B\u3057\u308D\u3063\u3066\u304A\u524D\u306E\u30B0\u30EB\u30FC\u30D7\u306E\u5974\u3089\u306B\u4F1D\u3048\u3066\u304A\u3051\u3002\u305D\u308C\u3068\u3001\u9593\u9055\u3048\u3066\u95A2\u4FC2\u306A\u3044\u30DD\u30CB\u30FC\u3092\u6BBA\u3055\u306A\u3044\u3088\u3046\u306B\u306A\u3002\u96C7\u7528\u8005\u30B5\u30DE\u306F\u4F4F\u6C11\u3092\u6BBA\u3057\u305F\u304F\u306A\u3044\u3093\u3060\u305D\u3046\u3060\u3002\u3053\u308C\u304B\u3089\u8B77\u885B\u5175\u304C\u5B9A\u671F\u7684\u306B\u304A\u524D\u306E\u6240\u306B\u6765\u3066\u6355\u307E\u3048\u305F\u30DD\u30CB\u30FC\u3092\u56DE\u53CE\u3057\u306B\u6765\u308B\u304B\u3089\u3001\u304A\u524D\u304C\u308F\u3056\u308F\u3056\u90E8\u968A\u3092\u5206\u3051\u308B\u5FC5\u8981\u306F\u306D\u3048\u3002\u304F\u308C\u3050\u308C\u3082\u30D4\u30C3\u30D7\u30D0\u30C3\u30AF\u3068\u5305\u5E2F\u3092\u898B\u9593\u9055\u3048\u306A\u3044\u3088\u3046\u306B\u306A\uFF1F\u30CF\u30C3\u30CF\u30C3\u30CF\uFF01|\u30DA\u30C3\u30AF\u3001\u4FFA\u3060\u3002\u30B9\u30C6\u30A3\u30F3\u30AB\u30FC\u3060\u3002\u7C21\u5358\u306B\u72B6\u6CC1\u3092\u8AAC\u660E\u3059\u308B\u3002\u4FFA\u9054\u306E\u30B0\u30EB\u30FC\u30D7\u306F\u30CF\u30F3\u30BF\u30FC\u5171\u306E\u63F4\u8B77\u3068\u3001\u4F8B\u306E\u533A\u57DF\u304C\u304A\u524D\u306E\u624B\u306B\u6E21\u3063\u305F\u304B\u3069\u3046\u304B\u3092\u76E3\u8996\u3059\u308B\u5F79\u76EE\u3092\u4EFB\u3055\u308C\u305F\u3002\u6B8B\u5FF5\u306A\u304C\u3089\u304A\u524D\u3092\u63A2\u3057\u3066\u3044\u308B\u6687\u306F\u306A\u3044\u304B\u3089\u3001\u3053\u3046\u3057\u3066\u30E1\u30E2\u3092\u6B8B\u3059\u3053\u3068\u306B\u3057\u305F\u3002\u3044\u3044\u304B\u3001\u4ECA\u3059\u3050\u5168\u3066\u3092\u307B\u3063\u307D\u308A\u51FA\u3057\u3066\u672C\u90E8\u306B\u884C\u3051\u3002\u305D\u3057\u3066\u3042\u306E\u5973\u3092\u30C8\u30A6\u30A3\u30FC\u30AF\u306B\u898B\u305B\u308B\u3093\u3060\u3002\u305D\u3046\u3059\u308A\u3083\u300C\u53CD\u6297\u300D\u306E\u7F70\u3067\u304A\u524D\u304C\u3042\u3044\u3064\u306B\u30B1\u30C4\u3092\u8E74\u3063\u98DB\u3070\u3055\u308C\u308B\u306E\u3092\u89B3\u5BDF\u3067\u304D\u3066\u4FFA\u304C\u697D\u3057\u3081\u308B\u3002\u2026\u5197\u8AC7\u3060\u3088\u76F8\u68D2\u3002\u672C\u984C\u306B\u5165\u308B\u305E\u3002\n\u304A\u524D\u306F\u5F8C\u885B\u90E8\u968A\u306E\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0\u306F\u3044\u306A\u304B\u3063\u305F\u3088\u306A\uFF1F\u3060\u304B\u3089\u305D\u306E\u5185\u5BB9\u3092\u624B\u77ED\u306B\u4F1D\u3048\u308B\u3002\u3053\u3053\u306B\u8AB0\u3082\u6765\u308B\u3068\u306F\u601D\u308F\u306D\u3048\u304C\u3001\u5FF5\u306E\u70BA\u3042\u306E\u30B9\u30C1\u30FC\u30EB\u306E\u91CE\u90CE\u5171\u3092\u8B66\u6212\u3057\u3066\u304A\u3051\u3002\u3042\u306E\u5175\u5668\u30D5\u30A7\u30C1\u5171\u306F\u4FFA\u3089\u306E\u5143\u306B\u30B9\u30D1\u30A4\u3092\u9001\u308A\u305F\u304C\u308B\u3093\u3060\u3002\u5225\u306B\u4FFA\u306F\u3069\u3046\u3067\u3082\u3044\u3044\u3093\u3060\u304C\u3001\u3053\u306E\u624B\u306E\u76E3\u8996\u304C\u3042\u308B\u3068\u96C7\u7528\u8005\u30B5\u30DE\u3082\u4E0D\u5B89\u306B\u306A\u308B\u304B\u3089\u306A\u3002\u30B9\u30D1\u30A4\u3092\u898B\u5206\u3051\u308B\u65B9\u6CD5\u3060\u304C\u3001\u3042\u306E\u9244\u30AF\u30BA\u5171\u306F\u30D4\u30C3\u30D7\u30D0\u30C3\u30AF\u3092\u7D76\u5BFE\u306B\u624B\u653E\u305D\u3046\u3068\u3057\u306A\u3044\u7656\u304C\u3042\u308B\u3002\u5974\u3089\u306E\u4FE1\u6761\u3068\u3084\u3089\u306B\u53CD\u3059\u308B\u3093\