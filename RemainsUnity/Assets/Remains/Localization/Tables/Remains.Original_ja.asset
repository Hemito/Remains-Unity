      ([1]\uFF5E[0]\u3001[-]\u3001[=])\u3092\u62BC\u3059\u3068\u3001\u62BC\u3057\u305F\u30AD\u30FC\u306B\u9053\u5177\u304C\u767B\u9332\u3055\u308C\u307E\u3059\u3002\u30B2\u30FC\u30E0\u4E2D\u306B\u767B\u9332\u3057\u305F\u30B7\u30E7\u30FC\u30C8\u30AB\u30C3\u30C8\u30AD\u30FC\u3092\u62BC\u3059\u3053\u3068\u3067\u30E1\u30CB\u30E5\u30FC\u3092\u958B\u304B\u305A\u3068\u3082\u9053\u5177\u304C\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002\u307E\u305F\u3001@1\u3092\u62BC\u3057\u306A\u304C\u3089[\u30B7\u30E7\u30FC\u30C8\u30AB\u30C3\u30C8\u30AD\u30FC]
