    m_Localized: "\u3057\u304B\u3057\u306A\u304C\u3089\u3001\u8CC7\u6E90\u8ABF\u9054\u3068\u3044\u3046\u9762\u3067\u306F\u559C\u3070\u3057\u3044\u8ABF\u67FB\u7D50\u679C\u304C\u51FA\u3066\u304A\u308A\u307E\u3059\u3002\u5730\u8868\u306E\u958B\u62D3\u306B\u3088\u3063\u3066\u3001\u7CBE\u932C\u3055\u308C\u305F\u91D1\u5C5E\u3001\u69D8\u3005\u306A\u8A2D\u5099\u3001\u4FDD\u5B58\u98DF\u3001\u305D\u306E\u4ED6\u306E\u88FD\u9020\u696D\u3084\u52A0\u5DE5\u696D\u306B\u3088\u308B\u7523\u7269\u306E\u56DE\u53CE\u304C\u671F\u5F85\u3067\u304D\u307E\u3059\u3002\u30E1\u30AC\u30B9\u30DA\u30EB\u306B\u3088\u308B\u653B\u6483\u3067\u751F\u5B58\u8005\u304C\u307B\u307C\u3044\u306A\u3044\u3053\u3068\u3092\u8003\u616E\u3059\u308C\u3070\u3001\u3053\u308C\u3089\u306E\u5927\u91CF\u306E\u5099\u84C4\u304C\u624B\u3064\u304B\u305A\u306A\u307E\u307E\u6B8B\u3063\u3066\u3044\u308B\u53EF\u80FD\u6027\u306F\u9AD8\u3044\u3067\u3057\u3087\u3046\u3002\u7279\u306B\u5927\u304D\u306A\u5229\u76CA\u304C\u898B\u8FBC\u3081\u308B\u306E\u306F\u300C\u6700\u5F8C\u306E\u65E5\u300D\u4EE5\u524D\u306B\u5EFA\u3066\u3089\u308C\u305F\u8ECD\u4E8B\u65BD\u8A2D\u3068\u30B9\u30C6\u30FC\u30D6\u30EB\u30C6\u30C3\u30AF\u793E\u306E\u30B7\u30A7\u30EB\u30BF\u30FC\u3067\u3042\u308B\u30B9\u30C6\u30FC\u30D6\u30EB\u3067\u3059\u3002\u3053\u308C\u3089\u306E\u65BD\u8A2D\u306B\u3064\u3044\u3066\u306E\u8A73\u7D30\u306A\u5831\u544A\u306F\u8ABF\u67FB\u6587\u66F8\u306B\u6DFB\u4ED8\u3057\u3066\u304A\u308A\u307E\u3059\u3002\n\u6211\u3005\u306F\u6B21\u306E\u6307\u793A\u3092\u304A\u5F85\u3061\u3057\u3066\u304A\u308A\u307E\u3059\u3002\n187\u5E746\u670814\u65E5\n\u30A6\u30A3\u30F3\u30C9\u30D5\u30ED\u30FC\u5927\u4F50*"
