    m_Localized: "\u300C\u30A8\u30CD\u30EB\u30AE\u30FC\u6B66\u5668\u300D\u30B9\u30AD\u30EB\u306F\u30EC\u30FC\u30B6\u30FC\u3001\u30D7\u30E9\u30BA\u30DE\u3001\u30D1\u30EB\u30B9\u3001\u706B\u708E\u653E\u5C04\u5668\u306E\u6271\u3044\u3092\u4E0A\u9054\u3055\u305B\u308B\u3002[br]\u2026\u30B9\u30AD\u30EB\u30EC\u30D9\u30EB\u3092\u5272\u308A\u632F\u308B\u3054\u3068\u306B\u30A8\u30CD\u30EB\u30AE\u30FC\u6B66\u5668\u306B\u3088\u308B\u30C0\u30E1\u30FC\u30B8\u304C#1\u4E0A\u6607\u3059\u308B\u3002[br]\u2026\u30B9\u30AD\u30EB\u30EC\u30D9\u30EB\u304C\u4E0A\u6607\u3059\u308B\u3068\u3088\u308A\u5F37\u529B\u306A\u30A8\u30CD\u30EB\u30AE\u30FC\u6B66\u5668\u3092\u4F7F\u7528\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u308B\u3002\u30B9\u30AD\u30EB\u30EC\u30D9\u30EB\u304C\u8DB3\u308A\u306A\u3044\u5834\u5408\u3001\u547D\u4E2D\u7387\u304C\u4F4E\u4E0B\u3059\u308B\u3002"
