  - m_Id: 2733629552
    m_Localized: "\u041F\u043E\u0434\u043E\u043B\u0430\u0439\u0442\u0435 \u043F\u0456\u0434\u0439\u043E\u043C\u043D\u0443
      \u0441\u0438\u043B\u0443 \u0432\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E\u0433\u043E
      \u0430\u043D\u0442\u0438\u0433\u0440\u0430\u0432\u0456\u0442\u0430\u0446\u0456\u0439\u043D\u043E\u0433\u043E
      \u043B\u0456\u0444\u0442\u0430. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043D\u0430\u0431\u0440\u0430\u0442\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0443
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u043F\u0430\u0434\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629553
    m_Localized: "\u0422\u0440\u0435\u0442\u0456\u0439 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0438\u0439 \u043F\u0456\u0434
      \u043F\u0456\u0434\u043B\u043E\u0433\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629554
    m_Localized: "\u0421\u0442\u0440\u0456\u043B\u044C\u0431\u0430 \u043F\u043E \u043A\u043D\u043E\u043F\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629555
    m_Localized: "\u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456\u0432 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u0443\u0441\u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u0456 \u043A\u043D\u043E\u043F\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629556
    m_Localized: "\u0429\u043E\u0431 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u043D\u0438\u0436\u043D\u044E \u043A\u043D\u043E\u043F\u043A\u0443, \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0433\u0440\u0430\u043D\u0430\u0442\u0443 \u0441\u043F\u0456\u043B\u044C\u043D\u043E
      \u0437 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629557
    m_Localized: "\u0414\u0432\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629558
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u0443\u0439\u0442\u0435 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E
      \u0434\u0432\u0456 \u043A\u043D\u043E\u043F\u043A\u0438 \u0437 \u0431\u043E\u043A\u0456\u0432
      \u043A\u0456\u043C\u043D\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629559
    m_Localized: "\u0429\u043E\u0431 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0456
      \u0434\u0432\u0435\u0440\u0456 \u043D\u0435 \u0437\u0430\u0447\u0438\u043D\u044F\u043B\u0438\u0441\u044F,
      \u043F\u043E\u0441\u0442\u0430\u0432\u0442\u0435 \u0432 \u0434\u0432\u0435\u0440\u043D\u043E\u043C\u0443
      \u043E\u0442\u0432\u043E\u0440\u0456 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629560
    m_Localized: "\u041C\u0435\u0442\u0430\u043D\u043D\u044F \u0433\u0440\u0430\u043D\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629561
    m_Localized: "\u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0432\u043B\u0443\u0447\u043D\u043E\u0433\u043E \u043C\u0435\u0442\u0430\u043D\u043D\u044F
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u0443\u0441\u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u0456 \u043A\u043D\u043E\u043F\u043A\u0438.
      \u041F\u043E\u0440\u0430\u0434\u0430: \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0417.\u041F.\u0421. \u0434\u043B\u044F \u043A\u0440\u0430\u0449\u043E\u0433\u043E
      \u043F\u0440\u0438\u0446\u0456\u043B\u044E\u0432\u0430\u043D\u043D\u044F. \u0429\u043E\u0431
      \u043C\u0435\u0442\u043D\u0443\u0442\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0443
      \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0443 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C,
      \u0432\u0438\u0432\u0447\u0456\u0442\u044C \u043D\u0430\u0432\u0438\u0447\u043A\u0443
      \"\u0412\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430\". \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0440\u0435\u0433\u0443\u043B\u044E\u0432\u0430\u0442\u0438 \u0441\u0438\u043B\u0443
      \u043A\u0438\u0434\u043A\u0430, \u0437\u043C\u0456\u043D\u044E\u044E\u0447\u0438
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F \u043A\u0443\u0440\u0441\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629562
    m_Localized: "\u0429\u043E\u0431 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u0431\u043B\u0438\u0436\u043D\u044E \u043A\u043D\u043E\u043F\u043A\u0443,
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437 \u0456\u0437 \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u043D\u043E\u044E
      \u0448\u0430\u0448\u043A\u043E\u044E. \u0429\u043E\u0431 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u0434\u0430\u043B\u044C\u043D\u044E \u043A\u043D\u043E\u043F\u043A\u0443,
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0417.\u041F.\u0421. \u0456 \u043F\u0456\u0434\u0431\u0435\u0440\u0456\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443 \u0442\u0440\u0430\u0454\u043A\u0442\u043E\u0440\u0456\u044E
      \u043A\u0438\u0434\u043A\u0430. \u0417\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0412\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430\"
      \u043D\u0435 \u043C\u0435\u043D\u0448\u0435 \u043D\u0456\u0436 3-\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629563
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0430 \u0432\u0435\u0441\u0435\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629564
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u043D\u0430 \u0432\u0441\u0456 \u043A\u043D\u043E\u043F\u043A\u0438. \u041A\u043E\u0436\u043D\u0430
      \u043A\u043D\u043E\u043F\u043A\u0430 \u0440\u0435\u0430\u0433\u0443\u0454 \u043D\u0430
      \u043E\u0434\u0438\u043D \u043F\u0435\u0432\u043D\u0438\u0439 \u0442\u0438\u043F
      \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629565
    m_Localized: "\u041B\u0430\u0437\u0435\u0440, \u0432\u043E\u0433\u043E\u043D\u044C,
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0430, \u043A\u0438\u0441\u043B\u043E\u0442\u0430,
      \u043F\u043B\u0430\u0437\u043C\u0430, \u0445\u043E\u043B\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629566
    m_Localized: "\u041F\u0430\u0434\u0430\u044E\u0447\u0430 \u0432\u0435\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629567
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u044F\u0449\u0438\u043A\u0438, \u0449\u043E\u0431 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0443 \u043D\u0430\u0433\u043E\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629568
    m_Localized: "\u041F\u043E\u0431\u0443\u0434\u0443\u0439\u0442\u0435 \u043F\u043E\u0445\u0438\u043B\u0443
      \u0432\u0435\u0436\u0443, \u0441\u0442\u0430\u0432\u043B\u044F\u0447\u0438
      \u043E\u0434\u0438\u043D \u044F\u0449\u0438\u043A \u043D\u0430 \u043A\u0440\u0430\u0439
      \u0456\u043D\u0448\u043E\u0433\u043E. \u041F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E
      \u044F\u043A \u0432\u0438\u043A\u043E\u043D\u0430\u0454\u0442\u0435 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F,
      \u0432\u0438\u0441\u043C\u0438\u043A\u043D\u0456\u0442\u044C \u043D\u0438\u0436\u043D\u0456\u0439
      \u044F\u0449\u0438\u043A. \u0424\u0456\u0437\u0438\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629569
    m_Localized: "\u0412\u0430\u043D\u0442\u0430\u0436\u043E\u043F\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629570
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F, \u0449\u043E
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432 \u043A\u0456\u043C\u043D\u0430\u0442\u0456,
      \u0449\u043E\u0431 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0443 \u043D\u0430\u0433\u043E\u0440\u0456.
      \u041D\u0435 \u043F\u0430\u0434\u0430\u0439\u0442\u0435 \u0432\u043D\u0438\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629571
    m_Localized: "\u041F\u043E\u0431\u0443\u0434\u0443\u0439\u0442\u0435 \u0432\u0435\u0436\u0443
      \u0437 \u044F\u0449\u0438\u043A\u0456\u0432 \u043D\u0430 \u0440\u0443\u0445\u043E\u043C\u0456\u0439
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0456. \u042F\u043A\u0449\u043E
      \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0443 \u044F\u043C\u0443, \u0432\u0438\u0439\u0434\u0456\u0442\u044C \u0456\u0437
      \u043A\u0456\u043C\u043D\u0430\u0442\u0438 \u0442\u0430 \u0437\u0430\u0439\u0434\u0456\u0442\u044C
      \u0443 \u043D\u0435\u0457 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629572
    m_Localized: "\u0417\u0430\u043F\u043B\u0443\u0442\u0430\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629573
    m_Localized: "\u0421\u0442\u0440\u0438\u0431\u0430\u0439\u0442\u0435 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C\u0438
      \u0442\u0430 \u0441\u0445\u043E\u0434\u0430\u043C\u0438, \u0449\u043E\u0431
      \u0437\u0430 \u0432\u0456\u0434\u0432\u0435\u0434\u0435\u043D\u0438\u0439 \u0447\u0430\u0441
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0432\u0435\u0440\u0445\u0443.
      \u0417\u0430\u043D\u0430\u0434\u0442\u043E \u043B\u0435\u0433\u043A\u043E?
      \u0422\u043E\u0434\u0456 \u0437\u0440\u043E\u0431\u0456\u0442\u044C \u0442\u0435
      \u0441\u0430\u043C\u0435, \u043A\u043E\u043B\u0438 \"\u043B\u0456\u0432\u043E\u0440\u0443\u0447\"
      \u0456 \"\u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447\" \u043F\u043E\u043C\u0456\u043D\u044F\u043B\u0438\u0441\u044F
      \u043C\u0456\u0441\u0446\u044F\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629574
    m_Localized: "\u0420\u043E\u0437\u043A\u043E\u043F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629575
    m_Localized: "\u0414\u0435\u0441\u044C \u0442\u0443\u0442 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0441\u0435\u0439\u0444. \u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C
      \u0439\u043E\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629576
    m_Localized: "\u041F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E \u0431\u0435\u0437\u043B\u0456\u0447
      \u0441\u043A\u0430\u0440\u0431\u0456\u0432 - \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u043A\u0443\u0432\u0430\u043B\u0434\u0443 \u0430\u0431\u043E \u0434\u0438\u043D\u0430\u043C\u0456\u0442,
      \u0449\u043E\u0431 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u043D\u0438\u0445. \u041E\u0431\u0435\u0440\u0435\u0436\u043D\u043E, \u0432\u0456\u0431\u0440\u0430\u0446\u0456\u044F
      \u0437\u0435\u043C\u043B\u0456 \u043F\u0440\u0438\u0432\u0430\u0431\u043B\u044E\u0454
      \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629577
    m_Localized: "\u0421\u043B\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629578
    m_Localized: "\u041B\u044E\u0431\u0438\u0442\u0435 \u043F\u043B\u0430\u0432\u0430\u0442\u0438
      \u0432 \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0456\u0439
      \u0432\u043E\u0434\u0456? \u0410 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F,
      \u0456\u043D\u0430\u043A\u0448\u0435 \u0442\u0443\u0442 \u043D\u0456\u044F\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629579
    m_Localized: "\u0417\u043B\u0438\u0432\u0430\u0439\u0442\u0435 \u0432\u043E\u0434\u0443,
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0447\u0438 \u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0438.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0430\u043D\u0442\u0438\u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0439\u043D\u0438\u0439
      \u043A\u043E\u0441\u0442\u044E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629580
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629581
    m_Localized: "\u0412\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
      \u0442\u0443\u0442, \u0430 \u043F\u043E\u0442\u0456\u043C \u0434\u043E\u0431\u0456\u0433\u0442\u0438
      \u043D\u0430 \u0442\u043E\u0439 \u0431\u0456\u043A, \u043F\u043E\u043A\u0438
      \u0434\u0432\u0435\u0440\u0456 \u043D\u0435 \u0437\u0430\u0447\u0438\u043D\u0438\u043B\u0438\u0441\u044F.
      \u0423\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u043E, \u0433\u043E\u043B\u043E\u0432\u043D\u0435
      - \u0432\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629582
    m_Localized: "\u0412\u043E\u0434\u0430 \u043D\u0430 \u043D\u0438\u0436\u043D\u044C\u043E\u043C\u0443
      \u0440\u0456\u0432\u043D\u0456 \u0432\u0430\u0441 \u0441\u0438\u043B\u044C\u043D\u043E
      \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u044C, \u043F\u043E\u0437\u0431\u0443\u0434\u044C\u0442\u0435\u0441\u044F
      \u0457\u0457. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0445\u0456\u043C\u0456\u044E, \u0449\u043E\u0431 \u0448\u0432\u0438\u0434\u0448\u0435
      \u0431\u0456\u0433\u0442\u0438 \u0456 \u0432\u0438\u0449\u0435 \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629583
    m_Localized: "\u0420\u043E\u0437\u0441\u0430\u0434\u043D\u0438\u043A \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629584
    m_Localized: "\u0417\u043D\u0438\u0449\u0456\u0442\u044C \u0443\u0441\u0456 \u0433\u043D\u0456\u0437\u0434\u0430
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629585
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0438
      \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456 \u0434\u043E \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u0417\u043D\u0438\u0449\u0456\u0442\u044C
      \u044F\u043A\u043D\u0430\u0439\u0448\u0432\u0438\u0434\u0448\u0435 \u0441\u0430\u043C\u0456
      \u0433\u043D\u0456\u0437\u0434\u0430, \u0456\u043D\u0430\u043A\u0448\u0435
      \u0432\u043E\u043D\u0438 \u0432\u0435\u0441\u044C \u0447\u0430\u0441 \u043F\u043B\u043E\u0434\u0438\u0442\u0438\u043C\u0443\u0442\u044C
      \u043D\u043E\u0432\u0438\u0445 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629586
    m_Localized: "\u041C\u0443\u0440\u0430\u0448\u0438\u043D\u0456 \u0442\u0443\u043D\u0435\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629587
    m_Localized: "\u0417\u043D\u0438\u0449\u0456\u0442\u044C \u0443\u0441\u0456 \u043C\u0443\u0440\u0430\u0448\u043D\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629588
    m_Localized: "\u041C\u0443\u0440\u0430\u0448\u043D\u0438\u043A\u0438 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448
      \u0443\u0440\u0430\u0437\u043B\u0438\u0432\u0456 \u0434\u043E \u0432\u0438\u0431\u0443\u0445\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629589
    m_Localized: "\u041A\u0430\u0431\u0456\u043D\u0435\u0442 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430
      \u0437\u0430\u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629590
    m_Localized: "\u0417\u0430\u0431\u0435\u0440\u0456\u0442\u044C \u0446\u0456\u043D\u043D\u0456
      \u0440\u0435\u0447\u0456 \u0437 \u0441\u0435\u0439\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629591
    m_Localized: "\u0421\u0445\u043E\u0432\u0438\u0449\u0435 \u0434\u0430\u043D\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629592
    m_Localized: "\u0421\u0445\u043E\u0432\u0438\u0449\u0435 \u0434\u0430\u043D\u0438\u0445
      \u0456 \u0441\u0435\u0440\u0432\u0435\u0440\u043D\u0430. \u0412\u0445\u0456\u0434
      \u0434\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u0438\u0439 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0414\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u0446\u0456, \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0443
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u043E\u0457 \u0441\u043B\u0443\u0436\u0431\u0438
      \u0442\u0430 \u0441\u0438\u0441\u0430\u0434\u043C\u0456\u043D\u0443. \u0423\u0432\u0430\u0433\u0430!
      \u0412\u043E\u0433\u043E\u043D\u044C \u043F\u043E \u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0430\u0445
      \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u0435\u0437 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629593
    m_Localized: "\u0417\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u0456 \u0442\u0443\u043D\u0435\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629594
    m_Localized: "\u0412\u0438 \u0432\u043C\u0456\u0454\u0442\u0435 \u043D\u0430\u0434\u043E\u0432\u0433\u043E
      \u0437\u0430\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0434\u0438\u0445\u0430\u043D\u043D\u044F,
      \u043E\u0440\u0456\u0454\u043D\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0432 \u043A\u0430\u043B\u0430\u043C\u0443\u0442\u043D\u0456\u0439 \u0432\u043E\u0434\u0456,
      \u0432\u043C\u0456\u0454\u0442\u0435 \u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438? \u042F\u043A\u0449\u043E
      \u043D\u0456, \u0442\u043E \u0432\u0438 \u0442\u0443\u0442 \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629595
    m_Localized: "\u0420\u0443\u0445\u043E\u043C\u0456 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629596
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0447\u0438
      \u0440\u0443\u0445\u043E\u043C\u0456 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438,
      \u0434\u0456\u0441\u0442\u0430\u043D\u044C\u0442\u0435\u0441\u044F \u0434\u043E
      \u0441\u0435\u0439\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629597
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0456 \u043F\u0430\u0441\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629598
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u044C\u0442\u0435 \u043B\u0430\u0437\u0435\u0440\u043D\u0456
      \u043F\u0430\u0441\u0442\u043A\u0438, \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435
      \u0457\u0445 \u0430\u0431\u043E \u043F\u0440\u043E\u0440\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044F
      \u0437 \u0431\u043E\u0454\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629599
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0456 \u0434\u0430\u0442\u0447\u0438\u043A\u0438
      \u0440\u0435\u0430\u0433\u0443\u044E\u0442\u044C \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0430 \u0432\u043E\u0440\u043E\u0436\u0456 \u0446\u0456\u043B\u0456.
      \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u043D\u0430 \u0432\u0430\u0441.
      \u0407\u0445 \u043C\u043E\u0436\u043D\u0430 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438,
      \u043C\u0430\u044E\u0447\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u0456\u0439
      \u0440\u0456\u0432\u0435\u043D\u044C \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u041D\u0430\u0443\u043A\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629600
    m_Localized: "\u0417\u043E\u043D\u0430 \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629601
    m_Localized: "\u041F\u043E\u0434\u043E\u043B\u0430\u0439\u0442\u0435 \u043F\u0440\u043E\u0445\u0456\u0434,
      \u044F\u043A\u0438\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u044E\u0442\u044C
      \u0442\u0443\u0440\u0435\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629602
    m_Localized: "\u0417\u0430 \u043D\u0435\u043C\u0456\u0446\u043D\u043E\u044E \u0441\u0442\u0456\u043D\u043E\u044E
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0438\u0439 \u0434\u0435\u0442\u043E\u043D\u0430\u0442\u043E\u0440,
      \u0449\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454 \u0434\u043E\u0441\u0442\u0443\u043F
      \u0434\u043E \u0431\u0430\u0441\u0435\u0439\u043D\u0443 \u0437 \u0432\u043E\u0434\u043E\u044E.
      \u0412\u043E\u0434\u0430 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629603
    m_Localized: "\u0420\u043E\u0431\u043E\u0442\u0438"
    m_Metadata:
      m_Items: []
