  - m_Id: 2733630065
    m_Localized: "\u0422\u0430\u043A, \u0432\u0438\u0439\u0448\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630066
    m_Localized: "\u0422\u0438\u0445\u0456\u0448\u0435, \u043D\u0435 \u043A\u0440\u0438\u0447\u0438,
      \u044F \u0449\u043E\u0439\u043D\u043E \u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0432\u0441\u044F!
      \u0422\u0438 \u0437\u043D\u0430\u0454\u0448 \u0445\u043E\u0447, \u0449\u043E
      \u0437\u0430\u0440\u0430\u0437 \u0434\u0440\u0443\u0433\u0430 \u0433\u043E\u0434\u0438\u043D\u0430
      \u043D\u043E\u0447\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630067
    m_Localized: "\u0412\u0438\u0431\u0430\u0447\u0442\u0435, \u043D\u0435 \u0441\u0442\u0435\u0436\u0438\u043B\u0430
      \u0437\u0430 \u0447\u0430\u0441\u043E\u043C, \u043F\u043E\u043A\u0438 \u043F\u0440\u043E\u0440\u0438\u0432\u0430\u043B\u0430\u0441\u044F
      \u043A\u0440\u0456\u0437\u044C \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0435,
      \u0437\u0430\u0431\u0438\u0442\u0435 \u0440\u043E\u0431\u043E\u0442\u0430\u043C\u0438
      \u0456 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438
      \u0421\u0442\u0456\u0439\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630068
    m_Localized: "\u041A\u0438\u043C \u0437\u0430\u0431\u0438\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630069
    m_Localized: "\u0422\u0430\u043A, \u0441\u043B\u0443\u0445\u0430\u0439\u0442\u0435.
      \u0422\u0443\u0442, \u0443 \u0421\u0442\u0456\u0439\u043B\u0456 88, \u043E\u0440\u0443\u0434\u0443\u0454
      \u0432\u0435\u043B\u0438\u043A\u0430 \u0433\u0440\u0443\u043F\u0430 \u043F\u043E\u043D\u0456,
      \u044F\u043A\u0456 \u043B\u043E\u0432\u043B\u044F\u0442\u044C \u0456 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442\u044C
      \u0443 \u0440\u0430\u0431\u0441\u0442\u0432\u043E \u0456\u043D\u0448\u0438\u0445
      \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630070
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u0445\u0442\u043E \u0442\u0430\u043A\u0456
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456, @lp..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630071
    m_Localized: "... \u044F\u043A\u0456 \u043F\u0435\u0432\u043D\u0438\u0439 \u0447\u0430\u0441
      \u0442\u043E\u043C\u0443 \u0441\u043F\u0456\u0439\u043C\u0430\u043B\u0438 \u041E\u0431\u0440\u0430\u043D\u0443-24
      \u0456 \u0432\u0438\u0440\u0443\u0448\u0438\u043B\u0438 \u043D\u0430 \u043F\u043E\u0448\u0443\u043A\u0438
      \u043D\u0430\u0448\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630072
    m_Localized: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439 \u0445\u0432\u0438\u043B\u0438\u043D\u043A\u0443.
      \u042F\u043A\u0449\u043E \u0434\u043B\u044F \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456 \u0454 \u0437\u0430\u0433\u0440\u043E\u0437\u0430, \u043D\u0430\u043C
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0432\u0436\u0438\u0442\u0438
      \u0434\u0443\u0436\u0435 \u0436\u043E\u0440\u0441\u0442\u043A\u0438\u0445 \u0437\u0430\u0445\u043E\u0434\u0456\u0432
      \u0431\u0435\u0437\u043F\u0435\u043A\u0438. \u0422\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430
      \u0443 \u0441\u0432\u043E\u0457\u0445 \u0441\u043B\u043E\u0432\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630073
    m_Localized: "\u0422\u0430\u043A, \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E.
      \u042F \u0447\u0438\u0442\u0430\u043B\u0430 \u0457\u0445\u043D\u0456 \u043D\u0430\u043A\u0430\u0437\u0438.
      \u041E\u0434\u043D\u0430\u043A \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u043E\u044E
      \u043F\u0430\u0440\u0430\u043D\u043E\u044E \u0446\u0456 \u0442\u0438\u043F\u0438
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043B\u0438 \u0437\u043D\u0430\u043D\u043D\u044F
      \u043F\u0440\u043E \u043D\u0430\u0448 \u0421\u0442\u0456\u0439\u043B\u043E
      \u044F\u043A \u0437\u0456\u043D\u0438\u0446\u044E \u043E\u043A\u0430, \u0456
      \u0432 \u043A\u0443\u0440\u0441\u0456 \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u0456
      \u0431\u0443\u043B\u043E \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u0435
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F. \u042F
      \u0443\u0441\u0443\u043D\u0443\u043B\u0430 \u0457\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630074
    m_Localized: "\u0423\u0441\u0443\u043D\u0443\u043B\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F?
      \u0426\u0435... \u0432\u0440\u0430\u0436\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630075
    m_Localized: "\u041F\u0440\u043E\u0442\u0435, @lp, \u0437\u0430 \u0432\u0441\u0456\u0454\u0457
      \u043F\u043E\u0432\u0430\u0433\u0438 \u044F \u043D\u0435 \u043C\u043E\u0436\u0443
      \u0434\u043E\u0432\u0456\u0440\u0438\u0442\u0438\u0441\u044F \u0442\u0432\u043E\u0457\u043C
      \u0441\u043B\u043E\u0432\u0430\u043C. \u0417 \u0446\u044C\u043E\u0433\u043E
      \u0436 \u0434\u043D\u044F \u044F \u0437\u043C\u0443\u0448\u0435\u043D\u0438\u0439
      \u0432\u0432\u0435\u0441\u0442\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456
      \u0437\u0430\u043F\u043E\u0431\u0456\u0436\u043D\u0456 \u0437\u0430\u0445\u043E\u0434\u0438.
      \u0414\u043B\u044F \u043D\u0430\u0441 \u0456\u0437 \u0442\u043E\u0431\u043E\u044E
      \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E \u043F\u043E\u0434\u0456\u0431\u043D\u0456
      \u0441\u0435\u0430\u043D\u0441\u0438 \u0437\u0432'\u044F\u0437\u043A\u0443
      \u0432\u0456\u0434\u0442\u0435\u043F\u0435\u0440 - \u043D\u0435\u0434\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u0430
      \u0440\u043E\u0437\u043A\u0456\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630076
    m_Localized: "\u041E\u0442\u0436\u0435, \u0442\u043E\u0431\u0456 \u0454 \u0449\u043E
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0442\u0438 \u0437 \u043F\u0440\u0438\u0432\u043E\u0434\u0443
      \u0442\u0432\u043E\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630077
    m_Localized: "\u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440 \u0443 \u043C\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630078
    m_Localized: "\u0427\u0443\u0434\u043E\u0432\u043E. \u0422\u0438 \u043C\u043E\u043B\u043E\u0434\u0435\u0446\u044C,
      @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630079
    m_Localized: "\u041E\u0442\u0436\u0435, \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F
      \u0442\u0430\u043A\u0430: \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440
      - \u043B\u0438\u0448\u0435 \u043E\u0434\u0438\u043D \u0456\u0437 \u043A\u0456\u043B\u044C\u043A\u043E\u0445
      \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432, \u044F\u043A\u0456
      \u043D\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456.
      \u0414\u0432\u0430, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F:
      \u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u0456 \u0427\u043E\u0440\u043D\u0430 \u041A\u043D\u0438\u0433\u0430. \u0426\u0435
      - \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438 \u0434\u0430\u0432\u043D\u0438\u043D\u0438,
      \u044F\u043A\u0456 \u0432\u0438\u0432\u0447\u0430\u043B\u0438\u0441\u044F \u043F\u043E\u043D\u0456
      \u0434\u043E \u0432\u0456\u0439\u043D\u0438 \u0456 \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0434\u043B\u044F \u0437\u0430\u0434\u0456\u044F\u043D\u043D\u044F \u0432
      \u043F\u0440\u043E\u0454\u043A\u0442\u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\".
      \u041E\u0431\u0438\u0434\u0432\u0430 \u0431\u0443\u043B\u0438 \u0434\u0430\u043B\u0435\u043A\u043E
      \u0432\u0456\u0434 \u043D\u0430\u0441 \u0443 \u0434\u0435\u043D\u044C, \u043A\u043E\u043B\u0438
      \u043D\u0430 \u0441\u0432\u0456\u0442 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0438\u0441\u044F
      \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u044F\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630080
    m_Localized: "\u0417\u0433\u0456\u0434\u043D\u043E \u0437 \u043D\u0430\u0448\u0438\u043C\u0438
      \u0430\u0440\u0445\u0456\u0432\u0430\u043C\u0438, \u0410\u043C\u0443\u043B\u0435\u0442
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430 \u0432\u0438\u0432\u0447\u0430\u043B\u0438
      \u0432 \u041D\u0414\u0406 \u041C\u0422\u041D \u0443 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0456,
      \u0432 \u0442\u043E\u0439 \u0447\u0430\u0441 \u044F\u043A \u0427\u043E\u0440\u043D\u0430
      \u041A\u043D\u0438\u0433\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043B\u0430\u0441\u044F
      \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456. \u0412\u043E\u043D\u0438
      - \u0442\u0432\u043E\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0430
      \u0446\u0456\u043B\u044C. \u0429\u043E\u0434\u043E \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440\u0430
      - \u0442\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u0439\u043E\u0433\u043E \u043D\u0430\u043C.
      \u042F \u043F\u0435\u0440\u0435\u0448\u043B\u044E \u0442\u043E\u0431\u0456
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0438 \u0442\u043E\u0447\u043A\u0438
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456 \u0456 \u0447\u0430\u0441,
      \u043D\u0430 \u043C\u0456\u0441\u0446\u0456 \u043D\u0430 \u0442\u0435\u0431\u0435
      \u0447\u0435\u043A\u0430\u0442\u0438\u043C\u0435 \u043D\u0430\u0434\u0456\u0439\u043D\u0438\u0439...
      \u043F\u043E\u043D\u0456. \u0412\u0456\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438\u043C\u0435
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0447\u0435\u0440\u0435\u0437 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0430.
      \u041D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F, \u043D\u0430
      \u043C\u0456\u0441\u0446\u0456 \u0442\u0438 \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0449\u043E \u043F\u0435\u0440\u0435\u0434
      \u0442\u043E\u0431\u043E\u044E \u0442\u043E\u0439, \u0445\u0442\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D.
      \u0412\u0456\u043D \u0437\u0430\u0431\u0435\u0440\u0435 \u0432 \u0442\u0435\u0431\u0435
      \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440, \u0430 \u043F\u043E\u0442\u0456\u043C
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u044C \u0442\u0435,
      \u0449\u043E \u0442\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F.
      \u041C\u0438 \u0432\u0441\u0435 \u0449\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438 \u0442\u043E\u0433\u043E,
      \u0449\u043E\u0431 \u043D\u0430\u0448\u0456 \u0441\u0435\u043A\u0440\u0435\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0431\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438
      \u0432\u043E\u0440\u043E\u0433\u043E\u0432\u0456, \u0430\u043B\u0435, \u0433\u0430\u0434\u0430\u044E,
      \u0442\u0438 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B\u0430 \u043F\u0440\u0430\u0432\u043E
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u0440\u043E \u0441\u0432\u043E\u0454 \u043C\u0438\u043D\u0443\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630081
    m_Localized: "\u041D\u0456! \u042F \u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044F
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456
      \u043F\u0440\u044F\u043C\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630082
    m_Localized: "*\u0417'\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E*"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630083
    m_Localized: "... \u0437\u0430\u0440\u0430\u0437. \u0429\u043E\u0431 \u0442\u0435\u0431\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630084
    m_Localized: "\u041D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u0430
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447 \u0437\u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u043C\u0438
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630085
    m_Localized: "\u0413\u0435\u0439, \u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630086
    m_Localized: "\u0417\u0430\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F. \u042F
      \u043D\u0435 \u0431\u0430\u0436\u0430\u044E \u0432\u0430\u043C \u0437\u043B\u0430,
      \u0435-\u0435-\u0435, \u0441\u0442\u0430\u043B\u0435\u0432\u0456 \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630087
    m_Localized: "\u042F \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E \u0442\u043E\u0431\u0456
      \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F, \u0456 \u0442\u0438
      \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0438.
      \u0426\u0435 \u0442\u0432\u0456\u0439 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630088
    m_Localized: "\u0429\u043E? \u0429\u043E \u0432\u0438 \u043C\u0430\u0454\u0442\u0435
      \u043D\u0430 \u0443\u0432\u0430\u0437\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630089
    m_Localized: "\u042F \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438 \u043B\u0435\u0436\u0438\u0442\u044C
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442. \u0412\u0456\u043D
      \u0442\u0432\u0456\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630090
    m_Localized: "\u0412\u0438 \u0449\u043E\u0441\u044C \u043F\u043B\u0443\u0442\u0430\u0454\u0442\u0435.
      \u042F \u043D\u0435 \u0432\u043E\u043B\u043E\u0434\u0456\u044E \u0436\u043E\u0434\u043D\u0438\u043C\u0438
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630091
    m_Localized: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439, \u0420\u043E\u0443\u0437.
      \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0443 \u043D\u0430\u0441
      \u0432\u0438\u043D\u0438\u043A\u043B\u043E \u043D\u0435\u043F\u043E\u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630092
    m_Localized: "\u0412\u0438\u0431\u0430\u0447 \u043C\u043E\u044E \u043F\u043E\u0434\u0440\u0443\u0433\u0443,
      \u043C\u0430\u043B\u044F\u0442\u043A\u043E. \u0412\u043E\u043D\u0430 \u043D\u0435
      \u0445\u043E\u0442\u0456\u043B\u0430 \u0442\u0435\u0431\u0435 \u043D\u0430\u043B\u044F\u043A\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630093
    m_Localized: "\u0429\u043E \u0442\u0438 \u043D\u0435\u0441\u0435\u0448, \u0414\u0430\u0439\u043C\u043E\u043D\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630094
    m_Localized: "\u0417\u0430\u043C\u043E\u0432\u043A\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630095
    m_Localized: "\u0421\u043A\u0430\u0436\u0438, \u043B\u044E\u0431\u0430, \u0437\u0432\u0456\u0434\u043A\u0438
      \u0432 \u0442\u0435\u0431\u0435 \u0446\u044F \u0448\u0442\u0443\u043A\u0430
      \u043D\u0430 \u043D\u043E\u0437\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630096
    m_Localized: "\u041F\u0440\u0438\u043F\u0438\u043D\u0438 \u0440\u043E\u0437\u043C\u043E\u0432\u043B\u044F\u0442\u0438
      \u0442\u0430\u043A \u0437\u0456 \u043C\u043D\u043E\u044E. \u0406 \u0446\u044F
      \"\u0448\u0442\u0443\u043A\u0430\" \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u043C\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630097
    m_Localized: "\u0412\u0438\u0431\u0430\u0447, \u043A\u0440\u0438\u0445\u0456\u0442\u043A\u043E,
      \u0430\u043B\u0435 \u0442\u0443\u0442 \u0442\u0438 \u043F\u043E\u043C\u0438\u043B\u044F\u0454\u0448\u0441\u044F.
      \u0420\u0456\u0447 \u0443 \u0442\u0456\u043C, \u0449\u043E \u043F\u043E\u0434\u0456\u0431\u043D\u0456
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 - \u0441\u043F\u0430\u0434\u0449\u0438\u043D\u0430
      \u0434\u0430\u0432\u043D\u0456\u0445 \u0447\u0430\u0441\u0456\u0432. \u0410
      \u043C\u0438 - \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438,
      \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043E, \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u043C
      \u044F\u043A\u043E\u0433\u043E \u0454 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0446\u0438\u0445 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439.
      \u0422\u043E\u043C\u0443 \u043C\u0438, \u043D\u0430 \u0436\u0430\u043B\u044C,
      \u043D\u0435 \u043C\u0430\u0454\u043C\u043E \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0430\u0432\u0430 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u0438
      \u0442\u0430\u043A\u0443 \u0440\u0456\u0447 \u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630098
    m_Localized: "\u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0442\u0438
      \u0436 \u0442\u0443\u0442 \u043D\u0435 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E,
      \u0432\u0456\u0440\u043D\u043E? \u041A\u043E\u043B\u0438 \u043C\u0438 \u0437\u043D\u0430\u0439\u0448\u043B\u0438
      \u0446\u044C\u043E\u0433\u043E \u0431\u043E\u0442\u0430, \u0432\u0456\u043D
      \u043D\u0435\u0440\u0443\u0445\u043E\u043C\u043E \u0432\u0438\u0441\u0456\u0432
      \u043D\u0430 \u043C\u0456\u0441\u0446\u0456, \u0445\u043E\u0432\u0430\u044E\u0447\u0438\u0441\u044C
      \u0443 \u043A\u0443\u0449\u0430\u0445. \u041D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0430
      \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0430 \u0434\u043B\u044F \u0431\u0435\u0437\u0434\u0443\u043C\u043D\u043E\u0457
      \u043C\u0430\u0448\u0438\u043D\u0438, \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?
      \u0422\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435\u0437\u0432\u0438\u0447\u043D\u043E
      \u0442\u0435, \u0449\u043E \u0446\u0435\u0439 \u0440\u043E\u0431\u043E\u0442
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0432 \u0432\u0442\u0435\u043A\u0442\u0438
      \u0432\u0456\u0434 \u043D\u0430\u0441, \u0442\u0456\u043B\u044C\u043A\u0438-\u043D\u043E
      \u043F\u043E\u0431\u0430\u0447\u0438\u0432\u0448\u0438. \u0426\u0438\u043C
      \u0431\u043E\u0442\u043E\u043C \u0445\u0442\u043E\u0441\u044C \u043A\u0435\u0440\u0443\u0432\u0430\u0432,
      \u0456 \u0432\u0456\u043D \u0437\u0431\u0438\u0440\u0430\u0432\u0441\u044F
      \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F \u0442\u0443\u0442
      \u0456\u0437 \u043F\u0435\u0432\u043D\u0438\u043C \u043F\u043E\u043D\u0456,
      \u044F\u043A\u0438\u0439 \u043D\u0435 \u043F\u043E\u043B\u0456\u043D\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0440\u0438\u0439\u0442\u0438 \u0432 \u0442\u0430\u043A\u0443 \u0434\u0438\u043A\u0443,
      \u0441\u0445\u043E\u0432\u0430\u043D\u0443 \u0432\u0456\u0434 \u0447\u0443\u0436\u0438\u0445
      \u043E\u0447\u0435\u0439 \u0433\u043B\u0443\u0445\u043E\u043C\u0430\u043D\u044C
      \u0443 \u0447\u0456\u0442\u043A\u043E \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439
      \u0447\u0430\u0441. \u0422\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448,
      \u043F\u0440\u043E \u0449\u043E \u044F, \u0434\u0456\u0432\u0447\u0438\u043D\u043A\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630099
    m_Localized: "\u042F\u043A\u0449\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u043E
      - \u0442\u0438 \u0439\u0434\u0435\u0448 \u0456\u0437 \u043D\u0430\u043C\u0438.
      \u0417\u0430\u0440\u0430\u0437 \u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630100
    m_Localized: "\u041D\u0430\u0432\u0456\u0449\u043E \u0442\u0430\u043A \u0433\u0440\u0443\u0431\u043E?
      \u041B\u044E\u0431\u0430, \u0432\u0438\u0431\u0430\u0447 \u0449\u0435 \u0440\u0430\u0437
      \u0433\u0440\u0443\u0431\u0438\u044F\u043D\u043A\u0443 \u0420\u043E\u0443\u0437.
      \u041C\u0438 \u043D\u0435 \u0432\u043E\u0440\u043E\u0433\u0438 \u0442\u043E\u0431\u0456.
      \u0410\u043B\u0435 \u043C\u0438 \u043C\u0430\u0454\u043C\u043E \u0432\u0456\u0434\u0432\u0435\u0441\u0442\u0438
      \u0442\u0435\u0431\u0435 \u0434\u043E \u043D\u0430\u0441 \u0434\u043E\u0434\u043E\u043C\u0443,
      \u0434\u0435 \u0442\u0438 \u0434\u0430\u0441\u0438 \u043D\u0430\u043C \u0441\u0432\u0456\u0439
      \u041F\u0456\u043F\u0411\u0430\u043A \u0456 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0438,
      \u0437\u0432\u0456\u0434\u043A\u0438 \u0432\u0456\u043D \u0443 \u0442\u0435\u0431\u0435
      \u0432\u0437\u044F\u0432\u0441\u044F \u0456 \u0445\u0442\u043E \u043A\u0435\u0440\u0443\u0432\u0430\u0432
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u043E\u043C. \u0422\u0438
      \u0437\u0440\u043E\u0431\u0438\u0448 \u0446\u0438\u043C \u0432\u0435\u043B\u0438\u043A\u0443
      \u043F\u043E\u0441\u043B\u0443\u0433\u0443 \u0432\u0441\u0456\u043C \u043F\u043E\u043D\u0456,
      \u0437\u0430\u043F\u0435\u0432\u043D\u044F\u044E \u0442\u0435\u0431\u0435!
      \u0410 \u0437\u0430 \u0446\u0435 \u043C\u0438 \u0442\u0435\u0431\u0435 \u0441\u0438\u0442\u043D\u043E
      \u043D\u0430\u0433\u043E\u0434\u0443\u0454\u043C\u043E \u0456 \u0434\u0430\u043C\u043E
      \u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432 \u0443 \u0434\u043E\u0440\u043E\u0433\u0443.
      \u0414\u043E\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630101
    m_Localized: "\u041C\u0430\u0431\u0443\u0442\u044C, \u0446\u0435 \u043D\u0430\u0439\u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456\u0448\u0430
      \u0441\u043F\u0440\u043E\u0431\u0430 \u043C\u0435\u043D\u0435 \u043F\u043E\u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438
      \u0437 \u0443\u0441\u0456\u0445, \u0449\u043E \u044F \u043C\u043E\u0436\u0443
      \u043F\u0440\u0438\u0433\u0430\u0434\u0430\u0442\u0438. \u041D\u0456, \u044F
      \u043D\u0456\u043A\u0443\u0434\u0438 \u043D\u0435 \u043F\u0456\u0434\u0443
      \u0437 \u0432\u0430\u043C\u0438 \u0456 \u0442\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0432\u0456\u0434\u0434\u0430\u043C \u0432\u0430\u043C \u0441\u0432\u0456\u0439
      \u041F\u0456\u043F\u0411\u0430\u043A. \u0412\u0438 \u043C\u0435\u043D\u0435
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630102
    m_Localized: "\u0422\u0430\u043A, \u0431\u0440\u043E\u0434\u044F\u0447\u0430.
      \u041C\u0438 \u0442\u0435\u0431\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630103
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430, \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0430
      \u0443 \u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630104
    m_Localized: "\u041F\u0435\u043A, \u0446\u0435 \u0421\u0442\u0456\u043D\u043A\u0435\u0440.
      \u041A\u043E\u0440\u043E\u0442\u0448\u0435, \u0442\u0443\u0442 \u0442\u0430\u043A\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F. \u041C\u043E\u0454 \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u043F\u0435\u0440\u0435\u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u043B\u0438
      \u043D\u0430 \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043D\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0445
      \u0437\u0430\u0433\u043E\u043D\u0456\u0432 \u043B\u043E\u0432\u0446\u0456\u0432,
      \u0430 \u043D\u0430\u0433\u043B\u044F\u0434 \u0437\u0430 \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u0454\u044E
      \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B\u0438 \u043D\u0430 \u0442\u0432\u043E\u0457\u0445.
      \u041D\u0435\u043C\u0430\u0454 \u0447\u0430\u0441\u0443 \u0448\u0443\u043A\u0430\u0442\u0438
      \u0442\u0435\u0431\u0435 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E,
      \u0442\u043E\u043C\u0443 \u0437\u0430\u043B\u0438\u0448\u0443 \u0442\u043E\u0431\u0456
      \u0446\u044E \u0437\u0430\u043F\u0438\u0441\u043A\u0443. \u0412\u0432\u0430\u0436\u0430\u0454\u0448,
      \u0449\u043E \u044F \u043D\u0430\u0439\u043E\u0431\u0443\u044E - \u043C\u043E\u0436\u0435\u0448
      \u043A\u0438\u043D\u0443\u0442\u0438 \u0432\u0441\u0435 \u0456 \u043F\u0440\u0438\u043B\u0435\u0442\u0456\u0442\u0438
      \u0434\u043E \u0448\u0442\u0430\u0431\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0438
      \u0457\u0457 \u0422\u0432\u0456\u043A\u0443, \u044F \u0437 \u0440\u0430\u0434\u0456\u0441\u0442\u044E
      \u043F\u043E\u0445\u0456\u0445\u0456\u0445\u0456\u043A\u0430\u044E \u043D\u0430\u0434
      \u0442\u0438\u043C, \u044F\u043A \u0432\u0456\u043D \u043D\u0430\u0434\u0435\u0440\u0435
      \u0442\u043E\u0431\u0456 \u0434\u0443\u043F\u0443 \u0437\u0430 \"\u043D\u0435\u043F\u0456\u0434\u043A\u043E\u0440\u0435\u043D\u043D\u044F\".
      \u042F \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E, \u043A\u043E\u0440\u0435\u0448,
      \u0437\u0430\u0440\u0430\u0437 \u0443\u0441\u0435 \u0431\u0435\u0437 \u043E\u0431\u043C\u0430\u043D\u0443.
      \u0422\u0435\u0431\u0435 \u043D\u0435 \u0431\u0443\u043B\u043E \u043D\u0430
      \u0456\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0456\u0432
      \u0437\u0430\u0433\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F, \u0442\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0434\u0430\u043C \u0443 \u0434\u0432\u043E\u0445
      \u0441\u043B\u043E\u0432\u0430\u0445 \u0441\u0443\u0442\u044C. \u041C\u0438
      \u043D\u0456\u043A\u043E\u0433\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043D\u0435 \u0447\u0435\u043A\u0430\u0454\u043C\u043E, \u0430\u043B\u0435
      \u043F\u0440\u043E \u0432\u0441\u044F\u043A \u0432\u0438\u043F\u0430\u0434\u043E\u043A
      \u0442\u0440\u0435\u0431\u0430 \u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430
      \u0421\u0442\u0430\u043B\u0435\u0436\u043E\u043F\u0438\u043C\u0438. \u0426\u0456
      \u0431\u0430\u0433\u043D\u043E\u043C\u0435\u0441\u0438 \u043D\u0430\u0432\u043E\u0441\u0442\u0440\u0438\u043B\u0438\u0441\u044F
      \u0437\u0430\u0441\u0438\u043B\u0430\u0442\u0438 \u043D\u0430 \u043C\u0456\u0441\u0446\u0435
      \u043D\u0430\u0448\u0438\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439
      \u043B\u0430\u0437\u0443\u0442\u0447\u0438\u043A\u0456\u0432. \u041C\u0435\u043D\u0456
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u043D\u0430 \u043D\u0438\u0445
      \u0441\u0440\u0430\u0442\u0438 \u0437 \u0434\u0430\u0445\u0443 \u0445\u043C\u0430\u0440\u043E\u0447\u043E\u0441\u0430,
      \u0430\u043B\u0435 \u043F\u043E\u0434\u0456\u0431\u043D\u0435 \u043F\u0456\u0434\u0433\u043B\u044F\u0434\u0430\u043D\u043D\u044F
      \u043D\u0435\u0440\u0432\u0443\u0454 \u043D\u0430\u0439\u043C\u0430\u0447\u0456\u0432.
      \u0422\u043E\u043C\u0443 \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u043E \u0431\u0435\u0437
      \u0440\u043E\u0437\u0433\u043B\u044F\u0434\u0456\u0432 \u0432\u0456\u0434\u0441\u0442\u0440\u0456\u043B\u044E\u0432\u0430\u0442\u0438
      \u043A\u043E\u0436\u043D\u0443 \u0441\u0443\u043A\u0443. \u0412\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438
      \u0442\u0430\u043A\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E: \u0446\u0456
      \u0448\u0435\u0441\u0442\u0435\u0440\u0456\u043D\u043A\u043E\u0439\u043E\u0431\u0438
      \u043D\u0456\u043A\u043E\u043B\u0438, \u0437\u0430 \u0436\u043E\u0434\u043D\u0438\u0445
      \u043E\u0431\u0441\u0442\u0430\u0432\u0438\u043D \u043D\u0435 \u0432 \u0441\u0438\u043B\u0430\u0445
      \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F \u0432\u0456\u0434
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u041F\u0456\u043F\u0411\u0430\u043A\u043E\u043C.
      \u0426\u0435 \u0441\u0443\u043F\u0435\u0440\u0435\u0447\u0438\u0442\u044C \u0457\u0445\u043D\u0456\u043C
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u043C \u0430\u0431\u043E \u0449\u043E\u0441\u044C
      \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442 \u0442\u043E\u0433\u043E.
      \u0422\u043E\u0436 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043A\u0430\u0436\u0438
      \u0441\u0432\u043E\u0457\u043C \u0445\u043B\u043E\u043F\u0446\u044F\u043C \u0434\u0456\u0440\u044F\u0432\u0438\u0442\u0438
      \u0432\u0441\u0456\u0445, \u0443 \u043A\u043E\u0433\u043E \u0431\u0443\u0434\u0435
      \u043D\u0430 \u043D\u043E\u0437\u0456 \u0442\u0430\u043A\u0430 \u0445\u0435\u0440\u043E\u0432\u0438\u043D\u0430.
      \u0406 \u043D\u0435 \u043F\u0440\u0438\u0448\u0438\u0439\u0442\u0435 \u0442\u0430\u043C
      \u043D\u0456\u043A\u043E\u0433\u043E \u043B\u0456\u0432\u043E\u0433\u043E,
      \u043C\u0456\u0441\u0446\u0435\u0432\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u043D\u0430\u0439\u043C\u0430\u0447\u0435\u0432\u0456 \u0436\u0438\u0432\u0438\u043C\u0438.
      \u0427\u0430\u0441 \u0432\u0456\u0434 \u0447\u0430\u0441\u0443 \u0434\u043E
      \u0432\u0430\u0441 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u043C\u0443\u0442\u044C
      \u043A\u043E\u043D\u0432\u043E\u0439, \u0449\u043E\u0431 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438
      \u0442\u0438\u0445 \u043F\u043E\u043D\u0456, \u044F\u043A\u0438\u0445 \u0432\u0438
      \u0432\u0456\u0434\u043B\u043E\u0432\u0438\u0442\u0435 \u043D\u0430 \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0456,
      \u0442\u043E\u0436 \u0440\u043E\u0437\u0434\u0456\u043B\u044F\u0442\u0438 \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0442\u043E\u0431\u0456 \u043D\u0435 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F.
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0443 \u0442\u0432\u043E\u0457\u0445
      \u0445\u043B\u043E\u043F\u0446\u0456\u0432 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0433\u043E\u0441\u0442\u0440\u0435 \u043E\u043A\u043E, \u0449\u043E\u0431
      \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u043B\u0443\u0442\u0430\u0442\u0438
      \u041F\u0456\u043F\u0411\u0430\u043A \u0456\u0437 \u043F\u043E\u0432'\u044F\u0437\u043A\u043E\u044E?
      \u0425\u0430-\u0445\u0430.|\u041F\u0435\u043A, \u0446\u0435 \u0421\u0442\u0456\u043D\u043A\u0435\u0440.
      \u041A\u043E\u0440\u043E\u0442\u0448\u0435, \u0442\u0443\u0442 \u0442\u0430\u043A\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F. \u041C\u043E\u0454 \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u043F\u0435\u0440\u0435\u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u043B\u0438
      \u043D\u0430 \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043D\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0445
      \u0437\u0430\u0433\u043E\u043D\u0456\u0432 \u043B\u043E\u0432\u0446\u0456\u0432,
      \u0430 \u043D\u0430\u0433\u043B\u044F\u0434 \u0437\u0430 \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u0454\u044E
      \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B\u0438 \u043D\u0430 \u0442\u0432\u043E\u0457\u0445.
      \u041D\u0435\u043C\u0430\u0454 \u0447\u0430\u0441\u0443 \u0448\u0443\u043A\u0430\u0442\u0438
      \u0442\u0435\u0431\u0435 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E,
      \u0442\u043E\u043C\u0443 \u0437\u0430\u043B\u0438\u0448\u0443 \u0442\u043E\u0431\u0456
      \u0446\u044E \u0437\u0430\u043F\u0438\u0441\u043A\u0443. \u0412\u0432\u0430\u0436\u0430\u0454\u0448,
      \u0449\u043E \u044F \u0431\u0440\u0435\u0448\u0443 - \u043C\u043E\u0436\u0435\u0448
      \u043A\u0438\u043D\u0443\u0442\u0438 \u0432\u0441\u0435 \u0456 \u043F\u0440\u0438\u043B\u0435\u0442\u0456\u0442\u0438
      \u0434\u043E \u0448\u0442\u0430\u0431\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0438
      \u0457\u0457 \u0422\u0432\u0456\u043A\u0443, \u044F \u0437 \u0440\u0430\u0434\u0456\u0441\u0442\u044E
      \u043F\u043E\u0445\u0456\u0445\u0456\u0445\u0456\u043A\u0430\u044E \u043D\u0430\u0434
      \u0442\u0438\u043C, \u044F\u043A \u0432\u0456\u043D \u043D\u0430\u0434\u0435\u0440\u0435
      \u0442\u043E\u0431\u0456 \u0434\u0443\u043F\u0443 \u0437\u0430 \"\u043D\u0435\u043F\u043E\u043A\u043E\u0440\u0443\".
      \u042F \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E, \u043A\u043E\u0440\u0435\u0448,
      \u0437\u0430\u0440\u0430\u0437 \u0443\u0441\u0435 \u0431\u0435\u0437 \u043E\u0431\u043C\u0430\u043D\u0443.
      \u0422\u0435\u0431\u0435 \u043D\u0435 \u0431\u0443\u043B\u043E \u043D\u0430
      \u0456\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0456\u0432
      \u0437\u0430\u0433\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F, \u0442\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0434\u0430\u043C \u0443 \u0434\u0432\u043E\u0445
      \u0441\u043B\u043E\u0432\u0430\u0445 \u0441\u0443\u0442\u044C. \u041C\u0438
      \u043D\u0456\u043A\u043E\u0433\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043D\u0435 \u0447\u0435\u043A\u0430\u0454\u043C\u043E, \u0430\u043B\u0435
      \u043F\u0440\u043E \u0432\u0441\u044F\u043A \u0432\u0438\u043F\u0430\u0434\u043E\u043A
      \u0442\u0440\u0435\u0431\u0430 \u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430
      \u0421\u0442\u0430\u043B\u0435\u0436\u043E\u043F\u0438\u043C\u0438. \u0426\u0456
      \u0431\u0430\u0433\u043D\u043E\u043C\u0435\u0441\u0438 \u043D\u0430\u0432\u043E\u0441\u0442\u0440\u0438\u043B\u0438\u0441\u044F
      \u0437\u0430\u0441\u0438\u043B\u0430\u0442\u0438 \u043D\u0430 \u043C\u0456\u0441\u0446\u0435
      \u043D\u0430\u0448\u0438\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439
      \u043B\u0430\u0437\u0443\u0442\u0447\u0438\u043A\u0456\u0432. \u041C\u0435\u043D\u0456
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u043D\u0430 \u043D\u0438\u0445
      \u043F\u043B\u044E\u0432\u0430\u0442\u0438 \u0437 \u0434\u0430\u0445\u0443
      \u0445\u043C\u0430\u0440\u043E\u0447\u043E\u0441\u0430, \u0430\u043B\u0435
      \u043F\u043E\u0434\u0456\u0431\u043D\u0435 \u043F\u0456\u0434\u0433\u043B\u044F\u0434\u0430\u043D\u043D\u044F
      \u043D\u0435\u0440\u0432\u0443\u0454 \u043D\u0430\u0439\u043C\u0430\u0447\u0456\u0432.
      \u0422\u043E\u043C\u0443 \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u043E \u0431\u0435\u0437
      \u0440\u043E\u0437\u0433\u043B\u044F\u0434\u0456\u0432 \u0432\u0456\u0434\u0441\u0442\u0440\u0456\u043B\u044E\u0432\u0430\u0442\u0438
      \u043A\u043E\u0436\u043D\u0443 \u043F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u0443
      \u043E\u0441\u043E\u0431\u0443. \u0412\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438
      \u0442\u0430\u043A\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E: \u0432\u043E\u043D\u0438
      \u043D\u0456\u043A\u043E\u043B\u0438, \u0437\u0430 \u0436\u043E\u0434\u043D\u0438\u0445
      \u043E\u0431\u0441\u0442\u0430\u0432\u0438\u043D \u043D\u0435 \u0432 \u0441\u0438\u043B\u0430\u0445
      \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F \u0432\u0456\u0434
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u041F\u0456\u043F\u0411\u0430\u043A\u043E\u043C.
      \u0426\u0435 \u0441\u0443\u043F\u0435\u0440\u0435\u0447\u0438\u0442\u044C \u0457\u0445\u043D\u0456\u043C
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u043C \u0430\u0431\u043E \u0449\u043E\u0441\u044C
      \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442 \u0442\u043E\u0433\u043E.
      \u0422\u043E\u0436 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043A\u0430\u0436\u0438
      \u0441\u0432\u043E\u0457\u043C \u0445\u043B\u043E\u043F\u0446\u044F\u043C \u0434\u0456\u0440\u044F\u0432\u0438\u0442\u0438
      \u0432\u0441\u0456\u0445, \u0443 \u043A\u043E\u0433\u043E \u0431\u0443\u0434\u0435
      \u043D\u0430 \u043D\u043E\u0437\u0456 \u0442\u0430\u043A\u0430 \u0437\u0430\u043B\u0456\u0437\u044F\u043A\u0430.
      \u0406 \u043D\u0435 \u043F\u0440\u0438\u0448\u0438\u0439\u0442\u0435 \u0442\u0430\u043C
      \u043D\u0456\u043A\u043E\u0433\u043E \u043B\u0456\u0432\u043E\u0433\u043E,
      \u043C\u0456\u0441\u0446\u0435\u0432\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u043D\u0430\u0439\u043C\u0430\u0447\u0435\u0432\u0456 \u0436\u0438\u0432\u0438\u043C\u0438.
      \u0427\u0430\u0441 \u0432\u0456\u0434 \u0447\u0430\u0441\u0443 \u0434\u043E
      \u0432\u0430\u0441 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u043C\u0443\u0442\u044C
      \u043A\u043E\u043D\u0432\u043E\u0439, \u0449\u043E\u0431 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438
      \u0442\u0438\u0445 \u043F\u043E\u043D\u0456, \u044F\u043A\u0438\u0445 \u0432\u0438
      \u0432\u0456\u0434\u043B\u043E\u0432\u0438\u0442\u0435 \u043D\u0430 \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0456,
      \u0442\u043E\u0436 \u0440\u043E\u0437\u0434\u0456\u043B\u044F\u0442\u0438 \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0442\u043E\u0431\u0456 \u043D\u0435 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F.
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0443 \u0442\u0432\u043E\u0457\u0445
      \u0445\u043B\u043E\u043F\u0446\u0456\u0432 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0433\u043E\u0441\u0442\u0440\u0435 \u043E\u043A\u043E, \u0449\u043E\u0431
      \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u043B\u0443\u0442\u0430\u0442\u0438
      \u041F\u0456\u043F\u0411\u0430\u043A \u0456\u0437 \u043F\u043E\u0432'\u044F\u0437\u043A\u043E\u044E?
      \u0425\u0430-\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630105
    m_Localized: "\u041E\u0433\u043B\u044F\u0434 \u0440\u0443\u0457\u043D \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630106
    m_Localized: "\u041E\u0441\u044C, \u0433\u0430\u0440\u043D\u0435 \u043C\u0456\u0441\u0446\u0435,
      \u0449\u043E\u0431 \u043E\u0437\u0438\u0440\u043D\u0443\u0442\u0438\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630107
    m_Localized: "\u0412\u0438 \u0434\u0456\u0441\u0442\u0430\u0454\u0442\u0435 \u0431\u0456\u043D\u043E\u043A\u043B\u044C
      \u0456 \u043E\u0433\u043B\u044F\u0434\u0430\u0454\u0442\u0435 \u0432\u0441\u0435
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630108
    m_Localized: "\u0421\u043A\u0440\u0456\u0437\u044C \u0441\u0443\u0446\u0456\u043B\u044C\u043D\u0456
      \u0440\u0443\u0457\u043D\u0438... \u0442\u0430\u043A, \u0432\u0456\u0439\u043D\u0430
      \u043D\u0435 \u043F\u043E\u0449\u0430\u0434\u0438\u043B\u0430 \u0446\u0435
      \u043C\u0456\u0441\u0446\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630109
    m_Localized: "\u0421\u0442\u043E\u043F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630110
    m_Localized: "\u0412\u0438\u0441\u043E\u043A\u0438\u0439 \u0445\u043C\u0430\u0440\u043E\u0447\u043E\u0441
      \u0456\u0437 \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0422\u0430\u0454\u043C\u043D\u0438\u0445
      \u041D\u0430\u0443\u043A. \u0421\u0438\u043B\u044C\u043D\u043E \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0438\u0439,
      \u0430\u043B\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u0440\u0430\u0437
      \u0443 \u043D\u044C\u043E\u043C\u0443 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u043D\u0435 \u043C\u0435\u043D\u0448\u0435 \u0442\u0440\u0438\u0434\u0446\u044F\u0442\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445\u0456\u0432. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0446\u0435 \u0456 \u0454 \u041D\u0414\u0406 \u041C\u0422\u041D \u042F\u043A\u0449\u043E
      \u0434\u0435\u0441\u044C \u0456 \u0432\u0430\u0440\u0442\u043E \u0448\u0443\u043A\u0430\u0442\u0438
      \u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430,
      \u0442\u043E \u0432 \u0446\u0456\u0439 \u0431\u0443\u0434\u0456\u0432\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630111
    m_Localized: "\u0422\u0430\u043A, \u044F\u043A \u0442\u0443\u0434\u0438 \u043A\u0440\u0430\u0449\u0435
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F... \u0417\u043D\u0438\u0437\u0443
      \u043F\u0440\u043E\u0445\u043E\u0434\u0443 \u043D\u0435\u043C\u0430\u0454,
      \u0442\u0430\u043C \u0443\u0441\u0435 \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043E
      \u0443\u043B\u0430\u043C\u043A\u0430\u043C\u0438... \u0410\u043B\u0435 \u0437\u0430\u0442\u0435
      \u0434\u043E \u0445\u043C\u0430\u0440\u043E\u0447\u043E\u0441\u0430 \u0432\u0435\u0434\u0435
      \u0435\u0441\u0442\u0430\u043A\u0430\u0434\u0430 \u043C\u043E\u043D\u043E\u0440\u0435\u0439\u043A\u043E\u0432\u043E\u0457
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0430 \u043D\u0430 \u043D\u0435\u0457
      \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0437 \u0434\u0430\u0445\u0443 \u0441\u0443\u0441\u0456\u0434\u043D\u044C\u043E\u0457
      \u0431\u0443\u0434\u0456\u0432\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630112
    m_Localized: "\u0410\u043B\u0435 \u0449\u043E \u0446\u0435 \u0437\u0430 \u0447\u043E\u0440\u043D\u0456
      \u0446\u044F\u0442\u043A\u0438 \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u041D\u0414\u0406?
      \u041D\u0435 \u0431\u0430\u0447\u0443. \u0410 \u044F\u043A\u0449\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438
      \u043A\u0440\u0430\u0442\u043D\u0456\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630113
    m_Localized: "\u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0438! \u0422\u0440\u0430\u0445\u043D\u0443\u0442\u0438
      \u0457\u0445 \u043C\u0430\u043D\u0442\u0438\u043A\u043E\u0440\u043E\u044E!
      \u0407\u0445 \u0442\u0430\u043C \u0446\u0456\u043B\u0430 \u0437\u0433\u0440\u0430\u044F.|\u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0438!
      \u041F\u0440\u043E\u043A\u043B\u044F\u043D\u0438 \u0457\u0445 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F!
      \u0407\u0445 \u0442\u0430\u043C \u0446\u0456\u043B\u0430 \u0437\u0433\u0440\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630114
    m_Localized: "\u0410\u043B\u0435 \u0447\u043E\u043C\u0443 \u0457\u0445 \u0442\u0430\u043C
      \u0442\u0430\u043A \u0431\u0430\u0433\u0430\u0442\u043E? \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0410\u043C\u0443\u043B\u0435\u0442 \u0434\u0456\u0439\u0441\u043D\u043E \u0442\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630115
    m_Localized: "\u0426\u0456\u0454\u044E \u0435\u0441\u0442\u0430\u043A\u0430\u0434\u043E\u044E
      \u043A\u043E\u043B\u0438\u0441\u044C \u0445\u043E\u0434\u0438\u043B\u0438 \u043F\u043E\u0442\u044F\u0433\u0438...
      \u0430 \u0442\u0435\u043F\u0435\u0440 \u043F\u0456\u0434 \u043D\u0435\u044E
      \u0445\u0456\u0431\u0430 \u0449\u043E \u0445\u043E\u0432\u0430\u044E\u0442\u044C\u0441\u044F
      \u043A\u0440\u043E\u0432\u043E\u043A\u0440\u0438\u043B\u0438. \u0410\u043B\u0435
      \u043D\u0435\u044E \u044F \u0437\u043C\u043E\u0436\u0443 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u0432\u0435\u0436\u0456 \u041C\u0422\u041D."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630116
    m_Localized: "\u0406\u0434\u0456\u0442\u044C \u0435\u0441\u0442\u0430\u043A\u0430\u0434\u043E\u044E
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447, \u0449\u043E\u0431 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0443 [\u0412\u0435\u0436\u0443 \u041C\u0422\u041D]. \u0410\u0431\u043E \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044C
      \u0443 \u0434\u0432\u0435\u0440\u0456 [Exit], \u0449\u043E\u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630117
    m_Localized: "\u041E\u0433\u043B\u044F\u0434 \u0441\u043F\u0440\u0430\u0439\u0442\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630118
    m_Localized: "\u0429\u043E \u0442\u0443\u0442 \u0443 \u043D\u0430\u0441..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630119
    m_Localized: "\u041D\u0430\u0447\u0435\u0431\u0442\u043E \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630120
    m_Localized: "\u0425\u043E\u0447\u0430 \u043D\u0456. \u0423 \u043D\u044C\u043E\u043C\u0443
      \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F
      \u0437\u043D\u044F\u0442\u043E, \"\u0432\u0456\u0447\u043D\u0430\" \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0430 \u0437\u0430\u043C\u0456\u043D\u0435\u043D\u0430
      \u0431\u0456\u043B\u044C\u0448 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0438\u043C
      \u0456 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0441\u0442\u0440\u043E\u043A\u043E\u0432\u0438\u043C
      \u0430\u043D\u0430\u043B\u043E\u0433\u043E\u043C. \u0423\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456
      \u043A\u043E\u0440\u043F\u0443\u0441\u0443 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456
      \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u0438\u0445 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432\u0435\u043B\u0438\u043A\u0430
      \u043F\u043E\u0440\u043E\u0436\u043D\u0438\u043D\u0430, \u043E\u0431\u0433\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u0430
      \u0432\u0456\u0434 \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u0433\u0440\u0443\u0431\u043E
      \u043F\u0440\u0438\u0432\u0430\u0440\u0435\u043D\u0438\u043C\u0438 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u0430\u043C\u0438.
      \u0411\u0435\u0437 \u0441\u0443\u043C\u043D\u0456\u0432\u0443, \u0446\u0435
      \u0442\u043E\u0439 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442,
      \u044F\u043A\u043E\u043C\u0443 \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u043E
      \u0437\u0430\u0431\u0440\u0430\u0442\u0438 \u0432 \u043C\u0435\u043D\u0435
      \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630121
    m_Localized: "\u041E\u0442\u0436\u0435, \u0437\u0443\u0441\u0442\u0440\u0456\u0447
      \u0437\u0456\u0440\u0432\u0430\u043B\u0430\u0441\u044F. \u0421\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442
      \u0437\u043D\u0438\u0449\u0435\u043D\u0438\u0439, \u0456 \u0445\u0442\u043E
      \u0431 \u0442\u0430\u043C \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u0432\u0441\u044F
      \u0437\u0430\u0431\u0440\u0430\u0442\u0438 \u0432 \u043C\u0435\u043D\u0435
      \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440, \u0431\u0456\u043B\u044C\u0448\u0435
      \u0432 \u043D\u044C\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0457 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u043D\u0435\u043C\u0430\u0454. \u0429\u043E \u0431 \u0432\u0430\u0441 \u041D\u0430\u0439\u0442\u043C\u0435\u0440
      \u041C\u0443\u043D \u0442\u0440\u0430\u0445\u043D\u0443\u043B\u0430, \u0432\u0438\u0440\u043E\u0434\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630122
    m_Localized: "\u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0434\u0430\u0432 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u043D\u044F \u0449\u043E\u0434\u043E
      \u0449\u0435 \u0434\u0432\u043E\u0445 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432
      \u043F\u0440\u043E\u0435\u043A\u0442\u0443. \u0417\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0445...
      \u0443 \u0440\u0443\u0457\u043D\u0430\u0445 \u0434\u0432\u043E\u0445 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0445
      \u043C\u0456\u0441\u0442 \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E...
      \u0434\u0435 \u0432\u043E\u043D\u0438 \u043D\u0435 \u0444\u0430\u043A\u0442
      \u0449\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0454. \u0427\u0443\u0434\u043E\u0432\u043E,
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630123
    m_Localized: "\u041D\u0443 \u0449\u043E \u0436, \u043A\u0443\u0434\u0438\u0441\u044C
      \u043C\u0438 \u0434\u0456\u0441\u0442\u0430\u043B\u0438\u0441\u044F. \u0421\u0445\u043E\u0436\u0435,
      \u0442\u0443\u0442 \u0443 \u043C\u0435\u043D\u0435 \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u044E\u0442\u044C\u0441\u044F
      \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043E\u0437\u0438\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0456 \u043F\u043E\u0440\u043E\u0437\u043F\u0438\u0442\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630124
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
      \u0434\u043E \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u0433\u043E
      \u041F\u043E\u043D\u0456\" - \u043D\u0430\u0439\u0434\u043E\u0431\u0440\u043E\u0437\u0438\u0447\u043B\u0438\u0432\u0456\u0448\u043E\u0433\u043E
      \u0442\u0430 \u043D\u0430\u0439\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u043E\u0433\u043E
      \u043C\u0456\u0441\u0446\u044F \u043D\u0430 \u041F\u0443\u0441\u0442\u0438\u0449\u0430\u0445.
      \u0422\u0443\u0442 \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0442\u0438, \u043F\u043E\u0442\u043E\u0440\u0433\u0443\u0432\u0430\u0442\u0438,
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F
      \u0456 \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u043C\u0435\u0434\u0438\u0447\u043D\u043E\u044E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630125
    m_Localized: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0434\u043E\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435\u0441\u044C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443. \u0417\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u0456:
      \u0431\u0456\u0439\u043A\u0438, \u0441\u0442\u0440\u0456\u043B\u044F\u043D\u0438\u043D\u0430,
      \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0438, \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0435\u043D\u043D\u044F
      \u043C\u0435\u0431\u043B\u0456\u0432. \u041F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0456\u0432,
      \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0431\u0443\u0434\u0435 \u0437\u043D\u0438\u0449\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630126
    m_Localized: "\u0420\u043E\u0437\u0434\u0456\u043B \"\u0417\u0434\u043E\u0440\u043E\u0432'\u044F\"
      \u0443 \u0432\u0430\u0448\u043E\u043C\u0443 \u041F\u0456\u043F\u0411\u0430\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630127
    m_Localized: "\u0421\u043B\u0456\u0434\u043A\u0443\u0439\u0442\u0435 \u0437\u0430
      \u0441\u0432\u043E\u0457\u043C \u0437\u0434\u043E\u0440\u043E\u0432'\u044F\u043C!
      \u0423 \u0446\u044C\u043E\u043C\u0443 \u0432\u0430\u043C \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u0440\u043E\u0437\u0434\u0456\u043B \"\u0417\u0434\u043E\u0440\u043E\u0432'\u044F\"
      \u0443 \u0432\u0430\u0448\u043E\u043C\u0443 \u041F\u0456\u043F\u0411\u0430\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630128
    m_Localized: "\u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435, \u043D\u0430
      \u043E\u0434\u043D\u0438\u0445 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0445
      \u0437\u0456\u043B\u043B\u044F\u0445 \u043D\u0435 \u043F\u0440\u043E\u0436\u0438\u0432\u0435\u0448.
      \u0425\u043E\u0447\u0430 \u0432\u043E\u043D\u0438 \u0456 \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u044E\u0442\u044C
      \u0432\u0430\u0448\u0435 \u0441\u0430\u043C\u043E\u043F\u043E\u0447\u0443\u0442\u0442\u044F,
      \u0430\u043B\u0435 \u043D\u0435 \u0437\u0446\u0456\u043B\u044E\u044E\u0442\u044C
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0438\u0445 \u0442\u0440\u0430\u0432\u043C
      \u0456 \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C. \u042F\u043A\u0449\u043E
      \u0432\u0438 \u043B\u044E\u0431\u0438\u0442\u0435 \u0448\u0430\u0441\u0442\u0430\u0442\u0438
      \u0440\u0456\u0437\u043D\u0438\u043C\u0438 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C\u0438
      \u043C\u0456\u0441\u0446\u044F\u043C\u0438, \u0430\u043B\u0435 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u043D\u0435 \u0434\u0443\u0436\u0435 \u0434\u043E\u0431\u0440\u0435 \u0437\u043D\u0430\u0454\u0442\u0435\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456, \u0442\u043E
      \u0432\u0430\u043C \u0431\u0435\u0437\u043F\u0435\u0440\u0435\u0447\u043D\u043E
      \u0432\u0430\u0440\u0442\u043E \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E
      \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0442\u0438 \u043B\u0456\u043A\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630129
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630130
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0432\u0435\u0440\u0441\u0442\u0430\u0442, \u044F\u043A\u0449\u043E \u0432\u0430\u043C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0449\u043E\u0441\u044C \u0437\u0456\u0431\u0440\u0430\u0442\u0438,
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0430\u0431\u043E
      \u043F\u0435\u0440\u0435\u0440\u043E\u0431\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630131
    m_Localized: "\u0414\u043B\u044F \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u0437\u0431\u0440\u043E\u0457 \u0442\u0430 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438
      \u0432\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u0441\u0445\u0435\u043C\u0438 \u0442\u0430 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0430
      \u043D\u0430\u0432\u0438\u0447\u043A\u0430. \u0414\u043B\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0443
      \u0437\u0431\u0440\u043E\u0457 \u0442\u0430 \u0431\u0440\u043E\u043D\u0456
      \u0432\u0430\u043C \u0442\u0430\u043A\u043E\u0436 \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u0440\u0456\u0437\u043D\u0456 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438
      \u0442\u0430 \u043D\u0430\u0432\u0438\u0447\u043A\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u0443.
      \u0410\u0431\u043E \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044E.
      \u041D\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0437\u043D\u043E\u0448\u0435\u043D\u0443 \u0431\u0440\u043E\u043D\u044E \u0430\u0431\u043E
      \u043F\u043E\u043B\u0430\u043C\u0430\u043D\u0443 \u0437\u0431\u0440\u043E\u044E
      - \u0432\u043E\u043D\u0438 \u0432\u0430\u0441 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E
      \u043F\u0456\u0434\u0432\u0435\u0434\u0443\u0442\u044C \u0443 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630132
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
      \u043D\u0430 \u0442\u0440\u0435\u043D\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0439
      \u043F\u043E\u043B\u0456\u0433\u043E\u043D. \u0422\u0443\u0442 \u0432\u0438
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0442\u0440\u0435\u043D\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E,
      \u0443 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0456, \u043C\u0435\u0442\u0430\u043D\u043D\u0456
      \u0433\u0440\u0430\u043D\u0430\u0442 \u0430\u0431\u043E \u043C\u0430\u0433\u0456\u0457,
      \u043D\u0456\u043A\u043E\u043C\u0443 \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443
      \u043D\u0435 \u0437\u0430\u0432\u0430\u0436\u0430\u044E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630133
    m_Localized: "\u041F\u043E\u043A\u0438 \u0432\u0438 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454\u0442\u0435
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456, \u0432\u0430\u0448\u0430
      \u0437\u0431\u0440\u043E\u044F \u043D\u0435 \u0431\u0443\u0434\u0435 \u0437\u043D\u043E\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
      \u0430 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438 \u043D\u0435
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F.
      \u0421\u0442\u0440\u0456\u043B\u044F\u0439\u0442\u0435 \u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0445\u043E\u0447\u0435\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630134
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0431\u0438\u0442\u0438\u0441\u044F
      \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u043C \u0431\u043E\u0441\u043E\u043C
      \u0449\u0435 \u0440\u0430\u0437, \u0430\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E, \u044F\u043A \u0437\u0434\u043E\u0431\u0443\u0434\u0435\u0442\u0435
      \u0439\u043E\u0433\u043E \u043A\u043B\u044E\u0447. \u0420\u0456\u0432\u0435\u043D\u044C
      \u0431\u043E\u0441\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438\u043C\u0435
      \u0432\u0430\u0448\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630135
    m_Localized: "\u0417\u043D\u0430\u0439\u043E\u043C\u0441\u0442\u0432\u043E \u0437
      \u0414\u0430\u0439\u043A\u0456\u0440\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630136
    m_Localized: "\u0412\u0456\u0442\u0430\u044E \u0442\u0435\u0431\u0435 \u0432
      \u043C\u043E\u0454\u043C\u0443 \u0431\u0430\u0440\u0456 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439
      \u041F\u043E\u043D\u0456\". \u0414\u043E \u0440\u0435\u0447\u0456, \u0442\u0430\u043A
      \u0441\u0430\u043C\u043E \u043D\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0456 \u0432\u0441\u0435 \u043D\u0430\u0448\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F.
      \u041C\u0438 \u0442\u0443\u0442 \u0437\u0430\u0432\u0436\u0434\u0438 \u0440\u0430\u0434\u0456
      \u043C\u0438\u0440\u043D\u0438\u043C \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0456\u043C.
      \u041D\u0435 \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u0439 \u043F\u0440\u043E\u0431\u043B\u0435\u043C,
      \u0456 \u043C\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E \u0437\u0430\u0432\u0436\u0434\u0438
      \u043C\u0430\u0442\u0438\u043C\u0435\u043C\u043E \u043B\u044E\u0431\u043E\u0432
      \u0456 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F. \u041D\u0443
      \u0430 \u043C\u0435\u043D\u0435 \u0437\u0432\u0443\u0442\u044C \u0414\u0430\u0439\u043A\u0456\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630137
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u044F @lp. \u042F\u043A
      \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0442\u0438 \u0432 \u0446\u044C\u043E\u043C\u0443
      \u0442\u0430\u0431\u043E\u0440\u0456 \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630138
    m_Localized: "\u041D\u0456\u0431\u0438 \u044F\u043A. \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u0432\u0441\u0456 \u0432\u0430\u0436\u043B\u0438\u0432\u0456 \u043F\u0438\u0442\u0430\u043D\u043D\u044F
      \u0432\u0438\u0440\u0456\u0448\u0443\u044E \u044F. \u0417\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u0434\u0435
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0447\u043E\u0433\u043E\u0441\u044C
      \u0430\u0431\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u044C\u0441\u044F
      \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u0442\u0438 \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630139
    m_Localized: "\u042F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0448 \u043F\u043E\u0442\u043E\u0440\u0433\u0443\u0432\u0430\u0442\u0438
      \u0430\u0431\u043E \u0437\u0430\u0440\u043E\u0431\u0438\u0442\u0438 \u0442\u0440\u043E\u0445\u0438
      \u043A\u0440\u0438\u0448\u043E\u043A, \u043D\u0430\u0432\u0456\u0434\u0430\u0439\u0441\u044F
      \u0434\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432 \u0443
      \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u043C\u0443 \u0437\u0430\u043B\u0456.
      \u0423 \u043D\u0438\u0445 \u0437\u0430\u0432\u0436\u0434\u0438 \u0441\u043F\u0440\u0430\u0432
      \u043F\u043E \u0432\u0443\u0445\u0430, \u043C\u043E\u0436\u0435, \u0432\u043E\u043D\u0438
      \u0432\u0438\u0440\u0456\u0448\u0430\u0442\u044C \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0438
      \u0442\u043E\u0431\u0456 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443
      \u0432 \u0447\u043E\u043C\u0443-\u043D\u0435\u0431\u0443\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630140
    m_Localized: "\u041D\u0443 \u0430 \u044F\u043A\u0449\u043E \u0431\u0443\u0434\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u0456\u0434\u043B\u0430\u0442\u0430\u0442\u0438\u0441\u044F,
      \u0437\u0430\u0437\u0438\u0440\u043D\u0438 \u0432 \u043A\u043B\u0456\u043D\u0456\u043A\u0443.
      \u041D\u0430\u0448 \u0414\u043E\u043A - \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439
      \u043B\u0456\u043A\u0430\u0440, \u044F\u043A\u043E\u0433\u043E \u0442\u0438
      \u0437\u043C\u043E\u0436\u0435\u0448 \u0437\u043D\u0430\u0439\u0442\u0438 \u0432
      \u0446\u0438\u0445 \u043C\u0456\u0441\u0446\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630141
    m_Localized: "\u0414\u044F\u043A\u0443\u044E \u0437\u0430 \u0433\u043E\u0441\u0442\u0438\u043D\u043D\u0456\u0441\u0442\u044C.
      \u042F\u043A\u0449\u043E \u043C\u0435\u043D\u0456 \u0431\u0443\u0434\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F,
      \u044F \u0437\u0430\u0432\u0436\u0434\u0438 \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434
      \u0456\u0442\u0438\u043C\u0443 \u0434\u043E \u0412\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630142
    m_Localized: "(\u043F\u0440\u043E \u0441\u0435\u0431\u0435) \u0422\u0430\u043A,
      \u043D\u0443 \u0449\u043E \u0436, \u043F\u0435\u0440\u0448\u0438\u0439 \u043A\u043E\u043D\u0442\u0430\u043A\u0442
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u043C.
      \u0422\u0440\u0435\u0431\u0430 \u0431 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C, \u0449\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u0432 \u043F\u043E\u0448\u0443\u043A\u0443 \u0437\u0430\u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630143
    m_Localized: "\u0417\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0438\u0439
      \u0437\u0430\u0432\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630144
    m_Localized: "\u042F \u043F\u0440\u0438\u0439\u0448\u043B\u0430 \u0437\u0434\u0430\u043B\u0435\u043A\u0443
      \u0456 \u043D\u0435 \u0437\u043D\u0430\u044E \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445
      \u043A\u0440\u0430\u0457\u0432. \u0427\u0438 \u0454 \u0442\u0443\u0442 \u043C\u0456\u0441\u0446\u044F,
      \u044F\u043A\u0456 \u0432\u0430\u0440\u0442\u043E \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0442\u0438
      \u0430\u0431\u043E, \u043D\u0430\u0432\u043F\u0430\u043A\u0438, \u044F\u043A\u0438\u0445
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0443\u043D\u0438\u043A\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630145
    m_Localized: "\u0404\u0434\u0438\u043D\u0430 \u0442\u0443\u0442\u0435\u0448\u043D\u044F
      \u043F\u0430\u043C'\u044F\u0442\u043A\u0430 - \u0446\u0435 \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0438\u0439
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0439 \u0437\u0430\u0432\u043E\u0434.
      \u0412\u0456\u043D \u043D\u0435 \u0434\u0443\u0436\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0436\u0434\u0430\u0432
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0443\u0432\u0430\u043D\u044C,
      \u0431\u043E \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0439\u043E\u0433\u043E
      \u0431\u0443\u0434\u0456\u0432\u0435\u043B\u044C \u0431\u0443\u043B\u0438 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u043C\u0438.
      \u0422\u0430\u043C \u0437\u0431\u0435\u0440\u0435\u0433\u043B\u0438\u0441\u044F
      \u043A\u0443\u043F\u0438 \u0446\u0456\u043D\u043D\u0438\u0445 \u0440\u0435\u0447\u0435\u0439,
      \u043D\u0430\u0448\u0456 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0442\u0443\u0434\u0438
      \u043D\u0430\u0432\u0456\u0434\u0443\u044E\u0442\u044C\u0441\u044F \u0437\u0430
      \u0445\u0430\u0431\u0430\u0440\u043E\u043C. \u0417\u0430\u0432\u043E\u0434
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439,
      \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0439\u043E\u0433\u043E
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0432\u0438\u0432\u0447\u0438\u0442\u0438 \u0456 \u0437\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0440\u043E\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630146
    m_Localized: "\u0417\u0430\u0432\u043E\u0434? \u0417\u0432\u0443\u0447\u0438\u0442\u044C
      \u0446\u0456\u043A\u0430\u0432\u043E, \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E
      \u0442\u0443\u0434\u0438 \u0437\u0430\u0433\u043B\u044F\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630147
    m_Localized: "\u0422\u0430 \u043D\u0430 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F,
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E.
      \u0422\u0430\u043C \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0448\u0430\u0441\u0442\u0430\u044E\u0442\u044C
      \u0440\u0435\u0439\u0434\u0435\u0440\u0438, \u0456 \u0442\u0443\u0440\u0435\u043B\u0456
      \u043C\u0456\u0441\u0446\u044F\u043C\u0438 \u0432\u0441\u0435 \u0449\u0435
      \u0430\u043A\u0442\u0438\u0432\u043D\u0456. \u041D\u0430\u0432\u0456\u0442\u044C
      \u043C\u0456\u043D\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044E\u0442\u044C\u0441\u044F
      - \u0442\u043E\u0436 \u0434\u0438\u0432\u0438\u0441\u044C \u043F\u0456\u0434
      \u043D\u043E\u0433\u0438. \u0410\u043B\u0435 \u0442\u0438 \u043D\u0435 \u0437\u0430\u0433\u0443\u0431\u0438\u0448\u0441\u044F:
      \u0442\u0430\u043C \u0443 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u0445
      \u043C\u0456\u0436 \u0443\u0441\u0456\u043C\u0430 \u0432\u0456\u0434\u0434\u0456\u043B\u0430\u043C\u0438
      \u0432\u0438\u0441\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0438, \u0437\u0430
      \u043D\u0438\u043C\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u043C\u043E\u0436\u043D\u0430
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0432\u0438\u0445\u0456\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630148
    m_Localized: "\u041D\u0443 \u044F\u043A \u0442\u043E\u0431\u0456 \u0442\u0443\u0442?
      \u041F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630149
    m_Localized: "\u0426\u0456\u043B\u043A\u043E\u043C \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E,
      \u043D\u0430\u0440\u043E\u0434 \u043D\u0456\u0431\u0438 \u043F\u0440\u0438\u0432\u0456\u0442\u043D\u0438\u0439,
      \u0442\u0430 \u0439 \u0443\u0437\u0430\u0433\u0430\u043B\u0456... \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u043E.
      \u0410 \u0431\u0430\u0433\u0430\u0442\u043E \u043D\u0430 \u041F\u0443\u0441\u0442\u0438\u0449\u0430\u0445
      \u0442\u0430\u043A\u0438\u0445 \u043E\u0441\u044C \u043C\u0456\u0441\u0446\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630150
    m_Localized: "\u041D\u0456\u0456\u0456, \u0437\u043E\u0432\u0441\u0456\u043C
      \u043C\u0430\u043B\u043E. \u0422\u0443\u0442 \u0432 \u043E\u043A\u0440\u0443\u0437\u0456
      \u0454 \u043E\u0434\u043D\u0435 \u043B\u0438\u0448\u0435 \u0446\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F,
      \u0434\u0435 \u0442\u0435\u0431\u0435 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436 \u043D\u0435 \u0441\u043F\u0440\u043E\u0431\u0443\u044E\u0442\u044C
      \u0432\u0431\u0438\u0442\u0438, \u043F\u043E\u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438
      \u0430\u0431\u043E \u0437\u0430\u043A\u0443\u0432\u0430\u0442\u0438 \u0432
      \u043A\u0430\u0439\u0434\u0430\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630151
    m_Localized: "\u0410 \u0442\u0438 \u0442\u0435\u0436 \u0442\u0443\u0442 \u0436\u0438\u0432\u0435\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630152
    m_Localized: "\u042F? \u041D\u0454. \u0410\u043B\u0435 \u043C\u0456\u0439 \u0434\u0456\u043C
      \u0442\u0443\u0442 \u043F\u043E\u0440\u0443\u0447. \u0421\u044E\u0434\u0438
      \u044F \u043D\u0430\u0432\u0456\u0434\u0443\u044E\u0441\u044F \u0437\u0430\u0440\u0430\u0434\u0438
      \u0440\u043E\u0431\u043E\u0442\u0438 \u044F\u043A\u043E\u0457\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630153
    m_Localized: "\u0406 \u0447\u0438\u043C \u0442\u0438 \u0437\u0430\u0439\u043C\u0430\u0454\u0448\u0441\u044F,
      \u044F\u043A\u0449\u043E \u043D\u0435 \u0441\u0435\u043A\u0440\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630154
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442\u0443 \u043D\u0435\u043C\u0430
      - \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E \u044F \u0442\u0443\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0438 \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u044E.
      \u0410\u043B\u0435 \u043D\u0430 \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0456
      \u0434\u043D\u0456 \u044F \u0442\u0443\u0442 \u0437\u0430\u0441\u0442\u0440\u044F\u0433\u043D\u0443,
      \u0442\u043E\u043C\u0443 \u0437\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F,
      \u044F\u043A\u0448\u043E \u0431\u0443\u0434\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0448\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630155
    m_Localized: "\u0414\u0430\u0439\u043A\u0456\u0440\u0456 \u043F\u0440\u043E \u0424\u043E\u043B\u0441
      \u0421\u043F\u0440\u0456\u043D\u0433\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630156
    m_Localized: "\u0423 \u043C\u0435\u043D\u0435 \u0454 \u0434\u043E \u0442\u0435\u0431\u0435
      \u043E\u0434\u043D\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F,
      \u0456 \u0446\u0435 \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u043E
      \u0434\u043B\u044F \u043C\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630157
    m_Localized: "\u0417\u0430\u043F\u0438\u0442\u0443\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630158
    m_Localized: "\u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441.
      \u0422\u043E\u0431\u0456 \u0432\u0456\u0434\u043E\u043C\u0430 \u0446\u044F
      \u043D\u0430\u0437\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630159
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E. \u0426\u0435 \u043D\u0435
      \u043D\u0430\u0434\u0442\u043E \u0434\u0430\u043B\u0435\u043A\u043E \u0437\u0432\u0456\u0434\u0441\u0438,
      \u043D\u0443, \u043C\u043E\u0436\u0435, \u0434\u0435\u043D\u044C \u0448\u043B\u044F\u0445\u0443
      \u0430\u0431\u043E \u0431\u043B\u0438\u0437\u044C\u043A\u043E \u0442\u043E\u0433\u043E.
      \u0419\u0434\u0438 \u043D\u0430 \u0441\u0445\u0456\u0434 \u0441\u0442\u0430\u0440\u043E\u044E
      \u0434\u043E\u0440\u043E\u0433\u043E\u044E, \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630160
    m_Localized: "\u0422\u0456\u043B\u044C\u043A\u0438 \u043E\u0442... \u043D\u0430\u0432\u0456\u0449\u043E
      \u0442\u043E\u0431\u0456 \u0442\u0443\u0434\u0438? \u0422\u043E\u0431\u0456
      \u0432\u0456\u0434\u043E\u043C\u043E \u0445\u043E\u0447, \u0449\u043E \u0446\u0435
      \u0437\u0430 \u043C\u0456\u0441\u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630161
    m_Localized: "\u0429\u043E \u0442\u0438 \u0445\u043E\u0447\u0435\u0448 \u0441\u043A\u0430\u0437\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630162
    m_Localized: "\u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441
      - \u043B\u0456\u0433\u0432\u043E \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432.
      \u0423 \u0442\u0435\u0431\u0435 \u0449\u043E, \u044F\u043A\u0456\u0441\u044C
      \u0441\u043F\u0440\u0430\u0432\u0438 \u0437 \u043D\u0438\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630163
    m_Localized: "\u0429\u043E? \u0417 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438?
      \u041D\u0456, \u0437\u0432\u0456\u0441\u043D\u043E \u0436 \u043D\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630164
    m_Localized: "\u0422\u043E\u0434\u0456 \u0432 \u0442\u0432\u043E\u0457\u0445
      \u0436\u0435 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445 \u043D\u0435
      \u0445\u043E\u0434\u0438\u0442\u0438 \u0442\u0443\u0434\u0438. \u042F\u043A\u0449\u043E
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0448 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0432 \u043A\u043B\u0456\u0442\u043A\u0443. \u041A\u0430\u0436\u0443\u0442\u044C,
      \u0457\u0445 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0446\u0456\u043A\u0430\u0432\u043B\u044F\u0442\u044C
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630165
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2733630166
    m_Localized: "\u0413\u0435\u0439, @lp! \u041C\u043E\u0436\u043D\u0430 \u0442\u0435\u0431\u0435
      \u043D\u0430 \u043F\u0430\u0440\u0443 \u0441\u043B\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630167
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u043F\u0440\u043E
      \u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630168
    m_Localized: "\u042F \u0442\u0443\u0442 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E
      \u043F\u043E\u0447\u0443\u0432 \u0432\u0430\u0448\u0443 \u0440\u043E\u0437\u043C\u043E\u0432\u0443.
      \u0421\u043A\u0430\u0436\u0438 \u0447\u0435\u0441\u043D\u043E - \u0443 \u0442\u0435\u0431\u0435
      \u043D\u0435\u043C\u0430 \u0436\u043E\u0434\u043D\u0438\u0445 \u0441\u043F\u0440\u0430\u0432
      \u0456\u0437 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630169
    m_Localized: "\u042F\u043A\u0456 \u0449\u0435 \u0441\u043F\u0440\u0430\u0432\u0438?
      \u042F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0448 \u0437\u043D\u0430\u0442\u0438
      \u043C\u043E\u044E \u0434\u0443\u043C\u043A\u0443, \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u0456\u0432\u043B\u044F
      - \u0446\u0435 \u043E\u0433\u0438\u0434\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630170
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u042F \u0440\u0430\u0434\u0438\u0439,
      \u0448\u043E \u0442\u0438 \u0442\u0430\u043A \u0434\u0443\u043C\u0430\u0454\u0448.
      \u0410\u043B\u0435 \u043D\u0430\u0432\u0456\u0449\u043E \u0442\u043E\u0434\u0456
      \u0442\u043E\u0431\u0456 \u0442\u0443\u0434\u0438 \u0442\u0440\u0435\u0431\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630171
    m_Localized: "\u041E\u0441\u043E\u0431\u0438\u0441\u0442\u0430 \u0441\u043F\u0440\u0430\u0432\u0430.
      \u0422\u0438 \u0449\u043E\u0441\u044C \u043C\u0430\u0454\u0448 \u043F\u0440\u043E\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630172
    m_Localized: "\u0422\u0435\u0431\u0435 \u0442\u0430\u043C \u0430\u0431\u043E
      \u0432\u0431'\u044E\u0442\u044C, \u0430\u0431\u043E \u043F\u043E\u0441\u0430\u0434\u044F\u0442\u044C
      \u0443 \u043A\u043B\u0456\u0442\u043A\u0443 \u0456 \u043F\u0440\u043E\u0434\u0430\u0434\u0443\u0442\u044C
      \u0427\u0435\u0440\u0432\u043E\u043D\u043E\u043C\u0443 \u041E\u043A\u0443.
      \u042F \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0448\u043E
      \u0437\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0430 \u0442\u0435\u0431\u0435
      \u0442\u0443\u0434\u0438 \u0442\u044F\u0433\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630173
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u0422\u0438 \u043C\u0435\u043D\u0435
      \u0432\u0438\u0440\u0443\u0447\u0438\u0432, \u0442\u043E\u043C\u0443 \u044F
      \u0441\u043A\u0430\u0436\u0443 \u0442\u043E\u0431\u0456. \u0421\u0442\u0456\u0439\u043B\u043E
      88 - \u0447\u0443\u0432 \u043F\u0440\u043E \u0442\u0430\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630174
    m_Localized: "\u041E\u0441\u044C \u0432\u043E\u043D\u043E \u044F\u043A... \u0422\u0430\u043A,
      \u044F \u0447\u0443\u0432, \u0448\u043E \u0443 \u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441
      \u0454 \u0432\u0445\u0456\u0434 \u0443 \u044F\u043A\u0435\u0441\u044C \u0421\u0442\u0456\u0439\u043B\u043E.
      \u0410\u043B\u0435 \u0449\u0435 \u044F \u0447\u0443\u0432, \u0449\u043E \u043F\u043E\u043D\u0456
      \u0437\u0432\u0456\u0434\u0442\u0438 \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630175
    m_Localized: "\u0410\u043B\u0435 \u0447\u043E\u043C\u0443? \u0427\u0435\u0440\u0435\u0437
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630176
    m_Localized: "\u041D\u0456, \u0432\u043E\u043D\u0438 \u0442\u0443\u0442 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F. \u041D\u0435 \u0432 \u043D\u0438\u0445
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430\u0432\u0456\u0442\u044C.
      \u0422\u0430\u043C, \u0443 \u0421\u0442\u0456\u0439\u043B\u0456, \u043F\u043E\u0432\u043D\u043E
      \u0440\u043E\u0431\u043E\u0442\u0456\u0432. \u0421\u0442\u0456\u0439\u043B\u043E
      88 \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u0435,
      \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0454, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0440\u043E\u043A\u0456\u0432 \u0432\u043E\u043D\u043E \u0442\u0430\u043A\u0438\u043C
      \u0443\u0436\u0435. \u041C\u043E\u0436\u0435, \u0439\u043E\u0433\u043E \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u0442\u0430\u043A\u0438\u043C \u0456 \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u043B\u0438,
      \u0431\u0435\u0437 \u043F\u043E\u043D\u0456. \u041D\u0435 \u0437\u043D\u0430\u044E...
      \u0446\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0447\u0443\u0442\u043A\u0438.
      \u0422\u0430\u043A, \u0442\u0430\u043C \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438
      \u0431\u0430\u0433\u0430\u0442\u043E \u0446\u0456\u043D\u043D\u043E\u0433\u043E
      \u0434\u043E\u0431\u0440\u0430, \u0430\u043B\u0435 \u0440\u0438\u0437\u0438\u043A...
      \u043D\u0456, \u044F \u0431 \u043D\u0435 \u0441\u0443\u043D\u0443\u0432\u0441\u044F
      \u0432 \u0442\u0430\u043A\u0435 \u043C\u0456\u0441\u0446\u0435 \u0431\u0435\u0437
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0457 \u043D\u0430 \u0442\u0435
      \u043F\u043E\u0442\u0440\u0435\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630177
    m_Localized: "\u0419\u043E\u0433\u043E \u0436\u0438\u0442\u0435\u043B\u0456 \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438?
      \u0422\u0440\u0435\u0431\u0430 \u0436... \u0406 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0442\u0443\u0434\u0438
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630178
    m_Localized: "\u0410 \u0442\u0438 \u0432\u043F\u0435\u0440\u0442\u0430, \u043C\u0435\u043D\u0456
      \u0446\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F.
      \u0422\u043E\u0434\u0456, \u044F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0448
      \u0443\u0446\u0456\u043B\u0456\u0442\u0438, \u0431\u0435\u0440\u0438 \u043C\u043E\u0457
      \u0441\u043B\u043E\u0432\u0430 \u0456 \u043A\u043B\u0430\u0434\u0438 \u0441\u043E\u0431\u0456
      \u0443 \u0432\u0443\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630179
    m_Localized: "\u0422\u0430\u0431\u0456\u0440 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u0434\u043E\u0431\u0440\u0435 \u0443\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0438\u0439.
      \u041D\u0430\u0432\u043A\u043E\u043B\u043E - \u0432\u0438\u0441\u043E\u043A\u0430
      \u0441\u0442\u0456\u043D\u0430, \u0447\u0435\u0440\u0435\u0437 \u044F\u043A\u0443
      \u043D\u0435 \u043F\u0435\u0440\u0435\u043B\u0456\u0437\u0442\u0438, \u0430
      \u0449\u0435 \u0432\u0438\u0448\u043A\u0438 \u0437\u0456 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0430\u043C\u0438
      \u0442\u0430 \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u043D\u0438\u043A\u0430\u043C\u0438.
      \u041F\u043E\u043B\u0456\u0437\u0435\u0448 \u043F\u0440\u044F\u043C\u043E -
      \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0448 \u0434\u0435\u0441\u044F\u0442\u043E\u043A
      \u0437\u0430\u0439\u0432\u0438\u0445 \u0434\u0456\u0440\u043E\u043A \u0443
      \u0442\u0456\u043B\u0456. \u0410\u043B\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u043F\u0440\u043E\u043B\u0456\u0437\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043E\u043A\u0438. \u041E\u0434\u0438\u043D
      \u0440\u0430\u0431-\u0443\u0442\u0456\u043A\u0430\u0447 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0432
      \u043C\u0435\u043D\u0456, \u0449\u043E \u0432\u0442\u0456\u043A \u0446\u0438\u043C
      \u0448\u043B\u044F\u0445\u043E\u043C. \u0422\u0430\u043C \u0442\u0435\u0436
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E, \u0430\u043B\u0435
      \u0442\u0430\u043C \u0443 \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435
      \u044F\u043A\u0438\u0439\u0441\u044C \u0448\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630180
    m_Localized: "\u0425\u043C... \u0434\u044F\u043A\u0443\u044E. \u0422\u0432\u043E\u044F
      \u043F\u043E\u0440\u0430\u0434\u0430 \u043C\u043E\u0436\u0435 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u043C\u0435\u043D\u0456 \u0436\u0438\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630181
    m_Localized: "\u041D\u0443, \u0442\u043E\u0434\u0456 \u0443\u0434\u0430\u0447\u0456!
      \u042F\u043A\u0448\u043E \u0442\u0438 \u0437\u0430\u043B\u0456\u0437\u0435\u0448
      \u0443 \u0442\u0443 \u0421\u0442\u0456\u0439\u043B\u043E \u043F\u0456\u0434
      \u043D\u043E\u0441\u043E\u043C \u0443 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432...
      \u041E \u0442\u0430\u043A, \u043E\u0441\u044C \u0446\u0435 \u0431\u0443\u0434\u0435
      \u043D\u043E\u0432\u0438\u043D\u0430! \u0411\u0430\u0433\u0430\u0442\u043E
      \u0445\u0442\u043E \u0442\u0443\u0442 \u0442\u043E\u0447\u043D\u043E \u0437\u0430\u0445\u043E\u0447\u0435,
      \u0448\u043E\u0431 \u0442\u0438 \u0457\u043C \u0447\u043E\u0433\u043E\u0441\u044C
      \u043F\u0440\u0438\u0442\u044F\u0433\u043B\u0430 \u0437\u0432\u0456\u0434\u0442\u0438.
      \u0422\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E
      \u0437\u0430\u0440\u043E\u0431\u0438\u0442\u0438, \u0437\u043D\u0430\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630182
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u043F\u0440\u043E
      \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630183
    m_Localized: "\u0410 \u043E\u0441\u044C \u0456 \u0442\u0438, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630184
    m_Localized: "\u0412\u0438 \u043C\u0435\u043D\u0435 \u0447\u0435\u043A\u0430\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630185
    m_Localized: "\u0429\u0435 \u0431 \u043F\u0430\u043A. \u041D\u0435 \u0449\u043E\u0434\u043D\u044F
      \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0437 \u043F\u043E\u043D\u0456, \u0437\u0434\u0430\u0442\u043D\u043E\u044E
      \u0442\u0430\u043A \u043D\u0430\u0434\u0435\u0440\u0442\u0438 \u0437\u0430\u0434
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630186
    m_Localized: "\u041F\u0456\u0441\u043B\u044F \u0442\u0432\u043E\u0457\u0445 \u0440\u043E\u0437\u043F\u0438\u0442\u0443\u0432\u0430\u043D\u044C
      \u044F \u0442\u0443\u0440\u0431\u0443\u0432\u0430\u0432\u0441\u044F \u043F\u0440\u043E
      \u0442\u0435\u0431\u0435, @lp. \u042F \u0432\u0438\u0440\u0456\u0448\u0438\u0432
      \u0437\u043B\u0456\u0442\u0430\u0442\u0438 \u0433\u043B\u044F\u043D\u0443\u0442\u0438,
      \u0447\u0438 \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0430
      \u0442\u0438 \u0432 \u043A\u043E\u043F\u0438\u0442\u0430 \u0446\u0438\u0445
      \u0432\u0438\u0440\u043E\u0434\u043A\u0456\u0432. \u0410\u043B\u0435 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043A\u0443\u043F\u0443 \u0442\u0440\u0443\u043F\u0456\u0432
      \u0456 \u043F\u043E\u0440\u043E\u0436\u043D\u0456 \u043A\u043B\u0456\u0442\u043A\u0438.
      \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0442\u0438 \u0442\u043E\u0447\u043D\u043E
      \u0432\u043C\u0456\u0454\u0448 \u043F\u043E\u0441\u0442\u043E\u044F\u0442\u0438
      \u0437\u0430 \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630187
    m_Localized: "\u0406 \u0442\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0456\u043B\u044F\u043B\u0430 \u043A\u0443\u043F\u0443
      \u043F\u043E\u0433\u0430\u043D\u0438\u0445 \u043F\u043E\u043D\u0456, @lp. \u0426\u0435\u0439
      \u0437\u0430\u0433\u0456\u043D \u043C\u0456\u0433 \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0448\u043E\u043C\u0443 \u0442\u0430\u0431\u043E\u0440\u0443.
      \u0406 \u043C\u0456\u0439 \u0434\u043E\u0441\u0432\u0456\u0434 \u043A\u0430\u0436\u0435,
      \u0449\u043E \u044F\u043A\u0431\u0438 \u043D\u0435 \u0442\u0438 \u0456 \u0442\u0432\u043E\u044F
      \u0432\u0456\u0434\u0432\u0430\u0433\u0430, \u0432 \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E\u043C\u0443
      \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443 \u043D\u0430\u043C
      \u0431\u0438 \u043D\u0430\u043F\u0435\u0432\u043D\u043E \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F
      \u0437\u0430\u043C\u0430\u0437\u0430\u0442\u0438 \u0441\u0432\u043E\u0457 \u043A\u043E\u043F\u0438\u0442\u0430
      \u0457\u0445\u043D\u044C\u043E\u044E \u043A\u0440\u043E\u0432'\u044E. \u0410\u0431\u043E
      \u043F\u0440\u0438\u043C\u0456\u0440\u044F\u0442\u0438 \u0440\u0430\u0431\u0441\u044C\u043A\u0456
      \u043A\u043E\u043B\u043E\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630188
    m_Localized: "\u042F\u043A \u0433\u043E\u043B\u043E\u0432\u0430 \u0446\u044C\u043E\u0433\u043E
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F, \u044F \u043D\u0435
      \u043C\u043E\u0436\u0443 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438 \u0442\u0432\u0456\u0439
      \u0432\u0447\u0438\u043D\u043E\u043A \u043D\u0435\u043F\u043E\u043C\u0456\u0447\u0435\u043D\u0438\u043C.
      \u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443 \u0432 \u0437\u0430\u0445\u0438\u0441\u0442\u0456
      \u0432\u0456\u0434 \u0437\u0430\u0433\u0440\u043E\u0437\u0438 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u0442\u043E\u0431\u0456 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0430
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630189
    m_Localized: "\u0414\u044F\u043A\u0443\u044E \u0437\u0430 \u0446\u0435. \u0410\u043B\u0435,
      \u044F\u043A\u0449\u043E \u0447\u0435\u0441\u043D\u043E, \u044F \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u0446\u0435 \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u0437\u0430\u0440\u0430\u0434\u0438
      \u0441\u0432\u043E\u0454\u0457 \u043C\u0435\u0442\u0438, \u0430 \u043D\u0435
      \u0437 \u0430\u043B\u044C\u0442\u0440\u0443\u0457\u0437\u043C\u0443. \u0412\u0430\u0448\u0456
      \u043F\u043E\u0445\u0432\u0430\u043B\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0437\u0430\u0439\u0432\u0438\u043C\u0438 \u0442\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630190
    m_Localized: "\u0410, \u0442\u0430\u043A. \u042F\u043A \u0442\u0430\u043C \u0437
      \u0446\u0438\u043C \u0443 \u0442\u0435\u0431\u0435, @lp? \u042F\u043A\u0449\u043E
      \u043D\u0435 \u0441\u0435\u043A\u0440\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630191
    m_Localized: "\u0423\u0441\u0435 \u0434\u043E\u0431\u0440\u0435, \u044F \u0432\u0438\u043A\u043E\u043D\u0430\u043B\u0430
      \u0432\u0441\u0435, \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E.
      \u0410\u043B\u0435 \u0442\u0435\u043F\u0435\u0440 \u043C\u0435\u043D\u0456,
      \u0441\u0445\u043E\u0436\u0435, \u0442\u0440\u0435\u0431\u0430 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F
      \u0449\u0435 \u0434\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630192
    m_Localized: "\u0406 \u043A\u0443\u0434\u0438 \u0442\u0435\u043F\u0435\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630193
    m_Localized: "\u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630194
    m_Localized: "\u041E\u0445 \u0434\u0430\u0440\u0435\u043C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630195
    m_Localized: "\u0427\u043E\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630196
    m_Localized: "\u042F\u043A\u0449\u043E \u043D\u0435 \u0431\u0440\u0430\u0442\u0438
      \u0434\u043E \u0443\u0432\u0430\u0433\u0438 \u0442\u043E\u0433\u043E, \u0449\u043E
      \u0446\u0435 \u0434\u043E\u0441\u0438\u0442\u044C \u0434\u0430\u043B\u0435\u043A\u043E?
      \u0417\u0430\u0440\u0430\u0437 \u0442\u0430\u043C \u0427\u0435\u0440\u0432\u043E\u043D\u0435
      \u041E\u043A\u043E \u0456 \u0411\u043E\u0433\u0438\u043D\u044F \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043B\u0438
      \u0432\u0435\u043B\u0438\u043A\u0435 \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F.
      \u0411\u0456\u0434\u043D\u0438\u0445 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0437\u0430\u0433\u0430\u043D\u044F\u044E\u0442\u044C,
      \u043D\u0430\u0447\u0435 \u0437\u0432\u0456\u0440\u0456\u0432, \u0456 \u0432\u0456\u0434\u0432\u043E\u0437\u044F\u0442\u044C
      \u0434\u043E \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630197
    m_Localized: "@lp, \u044F \u0437\u043D\u0430\u044E, \u0449\u043E \u0442\u043E\u0431\u0456
      \u043D\u0435 \u0432 \u043F\u0435\u0440\u0448\u0435 \u0434\u0456\u0440\u044F\u0432\u0438\u0442\u0438
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432,
      \u0430\u043B\u0435 \u0442\u0443\u0442 \u0432\u0441\u0435 \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u0442\u0430\u043A. \u0407\u0445 \u0431\u0456\u043B\u044C\u0448\u0435,
      \u0456 \u0437 \u043D\u0438\u043C\u0438 - \u041A\u0456\u0433\u0442\u0456 \u0442\u0430
      \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630198
    m_Localized: "\u042F\u043A\u0449\u043E \u0447\u0435\u0441\u043D\u043E, \u044F
      \u043D\u0435 \u0437\u043D\u0430\u044E \u043D\u0430\u0432\u0456\u0442\u044C,
      \u0445\u0442\u043E \u0446\u0456 \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630199
    m_Localized: "\u041A\u0456\u0433\u0442\u0456 - \u0446\u0435 \u043D\u0435 \u043F\u043E\u043D\u0456.
      \u0426\u0435 \u0433\u0440\u0438\u0444\u043E\u043D\u0438. \u0422\u0438 \u0447\u0443\u043B\u0430
      \u043F\u0440\u043E \u0442\u0430\u043A\u0438\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630200
    m_Localized: "\u041D\u0430\u0447\u0435\u0431\u0442\u043E \u043F\u0440\u0438\u0433\u0430\u0434\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630201
    m_Localized: "\u0422\u0430\u043A \u043E\u0442, \u041A\u0456\u0433\u0442\u0456
      - \u0446\u0435 \u0433\u0440\u0438\u0444\u043E\u043D\u0438-\u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u044F\u043A \u0442\u043E\u0431\u0456
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438, \u0430\u043B\u0435... \u0443 \u043D\u0438\u0445
      \u0436\u0438\u0442\u0442\u044F \u0456\u043D\u0448\u0435. \u0406 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438.
      \u0421\u0430\u043C\u0456 \u043F\u043E \u0441\u043E\u0431\u0456 \u0432\u043E\u043D\u0438
      \u043D\u0430\u0447\u0435\u0431\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0456
      \u0445\u043B\u043E\u043F\u0446\u0456, \u0430\u043B\u0435 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u0441\u043E\u0432\u0456\u0441\u0442\u0456 \u0432 \u043D\u0438\u0445 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442.
      \u0425\u0442\u043E \u0457\u043C \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      - \u0437 \u0442\u0438\u043C \u0456 \u0434\u0440\u0443\u0436\u0430\u0442\u044C.
      \u0406 \u0437\u0430\u0440\u0430\u0437 \u0457\u043C \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0427\u0435\u0440\u0432\u043E\u043D\u0435 \u041E\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630202
    m_Localized: "\u0423 \u043D\u0438\u0445 \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u0440\u0438\u0448\u043E\u043A \u0437\u0430\u0440\u043E\u0431\u043B\u0435\u043D\u043E.
      \u0406 \u0432\u043E\u043D\u0438 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C
      \u0446\u0456 \u043A\u0440\u0438\u0448\u0435\u0447\u043A\u0438, \u0448\u043E\u0431
      \u043A\u0443\u043F\u0443\u0432\u0430\u0442\u0438 \u043D\u0430\u0439\u0437\u0430\u0431\u0456\u0439\u043D\u0456\u0448\u0456
      \u0433\u0430\u0440\u043C\u0430\u0442\u0438 \u0432 \u0443\u0441\u0456\u0439
      \u041F\u0443\u0441\u0442\u0446\u0456. \u0422\u043E\u043C\u0443 \u0431\u043E\u0434\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437 \u043E\u0434\u043D\u0438\u043C
      \u0456\u0437 \u043D\u0438\u0445 - \u0440\u0438\u0437\u0438\u043A\u043E\u0432\u0430\u043D\u0430
      \u0441\u043F\u0440\u0430\u0432\u0430. \u0410 \u0442\u0430\u043C \u0457\u0445
      \u0446\u0456\u043B\u0430 \u0448\u043E\u0431\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630203
    m_Localized: "\u0410\u043B\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u0432\u043E\u043D\u0438
      \u043D\u0435 \u0442\u0430\u043A\u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456,
      \u044F\u043A \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630204
    m_Localized: "\u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043C\u0430\u043B\u043E
      \u0445\u0442\u043E \u0437\u043D\u0430\u0454, \u0445\u0442\u043E \u0432\u043E\u043D\u0438
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0442\u0430\u043A\u0456. \u0412\u0438\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C
      \u0432\u043E\u043D\u0438 \u044F\u043A \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0438,
      \u0430\u043B\u0435 \u0442\u043E\u0447\u043D\u043E \u043D\u0456\u044F\u043A
      \u0437 \u043D\u0438\u043C\u0438 \u043D\u0435 \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0456.
      \u0412\u043E\u043D\u0438 \u0431\u0435\u0437\u0436\u0430\u043B\u044C\u043D\u0456,
      \u0433\u043E\u0440\u0434\u043E\u0432\u0438\u0442\u0456 \u0439 \u0435\u0433\u043E\u0457\u0441\u0442\u0438\u0447\u043D\u0456.
      \u0406 \u0432\u043E\u043D\u0438 \u0432\u043A\u0440\u0430\u0439 \u0441\u0438\u043B\u044C\u043D\u0456
      \u0432 \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630205
    m_Localized: "\u0406 \u0446\u0435 \u043D\u0435 \u0432\u0441\u0435. \u0413\u0430\u0434\u043A\u0438
      \u043D\u0435 \u043C\u0430\u044E, \u044F\u043A, \u0430\u043B\u0435 \u0432\u043E\u043D\u0438
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0456
      \u043E\u0434\u0438\u043D \u0437 \u043E\u0434\u043D\u0438\u043C \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0438\u0447\u043D\u043E.
      \u0412\u043E\u043D\u0438 \u043D\u0430\u0437\u0438\u0432\u0430\u044E\u0442\u044C
      \u0446\u0435 \"\u0404\u0434\u043D\u0456\u0441\u0442\u044C\" \u0456 \u043F\u0440\u0430\u0433\u043D\u0443\u0442\u044C
      \u043D\u0430\u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438
      \u0434\u043E \u043D\u0435\u0457 \u0432\u0441\u0456\u0445, \u043A\u043E\u0433\u043E
      \u043C\u043E\u0436\u0443\u0442\u044C. \u0410 \u0433\u043E\u043B\u043E\u0432\u043D\u0430
      \u0432 \u0446\u0456\u0439 \u0404\u0434\u043D\u043E\u0441\u0442\u0456 - \u044F\u043A\u0430\u0441\u044C
      \u0411\u043E\u0433\u0438\u043D\u044F. \u0412\u043E\u043D\u0430 \u0432\u043A\u0430\u0437\u0443\u0454
      \u0456\u043D\u0448\u0438\u043C, \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u0438,
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u044E\u0447\u0438 \u0437\u0432\u0456\u0434\u043A\u0438\u0441\u044C
      \u0456\u0437 \u043D\u0430\u0434\u0440 \u0441\u0442\u0430\u0440\u043E\u0457
      \u0431\u0430\u0437\u0438 \u041C\u0430\u0440\u0456\u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630206
    m_Localized: "\u0410 \u0449\u0435 \u0432\u043E\u043D\u0430 \u044F\u043A\u0448\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437 \u0427\u0435\u0440\u0432\u043E\u043D\u0438\u043C \u041E\u043A\u043E\u043C,
      \u0442\u043E\u043C\u0443 \u0457\u0457 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0438
      \u0437\u0430\u0440\u0430\u0437 \u0437\u0430\u043E\u0434\u043D\u043E \u0437
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630207
    m_Localized: "\u0406 \u043E\u0441\u044C \u0442\u043E\u0431\u0456 \u0432\u0438\u0448\u0435\u043D\u044C\u043A\u0443
      \u043D\u0430 \u0442\u043E\u0440\u0442: \u0442\u0456 \u043F\u043E\u043D\u0456,
      \u0449\u043E \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0432\u0456\u0434 \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0432
      \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0456, \u0431\u0430\u0437\u0456\u043A\u0430\u044E\u0442\u044C,
      \u0449\u043E \u0431\u0430\u0447\u0438\u043B\u0438 \u0442\u0430\u043C \u044F\u043A\u043E\u0433\u043E\u0441\u044C
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0430. \u041A\u0430\u0436\u0443\u0442\u044C,
      \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u0438\u0439, \u044F\u043A
      \u0432\u0456\u0447\u043D\u0430 \u043D\u0456\u0447, \u0456 \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u0438\u0439,
      \u044F\u043A \u0437\u0433\u0440\u0430\u044F \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u0438\u0445
      \u0433\u043E\u043D\u0447\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630208
    m_Localized: "\u0422\u0438 \u0432\u0441\u0435 \u0449\u0435 \u0445\u043E\u0447\u0435\u0448
      \u0442\u0443\u0434\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630209
    m_Localized: "\u041D\u0456. \u0417\u043E\u0432\u0441\u0456\u043C \u043D\u0435
      \u0445\u043E\u0447\u0443. \u0410\u043B\u0435 \u044F \u043C\u0443\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630210
    m_Localized: "\u041D\u0430\u0432\u0456\u0442\u044C \u0442\u0430\u043A, \u0442\u0430\u043A?
      \u0428\u043A\u043E\u0434\u0430. \u041D\u0443, \u0442\u043E\u0434\u0456 \u044F
      \u043C\u043E\u0436\u0443 \u043F\u043E\u0431\u0430\u0436\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043E\u0434\u043D\u0435, @lp. \u0423\u0434\u0430\u0447\u0456 \u0442\u043E\u0431\u0456
      \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630211
    m_Localized: "\u0422\u043E\u0447\u043D\u044F\u043A. \u0423\u0434\u0430\u0447\u0456,
      @lp. \u041D\u0435 \u0432\u0456\u0434\u043A\u0438\u043D\u044C \u043A\u043E\u043F\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630212
    m_Localized: "\u0410, \u0456 \u043E\u0441\u044C \u0449\u0435 \u0448\u043E. \u0412\u0456\u0437\u044C\u043C\u0438
      \u0446\u044E \u0448\u0442\u0443\u043A\u0443. \u0423 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0456
      \u0432\u043E\u043D\u0430 \u0442\u043E\u0431\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630215
    m_Localized: "\u0427\u0435\u0440\u0432\u043E\u043D\u0435 \u041E\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630216
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456, \u044F \u0434\u0430\u0432\u043D\u043E
      \u0445\u043E\u0442\u0456\u043B\u0430 \u0437\u0430\u043F\u0438\u0442\u0430\u0442\u0438
      \u043E\u0434\u043D\u0443 \u0440\u0456\u0447. \u0425\u0442\u043E \u0442\u0430\u043A\u0438\u0439
      \u0427\u0435\u0440\u0432\u043E\u043D\u0435 \u041E\u043A\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630217
    m_Localized: "\u042F \u0432\u0436\u0435 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0440\u0430\u0437\u0456\u0432 \u043F\u0440\u043E \u043D\u044C\u043E\u0433\u043E
      \u0447\u0443\u043B\u0430, \u0437\u043E\u043A\u0440\u0435\u043C\u0430 \u0439
      \u0432\u0456\u0434 \u0442\u0435\u0431\u0435, \u0430\u043B\u0435 \u043F\u043E\u043A\u0438
      \u0449\u043E \u0432\u0441\u0435 \u0449\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E
      \u043D\u0456\u0447\u043E\u0433\u043E, \u043A\u0440\u0456\u043C \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0432\u0456\u043D - \u043B\u0456\u0434\u0435\u0440 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630218
    m_Localized: "\u0410\u0433\u0430\u0441\u044C, \u0446\u0435 \u0442\u0430\u043A.
      \u0412\u0456\u043D \u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u0443 \u0446\u0438\u0445 \u0448\u043A\u0443\u0440\u043E\u0434\u0435\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630219
    m_Localized: "\u0410\u043B\u0435 \u0432\u0456\u043D \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043A\u0430\u0436\u0435 \u0457\u043C \u0445\u0430\u043F\u0430\u0442\u0438
      \u0432\u0441\u0456\u0445 \u043F\u0456\u0434\u0440\u044F\u0434 \u0456 \u0432\u0435\u0441\u0442\u0438
      \u0434\u043E \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u0457.
      \u0412\u0456\u043D \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E \u0432\u0456\u0440\u0438\u0442\u044C,
      \u0448\u043E \u0440\u044F\u0442\u0443\u0454 \u043F\u043E\u043D\u0456. \u0411\u0443\u0434\u0443\u0454
      \u043D\u043E\u0432\u0438\u0439 \u0441\u0432\u0456\u0442, \u0442\u0438\u043F\u0443
      \u0442\u043E\u0433\u043E. \u041D\u0443 \u0447\u0438 \u043A\u0430\u0436\u0435
      \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630220
    m_Localized: "\u0423 \u043D\u044C\u043E\u0433\u043E \u0431\u0430\u0437\u0430
      \u0443 \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u0457,
      \u0442\u043E\u0447\u043D\u0456\u0448\u0435, \u0446\u0456\u043B\u0435 \u043C\u0456\u0441\u0442\u043E.
      \u0420\u0430\u0431\u0438 \u0442\u0430\u043C \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C,
      \u043F\u043E\u043A\u0438 \u043D\u0435 \u043F\u043E\u043C\u0440\u0443\u0442\u044C.
      \u0411\u0443\u0434\u0443\u044E\u0442\u044C \u0437\u0430\u0432\u043E\u0434\u0438,
      \u043D\u0430 \u044F\u043A\u0438\u0445 \u043F\u043E\u0442\u0456\u043C \u043C\u0430\u0439\u0441\u0442\u0440\u0443\u044E\u0442\u044C
      \u0437\u0431\u0440\u043E\u044E \u0434\u043B\u044F \u0430\u0440\u043C\u0456\u0457
      \u0427\u0435\u0440\u0432\u043E\u043D\u043E\u0433\u043E \u041E\u043A\u0430.
      \u041A\u0430\u0436\u0443\u0442\u044C, \u043C\u0456\u0441\u0442\u043E \u0432\u0436\u0435
      \u0432\u0435\u043B\u0438\u043A\u0435, \u0430\u043B\u0435 \u044F \u0442\u0430\u043C
      \u043D\u0435 \u0431\u0443\u0432\u0430\u0432 \u0436\u043E\u0434\u043D\u043E\u0433\u043E
      \u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630221
    m_Localized: "\u0406 \u0432 \u0446\u0456\u0439 \u0441\u0432\u043E\u0457\u0439
      \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u0457 \u0427\u0435\u0440\u0432\u043E\u043D\u0435
      \u041E\u043A\u043E \u0449\u043E\u0434\u043D\u044F \u0437 \u0442\u0440\u0438\u0431\u0443\u043D
      \u0432\u0442\u0438\u0440\u0430\u0454 \u043F\u043E\u043D\u0456, \u044F\u043A
      \u0432\u043E\u043D\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u0442\u0438
      \u0437\u0430\u0440\u0430\u0434\u0438 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0433\u043E
      \u0457\u0445\u043D\u0456\u0445 \u0434\u0456\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630222
    m_Localized: "\u041B\u0430\u0439\u043D\u043E \u0431\u0456\u0437\u043E\u043D\u044F\u0447\u0435
      \u0446\u0435 \u0432\u0441\u0435, @lp. \u042F\u043A\u0435 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454
      \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u043A\u0456\u0441\u0442\u043A\u0430\u0445? \u041F\u043E\u043D\u0456
      \u0432\u043C\u0438\u0440\u0430\u044E\u0442\u044C \u0437\u0430\u0440\u0430\u0434\u0438
      \u0439\u043E\u0433\u043E \u0456\u0434\u0435\u0439, \u0430 \u0439\u043E\u0433\u043E
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456 -
      \u0431\u0430\u043D\u0434\u044E\u0433\u0438 \u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u0457
      \u0434\u043E\u0440\u043E\u0433\u0438. \u0422\u0430\u043A \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454
      \u043D\u0435 \u0431\u0443\u0434\u0443\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630223
    m_Localized: "\u0410\u043B\u0435 \u0454 \u0442\u0430\u043A\u0456, \u0445\u0442\u043E
      \u0432\u0456\u0440\u0438\u0442\u044C. \u0422\u0430\u043A \u0432\u0456\u043D
      \u0456 \u043D\u0430\u0431\u0438\u0440\u0430\u0454 \u0441\u043E\u0431\u0456
      \u043D\u043E\u0432\u0430\u0447\u043A\u0456\u0432. \u0406 \u0447\u0430\u0441\u0442\u043E
      \u043D\u0430\u0431\u0438\u0440\u0430\u0454, \u0431\u043E \u0439\u043E\u0433\u043E
      \u0434\u0443\u0431\u043E\u043B\u043E\u043C\u0456\u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0456
      \u043F\u043E\u043D\u0456 \u0432\u0456\u0442\u0430\u044E\u0442\u044C \u043A\u0443\u043B\u0435\u044E
      \u0432 \u043B\u043E\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630224
    m_Localized: "\u0422\u0430\u043A, \u0442\u0435\u043F\u0435\u0440 \u0443\u0441\u0435
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0456\u0448\u0435. \u0414\u044F\u043A\u0443\u044E,
      \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630225
    m_Localized: "\u0410 \u044F \u0432\u0436\u0435 \u044F\u043A\u043E\u0441\u044C
      \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044F \u043D\u0430\u0432\u0447\u0438\u0442\u0438
      \u0439\u043E\u0433\u043E \u0441\u043B\u0443\u0436\u043E\u043A \u043C\u0430\u043D\u0435\u0440\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630226
    m_Localized: "\u041D\u0435 \u0445\u0430\u043F\u0430\u0439\u0441\u044F \u0437\u0430
      \u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0448\u043C\u0430\u0442\u043E\u043A,
      @lp. \u041D\u0430\u0439\u043C\u0435\u043D\u0448\u0435, \u0449\u043E \u044F
      \u0445\u043E\u0447\u0443 - \u0446\u0435 \u0449\u043E\u0431 \u0442\u0435\u0431\u0435
      \u0432\u0431\u0438\u043B\u0438 \u0430\u0431\u043E \u0437\u0430\u0431\u0440\u0430\u043B\u0438
      \u0432 \u0440\u0430\u0431\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630227
    m_Localized: "\u0410, \u0456 \u043E\u0441\u044C \u0449\u0435: \u0432\u0456\u043D
      \u0447\u0430\u0441\u0442\u043E \u0442\u0440\u0456\u043F\u0430\u0454, \u0448\u043E
      \u0432\u0438\u0439\u0448\u043E\u0432 \u0456\u0437 \u044F\u043A\u043E\u0433\u043E\u0441\u044C
      \u0421\u0442\u0456\u0439\u043B\u0430. \u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438,
      \u0421\u0442\u0456\u0439\u043B \u0446\u0456\u043B\u0438\u0445 \u0437\u0430\u0440\u0430\u0437
      \u043C\u0430\u043B\u0443\u0432\u0430\u0442\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F.
      \u0412\u0456\u0434 \u0432\u0430\u0441 \u043E\u0441\u0442\u0430\u043D\u043D\u0456
      \u0440\u043E\u043A\u0456\u0432 \u0434\u0435\u0441\u044F\u0442\u044C \u043D\u0456\u0445\u0442\u043E
      \u043D\u0435 \u0442\u0456\u043A\u0430\u0432? \u041A\u0440\u0456\u043C \u0442\u0435\u0431\u0435,
      \u0437\u0432\u0456\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630228
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u0442\u044F \u043D\u0435 \u043C\u0430\u044E.
      \u0417\u0456 \u0421\u0442\u0456\u0439\u043B\u0430, \u043A\u0430\u0436\u0435\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630229
    m_Localized: "\u0410\u0433\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630230
    m_Localized: "\u0426\u0435 \u0441\u0442\u0430\u0454 \u0446\u0456\u043A\u0430\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630231
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630232
    m_Localized: "\u041E\u0439!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630233
    m_Localized: "\u0421\u0422\u041E\u042F\u0422\u0418, \u0421\u041C\u0415\u0420\u0422\u041D\u0410.
      \u0414\u041E \u0422\u0415\u0411\u0415 \u0417\u0412\u0415\u0420\u0422\u0410\u0404\u0422\u042C\u0421\u042F
      \u0415\u041C\u0406\u0421\u0410\u0420 \u0404\u0414\u041D\u041E\u0421\u0422\u0406!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630234
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u043D\u0435 \u043A\u0440\u0438\u0447\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630235
    m_Localized: "\u041C\u041E\u0412\u0427\u0410\u0422\u0418! \u0422\u0418 \u041F\u041E\u0421\u041C\u0406\u041B\u0410
      \u0421\u0422\u0423\u041F\u0418\u0422\u0418 \u041D\u0410 \u0417\u0415\u041C\u041B\u042E,
      \u0429\u041E \u041D\u0410\u041B\u0415\u0416\u0418\u0422\u042C \u041F\u0420\u041E\u0412\u0406\u0414\u041D\u0418\u041A\u0423
      \u0412\u041E\u041B\u0406 \u0411\u041E\u0413\u0418\u041D\u0406, \u0425\u0420\u0410\u041D\u0418\u0422\u0415\u041B\u042C\u0426\u0406
      \u0410\u041C\u0423\u041B\u0415\u0422\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630236
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442\u0430 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430,
      \u044F \u0432\u0432\u0430\u0436\u0430\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630237
    m_Localized: "\u041C\u041E\u0412\u0427\u0410\u0422\u0418!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630238
    m_Localized: "\u0422\u0418 \u041F\u041E\u0421\u041C\u0406\u041B\u0410 \u0422\u0410\u041A\u041E\u0416
      \u041D\u0410\u041F\u0410\u0421\u0422\u0418 \u041D\u0410 \u041D\u0410\u0428\u0418\u0425
      \u0421\u0415\u0421\u0422\u0415\u0420, \u041D\u0418\u0428\u041A\u041E\u041C
      \u0410\u0422\u0410\u041A\u0423\u042E\u0427\u0418 \u0407\u0425 \u0423 \u0421\u041F\u0418\u041D\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630239
    m_Localized: "\u0404\u0414\u041D\u0406\u0421\u0422\u042C \u0412\u0418\u041D\u0415\u0421\u041B\u0410
      \u0421\u0412\u0406\u0419 \u0412\u0415\u0420\u0414\u0418\u041A\u0422. \u0422\u0412\u041E\u0407\u041C
      \u0412\u0418\u0420\u041E\u041A\u041E\u041C \u041C\u041E\u0416\u0415 \u0411\u0423\u0422\u0418
      \u0422\u0406\u041B\u042C\u041A\u0418 \u0421\u041C\u0415\u0420\u0422\u042C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630240
    m_Localized: "\u0406 \u041C\u0418 \u041F\u0420\u0418\u0419\u0428\u041B\u0418
      \u0412\u0418\u041A\u041E\u041D\u0410\u0422\u0418 \u0419\u041E\u0413\u041E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630241
    m_Localized: "\u0423 \u0422\u0415\u0411\u0415 \u041D\u0415\u041C\u0410\u0404
      \u0428\u0410\u041D\u0421\u0406\u0412 \u041F\u0415\u0420\u0415\u041C\u041E\u0413\u0422\u0418
      \u041D\u0410\u0421 \u0423 \u0427\u0415\u0421\u041D\u041E\u041C\u0423 \u0411\u041E\u042E,
      \u0425\u0420\u041E\u0411\u0410\u0427\u0418\u041D\u0410. \u041B\u042E\u0422\u042C
      \u0411\u041E\u0413\u0418\u041D\u0406 \u0421\u041F\u041E\u041F\u0415\u041B\u0418\u0422\u042C
      \u0422\u0412\u041E\u042E \u041F\u041B\u041E\u0422\u042C. \u0417\u0414\u0410\u0412\u0410\u0419\u0421\u042F,
      \u0406 \u0404\u0414\u041D\u0406\u0421\u0422\u042C \u0414\u0410\u0421\u0422\u042C
      \u0422\u041E\u0411\u0406 \u0417\u041C\u041E\u0413\u0423 \u041F\u041E\u041C\u0415\u0420\u0422\u0418...
      \u041C\u0415\u041D\u0428 \u0411\u041E\u041B\u0406\u0421\u041D\u041E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630242
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u041A\u0440\u0438\u0432\u0430\u0432\u0438\u043C
      \u041C\u0456\u0441\u044F\u0446\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630244
    m_Localized: "\u041E\u0422\u0416\u0415, \u0414\u041E \u041D\u0410\u0421 \u0417'\u042F\u0412\u0418\u041B\u0410\u0421\u042F
      \u041C\u041E\u0413\u0423\u0422\u041D\u042F \u0412\u0411\u0418\u0412\u0426\u042F
      \u0410\u041B\u0406\u041A\u041E\u0420\u041D\u0406\u0412. \u041C\u0418 \u041F\u0420\u0418\u0427\u0410\u0420\u041E\u0412\u0410\u041D\u0406."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630245
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0406
      \u0442\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630246
    m_Localized: "\u0422\u0412\u0406\u0419 \u0414\u0423\u0425 \u0412\u0420\u0410\u0416\u0410\u0404,
      \u0410\u041B\u0415 \u0422\u0406\u041B\u041E \u0422\u0412\u041E\u0404 \u0421\u041B\u0410\u0411\u041A\u0415.
      \u0422\u0418 - \u041D\u0406\u0429\u041E, \u0416\u0410\u041B\u042E\u0413\u0406\u0414\u041D\u0410
      \u041F\u041E\u0420\u041E\u0428\u0418\u041D\u041A\u0410 \u041F\u0415\u0420\u0415\u0414
      \u041D\u041E\u0413\u0410\u041C\u0418 \u0411\u041E\u0413\u0418\u041D\u0406."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630247
    m_Localized: "\u0410\u041B\u0415 \u0422\u0418 \u041D\u0415 \u0411\u0415\u0417\u041D\u0410\u0414\u0406\u0419\u041D\u0410,
      \u041F\u0418\u041B\u0418\u041D\u041A\u0410. \u0422\u0412\u0406\u0419 \u041F\u041E\u0422\u0415\u041D\u0426\u0406\u0410\u041B
      \u0412\u0415\u041B\u0418\u041A\u0418\u0419, \u0406 \u0411\u041E\u0413\u0418\u041D\u042F
      \u0412\u0412\u0410\u0416\u0410\u0404 \u0422\u0415\u0411\u0415 \u0413\u0406\u0414\u041D\u041E\u042E
      \u0421\u0422\u0410\u0422\u0418. \u0427\u0410\u0421\u0422\u0418\u041D\u041E\u042E.
      \u041D\u0410\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630248
    m_Localized: "\u041F\u0420\u0418\u0419\u041C\u0418 \u0421\u0412\u041E\u042E \u0414\u041E\u041B\u042E,
      \u0421\u041C\u0415\u0420\u0422\u041D\u0410, \u0406 \u0421\u0422\u0410\u041D\u042C
      \u0427\u0410\u0421\u0422\u0418\u041D\u041E\u042E \u0404\u0414\u041D\u041E\u0421\u0422\u0406."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630249
    m_Localized: "\u042F\u043A\u0438\u0439 \u043C\u0435\u043D\u0456 \u0437 \u0446\u044C\u043E\u0433\u043E
      \u0437\u0438\u0441\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630250
    m_Localized: "\u0411\u041E\u0413\u0418\u041D\u042F \u0413\u041E\u0422\u041E\u0412\u0410
      \u041F\u0420\u0418\u0419\u041D\u042F\u0422\u0418 \u0422\u0415\u0411\u0415 \u0414\u041E
      \u041D\u0410\u0428\u0418\u0425 \u041B\u0410\u0412. \u0422\u0418 \u041C\u041E\u0416\u0415\u0428
      \u0417\u041B\u0418\u0422\u0418\u0421\u042F \u0417 \u041D\u0410\u041C\u0418,
      \u0421\u0422\u0410\u0422\u0418 \u0404\u0414\u0418\u041D\u0418\u041C \u0406\u0417
      \u041C\u041E\u0413\u0423\u0422\u041D\u0406\u041C \u0420\u041E\u0417\u0423\u041C\u041E\u041C,
      \u0412\u0406\u0414\u0427\u0423\u0422\u0418 \u0421\u041F\u0406\u041B\u042C\u041D\u0406\u0421\u0422\u042C
      \u0412\u0415\u041B\u0418\u041A\u0418\u0425, \u0429\u041E \u0423\u0421\u041F\u0410\u0414\u041A\u0423\u042E\u0422\u042C
      \u0415\u041A\u0412\u0415\u0421\u0422\u0420\u0406\u042E! \u041C\u0406\u0426\u0406
      \u0410\u041B\u0406\u041A\u041E\u0420\u041D\u0406\u0412 \u0411\u041E\u0413\u0418\u041D\u0406
      \u041D\u0415 \u0421\u041C\u0406\u0404 \u041E\u041F\u0418\u0420\u0410\u0422\u0418\u0421\u042F
      \u0416\u041E\u0414\u0415\u041D \u0416\u0410\u041B\u042E\u0413\u0406\u0414\u041D\u0418\u0419
      \u0420\u0410\u0411, \u0406 \u0422\u0418 \u0410\u0411\u041E \u041F\u0420\u0418\u0419\u041C\u0415\u0428
      \u0404\u0414\u041D\u0406\u0421\u0422\u042C, \u0410\u0411\u041E \u0417\u0413\u041E\u0420\u0418\u0428
      \u0423 \u0407\u0407 \u041F\u041E\u041B\u0423\u041C'\u0407. \u0412\u0418\u0411\u0418\u0420\u0410\u0419,
      \u0421\u041C\u0415\u0420\u0422\u041D\u0410! \u0412\u0418\u0411\u0418\u0420\u0410\u0419,
      \u0411\u041E \u0426\u0415 \u041D\u0410\u0419\u0413\u041E\u041B\u041E\u0412\u041D\u0406\u0428\u0418\u0419
      \u041C\u041E\u041C\u0415\u041D\u0422 \u0423\u0421\u042C\u041E\u0413\u041E \u0422\u0412\u041E\u0413\u041E
      \u0416\u0410\u041B\u042E\u0413\u0406\u0414\u041D\u041E\u0413\u041E \u0416\u0418\u0422\u0422\u042F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630251
    m_Localized: "\u041C\u043C\u043C, \u043D\u0443... \u043D\u0456, \u043D\u0435
      \u0446\u0456\u043A\u0430\u0432\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630252
    m_Localized: "\u042F\u041A\u0410 \u0417\u0423\u0425\u0412\u0410\u041B\u0406\u0421\u0422\u042C.
      \u042F\u041A\u0410 \u0414\u0423\u0420\u0406\u0421\u0422\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630253
    m_Localized: "\u0422\u041E\u0414\u0406 \u0422\u0418 \u0417\u0413\u041E\u0420\u0418\u0428,
      \u041A\u041E\u041C\u0410\u0425\u0410."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630254
    m_Localized: "\u0426\u0435 \u0432\u0456\u043D, \u0442\u0430\u043A? \u0410\u043C\u0443\u043B\u0435\u0442
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630255
    m_Localized: "\u0422\u0430\u043A, \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0432\u0456\u043D. \u0422\u0456\u043B\u044C\u043A\u0438 \u0432\u0456\u0434
      \u0442\u043E\u0433\u043E, \u0449\u043E \u044F \u0442\u0440\u0438\u043C\u0430\u044E
      \u0439\u043E\u0433\u043E \u0432 \u043A\u043E\u043F\u0438\u0442\u0430\u0445,
      \u043C\u043E\u0457\u043C\u0438 \u043C'\u044F\u0437\u0430\u043C\u0438 \u043F\u0440\u043E\u0431\u0456\u0433\u0430\u0454
      \u0434\u0438\u0432\u043D\u0435 \u0442\u0440\u0435\u043C\u0442\u0456\u043D\u043D\u044F.
      \u041C\u0435\u043D\u0435 \u043D\u0456\u0431\u0438 \u043D\u0430\u043F\u043E\u0432\u043D\u044E\u0454
      \u0441\u0438\u043B\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630256
    m_Localized: "\u0429\u043E \u0436 \u0431\u0443\u0434\u0435, \u044F\u043A\u0449\u043E
      \u044F \u0432\u0434\u044F\u0433\u043D\u0443 \u0439\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630257
    m_Localized: "\u041D\u0435 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E,
      \u0410\u043C\u0443\u043B\u0435\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630258
    m_Localized: "\u0419\u043E\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u043E\u0434\u044F\u0433\u0430\u0442\u0438. \u0426\u0435 \u0442\u043E\u0447\u043D\u043E.
      \u0406 \u044F \u043D\u0435 \u0431\u0443\u0434\u0443. \u041C\u0435\u043D\u0456
      \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0432\u0456\u043D \u0437\u0456 \u043C\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630259
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u043C \u0439\u043E\u0433\u043E \u043A\u0443\u0440'\u0454\u0440\u0443
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430, \u0449\u043E\u0439\u043D\u043E
      \u0437'\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u043D\u043E\u0432\u0438\u0439
      \u0448\u0430\u043D\u0441 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F
      \u0437 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630260
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u043F\u0440\u043E
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630261
    m_Localized: "\u0417\u0434\u0440\u0430\u0441\u0442\u0443\u0439, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630262
    m_Localized: "\u0420\u0430\u0434\u0438\u0439 \u0442\u0435\u0431\u0435 \u0431\u0430\u0447\u0438\u0442\u0438,
      @lp. \u042F \u0432\u0436\u0435 \u043D\u0435 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0432\u0441\u044F,
      \u0449\u043E \u0442\u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0448\u0441\u044F.
      \u042F\u043A \u0442\u0432\u043E\u044F \u0441\u043F\u0440\u0430\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630263
    m_Localized: "\u041A\u0440\u0430\u0449\u0435, \u043D\u0456\u0436 \u043C\u043E\u0433\u043B\u043E
      \u0431\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823744
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0430 \u0432 \u043A\u0430\u043F\u0435\u043B\u044E\u0441\u0456?
      \u0411\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0442\u0440\u0435\u0431\u0430
      \u043D\u0456\u043A\u0443\u0434\u0438 \u0431\u0456\u0433\u0442\u0438 \u0456
      \u043D\u0456\u043A\u043E\u0433\u043E \u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823745
    m_Localized: "\u0411\u043E\u044E\u0441\u044F, \u0449\u043E \u043D\u0435 \u0437\u043E\u0432\u0441\u0456\u043C
      \u0442\u0430\u043A. \u041C\u0456\u0439 \u0448\u043B\u044F\u0445 \u0442\u0435\u043F\u0435\u0440
      \u043B\u0435\u0436\u0438\u0442\u044C \u0443 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823746
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442?.. \u0404
      \u0448\u043B\u044F\u0445\u0438 \u043F\u043E\u043C\u0435\u0440\u0442\u0438 \u043B\u0435\u0433\u0448\u0435,
      \u0437\u043D\u0430\u0454\u0448. \u0428\u043E \u0437\u0430 \u043B\u0438\u0445\u043E
      \u0442\u0443\u0434\u0438 \u0442\u0435\u0431\u0435 \u043D\u0435\u0441\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823747
    m_Localized: "\u042F \u0440\u043E\u0431\u043B\u044E \u0446\u0435 \u0437\u0430\u0440\u0430\u0434\u0438
      \u043C\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430. \u041F\u043E\u0432\u0456\u0440,
      \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0432\u0430\u0436\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823748
    m_Localized: "\u0412\u0436\u0435 \u043D\u0435 \u0434\u0443\u043C\u0430\u0432,
      \u0449\u043E \u043F\u043E\u0447\u0443\u044E \u0446\u0435 \u0437\u043D\u043E\u0432\u0443.
      \u0422\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430 \u0432 \u0446\u044C\u043E\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823749
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737823750
    m_Localized: "\u0422\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823751
    m_Localized: "\u042F\u043A \u0437\u043D\u0430\u0454\u0448. \u0410\u043B\u0435
      \u044F \u043D\u0435 \u043C\u043E\u0436\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0442\u043E\u0431\u0456. \u041D\u0456\u0447\u0438\u043C. \u042F \u0441\u0430\u043C
      \u043D\u0435 \u0431\u0443\u0432\u0430\u0432 \u0443 \u0442\u0438\u0445 \u043A\u0440\u0430\u044F\u0445
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443. \u0417\u043D\u0430\u044E
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0435, \u0448\u043E \u0456\u043D\u0448\u0456
      \u043A\u0430\u0436\u0443\u0442\u044C. \u0410 \u0433\u043E\u0432\u043E\u0440\u044F\u0442\u044C
      \u0432\u043E\u043D\u0438 \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823752
    m_Localized: "\u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u044F \u0437\u043D\u0430\u044E \u043C\u0435\u043D\u0448\u0435
      \u0437\u0430 \u0442\u0435\u0431\u0435. \u0421\u043A\u0430\u0436\u0438 \u043C\u0435\u043D\u0456,
      \u0449\u043E \u0442\u0438 \u0437\u043D\u0430\u0454\u0448 \u043F\u0440\u043E
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0441\u0430\u043C\u0435 \u0446\u0435 \u0432\u0440\u044F\u0442\u0443\u0454
      \u043C\u0435\u043D\u0456 \u0442\u0430\u043C \u0436\u0438\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823753
    m_Localized: "\u041D\u0443, \u044F\u043A\u0448\u043E \u0442\u0430\u043A, \u0442\u043E
      \u0441\u043B\u0443\u0445\u0430\u0439. \u041C\u0435\u043D\u0456 \u043A\u0430\u0437\u0430\u043B\u0438
      \u0432\u0441\u044F\u043A\u0456 \u0436\u0430\u0445\u0456\u0442\u0442\u044F \u043F\u0440\u043E
      \u0446\u0435 \u043C\u0456\u0441\u0442\u043E. \u0414\u043E \u0412\u0456\u0439\u043D\u0438
      \u0432\u043E\u043D\u043E \u0431\u0443\u043B\u043E \u043D\u0430\u0448\u043E\u044E
      \u0441\u0442\u043E\u043B\u0438\u0446\u0435\u044E, \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F
      \u0456 \u041B\u0443\u043D\u0430 \u0436\u0438\u043B\u0438 \u0442\u0430\u043C.
      \u041D\u0443 \u0456 \u0437\u0435\u0431\u0440\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u043B\u0438
      \u0434\u043B\u044F \u043D\u044C\u043E\u0433\u043E \u043D\u0430\u0439\u0433\u0456\u0440\u0448\u0435,
      \u0447\u043E\u0433\u043E \u0437\u043C\u043E\u0433\u043B\u0438. \u042F\u043A\u0438\u0439\u0441\u044C
      \u043B\u044E\u0442\u0438\u0439 \u0433\u0430\u0437, \u044F\u043A\u0438\u0439
      \u0437\u0432\u0435\u0442\u044C\u0441\u044F \u0420\u043E\u0436\u0435\u0432\u0430
      \u0425\u043C\u0430\u0440\u0430. \u0412\u0456\u043D \u0432\u0431\u0438\u0432\u0430\u0454
      \u0434\u0443\u0436\u0435 \u0448\u0432\u0438\u0434\u043A\u043E, \u0433\u0456\u0440\u0448\u0435
      \u0442\u043E\u0433\u043E, \u0437\u0440\u043E\u0449\u0443\u0454 \u0432\u0441\u0435,
      \u0434\u043E \u0447\u043E\u0433\u043E \u0442\u043E\u0440\u043A\u043D\u0435\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823754
    m_Localized: "\"\u0417\u0440\u043E\u0449\u0443\u0454\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823755
    m_Localized: "\u0410\u0433\u0430\u0441\u044C. \u041D\u0443, \u0431\u0443\u043B\u043E
      \u0434\u0432\u0430 - \u0441\u0442\u0430\u043B\u043E \u043E\u0434\u043D\u0435.
      \u0422\u044F\u0433\u0430\u043B\u0430 \u0442\u0438 \u0441\u0432\u0456\u0439
      \u041F\u0456\u043F\u0411\u0430\u043A \u043D\u0430 \u043D\u043E\u0437\u0456,
      \u0440\u0430\u0437 - \u0432\u0456\u043D \u0434\u043E \u0442\u0435\u0431\u0435
      \u043F\u0440\u0438\u043A\u043B\u0435\u0457\u0432\u0441\u044F, \u0442\u0430\u043A,
      \u0448\u043E \u0437 \u043C'\u044F\u0441\u043E\u043C \u043D\u0435 \u0432\u0456\u0434\u0456\u0440\u0432\u0435\u0448.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u0431\u0430\u0439\u043A\u0438 \u0446\u0435
      \u0447\u0438 \u043D\u0456, \u0430\u043B\u0435 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0442\u0438
      \u043D\u0435 \u0441\u0442\u0430\u0432 \u0431\u0438. \u0413\u0430\u0434\u043A\u0438
      \u043D\u0435 \u043C\u0430\u044E, \u0449\u043E \u0442\u0430\u043C \u0442\u043E\u0434\u0456
      \u0441\u0442\u0430\u043B\u043E\u0441\u044F, \u0430\u043B\u0435 \u0432\u0456\u0434\u0442\u043E\u0434\u0456
      \u0442\u0430\u043C \u0446\u0456\u0454\u0457 \u0425\u043C\u0430\u0440\u0438
      \u0441\u0438\u043B\u0430-\u0441\u0438\u043B\u0435\u043D\u043D\u0430. \u0406
      \u044F \u043D\u0435 \u0447\u0443\u0432, \u0448\u043E\u0431 \u0445\u0442\u043E\u0441\u044C
      \u0437\u0432\u0456\u0434\u0442\u0438 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0432\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823756
    m_Localized: "\u0410 \u0449\u0435 \u044F \u0447\u0443\u0432, \u0449\u043E \u0442\u0430\u043C
      \u043F\u0440\u0438\u043C\u0430\u0440\u0438 \u0432\u043E\u0434\u044F\u0442\u044C\u0441\u044F.
      \u041F\u0440\u0438\u0432\u0438\u0434\u0438 \u043F\u043E\u043C\u0435\u0440\u043B\u0438\u0445
      \u043F\u043E\u043D\u0456. \u0412\u043E\u043D\u0438 \u043F\u043E\u043C\u0435\u0440\u043B\u0438
      \u0442\u0430\u043A \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u043E,
      \u0449\u043E \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438 \u043D\u0430\u0448 \u0441\u0432\u0456\u0442,
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u0436\u0438\u0432\u0443\u0442\u044C
      \u0442\u0430\u043C, \u0443 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456.
      \u0414\u043B\u044F \u043D\u0438\u0445 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043E\u0434\u043D\u0430 \u0432\u0442\u0456\u0445\u0430 \u0454 - \u0437\u0430\u0431\u0440\u0430\u0442\u0438
      \u0434\u043E \u0441\u0435\u0431\u0435 \u043A\u043E\u0433\u043E\u0441\u044C
      \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u043E\u0433\u043E. \u0406 \u0432\u043E\u043D\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823757
    m_Localized: "\u042F \u043D\u0435 \u0441\u043A\u0430\u0436\u0443 \u0442\u043E\u0431\u0456
      \u0442\u043E\u0447\u043D\u043E, \u043A\u0443\u0434\u0438 \u0439\u0442\u0438
      \u0442\u0440\u0435\u0431\u0430, \u0448\u043E\u0431 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0442\u0443\u0434\u0438. \u042F \u0437\u043D\u0430\u044E, \u0448\u043E \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442
      \u0434\u0430\u043B\u0435\u043A\u043E \u043D\u0430 \u043F\u0456\u0432\u043D\u043E\u0447\u0456
      \u0432\u0456\u0434 \u043D\u0430\u0441. \u0414\u0443\u043C\u0430\u044E, \u0434\u043E
      \u043D\u044C\u043E\u0433\u043E \u0432\u0435\u0434\u0443\u0442\u044C \u0443\u0441\u0456
      \u0434\u043E\u0440\u043E\u0433\u0438, \u044F\u043A\u0448\u043E \u0432\u0436\u0435
      \u0432\u0456\u043D \u0441\u0442\u043E\u043B\u0438\u0446\u0435\u044E \u0431\u0443\u0432.
      \u0422\u043E\u0436 \u043D\u0430 \u0442\u0432\u043E\u0454\u043C\u0443 \u043C\u0456\u0441\u0446\u0456
      \u044F \u0431 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u0432\u0435\u043B\u0438\u043A\u0435 \u0448\u043E\u0441\u0435 \u043D\u0430
      \u043F\u0456\u0432\u043D\u0456\u0447 \u0456 \u0439\u0448\u043E\u0432 \u0431\u0438
      \u043D\u0438\u043C, \u0434\u043E\u043A\u0438 \u043D\u0435 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u0431\u0438 \u0447\u043E\u0433\u043E\u0441\u044C \u043F\u0440\u0438\u043C\u0456\u0442\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823758
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u044E, \u043C\u0435\u043D\u0456
      \u0442\u0432\u043E\u0457 \u0441\u043B\u043E\u0432\u0430 \u0434\u0443\u0436\u0435
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456.
      \u0414\u044F\u043A\u0443\u044E \u0442\u043E\u0431\u0456 \u0437\u0430 \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823759
    m_Localized: "@lp? \u0422\u0438 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0430
      \u0439\u0442\u0438 \u0442\u0443\u0434\u0438, \u0437\u043D\u0430\u0454\u0448?
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u043E\u0433\u043E \u0432 \u0442\u0435\u0431\u0435
      \u0442\u0430\u043C \u0437\u0430 \u0441\u043F\u0440\u0430\u0432\u0438 \u0437\u0456
      \u0441\u0432\u043E\u0457\u043C \u0421\u0442\u0456\u0439\u043B\u043E\u043C,
      \u0430\u043B\u0435 \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u0435\u043D
      \u0442\u0430\u043A \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F\u043C \u043D\u0456 \u0437\u0430 \u0433\u0440\u0456\u0448.
      \u0422\u0438 \u043C\u043E\u0436\u0435\u0448 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0442\u0443\u0442, \u0442\u043E\u0431\u0456 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0440\u0430\u0434\u0456. \u0423\u0432\u0456\u0439\u0434\u0435\u0448 \u0443
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C, \u0430\u0431\u043E \u043F\u0456\u0434\u043C\u0430\u0439\u0441\u0442\u0440\u043E\u043C
      \u0434\u043E \u0412\u0456\u043D\u0440\u0456, \u043C\u043E\u0436\u0435, \u0441\u0432\u043E\u044E
      \u0441\u043F\u0440\u0430\u0432\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0454\u0448
      \u043D\u0430\u0432\u0456\u0442\u044C. \u0422\u0438 \u0445\u043E\u0440\u043E\u0448\u0430
      \u043F\u043E\u043D\u0456, \u043F\u043E \u0442\u043E\u0431\u0456 \u0446\u0435
      \u0432\u0438\u0434\u043D\u043E. \u0417\u0430\u043B\u0438\u0448\u0430\u0439\u0441\u044F,
      \u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823760
    m_Localized: "\u042F \u0437\u0430\u043B\u0438\u0448\u0443\u0441\u044F \u0443
      \u0432\u0430\u0441. \u041A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C.
      \u0410\u043B\u0435 \u043D\u0435 \u0437\u0430\u0440\u0430\u0437. \u0417\u0430\u0440\u0430\u0437
      \u044F \u043D\u0435 \u043C\u043E\u0436\u0443 \u043D\u0456\u044F\u043A \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0441\u0432\u043E\u0457\u0445 \u0437\u0430\u0432\u0434\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823761
    m_Localized: "\u0414\u0430\u0440\u0435\u043C\u043D\u043E \u0442\u0438 \u0442\u0430\u043A,
      @lp. \u0421\u043F\u0440\u0430\u0432\u0430 \u0442\u0432\u043E\u044F, \u0437\u0432\u0456\u0441\u043D\u043E,
      \u0430\u043B\u0435 \u0434\u0430\u0440\u0435\u043C\u043D\u043E. \u041C\u043E\u0436\u0435,
      \u0441\u043A\u0430\u0436\u0435\u0448 \u0445\u043E\u0447, \u0437\u0430 \u0448\u043E
      \u0432\u043E\u044E\u0454\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823762
    m_Localized: "\u0412\u0438\u0431\u0430\u0447, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456.
      \u041D\u0435 \u043C\u043E\u0436\u0443. \u0422\u0430\u043A \u0443\u0436\u0435
      \u0432\u0438\u0439\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823763
    m_Localized: "\u041D\u0443, \u0442\u043E\u0434\u0456 \u0443\u0434\u0430\u0447\u0456
      \u0442\u043E\u0431\u0456. \u0417\u043D\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823766
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u0437\u0435\u0431\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823767
    m_Localized: "\u0421\u0442\u0456\u0439\u0442\u0435 \u0434\u0435 \u0441\u0442\u043E\u0457\u0442\u0435!
      \u041A\u043E\u043F\u0438\u0442\u0430 \u0440\u0456\u0432\u043D\u043E. \u041D\u0435
      \u0437\u043D\u0430\u044E, \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0438
      \u0432\u0438 \u0447\u0438 \u043D\u0456, \u0430\u043B\u0435 \u0432\u0430\u0448\u0435
      \u043C\u0430\u0441\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823768
    m_Localized: "\u041D\u0435 \u043F\u043E\u0433\u0440\u043E\u0436\u0443\u0439 \u043D\u0430\u043C,
      \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043A\u043E. \u0422\u0438
      \u043E\u0434\u043D\u0430, \u043D\u0430\u0441 \u043F'\u044F\u0442\u0435\u0440\u043E.
      \u0422\u043E\u0431\u0456 \u0436 \u043A\u0440\u0430\u0449\u0435, \u044F\u043A\u0449\u043E
      \u043A\u043E\u0436\u0435\u043D \u043F\u0456\u0434\u0435 \u0441\u0432\u043E\u0454\u044E
      \u0434\u043E\u0440\u043E\u0433\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823769
    m_Localized: "\u042F\u043A\u0449\u043E \u0446\u0435 \u0449\u0435 \u043E\u0434\u043D\u0430
      \u0445\u0438\u0442\u0440\u0456\u0441\u0442\u044C, \u0442\u043E \u0434\u043B\u044F
      \u0432\u0430\u0441 \u0436\u0435 \u043A\u0440\u0430\u0449\u0435, \u044F\u043A\u0449\u043E
      \u0432\u043E\u043D\u0430 \u0431\u0443\u0434\u0435 \u0432\u0434\u0430\u043B\u043E\u044E.
      \u041A\u0443\u0434\u0438 \u0432\u0438 \u043F\u0440\u044F\u043C\u0443\u0454\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823770
    m_Localized: "\u041B\u0435\u0433\u0456\u043E\u043D \u043D\u0435 \u0432\u0435\u0434\u0435
      \u0441\u043F\u0440\u0430\u0432 \u0456\u0437 \u043F\u043E\u043D\u0456, \u0442\u043E\u0436
      \u0442\u0438 \u043D\u0430\u043C \u043D\u0435 \u0432\u043E\u0440\u043E\u0433.
      \u041C\u0438 \u0439\u0434\u0435\u043C\u043E \u0434\u043E\u0434\u043E\u043C\u0443.
      \u0425\u0456\u0431\u0430 \u0443 \u043F\u043E\u043D\u0456 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043E
      \u0432\u0431\u0438\u0432\u0430\u0442\u0438 \u0442\u0438\u0445, \u0445\u0442\u043E
      \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F \u0434\u043E\u0434\u043E\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823771
    m_Localized: "\u041B\u0435\u0433\u0456\u043E\u043D? \u0425\u0442\u043E \u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823772
    m_Localized: "\u041D\u0430\u0448 \u0432\u043E\u0440\u043E\u0433. \u0406 \u0432\u0430\u0448
      \u0442\u0435\u0436. \u0417\u0435\u0431\u0440\u0438, \u0449\u043E \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0430\u0432'\u044F\u0437\u043B\u0438 \u0432 \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443,
      \u0449\u043E \u0432\u0441\u0435 \u0449\u0435 \u0432\u0435\u0434\u0443\u0442\u044C
      \u0432\u0456\u0439\u043D\u0443, \u044F\u043A\u0430 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044F
      \u0434\u0432\u0456\u0441\u0442\u0456 \u0440\u043E\u043A\u0456\u0432 \u0442\u043E\u043C\u0443.
      \u041F\u043E\u043D\u0456 \u0432\u043E\u043D\u0438 \u0432\u0431\u0438\u0432\u0430\u044E\u0442\u044C
      \u0431\u0435\u0437 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823773
    m_Localized: "\u0422\u0430\u043A, \u044F \u0431\u0430\u0447\u0438\u043B\u0430
      \u0442\u0430\u043A\u0438\u0445 \u0432\u0436\u0435 \u0440\u0430\u043D\u0456\u0448\u0435.
      \u0417\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0447\u0435\u0441\u043D\u043E,
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0438\u0445 \u044F \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043B\u0430
      \u043D\u0430\u043F\u0430\u0434\u0443 \u0456 \u0432\u0456\u0434 \u0432\u0430\u0441.
      \u0420\u0430\u0434\u0430, \u0449\u043E \u0446\u0435 \u043D\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823774
    m_Localized: "\u0417\u0435\u0431\u0440\u0430\u043C \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u043E
      \u0431\u0443\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0430\u043C\u0438 \u043F\u043E\u043D\u0456.
      \u041C\u0438 \u0432\u043E\u044E\u0432\u0430\u043B\u0438 \u0440\u0430\u043D\u0456\u0448\u0435,
      \u0456 \u0449\u043E \u043C\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0438
      \u0437 \u0442\u043E\u0433\u043E? \u041C\u0438 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0440\u0430\u0434\u0456 \u043D\u043E\u0432\u0438\u043C \u0434\u0440\u0443\u0437\u044F\u043C
      \u0443 \u0446\u0438\u0445 \u0437\u0435\u043C\u043B\u044F\u0445. \u0410 \u0432\u0438,
      \u043F\u043E\u043D\u0456, \u0431\u0443\u0432\u0430\u0454\u0442\u0435 \u0434\u0443\u0436\u0435
      \u0434\u043E\u0431\u0440\u043E\u0437\u0438\u0447\u043B\u0438\u0432\u0456, \u044F\u043A\u0449\u043E
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438 \u0432\u0430\u043C
      \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823775
    m_Localized: "\u041F\u043E \u043F\u0440\u0430\u0432\u0434\u0456, \u043C\u0438
      \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0438\u0441\u044F
      \u0437 \u0442\u0430\u043A\u043E\u044E. \u0427\u043E\u0440\u043D\u0430 \u043F\u043E\u043D\u0456
      \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u0430 \u0434\u0432\u043E\u0445
      \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0456\u0432,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u043F\u0440\u0438\u0439\u0448\u043B\u0430
      \u0437 \u043D\u0438\u043C\u0438 \u0432 \u043D\u0430\u0448 \u0434\u0456\u043C
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u0440\u044F\u0442\u0443\u0454 \u0449\u0435
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0436\u0438\u0442\u0442\u0456\u0432.
      \u042F\u043A\u0431\u0438 \u043D\u0435 \u0432\u043E\u043D\u0430, \u043D\u0430\u043C
      \u0431\u0438 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u0440\u043E\u0437\u043F\u0440\u043E\u0449\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0431\u0430\u0433\u0430\u0442\u044C\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823776
    m_Localized: "\u0427\u043E\u0440\u043D\u0430 \u043F\u043E\u043D\u0456? \u0423
      \u043D\u0435\u0457, \u0431\u0443\u0432\u0430, \u043D\u0435 \u0431\u0443\u043B\u043E
      \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044E, \u044F\u043A \u0443 \u043C\u0435\u043D\u0435
      \u043D\u0430 \u043D\u043E\u0437\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823777
    m_Localized: "\u0422\u0430\u043A, \u0432\u043E\u043D\u0430 \u043D\u043E\u0441\u0438\u0442\u044C
      \u0442\u0430\u043A\u0438\u0439 \u0441\u0430\u043C\u0438\u0439. \u0412\u0438
      \u0437\u043D\u0430\u0439\u043E\u043C\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823778
    m_Localized: "\u042F \u043F\u043E\u0432\u0438\u043D\u043D\u0430 \u0437 \u043D\u0435\u044E
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438. \u041F\u0440\u043E\u0448\u0443,
      \u043F\u0440\u043E\u0432\u0435\u0434\u0456\u0442\u044C \u043C\u0435\u043D\u0435
      \u0434\u043E \u0432\u0430\u0448\u043E\u0433\u043E \u0434\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823779
    m_Localized: "\u041C\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043C\u043E
      \u0442\u0435\u0431\u0435, \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043A\u043E.
      \u0410\u043B\u0435 \u0437\u043D\u0430\u0439, \u0449\u043E \u043C\u0438 \u043D\u0435
      \u0434\u0430\u043C\u043E \u0442\u043E\u0431\u0456 \u0437\u0430\u043F\u043E\u0434\u0456\u044F\u0442\u0438
      \u0457\u0439 \u0448\u043A\u043E\u0434\u0438. \u041D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u043F\u0440\u043E\u0431\u0443\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823780
    m_Localized: "\u0414\u043E\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F. \u0425\u043E\u0434\u0456\u043C\u043E
      \u0436!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823781
    m_Localized: "\u0422\u043E, \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C,
      \u0446\u0435 \u0456 \u0454 \u0432\u0430\u0448\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F?
      \u0412\u0438\u0433\u043B\u044F\u0434\u0430\u0454... \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823782
    m_Localized: "\u041D\u0430\u043C \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0432\u0438\u0436\u0438\u0432\u0430\u0442\u0438 \u0432 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0445
      \u0443\u043C\u043E\u0432\u0430\u0445. \u041E\u0434\u043D\u0430\u043A \u0443
      \u0446\u0456\u0439 \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u0456\u0439 \u0433\u043B\u0443\u0448\u0438\u043D\u0456
      \u043D\u0430\u043C \u043D\u0435 \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0454
      \u0437\u0456\u0442\u043A\u043D\u0443\u0442\u0438\u0441\u044F \u0437 \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823783
    m_Localized: "\u0425\u0456\u0431\u0430 \u0439\u043E\u043C\u0443 \u0454 \u0434\u043E
      \u0432\u0430\u0441 \u0434\u0456\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823784
    m_Localized: "\u041D\u0430 \u0449\u0430\u0441\u0442\u044F, \u043D\u0456. \u041D\u0430\u0441
      \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C \u0437\u0440\u0430\u0434\u043D\u0438\u043A\u0430\u043C\u0438
      \u0456 \u0437\u043B\u043E\u0447\u0438\u043D\u0446\u044F\u043C\u0438, \u0456
      \u043D\u0430\u0441 \u0443\u0431'\u044E\u0442\u044C \u043F\u0440\u0438 \u043F\u0435\u0440\u0448\u0456\u0439
      \u0436\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456 \u0431\u0435\u0437
      \u0437\u0430\u0439\u0432\u0438\u0445 \u0440\u043E\u0437\u043C\u043E\u0432.
      \u0422\u043E\u043C\u0443 \u043C\u0438 \u0437\u043C\u0443\u0448\u0435\u043D\u0456
      \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F. \u0410\u043B\u0435 \u0432
      \u043E\u0447\u0430\u0445 \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u043C\u0438
      - \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0436 \u043F\u0440\u0438\u043A\u0440\u0430
      \u0437\u0430\u0432\u0430\u0434\u0430, \u0456 \u043F\u043E\u043A\u0438 \u0432
      \u043D\u0438\u0445 \u0454 \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0456
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438, \u043D\u0430\u0441 \u043D\u0435
      \u0448\u0443\u043A\u0430\u0442\u0438\u043C\u0443\u0442\u044C. \u042F\u043A\u0449\u043E
      \u041B\u0435\u0433\u0456\u043E\u043D \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u044C
      \u043F\u0440\u0438\u0439\u0442\u0438 \u043F\u043E \u043D\u0430\u0448\u0456
      \u0434\u0443\u0448\u0456, \u0440\u0430\u043D\u043E \u0447\u0438 \u043F\u0456\u0437\u043D\u043E
      \u0432\u043E\u043D\u0438 \u0437\u043D\u0430\u0439\u0434\u0443\u0442\u044C \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823785
    m_Localized: "\u0422\u043E, \u043C\u043E\u0436\u0435, \u0432\u0430\u043C \u043A\u0440\u0430\u0449\u0435
      \u043F\u0456\u0442\u0438 \u0449\u0435 \u0434\u0430\u043B\u0456 \u043D\u0430
      \u043F\u0456\u0432\u043D\u0456\u0447?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823786
    m_Localized: "\u0412\u0456\u0434 \u043B\u0430\u0437\u0443\u0442\u0447\u0438\u043A\u0456\u0432
      \u0456 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447\u0456\u0432
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u043D\u0435 \u0441\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F.
      \u0410 \u044F\u043A\u0449\u043E \u043C\u0438 \u043F\u0456\u0434\u0435\u043C\u043E
      \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447, \u043C\u0438 \u0449\u0435
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0432\u0456\u0434\u0434\u0430\u043B\u0438\u043C\u043E\u0441\u044F
      \u0432\u0456\u0434 \u0432\u0456\u0434\u043E\u043C\u0438\u0445 \u043D\u0430\u043C
      \u0434\u0436\u0435\u0440\u0435\u043B \u0457\u0436\u0456 \u0442\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432.
      \u041C\u0438 \u043D\u0435 \u0454\u0434\u0438\u043D\u0456 \u0437\u0435\u0431\u0440\u0438,
      \u0445\u0442\u043E \u0436\u0438\u0432\u0435 \u0434\u0430\u043B\u0435\u043A\u043E
      \u0432\u0456\u0434 \u0441\u0444\u0435\u0440\u0438 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0456\u0432
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u0410\u043B\u0435 \u043D\u0456
      \u043C\u0438, \u043D\u0456 \u0456\u043D\u0448\u0456 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0438
      \u0437\u043D\u0430\u0439\u0442\u0438 \u043D\u0456\u0447\u043E\u0433\u043E \u0446\u0456\u043D\u043D\u043E\u0433\u043E
      \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447 \u0432\u0456\u0434 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430.
      \u041C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E \u043F\u0456\u0442\u0438
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E \u043A\u0443\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823787
    m_Localized: "\u0406 \u044F\u043A \u0436\u0435 \u0432\u0438 \u0442\u043E\u0434\u0456
      \u0437\u0431\u0438\u0440\u0430\u0454\u0442\u0435\u0441\u044F \u0436\u0438\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823788
    m_Localized: "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u044F\u043A
      \u0436\u0438\u0432\u0435\u043C\u043E \u0437\u0430\u0440\u0430\u0437. \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u043D\u0430\u0441 \u0442\u0443\u0442 \u043D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0442\u044C\u0441\u044F
      \u0432\u0431\u0438\u0442\u0438. \u0412\u0436\u0435 \u0434\u043E\u0431\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823789
    m_Localized: "\u0422\u0438 \u0445\u043E\u0442\u0456\u043B\u0430 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438\u0441\u044F
      \u0437 \u043D\u0430\u0448\u043E\u044E \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u044E-\u043F\u043E\u043D\u0456.
      \u0412\u043E\u043D\u0430 \u0437\u0430\u0440\u0430\u0437, \u043C\u0430\u0431\u0443\u0442\u044C,
      \u0443 \u0442\u0456\u0439 \u0431\u0443\u0434\u0456\u0432\u043B\u0456 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443,
      \u0434\u043E\u0433\u043B\u044F\u0434\u0430\u0454 \u0437\u0430 \u0417\u0456\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823790
    m_Localized: "\u0422\u0430\u043A, \u0441\u043F\u0430\u0441\u0438\u0431\u0456,
      \u0435\u043C... \u041C\u0438 \u0442\u0430\u043A \u0456 \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0438\u0441\u044F,
      \u0432\u0456\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823791
    m_Localized: "\u0410\u0441\u043A\u0430\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823792
    m_Localized: "@lp. \u041F\u0440\u0438\u0454\u043C\u043D\u043E \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823793
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u0420\u0435\u043C\u0435\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823794
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442? \u041E\u0431\u0440\u0430\u043D\u0430-24?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823795
    m_Localized: "\u041C\u0438 \u0437\u043D\u0430\u0439\u043E\u043C\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823796
    m_Localized: "\u041A\u043E\u043B\u0438\u0441\u044C \u0443 \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443
      - \u043D\u0430\u043F\u0435\u0432\u043D\u043E. \u0417\u0430\u0440\u0430\u0437
      - \u0449\u0435 \u043D\u0456. \u042F - \u041E\u0431\u0440\u0430\u043D\u0430-25.
      \u041C\u0435\u043D\u0435 \u0437\u0432\u0443\u0442\u044C @lp. \u041C\u0435\u043D\u0435
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u0442\u0443 \u043C\u0456\u0441\u0456\u044E, \u044F\u043A\u0443 \u0434\u043E\u0440\u0443\u0447\u0430\u043B\u0438
      \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u0442\u043E\u0431\u0456.
      \u0420\u0430\u0434\u0430 \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F
      \u0437 \u0442\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823797
    m_Localized: "\u0411\u0456\u0434\u043D\u0435 \u0434\u0438\u0442\u044F... \u0422\u043E\u0431\u0456
      \u0442\u0435\u0436 \u0441\u0442\u0435\u0440\u043B\u0438 \u043F\u0430\u043C'\u044F\u0442\u044C,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823798
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823799
    m_Localized: "\u0406 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u0437\u0430 \u0434\u0430\u043D\u0438\u043C\u0438 \u043D\u0430 \u0441\u0442\u0430\u0440\u0438\u0439
      \u0437\u0430\u0432\u043E\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823800
    m_Localized: "\u0422\u0430\u043A, \u0441\u0430\u043C\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823801
    m_Localized: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0442\u043E\u0431\u0456
      \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E \u0440\u043E\u0437\u0443\u043C\u0443
      \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u0440\u043E\u0431\u0438\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823802
    m_Localized: "\u042F \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0434\u0430\u043D\u0456
      \u0456 \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0430 \u0457\u0445 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0443.
      \u0422\u0430\u043A\u043E\u0436 \u044F \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0430
      \u0432\u0456\u0434 \u043D\u044C\u043E\u0433\u043E \u043D\u043E\u0432\u0456
      \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043D\u044F, \u0456 \u043E\u0434\u043D\u0435
      \u0437 \u043D\u0438\u0445 \u0432\u0435\u0434\u0435 \u043C\u0435\u043D\u0435
      \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823803
    m_Localized: "\u0421\u0432\u044F\u0442\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F...
      \u0422\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0449\u043E
      \u0442\u0438 \u0442\u0432\u043E\u0440\u0438\u0448? \u0422\u0438 \u0432\u0438\u0432\u0447\u0430\u043B\u0430
      \u043F\u0440\u043E\u0435\u043A\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823804
    m_Localized: "\u041D\u0456, \u0439\u043E\u0433\u043E \u0432\u0438\u0434\u0430\u043B\u0438\u043B\u0438
      \u0442\u0456\u0454\u0457 \u0441\u0430\u043C\u043E\u0457 \u043C\u0438\u0442\u0456,
      \u044F\u043A \u044F \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0439\u043E\u0433\u043E \u0432 \u0421\u0442\u0456\u0439\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823805
    m_Localized: "\u0422\u043E\u0431\u0442\u043E \u0442\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0454\u0448... \u0422\u0438 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0430
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438 \u0446\u0438\u043C
      \u043F\u043E\u043D\u0456, \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E?
      \u0422\u0435, \u0449\u043E \u0442\u0430\u043A \u0448\u0443\u043A\u0430\u0454
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A - \u0437\u0431\u0440\u043E\u044F,
      \u0456 \u0446\u044F \u0437\u0431\u0440\u043E\u044F \u043F\u0440\u0438\u043D\u0435\u0441\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0431\u0456\u043B\u044C \u0446\u044C\u043E\u043C\u0443
      \u0441\u0432\u0456\u0442\u0443. \u0429\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0431\u043E\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823806
    m_Localized: "\u0427\u043E\u043C\u0443 \u0442\u0438 \u0442\u0430\u043A \u043A\u0430\u0436\u0435\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823807
    m_Localized: "\u042F \u0431\u0430\u0447\u0438\u043B\u0430 \u0437\u0430\u043F\u0438\u0441\u0438.
      \u0427\u0438\u0442\u0430\u043B\u0430 \u0457\u0445. \u041F\u0440\u043E\u0435\u043A\u0442
      \"\u0421\u043E\u043D\u0446\u0435\" \u043C\u0430\u0454 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043E\u0434\u043D\u0443 \u043C\u0435\u0442\u0443 - \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F.
      \u0417\u0431\u0440\u043E\u044F \u0442\u0430\u043A\u043E\u0457 \u0441\u0438\u043B\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435 \u043F\u0456\u0442\u0438 \u043D\u0430
      \u0431\u043B\u0430\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823808
    m_Localized: "\u0411\u0443\u0434\u044C-\u044F\u043A\u0430 \u0437\u0431\u0440\u043E\u044F
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0430
      \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0430\u0431\u043E
      \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u0441\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823809
    m_Localized: "\u041F\u043E\u0433\u043B\u044F\u043D\u044C \u043D\u0430\u0432\u043A\u043E\u043B\u043E,
      @lp. \u0411\u0430\u0447\u0438\u0448? \u0426\u0435 - \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0438
      \"\u0441\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u043D\u043D\u044F\". \u041A\u043E\u043B\u0438\u0441\u044C
      \u043F\u043E\u043D\u0456 \u0434\u0443\u043C\u0430\u043B\u0438 - \u0449\u043E
      \u0431\u0456\u043B\u044C\u0448\u0456 \u0432 \u043D\u0438\u0445 \u0433\u0430\u0440\u043C\u0430\u0442\u0438,
      \u0442\u043E \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0435 \u0457\u043C
      \u0431\u0443\u0434\u0435 \u0436\u0438\u0442\u0438. \u0422\u0435\u043F\u0435\u0440
      \u0436\u043C\u0435\u043D\u044C\u043A\u0430 \u0457\u0445\u043D\u0456\u0445 \u043D\u0430\u0449\u0430\u0434\u043A\u0456\u0432
      \u0432\u0438\u0436\u0438\u0432\u0430\u0454 \u043D\u0430 \u043E\u0431\u0432\u0443\u0433\u043B\u0435\u043D\u0438\u0445
      \u0440\u0435\u0448\u0442\u043A\u0430\u0445 \u0442\u043E\u0433\u043E, \u0449\u043E
      \u0442\u0456 \u043F\u043E\u043D\u0456 \u043D\u0430\u0437\u0438\u0432\u0430\u043B\u0438
      \u0434\u043E\u043C\u0456\u0432\u043A\u043E\u044E. \u041D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0446\u0435\u0439 \u0442\u0430\u043A \u0437\u0432\u0430\u043D\u0438\u0439
      \"\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\" \u0432\u0456\u0440\u0438\u0442\u044C
      \u0443 \u0431\u043B\u0430\u0433\u0443 \u043C\u0435\u0442\u0443 \u0446\u044C\u043E\u0433\u043E
      \u043F\u0440\u043E\u0454\u043A\u0442\u0443, \u043F\u0456\u0434\u0441\u0443\u043C\u043E\u043A
      \u0443\u0441\u0435 \u043E\u0434\u043D\u043E \u0431\u0443\u0434\u0435 \u043E\u0434\u0438\u043D.
      \u0406 \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u0437\u0433\u0438\u043D\u0435
      \u0440\u0430\u0437\u043E\u043C \u0437 \u0443\u0441\u0456\u043C, \u0447\u043E\u0433\u043E
      \u0432\u0441\u0442\u0438\u0433\u043D\u0435 \u0442\u043E\u0440\u043A\u043D\u0443\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823810
    m_Localized: "\u0426\u044C\u043E\u043C\u0443 \u0441\u0432\u0456\u0442\u0443,
      \u0446\u0438\u043C \u043F\u043E\u043D\u0456 \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0437\u0431\u0440\u043E\u0457,
      @lp. \u0407\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0436\u0438\u0442\u0438.
      \u0416\u0438\u0442\u0438 \u0456 \u043F\u0440\u043E\u0446\u0432\u0456\u0442\u0430\u0442\u0438.
      \u0425\u0456\u0431\u0430 \u043D\u0435 \u0432 \u0446\u044C\u043E\u043C\u0443
      \u043D\u0430\u0448\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F?
      \u041C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438
      \u0442\u0438\u043C \u0431\u0456\u0434\u043D\u0438\u043C \u043F\u043E\u043D\u0456,
      \u0437\u0435\u0431\u0440\u0430\u043C \u0442\u0430 \u0456\u043D\u0448\u0438\u043C
      \u0440\u0430\u0441\u0430\u043C, \u0449\u043E \u0436\u0438\u0432\u0443\u0442\u044C
      \u0442\u0443\u0442, \u0430 \u043D\u0435 \u0432\u0431\u0438\u0432\u0430\u0442\u0438
      \u0457\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823811
    m_Localized: "\u041D\u0435 \u0432\u0441\u0456 \u043F\u043E\u043D\u0456 \u0433\u043E\u0442\u043E\u0432\u0456
      \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443,
      \u0412\u0435\u043B\u044C\u0432\u0435\u0442. \u041D\u0435\u0432\u0436\u0435
      \u0442\u0438 \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u0431\u0430\u0447\u0438\u0448?
      \u0410\u0434\u0436\u0435 \u0442\u0438 \u0431\u0443\u043B\u0430 \u0432 \u043F\u043E\u043B\u043E\u043D\u0456
      \u0443 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432,
      \u0442\u0438 \u0437\u043D\u0430\u0454\u0448 \u0446\u0435! \u042F\u043A \u0432\u043E\u043D\u0438
      \u0437 \u0442\u043E\u0431\u043E\u044E \u043E\u0431\u0456\u0439\u0448\u043B\u0438\u0441\u044F?
      \u042F\u043A \u0432\u043E\u043D\u0438 \u043F\u043E\u0432\u043E\u0434\u044F\u0442\u044C\u0441\u044F
      \u0437 \u0443\u0441\u0456\u043C\u0430, \u0445\u0442\u043E \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u0454
      \u0432 \u0457\u0445\u043D\u0456 \u043A\u043E\u043F\u0438\u0442\u0430? \u041F\u043E\u0437\u0431\u0443\u0434\u044C\u0441\u044F
      \u0437\u0431\u0440\u043E\u0457, \u0456 \u0442\u0438 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0448
      \u0441\u0432\u043E\u0457 \u0434\u043D\u0456 \u0432 \u0440\u0430\u0431\u0441\u044C\u043A\u0438\u0445
      \u043A\u043E\u043B\u043E\u0434\u043A\u0430\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823812
    m_Localized: "\u0404 \u0441\u043F\u043E\u0441\u043E\u0431\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438
      \u0441\u0435\u0431\u0435 \u0456 \u0431\u0435\u0437 \u043F\u0440\u043E\u0454\u043A\u0442\u0443
      \"\u0421\u043E\u043D\u0446\u0435\", @lp. \u0421\u0442\u043E\u043B\u0456\u0442\u0442\u044F\u043C\u0438
      \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u0436\u0438\u043B\u043E
      \u0431\u0435\u0437 \u043D\u044C\u043E\u0433\u043E, \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F
      \u043F\u0440\u043E\u0436\u0438\u0432\u0435 \u0439 \u0434\u0430\u043B\u0456.
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043B\u0438\u0448\u0435
      \u0440\u043E\u0431\u0438\u0442\u044C \u0433\u0456\u0440\u0448\u0435 \u0456
      \u043D\u0430\u043C, \u0456 \u0441\u043E\u0431\u0456, \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0447\u0438\u0441\u044C
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0446\u0435\u0439 \u0437\u043B\u043E\u0432\u0456\u0441\u043D\u0438\u0439
      \u043F\u0440\u043E\u0454\u043A\u0442 \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823813
    m_Localized: "\u0422\u0438 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u0456\u0434\u043A\u0438\u0434\u0430\u0454\u0448 \u0443\u0441\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u0456
      \u0434\u043E\u0432\u043E\u0434\u0438 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430.
      \u0427\u043E\u043C\u0443 \u0442\u0438 \u0432\u0432\u0430\u0436\u0430\u0454\u0448,
      \u0449\u043E \u0446\u044F \u0437\u0431\u0440\u043E\u044F \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0430
      \u0434\u043B\u044F \u044F\u043A\u043E\u0457\u0441\u044C \u0432\u0438\u0449\u043E\u0457
      \u043C\u0435\u0442\u0438? \u0429\u043E \u0442\u0438 \u0437\u043D\u0430\u0454\u0448
      \u043F\u0440\u043E \u0457\u0457 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F?
      \u0423 \u0442\u0438\u0445 \u0441\u0445\u0435\u043C\u0430\u0445 \u043F\u0440\u043E
      \u0446\u0435 \u043D\u0435 \u0431\u0443\u043B\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E
      \u043D\u0456\u0447\u043E\u0433\u043E, \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823814
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435 \u0442\u0430\u043A. \u0410\u043B\u0435
      \u0443 \u0437\u0431\u0440\u043E\u0457 \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438
      \u043B\u0438\u0448\u0435 \u043E\u0434\u043D\u0430 \u043C\u0435\u0442\u0430
      - \u0432\u0431\u0438\u0432\u0430\u0442\u0438. \u0406 \u044F\u043A \u0431\u0438
      \u0457\u0457 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0438 \u043D\u0435
      \u0432\u0432\u0430\u0436\u0430\u043B\u0438 \u0441\u0435\u0431\u0435 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043A\u0430\u043C\u0438,
      \u0432\u043E\u043D\u0438 \u0440\u0430\u043D\u043E \u0447\u0438 \u043F\u0456\u0437\u043D\u043E
      \u0442\u0435\u0436 \u0441\u0442\u0430\u044E\u0442\u044C \u0443\u0431\u0438\u0432\u0446\u044F\u043C\u0438.
      \u0406\u043D\u0448\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0456\u0432
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u043C\u0443
      \u0411\u043E\u0433\u0438\u043D\u044F\u043C\u0438 \u0441\u0432\u0456\u0442\u0456
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0431\u0443\u0432\u0430\u0454.
      \u042F \u0442\u0443\u0442 \u0434\u043E\u0432\u0448\u0435, \u043D\u0456\u0436
      \u0442\u0438, @lp, \u044F \u0437\u043D\u0430\u044E \u0446\u0435. \u042F \u0431\u0430\u0447\u0443
      \u0446\u0435 \u0449\u043E\u0434\u043D\u044F. \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C \u0442\u0430\u043A \u0441\u0430\u043C\u043E.
      \u0406 \u043F\u043E\u0442\u044F\u0433\u043D\u0435 \u0437\u0430 \u0441\u043E\u0431\u043E\u044E
      \u0456\u043D\u0448\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823815
    m_Localized: "\u0410 \u0449\u043E, \u044F\u043A\u0449\u043E \u0432\u0441\u0435
      \u0431\u0443\u0434\u0435 \u043D\u0435 \u0442\u0430\u043A? \u0429\u043E, \u044F\u043A\u0449\u043E
      \u0437\u0431\u0440\u043E\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438 \u0437\u043B\u043E \u0446\u044C\u043E\u0433\u043E
      \u0441\u0432\u0456\u0442\u0443? \u041F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438
      \u0427\u0435\u0440\u0432\u043E\u043D\u0435 \u041E\u043A\u043E, \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438
      \u0411\u043E\u0433\u0438\u043D\u044E? \u0425\u0456\u0431\u0430 \u043D\u0435
      \u0441\u0442\u0430\u043B\u043E \u0431 \u0432\u0456\u0434 \u0446\u044C\u043E\u0433\u043E
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457 \u043A\u0440\u0430\u0449\u0435?
      \u0422\u0456\u043B\u044C\u043A\u0438 \u0443\u044F\u0432\u0438, \u0449\u043E
      \u043F\u043E\u043D\u0456, \u044F\u043A\u0438\u043C \u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u0448,
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438\u043C\u0435
      \u0434\u043E\u043B\u044F \u043F\u043E\u043C\u0435\u0440\u0442\u0438 \u0440\u0430\u0431\u043E\u043C
      \u0430\u0431\u043E \u0441\u0442\u0430\u0442\u0438 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u043E\u043C.
      \u0425\u0456\u0431\u0430 \u0437\u0430 \u0442\u0430\u043A\u0438\u0439 \u0441\u0432\u0456\u0442
      \u043D\u0435 \u0432\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u0431
      \u043F\u043E\u0431\u043E\u0440\u043E\u0442\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823816
    m_Localized: "\u0422\u0438 \u0434\u0443\u0436\u0435 \u043D\u0430\u0457\u0432\u043D\u0430,
      @lp. \u0423\u0441\u044F \u0437\u0431\u0440\u043E\u044F, \u043A\u043E\u0436\u0435\u043D
      \u043A\u0430\u0440\u0430\u0431\u0456\u043D \u0456 \u043D\u0456\u0436, \u0449\u043E
      \u0431\u0443\u043B\u0438 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0456 \u0432
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457, \u0431\u0443\u043B\u0438
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0456 \u0437\u0430\u0440\u0430\u0434\u0438
      \u0442\u0456\u0454\u0457 \u0441\u0430\u043C\u043E\u0457 \u043C\u0435\u0442\u0438,
      \u043F\u0440\u043E \u044F\u043A\u0443 \u0442\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0448
      \u0437\u0430\u0440\u0430\u0437. \u0417\u0430\u0440\u0430\u0434\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0443.
      \u0406 \u0449\u043E\u0440\u0430\u0437\u0443 \u0432\u043E\u043D\u0438 \u0437\u0430\u0437\u043D\u0430\u0432\u0430\u043B\u0438
      \u043D\u0435\u0432\u0434\u0430\u0447\u0456 \u0456 \u0440\u043E\u0431\u0438\u043B\u0438
      \u043B\u0438\u0448\u0435 \u0433\u0456\u0440\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823817
    m_Localized: "\u0410\u043B\u0435 \u0446\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u043C\u0438 \u0437\u043D\u0430\u0454\u043C\u043E \u0446\u0456\u043D\u0443
      \u043F\u043E\u043C\u0438\u043B\u0446\u0456, \u0412\u0435\u043B\u044C\u0432\u0435\u0442!
      \u0426\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043C\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u043C\u043E,
      \u0437\u0430\u0440\u0430\u0434\u0438 \u0447\u043E\u0433\u043E \u0432\u043E\u044E\u0454\u043C\u043E
      \u0456 \u0447\u043E\u043C\u0443 \u0445\u043E\u0447\u0435\u043C\u043E \u0437\u0430\u043F\u043E\u0431\u0456\u0433\u0442\u0438.
      \u0422\u0456 \u043F\u043E\u043D\u0456, \u0449\u043E \u0436\u0438\u043B\u0438
      \u0442\u043E\u0434\u0456, \u043D\u0435 \u0437\u043D\u0430\u043B\u0438 \u0446\u044C\u043E\u0433\u043E.
      \u0406 \u0442\u043E\u043C\u0443 \u0432\u043E\u043D\u0438 \u043F\u043E\u043C\u0435\u0440\u043B\u0438.
      \u042F \u0432\u0456\u0440\u044E \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0443.
      \u042F \u0432\u0456\u0440\u044E, \u0449\u043E \u0432\u0456\u043D \u0440\u043E\u0437\u0443\u043C\u0456\u0454,
      \u0447\u043E\u0433\u043E \u0445\u043E\u0447\u0435 \u0434\u043E\u043C\u043E\u0433\u0442\u0438\u0441\u044F.
      \u0420\u043E\u0437\u0443\u043C\u0456\u0454 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u0440\u0430\u0449\u0435, \u043D\u0456\u0436 \u044F \u0447\u0438 \u0442\u0438.
      \u0406 \u0449\u043E \u0432\u0456\u043D \u043D\u0435 \u0431\u0443\u0434\u0435
      \u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0437\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823818
    m_Localized: "\u042F \u043D\u0435 \u043C\u043E\u0436\u0443 \u043F\u043E\u0433\u043E\u0434\u0438\u0442\u0438\u0441\u044F
      \u0437 \u0442\u043E\u0431\u043E\u044E, @lp. \u0423 \u0442\u0435\u0431\u0435
      \u0441\u0432\u043E\u044F \u043F\u0440\u0430\u0432\u0434\u0430, \u0443 \u043C\u0435\u043D\u0435
      - \u0441\u0432\u043E\u044F. \u042F \u043B\u0438\u0448\u0435 \u043C\u043E\u0436\u0443
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0442\u0438\u0441\u044F, \u0449\u043E
      \u043F\u0440\u0430\u0432\u0430 \u0442\u0438, \u0430 \u043D\u0435 \u044F. \u0422\u043E\u043C\u0443
      \u0449\u043E \u044F \u043D\u0435 \u0437\u043C\u043E\u0436\u0443 \u0442\u0435\u0431\u0435
      \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438, \u044F\u043A\u0449\u043E
      \u0432\u0441\u0435 \u043F\u0456\u0434\u0435 \u043D\u0435 \u0442\u0430\u043A,
      \u044F\u043A \u0442\u0438 \u043F\u0440\u0438\u043F\u0443\u0441\u043A\u0430\u043B\u0430.
      \u0410\u043B\u0435 \u044F \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u0435
      \u043F\u0440\u043E \u043E\u0434\u043D\u0443 \u0440\u0456\u0447. \u041F\u043E\u043E\u0431\u0456\u0446\u044F\u0439
      \u043C\u0435\u043D\u0456, \u0449\u043E \u044F\u043A\u0449\u043E \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u043E\u0431\u0434\u0443\u0440\u0438\u0442\u044C \u0442\u0432\u043E\u0457 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F,
      \u0442\u0438 \u043D\u0435 \u0434\u0430\u0441\u0438 \u0439\u043E\u043C\u0443
      \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043F\u043E\u0433\u0430\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823819
    m_Localized: "\u041E\u0431\u0456\u0446\u044F\u044E. \u042F \u0437\u043D\u0430\u044E,
      \u0449\u043E \u0432\u0456\u043D \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
