  - m_Id: 2742018268
    m_Localized: "(\u041F): \u042F \u0434\u0443\u043C\u0430\u044E, \u0432\u0441\u0456
      \u0432\u0436\u0435 \u043E\u0437\u043D\u0430\u0439\u043E\u043C\u043B\u0435\u043D\u0456
      \u0437 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C \u0434\u0435\u043D\u043D\u0438\u043C
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456\u0448\u043D\u044C\u043E\u0433\u043E
      \u0441\u043B\u0443\u0445\u0430\u043D\u043D\u044F. \u041F\u0440\u043E\u0448\u0443
      \u043D\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0442\u0438 \u0434\u0430\u0440\u0435\u043C\u043D\u043E
      \u0447\u0430\u0441. \u041B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442\u0435,
      \u0432\u0430\u043C \u0441\u043B\u043E\u0432\u043E.\n\u041B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442
      \u0421\u0430\u043C\u043C\u0435\u0440 \u041B\u0456\u0444 \u0437\u0430\u0447\u0438\u0442\u0443\u0454
      \u0442\u0435\u043A\u0441\u0442 \u0441\u0432\u043E\u0433\u043E \u0432\u0438\u0441\u0442\u0443\u043F\u0443
      (\u0442\u0435\u043A\u0441\u0442 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0456\u0439
      \u0442\u0435\u043C\u0430\u0442\u0438\u0446\u0456).\n(\u041C): \u0420\u0430\u0434\u0438\u0439
      \u0431\u0443\u0432 \u043F\u043E\u0447\u0443\u0442\u0438 \u0446\u0435, \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442\u0435.
      \u0425\u043E\u0447 \u0443 \u043A\u043E\u0433\u043E\u0441\u044C \u0443 \u0446\u0456\u0439
      \u0434\u0456\u0440\u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0441\u044F \u0442\u0432\u0435\u0440\u0435\u0437\u0438\u0439
      \u043F\u043E\u0433\u043B\u044F\u0434 \u043D\u0430 \u0441\u0432\u0456\u0442.\n(\u041F):
      \u041F\u043E\u043F\u0440\u043E\u0448\u0443 \u0431\u0435\u0437 \u0437\u043D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u043E\u0433\u043E
      \u0437\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F, \u043C\u0430\u0439\u043E\u0440\u0435.\n(\u041C):
      \u0410 \u0442\u043E \u0449\u043E, \u0434\u0440\u0456\u0431\u043D\u0438\u0439?
      \u0411\u043E\u0441\u043E\u0432\u0456 \u0441\u043A\u0430\u0440\u0433\u0443 \u043D\u0430\u043F\u0438\u0448\u0435\u0448?\n(\u0421):
      \u041F\u043E\u043B\u0435\u0433\u0448\u0435, \u041A\u043E\u043A\u0441\u0435!
      \u041E\u0445\u0440\u0435\u043D\u0456\u0432 \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0456\u044E
      \u043F\u043E\u0440\u0443\u0448\u0443\u0432\u0430\u0442\u0438? \u042F \u0442\u043E\u0431\u0456
      \u043D\u0430\u0433\u0430\u0434\u0430\u044E, \u0434\u043E \u043A\u043E\u0433\u043E
      \u0442\u0438 \u0437\u0432\u0435\u0440\u0442\u0430\u0454\u0448\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0442\u0440\u0435\u0431\u0430.\n(\u041C): \u042F
      \u0442\u043E\u0431\u0456 \u0449\u0430 \u0442\u0432\u043E\u044E \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0456\u044E
      \u043D\u0430\u0433\u0430\u0434\u0430\u044E, \u0442\u0438, \u043C\u0443\u0434\u0435\u043D\u044C.\n(\u041F):
      \u041F\u0440\u0438\u043F\u0438\u043D\u0438\u043B\u0438 \u043D\u0435\u0433\u0430\u0439\u043D\u043E!
      \u0412\u0438 - \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0438, \u0456
      \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454\u0442\u0435 \u043D\u0435
      \u0432 \u043F\u0438\u0432\u043D\u0456\u0439 \u0431\u0456\u043B\u044F \u041D\u0435\u0439\u0432\u0430\u0440\u0440\u043E!
      \u0429\u043E \u0437\u0430 \u0433\u0430\u043D\u0435\u0431\u043D\u0430 \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0430!\n(\u0414):
      \u041F\u043E\u043F\u0440\u043E\u0448\u0443 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438
      \u043B\u0430\u0439\u043A\u0443, \u043F\u0430\u043D\u043E\u0432\u0435. \u041D\u0430\u043C
      \u0449\u0435 \u0437\u0434\u0438\u0447\u0430\u0432\u0456\u043B\u0438\u0445 \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438.\n(\u041C):
      \u0422\u0430 \u0447\u043E\u0433\u043E \u0457\u0445 \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456? \u0422\u0438 \u0432\u0441\u0435
      \u043F\u043E \u0441\u043F\u0440\u0430\u0432\u0456 \u0441\u043A\u0430\u0437\u0430\u0432.
      \u041F\u0443\u0441\u043A\u0430\u0454\u043C\u043E \u0457\u0445 \u043D\u0430
      \u0434\u043E\u0441\u043B\u0456\u0434\u0438 \u0456 \u0432\u0441\u0435.\n(\u0421):
      \u0422\u0435\u0431\u0435 \u0431 \u043D\u0430 \u0434\u043E\u0441\u043B\u0456\u0434\u0438
      \u043F\u0443\u0441\u0442\u0438\u0442\u0438, \u0421\u0430\u0444\u0444\u0435\u0440.\n(\u041C):
      \u0420\u043E\u0442 \u0441\u0432\u0456\u0439 \u0437\u0430\u0432\u0430\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018269
    m_Localized: "(\u041F): \u042F \u0449\u0435 \u0440\u0430\u0437 \u0437\u0430\u043A\u043B\u0438\u043A\u0430\u044E
      \u0432\u0441\u0456\u0445 \u0434\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443!
      \u0421\u0435\u0440\u0436\u0430\u043D\u0442\u0435, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0432\u0438 \u043F\u0440\u043E\u0442\u0438
      \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457 \u0421\u0430\u043C\u043C\u0435\u0440
      \u041B\u0456\u0444\u0430. \u041F\u043E\u0442\u0440\u0443\u0434\u0456\u0442\u044C\u0441\u044F
      \u043E\u0431\u0491\u0440\u0443\u043D\u0442\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043E\u044E
      \u043F\u043E\u0437\u0438\u0446\u0456\u044E.\n(\u0421): \u0412\u0438 \u0442\u0430\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u044E\u0454\u0442\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0441\u043F\u0456\u0439\u043C\u0430\u043D\u0438\u0445
      \u0430\u0431\u043E\u0440\u0438\u0433\u0435\u043D\u0456\u0432 \u044F\u043A \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438\u0445
      \u0449\u0443\u0440\u0456\u0432, \u043D\u0456\u0431\u0438 \u0437\u0430\u0431\u0443\u043B\u0438,
      \u0449\u043E \u0432\u043E\u043D\u0438 \u043A\u043E\u043B\u0438\u0441\u044C
      \u0431\u0443\u043B\u0438 \u0441\u0445\u043E\u0436\u0456 \u043D\u0430 \u043D\u0430\u0441!\n(\u0414):
      \u041A\u043B\u044E\u0447\u043E\u0432\u0435 \u0441\u043B\u043E\u0432\u043E \"\u043A\u043E\u043B\u0438\u0441\u044C\",
      \u0422\u0430\u043D\u0434\u0435\u0440. \u0422\u0438 \u0441\u0430\u043C \u043D\u0435
      \u0440\u0430\u0437 \u0431\u0430\u0447\u0438\u0432, \u043D\u0430 \u0449\u043E
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044F
      \u043C\u0456\u0441\u0446\u0435\u0432\u0456 \u0436\u0438\u0442\u0435\u043B\u0456.
      \u0412\u043E\u043D\u0438 \u043D\u0435 \u043C\u0430\u044E\u0442\u044C \u0436\u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u0440\u0430\u0432\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438\u0441\u044F
      \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u043C\u0438 \u0456\u0441\u0442\u043E\u0442\u0430\u043C\u0438,
      \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u043E\u043F\u0440\u0438 \u0442\u0435,
      \u0449\u043E \u0432\u043E\u043D\u0438 \u0437\u0434\u0430\u0442\u043D\u0456
      \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u0443 \u0437\u0431\u0440\u043E\u044E.\n(\u0421):
      \u0422\u0432\u0456\u0439 \u0441\u043D\u043E\u0431\u0456\u0437\u043C \u043D\u0435
      \u043C\u0430\u0454 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0438. \u0422\u0430\u043A,
      \u0431\u0430\u0433\u0430\u0442\u043E \u0445\u0442\u043E \u0437 \u043D\u0438\u0445
      \u0437\u0434\u0438\u0447\u0430\u0432\u0456\u043B\u0438, \u0430\u043B\u0435
      \u0446\u0435 \u043D\u0435 \u043F\u0440\u0438\u0440\u0456\u0432\u043D\u044E\u0454
      \u0457\u0445 \u0434\u043E \u0442\u0432\u0430\u0440\u0438\u043D.\n(\u041F):
      \u042F \u0440\u043E\u0437\u0443\u043C\u0456\u044E \u0432\u0430\u0448\u0443
      \u0441\u0438\u043C\u043F\u0430\u0442\u0456\u044E \u0434\u043E \u0456\u0441\u0442\u043E\u0442,
      \u044F\u043A\u0456 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C
      \u0441\u0445\u043E\u0436\u0438\u043C\u0438 \u043D\u0430 \u043D\u0430\u0441,
      \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u0435. \u041E\u0434\u043D\u0430\u043A
      \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0437\u0430\u0443\u0432\u0430\u0436\u0438\u0442\u0438,
      \u0449\u043E \u0432\u0456\u0434\u043C\u043E\u0432\u0430 \u0432\u0456\u0434
      \u0432\u0438\u0437\u043D\u0430\u043D\u043D\u044F \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445
      \u0430\u0431\u043E\u0440\u0438\u0433\u0435\u043D\u0456\u0432 \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u043C\u0438
      \u0437\u0430\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0435 \u043D\u0430
      \u0441\u043D\u043E\u0431\u0456\u0437\u043C\u0456, \u0430 \u043D\u0430 \u043D\u0430\u0443\u043A\u043E\u0432\u0438\u0445
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F\u0445 \u0456
      \u0444\u0430\u043A\u0442\u0430\u0445. \u0414\u0432\u0456\u0441\u0442\u0456
      \u0440\u043E\u043A\u0456\u0432 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0456\u0457
      \u0442\u0430 \u0437\u0434\u0438\u0447\u0430\u0432\u0456\u043D\u043D\u044F \u0432
      \u0443\u043C\u043E\u0432\u0430\u0445 \u0435\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u043E
      \u0432\u043E\u0440\u043E\u0436\u043E\u0433\u043E \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0430
      \u043F\u043E\u0437\u0431\u0430\u0432\u0438\u043B\u0438 \u0457\u0445 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u043F\u043E\u0434\u043E\u0431\u0438 \u0446\u0438\u0432\u0456\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u043E\u0441\u0442\u0456.
      \u0412\u043E\u043D\u0438 \u043D\u0435 \u043C\u0430\u044E\u0442\u044C \u0440\u0456\u0432\u043D\u0438\u0445
      \u043D\u0430\u043C \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0435\u0439,
      \u043D\u0430 \u043D\u0438\u0445 \u043D\u0435 \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0440\u0456\u0432\u043D\u0430 \u043D\u0430\u043C \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C.
      \u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E, \u0432\u043E\u043D\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0443\u0442\u0438
      \u0440\u0456\u0432\u043D\u0438\u043C\u0438 \u043D\u0430\u043C \u0456 \u0432
      \u043F\u0440\u0430\u0432\u0430\u0445.\n(\u041C): \u041F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043C\u043E\u0432\u043A\u043D\u0438 \u0432\u0436\u0435.\n(\u0414):
      \u041F\u0430\u043D\u0435 \u043C\u0430\u0439\u043E\u0440\u0435, \u0437\u0430
      \u0432\u0441\u0456\u0454\u0457 \u043F\u043E\u0432\u0430\u0433\u0438, \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F \u0432\u0432\u0430\u0436\u0430\u044E \u0432\u0430\u0448\u0443 \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0443
      \u043D\u0435\u0434\u043E\u0440\u0435\u0447\u043D\u043E\u044E.\n(\u0421): \u042F
      \u043D\u0435 \u0437\u0430\u043C\u043E\u0432\u043A\u043D\u0443! \u0422\u0430\u043A,
      \u0432\u0438 \u043C\u0430\u0454\u0442\u0435 \u0440\u0430\u0446\u0456\u044E,
      \u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A\u0443, \u0432\u043E\u043D\u0438
      \u043D\u0430\u043C \u043D\u0435 \u0440\u0456\u0432\u043D\u044F. \u0410\u043B\u0435
      \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0430\u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E!
      \u0425\u0456\u0431\u0430 \u0442\u044F\u0433\u0430\u0440 \u0446\u0438\u0432\u0456\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u043F\u0435\u0433\u0430\u0441\u0430 \u043D\u0435 \u0432 \u0442\u043E\u043C\u0443,
      \u0449\u043E\u0431 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u0434\u0438\u043A\u0443\u043D\u0456\u0432
      \u041F\u0443\u0441\u0442\u043A\u0438 \u043D\u0430\u0437\u0430\u0434 \u0434\u043E
      \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u0433\u043E \u0441\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u0430?
      \u0425\u0456\u0431\u0430 \u043C\u0438 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0456,
      \u0437\u0430\u0432\u043E\u044E\u0432\u0430\u0432\u0448\u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E,
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0457\u043C \u043A\u043E\u043B\u0438\u0448\u043D\u044E
      \u043F\u043E\u0434\u043E\u0431\u0443? \u0410\u0434\u0436\u0435 \u0441\u0430\u043C\u0435
      \u043F\u0440\u043E \u0446\u0435 \u043D\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0432\u0434\u043E\u043C\u0430, \u0445\u0456\u0431\u0430 \u043D\u0435 \u0442\u0430\u043A?\n(\u041C):
      \u0411\u0445\u0430\u0445\u0430\u0445! \u0422\u0438 \u0442\u0430\u043A\u0438\u0439
      \u0456\u0434\u0456\u043E\u0442, \u0422\u0430\u043D\u0434\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018270
    m_Localized: "(\u0414): \u0421\u0435\u0440\u0436\u0430\u043D\u0442 \u0422\u0430\u043D\u0434\u0435\u0440
      \u043C\u0430\u0454 \u0440\u0430\u0446\u0456\u044E, \u0441\u0430\u043C\u0435
      \u0442\u0430\u043A\u043E\u044E \u0431\u0443\u043B\u0430 \u043D\u0430\u0448\u0430
      \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0430 \u043C\u0435\u0442\u0430
      \u0442\u0443\u0442. \u041E\u0434\u043D\u0430\u043A \u043D\u0430\u0448\u0456
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E \u0437\u043C\u0456\u043D\u0438\u043B\u0438
      \u0432 \u043D\u0430\u0448\u043E\u043C\u0443 \u0431\u0430\u0447\u0435\u043D\u043D\u0456
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457. \u0417 \u043E\u0433\u043B\u044F\u0434\u0443
      \u043D\u0430 \u043D\u043E\u0432\u043E\u0432\u0438\u044F\u0432\u043B\u0435\u043D\u0456
      \u043E\u0431\u0441\u0442\u0430\u0432\u0438\u043D\u0438 \u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E \u0437\u0430\u0440\u0430\u0437
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438, \u0447\u0438 \u0431\u0443\u0434\u0435
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0441\u0445\u0432\u0430\u043B\u0435\u043D\u0430
      \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0430 \u043A\u043E\u043B\u043E\u043D\u0456\u0437\u0430\u0446\u0456\u044F
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456. \u042F \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u044E
      \u0441\u0430\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0438 \u043D\u0430\u0434 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u043C\u0438
      \u043D\u0435 \u0437\u0430\u0440\u0430\u0434\u0438 \u0446\u0456\u043A\u0430\u0432\u043E\u0441\u0442\u0456,
      \u0430 \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u043F\u043E\u043D\u0456.
      \u041C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E \u0437\u043D\u0430\u0439\u0442\u0438
      \u0432\u0456\u0440\u043D\u0456 \u0441\u043F\u043E\u0441\u043E\u0431\u0438 \u043F\u0440\u043E\u0442\u0438\u0441\u0442\u043E\u044F\u0442\u0438
      \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u043C \u0445\u0432\u043E\u0440\u043E\u0431\u0430\u043C
      \u0456 \u041F\u043E\u0440\u0447\u0456, \u043D\u0435 \u0432\u0438\u0432\u0447\u0438\u0432\u0448\u0438
      \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445 \u0457\u0445\u043D\u044E
      \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0443 \u0432 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0456.\n(\u041F):
      \u0417\u0440\u0435\u0448\u0442\u043E\u044E \u0446\u0435 \u043F\u0456\u0434\u0435
      \u043D\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u044C \u0441\u0430\u043C\u0438\u043C
      \u0430\u0431\u043E\u0440\u0438\u0433\u0435\u043D\u0430\u043C.\n(\u0421): \u0412\u0438
      \u0432\u0441\u0456 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0442\u0435,
      \u0449\u043E \u0432\u0441\u044C\u043E\u0433\u043E \u043B\u0438\u0448\u0435
      \u0432\u0438\u043F\u0440\u0430\u0432\u0434\u043E\u0432\u0443\u0454\u0442\u0435
      \u0441\u0432\u0456\u0439 \u0441\u0442\u0440\u0430\u0445 \u0456 \u0441\u0432\u043E\u044E
      \u0431\u0430\u0439\u0434\u0443\u0436\u0456\u0441\u0442\u044C. \u041C\u043E\u0436\u043D\u0430
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0439 \u0456\u043D\u0448\u0456 \u0441\u043F\u043E\u0441\u043E\u0431\u0438
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u043B\u0456\u043A\u0456\u0432.\n(\u0414):
      \u0406 \u044F\u043A\u0456 \u0436, \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u0435?\n(\u0421):
      \u042F \u0437\u0432\u0456\u0434\u043A\u0438 \u0437\u043D\u0430\u044E?! \u041C\u0438
      \u044F\u043A\u043E\u0441\u044C \u043B\u0456\u043A\u0443\u0454\u043C\u043E\u0441\u044F
      \u0443 \u0441\u0435\u0431\u0435 \u0431\u0435\u0437 \u0434\u043E\u0441\u043B\u0456\u0434\u0456\u0432
      \u043D\u0430\u0434 \u043F\u0435\u0433\u0430\u0441\u0430\u043C\u0438!\n(\u041C):
      \u0426\u0435 \u044F\u043A\u0438\u0439\u0441\u044C \u0444\u0430\u0440\u0441.
      \u0427\u043E\u043C\u0443 \u043C\u0438 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u0441\u043B\u0443\u0445\u0430\u0454\u043C\u043E \u044F\u043A\u043E\u0433\u043E\u0441\u044C
      \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u0438\u0448\u043A\u0443?\n(\u041F):
      \u041F\u043E\u0434\u0456\u0431\u043D\u0456 \u0437\u0430\u044F\u0432\u0438 \u043D\u0435
      \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u043F\u0440\u0438\u0439\u043C\u0430\u0442\u0438\u0441\u044F
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E, \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u0435.
      \u041F\u043E\u043A\u0438 \u0449\u043E \u044F \u043D\u0435 \u0431\u0430\u0447\u0443
      \u0436\u043E\u0434\u043D\u043E\u0457 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457
      \u043F\u0440\u043E\u0442\u0438 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457
      \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442\u0430 \u0421\u0430\u043C\u043C\u0435\u0440
      \u041B\u0456\u0444\u0430.\n(\u0421): \u0410\u0431\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0435
      \u0431\u0430\u0447\u0438\u0442\u0438. \u0420\u0430\u043D\u043E \u0447\u0438
      \u043F\u0456\u0437\u043D\u043E \u043F\u0440\u043E \u0432\u0430\u0448\u0456
      \u0434\u0456\u0457 \u0442\u0443\u0442 \u0434\u0456\u0437\u043D\u0430\u0454\u0442\u044C\u0441\u044F
      \u0441\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u043E!\n(\u041C):
      \u0422\u0438 \u0446\u0435 \u043D\u0430\u043C \u043F\u043E\u0433\u0440\u043E\u0436\u0443\u0454\u0448
      \u0447\u0438 \u0449\u043E, \u0432\u0438\u0440\u043E\u0434\u043A\u0443?! \u0410
      \u043D\u0443 \u0439\u0434\u0438 \u0441\u044E\u0434\u0438.\n\u0414\u0430\u043B\u0456
      \u0439\u0434\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u0430 \u0431\u0456\u0439\u043A\u0430
      \u043C\u0456\u0436 \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u043E\u043C \u0422\u0430\u043D\u0434\u0435\u0440\u043E\u043C
      \u0456 \u043C\u0430\u0439\u043E\u0440\u043E\u043C \u0421\u0430\u0444\u0444\u0435\u0440\u043E\u043C.
      \u041E\u0431\u0438\u0434\u0432\u0430 \u0443\u0447\u0430\u0441\u043D\u0438\u043A\u0438
      \u0447\u0432\u0430\u0440\u0438 \u0431\u0443\u043B\u0438 \u0443\u0441\u043F\u0456\u0448\u043D\u043E
      \u0432\u0442\u0438\u0445\u043E\u043C\u0438\u0440\u0435\u043D\u0456 \u0456\u043D\u0448\u0438\u043C\u0438
      \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u043C\u0438 \u043D\u0430 \u0441\u043B\u0443\u0445\u0430\u043D\u043D\u0456
      \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u043A\u0456\u043B\u044C\u043A\u043E\u0445
      \u0445\u0432\u0438\u043B\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018271
    m_Localized: "(\u041F): \u0426\u0435 \u043E\u0431\u0443\u0440\u043B\u0438\u0432\u043E!
      \u041F\u0430\u043D\u0435 \u043C\u0430\u0439\u043E\u0440\u0435, \u043F\u0440\u043E
      \u0432\u0430\u0448\u0443 \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0443
      \u0431\u0443\u0434\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043E
      \u0443 \u0432\u0438\u0449\u0456 \u0456\u043D\u0441\u0442\u0430\u043D\u0446\u0456\u0457!
      \u042F \u043E\u0433\u043E\u043B\u043E\u0448\u0443\u044E \u0432\u0430\u043C
      \u0434\u043E\u0433\u0430\u043D\u0443 \u0456\u0437 \u0437\u0430\u043D\u0435\u0441\u0435\u043D\u043D\u044F\u043C
      \u0432 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0443 \u0441\u043F\u0440\u0430\u0432\u0443!\n(\u041C):
      \u0422\u0430 \u043F\u0456\u0434\u0456\u0442\u0440\u0438\u0441\u044C \u043D\u0438\u043C\u0438!\n(\u0414):
      \u0414\u043E\u0441\u0438\u0442\u044C! \u041F\u0430\u043D\u0435 \u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A\u0443,
      \u0437 \u043E\u0433\u043B\u044F\u0434\u0443 \u043D\u0430 \u043E\u0431\u0441\u0442\u0430\u0432\u0438\u043D\u0438,
      \u0449\u043E \u0441\u043A\u043B\u0430\u043B\u0438\u0441\u044F, \u044F \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u044E
      \u0443\u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F \u0432\u0456\u0434
      \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u043E\u043B\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F.\n(\u041F):
      \u041F\u0440\u0438\u0439\u043D\u044F\u0442\u043E. \u0426\u0438\u043C \u043E\u0433\u043E\u043B\u043E\u0448\u0443\u044E,
      \u0449\u043E \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044E \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442\u0430
      \u0421\u0430\u043C\u043C\u0435\u0440 \u041B\u0456\u0444\u0430 \u043F\u0440\u043E
      \u0441\u0430\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0432\u0430\u043D\u043D\u044F
      \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0456\u0432
      \u043D\u0430\u0434 \u043F\u043E\u043B\u043E\u043D\u0435\u043D\u0438\u043C\u0438
      \u0430\u0431\u043E\u0440\u0438\u0433\u0435\u043D\u0430\u043C\u0438 \u0443\u0445\u0432\u0430\u043B\u0435\u043D\u043E
      \u0456 \u043B\u044F\u0436\u0435 \u0432 \u043E\u0441\u043D\u043E\u0432\u0443
      \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u043E\u0433\u043E \u0440\u043E\u0437\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F.
      \u041E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u043B\u044F
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0432\u0441\u0456\u043C\u0430
      \u0447\u043B\u0435\u043D\u0430\u043C\u0438 \u0431\u0430\u0437\u0438, \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u0435!\n(\u0421):
      \u0412\u0438 \u043F\u043E\u0448\u043A\u043E\u0434\u0443\u0454\u0442\u0435 \u043F\u043E\u0442\u0456\u043C
      \u043F\u0440\u043E \u0446\u0435 \u0440\u0456\u0448\u0435\u043D\u043D\u044F,
      \u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A\u0443. \u041D\u0435
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u043D\u0435, \u043D\u0456, \u044F
      \u043D\u0435 \u043F\u043E\u0433\u0440\u043E\u0436\u0443\u044E \u0432\u0430\u043C.
      \u0410\u043B\u0435 \u0456\u0441\u0442\u043E\u0440\u0456\u044F \u0437\u0434\u0456\u0439\u0441\u043D\u0438\u0442\u044C
      \u0441\u0432\u0456\u0439 \u0441\u0443\u0434.\n(\u041F): \u041D\u0430 \u0446\u044C\u043E\u043C\u0443
      \u0446\u0435 \u0441\u043B\u0443\u0445\u0430\u043D\u043D\u044F \u043E\u0433\u043E\u043B\u043E\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018272
    m_Localized: "*\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0443 3 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0457
      \u043B\u0430\u043D\u043A\u0438 \u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u0447\u0443
      \u043F\u0435\u0440\u0448\u043E\u044E \u0435\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0456\u0439\u043D\u043E\u044E
      \u0433\u0440\u0443\u043F\u043E\u044E\n\u0413\u0435\u043D\u0435\u0440\u0430\u043B-\u043C\u0430\u0439\u043E\u0440\u0443
      \u0420\u0410\u0412\n\u0421\u0430\u0439\u043B\u0435\u043D\u0442 \u041A\u043B\u0430\u0443\u0434\u0443\n\n\u0420\u0410\u041F\u041E\u0420\u0422\n\u0421\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C
      \u0434\u043E\u0432\u043E\u0434\u0436\u0443 \u0434\u043E \u0412\u0430\u0448\u043E\u0433\u043E
      \u0432\u0456\u0434\u043E\u043C\u0430, \u0449\u043E \u043C\u043D\u043E\u044E
      \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438
      \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0433\u043E \u0430\u043D\u0430\u043B\u0456\u0437\u0443
      \u043F\u043E\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u0443
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0442\u0430 \u043F\u0440\u0438\u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0435\u0432\u043E\u0433\u043E
      \u0448\u0430\u0440\u0443 \u0491\u0440\u0443\u043D\u0442\u0443 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0432\u0430\u043D\u043E\u0457
      \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u0457. \u041F\u043E\u0432\u043D\u0438\u0439
      \u0442\u0435\u043A\u0441\u0442 \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u0446\u044C\u043A\u043E\u0457
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0431\u0443\u0434\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E
      \u0412\u0430\u043C \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u0442\u0440\u044C\u043E\u0445
      \u0434\u0456\u0431 \u0437 \u043C\u043E\u043C\u0435\u043D\u0442\u0443 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044F
      \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F,
      \u043E\u0434\u043D\u0430\u043A \u0437\u043C\u0443\u0448\u0435\u043D\u0438\u0439
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0442\u0438, \u0449\u043E
      \u0457\u0457 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043D\u0435
      \u043E\u0431\u043D\u0430\u0434\u0456\u044E\u0454. \u0417\u0433\u0456\u0434\u043D\u043E
      \u0437 \u043E\u0446\u0456\u043D\u043A\u0430\u043C\u0438 \u043D\u0430\u0448\u0438\u0445
      \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u0446\u044C\u043A\u0438\u0445
      \u043C\u0456\u0441\u0456\u0439, \u0442\u0435\u043F\u0435\u0440\u0456\u0448\u043D\u0456\u0439
      \u0440\u0456\u0432\u0435\u043D\u044C \u0437\u0430\u0431\u0440\u0443\u0434\u043D\u0435\u043D\u043D\u044F
      \u043D\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044F\u0454
      \u0432\u0438\u0441\u0443\u043D\u0443\u0442\u0438\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C
      \u0432\u0438\u043C\u043E\u0433\u0430\u043C. \u0423\u043C\u043E\u0432\u0438
      \u043F\u0440\u043E\u0436\u0438\u0432\u0430\u043D\u043D\u044F \u043D\u0435\u0441\u043F\u0440\u0438\u044F\u0442\u043B\u0438\u0432\u0456
      \u0434\u043B\u044F \u0436\u0438\u0442\u0442\u044F, \u0434\u043B\u044F \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0433\u043E
      \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0438\u0441\u043E\u043A\u0456
      \u0432\u0438\u0442\u0440\u0430\u0442\u0438 \u043D\u0430 \u0444\u0456\u043B\u044C\u0442\u0440\u0430\u0446\u0456\u0439\u043D\u0435
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0442\u0430 \u0456\u0437\u043E\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0456
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438. \u0411\u0430 \u0431\u0456\u043B\u044C\u0448\u0435,
      \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E \u0432\u0441\u044F \u0430\u0434\u0430\u043F\u0442\u043E\u0432\u0430\u043D\u0430
      \u0434\u043E \u0436\u0438\u0442\u0442\u044F \u0432 \u0442\u0430\u043A\u0438\u0445
      \u0435\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u0438\u0445
      \u0443\u043C\u043E\u0432\u0430\u0445 \u0444\u043B\u043E\u0440\u0430 \u0456
      \u0444\u0430\u0443\u043D\u0430, \u0432\u043A\u043B\u044E\u0447\u043D\u043E
      \u0437 \u043A\u043E\u043B\u0438\u0441\u044C \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u043C\u0438
      \u0432\u0438\u0434\u0430\u043C\u0438 \u0437\u0435\u043C\u043D\u043E\u043F\u043E\u043D\u0456
      \u0442\u0430 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432,
      \u043F\u0435\u0440\u0435\u0439\u0448\u043B\u0430 \u0434\u043E \u0445\u0438\u0436\u0430\u0446\u044C\u043A\u043E\u0433\u043E
      \u0441\u043F\u043E\u0441\u043E\u0431\u0443 \u0436\u0438\u0442\u0442\u044F \u0456
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0443
      \u0437\u0430\u0433\u0440\u043E\u0437\u0443 \u0434\u043B\u044F \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0439\u043D\u0438\u0445
      \u043A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0456\u0432. \u0412\u0438\u0442\u0440\u0430\u0442\u0438
      \u043D\u0430 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F
      \u0457\u0445\u043D\u044C\u043E\u0457 \u0431\u0435\u0437\u043F\u0435\u043A\u0438
