      m_Items: []
  - m_Id: 2737825309
    m_Localized: "\u041F\u0440\u043E\u043F\u043E\u043D\u0443\u044E \u0433\u0440\u043E\u0448\u043E\u0432\u0443
      \u0432\u0438\u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443 \u0442\u0438\u043C
      \u043F\u043E\u043D\u0456, \u0449\u043E \u0433\u043E\u0442\u043E\u0432\u0456
      \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E
      \u043F\u0440\u043E \u0440\u0435\u0446\u0435\u043F\u0442\u0438 \u0441\u0432\u044F\u0442\u043A\u043E\u0432\u0438\u0445
      \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A, \u0441\u0442\u0430\u043C\u043F\u0456\u0434\u0443
      \u0442\u0430 \u0443\u043B\u044C\u0442\u0440\u0430-\u0434\u0435\u0448\u0443.
      \u0421\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0435 \u043E\u0433\u043E\u043B\u043E\u0448\u0435\u043D\u043D\u044F
      \u0434\u043B\u044F \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u0456\u0432 \u043F\u043E\u0436\u0430\u0440\u0442\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u043E \u043B\u0456\u043A\u0430\u0440\u0456\u0432-\u043D\u0430\u0440\u043A\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432:
      \u041A\u043B\u0456\u043D\u0456\u043A\u0430 \u0414\u043E\u043A\u0430 \u0421\u0435\u043F\u0441\u0438\u0441\u0443
      \u043D\u0435 \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0454 \u0437\u043D\u0438\u0436\u043E\u043A
      \u043F\u0430\u0446\u0456\u0454\u043D\u0442\u0430\u043C, \u0447\u0438\u0457
      \u0442\u0440\u0430\u0432\u043C\u0438 \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u043E\u043C
      \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0443 \u0437 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u043E\u043C
      \u043A\u043B\u0456\u043D\u0456\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825310
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0435\u0446\u0435\u043F\u0442
      \u0443\u043B\u044C\u0442\u0440\u0430-\u0434\u0435\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825311
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0435\u0446\u0435\u043F\u0442
      \u0441\u0442\u0430\u043C\u043F\u0456\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825312
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0435\u0446\u0435\u043F\u0442
      \u0441\u0432\u044F\u0442\u043A\u043E\u0432\u0438\u0445 \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825313
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u043A\u043E\u043F\u0456\u0457
      \u0440\u0435\u0446\u0435\u043F\u0442\u0456\u0432 \u0414\u043E\u043A\u0443 \u0439
      \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825314
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825315
    m_Localized: "\u041A\u0443\u043F\u043B\u044E \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0456:
      \u0448\u0442\u0430\u043D\u0433\u0435\u043D\u0446\u0438\u0440\u043A\u0443\u043B\u044C,
      \u0433\u0456\u0434\u0440\u0430\u0432\u043B\u0456\u0447\u043D\u0438\u0439 \u0431\u043E\u043B\u0442\u043E\u0440\u0456\u0437
      \u0456 \u043E\u0441\u0446\u0438\u043B\u043E\u0433\u0440\u0430\u0444. \u0414\u043E\u0431\u0440\u0435
      \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0437\u0430 \u043A\u043E\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825316
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0448\u0442\u0430\u043D\u0433\u0435\u043D\u0446\u0438\u0440\u043A\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825317
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0433\u0456\u0434\u0440\u0430\u0432\u043B\u0456\u0447\u043D\u0438\u0439
      \u0431\u043E\u043B\u0442\u043E\u0440\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825318
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043E\u0441\u0446\u0438\u043B\u043E\u0433\u0440\u0430\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825319
    m_Localized: "\u041F\u0440\u043E \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825320
    m_Localized: "\u0423 \u0442\u0435\u0431\u0435 \u0442\u0443\u0442 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u0456\u0437\u043D\u0438\u0445 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825321
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E, \u0446\u0435
      \u0436 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u044F. \u0410\u043B\u0435
      \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432
      \u0443 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825322
    m_Localized: "\u042F\u043A\u0438\u0445 \u0441\u0430\u043C\u0435? \u041C\u043E\u0436\u0435,
      \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F \u0457\u0445
      \u0434\u0435\u0441\u044C \u0440\u043E\u0437\u0434\u043E\u0431\u0443\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825323
    m_Localized: "\u042F\u043A\u0449\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u0448,
      \u0442\u043E \u0432 \u043E\u0431\u0440\u0430\u0437\u0456 \u043D\u0435 \u0437\u0430\u043B\u0438\u0448\u0443.
      \u0410\u043B\u0435 \u043D\u0435 \u0434\u0443\u043C\u0430\u0439, \u0449\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u043C\u0435\u043D\u0456 \u0440\u0435\u0447\u0456
      \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0439\u0442\u0438 \u0432
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439 \u0448\u0430\u0444\u0456.
      \u0426\u0435 \u043D\u0435 \u044F\u043A\u0456\u0441\u044C \u0442\u0430\u043C
      \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0438. \u041E\u0442\u0436\u0435,
      \u0441\u043B\u0443\u0445\u0430\u0439: \u041F\u043E-\u043F\u0435\u0440\u0448\u0435,
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0448\u0442\u0430\u043D\u0433\u0435\u043D\u0446\u0438\u0440\u043A\u0443\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825324
    m_Localized: "\u0426\u0435 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
      \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825325
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0417
      \u0439\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043C\u043E\u0436\u043D\u0430 \u0442\u043E\u0447\u043D\u043E \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438,
      \u043D\u0443, \u0441\u043A\u0430\u0436\u0456\u043C\u043E, \u0434\u0456\u0430\u043C\u0435\u0442\u0440
      \u0431\u043E\u043B\u0442\u0430 \u0430\u0431\u043E \u0433\u0430\u0439\u043A\u0438.
      \u0421\u043F\u0440\u043E\u0431\u0443\u0439 \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438
      \u043D\u0430 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u043E\u043C\u0443 \u0437\u0430\u0432\u043E\u0434\u0456,
      \u0434\u043E \u0412\u0456\u0439\u043D\u0438 \u0432\u043E\u043D\u0438 \u0442\u0430\u043C
      \u0442\u043E\u0447\u043D\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0438\u0441\u044F.
      \u0410\u043B\u0435 \u043F\u043E\u043A\u0438 \u0449\u043E \u043C\u0435\u043D\u0456
      \u0449\u0435 \u043D\u0456\u0445\u0442\u043E \u0442\u0430\u043A\u043E\u0433\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0439\u0448\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825326
    m_Localized: "\u041F\u043E-\u0434\u0440\u0443\u0433\u0435, \u043C\u0435\u043D\u0456
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0433\u0456\u0434\u0440\u0430\u0432\u043B\u0456\u0447\u043D\u0438\u0439
      \u0431\u043E\u043B\u0442\u043E\u0440\u0456\u0437. \u0426\u0435 \u0442\u0430\u043A\u0430
      \u0448\u0442\u0443\u043A\u0430, \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u044F\u043A\u043E\u0457 \u043C\u043E\u0436\u043D\u0430 \u0437 \u043B\u0435\u0433\u043A\u0456\u0441\u0442\u044E
      \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u0438, \u043D\u0443,
      \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0442\u043E\u0432\u0441\u0442\u0438\u0439
      \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u043F\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825327
    m_Localized: "\u041A\u043E\u0440\u0438\u0441\u043D\u0430, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u0440\u0456\u0447. \u0414\u0435 \u0436 \u0457\u0457 \u043C\u043E\u0436\u043D\u0430
      \u0437\u043D\u0430\u0439\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825328
    m_Localized: "\u041D\u0443, \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0456
      \u043C\u043E\u0436\u0435 \u0442\u0430\u043A\u0438\u0439 \u0431\u0443\u0442\u0438,
      \u043D\u0430\u043F\u0435\u0432\u043D\u043E. \u0410\u043B\u0435 \u0454 \u0449\u0435
      \u043E\u0434\u0438\u043D \u0432\u0430\u0440\u0456\u0430\u043D\u0442. \u0411\u0430\u0433\u0430\u0442\u043E
      \u0440\u043E\u043A\u0456\u0432 \u0442\u043E\u043C\u0443 \u0446\u044F \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u044F
      \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u0430 \u0456\u043D\u0448\u043E\u043C\u0443
      \u043C\u0435\u0445\u0430\u043D\u0456\u043A\u0443. \u042F \u0442\u043E\u0447\u043D\u043E
      \u0437\u043D\u0430\u044E, \u0449\u043E \u0433\u0456\u0434\u0440\u0430\u0432\u043B\u0456\u0447\u043D\u0438\u0439
      \u0431\u043E\u043B\u0442\u043E\u0440\u0456\u0437 \u0443 \u043D\u044C\u043E\u0433\u043E
      \u0431\u0443\u0432. \u0422\u0430 \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0441\u044C
      \u043F\u043E\u043B\u0456\u0437 \u0432\u0456\u043D \u0456\u0437 \u043D\u0438\u043C
      \u044F\u043A\u043E\u0441\u044C \u0443 \u0441\u0442\u0430\u0440\u0443 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044E,
      \u043D\u0435 \u0437\u043D\u0430\u044E \u0432\u0436\u0435 \u043D\u0430\u0432\u0456\u0449\u043E,
      \u043C\u043E\u0436\u0435, \u0445\u043E\u0442\u0456\u0432 \u0440\u043E\u0437\u043A\u0440\u0438\u0442\u0438
      \u044F\u043A\u0443\u0441\u044C \u0440\u0435\u0448\u0456\u0442\u043A\u0443.
      \u0417\u0430\u0433\u0430\u043B\u043E\u043C, \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F
      \u0432\u0456\u043D \u0437\u0432\u0456\u0434\u0442\u0438,"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825329
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043E\u0431\u0456\u0446\u044F\u044E,
      \u044F\u043A\u043E\u0441\u044C \u043D\u0435 \u0442\u044F\u0433\u043D\u0435
      \u043C\u0435\u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E \u043F\u043E\u0434\u0432\u0438\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825330
    m_Localized: "\u0420\u043E\u0437\u0443\u043C\u0456\u044E, \u0443 \u043C\u0435\u043D\u0435
      \u0442\u0435\u0436 \u0442\u0430\u043A\u043E\u0433\u043E \u0431\u0430\u0436\u0430\u043D\u043D\u044F
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0432\u0438\u043D\u0438\u043A\u0430\u043B\u043E.
      \u041C\u043E\u0436\u0435, \u0449\u0435 \u0434\u0435\u0441\u044C \u0456\u043D\u0448\u0438\u0439
      \u0437\u043D\u0430\u0439\u0434\u0435\u0448. \u041D\u0443 \u0456, \u043D\u0430\u0440\u0435\u0448\u0442\u0456,
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u043E\u0441\u0446\u0438\u043B\u043E\u0433\u0440\u0430\u0444.
      \u041D\u0443, \u0437\u043D\u0430\u0454\u0448, \u0442\u0430\u043A\u0438\u0439
      \u043F\u0440\u0438\u043B\u0430\u0434 \u0434\u043B\u044F \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F
      \u0440\u0456\u0437\u043D\u0438\u0445 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0456\u0432
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u043E\u0433\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825331
    m_Localized: "\u0422\u0430\u043A, \u0432\u0456\u043D \u0431\u0443\u0432 \u0443
      \u043D\u0430\u0441 \u0443 \u0421\u0442\u0456\u0439\u043B\u0456. \u042F\u043A\u0449\u043E
      \u043D\u0430\u0442\u0440\u0430\u043F\u043B\u044E \u043D\u0430 \u0440\u043E\u0431\u043E\u0447\u0438\u0439
      \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440, \u0442\u043E \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u043F\u0440\u0438\u043D\u0435\u0441\u0443 \u0442\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825332
    m_Localized: "\u041D\u0435\u0441\u0438 \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u0436, \u0449\u043E\u0439\u043D\u043E \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0437\u043D\u0430\u0439\u0434\u0435\u0448. \u042F \u0434\u043E\u0431\u0440\u0435
      \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0437\u0430 \u043A\u043E\u0436\u0435\u043D
      \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0438\u0439 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825333
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0436\u0438\u0440
      \u043A\u0440\u043E\u0442\u043E\u0449\u0443\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825334
    m_Localized: "\u041A\u0443\u043F\u0443\u044E \u0436\u0438\u0440 \u043A\u0440\u043E\u0442\u043E\u0449\u0443\u0440\u0430
      \u0434\u043B\u044F \u0437\u043C\u0430\u0449\u0443\u0432\u0430\u043D\u043D\u044F
      \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0456\u0432, \u0437\u0430
      \u0445\u043E\u0440\u043E\u0448\u043E\u044E \u0446\u0456\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825335
    m_Localized: "\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0438\u0439
      \u0436\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825336
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B\u0438 \"\u041A\u0456\u0431\u0435\u0440\u043F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825337
    m_Localized: "\u0428\u0443\u043A\u0430\u044E \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456
      \u0436\u0443\u0440\u043D\u0430\u043B\u0438 \"\u041A\u0456\u0431\u0435\u0440\u043F\u043E\u043D\u0456\".
      \u0412\u043E\u043D\u0438 \u0434\u0443\u0436\u0435 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456,
      \u0432\u0438\u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u0441\u044C\u043E\u0433\u043E
      \u043E\u0434\u0438\u043D \u0440\u0456\u043A \u0456 \u043C\u0430\u043B\u0438\u043C
      \u0442\u0438\u0440\u0430\u0436\u0435\u043C. \u0417\u0430\u043F\u043B\u0430\u0447\u0443
      \u0437\u0430 \u043A\u043E\u0436\u0435\u043D, \u0430\u043B\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0430
      \u043F\u043E\u0434\u044F\u043A\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430
      \u0432\u0441\u0456 \u0434\u0432\u0430\u043D\u0430\u0434\u0446\u044F\u0442\u044C
      \u043D\u043E\u043C\u0435\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825338
    m_Localized: "\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456
      \u0436\u0443\u0440\u043D\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825339
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0441\u0442\u0430\u0440\u0456
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043F\u0440\u0438\u043B\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825340
    m_Localized: "\u0417\u0432\u0435\u0440\u043D\u0456\u0442\u044C \u0443\u0432\u0430\u0433\u0443
      \u0442\u0456, \u0445\u0442\u043E \u0437\u0430\u0439\u043C\u0430\u0454\u0442\u044C\u0441\u044F
      \u043E\u0431\u043D\u0438\u0448\u043F\u043E\u0440\u044E\u0432\u0430\u043D\u043D\u044F\u043C
      \u0443\u0441\u0456\u043B\u044F\u043A\u0438\u0445 \u0440\u0443\u0457\u043D \u0456
      \u0437\u0432\u0430\u043B\u0438\u0449! \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u0441\u0442\u0430\u0440\u0456 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043F\u0440\u0438\u043B\u0430\u0434\u0438,
      \u0437 \u044F\u043A\u0438\u0445 \u043C\u043E\u0436\u043D\u0430 \u0434\u043E\u0431\u0443\u0442\u0438
      \u043A\u043E\u0440\u0438\u0441\u043D\u0456 \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0438,
      \u043C\u043E\u0436\u043D\u0430 \u0437\u043B\u0430\u043C\u0430\u043D\u0456,
      \u0430\u043B\u0435 \u043D\u0435 \u0442\u0430\u043A \u0449\u043E\u0431 \u0437\u043E\u0432\u0441\u0456\u043C
      \u0443 \u043C\u043E\u0442\u043B\u043E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825341
    m_Localized: "\u0412\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825342
    m_Localized: "\u041D\u0430\u0441\u0442\u0456\u043B\u044C\u043D\u0456 \u043B\u0430\u043C\u043F\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825343
    m_Localized: "\u041A\u0430\u0432\u043E\u0432\u0430\u0440\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825344
    m_Localized: "\u0412\u0456\u0434\u043D\u0435\u0441\u0442\u0438 \u0432\u0441\u0435
      \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0435 \u0431\u0430\u0440\u0430\u0445\u043B\u043E
      \u0412\u0456\u043D\u0440\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825345
    m_Localized: "\u0411\u043E\u043B\u0442\u0438 \u0442\u0430 \u0433\u0430\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825346
    m_Localized: "\u041D\u0430\u0431\u0440\u0438\u0434\u043B\u043E \u0432\u0438\u043A\u0440\u0443\u0447\u0443\u0432\u0430\u0442\u0438
      \u0456\u0440\u0436\u0430\u0432\u0456 \u0431\u043E\u043B\u0442\u0438 \u0456
      \u0433\u0430\u0439\u043A\u0438 \u0437\u0456 \u0441\u0442\u0430\u0440\u0438\u0445
      \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440\u0456\u0432, \u043E\u0445\u043E\u0447\u0435
      \u043A\u0443\u043F\u043B\u044E \u043D\u043E\u0432\u0456. \u0422\u0456\u043B\u044C\u043A\u0438
      \u043D\u0435 \u0437\u0434\u0443\u043C\u0430\u0439\u0442\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438
      \u043F\u043E \u043E\u0434\u043D\u0456\u0439 \u0433\u0430\u0439\u0446\u0456,
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u043E\u0434\u0440\u0430\u0437\u0443
      \u0446\u0456\u043B\u0438\u0439 \u044F\u0449\u0438\u043A. \u0422\u0430\u043A\u0456
      \u0440\u0435\u0447\u0456, \u043F\u043E \u0456\u0434\u0435\u0457, \u043C\u043E\u0436\u043D\u0430
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0434\u0435\u0441\u044C \u043D\u0430
      \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u0437\u0430\u0432\u043E\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825347
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u044F\u0449\u0438\u043A \u0456\u0437
      \u043D\u043E\u0432\u0438\u043C\u0438 \u0431\u043E\u043B\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825348
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u044F\u0449\u0438\u043A \u0456\u0437
      \u043D\u043E\u0432\u0438\u043C\u0438 \u0433\u0430\u0439\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825349
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0432\u0441\u0435 \u0412\u0456\u043D\u0440\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825350
    m_Localized: "\u0426\u0456\u043D\u043D\u0456\u0441\u0442\u044C \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825351
    m_Localized: "\u0428\u0443\u043A\u0430\u044E \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0443
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u044E \u043D\u0430
      \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432. \u0425\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0431\u043E\u0457\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0432 \u0441\u0445\u043E\u0432\u0438\u0449\u0435 \u0434\u0430\u043D\u0438\u0445
      \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430
      - \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0430 \u0431\u0443\u0434\u0435
      \u0433\u0456\u0434\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825352
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0441\u0445\u043E\u0432\u0438\u0449\u0435
      \u0434\u0430\u043D\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825353
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0431\u0430\u0437\u0443 \u0434\u0430\u043D\u0438\u0445
      \u043F\u0430\u0440\u043E\u043B\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825354
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u0442\u0438 \u0445\u0430\u043A\u0435\u0440\u0441\u044C\u043A\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825355
    m_Localized: "\u0417\u043B\u0430\u043C\u0430\u0442\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0439
      \u0441\u0435\u0440\u0432\u0435\u0440 \u0456 \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E
      \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825356
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0434\u0438\u0441\u043A
      \u0456\u0437 \u0434\u0430\u043D\u0438\u043C\u0438 \u0412\u0456\u043D\u0440\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825357
    m_Localized: "\u0406\u043D\u0442\u0435\u0440\u0435\u0441 \u0434\u043E \u0440\u043E\u0431\u043E\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825358
    m_Localized: "\u0421\u043A\u0430\u0436\u0438, @lp, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0454\u0448\u0441\u044F
      \u0437\u0456 \u0437\u043B\u043E\u043C\u043E\u043C \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825359
    m_Localized: "\u042F \u0434\u043E\u0441\u0438\u0442\u044C \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044F,
      \u0430 \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825360
    m_Localized: "\u0420\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u044F \u0442\u0440\u043E\u0445\u0438
      \u0437\u0430\u0445\u043E\u043F\u043B\u044E\u044E\u0441\u044F \u0432\u0441\u0456\u043C,
      \u0449\u043E \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u043E \u0437 \u0440\u043E\u0431\u043E\u0442\u0430\u043C\u0438.
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043C\u0435\u043D\u0435 \u0446\u0456\u043A\u0430\u0432\u043B\u044F\u0442\u044C
      \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0438. \u041D\u0443,
      \u0437\u043D\u0430\u0454\u0448 \u0442\u0430\u043A\u0438\u0445? \u0426\u0435
      \u0440\u043E\u0431\u043E\u0442\u0438, \u0441\u0445\u043E\u0436\u0456 \u043D\u0430
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0445 \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825361
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825362
    m_Localized: "\u0412\u043E\u043D\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u043F\u043E\u0432\u043E\u0434\u044F\u0442\u044C\u0441\u044F \u0434\u0435\u0449\u043E
      \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u043E. \u0410\u043B\u0435
      \u0436 \u0446\u0435 \u043D\u0435 \u0457\u0445\u043D\u044F \u0432\u0438\u043D\u0430!
      \u0420\u0430\u043D\u0456\u0448\u0435 \u0432\u043E\u043D\u0438 \u043D\u0435
      \u0431\u0443\u043B\u0438 \u0442\u0430\u043A\u0438\u043C\u0438. \u0422\u0438
      \u0437\u043D\u0430\u0454\u0448, \u0449\u043E \u0457\u0445 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u043B\u0438 \u044F\u043A \u043D\u043E\u0441\u0456\u0457\u0432
      \u041F\u0417, \u0449\u043E \u0441\u0438\u043C\u0443\u043B\u044E\u0454 \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0443
      \u043F\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825363
    m_Localized: "\u041D\u0456, \u043D\u0435 \u0437\u043D\u0430\u044E. \u0426\u0435
      \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825364
    m_Localized: "\u0422\u0430\u043A. \u0412\u043E\u043D\u0438 \u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u0432\u043A\u0440\u0430\u0439 \u0440\u0456\u0434\u043A\u043E \u043D\u0430
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456\u0448\u043D\u0456\u0439 \u0434\u0435\u043D\u044C,
      \u043F\u0440\u043E\u0442\u0435 \u0434\u043E \u0412\u0456\u0439\u043D\u0438
      \u0431\u0443\u043B\u0438 \u043C\u0456\u0441\u0446\u044F, \u0434\u0435 \u0457\u0445
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0438
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0431\u0430\u0433\u0430\u0442\u043E.
      \u0406 \u044F \u0447\u0443\u043B\u0430, \u0449\u043E \u0442\u0438 \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043B\u0430
      \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438 \u0432 \u043E\u0434\u043D\u0435
      \u0421\u0442\u0456\u0439\u043B\u043E \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0456\u043A
      \u0432\u0456\u0434 \u043D\u0430\u0448\u043E\u0433\u043E \u0442\u0430\u0431\u043E\u0440\u0443,
      \u0432 \u044F\u043A\u043E\u043C\u0443, \u044F\u043A\u0449\u043E \u0432\u0456\u0440\u0438\u0442\u0438
      \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A\u0430\u043C, \u043F\u043E\u0432\u043D\u043E
      \u0440\u0456\u0437\u043D\u0438\u0445 \u0440\u043E\u0431\u043E\u0442\u0456\u0432.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435\u0448
      \u0442\u0430\u043C \u0456 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018048
    m_Localized: "\u0427\u0438 \u043C\u043E\u0433\u043B\u043E \u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u0442\u0430\u043A, \u0449\u043E \u0440\u043E\u0431\u043E\u0442\u0438 \u0446\u044C\u043E\u0433\u043E
      \u0421\u0442\u043E\u0439\u043B\u0430 \u0432\u0431\u0438\u043B\u0438 \u0439\u043E\u0433\u043E
      \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018049
    m_Localized: "\u0426\u0435 \u0446\u0456\u043B\u043A\u043E\u043C \u043C\u043E\u0436\u043B\u0438\u0432\u043E.
      \u0410\u043B\u0435 \u0437\u0430 \u0434\u0430\u0432\u043D\u0456\u0441\u0442\u044E
      \u0440\u043E\u043A\u0456\u0432 \u043D\u0456\u0445\u0442\u043E \u043D\u0435
      \u043C\u043E\u0436\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018050
    m_Localized: "\u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u044F \u0445\u043E\u0447\u0443 \u043F\u043E\u0431\u0456\u043B\u044C\u0448\u0435
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u043F\u0440\u043E \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432.
      \u0422\u0430\u043A \u0447\u0438 \u0456\u043D\u0430\u043A\u0448\u0435, \u0446\u0435
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454 \u0434\u0438\u0432\u043E \u0442\u0435\u0445\u043D\u0456\u043A\u0438.
      \u042F\u043A\u0431\u0438 \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430\u0432\u0447\u0438\u0442\u0438\u0441\u044F
      \u0457\u0445 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018051
    m_Localized: "\u0426\u0435 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u043E?
      \u0406 \u0449\u043E \u0432 \u0442\u0430\u043A\u043E\u043C\u0443 \u0440\u0430\u0437\u0456
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0456\u0434 \u043C\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018052
    m_Localized: "\u0422\u0435\u0445\u043D\u0456\u0447\u043D\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u044F
      \u043D\u0430 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432
      \u0456 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
      \u0434\u0430\u043D\u0456 \u043F\u0440\u043E \u043D\u0438\u0445. \u042F \u0442\u0430\u043A
      \u0434\u0443\u043C\u0430\u044E, \u044F\u043A\u0449\u043E \u0421\u0442\u043E\u0439\u043B\u043E
      88 \u0437\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F \u0457\u0445\u043D\u0456\u043C
      \u0432\u0438\u0432\u0447\u0435\u043D\u043D\u044F\u043C, \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438
      \u043C\u0430\u043B\u0438 \u043C\u0456\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0443 \u0441\u0445\u043E\u0432\u0438\u0449\u0456 \u0434\u0430\u043D\u0438\u0445
      \u0421\u0442\u0456\u0439\u043B\u0430. \u0417\u0432\u0456\u0441\u043D\u043E,
      \u0442\u0430\u043C \u0441\u043A\u0440\u0456\u0437\u044C \u043C\u0430\u0454
      \u0441\u0442\u043E\u044F\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0439\u043D\u043E\u0433\u043E
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443, \u0442\u043E\u043C\u0443 \u044F
      \u0439 \u0437\u0430\u043F\u0438\u0442\u0430\u043B\u0430 \u0442\u0435\u0431\u0435
      \u043F\u0440\u043E \u0442\u0432\u043E\u0457 \u0445\u0430\u043A\u0435\u0440\u0441\u044C\u043A\u0456
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018053
    m_Localized: "\u041D\u0443, \u044F, \u0437\u0432\u0456\u0441\u043D\u043E, \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044F...
      \u0410\u043B\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043E\u0431\u0456\u0446\u044F\u0442\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0443. \u0426\u0456\u043B\u043A\u043E\u043C
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0449\u043E \u0437\u0456 \u0437\u043B\u043E\u043C\u043E\u043C
      \u043C\u0435\u043D\u0456 \u043D\u0435 \u0432\u043F\u043E\u0440\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018054
    m_Localized: "\u0423 \u043C\u0435\u043D\u0435 \u0454 \u0442\u0435, \u0449\u043E
      \u0437\u043C\u043E\u0436\u0435 \u0442\u043E\u0431\u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438.
      \u0426\u0435 \u0441\u0445\u0435\u043C\u0430 \u043C\u043E\u0434\u0443\u043B\u044F
      \u0434\u043B\u044F \u041F\u0456\u043F\u0411\u0430\u043A\u0430, \u044F\u043A\u0438\u0439
      \u0437\u043C\u043E\u0436\u0435 \u043F\u043E\u043B\u0435\u0433\u0448\u0438\u0442\u0438
      \u043F\u0440\u043E\u0446\u0435\u0441 \u0437\u043B\u043E\u043C\u0443. \u041E\u0441\u044C,
      \u0442\u0440\u0438\u043C\u0430\u0439. \u042F \u0434\u0443\u043C\u0430\u044E,
      \u0443 \u0442\u0435\u0431\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C
      \u0437\u0456 \u0441\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F\u043C \u0446\u044C\u043E\u0433\u043E
      \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018055
    m_Localized: "\u041E\u0433\u043E, \u043E\u0441\u044C \u0446\u0435 \u043A\u0440\u0443\u0442\u043E!
      \u0414\u044F\u043A\u0443\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018056
    m_Localized: "\u041D\u0435 \"\u0434\u044F\u043A\u0443\u044E\", \u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u044F
      \u043D\u0430 \u0440\u043E\u0431\u043E\u0442\u0456\u0432! \u0423\u0434\u0430\u0447\u0456
      \u0442\u043E\u0431\u0456 \u0442\u0430\u043C, @lp. \u041D\u0435 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018057
    m_Localized: "\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E
      \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018058
    m_Localized: "\u041E\u0441\u044C, \u0442\u0440\u0438\u043C\u0430\u0439 \u0434\u0438\u0441\u043A.
      \u041D\u0430 \u043D\u044C\u043E\u043C\u0443 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
      \u0432\u0438\u0447\u0435\u0440\u043F\u043D\u0430 \u0431\u0430\u0437\u0430 \u0434\u0430\u043D\u0438\u0445
      \u043F\u0440\u043E \u0431\u0443\u0434\u043E\u0432\u0443 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018059
    m_Localized: "\u0412\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u0456!
      \u0412\u0430\u0436\u043A\u043E \u0431\u0443\u043B\u043E \u0439\u043E\u0433\u043E
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018060
    m_Localized: "\u0411\u0443\u0432\u0430\u043B\u043E \u0439 \u0432\u0430\u0436\u0447\u0435.
      \u0429\u043E \u0442\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u0448\u0441\u044F
      \u0440\u043E\u0431\u0438\u0442\u0438 \u0437 \u0446\u0438\u043C\u0438 \u0434\u0430\u043D\u0438\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018061
    m_Localized: "\u0423\u0432\u0430\u0436\u043D\u043E \u0457\u0445 \u0432\u0438\u0432\u0447\u0443,
      \u0437\u0432\u0456\u0441\u043D\u043E \u0436. \u0410 \u043F\u043E\u0442\u0456\u043C
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u044E, \u044F\u043A \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u0446\u0456. \u0412\u0438\u0431\u0430\u0447,
      \u0430\u043B\u0435 \u0434\u0430\u0432\u0430\u0439 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u043E
      \u043F\u043E\u0442\u0456\u043C, \u043C\u0435\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u043E-\u0442\u0430\u043A\u0438
      \u043D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F,
      \u0449\u043E \u0442\u0430\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018062
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u0442\u0438 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0435
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018063
    m_Localized: "\u0428\u0443\u043A\u0430\u044E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0456
      \u043A\u0430\u043C\u0435\u043D\u0456. \u0412\u043E\u043D\u0438 \u0431\u0456\u043B\u044C\u0448\u0456
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456 \u0456 \u043C\u0430\u044E\u0442\u044C
      \u044F\u0441\u043A\u0440\u0430\u0432\u043E \u0432\u0438\u0440\u0430\u0436\u0435\u043D\u0456
      \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456.
      \u0414\u043E\u0431\u0440\u0435 \u0437\u0430\u043F\u043B\u0430\u0447\u0443.
      \u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u0439 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018064
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0441\u043C\u0430\u0440\u0430\u0433\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018065
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0441\u0430\u043F\u0444\u0456\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018066
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0440\u0443\u0431\u0456\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018067
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u043C\u043E\u0440\u0441\u044C\u043A\u0438\u0439 \u0441\u043C\u0430\u0440\u0430\u0433\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018068
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u043A\u0440\u0438\u0436\u0430\u043D\u0438\u0439 \u0441\u0430\u043F\u0444\u0456\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018069
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u0432\u043E\u0433\u043D\u044F\u043D\u0438\u0439 \u0440\u0443\u0431\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018070
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0432\u0441\u0456
      \u043A\u0430\u043C\u0435\u043D\u0456 \u0414\u0430\u0441\u0442\u0456 \u041D\u0435\u0431\u0443\u043B\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018071
    m_Localized: "\u0411\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018072
    m_Localized: "\u041A\u0443\u043F\u0443\u044E \u043D\u0435\u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0456
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043A\u043D\u0438\u0436\u043A\u0438
      \u0437\u0430 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0443 \u0446\u0456\u043D\u0443.
      \u0417\u0456\u0439\u0434\u0443\u0442\u044C \u0431\u0443\u0434\u044C-\u044F\u043A\u0456,
      \u0430\u0431\u0438 \u0457\u0445 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u043B\u043E
      \u0447\u0438\u0442\u0430\u0442\u0438. \u0425\u0442\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u0435
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435, \u043E\u0442\u0440\u0438\u043C\u0430\u0454
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0443 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443.
      \u0427\u0438\u0442\u0430\u043D\u043D\u044F - \u0446\u0435 \u043C\u0430\u0433\u0456\u044F,
      \u0439\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018073
    m_Localized: "\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456
      \u043A\u043D\u0438\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018074
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0432\u0441\u0456 5 \u0442\u043E\u043C\u0456\u0432
      \"\u041D\u0435\u0431\u0435\u0441\u043D\u043E\u0457 \u041C\u0435\u0445\u0430\u043D\u0456\u043A\u0438\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018075
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437
      \u0414\u0430\u0441\u0442\u0456 \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0443 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018076
    m_Localized: "\u0411\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018077
    m_Localized: "\u042F \u0442\u0430\u043A \u043F\u043E\u0433\u043B\u044F\u043D\u0443,
      \u0443 \u0442\u0435\u0431\u0435 \u0442\u0443\u0442 \u0446\u0456\u043B\u0430
      \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018078
    m_Localized: "\u0414\u0435 \u0432\u0436\u0435 \u0442\u0430\u043C... \u041A\u0456\u043B\u044C\u043A\u0430
      \u043F\u043E\u043B\u0438\u0446\u044C \u0456\u0437 \u043A\u043D\u0438\u0436\u043A\u0430\u043C\u0438
      \u0456 \u0432\u0441\u0435. \u0417\u0430\u0440\u0430\u0437 \u043A\u043D\u0438\u0436\u043E\u043A
      \u043D\u0435 \u0432\u0438\u0434\u0430\u044E\u0442\u044C - \u043D\u0456\u043A\u043E\u043C\u0443
      \u0439 \u043D\u0456\u0434\u0435. \u041F\u043E\u043D\u0456 \u043C\u0430\u0439\u0436\u0435
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0446\u0456\u043A\u0430\u0432\u0438\u0442\u0438\u0441\u044F
      \u0432\u0441\u0456\u043C, \u0449\u043E \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454
      \u0457\u043C \u0432\u0438\u0436\u0438\u0432\u0430\u0442\u0438 \u0442\u0443\u0442
      \u0456 \u0437\u0430\u0440\u0430\u0437. \u0410 \u043C\u0430\u0439\u0436\u0435
      \u0432\u0441\u0456 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043A\u043D\u0438\u0436\u043A\u0438
      \u0430\u0431\u043E \u0437\u0433\u043E\u0440\u0456\u043B\u0438, \u0430\u0431\u043E
      \u0437\u0433\u043D\u0438\u043B\u0438 \u0432\u0456\u0434 \u0432\u043E\u0433\u043A\u043E\u0441\u0442\u0456,
      \u0430\u0431\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u043E\u0437\u0441\u0438\u043F\u0430\u044E\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434 \u0447\u0430\u0441\u0443 \u0456 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u043E\u0441\u0442\u0456
      \u0434\u043E\u0433\u043B\u044F\u0434\u0443. \u041D\u0438\u043D\u0456\u0448\u043D\u0456
      \u0447\u0430\u0441\u0438 \u0441\u0443\u0432\u043E\u0440\u0456 \u0434\u043E
      \u0437\u043D\u0430\u043D\u044C, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018079
    m_Localized: "\u0410\u043B\u0435 \u0456\u043D\u043E\u0434\u0456 \u0432 \u0441\u0442\u0430\u0440\u0438\u0445
      \u0440\u0443\u0457\u043D\u0430\u0445 \u043C\u043E\u0436\u0443\u0442\u044C \u0442\u0440\u0430\u043F\u043B\u044F\u0442\u0438\u0441\u044F
      \u0456 \u043C\u0430\u0439\u0436\u0435 \u0446\u0456\u043B\u0456 \u0442\u043E\u043C\u0438.
      \u042F\u043A\u0449\u043E \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u0457\u0445
      \u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0437\u0430
      \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0433\u043E \u0434\u043E\u0433\u043B\u044F\u0434\u0443,
      \u0432\u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u043B\u0443\u0436\u0430\u0442\u044C
      \u0449\u0435 \u043D\u0435 \u043E\u0434\u043D\u0435 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F.
      \u042F \u0432\u0432\u0430\u0436\u0430\u044E \u0446\u0435 \u0441\u0432\u043E\u0457\u043C
      \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u0438\u043C \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u043C.
      \u0414\u0430\u0432\u0430\u0439 \u0434\u043E\u043C\u043E\u0432\u0438\u043C\u043E\u0441\u044F
      - \u044F\u043A\u0449\u043E \u0442\u043E\u0431\u0456 \u0434\u0435-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0442\u0440\u0430\u043F\u043B\u044F\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0446\u0456\u043B\u0456 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043A\u043D\u0438\u0436\u043A\u0438,
      \u043F\u0440\u0438\u043D\u043E\u0441\u044C \u0457\u0445 \u043C\u0435\u043D\u0456.
      \u042F \u0431\u0443\u0434\u0443 \u0442\u043E\u0431\u0456 \u043F\u043B\u0430\u0442\u0438\u0442\u0438
      \u0437\u0430 \u043D\u0438\u0445 \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436
      \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u043A\u043E\u0433\u043E \u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018080
    m_Localized: "\u0414\u043E\u0431\u0440\u0435! \u0420\u0438\u0442\u0438\u043C\u0443\u0441\u044F
      \u0432 \u043A\u043E\u0436\u043D\u0456\u0439 \u043A\u043D\u0438\u0436\u043A\u043E\u0432\u0456\u0439
      \u0448\u0430\u0444\u0456 \u0442\u0430 \u043F\u0438\u0441\u044C\u043C\u043E\u0432\u043E\u043C\u0443
      \u0441\u0442\u043E\u043B\u0456, \u044F\u043A\u0456 \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0443.
      \u041C\u043E\u0436\u0435, \u0442\u0435\u0431\u0435 \u0446\u0456\u043A\u0430\u0432\u0438\u0442\u044C
      \u0449\u043E\u0441\u044C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018081
    m_Localized: "\u0412\u0437\u0430\u0433\u0430\u043B\u0456-\u0442\u043E \u0442\u0430\u043A.
      \u042F \u0434\u0430\u0432\u043D\u043E \u0445\u043E\u0447\u0443 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438
      \"\u041D\u0435\u0431\u0435\u0441\u043D\u0443 \u041C\u0435\u0445\u0430\u043D\u0456\u043A\u0443\"
      \u0432 \u043F'\u044F\u0442\u0438 \u0442\u043E\u043C\u0430\u0445. \u0426\u0435
      \u0447\u0443\u0434\u043E\u0432\u0456 \u043A\u043D\u0438\u0436\u043A\u0438,
      \u0441\u0430\u043C\u0430 \u0421\u043A\u0430\u0440\u043B\u0435\u0442 \u0428\u0430\u0439\u043D
      \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430 \u0432 \u043D\u0438\u0445
      \u0443\u0441\u0435, \u0449\u043E \u0437\u043D\u0430\u043B\u0430 \u043F\u0440\u043E
      \u0440\u0443\u0445 \u043D\u0435\u0431\u0435\u0441\u043D\u0438\u0445 \u0442\u0456\u043B
      \u043D\u0430 \u043D\u0435\u0431\u043E\u0441\u0445\u0438\u043B\u0456! \u0422\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0443\u044F\u0432\u043B\u044F\u0454\u0448,
      \u044F\u043A\u043E\u044E \u0446\u0456\u043D\u043D\u0456\u0441\u0442\u044E \u0432\u043E\u043D\u0438
      \u0431\u0443\u043B\u0438 \u0449\u0435 \u0434\u043E \u0412\u0456\u0439\u043D\u0438,
      \u0430 \u0432\u0436\u0435 \u0437\u0430\u0440\u0430\u0437! \u0410\u043B\u0435
      \u044F \u0442\u0456\u043B\u044C\u043A\u0438 \u0447\u0443\u043B\u0430 \u043F\u0440\u043E
      \u043D\u0438\u0445 \u0456 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430
      \u0437\u0433\u0430\u0434\u043A\u0438 \u0432 \u0456\u043D\u0448\u0438\u0445
      \u043A\u043D\u0438\u0433\u0430\u0445. \u042F\u043A\u0449\u043E \u0437\u043D\u0430\u0439\u0434\u0435\u0448
      \u0457\u0445, \u0442\u043E \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0442\u043E\u043C
      \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0448 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0443
      \u0446\u0456\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018082
    m_Localized: "\u0406 \u0449\u0435: \u0443 \u043C\u0435\u043D\u0435 \u0454 \u043E\u0434\u043D\u0430
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0430 \u043A\u043D\u0438\u0436\u043A\u0430,
      \u044F\u043A\u0430 \u043D\u0430\u043F\u0435\u0432\u043D\u043E \u0431\u0443\u0434\u0435
      \u0442\u043E\u0431\u0456 \u0446\u0456\u043A\u0430\u0432\u0430. \u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432 \u043C\u0435\u043D\u0435 \u0454 \u0434\u0432\u0456 \u0457\u0457 \u043A\u043E\u043F\u0456\u0457.
      \u041E\u0434\u043D\u0443 \u0437 \u043D\u0438\u0445 \u044F \u043F\u043E\u043E\u0431\u0456\u0446\u044F\u043B\u0430
      \u0442\u043E\u043C\u0443, \u0445\u0442\u043E \u0437\u0440\u043E\u0431\u0438\u0442\u044C
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0439 \u0432\u043D\u0435\u0441\u043E\u043A
      \u0443 \u043F\u043E\u043F\u043E\u0432\u043D\u0435\u043D\u043D\u044F \u043C\u043E\u0454\u0457
      \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438. \u0417\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E,
      \u0442\u0438 \u0442\u0435\u0436 \u043C\u043E\u0436\u0435\u0448 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0457\u0457! \u0425\u0456\u0431\u0430 \u0446\u0435 \u043D\u0435 \u0447\u0443\u0434\u043E\u0432\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018083
    m_Localized: "\u0422\u0432\u0456\u0439 \u0432\u043D\u0435\u0441\u043E\u043A \u0443
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438
      \u0431\u0443\u0432 \u043D\u0435\u043E\u0446\u0456\u043D\u0435\u043D\u043D\u0438\u0439,
      @lp. \u042F\u043A \u0456 \u043E\u0431\u0456\u0446\u044F\u043B\u0430, \u043E\u0441\u044C
      \u0442\u0432\u0456\u0439 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439
      \u043F\u0440\u0438\u0437. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0432\u0456\u043D \u0431\u0443\u0434\u0435 \u0442\u043E\u0431\u0456 \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018084
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u0442\u0438 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u0437\u0456\u043B\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018085
    m_Localized: "\u0428\u0443\u043A\u0430\u044E \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u0434\u043B\u044F \u043E\u0434\u043D\u043E\u0433\u043E \u0446\u0456\u043A\u0430\u0432\u043E\u0433\u043E
      \u0437\u0456\u043B\u043B\u044F. \u0425\u0442\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u0437 \u0457\u0445 \u0437\u0431\u043E\u0440\u043E\u043C, \u0442\u043E\u043C\u0443
      \u0432 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443 \u0432\u0456\u0434\u0434\u0430\u043C
      \u0439\u043E\u0433\u043E \u0440\u0435\u0446\u0435\u043F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018086
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u0442\u0438 \u0447\u0430\u0440\u0456\u0432\u043D\u0438\u0439
      \u043F\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018087
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0432\u043E\u0433\u043D\u044F\u043D\u0456
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018088
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0432\u0441\u0435 \u0414\u0430\u0441\u0442\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0440\u0435\u0446\u0435\u043F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018089
    m_Localized: "\u041F\u0440\u043E \u044F\u0431\u043B\u0443\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018090
    m_Localized: "\u0429\u043E \u0442\u0438 \u0437\u043D\u0430\u0454\u0448 \u043F\u0440\u043E
      \u044F\u0431\u043B\u0443\u043A\u0430, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018091
    m_Localized: "\u041F\u0440\u043E \u044F\u0431\u043B\u0443\u043A\u0430? \u0425\u043C...
      \u044F \u0457\u043B\u0430 \u0457\u0445 \u043C\u0430\u0439\u0436\u0435 \u0432\u0441\u0435
      \u0436\u0438\u0442\u0442\u044F, \u0442\u043E\u0436, \u0434\u0443\u043C\u0430\u044E,
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018092
    m_Localized: "\u0423\u0441\u0435 \u0436\u0438\u0442\u0442\u044F, \u043E\u0441\u044C
      \u0442\u0430\u043A \u043E\u0442? \u0410, \u0442\u0430\u043A, \u0442\u0438 \u0436
      \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456
      \u0437\u0433\u0430\u0434\u0443\u0432\u0430\u0432 \u0446\u0435. \u0412\u0438
      \u0436 \u0432\u0438\u0440\u043E\u0449\u0443\u0432\u0430\u043B\u0438 \u0441\u0432\u043E\u0457
      \u044F\u0431\u043B\u0443\u043A\u0430 \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E?
      \u0417\u0430\u0431\u0443\u0434\u044C \u043F\u0440\u043E \u0446\u044E \u0436\u0430\u043B\u044E\u0433\u0456\u0434\u043D\u0443
      \u043F\u043E\u0434\u043E\u0431\u0443! \u0423 \u043D\u0438\u0445 \u043D\u0435\u043C\u0430\u0454
      \u043D\u0456 \u0441\u043C\u0430\u043A\u0443, \u043D\u0456 \u0437\u0430\u043F\u0430\u0445\u0443,
      \u0442\u0430\u043A, \u043E\u0434\u043D\u0430 \u043D\u0430\u0437\u0432\u0430.
      \u042F \u043F\u0440\u043E \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456
      \u044F\u0431\u043B\u0443\u043A\u0430, \u0432\u0438\u0440\u043E\u0449\u0435\u043D\u0456
      \u043D\u0430 \u0441\u0432\u0456\u0436\u043E\u043C\u0443 \u043F\u043E\u0432\u0456\u0442\u0440\u0456,
      \u043F\u0456\u0434 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C \u0441\u043E\u043D\u0446\u0435\u043C.
      \u0422\u0438 \u0437\u043D\u0430\u0454\u0448, \u0449\u043E \u0440\u0430\u043D\u0456\u0448\u0435
      \u043F\u043E\u043D\u0456 \u0440\u043E\u0431\u0438\u043B\u0438 \u0437 \u043D\u0438\u0445
      \u043C\u0430\u0439\u0436\u0435 \u0432\u0441\u0435? \u042F\u043A\u0438\u0445
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0456\u0432
      \u043D\u0435 \u0431\u0443\u043B\u043E: \u044F\u0431\u043B\u0443\u0447\u043D\u0438\u0439
      \u0441\u0438\u0434\u0440, \u044F\u0431\u043B\u0443\u0447\u043D\u0435 \u0432\u0438\u043D\u043E,
      \u044F\u0431\u043B\u0443\u0447\u043D\u0435 \u0432\u0456\u0441\u043A\u0456,
      \u044F\u0431\u043B\u0443\u0447\u043D\u0430 \u0433\u043E\u0440\u0456\u043B\u043A\u0430,
      \u044F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u043B\u0456\u043A\u0435\u0440,
      \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u043A\u0430 \u0437 \u044F\u0431\u043B\u0443\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018093
    m_Localized: "\u041F\u043E\u0447\u0435\u043A\u0430\u0439, \u043F\u043E\u0447\u0435\u043A\u0430\u0439...
      \u0410\u0434\u0436\u0435 \u0446\u0435 \u0432\u0441\u0456 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0456
      \u043D\u0430\u043F\u043E\u0457 \u0437 \u044F\u0431\u043B\u0443\u043A? \u0426\u0435
      \u0456 \u0454 \u0442\u0432\u043E\u0457 \"\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018094
    m_Localized: "\u0410\u043B\u0435 \u0436 \u044F \u0431\u0430\u0440\u043C\u0435\u043D.
      \u041F\u0440\u043E \u0449\u043E \u043C\u0435\u043D\u0456 \u0449\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438,
      \u043F\u0440\u043E \u044F\u0431\u043B\u0443\u0447\u043D\u0456 \u043F\u0438\u0440\u043E\u0433\u0438?
      \u041F\u043E\u0441\u043B\u0443\u0445\u0430\u0439, \u044F \u043A\u043E\u043B\u0435\u043A\u0446\u0456\u043E\u043D\u0443\u044E
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456
      \u043D\u0430\u043F\u043E\u0457 \u0437 \u044F\u0431\u043B\u0443\u043A \u0456
      \u0433\u043E\u0442\u043E\u0432\u0438\u0439 \u0434\u043E\u0431\u0440\u0435 \u0437\u0430
      \u043D\u0438\u0445 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0438.
      \u041F\u0440\u0438\u043D\u043E\u0441\u044C \u043C\u0435\u043D\u0456 \u0432\u0441\u0435,
      \u0449\u043E \u0437\u043D\u0430\u0439\u0434\u0435\u0448, \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0435 \u0437\u0434\u0443\u043C\u0430\u0439 \u0432\u0438\u043F\u0438\u0442\u0438
      \u0441\u0430\u043C\u0430! \u0412\u0441\u0435 \u043E\u0434\u043D\u043E \u0442\u0438
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0437\u0434\u0430\u0442\u043D\u0430
      \u043E\u0446\u0456\u043D\u0438\u0442\u0438 \u0457\u0445\u043D\u0456\u0439 \u0441\u043C\u0430\u043A
      \u0456 \u0431\u0443\u043A\u0435\u0442. \u0410 \u043E\u0441\u044C \u043C\u043E\u0457
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456 \u043F\u043E\u043A\u0443\u043F\u0446\u0456
      \u043E\u0446\u0456\u043D\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018095
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u0454\u0448... \u0422\u0430
      \u044F \u0449\u0435 \u0439 \u043D\u0435 \u043D\u0430 \u0442\u0430\u043A\u0435
      \u0437\u0434\u0430\u0442\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018096
    m_Localized: "\u0420\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018097
    m_Localized: "\u041A\u0443\u043F\u0443\u044E \u0440\u0430\u0440\u0438\u0442\u0435\u0442\u043D\u0438\u0439
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0439 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C
      \u0456\u0437 \u044F\u0431\u043B\u0443\u043A. \u0426\u0456\u043A\u0430\u0432\u0438\u0442\u044C
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0435\u043B\u0456\u0442\u043D\u0430 \u0432\u0438\u043F\u0438\u0432\u043A\u0430,
      \u0432\u0441\u044F\u043A\u0438\u0439 \u0448\u043C\u0443\u0440\u0434\u044F\u043A
      \u0437\u0430\u043B\u0438\u0448\u0442\u0435 \u0441\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018098
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u0441\u0438\u0434\u0440
      \"\u0421\u0442\u0430\u0440\u0430 \u0444\u0435\u0440\u043C\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018099
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0435 \u0432\u0438\u043D\u043E
      \"\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u0437\u0430\u0445\u0456\u0434\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018100
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u043B\u0456\u043A\u0435\u0440
      \"\u0410\u0440\u043E\u043C\u0430\u0442\u0438 \u043B\u0456\u0442\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018101
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0435 \u0432\u0456\u0441\u043A\u0456
      \"\u0414\u0438\u043A\u0438\u0439 \u043F\u0435\u0433\u0430\u0441\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018102
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0430 \u0433\u043E\u0440\u0456\u043B\u043A\u0430
      \"\u041A\u0440\u0438\u0448\u0442\u0430\u043B\u0435\u0432\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018103
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u043A\u0430
      \u0411\u0430\u0431\u0443\u0441\u0456 \u0421\u043C\u0456\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018104
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u0431\u0430\u043B\u044C\u0437\u0430\u043C
      \"\u0414\u0430\u0440 \u043F\u0440\u0438\u0440\u043E\u0434\u0438\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018105
    m_Localized: "\u0413\u0456\u0434\u0440\u043E\u043F\u043E\u043D\u0456\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018106
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0434\u0430\u043D\u0456
      \u043F\u0440\u043E \u0433\u0456\u0434\u0440\u043E\u043F\u043E\u043D\u043D\u0456
      \u0444\u0435\u0440\u043C\u0438 \u0437 \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018107
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0435
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018108
    m_Localized: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
      \u0434\u0430\u043D\u0456 \u043F\u0440\u043E \u0433\u0456\u0434\u0440\u043E\u043F\u043E\u043D\u043D\u0456
      \u0444\u0435\u0440\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018109
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0456
      \u0434\u0430\u043D\u0456 \u043F\u0438\u0441\u0430\u0440\u044E \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018110
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0430
      \u0430\u043B\u0445\u0456\u043C\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018111
    m_Localized: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F \u0420\u043E\u0436\u0435\u0432\u043E\u0457
      \u0425\u043C\u0430\u0440\u0438 \u0441\u0438\u043B\u044C\u043D\u0435, \u044F\u043A
      \u0456 \u0441\u0438\u043B\u044C\u043D\u0430 \u043C\u0430\u0433\u0456\u044F,
      \u0449\u043E \u0439\u043E\u0433\u043E \u043F\u043E\u0440\u043E\u0434\u0438\u043B\u0430.
      \u0426\u044E \u0441\u0438\u043B\u0443 \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u0431\u0440\u0430\u0442\u0438.
      \u0422\u043E\u0433\u043E, \u0445\u0442\u043E \u0437\u0431\u0435\u0440\u0435
      \u0437\u0456\u043F\u0441\u043E\u0432\u0430\u043D\u0456 \u043E\u0441\u0442\u0430\u043D\u043A\u0438
      \u043F\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u044C \u0425\u043C\u0430\u0440\u0438
      \u0456 \u0432\u0456\u0434\u0434\u0430\u0441\u0442\u044C \u043C\u0435\u043D\u0456,
      \u044F \u043D\u0430\u0432\u0447\u0443 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u0457\u0445\u043D\u044E \u043C\u0430\u0433\u0456\u044E \u043D\u0430 \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u0439
      \u0435\u043B\u0456\u043A\u0441\u0438\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018112
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u0441\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018113
    m_Localized: "\u0422\u0435\u043C\u043D\u0430 \u0434\u0443\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018114
    m_Localized: "\u0420\u0456\u0433 \u0432\u0456\u0434\u044C\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018115
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0432\u0441\u0435 \u0417\u0430\u043C\u0431\u0435\u0437\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018116
    m_Localized: "\u0412\u043E\u0434\u043D\u0438\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018117
    m_Localized: "\u0423 \u043D\u0430\u0441 \u043D\u0435\u043C\u0430\u0454 \u0434\u0436\u0435\u0440\u0435\u043B\u0430
      \u0447\u0438\u0441\u0442\u043E\u0457 \u0432\u043E\u0434\u0438. \u0411\u0430\u0433\u0430\u0442\u043E
      \u0445\u0432\u043E\u0440\u043E\u0431 \u043C\u043E\u0457\u0445 \u043F\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0456\u0432
      \u0431\u0435\u0440\u0443\u0442\u044C \u043F\u043E\u0447\u0430\u0442\u043E\u043A
      \u0456\u0437 \u0446\u0456\u0454\u0457 \u043D\u0430\u043F\u0430\u0441\u0442\u0456.
      \u041D\u0430\u0448\u0456 \u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0438
      \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442\u044C \u0437 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u043C\u0438
      \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438, \u043D\u0435 \u0437\u043D\u0430\u0445\u043E\u0434\u044F\u0447\u0438
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u0442\u043E\u0433\u043E
      \u0441\u0442\u0440\u0443\u043C\u043E\u0447\u043A\u0430, \u0456 \u043C\u0438
      \u043C\u043E\u0436\u0435\u043C\u043E \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0442\u0438\u0441\u044F
      \u043B\u0438\u0448\u0435 \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u044E
      \u043C\u0430\u0433\u0456\u044E \u043F\u043E\u043D\u0456 - \u0432\u043E\u0434\u043D\u0456
      \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D\u0438, \u0449\u043E \u0437\u0434\u0430\u0442\u043D\u0456
      \u0432\u0438\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u0431\u0440\u0443\u0434 \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0432\u043E\u0434\u0438. \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442
      \u0431\u0443\u0432 \u0441\u0435\u0440\u0446\u0435\u043C \u043A\u0440\u0430\u0457\u043D\u0438
      \u043F\u043E\u043D\u0456, \u0456 \u0442\u0430\u043C \u0431\u0443\u043B\u0438
      \u0437\u0456\u0431\u0440\u0430\u043D\u0456 \u043D\u0435\u0437\u043B\u0456\u0447\u0435\u043D\u043D\u0456
      \u0431\u0430\u0433\u0430\u0442\u0441\u0442\u0432\u0430. \u0422\u043E\u0439,
      \u0445\u0442\u043E \u043D\u0430\u0432\u0430\u0436\u0438\u0442\u044C\u0441\u044F
      \u043F\u0443\u0441\u0442\u0438\u0442\u0438\u0441\u044F \u043D\u0430 \u043F\u043E\u0448\u0443\u043A\u0438
      \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D\u0430 \u0456 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0437 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u043E\u044E, \u0434\u0430\u0441\u0442\u044C
      \u043D\u0430\u043C \u043D\u043E\u0432\u0443 \u043D\u0430\u0434\u0456\u044E
      \u043D\u0430 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018118
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0432\u043E\u0434\u043D\u0438\u0439
      \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018119
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0432\u043E\u0434\u043D\u0438\u0439
      \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D \u0417\u0430\u043C\u0431\u0435\u0437\u0456
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018120
    m_Localized: "\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E
      \u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A \u041C2"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018121
    m_Localized: "\u0423 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u043C\u0443 \u043E\u0444\u0456\u0441\u0456
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0421\u0442\u0438\u043B\u044E,
      \u044F\u043A\u0435 \u0432 \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443
      \u0440\u043E\u0437\u0440\u043E\u0431\u0438\u043B\u043E \u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A,
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u0441\u0435 \u0449\u0435
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u044F\u043A\u0430\u0441\u044C
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E
      \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F \u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A\u0430
      \u041C2 (\u0434\u0440\u0443\u0433\u0430 \u043C\u043E\u0434\u0435\u043B\u044C,
      \u0437\u043D\u0430\u0447\u043D\u043E \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0456\u0448\u0430
      \u0437\u0430 \u043F\u0435\u0440\u0448\u0443). \u0414\u043E\u0431\u0440\u0435
      \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
      \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456 \u0434\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018122
    m_Localized: "\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456
      \u0434\u0430\u043D\u0456 \u043F\u0440\u043E \u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A
      \u041C2"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018123
    m_Localized: "\u041C\u043E\u0442\u0438\u0432\u0430\u0442\u043E\u0440\u0438 RX-47"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018124
    m_Localized: "\u041D\u0430\u0440\u0430\u0437\u0456 \u0456\u0441\u043D\u0443\u0454
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456\u0441\u0442\u044C \u0443
      \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0430\u0445 \u0434\u043E
      \u0440\u043E\u0431\u043E\u0442\u0456\u0432, \u0430 \u0441\u0430\u043C\u0435
      \u043C\u043E\u0442\u0438\u0432\u0430\u0442\u043E\u0440\u0430\u0445 RX-47. \u0412\u043E\u043D\u0438
      \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456
      \u043D\u0430 \u043A\u043E\u0436\u043D\u043E\u043C\u0443 \u0440\u043E\u0431\u043E\u0442\u0456
      \u043A\u043B\u0430\u0441\u0443 \"\u0412\u0430\u0440\u0442\u043E\u0432\u0438\u0439\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018125
    m_Localized: "\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456
      \u043C\u043E\u0442\u0438\u0432\u0430\u0442\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018126
    m_Localized: "\u0416\u0430\u0440-\u0431\u0430\u0442\u0430\u0440\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018127
    m_Localized: "\u041E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u043C\u0438 \u0437\u0430\u0440\u0430\u0437
      \u0432\u043E\u0440\u043E\u0433\u0443\u0454\u043C\u043E \u0437 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438
      \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F,
      \u0442\u043E \u0434\u043B\u044F \u043A\u0440\u0430\u0449\u043E\u0433\u043E
      \u043E\u0431\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0431\u0430\u0437\u0438
      \u043D\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u043F\u043E\u0442\u0443\u0436\u043D\u0435 \u0434\u0436\u0435\u0440\u0435\u043B\u043E
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457. \u041E\u0434\u043D\u0430 \u0437
      \u0436\u0430\u0440-\u0431\u0430\u0442\u0430\u0440\u0435\u0439, \u0449\u043E
      \u043F\u0440\u0438\u043F\u0430\u0434\u0430\u044E\u0442\u044C \u043F\u0438\u043B\u043E\u043C
      \u0434\u0435\u0441\u044C \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0456
      \u0432 \u0411\u0443\u043D\u043A\u0435\u0440\u0456, \u0446\u0456\u043B\u043A\u043E\u043C
      \u043F\u0456\u0434\u0456\u0439\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018128
    m_Localized: "\u0414\u043E\u0431\u0443\u0442\u0438 \u0436\u0430\u0440-\u0431\u0430\u0442\u0430\u0440\u0435\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018129
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0436\u0430\u0440-\u0431\u0430\u0442\u0430\u0440\u0435\u044E
      \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u0456 \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018130
    m_Localized: "\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018131
    m_Localized: "\u042F\u043A\u0449\u043E \u044F\u043A\u0430\u0441\u044C \u0444\u0440\u0430\u043A\u0446\u0456\u044F
      \u0456 \u0432\u043E\u043B\u043E\u0434\u0456\u0454 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044F\u043C\u0438,
      \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0456\u0448\u0438\u043C\u0438
      \u0437\u0430 \u0442\u0456, \u0449\u043E \u043C\u0430\u044E\u0442\u044C \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438, - \u0442\u043E \u0446\u0435,
      \u0431\u0435\u0437\u0441\u0443\u043C\u043D\u0456\u0432\u043D\u043E, \u0410\u043D\u043A\u043B\u0430\u0432
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432. \u0417\u0440\u0430\u0437\u043A\u0438
      \u0442\u0430\u043A\u0438\u0445 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439
      \u0431\u0443\u0434\u0443\u0442\u044C \u0449\u0435\u0434\u0440\u043E \u043E\u043F\u043B\u0430\u0447\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018132
    m_Localized: "\u041C\u0430\u0433\u043D\u0456\u0442\u043D\u043E-\u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u043D\u0438\u0439
      \u0445\u0440\u0456\u043D\u043E\u043B\u044F\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018133
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430-\u043A\u0432\u0430\u0434\u0440\u0430\u043F\u0443\u043F\u043F\u0456\u043D\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018134
    m_Localized: "\u0411\u0430\u0440\u0456\u043E\u043D\u043D\u0438\u0439 \u0434\u0435\u0444\u0443\u0440\u043A\u0443\u043B\u044F\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018135
    m_Localized: "\u0421\u0443\u043F\u0435\u0440\u043B\u044E\u043C\u0456\u043D\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u0438\u0439
      \u043A\u0432\u0430\u0437\u0456\u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0442\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018136
    m_Localized: "\u0413\u0456\u043F\u0435\u0440\u043F\u0440\u043E\u043C\u0435\u043D\u0435\u0432\u0438\u0439
      \u0442\u0440\u0430\u043D\u0441\u043A\u043B\u044E\u043A\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018137
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018138
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443 - \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0438\u0439
      \u043F\u0440\u0438\u043A\u043B\u0430\u0434 \u0441\u0443\u0447\u0430\u0441\u043D\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439. \u041C\u0435\u043D\u0456
      \u0431 \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0445\u043E\u0447\u0430 \u0431 \u043E\u0434\u0438\u043D \u043D\u0435\u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0438\u0439
      \u0437\u0440\u0430\u0437\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018139
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043D\u0435\u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0443
      \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018140
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0431\u0440\u043E\u043D\u044E
      \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018141
    m_Localized: "\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018142
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u043F\u043E\u0446\u0456\u043A\u0430\u0432\u0438\u0442\u0438\u0441\u044F?
      \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u0431\u0430\u0447\u0430\u0442\u044C \u0441\u0432\u043E\u044E \u043C\u0456\u0441\u0456\u044E
      \u0432 \u0437\u0431\u043E\u0440\u0456 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u0456
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439,
      \u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0440\u043E\u0437\u0443\u043C\u0456\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018143
    m_Localized: "\u0412\u0441\u0435 \u0432\u0456\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018144
    m_Localized: "\u0406 \u044F\u043A \u0441\u0430\u043C\u0435 \u0446\u0435 \u043F\u0440\u0430\u0446\u044E\u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018145
    m_Localized: "\u041C\u0438 \u043F\u0435\u0440\u0456\u043E\u0434\u0438\u0447\u043D\u043E
      \u043F\u043E\u0441\u0438\u043B\u0430\u0454\u043C\u043E \u043F\u043E\u0448\u0443\u043A\u043E\u0432\u0456
      \u0437\u0430\u0433\u043E\u043D\u0438 \u0432 \u0440\u0443\u0457\u043D\u0438
      \u0441\u0442\u0430\u0440\u0438\u0445 \u043C\u0456\u0441\u0442, \u0430 \u0449\u0435
      \u043F\u043B\u0430\u0442\u0438\u043C\u043E \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C \u0456 \u0441\u043C\u0456\u0442\u0442\u044F\u0440\u0430\u043C,
      \u044F\u043A\u0449\u043E \u0432\u043E\u043D\u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442\u044C
      \u043D\u0430\u043C \u0446\u0456\u043D\u043D\u0456 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018146
    m_Localized: "\u0429\u043E \u0436 \u0432\u0438 \u0440\u043E\u0431\u0438\u0442\u0435
      \u0437 \u0446\u0438\u043C\u0438 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018147
    m_Localized: "\u0412\u0438\u0432\u0447\u0430\u0454\u043C\u043E, \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0438\u0437\u0443\u0454\u043C\u043E,
      \u043F\u043E\u0442\u0456\u043C \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0454\u043C\u043E
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018148
    m_Localized: "\u0406 \u0449\u043E, \u0446\u0435 \u0432\u0441\u0435? \u041D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u0435
      \u0457\u0445? \u041D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u0435\u0441\u044F
      \u0432\u0456\u0434\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0456 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F? \u0427\u0435\u0441\u043D\u043E
      \u043A\u0430\u0436\u0443\u0447\u0438, \u044F \u0432\u0441\u0435 \u043D\u0456\u044F\u043A
      \u043D\u0435 \u043C\u043E\u0436\u0443 \u0446\u044C\u043E\u0433\u043E \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438.
      \u0425\u0456\u0431\u0430 \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456
      \u043C\u0430\u043B\u043E \u043F\u043E\u043D\u0456, \u044F\u043A\u0438\u043C
      \u0446\u0456 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 \u043C\u043E\u0433\u043B\u0438
      \u0431 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043A\u043E\u0440\u0438\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018149
    m_Localized: "\u041D\u0435 \u0434\u0443\u043C\u0430\u0439, \u0449\u043E \u0442\u0438
      \u043F\u0435\u0440\u0448\u0430, \u0445\u0442\u043E \u0441\u0442\u0430\u0432\u0438\u0432
      \u0441\u043E\u0431\u0456 \u0446\u0435 \u043F\u0438\u0442\u0430\u043D\u043D\u044F,
      @lp. \u0421\u0435\u0440\u0435\u0434 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0447\u0438\u043C\u0430\u043B\u043E
      \u0442\u0438\u0445, \u0445\u0442\u043E \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0430\u0432
      \u0431\u0438 \u0442\u0432\u043E\u044E \u0442\u043E\u0447\u043A\u0443 \u0437\u043E\u0440\u0443.
      \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430, \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C
      \u0432\u0432\u0430\u0436\u0430\u0454, \u0449\u043E \u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044F\u043C\u0438 \u0437
      \"\u0434\u0438\u043A\u0443\u043D\u0430\u043C\u0438\" \u043D\u0435 \u043B\u0438\u0448\u0435
      \u043D\u0435 \u0434\u043E\u0446\u0456\u043B\u044C\u043D\u043E, \u0430 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E \u0434\u043B\u044F
      \u0432\u0441\u0456\u0445. \u041D\u0456\u0431\u0438\u0442\u043E, \u043C\u0438
      \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u043F\u0456\u043A\u043B\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0456 \u043F\u043E\u043A\u043E\u043B\u0456\u043D\u043D\u044F,
      \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457
      \u0434\u043B\u044F \u043D\u0438\u0445, \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u043D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u0441\u044F
      \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438 \u043F\u0440\u0438\u0440\u0435\u0447\u0435\u043D\u0438\u0439
      \u0441\u0432\u0456\u0442 \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018150
    m_Localized: "\u041D\u0435 \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u0439 \u043E\u0431\u0443\u0440\u044E\u0432\u0430\u0442\u0438\u0441\u044F.
      \u042F \u0437\u043D\u0430\u044E, \u044F\u043A \u0446\u0438\u043D\u0456\u0447\u043D\u043E
      \u0446\u0435 \u0437\u0432\u0443\u0447\u0438\u0442\u044C... \u0430\u043B\u0435
      \u043C\u043E\u0454\u0457 \u0434\u0443\u043C\u043A\u0438 \u043D\u0456\u0445\u0442\u043E
      \u043D\u0435 \u043F\u0438\u0442\u0430\u0454, \u0430 \u0442\u0432\u043E\u0454\u0457
      \u0456 \u043F\u043E\u0433\u043E\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018151
    m_Localized: "\u0425\u043C... \u043D\u0443 \u0433\u0430\u0440\u0430\u0437\u0434.
      \u0422\u0438 \u043A\u0430\u0436\u0435\u0448, \u0449\u043E \u0432\u0438 \u043F\u043B\u0430\u0442\u0438\u0442\u0435
      \u0437\u0430 \u0446\u0456\u043D\u043D\u0456 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0438.
      \u0410 \u0447\u0438 \u0454 \u0449\u043E\u0441\u044C, \u0449\u043E \u0442\u043E\u0431\u0456
      \u0431 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F
      \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018152
    m_Localized: "\u0422\u0430\u043A \u0442\u043E\u0447\u043D\u043E. \u0421\u0438\u043B\u043E\u0432\u0443
      \u0431\u0440\u043E\u043D\u044E \u0410\u043D\u043A\u043B\u0430\u0432\u0443.
      \u0422\u043E\u0431\u0456 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044F
      \u0431\u0430\u0447\u0438\u0442\u0438 \u0442\u0430\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018153
    m_Localized: "\u041D\u0456. \u042F \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u0437\u043D\u0430\u044E \u043F\u0440\u043E \u0446\u0435\u0439
      \u0410\u043D\u043A\u043B\u0430\u0432. \u0410 \u0445\u0442\u043E \u0432\u043E\u043D\u0438
      \u0442\u0430\u043A\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018154
    m_Localized: "\u0410\u043D\u043A\u043B\u0430\u0432 - \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F \u043F\u0435\u0433\u0430\u0441\u0456\u0432.
      \u041C\u0438 \u043D\u0435 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0454\u043C\u043E
      \u0437 \u043D\u0438\u043C\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432
      \u0456 \u0441\u0430\u043C\u0456 \u043C\u0430\u043B\u043E \u0449\u043E \u043F\u0440\u043E
      \u043D\u0438\u0445 \u0437\u043D\u0430\u0454\u043C\u043E. \u041D\u0430\u043C
      \u0432\u0456\u0434\u043E\u043C\u043E \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0435,
      \u0449\u043E \u0432\u043E\u043D\u0438 \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u044C\u043C\u0430 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u043C\u0438
      \u0456 \u043F\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u043C\u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044F\u043C\u0438.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043D\u0430\u0439\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0456\u0448\u0438\u043C\u0438
      \u0443 \u0441\u0432\u0456\u0442\u0456. \u0406 \u0457\u0445\u043D\u0456 \u0431\u0456\u0439\u0446\u0456,
      \u043F\u043E\u0434\u0456\u0431\u043D\u043E \u0434\u043E \u043D\u0430\u0448\u0438\u0445
      \u043B\u0438\u0446\u0430\u0440\u0456\u0432, \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E. \u0410\u043B\u0435
      \u043D\u0430\u043C \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0432\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
      \u0440\u043E\u0437\u0434\u043E\u0431\u0443\u0442\u0438 \u0436\u043E\u0434\u043D\u043E\u0433\u043E
      \u0446\u0456\u043B\u043E\u0433\u043E \u0437\u0440\u0430\u0437\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018155
    m_Localized: "\u042F\u043A\u0449\u043E \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0442\u0430\u043A\u0443, \u044F \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E
      \u043F\u043E\u043A\u0430\u0436\u0443 \u0457\u0457 \u0442\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018156
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430,
      \u044F \u043D\u0435 \u0443\u044F\u0432\u043B\u044F\u044E, \u044F\u043A \u0446\u0435
      \u0432 \u0442\u0435\u0431\u0435 \u0432\u0438\u0439\u0434\u0435. \u041F\u0430\u043C'\u044F\u0442\u0430\u0439,
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0446\u0456\u043B\u0438\u0439
      \u0437\u0440\u0430\u0437\u043E\u043A, \u043D\u0435 \u043F\u043E\u0441\u0456\u0447\u0435\u043D\u0438\u0439
      \u043A\u0443\u043B\u044F\u043C\u0438, \u0442\u043E\u0436 \u043D\u0435 \u0437\u0434\u0443\u043C\u0430\u0439
      \u043F\u0440\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u0438 \u043C\u0435\u043D\u0456
      \u0431\u0440\u043E\u043D\u044E, \u0437\u043D\u044F\u0442\u0443 \u0437 \u0442\u0440\u0443\u043F\u0430
      \u0430\u043A\u043B\u0430\u0432\u0456\u0432\u0446\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018157
    m_Localized: "\u0406 \u0449\u0435... \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0430
      \u043F\u043E\u0440\u0430\u0434\u0430, \u044F\u043A \u043D\u0430\u0448\u043E\u043C\u0443
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018158
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018159
    m_Localized: "\u0410\u043D\u043A\u043B\u0430\u0432 - \u0433\u0440\u0456\u0437\u043D\u0438\u0439
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A. \u041D\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044C
      \u0439\u043E\u043C\u0443 \u0434\u043E\u0440\u043E\u0433\u0443 \u0431\u0435\u0437
      \u043A\u0440\u0430\u0439\u043D\u044C\u043E\u0457 \u043F\u043E\u0442\u0440\u0435\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018160
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018161
    m_Localized: "\u041F\u043E\u0433\u043B\u044F\u043D\u044C, \u0449\u043E \u0432
      \u043C\u0435\u043D\u0435 \u0454. \u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443. \u0417\u043E\u0432\u0441\u0456\u043C
      \u043D\u043E\u0432\u0430, \u0431\u0435\u0437 \u0454\u0434\u0438\u043D\u043E\u0457
      \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018162
    m_Localized: "\u041E\u0433\u043E, \u0442\u0430 \u0446\u0435 \u0436 \u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018163
    m_Localized: "\u0425\u043C... \u0442\u043E\u0431\u0442\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018164
    m_Localized: "\u041F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u044E.
      \u0426\u0435 \u0441\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443, \u0449\u043E\u043F\u0440\u0430\u0432\u0434\u0430
      \u043B\u0438\u0448\u0435 \u0432 \u0431\u0430\u0437\u043E\u0432\u0456\u0439,
      \u043D\u0430\u0439\u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0456\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430\u0446\u0456\u0457.
      \u0411\u0435\u0437 \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0434\u043B\u044F
      \u043A\u0440\u0438\u043B, \u0431\u0435\u0437 \u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u043E\u0432\u043E\u0433\u043E
      \u0436\u0430\u043B\u0430 \u0456 \u0431\u0435\u0437 \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u043E\u0457
      \u043C\u0430\u0442\u0440\u0438\u0446\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018165
    m_Localized: "\u0410\u043B\u0435 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E,
      \u0432\u0438\u0437\u043D\u0430\u0439, \u0449\u043E \u0442\u0438 \u0432\u0440\u0430\u0436\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018166
    m_Localized: "\u0422\u0440\u043E\u0445\u0438 \u0437\u0434\u0438\u0432\u043E\u0432\u0430\u043D\u0430.
      \u0414\u0435 \u0442\u043E\u0431\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u0457\u0457 \u0434\u043E\u0431\u0443\u0442\u0438, \u0443 \u0440\u043E\u0437\u0434\u044F\u0433\u0430\u043B\u044C\u043D\u0456
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443? \u0423\u0442\u0456\u043C, \u043C\u0435\u043D\u0456
      \u0432\u0441\u0435 \u043E\u0434\u043D\u043E. \u042F \u0443\u043F\u043E\u0432\u043D\u043E\u0432\u0430\u0436\u0435\u043D\u0430
      \u0432\u0438\u0434\u0430\u0442\u0438 \u0442\u043E\u0431\u0456 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443.
      \u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0442\u0438 \u0445\u043E\u0447\u0435\u0448
      \u0437\u0430 \u0446\u0435\u0439 \u0437\u0440\u0430\u0437\u043E\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018167
    m_Localized: "\u0412\u0438\u0431\u0430\u0447, \u0430\u043B\u0435 \u0446\u044F
      \u0431\u0440\u043E\u043D\u044F \u043C\u0435\u043D\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0456\u0439. \u042F \u043D\u0435 \u0445\u043E\u0447\u0443
      \u0457\u0457 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018168
    m_Localized: "\u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u0434\u0443\u0440\u043D\u0438\u0446\u044C,
      \u0446\u0435 \u0436 \u0431\u0440\u043E\u043D\u044F \u0434\u043B\u044F \u043F\u0435\u0433\u0430\u0441\u0456\u0432!
      \u0422\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0448 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0430\u0434\u0456\u0442\u0438 \u0448\u043E\u043B\u043E\u043C \u0447\u0435\u0440\u0435\u0437
      \u0441\u0432\u0456\u0439 \u0440\u0456\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018169
    m_Localized: "\u041E, \u044F \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430,
      \u0449\u043E \u0431\u0440\u043E\u043D\u044E \u043C\u043E\u0436\u043D\u0430
      \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0443\u0432\u0430\u0442\u0438. \u041D\u0435
      \u0442\u0430\u043A \u0443\u0436\u0435 \u0446\u0435 \u0439 \u0441\u043A\u043B\u0430\u0434\u043D\u043E,
      \u044F\u043A \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F.
      \u0414\u0430\u0432\u0430\u0439 \u0443\u043A\u043B\u0430\u0434\u0435\u043C\u043E
      \u0443\u0433\u043E\u0434\u0443 - \u044F \u0434\u0430\u043C \u0457\u0457 \u0442\u043E\u0431\u0456
      \u043D\u0430 \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441, \u0434\u043B\u044F
      \u0432\u0438\u0432\u0447\u0435\u043D\u043D\u044F. \u0410 \u0442\u0438 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0443\u0454\u0448
      \u0457\u0457 \u043F\u0456\u0434 \u043C\u043E\u0457 \u043F\u043E\u0442\u0440\u0435\u0431\u0438.
      \u0414\u043E\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018170
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u0423 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0456,
      \u044F \u0439 \u043D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u0442\u0430\u043A\u0430
      \u0431\u0440\u043E\u043D\u044F \u043F\u0456\u0434\u0456\u0439\u0434\u0435 \u043A\u043E\u043C\u0443\u0441\u044C
      \u0456\u0437 \u043B\u0438\u0446\u0430\u0440\u0456\u0432 \u0430\u0431\u043E
      \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u0438\u043A\u0456\u0432,
      \u0432\u043E\u043D\u0430 \u0434\u043B\u044F \u043D\u0438\u0445 \u043D\u0430\u0434\u0442\u043E
      \u043A\u0432\u043E\u043B\u0430, \u0430 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438
      \u0457\u0457 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u0441\u0435\u043D\u0441\u0443 \u043D\u0435\u043C\u0430\u0454. \u041C\u0435\u043D\u0456
      \u0431\u0443\u0434\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0456 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0438\u0432\u0447\u0438\u0442\u0438
      \u0457\u0457. \u041F\u0440\u0438\u0445\u043E\u0434\u044C \u0442\u0440\u043E\u0445\u0438
      \u043F\u0456\u0437\u043D\u0456\u0448\u0435, \u0432\u0441\u0435 \u0431\u0443\u0434\u0435
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018171
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0410\u043D\u043A\u043B\u0430\u0432\u0443
      \u0433\u043E\u0442\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018172
    m_Localized: "\u041D\u0443 \u044F\u043A, \u0449\u043E \u0442\u0430\u043C \u0456\u0437
      \u043C\u043E\u0454\u044E \u0431\u0440\u043E\u043D\u0435\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018173
    m_Localized: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u043E \u0432\u0438\u0432\u0447\u0438\u0442\u0438
      \u0457\u0457. \u0414\u0443\u0436\u0435 \u0446\u0456\u043A\u0430\u0432\u0430
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044F. \u0411\u0440\u043E\u043D\u044F
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043B\u0435\u0433\u0448\u0430
      \u0437\u0430 \u043D\u0430\u0448\u0443, \u0434\u0443\u0436\u0435 \u0433\u043D\u0443\u0447\u043A\u0430
      \u0456 \u043D\u0435 \u0442\u0430\u043A \u0441\u043A\u043E\u0432\u0443\u0454
      \u0440\u0443\u0445\u0438. \u0410\u043B\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0446\u0435 \u0456 \u043A\u0443\u0434\u0438 \u043C\u0435\u043D\u0448 \u043C\u0456\u0446\u043D\u0430.
      \u0424\u0430\u043A\u0442\u0438\u0447\u043D\u043E, \u0432\u043E\u043D\u0430
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0437\u0434\u0430\u0442\u043D\u0430
      \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0456\u0434 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u043E\u0432\u043E\u0457
      \u043A\u0443\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018174
    m_Localized: "\u0426\u044F \u0431\u0440\u043E\u043D\u044F \u044F\u0432\u043D\u043E
      \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0430 \u043D\u0430
      \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u0432\u043F\u043B\u0438\u0432\u0456\u0432. \u0406 \u043E\u0441\u044C \u0442\u0443\u0442
      \u0442\u0440\u0435\u0431\u0430 \u0432\u0438\u0437\u043D\u0430\u0442\u0438,
      \u0432\u043E\u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0445\u043E\u0440\u043E\u0448\u0430.
      \u041C\u0430\u0442\u0440\u0438\u0446\u044F \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C
      \u0434\u0443\u0436\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u0430 \u0437
      \u0431\u0430\u0433\u0430\u0442\u044C\u043C\u0430 \u0440\u0456\u0432\u043D\u044F\u043C\u0438
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018175
    m_Localized: "\u0410\u0433\u0430... \u0422\u0430\u043A \u0449\u043E \u0437 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0454\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018176
    m_Localized: "\u0414\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u0432 \u0448\u043E\u043B\u043E\u043C\u0456
      \u043F\u0440\u043E\u0441\u0432\u0435\u0440\u0434\u043B\u0438\u0442\u0438 \u0434\u0456\u0440\u043A\u0443
      \u0434\u043B\u044F \u0440\u043E\u0433\u0443. \u041D\u0443 \u0456 \u043F\u0456\u0434\u0456\u0433\u043D\u0430\u0442\u0438
      \u043F\u0456\u0434 \u0442\u0432\u0456\u0439 \u0437\u0440\u0456\u0441\u0442.
      \u0412 \u0456\u043D\u0448\u043E\u043C\u0443 \u0442\u043E\u0431\u0456 \u043C\u0430\u0454
      \u0431\u0443\u0442\u0438 \u043D\u0435\u0441\u043A\u043B\u0430\u0434\u043D\u043E
      \u043E\u0441\u0432\u043E\u0457\u0442\u0438\u0441\u044F \u0437 \u0446\u0456\u0454\u044E
      \u0431\u0440\u043E\u043D\u0435\u044E, \u0431\u043E \u0432\u043E\u043D\u0430
      \u0434\u0443\u0436\u0435... \u043D\u0443 \u0441\u043A\u0430\u0436\u0456\u043C\u043E
      \u0442\u0430\u043A, \u0430\u0434\u0430\u043F\u0442\u0438\u0432\u043D\u0430.
      \u0421\u0430\u043C\u0430 \u043F\u0440\u0438\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u043E\u0441\u0456\u044F. \u0412\u0447\u0435\u043D\u0456
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443 \u044F\u0432\u043D\u043E \u043D\u0435
      \u0441\u0438\u0434\u0456\u043B\u0438 \u0431\u0435\u0437 \u0434\u0456\u043B\u0430
      \u043E\u0441\u0442\u0430\u043D\u043D\u0456 \u0434\u0432\u0456\u0441\u0442\u0456
      \u0440\u043E\u043A\u0456\u0432. \u0412\u0456\u0439\u043D\u0430 \u0437 \u043D\u0438\u043C\u0438
      \u0431\u0443\u0434\u0435 \u0432\u0430\u0436\u043A\u043E\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018177
    m_Localized: "\u041E\u0445, \u0434\u044F\u043A\u0443\u044E! \u041D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442\u044C\u0441\u044F
      \u0457\u0457 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0432 \u0441\u043F\u0440\u0430\u0432\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018178
    m_Localized: "\u041D\u0435 \u0432\u0430\u0440\u0442\u043E \u043F\u043E\u0434\u044F\u043A\u0438.
      \u0422\u0438 - \u0446\u0456\u043D\u043D\u0438\u0439 \u0441\u043E\u044E\u0437\u043D\u0438\u043A,
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u044E\u0447\u0438 \u0442\u043E\u0431\u0456,
      \u043C\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u043C\u043E
      \u0441\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018179
    m_Localized: "\u0422\u0430 \u0446\u0435 \u0436 \u043C\u043E\u044F \u043A\u043E\u043B\u0438\u0448\u043D\u044F
      \u043A\u0456\u043C\u043D\u0430\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018180
    m_Localized: "\u0422\u0440\u0435\u0431\u0430 \u0436, \u0456 \u043D\u0456\u0442\u0440\u043E\u0445\u0438
      \u043D\u0435 \u0437\u043C\u0456\u043D\u0438\u043B\u0430\u0441\u044F. \u0422\u0430\u043A\u0430
      \u0436 \u0441\u0456\u0440\u0430, \u044F\u043A \u0456 \u043C\u043E\u0454 \u043C\u0438\u043D\u0443\u043B\u0435
      \u0436\u0438\u0442\u0442\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018181
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438,
      \u044F\u043A\u0431\u0438 \u043C\u0435\u043D\u0435 \u043D\u0435 \u0432\u0438\u0431\u0440\u0430\u043B\u0438
      \u0434\u043B\u044F \u043C\u0456\u0441\u0456\u0457 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456,
      \u044F \u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0430
      \u0436\u0438\u0442\u0438 \u0442\u0443\u0442. \u0414\u0435\u043D\u044C \u0437\u0430
      \u0434\u043D\u0435\u043C, \u0440\u0456\u043A \u0437\u0430 \u0440\u043E\u043A\u043E\u043C,
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u044E\u0447\u0438
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437\u043E\u0432\u043D\u0456. \u0411\u0435\u0437\u043F\u0435\u0447\u043D\u043E
      \u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018182
    m_Localized: "\u0431\u0435\u0437\u0433\u043B\u0443\u0437\u0434\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018183
    m_Localized: "\u0428\u0430\u043D\u043E\u0432\u043D\u0438\u0439 \u0447\u0438\u0442\u0430\u0447\u0443!
      \u042F\u043A\u0449\u043E \u0412\u0438 \u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u0443 \u0441\u0432\u043E\u0457\u0445 \u043A\u043E\u043F\u0438\u0442\u0430\u0445
      \u0446\u044E \u0437\u0431\u0456\u0440\u043A\u0443, \u0437\u043D\u0430\u0447\u0438\u0442\u044C,
      \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0412\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0438 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u043F\u0435\u0440\u0448\u0438\u0439 \u043A\u0440\u043E\u043A \u0432 \u043E\u0441\u0432\u043E\u0454\u043D\u043D\u0456
      \u0442\u043E\u043D\u043A\u043E\u0433\u043E \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u0430
      \u043D\u0435\u0446\u0435\u043D\u0437\u0443\u0440\u043D\u043E\u0457 \u043B\u0430\u0439\u043A\u0438.
      \u0423\u043C\u0456\u043D\u043D\u044F \u043C\u0456\u0446\u043D\u043E \u0439
      \u0432\u0438\u0442\u0456\u044E\u0432\u0430\u0442\u043E \u043B\u0430\u044F\u0442\u0438\u0441\u044F
      - \u0446\u0435 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0432\u0430\u0436\u043B\u0438\u0432\u0430
      \u0439 \u043D\u0435\u0432\u0456\u0434'\u0454\u043C\u043D\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430
      \u0440\u043E\u0437\u0443\u043C\u043D\u043E\u0433\u043E \u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F,
      \u0456 \u043D\u0456\u0447\u043E\u0433\u043E \u0433\u0430\u043D\u0435\u0431\u043D\u043E\u0433\u043E
      \u0432 \u0439\u043E\u0433\u043E \u0434\u043E\u0440\u0435\u0447\u043D\u043E\u043C\u0443
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u0456 \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435\u043C\u0430\u0454. \u0423 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0432\u0438\u043F\u0430\u0434\u043A\u0430\u0445 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E
      \u0434\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F \u0434\u043E \u0441\u0432\u043E\u0457\u0445
      \u043F\u0440\u043E\u043C\u043E\u0432 \u0431\u0440\u0443\u0434\u043D\u043E\u0433\u043E
      \u0441\u043B\u0456\u0432\u0446\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E,
      \u0449\u043E\u0431 \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u0432\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0456 \u043F\u043E\u0432\u043D\u043E\u044E \u043C\u0456\u0440\u043E\u044E
      \u0432\u0438\u0441\u043B\u043E\u0432\u0438\u0442\u0438 \u0441\u0432\u043E\u0457
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F, \u0456 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0445\u0442\u043E \u0432\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u044E\u0454
      \u0441\u0432\u043E\u0454 \u0432\u043C\u0456\u043D\u043D\u044F \u0431\u0430\u0440\u0432\u0438\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u0441\u0432\u043E\u0457 \u0435\u043C\u043E\u0446\u0456\u0457
      \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u0443\u0441\u044C\u043E\u0433\u043E
      \u0436\u0438\u0442\u0442\u044F. \u041D\u0430\u0448 \u0441\u043B\u043E\u0432\u043D\u0438\u043A,
      \u043D\u0430 \u0436\u0430\u043B\u044C, \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0437\u0434\u0430\u0442\u0435\u043D \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436 \u043F\u0456\u0434\u043D\u044F\u0442\u0438 \u0412\u0430\u0441 \u0434\u043E
      \u0440\u0456\u0432\u043D\u044F \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0445
