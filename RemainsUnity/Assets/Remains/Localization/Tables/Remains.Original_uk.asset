      m_Items: []
  - m_Id: 2737825062
    m_Localized: "\u0413\u0438-\u0438-\u0438-\u0438-\u0438-\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825063
    m_Localized: "\u0423\u0441\u0435 \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u044F\u043A\u0435\u0441\u044C...
      \u0434\u0432\u043E\u043C\u0456\u0440\u043D\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825064
    m_Localized: "\u0424\u0443, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u043B\u043E. \u041E\u0439,
      \u043D\u0456... \u0446\u0435 \u0449\u0435 \u043D\u0435 \u0432\u0441\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825065
    m_Localized: "\u041E\u0441\u044C, \u0442\u0435\u043F\u0435\u0440 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
      \u0422\u0430-\u0430-\u0430-\u0430\u043A, \u0446\u0435 \u0431\u0443\u043B\u043E
      \u0434\u0438\u0432\u043D\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825066
    m_Localized: "\u0422\u0430\u0430\u0430\u043A... \u0449\u043E \u0442\u0443\u0442
      \u0443 \u043D\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825067
    m_Localized: "\u0425\u043C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825068
    m_Localized: "\u0425\u043C\u043C\u043C\u043C\u043C\u043C\u043C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825069
    m_Localized: "\u041D\u0443 \u0449\u043E \u0442\u0443\u0442 \u043C\u043E\u0436\u043D\u0430
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438? \u0426\u044F \u0448\u0442\u0443\u043A\u0430,
      \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E, \u0437\u043B\u0430\u043C\u0430\u043D\u0430.
      \u0410\u043B\u0435 \u044F \u043F\u043E\u043D\u044F\u0442\u0442\u044F \u043D\u0435
      \u043C\u0430\u044E, \u044F\u043A \u0457\u0457 \u043C\u043E\u0436\u043D\u0430
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825070
    m_Localized: "\u0422\u0430\u043A, \u0443 \u0440\u0435\u043C\u043E\u043D\u0442\u0456
      \u044F \u043F\u043E\u0432\u043D\u0438\u0439 \u043D\u0443\u043B\u044C. \u042F\u043A\u0449\u043E
      \u0449\u043E\u0441\u044C \u0456 \u043C\u043E\u0436\u0443, \u0442\u043E \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u0422\u0440\u0435\u0431\u0430 \u0445\u043E\u0447\u0430 \u0431 \u043A\u043D\u0438\u0436\u043A\u0443
      \u044F\u043A\u0443\u0441\u044C \u043F\u0440\u043E \u0446\u0435 \u043F\u043E\u0447\u0438\u0442\u0430\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825071
    m_Localized: "\u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F...
      \u0422\u0430\u043A, \u0446\u0435\u0439 \u0410\u0432\u0442\u043E\u0414\u043E\u043A
      \u044F\u0432\u043D\u043E \u0437\u043D\u0430\u0432 \u043A\u0440\u0430\u0449\u0456
      \u0447\u0430\u0441\u0438. \u0427\u0438\u043C\u0430\u043B\u043E \u0434\u0435\u0442\u0430\u043B\u0435\u0439,
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u044C
      \u0437\u0430\u043C\u0456\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825072
    m_Localized: "\u0429\u043E \u0432 \u043D\u0430\u0441 \u0456\u0437 \u043C\u0435\u0445\u0430\u043D\u0456\u043A\u043E\u044E?
      \u041C\u043E\u0442\u043E\u0440 \u043D\u0435 \u043F\u0430\u0448\u0435... \u0442\u0443\u0442
      \u043F\u0440\u0443\u0436\u0438\u043D\u0430 \u043B\u043E\u043F\u043D\u0443\u043B\u0430...
      \u0443\u0449\u0456\u043B\u044C\u043D\u044E\u0432\u0430\u0447\u0456 \u0440\u043E\u0437\u0441\u043E\u0445\u043B\u0438\u0441\u044F.
      \u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u043A\u043B\u0435\u0457\u0442\u0438,
      \u0430 \u0442\u0443\u0442 \u043F\u0440\u0438\u043C\u043E\u0442\u0430\u0442\u0438
      \u0456\u0437\u043E\u043B\u044F\u0446\u0456\u0439\u043D\u043E\u044E \u0441\u0442\u0440\u0456\u0447\u043A\u043E\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825073
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0430 \u043D\u0430\u0447\u0438\u043D\u043A\u0430
      \u0442\u0435\u0436 \u0443\u0441\u044F \u0434\u043E\u0445\u043B\u0430. \u0411\u0430\u0442\u0430\u0440\u0435\u044F
      \u0432\u0438\u0447\u0435\u0440\u043F\u0430\u043B\u0430 \u0441\u0432\u0456\u0439
      \u0440\u0435\u0441\u0443\u0440\u0441, \u043A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440\u0438
      \u0432\u0438\u0441\u043E\u0445\u043B\u0438, \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440
      \u0442\u0435\u0436 \u0442\u0440\u0435\u0431\u0430 \u0431 \u0437\u0430\u043C\u0456\u043D\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825074
    m_Localized: "\u0410 \u0446\u0435 \u0449\u043E, \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C? \u0423\u043B\u044C\u0442\u0440\u0430\u0437\u0432\u0443\u043A\u043E\u0432\u0438\u0439
      \u0441\u043A\u0430\u043D\u0435\u0440 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043C\u0456\u043D\u044F\u0442\u0438, \u0441\u0442\u0430\u0440\u0438\u0439
      \u0437\u043E\u0432\u0441\u0456\u043C \u0432\u0456\u0434\u043A\u0438\u043D\u0443\u0432\u0441\u044F.
      \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0447\u0438\u0439 \u043B\u0430\u0437\u0435\u0440
      \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454, \u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0456
      \u0437\u0430\u0442\u0438\u0441\u043A\u0430\u0447\u0456 \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825075
    m_Localized: "\u0415\u0445, \u0442\u0430 \u0442\u0443\u0442 \u043F\u0440\u043E\u0440\u0432\u0430
      \u0440\u043E\u0431\u043E\u0442\u0438, \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0441\u044C\u043E\u0433\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u0430\u043C\u0456\u043D\u0438\u0442\u0438... \u042F\u043A \u0446\u0435\u0439
      \u0430\u043F\u0430\u0440\u0430\u0442 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u0434\u043E\u0436\u0438\u0432 \u0434\u043E \u043D\u0430\u0448\u0438\u0445
      \u0434\u043D\u0456\u0432? \u0421\u043A\u043B\u0430\u0434\u0443, \u043C\u0430\u0431\u0443\u0442\u044C,
      \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445
      \u0434\u0435\u0442\u0430\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825076
    m_Localized: "\u0414\u0435\u0442\u0430\u043B\u0456 \u0434\u043B\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0443
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u0430: - \u0427\u0443\u0434\u043E-\u043A\u043B\u0435\u0439
      (3 \u0448\u0442) - \u0406\u0437\u043E\u0441\u0442\u0440\u0456\u0447\u043A\u0430
      (3 \u0448\u0442) - \u0413\u0443\u043C\u043E\u0432\u0438\u0439 \u0434\u0436\u0433\u0443\u0442
      (2 \u0448\u0442) - \u041F\u0440\u043E\u043C\u0438\u0441\u043B\u043E\u0432\u0430
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F (1 \u0448\u0442) - \u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u043E\u0442\u043E\u0440
      (1 \u0448\u0442) - \u041F\u0440\u0443\u0436\u0438\u043D\u0430 (2 \u0448\u0442)
      - \u041A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440 (1 \u0448\u0442)
      - \u0423\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0438\u0439
      \u0447\u0438\u043F (1 \u0448\u0442) - \u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0456
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 (10 \u0448\u0442)
      - \u0423\u043B\u044C\u0442\u0440\u0430\u0437\u0432\u0443\u043A\u043E\u0432\u0438\u0439
      \u0441\u043A\u0430\u043D\u0435\u0440 (1 \u0448\u0442) - \u041B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u0446\u0456\u043B\u0435\u0432\u043A\u0430\u0437\u0443\u0432\u0430\u0447 (1
      \u0448\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825077
    m_Localized: "\u0422\u0440\u0435\u0431\u0430 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u0446\u0435\u0439 \u0430\u043F\u0430\u0440\u0430\u0442. \u0422\u0456\u043B\u044C\u043A\u0438
      \u0432 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454 \u0432\u0441\u0456\u0445
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445 \u0434\u0435\u0442\u0430\u043B\u0435\u0439,
      \u0430 \u0431\u0435\u0437 \u043D\u0438\u0445 \u044F \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0449\u043E\u0441\u044C \u0437\u0440\u043E\u0431\u043B\u044E.
      \u041C\u043E\u0436\u0435, \u0443 \u0412\u0456\u043D\u0440\u0456 \u0454 \u0449\u043E\u0441\u044C
      \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0449\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 3023036416
    m_Localized: "\u0414\u0435\u0442\u0430\u043B\u0456 \u0434\u043B\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0443
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u0430: - \u0427\u0443\u0434\u043E-\u043A\u043B\u0435\u0439
      (3 \u0448\u0442) - \u0406\u0437\u043E\u0441\u0442\u0440\u0456\u0447\u043A\u0430
      (3 \u0448\u0442) - \u0413\u0443\u043C\u043E\u0432\u0438\u0439 \u0434\u0436\u0433\u0443\u0442
      (2 \u0448\u0442) - \u041F\u0440\u043E\u043C\u0438\u0441\u043B\u043E\u0432\u0430
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F (1 \u0448\u0442) - \u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u043E\u0442\u043E\u0440
      (1 \u0448\u0442) - \u041F\u0440\u0443\u0436\u0438\u043D\u0430 (2 \u0448\u0442)
      - \u041A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440 (1 \u0448\u0442)
      - \u0423\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0438\u0439
      \u0447\u0438\u043F (1 \u0448\u0442) - \u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0456
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 (10 \u0448\u0442)
      - \u0423\u043B\u044C\u0442\u0440\u0430\u0437\u0432\u0443\u043A\u043E\u0432\u0438\u0439
      \u0441\u043A\u0430\u043D\u0435\u0440 (1 \u0448\u0442) - \u041B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u0446\u0456\u043B\u0435\u0432\u043A\u0430\u0437\u0443\u0432\u0430\u0447 (1
      \u0448\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825078
    m_Localized: "\u041D\u0443 \u0449\u043E, \u0441\u043F\u0440\u043E\u0431\u0443\u0454\u043C\u043E
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0446\u044E \u0441\u0442\u0430\u0440\u0443
      \u0440\u043E\u0437\u0432\u0430\u043B\u044E\u0445\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825079
    m_Localized: "\u041E\u0441\u044C \u0442\u0430\u043A. \u0426\u0435 \u0441\u044E\u0434\u0438.
      \u0426\u0435 \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043E\u0441\u044C
      \u0441\u044E\u0434\u0438... \u043F\u0456\u0434\u043A\u0440\u0443\u0442\u0438\u0442\u0438
      \u0442\u0443\u0442... \u043F\u0440\u0438\u043A\u043B\u0435\u0457\u0442\u0438
      \u0442\u0443\u0442. \u0410 \u0446\u0435 \u0449\u043E, \u0437\u0430\u0439\u0432\u0430
      \u0434\u0435\u0442\u0430\u043B\u044C \u0456 \u0434\u0432\u0456 \u0433\u0430\u0439\u043A\u0438?
      \u0413\u0430\u0440\u0430\u0437\u0434, \u0446\u0435, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u0431\u0443\u043B\u043E \u0449\u043E\u0441\u044C \u043D\u0435\u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435,
      \u0456 \u0442\u0430\u043A \u0437\u0456\u0439\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825080
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E! \u0412\u0441\u0435 \u043F\u0440\u0430\u0446\u044E\u0454.
      \u041D\u0435 \u0442\u0430\u043A \u0432\u0436\u0435 \u0439 \u0441\u043A\u043B\u0430\u0434\u043D\u043E
      \u0446\u0435 \u0431\u0443\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825081
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0442\u0430\u043A\u043E\u0457
      \u043F\u0440\u043E\u0441\u0442\u043E\u0457 \u043C\u0430\u0448\u0438\u043D\u0438?
      \u0422\u0430 \u0446\u0435 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438\u043C\u0435 \u0430\u043D\u0456
      \u043D\u0430\u0439\u043C\u0435\u043D\u0448\u043E\u0457 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825082
    m_Localized: "\u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F...
      \u0422\u0430 \u0445\u0456\u0431\u0430 \u0446\u044F \u0448\u0442\u0443\u043A\u0430
      \u0437\u043B\u0430\u043C\u0430\u043D\u0430? \u0407\u0439 \u0443\u0441\u044C\u043E\u0433\u043E-\u0442\u043E
      \u0439 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E, \u0449\u043E \u0442\u0440\u043E\u0445\u0438
      \u0442\u0443\u0440\u0431\u043E\u0442\u0438. \u0422\u0443\u0442 \u043F\u0456\u0434\u043A\u0440\u0443\u0442\u0438\u0442\u0438,
      \u0442\u0443\u0442 \u043F\u0456\u0434\u0432\u0435\u0440\u043D\u0443\u0442\u0438...
      \u0422\u0435\u043F\u0435\u0440 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0438\u043C\u043A\u043D\u0443\u0442\u0438
      \u0439 \u0443\u0432\u0456\u043C\u043A\u043D\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825083
    m_Localized: "\u041D\u0443 \u043E\u0441\u044C \u0456 \u0432\u0441\u0435, \u0447\u0443\u0434\u043E\u0432\u043E
      \u043F\u0440\u0430\u0446\u044E\u0454! \u0412\u0456\u0434\u0440\u0430\u0437\u0443
      \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u043C\u0435\u043D\u0435
      \u043A\u043B\u0438\u043A\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825084
    m_Localized: "\u0412\u0438\u043B\u0456\u043A\u0443\u0432\u0430\u0442\u0438 \u0445\u0432\u043E\u0440\u0443
      \u0437\u0435\u0431\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825085
    m_Localized: "\u0417\u0435\u0431\u0440\u0430 \u043D\u0430 \u0456\u043C'\u044F
      \u0417\u0456\u0440\u0430 \u0442\u044F\u0436\u043A\u043E \u0445\u0432\u043E\u0440\u0430,
      \u0456 \u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u043D\u0435 \u0432 \u0441\u0438\u043B\u0430\u0445
      \u0457\u0439 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438. \u0412\u0430\u0448\u0456
      \u043F\u0456\u0437\u043D\u0430\u043D\u043D\u044F \u0432 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456
      \u0431\u0443\u0434\u0443\u0442\u044C \u0434\u0443\u0436\u0435 \u0434\u043E\u0440\u0435\u0447\u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825086
    m_Localized: "\u0412\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438 \u0434\u0456\u0430\u0433\u043D\u043E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825087
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0443
      \u0432\u0456\u0434 \u043F\u0438\u043B\u043E\u0432\u043E\u0457 \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825088
    m_Localized: "\u0414\u0430\u0442\u0438 \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0443
      \u0417\u0456\u0440\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825089
    m_Localized: "\u041F\u0440\u0438\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u0456 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u0443 \u0412\u0435\u043B\u044C\u0432\u0435\u0442, \u044F\u043A \u0441\u043F\u0440\u0430\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825090
    m_Localized: "\u0411\u0443\u043D\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825091
    m_Localized: "\u0423 \u0431\u0443\u043D\u043A\u0435\u0440\u0456-\u0441\u0445\u043E\u0432\u0438\u0449\u0456
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u043D\u0430\u043F\u0435\u0432\u043D\u043E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u0430\u0433\u0430\u0442\u043E \u0446\u0456\u043D\u043D\u0438\u0445 \u0440\u0435\u0447\u0435\u0439.
      \u0412\u043E\u043D\u0438 \u0445\u043E\u0442\u0456\u043B\u0438 \u043D\u0430\u043F\u0430\u0441\u0442\u0438
      \u043D\u0430 \u0432\u0430\u0448 \u0434\u0456\u043C \u0456 \u0440\u043E\u0437\u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E, \u0442\u043E\u0436 \u0434\u0430\u0439\u0442\u0435
      \u0457\u043C \u0442\u0443 \u0441\u0430\u043C\u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825092
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437
      \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u043E\u044E \u043F\u0440\u043E \u0431\u0443\u043D\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825093
    m_Localized: "\u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438 \u0432
      \u0431\u0443\u043D\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825094
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u0441\u0445\u043E\u0432\u0438\u0449\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825095
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F
      \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825096
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0457 \u0431\u0440\u043E\u043D\u0456,
      \u044F\u043A\u0456 \u0437\u043D\u0430\u0445\u043E\u0434\u044F\u0442\u044C\u0441\u044F
      \u0434\u0435\u0441\u044C \u0443 \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u043E\u043C\u0443
      \u0437\u0430\u0432\u043E\u0434\u0456. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E,
      \u0443 \u043A\u0430\u0431\u0456\u043D\u0435\u0442\u0456 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430
      \u0437\u0430\u0432\u043E\u0434\u0443. \u0410 \u043C\u043E\u0436\u0435 \u0439
      \u043D\u0456, \u043D\u0435 \u0437\u043D\u0430\u044E. \u0410\u043B\u0435 \u0434\u0443\u043C\u0430\u044E,
      \u0449\u043E \u0441\u0430\u043C\u0435 \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825097
    m_Localized: "\u0414\u043E\u0431\u0443\u0442\u0438 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F
      \u0431\u0440\u043E\u043D\u0456 \u0456\u0437 \u0441\u0435\u0439\u0444\u0430
      \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825098
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825099
    m_Localized: "\u041A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825100
    m_Localized: "\u0428\u0443\u043A\u0430\u0454\u0448 \u0440\u043E\u0431\u043E\u0442\u0443?
      \u0404 \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u043E\u0434\u043D\u0435
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F. \u0422\u0438 \u0432\u0436\u0435
      \u0431\u0443\u0432\u0430\u043B\u0430 \u043D\u0430 \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u043E\u043C\u0443
      \u0437\u0430\u0432\u043E\u0434\u0456? \u0422\u0430\u043C \u0434\u043E\u0432\u043E\u043B\u0456
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E, \u0430\u043B\u0435
      \u0439 \u0443\u0441\u044F\u043A\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0430
      \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u0434\u043E\u0431\u0443\u0442\u0438
      \u0447\u0438\u043C\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825101
    m_Localized: "\u0420\u043E\u0437\u0443\u043C\u0456\u044E. \u0422\u0435\u0431\u0435
      \u0446\u0456\u043A\u0430\u0432\u0438\u0442\u044C \u0449\u043E\u0441\u044C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825102
    m_Localized: "\u0421\u0430\u043C\u0435 \u0442\u0430\u043A. \u042F \u0456 \u0441\u0430\u043C
      \u0432\u0438\u043D\u0456\u0441 \u0456\u0437 \u0446\u044C\u043E\u0433\u043E
      \u043C\u0456\u0441\u0446\u044F \u0447\u0438\u043C\u0430\u043B\u043E \u0446\u0456\u043D\u043D\u043E\u0441\u0442\u0435\u0439,
      \u0430\u043B\u0435 \u0454 \u043E\u0434\u043D\u0430 \u0440\u0456\u0447, \u044F\u043A\u0443
      \u043C\u0435\u043D\u0456 \u0437\u043D\u0430\u0439\u0442\u0438 \u043D\u0435
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F. \u0412 \u043E\u0434\u043D\u043E\u043C\u0443
      \u0437 \u043F\u0440\u0430\u0446\u044E\u044E\u0447\u0438\u0445 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432
      \u044F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E
      \u043F\u0440\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438,
      \u044F\u043A\u0456 \u0432\u0435\u0434\u0443\u0442\u044C\u0441\u044F \u043D\u0430
      \u0437\u0430\u0432\u043E\u0434\u0456. \u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u0446\u0435 \u0431\u0443\u043B\u0430
      \u044F\u043A\u0430\u0441\u044C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0430
      \u0431\u0440\u043E\u043D\u044F, \u0430\u043B\u0435 \u0434\u043E\u043A\u043B\u0430\u0434\u043D\u043E\u0457
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457 \u0442\u0430\u043C
      \u043D\u0435 \u0431\u0443\u043B\u043E. \u0410 \u043C\u0435\u043D\u0456 \u0437\u0430
      \u0440\u043E\u0434\u043E\u043C \u0434\u0456\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0456
      \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0446\u0456\u043A\u0430\u0432\u0438\u0442\u0438\u0441\u044F
      \u0442\u0430\u043A\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825103
    m_Localized: "\u0406 \u0442\u0438 \u0445\u043E\u0447\u0435\u0448 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0446\u044E \u0431\u0440\u043E\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825104
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E. \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430,
      \u044F \u0441\u0443\u043C\u043D\u0456\u0432\u0430\u044E\u0441\u044F, \u0449\u043E
      \u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0448 \u0441\u0430\u043C\u0443
      \u0431\u0440\u043E\u043D\u044E, \u0434\u043E \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u0440\u043E\u0431\u043E\u0447\u043E\u0433\u043E \u0437\u0440\u0430\u0437\u043A\u0430
      \u0441\u043F\u0440\u0430\u0432\u0430 \u0442\u0430\u043A \u0456 \u043D\u0435
      \u0434\u0456\u0439\u0448\u043B\u0430. \u0410\u043B\u0435 \u043C\u0435\u043D\u0456
      \u0431 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u044C
      \u0456 \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u043E\u0457 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457.
      \u0422\u043E\u0431\u0456 \u0432\u0456\u0434 \u043D\u0438\u0445 \u0443\u0441\u0435
      \u043E\u0434\u043D\u043E \u043D\u0435 \u0431\u0443\u0434\u0435 \u0436\u043E\u0434\u043D\u043E\u0457
      \u043A\u043E\u0440\u0438\u0441\u0442\u0456, \u0430 \u044F \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u043F\u043B\u0430\u0447\u0443,
      \u0430 \u0439, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u043C\u043E\u0436\u0443
      \u0446\u044E \u0431\u0440\u043E\u043D\u044E \u0432\u0456\u0434\u0442\u0432\u043E\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825105
    m_Localized: "\u041E\u0441\u044C, \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044F,
      \u0446\u0435 \u0442\u0435, \u0449\u043E \u0442\u0438 \u0448\u0443\u043A\u0430\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825106
    m_Localized: "\u0414\u0430\u0439-\u043D\u043E \u043F\u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825107
    m_Localized: "\u0425\u043C... \u0422\u0430\u043A, \u0437\u0432\u0456\u0441\u043D\u043E,
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u0441\u043A\u043B\u0430\u0434\u043D\u043E
      \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438. \u0410\u043B\u0435
      \u0442\u0435, \u0449\u043E \u0446\u0456 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F
      \u043F\u043E \u043C\u043E\u0457\u0439 \u0447\u0430\u0441\u0442\u0438\u043D\u0456,
      \u043C\u043E\u0436\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825108
    m_Localized: "\u0406 \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0437\u0430 \u043D\u0438\u043C\u0438 \u0431\u0440\u043E\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825109
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E. \u041C\u0435\u043D\u0456
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0441\u043F\u0435\u0440\u0448\u0443
      \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u043E \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0432 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F\u0445, \u0430
      \u043F\u043E\u0442\u0456\u043C \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0440\u0435\u0432\u0456\u0437\u0456\u044E \u0437\u0430\u043F\u0430\u0441\u0456\u0432
      \u0449\u043E\u0434\u043E \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0445
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432 \u0430\u0431\u043E
      \u0431\u0456\u043B\u044C\u0448-\u043C\u0435\u043D\u0448 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0445
      \u0437\u0430\u043C\u0456\u043D\u043D\u0438\u043A\u0456\u0432. \u0410\u043B\u0435
      \u0431\u0443\u0434\u044C \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430,
      \u044F\u043A\u0449\u043E \u0432 \u043C\u0435\u043D\u0435 \u0432\u0438\u0439\u0434\u0435,
      \u0442\u043E\u0431\u0456 \u044F \u043F\u0435\u0440\u0448\u043E\u044E \u043F\u0440\u043E
      \u0446\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825110
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      - \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0434\u0435\u0442\u0430\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825111
    m_Localized: "\u0421\u043A\u0430\u0436\u0438, \u0430 \u0447\u0438 \u043D\u0435
      \u043F\u0440\u043E\u0434\u0430\u0454\u0448 \u0442\u0438 \u0441\u0438\u043B\u043E\u0432\u0443
      \u0431\u0440\u043E\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825112
    m_Localized: "\u0427\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825113
    m_Localized: "\u0429\u043E \u043D\u0430\u0432\u0435\u043B\u043E \u0442\u0435\u0431\u0435
      \u043D\u0430 \u0434\u0443\u043C\u043A\u0443, \u0449\u043E \u044F \u043C\u043E\u0436\u0443
      \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438 \u0441\u0438\u043B\u043E\u0432\u0443
      \u0431\u0440\u043E\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825114
    m_Localized: "\u0410\u0434\u0436\u0435 \u0442\u0438 \u0431\u0440\u043E\u043D\u043D\u0438\u043A?
      \u0410 \u0441\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      - \u0442\u0435\u0436 \u0431\u0440\u043E\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825115
    m_Localized: "\u0422\u0438 \u0437\u0430\u0440\u0430\u0437 \u0436\u0430\u0440\u0442\u0443\u0454\u0448,
      \u0442\u0430\u043A? \u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0454 \u0442\u0456\u043B\u044C\u043A\u0438 \u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0442\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F \u0440\u043E\u0431\u043E\u0442\u0438
      \u043F\u0440\u0438\u043B\u0430\u0434\u0456\u0432 \u0456 \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430,
      \u0442\u0432\u043E\u0457 \u0437\u043D\u0430\u043D\u043D\u044F \u043D\u0435
      \u0434\u0430\u0434\u0443\u0442\u044C \u0442\u043E\u0431\u0456 \u043D\u0456\u0447\u043E\u0433\u043E
      \u0431\u0435\u0437 \u0433\u043E\u0442\u043E\u0432\u0438\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825116
    m_Localized: "\u0422\u043E\u0431\u0442\u043E \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0457\u0457 \u043C\u043E\u0436\u043D\u0430 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825117
    m_Localized: "\u0425\u043C\u043C. \u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456,
      \u044F\u043A\u0449\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438,
      \u0442\u043E \u043D\u0456. \u041D\u0435 \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u0432\u0438\u043D\u0430\u0439\u0448\u043B\u0438
      \u0446\u044E \u0431\u0440\u043E\u043D\u044E, \u0457\u0457 \u0431\u0443\u043B\u043E
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E \u0449\u0435 \u0434\u043E
      \u043F\u0430\u0434\u0456\u043D\u043D\u044F \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C.
      \u0422\u043E\u043C\u0443 \u0442\u0430\u043A\u0443 \u0431\u0440\u043E\u043D\u044E
      \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0439\u0442\u0438 \u0431\u0435\u0437\u0445\u0430\u0437\u044F\u0439\u043D\u043E\u044E
      \u043D\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0456\u0439
      \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0456\u0439 \u0431\u0430\u0437\u0456.
      \u041C\u043E\u0436\u043D\u0430 \u043D\u0430\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0442\u0438\u0441\u044F
      \u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u043A\u0438 \u0437\u0430\u0433\u0438\u0431\u043B\u043E\u0433\u043E
      \u043F\u0430\u0442\u0440\u0443\u043B\u044F. \u041C\u043E\u0436\u043D\u0430
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u0438
      \u0457\u0457 \u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432,
      \u044F\u043A\u0449\u043E \u0441\u0438\u043B \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C.
      \u042F\u043A\u0449\u043E \u0442\u043E\u0431\u0456 \u0446\u0435 \u0434\u0443\u0436\u0435
      \u0442\u0440\u0435\u0431\u0430, \u0442\u043E \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438
      \u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825118
    m_Localized: "\u041E\u0442\u0436\u0435, \u0446\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E?
      \u0427\u0443\u0434\u043E\u0432\u043E! \u0422\u043E\u0434\u0456 \u0437 \u043C\u0435\u043D\u0435
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825119
    m_Localized: "\u042F \u043C\u043E\u0436\u0443 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0441\u0438\u043B\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435. \u041F\u0440\u0438\u043D\u0435\u0441\u0435\u0448
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0447\u0456 -
      \u0437\u0440\u043E\u0431\u043B\u044E. \u042F \u043F\u0456\u0434\u0436\u0435\u043D\u0443
      \u0457\u0457 \u043F\u0456\u0434 \u0442\u0432\u0456\u0439 \u0440\u043E\u0437\u043C\u0456\u0440,
      \u044F\u043A\u0449\u043E \u0446\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0456 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0443\u044E \u0448\u043E\u043B\u043E\u043C
      \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u0439\u043E\u0433\u043E
      \u043C\u043E\u0433\u043B\u0438 \u043D\u043E\u0441\u0438\u0442\u0438 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438.
      \u0410\u043B\u0435 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0449\u0435 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0438 \u0437\u0430
      \u0440\u043E\u0431\u043E\u0442\u0443... \u0441\u043A\u0430\u0436\u0456\u043C\u043E...
      \u0434\u0432\u0430\u0434\u0446\u044F\u0442\u044C \u0442\u0438\u0441\u044F\u0447
      \u043A\u0440\u0438\u0448\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825122
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0441\u0430\u043F\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825123
    m_Localized: "@lp, \u043C\u043E\u0436\u0443 \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0432\u0456\u0442\u0430\u0442\u0438
      - \u0442\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430 \u0441\u0435\u0431\u0435
      \u0441\u0443\u043C\u043B\u0456\u043D\u043D\u0438\u043C \u043F\u0430\u0440\u0442\u043D\u0435\u0440\u043E\u043C.
      \u041F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F,
      \u044F\u043A\u0456 \u0442\u0438 \u0434\u0456\u0441\u0442\u0430\u043B\u0430?
      \u0412\u043E\u043D\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043C\u0456\u0441\u0442\u0438\u043B\u0438
      \u0432\u0441\u044E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0443 \u043C\u0435\u043D\u0456
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E. \u042F \u0432
      \u043D\u0438\u0445 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0432\u0441\u044F
      \u0456 \u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044F \u043D\u0430\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u043E \u043D\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0446\u0435 \u043D\u0435 \u0432 \u043C\u043E\u0457\u0445 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445,
      \u0430\u043B\u0435 \u0442\u043E\u0431\u0456, \u044F\u043A \u043A\u043E\u043B\u0438\u0448\u043D\u044C\u043E\u043C\u0443
      \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0443 \u0446\u0438\u0445 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u044C,
      \u044F \u0433\u043E\u0442\u043E\u0432\u0438\u0439 \u043D\u0430\u0434\u0430\u0442\u0438
      \u0445\u043E\u0440\u043E\u0448\u0443 \u0437\u043D\u0438\u0436\u043A\u0443 \u043D\u0430
      \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0439 \u0437\u0430
      \u043D\u0438\u043C\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825124
    m_Localized: "\u041E, \u0456 \u0449\u043E \u0446\u0435 \u0437\u0430 \u043D\u043E\u0432\u0430
      \u0431\u0440\u043E\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825125
    m_Localized: "\u0423 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457
      \u0432\u043E\u043D\u0430 \u043D\u0430\u0437\u0438\u0432\u0430\u043B\u0430\u0441\u044F
      \"\u0411\u0440\u043E\u043D\u0435\u044E \u0441\u0430\u043F\u0435\u0440\u0430\".
      \u0412\u043E\u043D\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0430
      \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u043D\u043E\u0441\u0456\u044F
      \u0432\u0456\u0434 \u043F\u043E\u0432\u0456\u0442\u0440\u044F\u043D\u043E\u0457
      \u0443\u0434\u0430\u0440\u043D\u043E\u0457 \u0445\u0432\u0438\u043B\u0456,
      \u0432\u043E\u0433\u043D\u044E, \u043E\u0441\u043A\u043E\u043B\u043A\u0456\u0432
      \u0456 \u043D\u0430\u0434\u043B\u0438\u0448\u043A\u043E\u0432\u043E\u0433\u043E
      \u0442\u0438\u0441\u043A\u0443, \u0449\u043E \u0432\u0438\u043D\u0438\u043A\u0430\u044E\u0442\u044C
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u043F\u0456\u0434\u0440\u0438\u0432\u0443
      \u043C\u0456\u043D \u0456 \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432
      \u0443 \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u0456\u0439
      \u0431\u043B\u0438\u0437\u044C\u043A\u043E\u0441\u0442\u0456 \u0432\u0456\u0434
      \u043F\u043E\u043D\u0456. \u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E,
      \u0443 \u043C\u0435\u043D\u0435 \u043D\u0435 \u0431\u0443\u043B\u043E \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0445
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432, \u0456 \u043C\u0435\u043D\u0456
      \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u0456\u043C\u043F\u0440\u043E\u0432\u0456\u0437\u0443\u0432\u0430\u0442\u0438
      \u0437 \u0442\u0438\u043C, \u0449\u043E \u0454. \u0422\u0430 \u0439 \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F \u0431\u0440\u043E\u043D\u0435\u043F\u043E\u043A\u0440\u0438\u0442\u0442\u044F
      \u0442\u0430 \u0456\u0437\u043E\u043B\u044F\u0446\u0456\u0457 \u0432 \u0443\u043C\u043E\u0432\u0430\u0445
      \u043C\u043E\u0454\u0457 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u0456
      \u0434\u043E\u043C\u043E\u0433\u0442\u0438\u0441\u044F \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E.
      \u0410\u043B\u0435 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u0446\u0435
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435, \u0449\u043E \u043C\u043E\u0436\u043D\u0430
      \u0437\u0430\u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044E \u043F\u043E\u0433\u0440\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825126
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      - \u043E\u0447\u0456\u043A\u0443\u0454\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825127
    m_Localized: "\u041D\u0443 \u0449\u043E, \u0446\u0438\u0445 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0456\u0432
      \u0431\u0440\u043E\u043D\u0456 \u0442\u043E\u0431\u0456 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C,
      \u0449\u043E\u0431 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043E\u0434\u0438\u043D
      \u0440\u043E\u0431\u043E\u0447\u0438\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825128
    m_Localized: "\u0414\u0443\u043C\u0430\u044E, \u0449\u043E \u0442\u0430\u043A.
      \u041C\u0430\u0454 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u0438.
      \u0414\u0430\u0432\u0430\u0439 \u0457\u0445 \u0441\u044E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825129
    m_Localized: "\u0406 \u044F\u043A \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u0430\u0441\u0443
      \u0437\u0430\u0439\u043C\u0435 \u0440\u043E\u0431\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825130
    m_Localized: "\u0411\u0435\u0437 \u043F\u043E\u043D\u044F\u0442\u0442\u044F!
      \u0414\u0435\u043D\u044C, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0430
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0456 \u0442\u0438\u0436\u0434\u0435\u043D\u044C.
      \u041C\u043E\u0436\u0435, \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u044F\u043A\u043E\u0457\u0441\u044C
      \u0441\u0445\u0435\u043C\u0438 \u043D\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C,
      \u0456 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0442\u043E\u0431\u0456
      \u0434\u043E\u0431\u0443\u0442\u0438 \u0449\u0435 \u0439 \u0457\u0457. \u0410\u0434\u0436\u0435
      \u044F \u043D\u0456\u043A\u043E\u043B\u0438 \u0440\u0430\u043D\u0456\u0448\u0435
      \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0435 \u0440\u043E\u0431\u0438\u0432.
      \u0422\u0438 \u0437\u0430\u0433\u043B\u044F\u0434\u0430\u0439 \u0447\u0430\u0441
      \u0432\u0456\u0434 \u0447\u0430\u0441\u0443, \u0430 \u044F \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044E,
      \u043A\u043E\u043B\u0438 \u0431\u0443\u0434\u0435 \u0433\u043E\u0442\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825131
    m_Localized: "\u0410 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u0434\u0435
      \u043F\u0456\u0434 \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442
      \u043C\u043E\u0454\u0457 \u0431\u0440\u043E\u043D\u0456 \u043F\u0440\u0438\u043A\u0440\u0456\u043F\u0438\u0442\u0438
      \u0449\u0435 \u0439..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825132
    m_Localized: "\u041D\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825133
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      - \u0433\u043E\u0442\u043E\u0432\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825134
    m_Localized: "\u0422\u0432\u043E\u044F \u0441\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0433\u043E\u0442\u043E\u0432\u0430. \u0417\u0430\u043F\u043B\u0430\u0442\u0438
      \u043E\u0431\u0443\u043C\u043E\u0432\u043B\u0435\u043D\u0443 \u0441\u0443\u043C\u0443
      \u0456 \u0437\u0430\u0431\u0438\u0440\u0430\u0439. \u0426\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      - \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0440\u043E\u0431\u043E\u0442\u0430,
      \u043D\u0456\u043A\u043E\u043C\u0443 \u0431\u0456\u043B\u044C\u0448\u0435 \u0442\u0430\u043A\u0438\u0439
      \u0440\u043E\u0437\u043C\u0456\u0440 \u043D\u0435 \u043F\u0456\u0434\u0456\u0439\u0434\u0435.
      \u0422\u043E\u043C\u0443 \u044F \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u044E,
      \u0449\u043E \u0442\u043E\u0431\u0456 \u0446\u0435 \u043F\u043E \u043A\u0438\u0448\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825135
    m_Localized: "\u0423\u0445 \u0442\u0438! \u0412\u043E\u043D\u0430 \u0442\u0430\u043A\u0430
      \u0436 \u043A\u0440\u0443\u0442\u0430, \u044F\u043A \u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825136
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E \u0436 \u043D\u0456. \u0423
      \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E\u0433\u043E
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F, \u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u043D\u0456
      \u0442\u043E\u0431\u043E\u044E \u0434\u0435\u0442\u0430\u043B\u0456 \u043C\u0430\u043B\u0438
      \u0431\u0435\u0437\u043B\u0456\u0447 \u0434\u0435\u0444\u0435\u043A\u0442\u0456\u0432
      \u0432\u0456\u0434 \u0437\u0430\u0432\u0434\u0430\u043D\u0438\u0445 \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C,
      \u0442\u043E\u0436 \u0431\u0430\u0433\u0430\u0442\u044C\u043C\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044F\u043C\u0438
      \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u0443\u0432\u0430\u0442\u0438.
      \u041E\u0434\u043D\u0430\u043A \u0456 \u0442\u043E\u0433\u043E, \u0449\u043E
      \u0454, \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C \u0434\u043B\u044F
      \u043D\u0430\u0434\u0456\u0439\u043D\u043E\u0433\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443
      \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445
      \u0432\u0438\u0434\u0456\u0432 \u0430\u0442\u0430\u043A. \u042F \u043F\u043E\u0444\u0430\u0440\u0431\u0443\u0432\u0430\u0432
      \u0457\u0457 \u0443 \u0437\u0443\u0445\u0432\u0430\u043B\u043E-\u043F\u043E\u043C\u0430\u0440\u0430\u043D\u0447\u0435\u0432\u0438\u0439
      \u043A\u043E\u043B\u0456\u0440, \u044F\u043A\u0438\u0439 \u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E
      \u044F\u0441\u043D\u043E \u0434\u043E\u043D\u0435\u0441\u0435 \u0442\u0432\u043E\u0457\u043C
      \u0432\u043E\u0440\u043E\u0433\u0430\u043C, \u0449\u043E \u0446\u0435 \u0457\u043C
      \u0442\u0440\u0435\u0431\u0430 \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F,
      \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0442\u0438 \u043D\u0435
      \u043C\u0430\u0454\u0448 \u043D\u0430\u043C\u0456\u0440\u0443. \u0422\u0435,
      \u0449\u043E \u0432\u043E\u0440\u043E\u0433 \u0431\u0430\u0447\u0438\u0442\u044C,
      \u0442\u043E\u0433\u043E \u0432\u0456\u043D \u0441\u043A\u043E\u0440\u043E
      \u043D\u0430\u0432\u0447\u0438\u0442\u044C\u0441\u044F \u0431\u043E\u044F\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825137
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825138
    m_Localized: "\u042F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0448 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0443 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E
      \u043F\u0456\u0434 \u0442\u0432\u043E\u0457 \u043F\u043E\u0442\u0440\u0435\u0431\u0438
      \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E, \u0434\u0456\u0441\u0442\u0430\u043D\u044C
      \u0445\u043E\u0447\u0430 \u0431 \u043A\u0456\u043B\u044C\u043A\u0430 \u0457\u0457
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0456\u0432. \u041C\u0435\u043D\u0456
      \u0431\u0430\u0439\u0434\u0443\u0436\u0435, \u0437\u0432\u0456\u0434\u043A\u0438
      \u0442\u0438 \u0457\u0445 \u0434\u0456\u0441\u0442\u0430\u043D\u0435\u0448,
      \u043E\u0434\u043D\u0430\u043A \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0456
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 \u043C\u0430\u044E\u0442\u044C
      \u0431\u0443\u0442\u0438 \u0432 \u0440\u043E\u0431\u043E\u0447\u043E\u043C\u0443
      \u0441\u0442\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825139
    m_Localized: "\u0414\u043E\u0431\u0443\u0442\u0438 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0438
      \u0441\u0438\u043B\u043E\u0432\u043E\u0457 \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825140
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438
      \u0434\u043B\u044F \u0431\u0440\u043E\u043D\u0456 \u041E\u0443\u043A\u0443
      \u0421\u0442\u0430\u043B\u0432\u043E\u0440\u0442\u0443 \u0456 \u0434\u043E\u0447\u0435\u043A\u0430\u0442\u0438\u0441\u044F
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F \u0440\u043E\u0431\u043E\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825141
    m_Localized: "\u0423\u0431\u0438\u0442\u0438 \u0421\u043A\u0430\u0436\u0435\u043D\u043E\u0433\u043E
      \u041B\u0438\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825142
    m_Localized: "\u0427\u0443\u043B\u0438 \u043F\u0440\u043E \u0431\u0430\u043D\u0434\u0443
      \u0421\u043A\u0430\u0436\u0435\u043D\u043E\u0433\u043E \u041B\u0438\u0441\u0430?
      \u041A\u0430\u0436\u0443\u0442\u044C, \u0457\u0445\u043D\u0454 \u043B\u0456\u0433\u0432\u043E
      \u0434\u0435\u0441\u044C \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u043C\u0443
      \u0437\u0430\u0432\u043E\u0434\u0456. \u0425\u0442\u043E \u0437\u043D\u0430\u0439\u0434\u0435
      \u0456 \u043F\u0440\u0438\u043A\u0456\u043D\u0447\u0438\u0442\u044C \u0446\u0438\u0445
      \u0434\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u0456\u0432, \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u043C\u043E\u044E \u0432\u0456\u0447\u043D\u0443 \u043F\u043E\u0434\u044F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825143
    m_Localized: "\u0423\u0431\u0438\u0442\u0438 \u0421\u043A\u0430\u0436\u0435\u043D\u043E\u0433\u043E
      \u041B\u0438\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825144
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443
      \u0432\u0456\u0434 \u041E\u0443\u043A\u0430 \u0421\u0442\u0430\u043B\u0432\u043E\u0440\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825145
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0444\u0430\u0440\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825146
    m_Localized: "\u0428\u0443\u043A\u0430\u044E \u0431\u0430\u043B\u043E\u043D\u0447\u0438\u043A\u0438
      \u0437 \u0444\u0430\u0440\u0431\u043E\u044E \u0440\u0456\u0437\u043D\u0438\u0445
      \u043A\u043E\u043B\u044C\u043E\u0440\u0456\u0432. \u0414\u043B\u044F \u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u0437\u0456\u0439\u0434\u0443\u0442\u044C \u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456."
    m_Metadata:
      m_Items: []
