  - m_Id: 2725240873
    m_Localized: "\u0428\u0442\u043E\u0440\u043C\u0431\u043B\u0435\u0439\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240874
    m_Localized: "\u0428\u0442\u043E\u0440\u043C\u0445\u0430\u043C\u043C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240875
    m_Localized: "\u041F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A \u0412\u0456\u043D\u0434\u0444\u043B\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240876
    m_Localized: "\u0422\u0440\u0430\u043D\u0437\u0438\u0441\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240877
    m_Localized: "\u041B\u0430\u0439\u043C \u0424\u0456\u0437\u0437\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240878
    m_Localized: "\u0425\u0430\u0440\u0442\u0440\u043E\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240879
    m_Localized: "\u041F\u0440\u043E\u0444\u0435\u0441\u043E\u0440 \u0411\u0440\u0430\u0443\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240880
    m_Localized: "\u0416\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240881
    m_Localized: "\u0424\u0435\u043D\u0456\u043A\u0441, \u044F\u043A\u0438\u0439
      \u043C\u0443\u0442\u0443\u0432\u0430\u0432 \u043F\u0456\u0434 \u0434\u0456\u0454\u044E
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457 \u0456 \u043F\u0440\u0438\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0432\u0441\u044F
      \u0434\u043E \u0436\u0438\u0442\u0442\u044F \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445.
      \u041D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u0431\u043B\u0438\u0432\u0438\u0439
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0439 \u0432\u0438\u0433\u043B\u044F\u0434,
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0434\u043E\u0432\u043E\u043B\u0456
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C \u0447\u0435\u0440\u0435\u0437
      \u0441\u0432\u043E\u044E \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u0432\u0438\u0434\u0438\u0445\u0430\u0442\u0438 \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0435
      \u043F\u043E\u043B\u0443\u043C'\u044F. \u0416\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441
      \u043D\u0435 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0438\u0439 \u0449\u043E\u0434\u043E
      \u0442\u0438\u0445, \u0443 \u0447\u0438\u0457\u0439 \u0434\u0443\u0448\u0456
      \u0449\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F \u0434\u043E\u0431\u0440\u043E
      \u0456 \u0441\u043F\u0456\u0432\u0447\u0443\u0442\u0442\u044F. \u0419\u043E\u0433\u043E
      \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u0438\u0440\u0443\u0447\u0438\u0442\u0438,
      \u0456 \u0442\u043E\u0434\u0456 \u0432\u0456\u043D \u0441\u0442\u0430\u043D\u0435
      \u0432\u0430\u0448\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u043C \u0456
      \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240882
    m_Localized: "\u0420\u043E\u0431\u043E-\u0441\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240883
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439
      \u0440\u043E\u0431\u043E\u0442, \u044F\u043A\u0438\u0439 \u0442\u0430\u043A\u043E\u0436
      \u043C\u043E\u0436\u0435 \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0444\u0443\u043D\u043A\u0446\u0456\u0457 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E\u0433\u043E
      \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u0430 \u0430\u0431\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044F.
      \u041C\u0430\u0454 \u0434\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u043B\u0430\u0437\u0435\u0440 \u044F\u043A \u0437\u0431\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240884
    m_Localized: "\u041F\u043E\u043D\u0456, \u0437\u0435\u0431\u0440\u0438 \u0442\u0430
      \u0433\u0440\u0438\u0444\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240885
    m_Localized: "\u041F\u043E\u043D\u0456 - \u0434\u043E\u043C\u0456\u043D\u0443\u044E\u0447\u0438\u0439
      \u0432\u0438\u0434 \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u0445 \u0456\u0441\u0442\u043E\u0442,
      \u0449\u043E \u043D\u0430\u0441\u0435\u043B\u044F\u044E\u0442\u044C \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E.
      \u041F\u043E\u0434\u0456\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      \u0442\u0440\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u0456 \u0440\u0430\u0441\u0438:
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438, \u043F\u0435\u0433\u0430\u0441\u0438
      \u0442\u0430 \u0437\u0435\u043C\u043D\u0456 \u043F\u043E\u043D\u0456. \u041A\u043E\u0436\u043D\u0430
      \u0440\u0430\u0441\u0430 \u043C\u0430\u0454 \u0441\u0432\u043E\u0457 \u0441\u0438\u043B\u044C\u043D\u0456
      \u0441\u0442\u043E\u0440\u043E\u043D\u0438. \u0404\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438
      \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u0434\u0430\u0440\u043E\u043C
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443, \u0430 \u0437\u0430
      \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0433\u043E \u043D\u0430\u0432\u0447\u0430\u043D\u043D\u044F
      \u0437\u0434\u0430\u0442\u043D\u0456 \u043E\u0432\u043E\u043B\u043E\u0434\u0456\u0442\u0438
      \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0438\u043C\u0438
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C\u0438;
      \u043F\u0435\u0433\u0430\u0441\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u043B\u0456\u0442\u0430\u0442\u0438;
      \u043D\u0443 \u0430 \u0437\u0435\u043C\u043D\u0456 \u043F\u043E\u043D\u0456
      \u0437 \u0443\u0441\u0456\u0445 \u0440\u0430\u0441 \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456,
      \u043D\u0430\u0439\u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0448\u0456
      \u0442\u0430 \u043D\u0430\u0439\u0436\u0438\u0432\u0443\u0447\u0456\u0448\u0456.
      \u041D\u0438\u043D\u0456 \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445
      \u0443 \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u044F\u0445
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432 \u0456 \u0437\u0435\u043C\u043D\u0438\u0445
      \u043F\u043E\u043D\u0456. \u041F\u0435\u0433\u0430\u0441\u0438 \u0436 \u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u0432\u043A\u0440\u0430\u0439 \u0440\u0456\u0434\u043A\u043E, \u0431\u043E
      \u043C\u0430\u0439\u0436\u0435 \u0432\u0441\u0456 \u0432\u043E\u043D\u0438
      \u0436\u0438\u0432\u0443\u0442\u044C \u0443 \u0441\u0432\u043E\u0457\u0445
      \u0445\u043C\u0430\u0440\u043D\u0438\u0445 \u043C\u0456\u0441\u0442\u0430\u0445
      \u0456 \u043D\u0435 \u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E. \u0417\u0435\u0431\u0440\u0438
      - \u0436\u0438\u0442\u0435\u043B\u0456 \u0434\u0430\u043B\u0435\u043A\u043E\u0457
      \u043A\u0440\u0430\u0457\u043D\u0438, \u0433\u043E\u043B\u043E\u0432\u043D\u0456
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438 \u043F\u043E\u043D\u0456
      \u0443 \u0412\u0435\u043B\u0438\u043A\u0456\u0439 \u0412\u0456\u0439\u043D\u0456.
      \u041D\u0438\u043D\u0456 \u0457\u0445\u043D\u0456\u0445 \u043D\u0430\u0449\u0430\u0434\u043A\u0456\u0432
      \u0434\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u043E \u043C\u043E\u0436\u043D\u0430
      \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438 \u0432 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457,
      \u0456, \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430
      \u043C\u0438\u043D\u0443\u043B\u0456 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F,
      \u043A\u043E\u043B\u0438\u0448\u043D\u044F \u0432\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0430
      \u0449\u0435 \u043D\u0435 \u0437\u0430\u0431\u0443\u0442\u0430. \u0417\u0435\u0431\u0440\u0438
      \u043D\u0435 \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u043C\u0430\u0433\u0456\u0454\u044E,
      \u044F\u043A \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438, \u0430\u043B\u0435
      \u043C\u043E\u0436\u0443\u0442\u044C \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437\u043C\u043E\u0432\u0430\u043C\u0438, \u043F\u0440\u043E\u043A\u043B\u044C\u043E\u043D\u0430\u043C\u0438,
      \u0437\u0456\u043B\u043B\u044F\u043C \u0456 \u0430\u043C\u0443\u043B\u0435\u0442\u0430\u043C\u0438,
      \u0430 \u0434\u0435\u0445\u0442\u043E \u0449\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u0454
      \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0454 \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043E
      \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0456\u0457. \u0413\u0440\u0438\u0444\u043E\u043D\u0456\u0432
      \u0432 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457 \u043D\u0435
      \u0442\u0430\u043A \u0443\u0436\u0435 \u0439 \u0431\u0430\u0433\u0430\u0442\u043E,
      \u0456 \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0456\u0437
      \u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u0432 \u0437\u0430\u0433\u043E\u043D\u0430\u0445 \u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456\u0432.
      \u0424\u0456\u0437\u0438\u0447\u043D\u043E \u0432\u043E\u043D\u0438 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456
      \u0437\u0430 \u043F\u043E\u043D\u0456 \u0456 \u043C\u0430\u044E\u0442\u044C
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u043E \u043F\u043E\u043B\u044C\u043E\u0442\u0443,
      \u0430\u043B\u0435 \u043D\u0435 \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C
      \u0436\u043E\u0434\u043D\u043E\u044E \u043C\u0430\u0433\u0456\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240886
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240887
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440\u0438 - \u0446\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u0438,
      \u0437\u0435\u043C\u043D\u0456 \u043F\u043E\u043D\u0456 \u0442\u0430 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438,
      \u044F\u043A\u0456 \u0436\u0438\u0432\u0443\u0442\u044C \u0437\u0430 \u0440\u0430\u0445\u0443\u043D\u043E\u043A
      \u0440\u043E\u0437\u0431\u043E\u044E, \u0433\u0440\u0430\u0431\u0435\u0436\u0456\u0432
      \u0456 \u043D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0430. \u0426\u0435
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454 \u043B\u0438\u0445\u043E \u041F\u0443\u0441\u0442\u043E\u043A,
      \u0443 \u044F\u043A\u0438\u0445 \u0437\u043B\u0438\u043B\u0438\u0441\u044F
      \u0432\u043E\u0454\u0434\u0438\u043D\u043E \u043D\u0430\u0439\u0433\u0456\u0440\u0448\u0456
      \u0440\u0438\u0441\u0438 \u0439 \u043F\u043E\u0440\u043E\u043A\u0438. \u0420\u0435\u0439\u0434\u0435\u0440\u0438,
      \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0456, \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0456,
      \u0436\u0430\u0434\u0456\u0431\u043D\u0456, \u043F\u0456\u0434\u043B\u0456,
      \u0430 \u0447\u0430\u0441\u0442\u043E \u0456 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0456. \u041D\u0430
      \u0432\u0438\u0433\u043B\u044F\u0434 \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0440\u0443\u0434\u043D\u0456,
      \u043E\u0431\u0456\u0440\u0432\u0430\u043D\u0456 \u0442\u0430 \u0432\u043A\u0440\u0438\u0442\u0456
      \u0448\u0440\u0430\u043C\u0430\u043C\u0438. \u0420\u0435\u0439\u0434\u0435\u0440\u0438
      \u0447\u0430\u0441\u0442\u043E \u0437\u0431\u0438\u0432\u0430\u044E\u0442\u044C\u0441\u044F
      \u0432 \u0437\u0433\u0440\u0430\u0457 \u0430\u0431\u043E \u043D\u0430\u0432\u0456\u0442\u044C
      \u0432\u0435\u043B\u0438\u043A\u0456 \u0431\u0430\u043D\u0434\u0438, \u044F\u043A\u0438\u043C\u0438
      \u043A\u0435\u0440\u0443\u044E\u0442\u044C \u0432\u0430\u0442\u0430\u0436\u043A\u0438.
      \u0412\u043E\u043D\u0438 \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u0441\u043E\u0431\u0456 \u043B\u0456\u0433\u0432\u0430 \u0432 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438\u0445
      \u0431\u0443\u0434\u0456\u0432\u043B\u044F\u0445, \u0437\u0432\u0456\u0434\u043A\u0438
      \u0437\u0440\u0443\u0447\u043D\u043E \u0437\u0434\u0456\u0439\u0441\u043D\u044E\u0432\u0430\u0442\u0438
      \u043D\u0430\u043B\u044C\u043E\u0442\u0438 \u043D\u0430 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0436 \u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438
      \u0442\u043E\u0440\u0433\u043E\u0432\u0456 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0438
      \u0456 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0438\u0445 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0456\u0445.
      \u0411\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E, \u0445\u0442\u043E
      \u0432\u0442\u043E\u0440\u0433\u0441\u044F \u043D\u0430 \u0457\u0445\u043D\u044E
      \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044E, \u0432\u043E\u043D\u0438
      \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u0441\u043F\u0440\u043E\u0431\u0443\u044E\u0442\u044C
      \u0443\u0431\u0438\u0442\u0438. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043F\u043E\u0433\u0430\u043D\u043E,
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0430\u0431\u043E \u0441\u0442\u0430\u0440\u043E\u044E
      \u0456 \u0432\u0431\u0438\u0442\u043E\u044E \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E, \u0430 \u0431\u0440\u043E\u043D\u044E
      \u043C\u0430\u0439\u0441\u0442\u0440\u0443\u044E\u0442\u044C \u0437 \u0440\u0456\u0437\u043D\u043E\u0433\u043E
      \u043C\u043E\u0442\u043B\u043E\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240888
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u0441\u0430\u0434\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240889
    m_Localized: "\u041F\u0441\u0438\u0445\u0438 \u0456 \u043C\u0430\u043D\u0456\u044F\u043A\u0438,
      \u044F\u043A\u0456 \u043F\u043E\u043D\u0430\u0434 \u0443\u0441\u0435 \u043D\u0430
      \u0441\u0432\u0456\u0442\u0456 \u043E\u0431\u043E\u0436\u043D\u044E\u044E\u0442\u044C
      \u0442\u043E\u0440\u0442\u0443\u0440\u0438 \u0456 \u0440\u0456\u0437\u043D\u0456
      \u0437\u043D\u0443\u0449\u0430\u043D\u043D\u044F \u043D\u0430\u0434 \u0441\u0432\u043E\u0457\u043C\u0438
      \u0436\u0435\u0440\u0442\u0432\u0430\u043C\u0438. \u0423 \u0431\u043E\u044E
      \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u043D\u0430
      \u0445\u043E\u043B\u043E\u0434\u043D\u0443 \u0437\u0431\u0440\u043E\u044E \u0430\u0431\u043E
      \u0436 \u043D\u0430 \u0432\u043B\u0430\u0441\u043D\u0456 \u043A\u043E\u043F\u0438\u0442\u0430
      \u0456 \u0434\u0443\u0431\u043E\u0432\u0435 \u0447\u043E\u043B\u043E. \u0427\u0435\u0440\u0435\u0437
      \u0431\u0435\u0437\u0433\u043B\u0443\u0437\u0434\u0443 \u0437\u0432\u0438\u0447\u043A\u0443
      \"\u043F\u0440\u0438\u043A\u0440\u0430\u0448\u0430\u0442\u0438\" \u0441\u0432\u043E\u0457
      \u043E\u0441\u0435\u043B\u0456 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0442\u0440\u0443\u043F\u0456\u0432, \u0449\u043E \u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F,
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0447\u0438\u043C\u043E\u0441\u044C
      \u0445\u0432\u043E\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240890
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u0432\u043E\u043B\u043E\u0446\u044E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240891
    m_Localized: "\u0412\u0432\u0430\u0436\u0430\u044E\u0442\u044C\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C\u0438
      \u043F\u043E\u043A\u0438\u0434\u044C\u043A\u0430\u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0437\u0430 \u043C\u0456\u0440\u043A\u0430\u043C\u0438 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432.
      \u0412\u043E\u043D\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u043E\u0434\u044F\u0433\u043D\u0435\u043D\u0456
      \u0432 \u043B\u0430\u0445\u043C\u0456\u0442\u0442\u044F, \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u043D\u0435\u043F\u043E\u0442\u0440\u0435\u0431\u043E\u043C,
      \u0430 \u0457\u0445\u043D\u0454 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F
      \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u043D\u0435 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u043C
      \u0432\u0436\u0438\u0432\u0430\u043D\u043D\u044F\u043C \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044E
      \u0456 \u043D\u0430\u0440\u043A\u043E\u0442\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240892
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u043C\u0435\u0442\u0430\u043B\u0456\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240893
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440\u0438 \u0437 \u0431\u0430\u043D\u0434\u0438
      \u041C\u0435\u0442\u0430\u043B\u0456\u0441\u0442\u0456\u0432 \u043E\u0431\u043E\u0436\u043D\u044E\u044E\u0442\u044C
      \u043E\u0431\u0432\u0456\u0448\u0443\u0432\u0430\u0442\u0438 \u0441\u0435\u0431\u0435
      \u0440\u0456\u0437\u043D\u0438\u043C\u0438 \u0437\u0430\u043B\u0456\u0437\u044F\u043A\u0430\u043C\u0438,
      \u044F\u043A\u0456 \u0432\u043E\u043D\u0438 \u0441\u0430\u043C\u0456 \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C
      \u0431\u0440\u043E\u043D\u0435\u044E. \u0427\u0435\u0440\u0435\u0437 \u0446\u0435
      \u0432\u043E\u043D\u0438 \u0432\u0430\u0436\u043A\u0456 \u0439 \u043D\u0435\u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043A\u0456,
      \u0430\u043B\u0435 \u0437\u0430\u0442\u0435 \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E
      \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0456 \u0432\u0456\u0434 \u043A\u0443\u043B\u044C
      \u0456 \u0443\u0434\u0430\u0440\u0456\u0432. \u041A\u043E\u0440\u0438\u0441\u0442\u0443\u044E\u0442\u044C\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E
      \u0430\u0431\u043E \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0448\u0438\u043F\u0438, \u0449\u043E \u043F\u0440\u0438\u043A\u0440\u0430\u0448\u0430\u044E\u0442\u044C
      \u0457\u0445\u043D\u0456 \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240894
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u0440\u043E\u0437\u043F\u0443\u0441\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240895
    m_Localized: "\u0411\u0430\u043D\u0434\u0430 \u0420\u043E\u0437\u043F\u0443\u0441\u043D\u0438\u043A\u0456\u0432
      - \u043E\u0441\u0435\u0440\u0435\u0434\u043E\u043A \u0443\u0441\u0456\u0445
      \u0432\u0456\u0434\u043E\u043C\u0438\u0439 \u043F\u043E\u0440\u043E\u043A\u0456\u0432.
      \u0412\u043E\u043D\u0438 \u0437\u043B\u0456\u0441\u043D\u0456, \u0436\u0430\u0434\u0456\u0431\u043D\u0456,
      \u0445\u0442\u0438\u0432\u0456 - \u0441\u043B\u043E\u0432\u043E\u043C, \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456
      \u0432\u0456\u0434\u043C\u043E\u0440\u043E\u0437\u043A\u0438. \u041B\u044E\u0431\u043B\u044F\u0442\u044C
      \u0432\u0435\u043B\u0438\u043A\u0443 \u0456 \u0432\u0430\u0436\u043A\u0443
      \u0445\u043E\u043B\u043E\u0434\u043D\u0443 \u0437\u0431\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240896
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u0431\u0443\u043D\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240897
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440\u0438-\u0411\u0443\u043D\u0442\u0430\u0440\u0456
      \u043F\u043E\u043D\u0430\u0434 \u0443\u0441\u0435 \u043D\u0430 \u0441\u0432\u0456\u0442\u0456
      \u0446\u0456\u043D\u0443\u044E\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u0443.
      \u042F\u043A\u0430, \u0432 \u0457\u0445\u043D\u044C\u043E\u043C\u0443 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u0456,
      \u0432\u0438\u0440\u0430\u0436\u0430\u0454\u0442\u044C\u0441\u044F \u0432 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0431\u0435\u0437\u043A\u0430\u0440\u043D\u043E \u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438
      \u0456 \u0491\u0432\u0430\u043B\u0442\u0443\u0432\u0430\u0442\u0438 \u043A\u043E\u0433\u043E
      \u0456 \u0434\u0435 \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u043B\u0435\u0433\u043A\u043E\u044E \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240898
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u043A\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240899
    m_Localized: "\u041D\u0430 \u0441\u043E\u0432\u0456\u0441\u0442\u0456 \u0431\u0430\u043D\u0434\u0438
      \u041A\u0430\u0442\u0456\u0432 \u043D\u0435 \u043E\u0434\u043D\u0435 \u0440\u043E\u0437\u043E\u0440\u0435\u043D\u0435
      \u0456 \u0437\u043D\u0438\u0449\u0435\u043D\u0435 \u0434\u043E \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u0436\u0438\u0442\u0435\u043B\u044F \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F.
      \u0426\u0435 \u0431\u0435\u0437\u0436\u0430\u043B\u044C\u043D\u0456 \u0432\u0431\u0438\u0432\u0446\u0456,
      \u044F\u043A\u0456 \u0432\u0431\u0438\u0432\u0430\u044E\u0442\u044C \u043D\u0435
      \u0437\u0430\u0440\u0430\u0434\u0438 \u044F\u043A\u0438\u0445\u043E\u0441\u044C
      \u043A\u043E\u0440\u0438\u0441\u043B\u0438\u0432\u0438\u0445 \u0446\u0456\u043B\u0435\u0439,
      \u0430 \u0442\u0456\u043B\u044C\u043A\u0438 \u043B\u0438\u0448\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0432\u043E\u0454 \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u043B\u044F.
      \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0456 \u043D\u0430\u0439\u0447\u0430\u0441\u0442\u0456\u0448\u0435
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430\u043C\u0438, \u0449\u043E
      \u0440\u043E\u0431\u0438\u0442\u044C \u0457\u0445 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C\u0438 \u043D\u0430
      \u0431\u043B\u0438\u0437\u044C\u043A\u0456\u0439 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240900
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u043C\u0430\u0439\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240901
    m_Localized: "\u041C\u0430\u0439\u0441\u0442\u0440\u0438 - \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0430, \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u0430
      \u0456 \u0434\u043E\u0431\u0440\u0435 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430
      \u0440\u0435\u0439\u0434\u0435\u0440\u0441\u044C\u043A\u0430 \u0431\u0430\u043D\u0434\u0430.
      \u041C\u0430\u044E\u0442\u044C \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u0456,
      \u0437\u0430 \u043C\u0456\u0440\u043A\u0430\u043C\u0438 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432,
      \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043A\u0438 \u0442\u0430 \u0437\u0431\u0440\u043E\u044E,
      \u0456 \u043A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0432\u043C\u0456\u044E\u0442\u044C
      \u043D\u0438\u043C\u0438 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240902
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u043F\u0430\u043B\u0456\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240903
    m_Localized: "\u0411\u0430\u043D\u0434\u0430 \u041F\u0430\u043B\u0456\u0457\u0432
      \u0432\u0456\u0434\u0437\u043D\u0430\u0447\u0438\u043B\u0430\u0441\u044F \u0441\u0432\u043E\u0454\u044E
      \u043D\u0435\u0437\u0434\u043E\u0440\u043E\u0432\u043E\u044E \u043B\u044E\u0431\u043E\u0432'\u044E
      \u0434\u043E \u0432\u043E\u0433\u043D\u044E. \u0423 \u0431\u043E\u044E \u0432\u043E\u043D\u0438
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442\u0438 \u0456 \u0437\u0430\u043F\u0430\u043B\u044C\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E, \u0430 \u0441\u0430\u043C\u0456 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E\u0442\u044C \u043E\u043F\u0456\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240904
    m_Localized: "\u0420\u0435\u0439\u0434\u0435\u0440-\u043F\u0456\u0434\u0440\u0438\u0432\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240905
    m_Localized: "\u041F\u0456\u0434\u0440\u0438\u0432\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u0445\u0438\u0431\u043B\u0435\u043D\u0456 \u043D\u0430 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u0446\u0456.
      \u0421\u043A\u0440\u0456\u0437\u044C \u0445\u043E\u0434\u044F\u0442\u044C,
      \u043E\u0431\u0432\u0456\u0448\u0430\u043D\u0456 \u0433\u0440\u0430\u043D\u0430\u0442\u0430\u043C\u0438,
      \u0456 \u043D\u0435 \u0441\u043E\u0440\u043E\u043C\u043B\u044F\u0442\u044C\u0441\u044F
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0457\u0445 \u0437 \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0436 \u043F\u0440\u0438\u0432\u043E\u0434\u0443.
      \u0426\u0435 \u0440\u043E\u0431\u0438\u0442\u044C \u0457\u0445, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u0431\u0456\u043B\u044C\u0448 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C\u0438
      \u0434\u043B\u044F \u0441\u0432\u043E\u0457\u0445 \u0436\u0435 \u043F\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0456\u0432,
      \u043D\u0456\u0436 \u0434\u043B\u044F \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240906
    m_Localized: "\u0412\u0430\u0442\u0430\u0436\u043E\u043A \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240907
    m_Localized: "\u0412\u0430\u0442\u0430\u0436\u043A\u0430\u043C\u0438 \u043C\u0430\u0439\u0436\u0435
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0441\u0442\u0430\u044E\u0442\u044C \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0456,
      \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456 \u0442\u0430
      \u043D\u0430\u0439\u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0456\u0448\u0456
      \u0437 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240908
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240909
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u0438, \u043E\u0441\u043D\u043E\u0432\u043D\u0430
      \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C \u044F\u043A\u0438\u0445
      \u043F\u043E\u043B\u044F\u0433\u0430\u0454 \u0443 \u0432\u0438\u043B\u043E\u0432\u0456
      \u0442\u0430 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u043E\u043C\u0443 \u043F\u0440\u043E\u0434\u0430\u0436\u0443
      \u0431\u0440\u0430\u043D\u0446\u0456\u0432 \u0432 \u044F\u043A\u043E\u0441\u0442\u0456
      \u0440\u0430\u0431\u0456\u0432. \u041C\u0430\u0439\u0436\u0435 \u0442\u0430\u043A\u0456
      \u0436 \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0456 \u0439 \u0430\u043C\u043E\u0440\u0430\u043B\u044C\u043D\u0456,
      \u044F\u043A \u0440\u0435\u0439\u0434\u0435\u0440\u0438, \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456,
      \u043E\u0434\u043D\u0430\u043A, \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \"\u0446\u0438\u0432\u0456\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u0456\u0448\u0456\".
      \u0407\u0445\u043D\u0456 \u0431\u0430\u043D\u0434\u0438 \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u0456
      \u0456 \u0434\u043E\u0431\u0440\u0435 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u0456,
      \u043C\u0430\u044E\u0442\u044C \u0433\u0440\u0430\u043C\u043E\u0442\u043D\u0438\u0445
      \u043B\u0456\u0434\u0435\u0440\u0456\u0432, \u0447\u0456\u0442\u043A\u0443
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u0456 \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B
      \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0456\u0432. \u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456
      \u0434\u043E\u0431\u0440\u0435 \u043D\u0430\u0432\u0447\u0435\u043D\u0456 \u0441\u0432\u043E\u0433\u043E
      \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u043E\u0433\u043E \u0440\u0435\u043C\u0435\u0441\u043B\u0430,
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u044E\u0442\u044C\u0441\u044F \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u0440\u0430\u0449\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E \u0456
      \u0431\u0440\u043E\u043D\u0435\u044E, \u043D\u0456\u0436 \u0440\u0435\u0439\u0434\u0435\u0440\u0438.
      \u0423\u0441\u0435 \u0446\u0435 \u0440\u043E\u0431\u0438\u0442\u044C \u0457\u0445
      \u0437\u043D\u0430\u0447\u043D\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u043C\u0438
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240910
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240911
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0438\u0447\u0456 \u0437\u0430\u0439\u043C\u0430\u044E\u0442\u044C
      \u043D\u0438\u0436\u0447\u0438\u0439 \u0449\u0430\u0431\u0435\u043B\u044C \u0456\u0454\u0440\u0430\u0440\u0445\u0456\u0457
      \u0432 \u0431\u0430\u043D\u0434\u0430\u0445 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432.
      \u0407\u0445\u043D\u0456\u0439 \u043E\u0431\u043E\u0432'\u044F\u0437\u043E\u043A
      \u043F\u043E\u043B\u044F\u0433\u0430\u0454 \u0437\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E
      \u0432 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u043D\u043D\u0456
      \u0430\u0431\u043E \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0456 \u0440\u0430\u0431\u0456\u0432
      \u0434\u043E \u043C\u0456\u0441\u0446\u044C \u0457\u0445\u043D\u044C\u043E\u0433\u043E
      \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u0440\u043E\u0434\u0430\u0436\u0443.
      \u0417 \u0446\u0456\u0454\u044E \u043C\u0435\u0442\u043E\u044E \u0432\u043E\u043D\u0438
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043E\u0437\u0431\u0440\u043E\u044E\u044E\u0442\u044C\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E,
      \u0430 \u0457\u0445\u043D\u0456 \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043A\u0438,
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u043D\u0438\u0437\u044C\u043A\u043E\u0433\u043E
      \u0441\u0442\u0430\u0442\u0443\u0441\u0443, \u0434\u043E\u0432\u043E\u043B\u0456
      \u043F\u043E\u0433\u0430\u043D\u043E\u0457 \u044F\u043A\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240912
    m_Localized: "\u041B\u043E\u0432\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240913
    m_Localized: "\u0412 \u043E\u0431\u043E\u0432'\u044F\u0437\u043E\u043A \u043B\u043E\u0432\u0446\u0456\u0432
      \u0432\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u0438\u0441\u0442\u0435\u0436\u0443\u0432\u0430\u043D\u043D\u044F
      \u0456 \u0443\u043F\u0456\u0439\u043C\u0430\u043D\u043D\u044F \u043D\u043E\u0432\u0438\u0445
      \u0440\u0430\u0431\u0456\u0432. \u0417\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E
      \u0440\u0430\u0431\u0438 \u043D\u0430\u0431\u0438\u0440\u0430\u044E\u0442\u044C\u0441\u044F
      \u0437 \u0447\u0438\u0441\u043B\u0430 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432,
      \u0434\u0438\u043A\u0443\u043D\u0456\u0432 \u0456 \u0432\u043E\u043B\u043E\u0446\u044E\u0433,
      \u0430\u043B\u0435 \u0447\u0430\u0441\u0442\u043E \u043B\u043E\u0432\u0446\u0456
      \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0442\u044C \u0456 \u043D\u0430
      \u043C\u0438\u0440\u043D\u0456 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F,
      \u0437\u0430\u0445\u043E\u043F\u043B\u044E\u044E\u0447\u0438 \u0432\u0441\u0456\u0445
      \u0441\u0438\u043B\u044C\u043D\u0438\u0445 \u0456 \u0437\u0434\u043E\u0440\u043E\u0432\u0438\u0445
      \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u0443 \u043F\u043E\u043B\u043E\u043D
      \u0456 \u0432\u0431\u0438\u0432\u0430\u044E\u0447\u0438 \u0432\u0441\u0456\u0445
      \u0456\u043D\u0448\u0438\u0445. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u0440\u0456\u0437\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E \u0456
      \u0434\u043E\u0441\u0438\u0442\u044C \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456
      \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0442\u043D\u044C\u043E\u0433\u043E
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240914
    m_Localized: "\u041D\u0430\u0433\u043B\u044F\u0434\u0430\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240915
    m_Localized: "\u041E\u0431\u043E\u0432'\u044F\u0437\u043A\u0438 \u043D\u0430\u0433\u043B\u044F\u0434\u0430\u0447\u0456\u0432
      \u043F\u043E\u043B\u044F\u0433\u0430\u044E\u0442\u044C \u0443 \u043D\u0430\u0433\u043B\u044F\u0434\u0456
      \u0437\u0430 \u0440\u0430\u0431\u0430\u043C\u0438, \u043F\u0440\u0438\u043F\u0438\u043D\u0435\u043D\u043D\u044F
      \u0432\u0442\u0435\u0447, \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0446\u0456
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u0456 \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u044C
      (\u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u043F\u0443\u043D\u043A\u0442,
      \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0432\u0438\u043A\u043E\u043D\u0443\u044E\u0442\u044C
      \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u043C \u0437\u0430\u0432\u0437\u044F\u0442\u0442\u044F\u043C).
      \u0427\u0430\u0441\u0442\u043E \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443\u044E\u0442\u044C
      \u043B\u043E\u0432\u0446\u0456\u0432 \u0443 \u0457\u0445\u043D\u0456\u0445
      \u0440\u0435\u0439\u0434\u0430\u0445. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E
      \u0456 \u0432 \u0431\u043E\u044E \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u0447\u0438\u043C\u0430\u043B\u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240916
    m_Localized: "\u041E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240917
    m_Localized: "\u041E\u0445\u043E\u0440\u043E\u043D\u0446\u0456 - \u0443\u0434\u0430\u0440\u043D\u0430
      \u0441\u0438\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432.
      \u0421\u043B\u0443\u0433\u0443\u044E\u0442\u044C \u043F\u0440\u0438\u043A\u0440\u0438\u0442\u0442\u044F\u043C
      \u0456 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u043E\u044E \u0443
      \u0440\u0435\u0439\u0434\u0430\u0445, \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u044E\u0442\u044C
      \u0442\u0430\u0431\u043E\u0440\u0438 \u0432\u0456\u0434 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0445
      \u0437\u0430\u0433\u0440\u043E\u0437. \u0422\u0430\u043A\u043E\u0436 \u043D\u0430\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C
      \u0437\u0430 \u0456\u043D\u0448\u0438\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438,
      \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u043E \u0440\u043E\u0437\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0447\u0438\u0441\u044C
      \u0437 \u0431\u0430\u043B\u0430\u043C\u0443\u0442\u0430\u043C\u0438. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u0456 \u043C\u0430\u044E\u0442\u044C
      \u0445\u043E\u0440\u043E\u0448\u0443 \u0431\u0440\u043E\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240918
    m_Localized: "\u0415\u043B\u0456\u0442\u043D\u0438\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240919
    m_Localized: "\u0415\u043B\u0456\u0442\u043D\u0456 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0456
      - \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456 \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u043E\u043D\u0430\u043B\u0438,
      \u0441\u0438\u043B\u044C\u043D\u0456, \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0456
      \u0442\u0430 \u0447\u0443\u0434\u043E\u0432\u043E \u0435\u043A\u0456\u043F\u0456\u0440\u043E\u0432\u0430\u043D\u0456.
      \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u044E\u0442\u044C
      \u0432\u0430\u0442\u0430\u0436\u043A\u0456\u0432 \u0431\u0430\u043D\u0434 \u0430\u0431\u043E
      \u0431\u0435\u0440\u0443\u0442\u044C \u0443\u0447\u0430\u0441\u0442\u044C \u0443
      \u043D\u0430\u0439\u0440\u0438\u0437\u0438\u043A\u043E\u0432\u0430\u043D\u0456\u0448\u0438\u0445
      \u0440\u0435\u0439\u0434\u0430\u0445. \u041D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240920
    m_Localized: "\u041B\u0456\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240921
    m_Localized: "\u041B\u0456\u0434\u0435\u0440\u0430\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432,
      \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0441\u0442\u0430\u044E\u0442\u044C
      \u043D\u0430\u0439\u0445\u0438\u0442\u0440\u0456\u0448\u0456, \u043D\u0430\u0439\u0443\u0441\u043F\u0456\u0448\u043D\u0456\u0448\u0456
      \u0442\u0430 \u043D\u0430\u0439\u043D\u0435\u0449\u0430\u0434\u043D\u0456\u0448\u0456
      \u0437 \u043D\u0438\u0445. \u041F\u0456\u0434 \u0457\u0445\u043D\u0456\u043C
      \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F\u043C \u0447\u0430\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0456
      \u0437\u0430\u0433\u043E\u043D\u0438 \u043B\u043E\u0432\u0446\u0456\u0432,
      \u043D\u0430\u0433\u043B\u044F\u0434\u0430\u0447\u0456\u0432 \u0456 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0456\u0432,
      \u044F\u043A\u0438\u0445 \u0432\u043E\u043D\u0438 \u0432\u0435\u0434\u0443\u0442\u044C
      \u043D\u0430 \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0437\u0430
      \u0436\u0438\u0432\u0438\u043C \u0442\u043E\u0432\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240922
    m_Localized: "\u041D\u0430\u0439\u043C\u0430\u043D\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240923
    m_Localized: "\u041D\u0430\u0439\u043C\u0430\u043D\u0446\u0456, \u0442\u0430\u043A\u043E\u0436
      \u0432\u0456\u0434\u043E\u043C\u0456 \u044F\u043A \"\u041A\u0456\u0433\u0442\u0456\"
      - \u043D\u0430\u043F\u0456\u0432\u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F, \u0434\u043E
      \u044F\u043A\u043E\u0457 \u0432\u0445\u043E\u0434\u044F\u0442\u044C \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E
      \u0433\u0440\u0438\u0444\u043E\u043D\u0438. \u0421\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437 \u0431\u0435\u0437\u043B\u0456\u0447\u0456 \u043D\u0435\u0437\u0430\u043B\u0435\u0436\u043D\u0438\u0445
      \u043E\u0441\u0435\u0440\u0435\u0434\u043A\u0456\u0432, \u043A\u043E\u0436\u0435\u043D
      \u0437\u0456 \u0441\u0432\u043E\u0457\u043C \u043B\u0456\u0434\u0435\u0440\u043E\u043C.
      \u0425\u043E\u0447\u0430 \u0434\u0435\u044F\u043A\u0456 \u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456
      \u043C\u0430\u044E\u0442\u044C \u0441\u0432\u0456\u0439 \u0432\u043B\u0430\u0441\u043D\u0438\u0439
      \u043A\u043E\u0434\u0435\u043A\u0441 \u0447\u0435\u0441\u0442\u0456, \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C
      \u0456\u0437 \u043D\u0438\u0445 \u0454 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C\u0438
      \u043C\u0435\u0440\u0437\u043E\u0442\u043D\u0438\u043A\u0430\u043C\u0438, \u044F\u043A\u0438\u0445
      \u0446\u0456\u043A\u0430\u0432\u043B\u044F\u0442\u044C \u0442\u0456\u043B\u044C\u043A\u0438
      \u0433\u0440\u043E\u0448\u0456 \u0456 \u044F\u043A\u0456 \u043D\u0435 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0456
      \u0436\u043E\u0434\u043D\u0438\u043C\u0438 \u043D\u043E\u0440\u043C\u0430\u043C\u0438
      \u043C\u043E\u0440\u0430\u043B\u0456. \u0412\u043E\u043D\u0438 \u0431\u0435\u0440\u0443\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443 \u0440\u043E\u0431\u043E\u0442\u0443,
      \u0447\u0438 \u0442\u043E \u0437\u0430\u043C\u043E\u0432\u043D\u0456 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430,
      \u0432\u0438\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044F, \u0447\u0438
      \u0442\u043E \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u0456\u0432\u043B\u044F,
      \u0456 \u043D\u0435 \u0432\u0438\u044F\u0432\u043B\u044F\u044E\u0442\u044C
      \u0436\u043E\u0434\u043D\u043E\u0457 \u0436\u0430\u043B\u043E\u0441\u0442\u0456
      \u0434\u043E \u0441\u0432\u043E\u0457\u0445 \u0436\u0435\u0440\u0442\u0432.
      \u0417\u0431\u0440\u043E\u044F \u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456\u0432,
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439, \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u0440\u0430\u0449\u0430, \u043D\u0456\u0436 \u0443 \u0456\u043D\u0448\u0438\u0445
      \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u041F\u0443\u0441\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240924
    m_Localized: "\u0413\u0440\u0438\u0444\u043E\u043D-\u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240925
    m_Localized: "\u0420\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432
      \u041A\u0456\u0433\u0442\u0456\u0432 \u0437\u0430\u0432\u0436\u0434\u0438 \u043F\u0443\u0441\u043A\u0430\u044E\u0442\u044C
      \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0445
      \u0441\u0438\u043B. \u0407\u0445\u043D\u0454 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F
      \u043F\u043E\u043B\u044F\u0433\u0430\u0454 \u0432 \u0442\u043E\u043C\u0443,
      \u0449\u043E\u0431 \u0440\u043E\u0437\u0432\u0456\u0434\u0430\u0442\u0438 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443,
      \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456
      \u0442\u0430 \u0432\u0456\u0434\u0448\u0443\u043A\u0430\u0442\u0438 \u0446\u0456\u043B\u0456.
      \u0420\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0441\u043B\u0430\u0431\u043A\u043E \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u0439 \u043D\u043E\u0441\u044F\u0442\u044C \u0442\u0456\u043B\u044C\u043A\u0438
      \u043B\u0435\u0433\u043A\u0443 \u0431\u0440\u043E\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240926
    m_Localized: "\u0413\u0440\u0438\u0444\u043E\u043D-\u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240927
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430 \u0443\u0434\u0430\u0440\u043D\u0430
      \u0441\u0438\u043B\u0430 \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0437\u0430\u0433\u043E\u043D\u0456\u0432
      \u041A\u0456\u0433\u0442\u0456\u0432. \u0407\u0445\u043D\u0454 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F
      - \u0432\u0441\u0442\u0443\u043F\u0430\u0442\u0438 \u0432 \u0431\u0456\u0439
      \u0443 \u043F\u0435\u0440\u0448\u0438\u0445 \u0440\u044F\u0434\u0430\u0445.
      \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0432\u043E\u043D\u0438
      \u043C\u0430\u044E\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0443 \u0431\u0440\u043E\u043D\u044E
      \u0442\u0430 \u0437\u0431\u0440\u043E\u044E \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0456\u0432 \u0456 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u0445
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240928
    m_Localized: "\u0413\u0440\u0438\u0444\u043E\u043D-\u043A\u0443\u043B\u0435\u043C\u0435\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240929
    m_Localized: "\u0417\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u043D\u0438\u043A\u0456\u0432
      - \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438 \u0432\u043E\u0433\u043D\u0435\u0432\u0443
      \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0443 \u0432\u0430\u0436\u043A\u0438\u043C
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F\u043C. \u0412\u043E\u043D\u0438
      \u0432\u0456\u0434\u0434\u0430\u044E\u0442\u044C \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443
      \u0431\u0456\u043B\u044C\u0448\u0438\u043C \u0433\u0430\u0440\u043C\u0430\u0442\u0430\u043C,
      \u0437\u0430\u0440\u0430\u0434\u0438 \u044F\u043A\u0438\u0445 \u0457\u043C
      \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0436\u0435\u0440\u0442\u0432\u0443\u0432\u0430\u0442\u0438
      \u0431\u0440\u043E\u043D\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240930
    m_Localized: "\u0413\u0440\u0438\u0444\u043E\u043D-\u0441\u043D\u0430\u0439\u043F\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240931
    m_Localized: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0438 \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0442\u044C\u0441\u044F
      \u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F \u043D\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456
      \u0456 \u043B\u0456\u043A\u0432\u0456\u0434\u0443\u0432\u0430\u0442\u0438 \u0446\u0456\u043B\u0456
      \u0437\u0434\u0430\u043B\u0435\u043A\u0443. \u0412\u043E\u043D\u0438 \u0447\u0430\u0441\u0442\u043E
      \u0431\u0443\u0432\u0430\u044E\u0442\u044C \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0456
      \u0432\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0438\u043C\u0438
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430\u043C\u0438, \u0447\u0435\u0440\u0435\u0437
      \u0449\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C \u0447\u0438\u043C\u0430\u043B\u0443
      \u0437\u0430\u0433\u0440\u043E\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240932
    m_Localized: "\u0415\u043B\u0456\u0442\u043D\u0438\u0439 \u041A\u0456\u0433\u043E\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240933
    m_Localized: "\u041D\u0430\u0439\u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0456\u0448\u0456
      \u0431\u0456\u0439\u0446\u0456 \u041A\u0456\u0433\u0442\u0456\u0432. \u041D\u043E\u0441\u044F\u0442\u044C
      \u0431\u043E\u0439\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E \u0456
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u044E\u0442\u044C\u0441\u044F \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u043E\u044E
      \u0437 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457,
      \u0437 \u044F\u043A\u043E\u044E \u0447\u0443\u0434\u043E\u0432\u043E \u0432\u043C\u0456\u044E\u0442\u044C
      \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u0438\u0441\u044F. \u0414\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u043B\u0435\u0437\u0430, \u0437\u0430\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0456
      \u043D\u0430 \u043A\u0440\u0438\u043B\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240934
    m_Localized: "\u041B\u0435\u0433\u0456\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240935
    m_Localized: "\u0421\u0445\u043E\u0436\u0435, \u043D\u0435 \u0432\u0441\u0456
      \u0437\u0435\u0431\u0440\u0438 \u0432 \u043A\u0443\u0440\u0441\u0456, \u0449\u043E
      \u0412\u0435\u043B\u0438\u043A\u0430 \u0412\u0456\u0439\u043D\u0430 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044F
      \u0434\u0432\u0456 \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432
      \u0442\u043E\u043C\u0443. \u041E\u0441\u0442\u0430\u043D\u043D\u0456\u043C
      \u0447\u0430\u0441\u043E\u043C \u043F\u043E\u0447\u0430\u043B\u0430 \u043D\u0430\u0431\u0438\u0440\u0430\u0442\u0438
      \u0441\u0438\u043B\u0443 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0430
      \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F,
      \u0432\u0456\u0434\u043E\u043C\u0430 \u044F\u043A \u041B\u0435\u0433\u0456\u043E\u043D.
      \u0426\u0456\u043B\u0456 \u0439\u043E\u0433\u043E \u043B\u0456\u0434\u0435\u0440\u0456\u0432
      \u0434\u043E\u0441\u0456 \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u043C\u0438, \u0430\u043B\u0435
      \u0432\u0441\u0456\u043C \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E,
      \u0449\u043E \u043D\u0456\u0447\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u043E\u0433\u043E
      \u0432\u0456\u0434 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u0430 \u043D\u0435
      \u0447\u0435\u043A\u0430\u0442\u0438. \u0417\u0435\u0431\u0440\u0438 \u0447\u0443\u0434\u043E\u0432\u043E
      \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u043D\u0430\u0432\u0438\u0447\u043A\u0430\u043C\u0438
      \u0441\u043A\u0440\u0438\u0442\u043D\u043E\u0441\u0442\u0456, \u0432\u043E\u043D\u0438
      - \u043C\u0430\u0439\u0441\u0442\u0440\u0438 \u043C\u0430\u0441\u043A\u0443\u0432\u0430\u043D\u043D\u044F
      \u0456 \u0440\u0430\u043F\u0442\u043E\u0432\u043E\u0433\u043E \u043D\u0430\u043F\u0430\u0434\u0443
      \u0456\u0437 \u0437\u0430\u0441\u0456\u0434\u043A\u0438, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456
      \u0432 \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u043C\u0443 \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240936
    m_Localized: "\u0417\u0435\u0431\u0440\u0430-\u0448\u043F\u0438\u0433\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240937
    m_Localized: "\u041D\u0456\u0445\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0454,
      \u0449\u043E \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u043E\u0441\u044F
      \u0448\u043F\u0438\u0433\u0443\u043D\u0430\u043C \u041B\u0435\u0433\u0456\u043E\u043D\u0443
      \u0432 \u0446\u0438\u0445 \u043A\u0440\u0430\u044F\u0445 - \u0437\u0435\u0431\u0440\u0438
      \u043D\u0456 \u0437 \u043A\u0438\u043C \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C
      \u0443 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438. \u0412\u043E\u043D\u0438
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0434\u0456\u044E\u0442\u044C \u043F\u043E\u0442\u0430\u0439\u043A\u0438
      \u0439 \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u043E, \u0430\u043B\u0435
      \u0432 \u0440\u0430\u0437\u0456 \u0432\u0438\u044F\u0432\u043B\u0435\u043D\u043D\u044F
      \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C \u0443 \u0431\u0456\u0439
      \u0456\u0437 \u043D\u0435\u0431\u0443\u0432\u0430\u043B\u043E\u044E \u043B\u044E\u0442\u0442\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240938
    m_Localized: "\u0417\u0435\u0431\u0440\u0430-\u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240939
    m_Localized: "\u0414\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443
      \u043F\u043E\u0442\u0430\u0439\u043A\u0438 \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u044C\u0441\u044F
      \u0432 \u0440\u0456\u0437\u043D\u0456 \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0456
      \u0431\u0443\u0434\u0456\u0432\u043B\u0456 \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445
      \u0456\u0437 \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0437\u0430\u043F\u0430\u0441\u043E\u043C
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438. \u041D\u0430\u0432\u0456\u0449\u043E?
      \u041D\u0435\u0432\u0456\u0434\u043E\u043C\u043E, \u0430\u043B\u0435 \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0437 \u0434\u043E\u0431\u0440\u0438\u043C\u0438 \u043D\u0430\u043C\u0456\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240940
    m_Localized: "\u0417\u0435\u0431\u0440\u0430-\u0430\u0441\u0430\u0441\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240941
    m_Localized: "\u0417\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0439
      \u043F\u043B\u0430\u0449 \u0430\u0441\u0430\u0441\u0438\u043D\u0430 \u0440\u043E\u0431\u0438\u0442\u044C
      \u0439\u043E\u0433\u043E \u043C\u0430\u0439\u0436\u0435 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u043C. \u041D\u0456\u0449\u043E
      \u043D\u0435 \u0432\u0438\u0434\u0430\u0441\u0442\u044C \u0439\u043E\u0433\u043E
      \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u043E\u0441\u0442\u0456 \u0434\u043E
      \u0441\u0430\u043C\u043E\u0433\u043E \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u044C\u043A\u043E\u0457
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240942
    m_Localized: "\u0417\u0435\u0431\u0440\u0430-\u0431\u043E\u0439\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240943
    m_Localized: "\u0412\u0456\u0434\u043C\u0456\u043D\u043D\u043E \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0456
      \u0439 \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0456 \u0431\u043E\u0439\u043E\u0432\u0438\u043A\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0437\u0432\u0438\u043A\u043B\u0438
      \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438
      \u0443\u0434\u0430\u0440\u0443, \u0430 \u043F\u043E\u0442\u0456\u043C \u0441\u0442\u0440\u0456\u043C\u043A\u043E
      \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u0430\u0442\u0438, \u0440\u043E\u0437\u0447\u0438\u043D\u044F\u044E\u0447\u0438\u0441\u044C
      \u0443 \u043D\u0456\u0447\u043D\u0456\u0439 \u0442\u0435\u043C\u0440\u044F\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240944
    m_Localized: "\u041E\u0444\u0456\u0446\u0435\u0440 \u041B\u0435\u0433\u0456\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240945
    m_Localized: "\u041E\u0444\u0456\u0446\u0435\u0440\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043D\u043E\u0441\u044F\u0442\u044C
      \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043D\u0435 \u0432\u0431\u0440\u0430\u043D\u043D\u044F
      \u0456 \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043A\u0438. \u0412\u043E\u043D\u0438
      \u043D\u0435 \u0442\u0430\u043A \u0443\u0436\u0435 \u0439 \u0434\u043E\u0431\u0440\u0435
      \u0437\u0430\u0445\u0438\u0449\u0430\u044E\u0442\u044C \u0432\u0456\u0434 \u043A\u0443\u043B\u044C,
      \u0437\u0430\u0442\u0435 \u0457\u0445\u043D\u0456\u0439 \u0432\u0438\u0433\u043B\u044F\u0434
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u0431\u043E\u0439\u043E\u0432\u0438\u0439
      \u0434\u0443\u0445 \u043B\u0435\u0433\u0456\u043E\u043D\u0435\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240946
    m_Localized: "\u041D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240947
    m_Localized: "\u0417\u0435\u0431\u0440\u0438-\u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0438
      - \u0446\u0435 \u043C\u043E\u0433\u0443\u0442\u043D\u0456 \u0447\u0430\u043A\u043B\u0443\u043D\u0438,
      \u044F\u043A\u0456 \u043D\u0456 \u0432 \u0447\u043E\u043C\u0443 \u043D\u0435
      \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C\u0441\u044F \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u043C
      \u043C\u0430\u0433\u0430\u043C-\u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430\u043C.
      \u0410\u043B\u0435, \u043D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u043D\u0438\u0445, \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043D\u0430 \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0443
      \u043C\u0430\u0433\u0456\u044E, \u0430 \u043D\u0430 \u0442\u0435\u043C\u043D\u0456
      \u043F\u0440\u043E\u043A\u043B\u044C\u043E\u043D\u0438 \u0456 \u043F\u043E\u043A\u043B\u0438\u043A
      \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0438\u0445
      \u0456\u0441\u0442\u043E\u0442 \u0456 \u0434\u0443\u0445\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240948
    m_Localized: "\u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240949
    m_Localized: "\u041E\u0434\u043D\u0430 \u0437 \u043D\u0430\u0439\u043C\u043E\u0433\u0443\u0442\u043D\u0456\u0448\u0438\u0445
      \u0444\u0440\u0430\u043A\u0446\u0456\u0439 \u043F\u0456\u0441\u043B\u044F\u0432\u043E\u0454\u043D\u043D\u043E\u0457
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457. \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 - \u0437\u0430\u043A\u0440\u0438\u0442\u0430
      \u0432\u043E\u0454\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F,
      \u0449\u043E \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0456\u0437 \u0437\u0435\u043C\u043D\u0438\u0445 \u043F\u043E\u043D\u0456
      \u0442\u0430 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432,
      \u044F\u043A\u0430 \u043F\u0440\u043E\u0433\u043E\u043B\u043E\u0441\u0438\u043B\u0430
      \u0441\u0432\u043E\u0454\u044E \u043C\u0435\u0442\u043E\u044E \u043F\u043E\u0448\u0443\u043A
      \u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u044E\u0442\u044C\u0441\u044F
      \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0456\u0441\u0442\u044E, \u043D\u0435\u0442\u0435\u0440\u043F\u0438\u043C\u0456\u0441\u0442\u044E
      \u0434\u043E \u0447\u0443\u0436\u0438\u043D\u0446\u0456\u0432 \u0456 \u0437\u0430\u0433\u0430\u043B\u043E\u043C
      \u0437\u043D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u0438\u043C \u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044F\u043C
      \u0434\u043E \u0440\u0435\u0448\u0442\u0438 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432
      \u041F\u0443\u0441\u0442\u043E\u043A, \u044F\u043A\u0438\u0445 \u043D\u0430\u0437\u0438\u0432\u0430\u044E\u0442\u044C
      \u043D\u0435 \u0456\u043D\u0430\u043A\u0448\u0435 \u044F\u043A \"\u0434\u0438\u043A\u0443\u043D\u0438\".
      \u0412\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u044C\u043C\u0430
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u043C\u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044F\u043C\u0438,
      \u043D\u0435 \u0432\u0438\u0437\u043D\u0430\u044E\u0442\u044C \u0433\u0430\u0440\u043C\u0430\u0442
      \u043C\u0435\u043D\u0448\u0438\u0445 \u0437\u0430 \u043C\u0456\u043D\u0456\u0433\u0430\u043D,
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0432\u0456\u0434\u043E\u043C\u0456
      \u0441\u0432\u043E\u0454\u044E \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u044E
      \u0441\u0438\u043B\u043E\u0432\u043E\u044E \u0431\u0440\u043E\u043D\u0435\u044E
      - \u0441\u043F\u0430\u0434\u0449\u0438\u043D\u043E\u044E \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445 \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439.
      \u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F, \u043F\u043E\u0442\u0443\u0436\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F, \u0431\u043E\u0439\u043E\u0432\u0456 \u0440\u043E\u0431\u043E\u0442\u0438
      \u0456 \u0437\u0431\u043E\u0447\u0435\u043D\u0430 \u043C\u043E\u0440\u0430\u043B\u044C,
      \u0442\u0440\u043E\u0445\u0438 \u043A\u0440\u0430\u0449\u0430, \u043D\u0456\u0436
      \u0443 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432, - \u0432\u0441\u0435
      \u0446\u0435 \u0440\u043E\u0431\u0438\u0442\u044C \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u043E\u0434\u043D\u0438\u043C\u0438
      \u0437 \u043D\u0430\u0439\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0445
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432,
      \u0437 \u044F\u043A\u0438\u043C\u0438 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u0456\u0442\u043A\u043D\u0443\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240950
    m_Localized: "\u041B\u0438\u0446\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240951
    m_Localized: "\u041B\u0438\u0446\u0430\u0440\u0456 - \u0440\u044F\u0434\u043E\u0432\u0456
      \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438,
      \u043D\u0430\u0439\u043D\u0438\u0436\u0447\u0435 \u0437\u0432\u0430\u043D\u043D\u044F
      \u0443 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0456\u0439 \u0456\u0454\u0440\u0430\u0440\u0445\u0456\u0457.
      \u0412\u043E\u043D\u0438 \u043E\u0431'\u0454\u0434\u043D\u0443\u044E\u0442\u044C\u0441\u044F
      \u0443 \u0432\u0437\u0432\u043E\u0434\u0438 \u043F\u0456\u0434 \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F\u043C
      \u0425\u0440\u0435\u0441\u0442\u043E\u043D\u043E\u0441\u0446\u0456\u0432 \u0430\u0431\u043E
      \u0436 \u0443 \u0431\u0456\u043B\u044C\u0448\u0456 \u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240952
    m_Localized: "\u0425\u0440\u0435\u0441\u0442\u043E\u043D\u043E\u0441\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240953
    m_Localized: "\u0425\u0440\u0435\u0441\u0442\u043E\u043D\u043E\u0441\u0446\u0456
      - \u043C\u043E\u043B\u043E\u0434\u0448\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0438,
      \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u0430\u043D\u0430\u043B\u043E\u0433\u0456\u0447\u043D\u0456
      \u0441\u0435\u0440\u0436\u0430\u043D\u0442\u0430\u043C \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u043E\u0457
      \u0430\u0440\u043C\u0456\u0457, \u044F\u043A\u0456 \u043E\u0447\u043E\u043B\u044E\u044E\u0442\u044C
      \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0456 \u0437\u0430\u0433\u043E\u043D\u0438
      \u0447\u0438\u0441\u0435\u043B\u044C\u043D\u0456\u0441\u0442\u044E \u0432\u0456\u0441\u0456\u043C
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u0456 \u0432\u0438\u043A\u043E\u043D\u0443\u044E\u0442\u044C \u043D\u0430\u043A\u0430\u0437\u0438
      \u0432\u0438\u0449\u0438\u0445 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240954
    m_Localized: "\u041F\u0430\u043B\u0430\u0434\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240955
    m_Localized: "\u041F\u0430\u043B\u0430\u0434\u0438\u043D\u0438 - \u043C\u043E\u043B\u043E\u0434\u0448\u0456
      \u043E\u0444\u0456\u0446\u0435\u0440\u0438, \u044F\u043A\u0456 \u0432\u0435\u0434\u0443\u0442\u044C
      \u0443 \u0431\u0456\u0439 \u0432\u0435\u043B\u0438\u043A\u0456 \u0432\u0437\u0432\u043E\u0434\u0438
      \u0447\u0438\u0441\u0435\u043B\u044C\u043D\u0456\u0441\u0442\u044E \u0434\u0432\u0430\u0434\u0446\u044F\u0442\u044C
      \u0447\u043E\u0442\u0438\u0440\u0438 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430. \u0421\u0430\u043C\u0456
      \u0436 \u0432\u043E\u043D\u0438 \u043F\u0456\u0434\u043F\u043E\u0440\u044F\u0434\u043A\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F
      \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0421\u0442\u0430\u0440\u0448\u0438\u043C \u041F\u0430\u043B\u0430\u0434\u0438\u043D\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240956
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u0410\u043D\u043A\u043B\u0430\u0432
      \u041F\u0435\u0433\u0430\u0441\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240957
    m_Localized: "\u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432, \u0449\u043E \u0437'\u044F\u0432\u0438\u043B\u0430\u0441\u044F
      \u0456\u0437 \u0437\u0430\u043B\u0438\u0448\u043A\u0456\u0432 \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0445
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F\u043D\u0438\u0445 \u0441\u0438\u043B
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457, \u044F\u043A\u0456
      \u043A\u043E\u043B\u0438\u0441\u044C \u043F\u0440\u0438\u043A\u0440\u0438\u0432\u0430\u043B\u0438
      \u043D\u0430 \u0412\u0456\u0439\u043D\u0456 \u0456\u043D\u0448\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0437 \u043F\u043E\u0432\u0456\u0442\u0440\u044F.
      \u041D\u0435\u0437\u0430\u0434\u043E\u0432\u0433\u043E \u0434\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u0412\u0456\u0439\u043D\u0438 \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u043A\u0438
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432 \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F
      \u0431\u0440\u0430\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044C \u0443
      \u0431\u043E\u044F\u0445 \u0456\u0437 \u0437\u0435\u0431\u0440\u0430\u043C\u0438
      \u0456, \u0437\u0430\u043A\u0440\u0438\u0432\u0448\u0438 \u043D\u0430\u0433\u043B\u0443\u0445\u043E
      \u043D\u0435\u0431\u043E \u0445\u043C\u0430\u0440\u0430\u043C\u0438, \u0432\u0456\u0434\u043E\u043A\u0440\u0435\u043C\u0438\u043B\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0440\u0435\u0448\u0442\u0438 \u043F\u043E\u043D\u0456.
      \u0421\u0435\u0440\u0435\u0434 \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u0430\u0454
      \u0432\u043E\u0440\u043E\u0436\u0435 \u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044F
      \u0434\u043E \u0436\u0438\u0442\u0435\u043B\u0456\u0432 \u041F\u0443\u0441\u0442\u043A\u0438,
      \u0432 \u044F\u043A\u0438\u0445 \u0432\u043E\u043D\u0438 \u0432\u0431\u0430\u0447\u0430\u044E\u0442\u044C
      \u0437\u0430\u0433\u0440\u043E\u0437\u0443 \u0434\u043B\u044F \u0441\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u0430
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432 \u0456 \u0432\u043B\u0430\u0441\u043D\u043E\u0457
      \u0432\u043B\u0430\u0434\u0438. \u041D\u0430\u0440\u0430\u0437\u0456 \u0410\u043D\u043A\u043B\u0430\u0432
      \u0432\u043E\u043B\u043E\u0434\u0456\u0454 \u043D\u0430\u0439\u043F\u0435\u0440\u0435\u0434\u043E\u0432\u0456\u0448\u0438\u043C\u0438
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044F\u043C\u0438 \u0432
      \u0443\u0441\u0456\u0439 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457,
      \u0432\u043A\u043B\u044E\u0447\u043D\u043E \u0437 \u0431\u043E\u0439\u043E\u0432\u0438\u043C\u0438
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F\u043D\u0438\u043C\u0438 \u043A\u043E\u0440\u0430\u0431\u043B\u044F\u043C\u0438,
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u043F\u043E\u043A\u043E\u043B\u0456\u043D\u043D\u044F \u0439 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u044E,
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E\u044E \u0434\u043B\u044F
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432 \u0441\u0438\u043B\u043E\u0432\u043E\u044E
      \u0431\u0440\u043E\u043D\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240958
    m_Localized: "\u041E\u0444\u0456\u0446\u0435\u0440 \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240959
    m_Localized: "\u041E\u0444\u0456\u0446\u0435\u0440\u0456\u0432 \u0410\u043D\u043A\u043B\u0430\u0432\u0443
      \u0440\u0456\u0434\u043A\u043E \u043C\u043E\u0436\u043D\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438
      \u0437\u0430 \u043C\u0435\u0436\u0430\u043C\u0438 \u0443\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0438\u0445
      \u0440\u0430\u0439\u043E\u043D\u0456\u0432, \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445
      \u0431\u0430\u0437 \u0430\u0431\u043E \u043F\u043E\u0432\u0456\u0442\u0440\u044F\u043D\u0438\u0445
      \u043A\u043E\u0440\u0430\u0431\u043B\u0456\u0432. \u0412\u043E\u043D\u0438
      \u043D\u0435 \u043D\u043E\u0441\u044F\u0442\u044C \u0441\u0438\u043B\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456, \u0430 \u0442\u043E\u043C\u0443 \u0454 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E
      \u0441\u043B\u0430\u0431\u043A\u0438\u043C\u0438 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240960
    m_Localized: "\u0420\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240961
    m_Localized: "\u0420\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443 \u0447\u0430\u0441\u0442\u043E \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u044C
      \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0445
      \u0441\u0438\u043B. \u0412\u043E\u043D\u0438 \u043E\u0434\u044F\u0433\u043D\u0435\u043D\u0456
      \u0432 \u043B\u0435\u0433\u043A\u0443 \u0441\u0438\u043B\u043E\u0432\u0443
      \u0431\u0440\u043E\u043D\u044E, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0430\u0454
      \u043D\u0435\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u043C\u0438 \u043A\u0440\u0438\u043B\u0430,
      \u0430\u043B\u0435 \u043C\u0430\u044E\u0442\u044C \u0446\u0456\u043B\u0438\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0445
      \u0443 \u0448\u043E\u043B\u043E\u043C \u043B\u043E\u043A\u0430\u0442\u043E\u0440\u0456\u0432,
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u044F\u043A\u0438\u0445
      \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0430\u0441\u0456\u043A\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u043C\u0430\u0441\u043A\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240962
    m_Localized: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240963
    m_Localized: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0434\u0456\u044E\u0442\u044C \u0443 \u0441\u043A\u043B\u0430\u0434\u0456
      \u0432\u0437\u0432\u043E\u0434\u0456\u0432 \u0456\u0437 \u0442\u0440\u044C\u043E\u0445
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432, \u0449\u043E \u0456\u043C\u0435\u043D\u0443\u044E\u0442\u044C\u0441\u044F
      \"\u043A\u0440\u0438\u043B\u0430\". \u0407\u0445\u043D\u044F \u0441\u0438\u043B\u043E\u0432\u0430
      \u0431\u0440\u043E\u043D\u044F, \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u0430
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u043C\u0438 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C\u0438
      \u0433\u0430\u0440\u043C\u0430\u0442\u0430\u043C\u0438, \u0437\u0434\u0430\u0442\u043D\u0430
      \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0437\u043D\u0430\u0447\u043D\u0456
      \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F, \u0430 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u043E\u0432\u043E\u0433\u043E
      \u0445\u0432\u043E\u0441\u0442\u0430 \u0432\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u0431\u043E\u0440\u043E\u0442\u0438\u0441\u044F
      \u0432 \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u043C\u0443 \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240964
    m_Localized: "\u0415\u043B\u0456\u0442\u043D\u0438\u0439 \u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240965
    m_Localized: "\u0415\u043B\u0456\u0442\u043D\u0456 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A\u0438
      - \u0433\u043E\u0440\u0434\u0456\u0441\u0442\u044C \u0430\u0440\u043C\u0456\u0457
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443. \u041D\u043E\u0441\u044F\u0442\u044C
      \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u0443 \u0441\u0438\u043B\u043E\u0432\u0443
      \u0431\u0440\u043E\u043D\u044E, \u0449\u043E \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E
      \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438, \u0456 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u044E\u0442\u044C\u0441\u044F
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u0438\u043C
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240966
    m_Localized: "\u041A\u0440\u0438\u043B\u043E \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0443\u0432\u0430\u0447\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240967
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439 \u0437\u0430\u0433\u0456\u043D,
      \u0449\u043E \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437 \u0442\u0440\u044C\u043E\u0445 \u043F\u0435\u0433\u0430\u0441\u0456\u0432.
      \u041F\u0456\u0434\u043F\u043E\u0440\u044F\u0434\u043A\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E
      \u0441\u0430\u043C\u043E\u043C\u0443 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u0447\u0443
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240968
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240969
    m_Localized: "\u041F\u0456\u0441\u043B\u044F\u0432\u043E\u0454\u043D\u043D\u0443
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E \u043D\u0430\u0441\u0435\u043B\u044F\u044E\u0442\u044C
      \u0446\u0456\u043B\u0456 \u043F\u043E\u043B\u0447\u0438\u0449\u0430 \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0438\u0445
      \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432, \u0447\u0443\u0434\u043E\u0432\u0438\u0441\u044C\u043A
      \u0456 \u043C\u0443\u0442\u0430\u043D\u0442\u0456\u0432. \u041E\u0434\u043D\u0456
      \u0437 \u043D\u0438\u0445 \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F
      \u043F\u0456\u0434 \u0434\u0456\u0454\u044E \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457,
      \u041F\u043E\u0440\u0447\u0456 \u0430\u0431\u043E \u0440\u0456\u0437\u043D\u0438\u0445
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C,
      \u0456\u043D\u0448\u0456 \u0436 \u0431\u0443\u043B\u0438 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0456
      \u0448\u0442\u0443\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240970
    m_Localized: "\u0413\u0443\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240971
    m_Localized: "\u0413\u0443\u043B\u0456 - \u0446\u0435 \u043F\u043E\u043D\u0456,
      \u044F\u043A\u0456 \u043C\u0443\u0442\u0443\u0432\u0430\u043B\u0438 \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457.
      \u041D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E \u0442\u0430\u043A \u0437\u0432\u0430\u043D\u0456
      \u0434\u0438\u043A\u0456 \u0433\u0443\u043B\u0456, \u044F\u043A\u0456 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0440\u043E\u0437\u0443\u043C \u0456 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044F
      \u043D\u0430 \u043A\u0440\u043E\u0432\u043E\u0436\u0435\u0440\u043B\u0438\u0432\u0438\u0445
      \u0437\u043E\u043C\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240972
    m_Localized: "\u0414\u0438\u043A\u0438\u0439 \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240973
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u0434\u0438\u043A\u0438\u0445
      \u0433\u0443\u043B\u0456\u0432 \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438
      \u0431\u0435\u0437\u043B\u0456\u0447. \u042F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E,
      \u0432\u043E\u043D\u0438 \u043C\u0435\u0448\u043A\u0430\u044E\u0442\u044C \u0443
      \u043F\u0443\u0441\u0442\u0435\u043B\u044C\u043D\u0438\u0445 \u0456 \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u0438\u0445
      \u043C\u0456\u0441\u0446\u044F\u0445, \u0442\u0430\u043A\u0438\u0445 \u044F\u043A
      \u0440\u0443\u0457\u043D\u0438 \u0431\u0443\u0434\u0456\u0432\u0435\u043B\u044C
      \u0456 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0439\u043D\u0456
      \u0442\u0443\u043D\u0435\u043B\u0456, \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0436 \u0432\u043E\u043D\u0438 \u043B\u044E\u0431\u043B\u044F\u0442\u044C
      \u043C\u0456\u0441\u0446\u044F \u0437 \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u043C
      \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240974
    m_Localized: "\u041C\u043E\u0442\u043E\u0440\u043D\u0438\u0439 \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240975
    m_Localized: "\u041C\u0443\u0442\u0430\u0446\u0456\u044F \u0446\u044C\u043E\u0433\u043E
      \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434\u0443 \u0433\u0443\u043B\u0456\u0432
      \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0437\u043C\u0435\u043D\u0448\u0438\u043B\u0430
      \u0457\u0445\u043D\u044E \u0441\u0438\u043B\u0443 \u0442\u0430 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C,
      \u0430 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0432\u043F\u0430\u043A\u0438,
      \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u043B\u0430. \u0422\u0430\u043A\u043E\u0436
      \u0432\u043E\u043D\u0438 \u0440\u043E\u0437\u0432\u0438\u043D\u0443\u043B\u0438
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u043E \u0441\u0442\u0440\u0438\u0431\u043A\u0456\u0432
      \u043D\u0430 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0443 \u0432\u0438\u0441\u043E\u0442\u0443
      \u0456 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240976
    m_Localized: "\u0413\u043E\u043B\u043E\u0434\u043D\u0438\u0439 \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240977
    m_Localized: "\u0413\u0443\u043B\u0456-\u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438,
      \u0447\u0438\u0457 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456 \u0434\u043E
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443 \u043F\u0456\u0441\u043B\u044F
      \u043C\u0443\u0442\u0430\u0446\u0456\u0457 \u043B\u0438\u0448\u0435 \u0437\u0440\u043E\u0441\u043B\u0438.
      \u0421\u043B\u0456\u0434 \u043F\u043E\u0431\u043E\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240978
    m_Localized: "\u041D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240979
    m_Localized: "\u041F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u043C \u0436\u0438\u0442\u0442\u0454\u0434\u0456\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0456
      \u0446\u044C\u043E\u0433\u043E \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434\u0443
      \u0433\u0443\u043B\u0435\u0439 \u0454 \u0446\u0456\u043B\u0430 \u043A\u043E\u043B\u0435\u043A\u0446\u0456\u044F
      \u043D\u0430\u0439\u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456\u0448\u0438\u0445
      \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u0438\u0445 \u0440\u0435\u0447\u043E\u0432\u0438\u043D.
      \u041D\u0430\u043F\u0430\u0434\u0430\u044E\u0447\u0438, \u0432\u043E\u043D\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0442\u0438
      \u0445\u043C\u0430\u0440\u0443 \u043E\u0442\u0440\u0443\u0439\u043D\u043E\u0433\u043E
      \u0433\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240980
    m_Localized: "\u0421\u0432\u0456\u0442\u043D\u0438\u0439 \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240981
    m_Localized: "\u0426\u0435\u0439 \u0433\u0443\u043B\u044C \u0441\u0432\u0456\u0442\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u044E,
      \u0449\u043E \u043F\u0435\u0440\u0435\u043F\u043E\u0432\u043D\u044E\u0454 \u0439\u043E\u0433\u043E.
      \u041F\u043E\u0442\u0440\u0430\u043F\u0438\u0432\u0448\u0438 \u043F\u0456\u0434
      \u0439\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0438, \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0444\u0456\u0437\u0438\u0447\u043D\u0443
      \u0448\u043A\u043E\u0434\u0443, \u0430 \u0439 \u0434\u043E\u0437\u0443 \u043E\u043F\u0440\u043E\u043C\u0456\u043D\u0435\u043D\u043D\u044F.
      \u0422\u0430\u043A\u043E\u0436 \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u0441\u043F\u043B\u0435\u0441\u043A\u0438 \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F,
      \u0449\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0456\u043D\u0448\u0438\u0445
      \u0433\u0443\u043B\u0456\u0432 \u043F\u043E\u0431\u043B\u0438\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240982
    m_Localized: "\u0413\u0443\u043B\u044C-\u0441\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240983
    m_Localized: "\u0417\u0435\u043C\u043D\u0438\u0439 \u043F\u043E\u043D\u0456-\u0441\u043E\u043B\u0434\u0430\u0442,
      \u044F\u043A\u0438\u0439 \u0441\u0442\u0430\u0432 \u0433\u0443\u043B\u0435\u043C.
      \u041D\u0430 \u043D\u044C\u043E\u043C\u0443 \u0432\u0441\u0435 \u0449\u0435
      \u0432\u0438\u0434\u043D\u043E \u0437\u0430\u043B\u0438\u0448\u043A\u0438 \u0431\u0440\u043E\u043D\u0456,
      \u0430 \u0439\u043E\u0433\u043E \u0444\u0456\u0437\u0438\u0447\u043D\u0430
      \u0441\u0438\u043B\u0430 \u043F\u0456\u0441\u043B\u044F \u043C\u0443\u0442\u0430\u0446\u0456\u0457
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0437\u0440\u043E\u0441\u043B\u0430.
      \u041E\u0434\u043D\u0438\u043C \u0442\u0456\u043B\u044C\u043A\u0438 \u0443\u0434\u0430\u0440\u043E\u043C
      \u043A\u043E\u043F\u0438\u0442 \u043E\u0431 \u0437\u0435\u043C\u043B\u044E
      \u0432\u0456\u043D \u043C\u043E\u0436\u0435 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
      \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240984
    m_Localized: "\u0413\u0443\u043B\u044C-\u0440\u0456\u0437\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240985
    m_Localized: "\u041C\u0443\u0442\u0430\u0446\u0456\u044F \u0446\u044C\u043E\u0433\u043E
      \u0433\u0443\u043B\u044F \u043F\u0456\u0448\u043B\u0430 \u0434\u0430\u043B\u0456,
      \u043D\u0456\u0436 \u0443 \u0456\u043D\u0448\u0438\u0445 \u0439\u043E\u0433\u043E
      \u0440\u043E\u0434\u0438\u0447\u0456\u0432. \u0419\u043E\u0433\u043E \u0441\u0438\u043B\u0430,
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0456 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u043E\u0440\u0430\u0437\u043E\u0432\u043E \u0437\u0440\u043E\u0441\u043B\u0438,
      \u043D\u0430 \u0442\u0456\u043B\u0456 \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F
      \u0433\u043E\u0441\u0442\u0440\u0456 \u0448\u0438\u043F\u0438, \u0430 \u043D\u0430
      \u0434\u043E\u0434\u0430\u0447\u0443 \u0432\u0456\u043D \u0449\u0435 \u0439
      \u043D\u0430\u0431\u0443\u0432 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u043F\u043B\u044E\u0432\u0430\u0442\u0438\u0441\u044F \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u044E.
      \u0423 \u043F\u0456\u0434\u0441\u0443\u043C\u043A\u0443 \u0432\u0438\u0439\u0448\u043E\u0432
      \u043E\u0434\u0438\u043D \u0456\u0437 \u043D\u0430\u0439\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0445
      \u043C\u0443\u0442\u0430\u043D\u0442\u0456\u0432 \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240986
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0438\u0439
      \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240987
    m_Localized: "\u0423 \u0440\u0443\u0457\u043D\u0430\u0445 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430
      \u043C\u0435\u0448\u043A\u0430\u0454 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439
      \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434 \u0434\u0438\u043A\u0438\u0445
      \u0433\u0443\u043B\u0456\u0432, \u0449\u043E \u0432\u0438\u043D\u0438\u043A\u043B\u0438
      \u043F\u0456\u0434 \u0434\u0456\u0454\u044E \u043D\u0435 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457,
      \u0430 \u0420\u043E\u0436\u0435\u0432\u043E\u0457 \u0425\u043C\u0430\u0440\u0438.
      \u0412\u043E\u043D\u0438 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456
      \u0442\u0438\u043C, \u0449\u043E \u0457\u0445 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
      \u0432\u0431\u0438\u0442\u0438 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C\u0438
      \u043A\u0443\u043B\u044F\u043C\u0438, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u043F\u0456\u0441\u043B\u044F \"\u0441\u043C\u0435\u0440\u0442\u0456\" \u0432\u043E\u043D\u0438
      \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E \u0432\u0456\u0434\u0440\u043E\u0434\u044F\u0442\u044C\u0441\u044F.
      \u0429\u043E\u0431 \u0443\u0431\u0438\u0442\u0438 \u0446\u0438\u0445 \u0433\u0443\u043B\u0456\u0432
      \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0457\u0445 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0441\u043F\u0430\u043B\u0438\u0442\u0438 \u0430\u0431\u043E \u0434\u0435\u0437\u0456\u043D\u0442\u0435\u0433\u0440\u0443\u0432\u0430\u0442\u0438.
      \u0414\u043E \u0442\u043E\u0433\u043E \u0436 \u0433\u0443\u043B\u0456-\u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438
      \u0437\u0434\u0430\u0442\u043D\u0456 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240988
    m_Localized: "\u0420\u043E\u0437\u0434\u0443\u0442\u0438\u0439 \u0433\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240989
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0430 \u0425\u043C\u0430\u0440\u0430
      \u0442\u0430\u043A \u0433\u043B\u0438\u0431\u043E\u043A\u043E \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0430
      \u0432 \u043C\u0435\u0440\u0442\u0432\u0443 \u043F\u043B\u043E\u0442\u044C
      \u0446\u0438\u0445 \u0433\u0443\u043B\u0456\u0432, \u0449\u043E \u0441\u0442\u0430\u043B\u0430
      \u0441\u0430\u043C\u043E\u044E \u0457\u0445\u043D\u044C\u043E\u044E \u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044E.
      \u0422\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0438 \u0437\u0434\u0430\u0442\u043D\u0456
      \u0433\u0435\u043D\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0457\u0457 \u0441\u0430\u043C\u0456
      \u0437\u0430 \u0441\u0432\u043E\u0457\u043C \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240990
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0430
      \u0432\u0456\u0434\u044C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240991
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043D\u0430\u0439\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0439
      \u0437 \u0456\u0441\u043D\u0443\u044E\u0447\u0438\u0445 \u0433\u0443\u043B\u0456\u0432.
      \u0412\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u0454\u0442\u044C\u0441\u044F
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u044E \u0441\u0438\u043B\u043E\u044E,
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E \u0456 \u0436\u0438\u0432\u0443\u0447\u0456\u0441\u0442\u044E.
      \u0423 \u0441\u0432\u043E\u0457 \u0443\u0434\u0430\u0440\u0438 \u0432\u043E\u043D\u0430
      \u0432\u043A\u043B\u0430\u0434\u0430\u0454 \u0447\u043E\u0440\u043D\u0443 \u043C\u0430\u0433\u0456\u044E,
      \u0432\u0456\u0434 \u044F\u043A\u043E\u0457 \u043D\u0435 \u0440\u044F\u0442\u0443\u0454
      \u0431\u0440\u043E\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240992
    m_Localized: "\u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240993
    m_Localized: "\u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0438 - \u0456\u0441\u0442\u043E\u0442\u0438,
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0456 \u0411\u043E\u0433\u0438\u043D\u0435\u044E
      \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u043F\u043E\u043D\u0456
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0437\u0456\u043B\u043B\u044F
      \u0432\u0438\u043C\u0443\u0448\u0435\u043D\u043E\u0457 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457.
      \u041C\u0430\u044E\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u0456, \u043D\u0456\u0436
      \u0443 \u043F\u043E\u043D\u0456, \u0440\u043E\u0437\u043C\u0456\u0440\u0438,
      \u0432\u0435\u043B\u0438\u043A\u0456 \u043A\u0440\u0438\u043B\u0430 \u0456
      \u0434\u043E\u0432\u0433\u0438\u0439 \u0440\u0456\u0433. \u0422\u0430\u043A\u043E\u0436
      \u043C\u0430\u044E\u0442\u044C \u0446\u0456\u043B\u0443 \u043D\u0438\u0437\u043A\u0443
      \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439: \u043C\u043E\u0436\u0443\u0442\u044C
      \u043B\u0456\u0442\u0430\u0442\u0438, \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0456\u0457,
      \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u043E \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C, \u0431\u043E\u0439\u043E\u0432\u0438\u043C\u0438
      \u0456 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043C\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C\u0438.
      \u0423\u0441\u0435 \u0446\u0435 \u0437\u0430\u0433\u0430\u043B\u043E\u043C
      \u0440\u043E\u0431\u0438\u0442\u044C \u0457\u0445 \u043E\u0434\u043D\u0438\u043C\u0438
      \u0437 \u043D\u0430\u0439\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0445
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240994
    m_Localized: "\u0421\u0438\u043D\u0456\u0439 \u0430\u043B\u0456\u043A\u043E\u0440\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240995
    m_Localized: "\u0421\u0438\u043D\u0456 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0438
      \u043D\u0430 \u0434\u043E\u0434\u0430\u0442\u043E\u043A \u0434\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0438\u0445
      \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439 \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0456.
      \u041F\u0440\u0438\u0445\u043E\u0432\u0443\u044E\u0447\u0438 \u0434\u043E \u043F\u043E\u0440\u0438
      \u0441\u0432\u043E\u044E \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C,
      \u0432\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u043F\u0456\u0434\u0441\u0442\u0443\u043F\u043D\u043E
      \u043D\u0430\u043F\u0430\u0441\u0442\u0438 \u0456\u0437 \u0437\u0430\u0441\u0456\u0434\u043A\u0438.
      \u0422\u0430\u043A\u043E\u0436 \u0441\u0435\u0440\u0435\u0434 \u0443\u0441\u0456\u0445
      \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432 \u0432\u043E\u043D\u0438
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448 \u0436\u0438\u0432\u0443\u0447\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240996
    m_Localized: "\u0424\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u0438\u0439 \u0430\u043B\u0456\u043A\u043E\u0440\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240997
    m_Localized: "\u0424\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u0456 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0438
      \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C \u0456 \u0434\u043E
      \u0442\u043E\u0433\u043E \u0436, \u043A\u0440\u0456\u043C \u0443\u0441\u0456\u0445
      \u0456\u043D\u0448\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C,
      \u0432\u043C\u0456\u044E\u0442\u044C \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
      \u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u0457
      \u0432\u043E\u043D\u0438 \u0432\u043C\u0456\u044E\u0442\u044C \u0443\u0445\u0438\u043B\u044F\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0430\u0442\u0430\u043A \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u0430\u0431\u043E \u043D\u0430\u043F\u043E\u043B\u0435\u0433\u043B\u0438\u0432\u043E
      \u0439\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725240998
    m_Localized: "\u0417\u0435\u043B\u0435\u043D\u0438\u0439 \u0430\u043B\u0456\u043A\u043E\u0440\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725240999
    m_Localized: "\u0417\u0435\u043B\u0435\u043D\u0456 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043C\u0456\u0446\u043D\u0456
      \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0449\u0438\u0442\u0438, \u0430
      \u0442\u0430\u043A\u043E\u0436, \u043D\u0430 \u0434\u043E\u0434\u0430\u0442\u043E\u043A
      \u0434\u043E \u0432\u0441\u0456\u0445 \u0456\u043D\u0448\u0438\u0445 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C
      \u0434\u0430\u0440\u043E\u043C \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0456\u0457.
      \u0417 \u0439\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0432\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0432\u043F\u043B\u0438\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0440\u043E\u0437\u0443\u043C \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
      \u0434\u0435\u0437\u043E\u0440\u0456\u0454\u043D\u0442\u0443\u044E\u0447\u0438
      \u0439\u043E\u0433\u043E \u0430\u0431\u043E \u043D\u0430\u0441\u0438\u043B\u0430\u044E\u0447\u0438
      \u043A\u043E\u0448\u043C\u0430\u0440\u043D\u0456 \u0432\u0438\u0434\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241000
    m_Localized: "\u041A\u0440\u0438\u0432\u0430\u0432\u0438\u0439 \u041C\u0456\u0441\u044F\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241001
    m_Localized: "\u0414\u0438\u0432\u043D\u0438\u0439 \u0430\u043B\u0456\u043A\u043E\u0440\u043D
      \u0447\u043E\u0440\u043D\u043E-\u0447\u0435\u0440\u0432\u043E\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443. \u0421\u0445\u043E\u0436\u0435,
      \u0432\u043E\u043D\u0430 \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u0447\u0438\u043D\u043E\u043C
      \u043E\u0431'\u0454\u0434\u043D\u0430\u043B\u0430 \u0432 \u0441\u043E\u0431\u0456
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456 \u0441\u0438\u043B\u0438 \u0432\u0441\u0456\u0445
      \u0442\u0440\u044C\u043E\u0445 \u0432\u0438\u0434\u0456\u0432 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432,
      \u0449\u043E \u0437\u0440\u043E\u0431\u0438\u043B\u043E \u0457\u0457 \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241002
    m_Localized: "\u041F\u0440\u0438\u043C\u0430\u0440\u043D\u0435 \u043B\u0435\u0437\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241003
    m_Localized: "\u041F\u0435\u043A\u0435\u043B\u044C\u043D\u0456 \u0433\u043E\u043D\u0447\u0430\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241004
    m_Localized: "\u041C\u0443\u0442\u043E\u0432\u0430\u043D\u0456 \u043D\u0430\u0449\u0430\u0434\u043A\u0438
      \u0430\u043B\u043C\u0430\u0437\u043D\u0438\u0445 \u043F\u0441\u0456\u0432,
      \u0449\u043E \u0432\u043E\u043B\u043E\u0434\u0456\u044E\u0442\u044C \u0440\u043E\u0437\u0443\u043C\u043E\u043C,
      \u0430\u043B\u0435 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0456 \u0449\u043E\u0434\u043E
      \u043F\u043E\u043D\u0456 \u0456 \u0432\u043A\u0440\u0430\u0439 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456.
      \u041C\u0430\u044E\u0442\u044C \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E - \u0437\u0443\u0431\u0438 \u0456 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0456,
      \u0433\u043E\u0441\u0442\u0440\u0456 \u0456 \u043C\u0456\u0446\u043D\u0456
      \u043A\u0456\u0433\u0442\u0456 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0456\u0445
      \u043B\u0430\u043F\u0430\u0445, \u044F\u043A\u0438\u043C\u0438 \u043B\u0435\u0433\u043A\u043E
      \u043C\u043E\u0436\u0443\u0442\u044C \u0440\u0456\u0437\u0430\u0442\u0438 \u0456
      \u043C\u0435\u0442\u0430\u043B, \u0456 \u043A\u0430\u043C\u0456\u043D\u044C.
      \u0422\u0430\u043A\u043E\u0436 \u043C\u0430\u044E\u0442\u044C \u0433\u0430\u0440\u043D\u0438\u0439
      \u043D\u044E\u0445 \u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u043B\u0435\u0433\u043A\u043E
      \u0432\u0456\u0434\u0447\u0443\u0442\u0438 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u0430\u0431\u043E \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0433\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430, \u044F\u043A\u0449\u043E \u043F\u0456\u0434\u0456\u0439\u0434\u0443\u0442\u044C
      \u0434\u043E\u0441\u0438\u0442\u044C \u0431\u043B\u0438\u0437\u044C\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241005
    m_Localized: "\u0413\u043E\u043D\u0447\u0430 \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241006
    m_Localized: "\u0410\u043D\u043A\u043B\u0430\u0432 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u0441\u043F\u043E\u0441\u0456\u0431 \u043F\u0440\u0438\u0434\u0443\u0448\u0443\u0432\u0430\u0442\u0438
      \u0432\u043E\u043B\u044E \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u0438\u0445
      \u0433\u043E\u043D\u0447\u0430\u043A\u0456\u0432 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445 \u0448\u043E\u043B\u043E\u043C\u0456\u0432
      \u0456 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0447\u0456\u0432,
      \u043F\u0456\u0434\u043F\u043E\u0440\u044F\u0434\u043A\u043E\u0432\u0443\u044E\u0447\u0438
      \u0457\u0445 \u0441\u043E\u0431\u0456, \u0456 \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0432\u0448\u0438 \u043D\u0430
      \u0441\u0432\u043E\u044E \u0437\u0431\u0440\u043E\u044E. \u0427\u0435\u0440\u0435\u0437
      \u0446\u0456 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457, \u0449\u043E
      \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0442\u044C \u043D\u0430 \u0457\u0445\u043D\u0456\u0439
      \u043C\u043E\u0437\u043E\u043A, \u0433\u043E\u043D\u0447\u0430\u043A\u0438
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443 \u0432\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C
      \u0437\u043D\u0430\u0447\u043D\u0443 \u0447\u0430\u0441\u0442\u0438\u043D\u0443
      \u0441\u0432\u043E\u0433\u043E \u0440\u043E\u0437\u0443\u043C\u0443 \u0456
      \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u0456, \u0430\u043B\u0435 \u043D\u0435
      \u0441\u0438\u043B\u0438, \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456
      \u0442\u0430 \u043B\u044E\u0442\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241007
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241008
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0438
      - \u0446\u0435, \u0441\u0443\u0434\u044F\u0447\u0438 \u0437 \u0443\u0441\u044C\u043E\u0433\u043E,
      \u043C\u0443\u0442\u043E\u0432\u0430\u043D\u0456 \u043F\u0456\u0434 \u0434\u0456\u0454\u044E
      \u041F\u043E\u0440\u0447\u0456 \u0430\u0431\u043E \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457
      \u043F\u0430\u0440\u0430\u0441\u043F\u0440\u0430\u0439\u0442\u0438. \u041D\u0430\u0431\u0443\u0432\u0448\u0438
      \u043D\u043E\u0432\u0438\u0445, \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0445
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439, \u0432\u043E\u043D\u0438
      \u043D\u0435 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0434\u043E \u0456\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E
      \u0440\u043E\u0437\u043C\u043D\u043E\u0436\u0435\u043D\u043D\u044F, \u0447\u0435\u0440\u0435\u0437
      \u0449\u043E \u0457\u0445\u043D\u044F \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043D\u0430 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0456\u0439
      \u041F\u0443\u0441\u0442\u043E\u0448\u0456 \u0432\u0435\u043B\u044C\u043C\u0438
      \u0432\u0435\u043B\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241009
    m_Localized: "\u0406\u043D\u0448\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241010
    m_Localized: "\u041A\u0440\u043E\u0432\u043E\u043A\u0440\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241011
    m_Localized: "\u041A\u0430\u0436\u0430\u043D\u0438-\u0432\u0430\u043C\u043F\u0456\u0440\u0438,
      \u044F\u043A\u0456 \u043C\u0443\u0442\u0443\u0432\u0430\u043B\u0438 \u0456
      \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u043B\u0438\u0441\u044F \u0432 \u0440\u043E\u0437\u043C\u0456\u0440\u0430\u0445.
      \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0441\u0435\u043B\u044F\u0442\u044C\u0441\u044F
      \u0432 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0445 \u0456 \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u0438\u0445
      \u0431\u0443\u0434\u0456\u0432\u043B\u044F\u0445, \u043F\u0435\u0447\u0435\u0440\u0430\u0445,
      \u043F\u0456\u0434 \u043C\u043E\u0441\u0442\u0430\u043C\u0438 \u0442\u0430
      \u0435\u0441\u0442\u0430\u043A\u0430\u0434\u0430\u043C\u0438. \u0423 \u043F\u0435\u0440\u0435\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u0456
      \u0441\u0432\u043E\u0457\u0445 \u0436\u0435\u0440\u0442\u0432 \u0437\u0430\u0432\u0437\u044F\u0442\u0456
      \u0439 \u043D\u0430\u043F\u043E\u043B\u0435\u0433\u043B\u0438\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241012
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0438\u0439
      \u043D\u0435\u0442\u043E\u043F\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241013
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0438\u0439
      \u043F\u0456\u0434\u0432\u0438\u0434 \u043A\u0440\u043E\u0432\u043E\u043A\u0440\u0438\u043B\u0430,
      \u0449\u043E \u043F\u0440\u0438\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0432\u0441\u044F
      \u0434\u043E \u0420\u043E\u0436\u0435\u0432\u043E\u0457 \u0425\u043C\u0430\u0440\u0438,
      \u0456 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0436\u0430\u0445\u043B\u0438\u0432\u0456\u0448\u0438\u0439."
    m_Metadata:
      m_Items: []
