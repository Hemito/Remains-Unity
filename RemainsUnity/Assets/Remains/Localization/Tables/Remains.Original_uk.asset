      m_Items: []
  - m_Id: 2725241670
    m_Localized: "\u041F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B. 50 MG"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241671
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0438\u0439
      \u043F\u0430\u0442\u0440\u043E\u043D \u0437\u0456 \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u043C
      \u043D\u0430\u043A\u043E\u043D\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u043E\u0434\u0438\u043D
      \u0456\u0437 \u043D\u0430\u0439\u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456\u0448\u0438\u0445,
      \u043D\u0430\u0439\u0434\u043E\u0440\u043E\u0436\u0447\u0438\u0445 \u0456 \u043D\u0430\u0439\u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241672
    m_Localized: "5,56-\u043C\u043C \u043F\u0430\u0442\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241673
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0438\u0439
      \u043F\u0430\u0442\u0440\u043E\u043D \u0434\u043B\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u0445
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043E\u043A, \u043F\u0456\u0434
      \u0447\u0430\u0441 \u0412\u0456\u0439\u043D\u0438 \u0448\u0438\u0440\u043E\u043A\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0432\u0441\u044F
      \u043E\u0431\u043E\u043C\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241674
    m_Localized: "5-\u043C\u043C \u043F\u0430\u0442\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241675
    m_Localized: "\u041F\u0430\u0442\u0440\u043E\u043D \u0434\u0440\u0456\u0431\u043D\u043E\u0433\u043E
