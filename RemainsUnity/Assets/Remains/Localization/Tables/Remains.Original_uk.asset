  - m_Id: 2733629935
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629936
    m_Localized: "\u0422\u0430\u043A, @lp? \u0428\u043E\u0441\u044C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629937
    m_Localized: "\u041D\u0443, \u0437\u0430\u0433\u0430\u043B\u043E\u043C, \u0442\u0430\u043A.
      \u0421\u043A\u0430\u0436\u0438, \u0437\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u0456
      \u043A\u0456\u043B\u044C\u043A\u0430 \u043C\u0456\u0441\u044F\u0446\u0456\u0432
      \u0442\u0438 \u043D\u0435 \u0431\u0430\u0447\u0438\u0432 \u043D\u0456\u043A\u043E\u0433\u043E,
      \u0441\u0445\u043E\u0436\u043E\u0433\u043E \u043D\u0430 \u043C\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629938
    m_Localized: "\u0413\u0430? \u0423 \u0441\u0435\u043D\u0441\u0456 \u0441\u0445\u043E\u0436\u043E\u0433\u043E?
      \u0422\u0430\u043A\u043E\u0433\u043E \u0436 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E?
      \u0410\u0431\u043E \u0442\u0430\u043A\u043E\u0433\u043E \u0436 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044F
      \u043F\u0440\u0438\u0433\u043E\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629939
    m_Localized: "(\u0437\u0431\u0435\u043D\u0442\u0435\u0436\u0435\u043D\u043E)
      \u041D\u0456. \u042F \u043C\u0430\u044E \u043D\u0430 \u0443\u0432\u0430\u0437\u0456
      \"\u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629940
    m_Localized: "\u0410, \u0432 \u0446\u044C\u043E\u043C\u0443 \u0441\u0435\u043D\u0441\u0456.
      \u0422\u0430\u043A, \u0431\u0430\u0447\u0438\u0432 \u043E\u0434\u043D\u0443.
      \u0414\u0438\u0432\u0430\u0447\u043A\u0430, \u044F\u043A\u0448\u043E \u0447\u0435\u0441\u043D\u043E,
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u043D\u043E,
      \u0448\u043E \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430.
      \u0410\u043B\u0435 \u0445\u043E\u0440\u043E\u0448\u0430. \u0421\u0435\u0440\u0446\u0435
      \u0432 \u043D\u0435\u0457 \u0434\u043E\u0431\u0440\u0435. \u042F \u0436 \u0449\u0435
      \u0445\u043E\u0442\u0456\u0432 \u0443 \u0442\u0435\u0431\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u0442\u0438,
      \u0447\u0438 \u043D\u0435 \u0442\u0432\u043E\u044F \u0446\u0435 \u0437\u043D\u0430\u0439\u043E\u043C\u0430,
      \u0442\u0430 \u044F\u043A\u0441\u044C \u043D\u0435 \u0434\u043E \u0442\u043E\u0433\u043E
      \u0431\u0443\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629941
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u0448\u0435, \u0434\u0435\u0441\u044C
      \u0442\u0440\u0438 \u0447\u0438 \u0447\u043E\u0442\u0438\u0440\u0438 \u043C\u0456\u0441\u044F\u0446\u0456
      \u0442\u043E\u043C\u0443 \u0432\u043E\u043D\u0430 \u043F\u0440\u0438\u0439\u0448\u043B\u0430
      \u0434\u043E \u043D\u0430\u0441. \u0421\u0430\u043C\u0430 \u0441\u043B\u0430\u0431\u043A\u0430,
      \u0433\u043E\u043B\u043E\u0434\u043D\u0430, \u043F\u0456\u0448\u043B\u0430
      \u0431\u0443\u043B\u043E \u0434\u043E \u043D\u0456\u0447\u043B\u0456\u0436\u043A\u0438,
      \u0430\u043B\u0435 \u0437\u0443\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F,
      \u043F\u043E\u0431\u0430\u0447\u0438\u0432\u0448\u0438 \u043A\u0443\u0442\u043E\u0447\u043E\u043A
      \u0414\u043E\u043A\u0430. \u0422\u0430\u043C \u0432\u0456\u043D \u044F\u043A\u0440\u0430\u0437
      \u0448\u0442\u043E\u043F\u0430\u0432 \u043F\u0430\u0440\u0443 \u043D\u0430\u0448\u0438\u0445,
      \u044F\u043A\u0438\u0445 \u0440\u0435\u0439\u0434\u0435\u0440\u0438 \u043F\u0456\u0434\u0441\u0442\u0440\u0435\u043B\u0438\u043B\u0438.
      \u0422\u0430\u043A \u0432\u043E\u043D\u0430 \u0437\u0430\u0439\u0448\u043B\u0430,
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0437 \u043D\u0438\u043C
      \u043F\u0440\u043E \u0449\u043E\u0441\u044C \u0445\u0432\u0438\u043B\u0438\u043D
      \u043F'\u044F\u0442\u044C \u0456 \u0432\u0441\u0442\u0430\u043B\u0430 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438
      \u043F\u043E\u0440\u0443\u0447. \u0412\u0456\u0434\u0442\u043E\u0434\u0456
      \u0432\u043E\u043D\u0430 \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0414\u043E\u043A\u043E\u043C
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0439 \u043E\u0448\u0438\u0432\u0430\u043B\u0430\u0441\u044F.
      \u0412\u0456\u043D \u0457\u0457 \u0431\u0430\u0433\u0430\u0442\u043E \u0445\u0432\u0430\u043B\u0438\u0432,
      \u0430\u043B\u0435 \u043C\u0456\u0436 \u043D\u0430\u043C\u0438 \u0431\u0443\u0440\u0447\u0430\u0432,
      \u0442\u0438\u043F\u0443 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0430 \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u0445\u0432\u043E\u0440\u0438\u043C \u0434\u0430\u0432\u0430\u0442\u0438 \u043B\u0456\u043A\u0438,
      \u0437\u0430 \u044F\u043A\u0456 \u0442\u0456 \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629942
    m_Localized: "\u0410 \u0447\u043E\u043C\u0443 \u0457\u0457 \u0437\u0430\u0440\u0430\u0437
      \u043D\u0435\u043C\u0430\u0454 \u0442\u0443\u0442? \u0414\u043E\u043A \u0421\u0435\u043F\u0441\u0438\u0441
      \u0457\u0457 \u0432\u0438\u0433\u043D\u0430\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629943
    m_Localized: "\u0422\u0430 \u043D\u0454, \u0448\u043E \u0442\u0438. \u0410\u043B\u0435,
      \u0447\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438, \u0431\u043E\u044E\u0441\u044F,
      \u0448\u043E \u0432\u0441\u0435 \u0449\u0435 \u0433\u0456\u0440\u0448\u0435.
      \u0410\u043B\u0435 \u0437\u043D\u0430\u0454\u0448, \u0437\u0430\u043F\u0438\u0442\u0430\u0439-\u043D\u043E
      \u043A\u0440\u0430\u0449\u0435 \u0432 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0414\u043E\u043A\u0430... \u0412\u0456\u043D \u0442\u043E\u0431\u0456 \u0437\u043D\u0430\u0447\u043D\u043E
      \u043B\u0456\u043F\u0448\u0435 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629944
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437 \u0414\u043E\u043A\u043E\u043C
      \u043F\u0440\u043E \u0412\u0435\u043B\u044C\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629945
    m_Localized: "\u0421\u043B\u0443\u0445\u0430\u0439, \u0414\u043E\u043A, \u0454
      \u0440\u043E\u0437\u043C\u043E\u0432\u0430. \u0414\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629946
    m_Localized: "\u042F\u043A\u0449\u043E \u0446\u0435 \u0432\u0435\u043D\u0435\u0440\u0438\u0447\u043D\u0435,
      \u0442\u043E \u043A\u0440\u0430\u0449\u0435 \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0442\u0432\u043E\u0454 \u043F\u0438\u0442\u0430\u043D\u043D\u044F \u0437\u0430
      \u0444\u0456\u0440\u0430\u043D\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629947
    m_Localized: "\u0422\u0430 \u043D\u0456, \u044F \u043D\u0435 \u043F\u0440\u043E
      \u0442\u0435. \u0425\u043E\u0447\u0443 \u0442\u0435\u0431\u0435 \u0440\u043E\u0437\u043F\u0438\u0442\u0430\u0442\u0438
      \u043F\u0440\u043E \u0432\u0438\u0445\u0456\u0434\u0446\u044F \u0437\u0456
      \u0421\u0442\u0456\u0439\u043B\u0430. \u0417\u043D\u0430\u0454\u0448 \u0442\u0430\u043A\u0443?
      \u041C\u0435\u043D\u0456 \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0449\u043E
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u0442\u043E\u043C\u0443
      \u0432\u043E\u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u043B\u0430
      \u0442\u043E\u0431\u0456 \u0442\u0443\u0442, \u0443 \u043A\u043B\u0456\u043D\u0456\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629948
    m_Localized: "\u0410, \u043D\u0443 \u0442\u0430\u043A, \u043F\u0430\u043C'\u044F\u0442\u0430\u044E,
      \u0437\u0432\u0456\u0441\u043D\u043E \u0436. \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u0420\u0435\u043C\u0435\u0434\u0456 - \u0442\u0430\u043A \u0457\u0457 \u0437\u0432\u0430\u043B\u0438.
      \u0422\u0430\u043A, \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u043B\u0430
      \u043C\u0435\u043D\u0456 \u0442\u0443\u0442 \u044F\u043A\u0438\u0439\u0441\u044C
      \u0447\u0430\u0441. \u0414\u0443\u0436\u0435 \u0437\u0434\u0456\u0431\u043D\u0430,
      \u0456 \u0432 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0442\u044C\u0441\u044F,
      \u0445\u043E\u0447\u0430 \u0439 \u0441\u0430\u043C\u043E\u0443\u0447\u043A\u0430.
      \u041D\u0430\u0432\u0447\u0430\u043B\u0430\u0441\u044F \u0437\u0430 \u043A\u043D\u0438\u0436\u043A\u0430\u043C\u0438,
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u043D\u043E.
      \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0438 \u043C\u0430\u043B\u043E,
      \u0430 \u0432 \u0445\u0456\u0440\u0443\u0440\u0433\u0456\u0457 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u043D\u0456\u044F\u043A\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629949
    m_Localized: "\u0410\u043B\u0435 \u0434\u0443\u0436\u0435 \u0434\u043E\u0431\u0440\u0430,
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E.
      \u0422\u0430\u043A \u0456 \u043D\u043E\u0440\u043E\u0432\u0438\u043B\u0430
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438 \u0432\u0441\u0456\u043C
      \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E. \u041D\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u043E\u043D\u0456, \u0430 \u0439
      \u0443\u0437\u0430\u0433\u0430\u043B\u0456 \u0432\u0441\u0456\u043C. \u041C\u0438
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432 \u0456\u0437
      \u043D\u0435\u044E \u043F\u043E\u0441\u0432\u0430\u0440\u0438\u043B\u0438\u0441\u044F
      \u0437 \u0446\u044C\u043E\u0433\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u0443,
      \u0442\u043E\u043C\u0443 \u0449\u043E \u0457\u0457 \u0434\u043E\u0431\u0440\u043E\u0442\u0430
      \u0432\u0438\u0432\u043E\u0434\u0438\u043B\u0430 \u043A\u043B\u0456\u043D\u0456\u043A\u0443
      \u0432 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u0438\u0439 \u0431\u0430\u043B\u0430\u043D\u0441.
      \u0410\u043B\u0435 \u043D\u0430\u043C \u0432\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
      \u0437\u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0456\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629950
    m_Localized: "\u0411\u0430\u0433\u0430\u0442\u043E \u0440\u043E\u0437\u043F\u0438\u0442\u0443\u0432\u0430\u043B\u0430
      \u043F\u0440\u043E \u043D\u0430\u0448\u0435 \u0436\u0438\u0442\u0442\u044F,
      \u0430\u043B\u0435 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435 \u0446\u0456\u043A\u0430\u0432\u0438\u043B\u0430\u0441\u044F
      \u0433\u0443\u043B\u044F\u043C\u0438. \u041D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
      \u0440\u043E\u0437\u043A\u0440\u0438\u0442\u0438 \u0441\u0435\u043A\u0440\u0435\u0442
      \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u043D\u0435-\u0436\u0438\u0442\u0442\u044F,
      \u043D\u0435 \u0432\u0456\u0440\u0438\u043B\u0430 \u043C\u043E\u0457\u043C
      \u0441\u043B\u043E\u0432\u0430\u043C, \u0449\u043E \u0446\u0435 \u0447\u043E\u0440\u043D\u0430
      \u043C\u0430\u0433\u0456\u044F \u0437\u0435\u0431\u0440. \u0417\u0440\u0435\u0448\u0442\u043E\u044E
      \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0441\u0430\u043C\u0430 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F.
      \u0414\u0443\u0440\u043D\u0430 \u0437\u0430\u0442\u0456\u044F, \u044F\u043A
      \u043D\u0430 \u043C\u0435\u043D\u0435. \u0413\u0443\u043B\u0456\u0432 \u0443\u0436\u0435
      \u043D\u0435 \u0432\u0438\u043B\u0456\u043A\u0443\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629951
    m_Localized: "\u0421\u043F\u0435\u0440\u0448\u0443 \u0448\u0443\u043A\u0430\u043B\u0430
      \u0457\u0445 \u043F\u043E \u043E\u043A\u0440\u0443\u0437\u0456... \u042F \u0457\u0457
      \u043D\u0430\u043C\u0430\u0433\u0430\u0432\u0441\u044F \u0432\u0456\u0434\u0440\u0430\u0434\u0438\u0442\u0438,
      \u0442\u0430 \u0432\u0441\u0435 \u043C\u0430\u0440\u043D\u043E. \u0410 \u043F\u043E\u0442\u0456\u043C
      \u044F\u043A\u043E\u0441\u044C \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u043D\u0456\u0431\u0438 \u0437\u043D\u0430\u0454, \u0434\u0435 \u0446\u0438\u0445
      \u0456\u0441\u0442\u043E\u0442 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435.
      \u041D\u0443 \u044F \u0437\u0434\u043E\u0433\u0430\u0434\u0443\u044E\u0441\u044F,
      \u0434\u0435 - \u0432 \u044F\u043A\u0456\u0439-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457 \u0430\u0431\u043E
      \u0456\u043D\u0448\u0456\u0439 \u0434\u0456\u0440\u0456. \u041F\u043E\u0442\u0456\u043C
      \u043F\u0456\u0448\u043B\u0430, \u043D\u0443 \u0439 \u0443\u0441\u0435, \u0442\u0430\u043A
      \u0456 \u043D\u0435 \u0431\u0430\u0447\u0438\u043B\u0438 \u0457\u0457 \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629952
    m_Localized: "\u0428\u043A\u043E\u0434\u0430... \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0433\u0443\u043B\u0456\u0432, \u043D\u0456\u0436 \u0431\u0443\u043B\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E. \u0414\u0438\u0432\u0438\u0441\u044C,
      \u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u0457\u0457 \u043F\u043E\u043C\u0438\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629953
    m_Localized: "\u0406 \u0432\u0438 \u0449\u043E, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u0448\u0443\u043A\u0430\u043B\u0438 \u0457\u0457?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629954
    m_Localized: "\u0428\u0443\u043A\u0430\u043B\u0438. \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456
      \u043B\u0456\u0442\u0430\u0432, \u0448\u0443\u043A\u0430\u0432, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043F\u043E \u0441\u0442\u043E\u043A\u0430\u0445 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432.
      \u041D\u0456\u044F\u043A\u0438\u0445 \u0441\u043B\u0456\u0434\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629955
    m_Localized: "\u041E\u0441\u044C \u044F\u043A... \u0414\u044F\u043A\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629956
    m_Localized: "\u0422\u0430 \u0437\u0430 \u0449\u043E \u0442\u0443\u0442 \u0434\u044F\u043A\u0443\u0432\u0430\u0442\u0438...
      \u0410 \u0442\u043E\u0431\u0456 \u043D\u0430\u0432\u0456\u0449\u043E \u0432\u043E\u043D\u0430?
      \u0412\u0438 \u0431\u0443\u043B\u0438 \u0437\u043D\u0430\u0439\u043E\u043C\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629957
    m_Localized: "\u0422\u0430\u043A... \u0442\u043E\u0431\u0442\u043E \u043D\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629958
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629959
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2733629960
    m_Localized: "\u041D\u0443 \u0433\u0430\u0440\u0430\u0437\u0434, \u0441\u043F\u0440\u0430\u0432\u0430
      \u0442\u0432\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629961
    m_Localized: "\u0421\u0442\u043E\u043F! \u0414\u0430\u043B\u0456 \u0439\u0442\u0438
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E! \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0456\u043D\u0448\u0438\u0439
      \u0448\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629962
    m_Localized: "\u0422\u0430\u0431\u0456\u0440? \u0422\u0443\u0442? \u0426\u0456\u043A\u0430\u0432\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629963
    m_Localized: "\u0422\u0440\u0435\u0431\u0430 \u043E\u0437\u0438\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0443\u0432\u0430\u0436\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629964
    m_Localized: "\u041E\u0433\u043B\u044F\u0434 \u0442\u0430\u0431\u043E\u0440\u0443
      \u0432 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629965
    m_Localized: "\u0422\u0430\u0430\u0430\u043A. \u0421\u043B\u0456\u0434\u0456\u0432
      \u0433\u0443\u043B\u0456\u0432 \u043D\u0435\u043C\u0430\u0454 - \u0443\u0436\u0435
      \u0434\u043E\u0431\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629966
    m_Localized: "\u0410\u043B\u0435 \u0442\u0443\u0442 \u0454 \u043E\u0437\u043D\u0430\u043A\u0438
      \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0438. \u041C\u0430\u0442\u0440\u0430\u0446
      \u0437\u0456\u043C'\u044F\u0442\u0438\u0439, \u043D\u0430\u0447\u0435 \u043F\u043E
      \u043D\u044C\u043E\u043C\u0443 \u043F\u043E\u0442\u043E\u043F\u0442\u0430\u043B\u0430\u0441\u044F
      \u043F\u0430\u0440\u0430 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432.
      \u041E\u0434\u043D\u0430 \u0441\u0442\u043E\u043F\u043A\u0430 \u043A\u043D\u0438\u0433
      \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u0442\u0430. \u0422\u0435
      \u0436 \u0441\u0430\u043C\u0435 \u0437 \u043A\u0430\u0437\u0430\u043D\u043A\u043E\u043C
      \u0456 \u0441\u043A\u043B\u044F\u043D\u043A\u0430\u043C\u0438 \u043D\u0430
      \u0441\u0442\u043E\u043B\u0456. \u0412\u043E\u043D\u0438 \u0440\u043E\u0437\u0431\u0438\u0442\u0456,
      \u043D\u0430\u0447\u0435 \u0432\u043F\u0430\u043B\u0438 \u043F\u0456\u0441\u043B\u044F
      \u0442\u043E\u0433\u043E, \u044F\u043A \u0445\u0442\u043E\u0441\u044C \u0437
      \u0443\u0441\u0456\u0454\u0457 \u0441\u0438\u043B\u0438 \u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0432
      \u0441\u0442\u0456\u043B \u043F\u0456\u0434 \u043D\u0438\u043C\u0438. \u0410\u0431\u043E
      \u0449\u043E\u0441\u044C \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \u0446\u044C\u043E\u0433\u043E. \u0406 \u0432\u0441\u0435 \u0446\u0435 \u043B\u0435\u0436\u0438\u0442\u044C
      \u043D\u0435\u0434\u043E\u0442\u043E\u0440\u043A\u0430\u043D\u0438\u043C \u0443\u0436\u0435
      \u0434\u043E\u0441\u0438\u0442\u044C \u0434\u0430\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629967
    m_Localized: "\u041D\u0430\u0439\u0433\u043E\u043B\u043E\u0432\u043D\u0456\u0448\u0435,
      \u043A\u0440\u043E\u0432\u0456 \u043D\u0435\u043C\u0430\u0454. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440 \u0442\u0430\u0431\u043E\u0440\u0443
      \u0436\u0438\u0432\u0438\u0439... \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0449\u0435 \u044F\u043A\u0456\u0441\u044C
      \u0441\u043B\u0456\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629968
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0435\u043D\u043E \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A
      \u0412\u0435\u043B\u044C\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629969
    m_Localized: "\u041E, \u0430 \u0442\u0443\u0442 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A!
      \u041D\u0430\u043F\u0435\u0432\u043D\u043E \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0435\u0432\u0456 \u0442\u0430\u0431\u043E\u0440\u0443.
      \u0422\u0430\u043A... \u0422\u0443\u0442 \u0454 \u043F\u0456\u0434\u043F\u0438\u0441:
      \"\u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u0420\u0435\u043C\u0435\u0434\u0456\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629970
    m_Localized: "(\u0447\u0438\u0442\u0430\u0454) \u0422\u0430\u043A-\u0442\u0430\u043A-\u0442\u0430\u043A...
      \u0412\u043E\u043D\u0430 \u0442\u0443\u0442 \u0432\u0438\u0432\u0447\u0430\u043B\u0430
      \u0433\u0443\u043B\u0456\u0432, \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0430
      \u044F\u043A\u0456\u0441\u044C \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438...
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u0434\u0435 \u043D\u0430
      \u0434\u043E\u0437\u0432\u0456\u043B\u043B\u0456 \u0432\u0438\u0432\u0447\u0438\u0442\u0438
      \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629971
    m_Localized: "\u041E\u0434\u043D\u0430\u043A \u0442\u0430\u0431\u0456\u0440 \u0434\u0430\u0432\u043D\u043E
      \u043F\u0443\u0441\u0442\u0443\u0454, \u0456 \u043F\u0456\u0448\u043B\u0430
      \u0432\u043E\u043D\u0430 \u044F\u0432\u043D\u043E \u043D\u0435 \u0437 \u0432\u043B\u0430\u0441\u043D\u043E\u0457
      \u0432\u043E\u043B\u0456. \u0425\u0442\u043E \u0457\u0457 \u043C\u0456\u0433
      \u0442\u0443\u0442 \u0432\u0438\u044F\u0432\u0438\u0442\u0438, \u043A\u0440\u0456\u043C
      \u0433\u0443\u043B\u0456\u0432?... \u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456
      \u0437 \u0442\u0430\u0431\u043E\u0440\u0443 \u043D\u0430\u0433\u043E\u0440\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629972
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437 \u0431\u0440\u0430\u043D\u0446\u044F\u043C\u0438
      \u0433\u0440\u0438\u0444\u0456\u043E\u043D\u0456\u0432 \u043F\u0440\u043E \u0412\u0435\u043B\u044C\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629973
    m_Localized: "\u0422\u0438\u0445\u043E. \u041D\u0435 \u0448\u0443\u043C\u0456\u0442\u044C.
      \u0417\u0430\u0440\u0430\u0437 \u044F \u0432\u0430\u0441 \u0437\u0432\u0456\u043B\u044C\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629974
    m_Localized: "\u0414\u044F\u043A\u0443\u044E, \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629975
    m_Localized: "\u0410\u043B\u0435 \u044F\u043A\u0449\u043E \u0442\u0438 \u043F\u0440\u0438\u0439\u0448\u043B\u0430
      \u0437\u0430 \u0441\u0432\u043E\u0454\u044E \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u044E,
      \u0442\u043E \u0432\u0438\u0431\u0430\u0447, \u0457\u0457 \u0437 \u043D\u0430\u043C\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629976
    m_Localized: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439. \u0422\u0438 \u043F\u0440\u043E
      \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629977
    m_Localized: "\u0406\u043D\u0448\u0430 \u043F\u043E\u043D\u0456. \u041C\u0438
      \u0442\u0456\u043A\u0430\u043B\u0438 \u0437 \u043D\u0435\u044E \u0432\u0456\u0434
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432,
      \u0456 \u0432\u043E\u043D\u0430 \u043D\u043E\u0441\u0438\u043B\u0430 \u0442\u0430\u043A\u0443
      \u0441\u0430\u043C\u0443 \u0437\u0430\u043B\u0456\u0437\u044F\u043A\u0443 \u043D\u0430
      \u043D\u043E\u0437\u0456, \u044F\u043A \u0443 \u0442\u0435\u0431\u0435. \u0412\u0438
      \u0437 \u043E\u0434\u043D\u043E\u0433\u043E \u043A\u043B\u0430\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629978
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0440\u043E\u0437\u043A\u0430\u0436\u0438
      \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629979
    m_Localized: "\u0427\u043E\u0440\u043D\u0430 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0436\u043A\u0430
      \u0437\u0456 \u0441\u0440\u0456\u0431\u043D\u043E\u044E \u0433\u0440\u0438\u0432\u043E\u044E.
      \u0412\u043E\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0449\u043E
      \u0457\u0457 \u0437\u0432\u0443\u0442\u044C \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u0420\u0435\u043C\u0435\u0434\u0456. \u041F\u0456\u0441\u043B\u044F \u0432\u0442\u0435\u0447\u0456
      \u043C\u0438 \u043F\u043E\u043D\u0435\u0432\u0456\u0440\u044F\u043B\u0438\u0441\u044F
      \u0440\u0430\u0437\u043E\u043C \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441.
      \u0412\u043E\u043D\u0430 \u043D\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u043F\u0440\u043E \u0441\u0432\u043E\u0454
      \u043C\u0438\u043D\u0443\u043B\u0435, \u0430\u043B\u0435 \u0434\u0443\u0436\u0435
      \u0434\u043E\u0431\u0440\u0435 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u0430.
      \u041C\u0438 \u0440\u043E\u0437\u043B\u0443\u0447\u0438\u043B\u0438\u0441\u044F,
      \u043A\u043E\u043B\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0438 \u0437\u0435\u0431\u0440.
      \u0426\u0456 \u043F\u043E\u043A\u0438\u0434\u044C\u043A\u0438 \u0437\u0430\u043C\u0430\u043D\u0438\u043B\u0438
      \u0457\u0457 \u0434\u043E \u0441\u0435\u0431\u0435. \u041F\u0440\u0438\u043A\u0438\u043D\u0443\u043B\u0438\u0441\u044F,
      \u043D\u0456\u0431\u0438 \u0457\u043C \u043F\u043E\u0433\u0430\u043D\u043E,
      \u0456 \u0442\u0432\u043E\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430
      \u043A\u043B\u044E\u043D\u0443\u043B\u0430. \u041C\u0438 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0438\u0441\u044F
      \u0457\u0457 \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0442\u0438, \u0430\u043B\u0435
      \u0432\u043E\u043D\u0430 \u043D\u0435 \u0441\u043B\u0443\u0445\u0430\u043B\u0430.
      \u0417\u0430\u0440\u0430\u0437, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u0432\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u0432 \u0448\u043B\u0443\u043D\u043A\u0430\u0445
      \u0441\u043C\u0443\u0433\u0430\u0441\u0442\u0438\u0445. \u0412\u0438\u0431\u0430\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629980
    m_Localized: "\u0425\u043C... \u0441\u043F\u0430\u0441\u0438\u0431\u0456, \u0449\u043E
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629981
    m_Localized: "\u0412\u0456\u0442\u0430\u0454\u043C\u043E! \u0412\u0438 \u043F\u043E\u0434\u043E\u043B\u0430\u043B\u0438
      [\u043F\u0435\u0440\u0448\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C
      \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457]. \u0412\u0438
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438
      \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044E, \u043F\u0456\u0434\u043D\u044F\u0432\u0448\u0438\u0441\u044C
      \u0434\u0440\u0430\u0431\u0438\u043D\u043E\u044E, \u0430\u0431\u043E \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0433\u043B\u0438\u0431\u0448\u0435, \u0443\u0432\u0456\u0439\u0448\u043E\u0432\u0448\u0438
      \u0443 \u0434\u0432\u0435\u0440\u0456 [Exit]. \u041D\u0430 \u0433\u043B\u0438\u0431\u0448\u0438\u0445
      \u0440\u0456\u0432\u043D\u044F\u0445 \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u044C \u0456 \u043D\u0430\u0433\u043E\u0440\u043E\u0434,
      \u0456 \u043D\u0430\u043F\u0440\u0438\u043A\u0456\u043D\u0446\u0456 \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0442\u0430\u043A\u043E\u0436 \u0454 \u043F\u0440\u043E\u0445\u043E\u0434\u0438
      \u043D\u0430\u0433\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629982
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437 \u0431\u0440\u0430\u043D\u0446\u0435\u043C
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629983
    m_Localized: "\u0413\u0435\u0439! \u0422\u0438 \u043D\u0435 \u043E\u0434\u043D\u0430
      \u0437 \u043D\u0438\u0445? \u0422\u0438 \u043D\u0430 \u043D\u0438\u0445 \u043D\u0435
      \u0441\u0445\u043E\u0436\u0430... \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430,
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0438 \u043C\u0435\u043D\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629984
    m_Localized: "\u0429\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F? \u0425\u0442\u043E
      \u043F\u043E\u0441\u0430\u0434\u0438\u0432 \u0442\u0435\u0431\u0435 \u0432
      \u043A\u043B\u0456\u0442\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629985
    m_Localized: "\u0406 \u0445\u0442\u043E \u0442\u0430\u043A\u0456 \u0446\u0456
      \"\u0432\u043E\u043D\u0438\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629986
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456!
      \u0407\u0445 \u0442\u0443\u0442 \u0446\u0456\u043B\u0430 \u0431\u0430\u043D\u0434\u0430.
      \u0412\u043E\u043D\u0438 \u0437\u0430\u0445\u043E\u043F\u0438\u043B\u0438 \u043D\u0430\u0441
      \u0443 \u043F\u043E\u043B\u043E\u043D \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043D\u0430\u0431\u0456\u0433\u0443 - \u043C\u0435\u043D\u0435 \u0442\u0430
      \u0456\u043D\u0448\u0438\u0445 \u043F\u043E\u043D\u0456. \u0406 \u0442\u0435\u043F\u0435\u0440
      \u0442\u0440\u0438\u043C\u0430\u044E\u0442\u044C \u0443 \u043A\u043B\u0456\u0442\u043A\u0430\u0445,
      \u0434\u043E\u043A\u0438 \u043D\u0435 \u0432\u0456\u0434\u0432\u0435\u0437\u0443\u0442\u044C
      \u0443 \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629987
    m_Localized: "\u0412\u043E\u043D\u0438 \u0432\u0438\u043A\u0440\u0430\u0434\u0430\u044E\u0442\u044C
      \u0456\u043D\u0448\u0438\u0445 \u043F\u043E\u043D\u0456, \u0449\u043E\u0431...
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0457\u0445, \u043D\u0456\u0431\u0438 \u0446\u0435 \u044F\u043A\u0456\u0441\u044C
      \u0440\u0435\u0447\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629988
    m_Localized: "\u0422\u0430\u043A! \u041F\u0440\u043E\u0448\u0443, \u043D\u0435
      \u0437\u0430\u043B\u0438\u0448\u0430\u0439 \u043C\u0435\u043D\u0435 \u0442\u0443\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629989
    m_Localized: "\u041D\u0435 \u0437\u0430\u043B\u0438\u0448\u0443! \u041D\u0456
      \u0442\u0435\u0431\u0435, \u043D\u0456 \u0456\u043D\u0448\u0438\u0445 \u0431\u0440\u0430\u043D\u0446\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629990
    m_Localized: "\u0410\u043B\u0435 \u043A\u043B\u0456\u0442\u043A\u0430 \u0436
      \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0430... \u041D\u0435 \u0437\u043D\u0430\u044E,
      \u0447\u0438 \u0437\u043C\u043E\u0436\u0443 \u044F \u0432\u043F\u043E\u0440\u0430\u0442\u0438\u0441\u044F
      \u0456\u0437 \u0437\u0430\u043C\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629991
    m_Localized: "\u0423 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u043C\u0430\u044E\u0442\u044C \u0431\u0443\u0442\u0438 \u043A\u043B\u044E\u0447\u0456.
      \u041D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0443 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E \u043D\u0430\u0433\u043B\u044F\u0434\u0430\u0447\u0430
      \u0454 \u043A\u043E\u043F\u0456\u044F. \u0410\u043B\u0435 \u0432\u043A\u0440\u0430\u0441\u0442\u0438
      \u0457\u0445 \u043D\u0456\u044F\u043A \u043D\u0435 \u0432\u0438\u0439\u0434\u0435,
      \u0430 \u0437\u0430\u0431\u0440\u0430\u0442\u0438 \u0441\u0438\u043B\u043E\u044E...
      \u0407\u0445 \u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u043E\u0434\u043D\u0456\u0454\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629992
    m_Localized: "\u0426\u0435 \u043C\u0438 \u0449\u0435 \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629993
    m_Localized: "\u0414\u0435 \u0442\u0440\u0438\u043C\u0430\u044E\u0442\u044C \u0456\u043D\u0448\u0438\u0445
      \u0431\u0440\u0430\u043D\u0446\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629994
    m_Localized: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E. \u041C\u0430\u0431\u0443\u0442\u044C,
      \u0443 \u0442\u0456\u0439 \u0432\u0435\u043B\u0438\u043A\u0456\u0439 \u0431\u0443\u0434\u0456\u0432\u043B\u0456.
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0437 \u043D\u0438\u043C\u0438
      \u043D\u0435 \u0437\u0440\u043E\u0431\u0438\u043B\u0438 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043F\u043E\u0433\u0430\u043D\u043E\u0433\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629995
    m_Localized: "\u0417\u0430\u0440\u0430\u0437 \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u044E
      \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u0437\u0430\u043C\u043E\u043A \u043D\u0430
      \u0442\u0432\u043E\u0457\u0439 \u043A\u043B\u0456\u0442\u0446\u0456. \u0410
      \u044F\u043A\u0449\u043E \u043D\u0435 \u0432\u0438\u0439\u0434\u0435, \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u0456\u0442\u0438 \u0439 \u0434\u043E\u0431\u0443\u0442\u0438 \u043A\u043B\u044E\u0447\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629996
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0432\u0456\u0440\u044E,
      \u0449\u043E \u0442\u0430\u043A\u0435 \u043C\u043E\u0436\u0435 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0442\u0438\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629997
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437 \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u043C
      \u043D\u0430\u0433\u043B\u044F\u0434\u0430\u0447\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629998
    m_Localized: "\u0410\u0433\u0430, \u043E\u0441\u044C \u0442\u0438 \u0434\u0435!
      \u0422\u0430\u043A \u0446\u0435 \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0431\u0435
      \u0432 \u043D\u0430\u0441 \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629999
    m_Localized: "\u0422\u0430\u043A, \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u043D\u0435.
      \u0410 \u0442\u0438, \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C, \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u043D\u0430\u0433\u043B\u044F\u0434\u0430\u0447? \u0423 \u0442\u0435\u0431\u0435
      \u043A\u043B\u044E\u0447 \u0432\u0456\u0434 \u043A\u043B\u0456\u0442\u043E\u043A
      \u0456\u0437 \u0431\u0440\u0430\u043D\u0446\u044F\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630000
    m_Localized: "\u0410 \u044F\u043A \u0436\u0435! \u0425\u043E\u0447\u0435\u0448
      \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438 \u0432\u0441\u0435 \u0446\u0435
      \u043C'\u044F\u0441\u043E? \u041D\u0443 \u0449\u043E \u0436, \u043A\u043B\u044E\u0447
      \u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0432 \u043C\u0435\u043D\u0435.
      \u041F\u0456\u0434\u0456\u0439\u0434\u0438 \u0431\u043B\u0438\u0436\u0447\u0435...
      \u0449\u043E\u0431 \u044F \u043C\u0456\u0433 \u0442\u043E\u0431\u0456 \u0439\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0430\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630001
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u0411\u0443\u0447\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630002
    m_Localized: "\u041D\u0443 \u0442\u0440\u0435\u0431\u0430 \u0436... \u044F\u043A\u0438\u0439
      \u0437\u0434\u043E\u0440\u043E\u0432\u0435\u043D\u043D\u0438\u0439! \u0425\u0456\u0431\u0430
      \u043F\u043E\u043D\u0456 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u0442\u0430\u043A\u043E\u0433\u043E \u0440\u043E\u0437\u043C\u0456\u0440\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630003
    m_Localized: "\u0422\u0430\u043A, \u044F, \u0431\u043B\u044F\u0445\u0430, \u043D\u0435
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432! \u0429\u043E \u0437\u0430
      \u0445\u0443\u0454\u0442\u0430 \u0442\u0443\u0442 \u043A\u043E\u0457\u0442\u044C\u0441\u044F???
      \u0429\u043E \u0437\u0430 \u0441\u0442\u0440\u0456\u043B\u044F\u043D\u0438\u043D\u0430,
      \u0449\u043E \u0437\u0430 \u0445\u0435\u0440\u043D\u044F? \u0412\u0438 \u0432\u0436\u0435
      \u0437\u043E\u0432\u0441\u0456\u043C \u043C\u0456\u0437\u043A\u0430\u043C\u0438
      \u0457\u0431\u0430\u043D\u0443\u043B\u0438\u0441\u044F?|\u0422\u0430\u043A,
      \u044F \u043D\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432! \u0429\u043E
      \u0437\u0430 \u0444\u0456\u0433\u043D\u044F \u0442\u0443\u0442 \u043A\u043E\u0457\u0442\u044C\u0441\u044F???
      \u0429\u043E \u0437\u0430 \u0441\u0442\u0440\u0456\u043B\u044F\u043D\u0438\u043D\u0430,
      \u0432\u0438 \u0432\u0436\u0435 \u0437\u043E\u0432\u0441\u0456\u043C \u043C\u0456\u0437\u043A\u0438
      \u043F\u0440\u043E\u043F\u0438\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630004
    m_Localized: "\u0413\u0415\u0419 \u0422\u0410\u041C, \u041E\u0413\u041B\u0423\u0425\u041B\u0418!!??
      \u041F\u0418\u0417\u0414\u0423\u0419\u0422\u0415 \u0412\u0421\u0406 \u0421\u042E\u0414\u0418,
      \u0422\u0423\u041F\u0406 \u0413\u0406\u0412\u041D\u042E\u041A\u0418, \u0428\u0412\u0418\u0414\u041A\u041E
      \u041D\u0410\u0425!!!|\u0413\u0415\u0419 \u0422\u0410\u041C, \u041E\u0413\u041B\u0423\u0425\u041B\u0418!!??
      \u0410 \u041D\u0423 \u0412\u0421\u0406 \u0421\u042E\u0414\u0418, \u0422\u0423\u041F\u0406
      \u0412\u0410\u041B\u042F\u041D\u041A\u0418, \u0428\u0412\u0418\u0414\u041A\u041E!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630005
    m_Localized: "\u041D\u0435 \u043E\u0440\u0438, \u0431\u0438\u0447\u0430\u0440\u0430,
      \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0439\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630006
    m_Localized: "\u0425\u0442\u043E \u0449\u0435, \u0431\u043B\u044F\u0445\u0430,
      \u043F\u0438\u0449\u0438\u0442\u044C \u0442\u0430\u043C, \u0443\u043D\u0438\u0437\u0443?
      \u0422\u0438 \u0449\u043E \u0437\u0430 \u0431\u043B\u043E\u0445\u0430?| \u0425\u0442\u043E
      \u0449\u0435 \u043F\u0438\u0449\u0438\u0442\u044C \u0442\u0430\u043C, \u0432\u043D\u0438\u0437\u0443?
      \u0422\u0438 \u0449\u043E \u0437\u0430 \u0431\u043B\u043E\u0445\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630007
    m_Localized: "\u0422\u0432\u043E\u044E \u0431\u0430\u043D\u0434\u0443 \u0437\u043D\u0438\u0449\u0435\u043D\u043E,
      \u0430 \u0431\u0440\u0430\u043D\u0446\u0456 \u043D\u0430 \u0432\u043E\u043B\u0456.
      \u041C\u043E\u0436\u0435, \u0445\u043E\u0447\u0435\u0448 \u0449\u043E\u0441\u044C
      \u0456\u0437 \u0446\u044C\u043E\u0433\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u0443
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630008
    m_Localized: "\u042F \u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u0430\u0437
      \u043D\u0430 \u0442\u0435\u0431\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u044E,
      \u0434\u0440\u0456\u0431\u043D\u0430 \u0441\u0443\u0447\u043A\u0430. \u0414\u0440\u0443\u0433\u043E\u0433\u043E
      \u0440\u0430\u0437\u0443 \u043D\u0435 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F.|\u042F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u0430\u0437 \u043D\u0430 \u0442\u0435\u0431\u0435
      \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u044E, \u043C\u0456\u043B\u043A\u043E\u0442\u0430.
      \u0414\u0440\u0443\u0433\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043D\u0435
      \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630009
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u0432\u0456\u0434 \u0428\u0430\u0440\u043F
      \u0428\u0443\u0442\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630010
    m_Localized: "\u0411\u0443\u0447! \u0422\u0440\u044F\u0441\u0446\u044F \u0442\u0432\u043E\u0457\u0439
      \u043C\u0430\u0442\u0435\u0440\u0456! \u041C\u0430\u043B\u043E \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0442\u0438 \u043D\u0435 \u0432\u0438\u043A\u043E\u043D\u0443\u0454\u0448
      \u043C\u043E\u0457 \u043D\u0430\u043A\u0430\u0437\u0438, \u0442\u0430\u043A
      \u0442\u0438 \u0449\u0435 \u0439 \u0437\u0432\u0430\u043B\u044E\u0454\u0448,
      \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u044F\u044E\u0447\u0438 \u043C\u0435\u043D\u0435
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456 \u043D\u0430\u0434\u0435\u0440\u0442\u0438
      \u0442\u043E\u0431\u0456 \u0434\u0443\u043F\u0443 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E?\n\t\u0417\u0430\u043F\u0430\u043C'\u044F\u0442\u0430\u0439,
      \u044F\u043A\u0449\u043E \u044F \u0449\u0435 \u0440\u0430\u0437 \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F,
      \u0449\u043E \u0442\u0438 \u043A\u043B\u0430\u0434\u0435\u0448 \u0445\u0443\u0439
      \u043D\u0430 \u0441\u0432\u043E\u0457 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0438,
      \u0446\u044F \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u044F \u0431\u0443\u0434\u0435
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u044E
      \u0432 \u043C\u043E\u0454\u043C\u0443 \u0437\u0430\u0433\u043E\u043D\u0456!
      \u042F \u043D\u0430\u043A\u0430\u0437\u0443\u0432\u0430\u0432 \u0442\u043E\u0431\u0456
      \u043F\u043E\u0447\u0430\u0442\u0438 \u043F\u043E\u0448\u0443\u043A\u0438?
      \u041D\u0430\u043A\u0430\u0437\u0443\u0432\u0430\u0432, \u0441\u0443\u043A\u0430,
      \u043C\u043E\u0436\u0435\u0448 \u043D\u0435 \u0437\u0430\u043F\u0435\u0440\u0435\u0447\u0443\u0432\u0430\u0442\u0438.
      \u0422\u043E\u0431\u0456 \u0431\u0443\u043B\u043E \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043E
      \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0445\u043B\u043E\u043F\u0446\u0456\u0432
      \u0456 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0440\u043E\u0437\u0432\u0456\u0434\u043A\u0443 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430
      15:28 \u043D\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432\u0445\u043E\u0434\u0443
      \u0432 \u0421\u0442\u0456\u0439\u043B\u043E. \u0414\u043E\u0440\u0443\u0447\u0435\u043D\u043E
      \u0449\u0435 \u0432\u0447\u043E\u0440\u0430! \u0406 \u044F\u043A\u043E\u0433\u043E
      \u0445\u0443\u044F \u0442\u0438 \u0434\u043E\u0441\u0456 \u0446\u044C\u043E\u0433\u043E
      \u043D\u0435 \u0437\u0440\u043E\u0431\u0438\u0432! \u0417\u043D\u043E\u0432\u0443
      \u0441\u0438\u0434\u0438\u0448, \u0431\u0443\u0445\u0430\u0454\u0448 \u0456
      \u0445\u0435\u0440\u043E\u043C \u0433\u0440\u0443\u0448\u0456 \u0437\u0430\u0431\u0438\u0432\u0430\u0454\u0448?
      \u0422\u0432\u0456\u0439 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0448\u0430\u043D\u0441:
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0432\u0435\u0447\u0435\u0440\u0456
      \u0442\u0438 \u043C\u0430\u0454\u0448 \u0443\u0437\u044F\u0442\u0438 \u0434\u0435\u0441\u044F\u0442\u043E\u043A
      \u0437\u0456 \u0441\u0432\u043E\u0454\u0457 \u043F\u0438\u0437\u0434\u043E\u0431\u0440\u0430\u0442\u0456\u0457
      \u0442\u0430 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u043C\u0456\u0439
      \u043D\u0430\u043A\u0430\u0437 \u0456\u0437 \u043F\u043E\u0448\u0443\u043A\u0443
      \u0434\u043E\u043C\u0443 \u0446\u0456\u0454\u0457 \u0441\u043E\u043B\u043E\u0434\u043A\u0443\u0432\u0430\u0442\u043E\u0457
      \u0441\u0443\u0447\u043A\u0438 \u0437 \u041F\u0456\u043F\u0411\u0430\u043A\u043E\u043C,
      \u044F\u043A\u0443 \u0442\u0432\u043E\u0457 \u0445\u043B\u043E\u043F\u0446\u0456
      \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u0442\u0438\u0436\u0434\u0435\u043D\u044C
      \u0442\u043E\u043C\u0443. \u0423 \u043D\u0430\u0441 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u043A\u0456\u043B\u043E\u043C\u0435\u0442\u0440\u0456\u0432
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0439
      \u0431\u0443\u043D\u043A\u0435\u0440, \u0432\u0449\u0435\u0440\u0442\u044C
      \u043D\u0430\u0431\u0438\u0442\u0438\u0439 \u0434\u043E\u0431\u0456\u0440\u043D\u0438\u043C
      \u043C'\u044F\u0441\u043E\u043C, \u0456 \u043C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0439\u043E\u0433\u043E \u043F\u0440\u043E\u0491\u0430\u0432\u0438\u0442\u0438.
      \u0420\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0411\u0443\u0447? \u041D\u0435
      \u043C\u043E\u0436\u0435\u043C\u043E! \u042F\u043A\u0449\u043E \u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0441\u044F
      \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430 88, \u0430 \u0442\u0438 \u0431\u0443\u0434\u0435\u0448
      \u0456\u0449\u0435 \u0442\u0443\u0442 - \u041E\u041A\u041E \u041D\u0410 \u0421\u0420\u0410\u041A\u0423
      \u041D\u0410\u0422\u042F\u0413\u041D\u0423!\n\t\u0406 \u0449\u0435, \u044F\u043A\u0449\u043E
      \u044F \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F, \u0449\u043E \u0442\u0438
      \u0440\u043E\u0437\u0431\u043E\u0432\u043A\u0430\u0432 \u0445\u043B\u043E\u043F\u0446\u044F\u043C
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044E \u043C\u0435\u0442\u0443 \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u043D\u043A\u0438
      - \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u044F\u0437\u0438\u043A
      \u0432\u0456\u0434\u0440\u0456\u0436\u0443.\n\t\u0428\u0430\u0440\u043F \u0428\u0443\u0442\u0435\u0440.|\u0411\u0443\u0447!
      \u041C\u0430\u043B\u043E \u0442\u043E\u0433\u043E, \u0449\u043E \u0442\u0438
      \u043D\u0435 \u0432\u0438\u043A\u043E\u043D\u0443\u0454\u0448 \u043C\u043E\u0457
      \u043D\u0430\u043A\u0430\u0437\u0438, \u0442\u0430\u043A \u0442\u0438 \u0449\u0435
      \u0439 \u0437\u0432\u0430\u043B\u044E\u0454\u0448, \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u044F\u044E\u0447\u0438
      \u043C\u0435\u043D\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u043D\u0430\u0434\u0435\u0440\u0442\u0438 \u0442\u043E\u0431\u0456 \u0434\u0443\u043F\u0443
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E?\n\t\u0417\u0430\u043F\u0430\u043C'\u044F\u0442\u0430\u0439,
      \u044F\u043A\u0449\u043E \u044F \u0449\u0435 \u0440\u0430\u0437 \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F,
      \u0449\u043E \u0442\u0438 \u043D\u0435\u0445\u0442\u0443\u0454\u0448 \u0441\u0432\u043E\u0457\u043C\u0438
      \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0430\u043C\u0438, \u0446\u044F
      \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u044F \u0431\u0443\u0434\u0435 \u0434\u043B\u044F
      \u0442\u0435\u0431\u0435 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u044E
      \u0432 \u043C\u043E\u0454\u043C\u0443 \u0437\u0430\u0433\u043E\u043D\u0456!
      \u042F \u043D\u0430\u043A\u0430\u0437\u0443\u0432\u0430\u0432 \u0442\u043E\u0431\u0456
      \u043F\u043E\u0447\u0430\u0442\u0438 \u043F\u043E\u0448\u0443\u043A\u0438?
      \u041D\u0430\u043A\u0430\u0437\u0443\u0432\u0430\u0432, \u043C\u043E\u0436\u0435\u0448
      \u043D\u0435 \u0437\u0430\u043F\u0435\u0440\u0435\u0447\u0443\u0432\u0430\u0442\u0438.
      \u0422\u043E\u0431\u0456 \u0431\u0443\u043B\u043E \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043E
      \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0445\u043B\u043E\u043F\u0446\u0456\u0432
      \u0456 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0440\u043E\u0437\u0432\u0456\u0434\u043A\u0443 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430
      15:28 \u043D\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432\u0445\u043E\u0434\u0443
      \u0432 \u0421\u0442\u0456\u0439\u043B\u043E. \u0414\u043E\u0440\u0443\u0447\u0435\u043D\u043E
      \u0449\u0435 \u0432\u0447\u043E\u0440\u0430! \u0406 \u0442\u0438 \u0434\u043E\u0441\u0456
      \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u0437\u0440\u043E\u0431\u0438\u0432!
      \u0422\u0432\u0456\u0439 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0448\u0430\u043D\u0441:
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0432\u0435\u0447\u0435\u0440\u0456
      \u0442\u0438 \u043C\u0430\u0454\u0448 \u0443\u0437\u044F\u0442\u0438 \u0434\u0435\u0441\u044F\u0442\u043E\u043A
      \u0437\u0456 \u0441\u0432\u043E\u0454\u0457 \u0433\u0440\u0443\u043F\u0438
      \u0442\u0430 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u043C\u0456\u0439
      \u043D\u0430\u043A\u0430\u0437 \u0456\u0437 \u043F\u043E\u0448\u0443\u043A\u0443
      \u0434\u043E\u043C\u0443 \u0446\u0456\u0454\u0457 \u0441\u043E\u043B\u043E\u0434\u043A\u0443\u0432\u0430\u0442\u043E\u0457
      \u043F\u043E\u043D\u0456 \u0437 \u041F\u0456\u043F\u0411\u0430\u043A\u043E\u043C,
      \u044F\u043A\u0443 \u0442\u0432\u043E\u0457 \u0445\u043B\u043E\u043F\u0446\u0456
      \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u0442\u0438\u0436\u0434\u0435\u043D\u044C
      \u0442\u043E\u043C\u0443. \u0423 \u043D\u0430\u0441 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u043A\u0456\u043B\u043E\u043C\u0435\u0442\u0440\u0456\u0432
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0439
      \u0431\u0443\u043D\u043A\u0435\u0440, \u0432\u0449\u0435\u0440\u0442\u044C
      \u043D\u0430\u0431\u0438\u0442\u0438\u0439 \u0434\u043E\u0431\u0456\u0440\u043D\u0438\u043C
      \u043C'\u044F\u0441\u043E\u043C, \u0456 \u043C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0439\u043E\u0433\u043E \u043F\u0440\u043E\u0491\u0430\u0432\u0438\u0442\u0438.
      \u0420\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0411\u0443\u0447? \u041D\u0435
      \u043C\u043E\u0436\u0435\u043C\u043E! \u0414\u0443\u0436\u0435 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0449\u043E \u043A\u043E\u043B\u0438 \u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0441\u044F
      \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430 88, \u0442\u0438 \u0432\u0436\u0435
      \u0431\u0443\u0434\u0435\u0448 \u0434\u0430\u043B\u0435\u043A\u043E, \u043F\u0430\u0445\u0430\u0442\u0438
      \u0432\u0435\u0441\u044C \u0443 \u043C\u0438\u043B\u0456.\n\t\u0406 \u0449\u0435:
      \u044F\u043A\u0449\u043E \u044F \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F,
      \u0449\u043E \u0442\u0438 \u0440\u043E\u0437\u0431\u043E\u0432\u043A\u0430\u0432
      \u0445\u043B\u043E\u043F\u0446\u044F\u043C \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044E
      \u043C\u0435\u0442\u0443 \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u043D\u043A\u0438
      - \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u044F\u0437\u0438\u043A
      \u0432\u0456\u0434\u0440\u0456\u0436\u0443.\n\t\u0428\u0430\u0440\u043F \u0428\u0443\u0442\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630011
    m_Localized: "\u0421\u0432\u0456\u0442\u043B\u043E, \u0432\u043E\u0434\u0430
      \u0456 \u0441\u0432\u0456\u0436\u0435 \u043F\u043E\u0432\u0456\u0442\u0440\u044F!"
