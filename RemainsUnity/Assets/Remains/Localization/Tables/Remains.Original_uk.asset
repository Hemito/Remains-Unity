  - m_Id: 2725242165
    m_Localized: "\u0406\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
      \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u043C\u0430\u0433\u0456\u0432.
      \u0417\u0430 \u0436\u043E\u0434\u043D\u0438\u0445 \u043E\u0431\u0441\u0442\u0430\u0432\u0438\u043D
      \u043D\u0435 \u0434\u0430\u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0456\u0439
      \u0441\u0438\u043B\u0456 \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u0443\u043B\u044F, \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0454
      \u0432\u0438\u0433\u043E\u0440\u044F\u043D\u043D\u044F."
