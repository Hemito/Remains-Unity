      m_Items: []
  - m_Id: 2725241112
    m_Localized: "\u0420\u043E\u0431\u043E\u0442-\u0431\u043E\u043C\u0431\u0430,
      \u0432\u043E\u0447\u0435\u0432\u0438\u0434\u044C, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439
      \u0437\u0435\u0431\u0440\u0430\u043C\u0438. \u041D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u043C\u0456\u043D,
      \u0446\u0456 \u043D\u0435 \u0447\u0435\u043A\u0430\u044E\u0442\u044C, \u043A\u043E\u043B\u0438
      \u0432\u043E\u0440\u043E\u0433 \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C,
      \u0430 \u0441\u0430\u043C\u0456 \u043F\u0440\u0430\u0433\u043D\u0443\u0442\u044C
      \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F \u0431\u043B\u0438\u0436\u0447\u0435.
      \u0407\u0445 \u0443 \u0436\u043E\u0434\u043D\u043E\u043C\u0443 \u0440\u0430\u0437\u0456
      \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043F\u0456\u0434\u043F\u0443\u0441\u043A\u0430\u0442\u0438
      \u0434\u043E \u0441\u0435\u0431\u0435 - \u043E\u043F\u0438\u043D\u0438\u0432\u0448\u0438\u0441\u044C
      \u0431\u043B\u0438\u0437\u044C\u043A\u043E \u0434\u043E \u0446\u0456\u043B\u0456,
      \u0432\u043E\u043D\u0438 \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u0432\u0438\u0431\u0443\u0445\u0430\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241113
    m_Localized: "\u041E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u0434\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241114
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0439, \u0430\u043B\u0435
      \u0434\u043E\u0441\u0438\u0442\u044C \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u043B\u0456\u0442\u0430\u044E\u0447\u0438\u0439 \u0440\u043E\u0431\u043E\u0442.
      \u041C\u0430\u0454 \u043C\u0456\u0446\u043D\u0438\u0439 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043D\u0438\u0439
      \u043A\u043E\u0440\u043F\u0443\u0441, \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0439
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0456 \u0434\u043E\u0432\u043E\u043B\u0456 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u043B\u0430\u0437\u0435\u0440 \u0432 \u044F\u043A\u043E\u0441\u0442\u0456
      \u0437\u0431\u0440\u043E\u0457. \u0417\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445
      \u0456 \u0446\u0438\u0432\u0456\u043B\u044C\u043D\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432,
      \u0449\u043E \u043C\u0430\u044E\u0442\u044C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0432\u0430\u0436\u043B\u0438\u0432\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241115
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0438\u0439 \u0434\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241116
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u0434\u0440\u043E\u043D,
      \u043D\u0435 \u0442\u0430\u043A\u0438\u0439 \u0436\u0438\u0432\u0443\u0447\u0438\u0439,
      \u0430\u043B\u0435 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0448\u0432\u0438\u0434\u0448\u0438\u0439
      \u0456 \u0440\u0443\u0445\u043B\u0438\u0432\u0456\u0448\u0438\u0439. \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0438\u0439
      \u0432\u0438\u0441\u043E\u043A\u043E\u0432\u043E\u043B\u044C\u0442\u043D\u0438\u043C
      \u0440\u043E\u0437\u0440\u044F\u0434\u043D\u0438\u043A\u043E\u043C \u0456 \u043F\u043B\u0430\u0437\u043C\u043E\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u043C.
      \u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0434\u043B\u044F
      \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0443 \u0456 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438
      \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u043F\u0456\u0434\u0440\u043E\u0437\u0434\u0456\u043B\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241117
    m_Localized: "\u0414\u0440\u043E\u043D \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241118
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u043D\u0438\u0439 \u0434\u0440\u043E\u043D
      \u043F\u043E\u043B\u0435\u0433\u0448\u0435\u043D\u043E\u0457 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457.
      \u0427\u0430\u0441\u0442\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A\u0430\u043C\u0438 \u0410\u043D\u043A\u043B\u0430\u0432\u0443
      \u0432 \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445.
      \u0417\u0430\u0432\u0434\u044F\u043A\u0438 \u0432\u0438\u0441\u043E\u043A\u0456\u0439
      \u043C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u043E\u0441\u0442\u0456 \u0442\u0430
      \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0438\u043C \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u043E\u0432\u0438\u043C
      \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0430\u043C, \u0432\u043C\u0456\u0454
      \u0443\u0445\u0438\u043B\u044F\u0442\u0438\u0441\u044F \u0432\u0456\u0434 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432,
      \u0449\u043E \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u043B\u0435\u0442\u044F\u0442\u044C,
      \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u043A\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241119
    m_Localized: "\u041A\u0430\u043F\u043A\u0430\u043D"
    m_Metadata:
