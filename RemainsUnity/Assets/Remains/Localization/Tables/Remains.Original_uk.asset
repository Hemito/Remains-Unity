    m_Localized: "\u0417\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435979
    m_Localized: "\u0415\u0444\u0435\u043A\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435980
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432'\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435981
    m_Localized: "\u0427\u0430\u0441 \u0433\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435982
    m_Localized: "\u0406\u043C'\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435983
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435984
    m_Localized: "\u0414\u043E\u0441\u0432\u0456\u0434 (\u0434\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435985
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C \u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435986
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432'\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435987
    m_Localized: "\u0412\u0430\u0448\u0435 \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0435
      \u0441\u0430\u043C\u043E\u043F\u043E\u0447\u0443\u0442\u0442\u044F. \u041F\u043E\u043A\u0430\u0437\u0443\u0454,
      \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C
      \u0432\u0438 \u0437\u0434\u0430\u0442\u043D\u0456 \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u0442\u0438,
      \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0435
      \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C \u0456 \u0431\u0443\u0434\u0435\u0442\u0435
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0456 \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443
      \u0442\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435988
    m_Localized: "\u0420\u0430\u0434\u0456\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435989
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u043D\u0435 \u0432\u0430\u043C\u0438
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0439\u043D\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0437\u043C\u0435\u043D\u0448\u0443\u0454 \u0432\u0430\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F.
      \u0412\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438 \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \"\u0410\u043D\u0442\u0438\u0440\u0430\u0434\u0438\u043D\u0443\", \u0449\u043E\u0431
      \u0432\u0438\u0432\u0435\u0441\u0442\u0438 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u044E
      \u0437 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435990
    m_Localized: "\u041E\u0442\u0440\u0443\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435991
    m_Localized: "\u041A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043E\u0442\u0440\u0443\u0442\u0438
      \u0443 \u0432\u0430\u0448\u043E\u043C\u0443 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0456.
      \u0412\u0438 \u0432\u0442\u0440\u0430\u0447\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F, \u0434\u043E\u043A\u0438 \u043D\u0435
      \u043F\u0440\u0438\u0439\u043C\u0435\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u043E\u0442\u0440\u0443\u0442\u0443
      \u0430\u0431\u043E \u0434\u043E\u043A\u0438 \u0434\u0456\u044F \u043E\u0442\u0440\u0443\u0442\u0438
      \u043D\u0435 \u043C\u0438\u043D\u0435 \u0441\u0430\u043C\u0430 \u0441\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435992
    m_Localized: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0456 \u0440\u0430\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435993
    m_Localized: "\u0417 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u043C\u0438
      \u0440\u0430\u043D\u0430\u043C\u0438 \u0432\u0438 \u0431\u0443\u0434\u0435\u0442\u0435
      \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E \u0441\u0442\u0456\u043A\u0430\u0442\u0438
      \u043A\u0440\u043E\u0432'\u044E. \u0425\u043E\u0447\u0430 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0430
      \u0437 \u0447\u0430\u0441\u043E\u043C \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0430, \u043A\u0440\u0430\u0449\u0435 \u0432\u0447\u0430\u0441\u043D\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0456
      \u0431\u0438\u043D\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435994
    m_Localized: "\u0421\u0442\u0430\u043D \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435995
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0443\u0454 \u0432\u0430\u0448\u0456
      \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456 \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F,
      \u043E\u043A\u0440\u0435\u043C\u043E \u0434\u043B\u044F \u0433\u043E\u043B\u043E\u0432\u0438,
      \u043A\u043E\u0440\u043F\u0443\u0441\u0443 \u0456 \u043A\u0456\u043D\u0446\u0456\u0432\u043E\u043A.
      \u0407\u0445 \u0441\u043A\u043B\u0430\u0434\u043D\u043E \u0437\u0446\u0456\u043B\u0438\u0442\u0438
      \u0432 \u043F\u043E\u043B\u044C\u043E\u0432\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445,
      \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0445
      \u0437\u0456\u043B\u044C. \u0412\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430 \u043A\u0432\u0430\u043B\u0456\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u043C\u0435\u0434\u0438\u043A\u0430 \u0430\u0431\u043E \u0437\u043D\u0430\u043D\u043D\u044F
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0438 \u0442\u0430 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0435
      \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F. \u0417\u0430
      \u043D\u0430\u044F\u0432\u043D\u0438\u0445 \u0442\u0440\u0430\u0432\u043C \u0433\u043E\u043B\u043E\u0432\u0438
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435 \u0448\u0442\u0440\u0430\u0444\u0438
      \u043D\u0430 \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C, \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0430\u0442\u0430\u043A\u0438 \u0456 \u043C\u0430\u0433\u0456\u044E, \u0437\u0430
      \u0442\u0440\u0430\u0432\u043C \u043A\u043E\u0440\u043F\u0443\u0441\u0443 \u043F\u043E\u0441\u0442\u0440\u0430\u0436\u0434\u0430\u0454
      \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C, \u0430
      \u0437\u0430 \u0442\u0440\u0430\u0432\u043C \u043D\u0456\u0433 - \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0440\u0443\u0445\u0443. \u0421\u0435\u0440\u0439\u043E\u0437\u043D\u0430
      \u043A\u0440\u043E\u0432\u043E\u0432\u0442\u0440\u0430\u0442\u0430 \u0442\u0430\u043A\u043E\u0436
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u0432\u043F\u043B\u0438\u043D\u0435
      \u043D\u0430 \u0432\u0430\u0448\u0443 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438 \u0448\u043A\u043E\u0434\u0438
      \u0456 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0438 \u0431\u0456\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435996
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435997
    m_Localized: "\u0421\u0442\u0430\u043D: \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435998
    m_Localized: "\u0423\u0441\u0435 \u0432 \u043F\u043E\u0432\u043D\u043E\u043C\u0443
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435999
    m_Localized: "\u0421\u0442\u0430\u043D: \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436000
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0448\u0438\u0448\u043A\u0430
      \u043D\u0430 \u043B\u043E\u0431\u0456, \u043F\u043E\u0434\u0440\u044F\u043F\u0430\u043D\u0435
      \u0432\u0443\u0445\u043E \u0456 \u0444\u043E\u043D\u0430\u0440 \u043F\u0456\u0434
      \u043E\u043A\u043E\u043C, \u0437\u0430\u0433\u0440\u043E\u0437\u0438 \u0434\u043B\u044F
      \u0436\u0438\u0442\u0442\u044F \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436001
    m_Localized: "\u0421\u0442\u0430\u043D: \u043F\u043E\u0433\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436002
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0447\u0435\u0440\u0435\u043F\u043D\u043E-\u043C\u043E\u0437\u043A\u043E\u0432\u0430
      \u0442\u0440\u0430\u0432\u043C\u0430, \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u0442\u0430\u043A\u043E\u0436 \u0441\u0442\u0440\u0443\u0441 \u043C\u043E\u0437\u043A\u0443.
      \u041C\u043E\u0436\u043B\u0438\u0432\u0456 \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u0431\u0456\u043B\u044C, \u043D\u0443\u0434\u043E\u0442\u0430, \u0437\u0430\u043F\u0430\u043C\u043E\u0440\u043E\u0447\u0435\u043D\u043D\u044F.
      \u0417 \u0442\u0430\u043A\u0438\u043C\u0438 \u0442\u0440\u0430\u0432\u043C\u0430\u043C\u0438
      \u0432\u0430\u043C \u0431\u0443\u0434\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043C\u0430\u0433\u0456\u044E, \u043F\u0440\u0438\u0446\u0456\u043B\u044C\u043D\u043E
      \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438 \u0456 \u0434\u0443\u043C\u0430\u0442\u0438.
      \u0417\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456 \u0437\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F
      \u0434\u043E \u043B\u0456\u043A\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436003
    m_Localized: "\u0421\u0442\u0430\u043D: \u0436\u0430\u0445\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436004
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0432\u0430\u0436\u043A\u0456
      \u0442\u0440\u0430\u0432\u043C\u0438 \u0433\u043E\u043B\u043E\u0432\u0438,
      \u0442\u0440\u0456\u0449\u0438\u043D\u0438 \u0432 \u0447\u0435\u0440\u0435\u043F\u0456,
      \u0442\u0440\u0430\u0432\u043C\u0430 \u043E\u043A\u0430, \u043A\u043E\u043D\u0442\u0443\u0437\u0456\u044F.
      \u041F\u043E\u0433\u0456\u0440\u0448\u0435\u043D\u043D\u044F \u0437\u043E\u0440\u0443
      \u0456 \u0441\u043B\u0443\u0445\u0443. \u041C\u043E\u0436\u043B\u0438\u0432\u0456
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438 \u0432 \u043F\u0430\u043C'\u044F\u0442\u0456,
      \u0433\u0430\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0456\u0457 \u0442\u0430
      \u043D\u0435\u0430\u0434\u0435\u043A\u0432\u0430\u0442\u043D\u0456 \u0440\u0435\u0430\u043A\u0446\u0456\u0457
      \u043D\u0430 \u043F\u043E\u0434\u0440\u0430\u0437\u043D\u0438\u043A\u0438.
      \u041C\u0430\u0433\u0456\u044F \u043D\u0430 \u043C\u0435\u0436\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0435\u0439.
      \u041F\u0440\u044F\u043C\u0430 \u0437\u0430\u0433\u0440\u043E\u0437\u0430 \u0434\u043B\u044F
      \u0436\u0438\u0442\u0442\u044F. \u0422\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u043C\u0435\u0434\u0438\u0447\u043D\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436005
    m_Localized: "\u041A\u043E\u0440\u043F\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436006
    m_Localized: "\u0421\u0442\u0430\u043D: \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436007
    m_Localized: "\u0423\u0441\u0435 \u0433\u0430\u0440\u0430\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436008
    m_Localized: "\u0421\u0442\u0430\u043D: \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436009
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0456
      \u0437\u0430\u0431\u043E\u0457, \u0441\u0438\u043D\u0446\u0456, \u043F\u043E\u0440\u0456\u0437\u0438
      \u0442\u0430 \u043E\u043F\u0456\u043A\u0438. \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430,
      \u0431\u0443\u0434\u044C\u0442\u0435 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436010
    m_Localized: "\u0421\u0442\u0430\u043D: \u043F\u043E\u0433\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436011
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0437\u043B\u0430\u043C\u0430\u043D\u043E
      \u043E\u0434\u043D\u0435 \u0430\u0431\u043E \u043A\u0456\u043B\u044C\u043A\u0430
      \u0440\u0435\u0431\u0435\u0440, \u043D\u0435\u0437\u043D\u0430\u0447\u043D\u0456
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0445
      \u043E\u0440\u0433\u0430\u043D\u0456\u0432. \u041C\u043E\u0436\u043B\u0438\u0432\u0456
      \u043F\u043E\u0433\u0456\u0440\u0448\u0435\u043D\u043D\u044F \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456,
      \u0437\u0430\u0434\u0438\u0448\u043A\u0430, \u0443\u0442\u0440\u0443\u0434\u043D\u0435\u043D\u0435
      \u0434\u0438\u0445\u0430\u043D\u043D\u044F. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u043E\u0441\u0442\u0456\u043B\u044C\u043D\u0438\u0439 \u0440\u0435\u0436\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436012
    m_Localized: "\u0421\u0442\u0430\u043D: \u0436\u0430\u0445\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436013
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u043C\u043D\u043E\u0436\u0438\u043D\u043D\u0456
      \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0438 \u0440\u0435\u0431\u0435\u0440,
      \u0432\u0435\u043B\u0438\u043A\u0456 \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F, \u043F\u0456\u0434\u043E\u0437\u0440\u0430
      \u043D\u0430 \u0442\u0440\u0430\u0432\u043C\u0443 \u0445\u0440\u0435\u0431\u0442\u0430.
      \u041C\u043E\u0436\u043B\u0438\u0432\u0456 \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0441\u0435\u0440\u0446\u044F \u0442\u0430
      \u0456\u043D\u0448\u0438\u0445 \u043E\u0440\u0433\u0430\u043D\u0456\u0432.
      \u041F\u0440\u044F\u043C\u0430 \u0437\u0430\u0433\u0440\u043E\u0437\u0430 \u0434\u043B\u044F
      \u0436\u0438\u0442\u0442\u044F. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
      \u043D\u0435\u0433\u0430\u0439\u043D\u0430 \u0433\u043E\u0441\u043F\u0456\u0442\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436014
    m_Localized: "\u041D\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436015
    m_Localized: "\u0421\u0442\u0430\u043D: \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436016
    m_Localized: "\u041D\u0456\u0434\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
      \u0431\u043E\u043B\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436017
    m_Localized: "\u0421\u0442\u0430\u043D: \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436018
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0432\u0438\u0432\u0438\u0445
      \u0430\u0431\u043E \u0440\u043E\u0437\u0442\u044F\u0433\u043D\u0435\u043D\u043D\u044F
      \u0437\u0432'\u044F\u0437\u043E\u043A. \u041D\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0439\u0442\u0435
      \u043D\u0430 \u0445\u0432\u043E\u0440\u0443 \u043D\u043E\u0433\u0443 \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u0442\u0438\u0436\u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436019
    m_Localized: "\u0421\u0442\u0430\u043D: \u043F\u043E\u0433\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436020
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u043F\u0435\u0440\u0435\u043B\u043E\u043C
      \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u043E\u0434\u043D\u0456\u0454\u0457
      \u043D\u043E\u0433\u0438, \u043C\u043D\u043E\u0436\u0438\u043D\u043D\u0456
      \u0442\u0440\u0430\u0432\u043C\u0438 \u0440\u0435\u0448\u0442\u0438. \u0423
      \u0442\u0430\u043A\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456 \u0432\u0438
      \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0431\u0456\u0433\u0430\u0442\u0438
      \u0456 \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438 \u044F\u043A \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439.
      \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u043F\u0435\u0440\u0435\u043B\u043E\u043C,
      \u043D\u0430\u043A\u043B\u0430\u0441\u0442\u0438 \u0448\u0438\u043D\u0443 \u0456
      \u043D\u0430\u0434\u0430\u043B\u0456 \u0443\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u043D\u0430\u0434\u043C\u0456\u0440\u043D\u0438\u0445 \u043D\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436021
    m_Localized: "\u0421\u0442\u0430\u043D: \u0436\u0430\u0445\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436022
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u043C\u043D\u043E\u0436\u0438\u043D\u043D\u0456
      \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0438, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0456, \u0440\u043E\u0437\u0440\u0438\u0432
      \u0437\u0432'\u044F\u0437\u043E\u043A, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u043F\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u0435\u043D\u0435 \u043A\u043E\u043B\u0456\u043D\u043E.
      \u041D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E, \u044F\u043A
      \u0432\u0438 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0432
      \u0442\u0430\u043A\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456. \u0422\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u043E
      \u0437\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F \u0434\u043E \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0457
      \u0444\u0456\u043B\u0456\u0457 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u041C\u0438\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436023
    m_Localized: "\u041A\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436024
    m_Localized: "\u0421\u0442\u0430\u043D: \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436025
    m_Localized: "\u0412\u0438 \u0441\u043F\u043E\u0432\u043D\u0435\u043D\u0456 \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436026
    m_Localized: "\u0421\u0442\u0430\u043D: \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436027
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0432\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0442\u0440\u043E\u0445\u0438 \u043A\u0440\u043E\u0432\u0456, \u0430\u043B\u0435
      \u043F\u043E\u043A\u0438 \u0449\u043E \u0446\u0435 \u043D\u0435 \u0442\u0430\u043A
      \u0443\u0436\u0435 \u0439 \u0441\u0442\u0440\u0430\u0448\u043D\u043E. \u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u043E\u043A \u0456 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435
      \u0445\u0430\u0440\u0447\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u0440\u0438\u0432\u0435\u0434\u0435
      \u0432\u0441\u0435 \u0432 \u043D\u043E\u0440\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436028
    m_Localized: "\u0421\u0442\u0430\u043D: \u043F\u043E\u0433\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436029
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0443 \u0432\u0430\u0441
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0430 \u043A\u0440\u043E\u0432\u043E\u0432\u0442\u0440\u0430\u0442\u0430.
      \u041C\u043E\u0436\u043B\u0438\u0432\u0456 \u043D\u0430\u043F\u0430\u0434\u0438
      \u0440\u0430\u043F\u0442\u043E\u0432\u043E\u0457 \u0441\u043B\u0430\u0431\u043A\u043E\u0441\u0442\u0456,
      \u0437\u0430\u043F\u0430\u043C\u043E\u0440\u043E\u0447\u0435\u043D\u043D\u044F,
      \u0432\u0442\u0440\u0430\u0442\u0430 \u0441\u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456.
      \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u043D\u043D\u044F \u0434\u043E\u043D\u043E\u0440\u0441\u044C\u043A\u043E\u0457
      \u0430\u0431\u043E \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u043D\u043E\u0457
      \u043A\u0440\u043E\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436030
    m_Localized: "\u0421\u0442\u0430\u043D: \u0436\u0430\u0445\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436031
    m_Localized: "\u0414\u0456\u0430\u0433\u043D\u043E\u0437: \u0432\u0438 \u043D\u0430
      \u043C\u0435\u0436\u0456 \u0441\u043C\u0435\u0440\u0442\u0456 \u0432\u0456\u0434
      \u0432\u0442\u0440\u0430\u0442\u0438 \u043A\u0440\u043E\u0432\u0456. \u041D\u0435\u0433\u0430\u0439\u043D\u043E
      \u0432\u0436\u0438\u0432\u0456\u0442\u044C \u0437\u0430\u0445\u043E\u0434\u0456\u0432,
      \u0430\u0431\u043E \u0432\u0430\u0441 \u0443\u0436\u0435 \u043D\u0456\u0449\u043E
      \u043D\u0435 \u0432\u0440\u044F\u0442\u0443\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436032
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0430 \u0441\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436033
    m_Localized: "\u0421\u0442\u0430\u043D: \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436034
    m_Localized: "\u0412\u0430\u0448\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0441\u0438\u043B\u0430 \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436035
    m_Localized: "\u0421\u0442\u0430\u043D: \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436036
    m_Localized: "\u0412\u0438 \u0442\u0440\u043E\u0445\u0438 \u0432\u0442\u043E\u043C\u0438\u043B\u0438\u0441\u044F,
      \u0430\u043B\u0435 \u043D\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456 \u0446\u0435 \u043F\u043E\u043A\u0438
      \u0449\u043E \u043D\u0435 \u0432\u043F\u043B\u0438\u0432\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436037
    m_Localized: "\u0421\u0442\u0430\u043D: \u043F\u043E\u0433\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436038
    m_Localized: "\u0412\u0430\u0448\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0441\u0438\u043B\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F.
      \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0456 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437
      \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0443\u0442\u0438 \u0442\u0440\u043E\u0445\u0438
      \u0441\u043B\u0430\u0431\u0448\u0438\u043C\u0438, \u043D\u0456\u0436 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436039
    m_Localized: "\u0421\u0442\u0430\u043D: \u0436\u0430\u0445\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436040
    m_Localized: "\u0412\u0430\u0448\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0441\u0438\u043B\u0430 \u043D\u0430 \u043C\u0435\u0436\u0456 \u043F\u043E\u0432\u043D\u043E\u0433\u043E
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u043D\u044F. \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0456 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437 \u0437\u043D\u0430\u0447\u043D\u043E
      \u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u0456. \u041D\u0430\u043F\u043E\u043B\u0435\u0433\u043B\u0438\u0432\u043E
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0442\u0438 \u0456 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0456
      \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0438, \u0456 \u0432 \u0436\u043E\u0434\u043D\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u043D\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0441\u043A\u043B\u0430\u0434\u043D\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0432 \u0442\u0430\u043A\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436041
    m_Localized: "\u0421\u0442\u0430\u043D: \u0432\u0438\u0433\u043E\u0440\u044F\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436042
    m_Localized: "\u0412\u0430\u0448\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0441\u0438\u043B\u0430 \u043D\u0430 \u043D\u0443\u043B\u0456. \u0412\u0438
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0456\u0434\u043D\u0456\u043C\u0430\u0442\u0438 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0456
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438, \u0430 \u043F\u0440\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C
      \u0456 \u043C\u043E\u0432\u0438 \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436043
    m_Localized: "\u0437\u0430\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0456 \u043F\u043E\u043A\u0438
      \u0449\u043E \u043D\u0435\u043C\u0430\u0454."
