  - m_Id: 2725241273
    m_Localized: "\u0426\u0435\u0439 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440
      \u0456\u0441\u0442\u043E\u0442\u043D\u043E \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u0454\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0457
      \u043C\u043E\u0434\u0435\u043B\u0456 12,7-\u043C\u043C \u041F\u041F. \u0417\u0430\u0432\u0434\u044F\u043A\u0438
      \u0434\u0435\u044F\u043A\u0438\u043C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u044F\u043C
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457 \u0432 \u043D\u044C\u043E\u043C\u0443
      \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E \u0440\u043E\u0437\u043B\u0456\u0442
      \u043A\u0443\u043B\u044C \u0456 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E
      \u043F\u0440\u0438\u0446\u0456\u043B\u044C\u043D\u0443 \u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C."
