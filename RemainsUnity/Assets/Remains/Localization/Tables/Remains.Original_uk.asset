  - m_Id: 2729435457
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0425\u043E\u043B\u043E\u0434\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F\" \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u0454,
      \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0434\u043E\u0431\u0440\u0435
      \u0432\u0438 \u0432\u043E\u043B\u043E\u0434\u0456\u0454\u0442\u0435 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u0433\u043E
      \u0431\u043E\u044E. [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u0448\u043A\u043E\u0434\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 #1.[br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C
      \u0440\u0456\u0432\u043D\u0435\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u0432\u0430\u043C \u0441\u0442\u0430\u044E\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
      \u0431\u0456\u043B\u044C\u0448 \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0456
      \u0432\u0438\u0434\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457.
      \u041F\u0440\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E\u043C\u0443
      \u0440\u0456\u0432\u043D\u0456 \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u043E\u0447\u043E\u043A \u0434\u0456\u0457
      \u0432 \u0417.\u041F.\u0421."
