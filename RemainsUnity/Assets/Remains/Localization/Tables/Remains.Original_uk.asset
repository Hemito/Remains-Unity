    m_Localized: "\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E
      \u0432\u0456\u0434\u0434\u0430\u043B\u0435\u043D\u0435 \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F.
      \u041F\u043E\u0447\u0438\u043D\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044F,
      \u0447\u0435\u043A\u0430\u0439\u0442\u0435..."
    m_Metadata:
