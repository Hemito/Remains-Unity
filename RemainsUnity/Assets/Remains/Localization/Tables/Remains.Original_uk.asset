  - m_Id: 2742018233
    m_Localized: "\u041F\u0440\u0438\u043C\u0456\u0442\u043A\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E
      \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430:\n\u0414\u0440\u0443\u0437\u0456
      \u043C\u043E\u0457, \u043C\u0438 \u0432\u0441\u0456 \u0441\u0442\u0430\u043B\u0438
      \u0441\u0432\u0456\u0434\u043A\u0430\u043C\u0438 \u0442\u0440\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u043F\u043E\u0434\u0456\u0439, \u0449\u043E \u0441\u0442\u0430\u043B\u0438\u0441\u044F
      \u0432 \u0417\u0435\u0431\u0440\u0430\u0442\u0430\u0443\u043D\u0456 \u043C\u0438\u043D\u0443\u043B\u043E\u0457
      \u043D\u043E\u0447\u0456. \u041D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0456 \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0456\u0441\u0442\u044C \u0446\u044C\u043E\u0433\u043E
      \u0437\u043B\u043E\u0447\u0438\u043D\u0443 \u043D\u0430\u043F\u043E\u0432\u043D\u044E\u0454
      \u043C\u0435\u043D\u0435 \u0433\u0456\u0440\u043A\u043E\u0442\u043E\u044E,
      \u0430\u043B\u0435, \u044F\u043A \u043F\u043E\u043D\u0456 \u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u044E
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044E,
      \u044F \u0437\u043E\u0431\u043E\u0432'\u044F\u0437\u0430\u043D\u0438\u0439
      \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u0434\u0443\u043C\u0430\u0442\u0438
      \u043F\u0440\u043E \u043D\u0430\u0448\u0443 \u0441\u043F\u0440\u0430\u0432\u0443.
      \u041F\u0440\u043E \u0437\u0430\u0445\u0438\u0441\u0442 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.
      \u0406 \u0437\u0430\u0440\u0430\u0437 \u0431\u0456\u043B\u044C\u0448 \u043D\u0456\u0436
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u0449\u043E \u043F\u0435\u0440\u0435\u0434
      \u043D\u0430\u0448\u043E\u044E \u0411\u0430\u0442\u044C\u043A\u0456\u0432\u0449\u0438\u043D\u043E\u044E
      \u043F\u043E\u0441\u0442\u0430\u0454 \u043D\u043E\u0432\u0430 \u0437\u0430\u0433\u0440\u043E\u0437\u0430.
      \u041D\u0430\u0448 \u0432\u043E\u0440\u043E\u0433 \u0431\u0435\u0437\u0436\u0430\u043B\u0456\u0441\u043D\u0438\u0439
      \u0456 \u0431\u0435\u0437\u0447\u0435\u0441\u043D\u0438\u0439, \u0456 \u0442\u0435\u043F\u0435\u0440
      \u0432\u0456\u043D \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u043D\u043E\u0432\u0438\u0439
      \u043F\u0456\u0434\u043B\u0438\u0439 \u0432\u0430\u0436\u0456\u043B\u044C \u0442\u0438\u0441\u043A\u0443
      \u043D\u0430 \u043D\u0430\u0448\u0435 \u0446\u0438\u0432\u0456\u043B\u044C\u043D\u0435
      \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F: \u0432\u0456\u0434\u0442\u0435\u043F\u0435\u0440
      \u0456 \u043D\u0430\u0434\u0430\u043B\u0456 \u0432\u0456\u043D \u0440\u043E\u0431\u0438\u0442\u0438\u043C\u0435
      \u0432\u0441\u0435, \u0449\u043E\u0431 \u0437\u043D\u0438\u0449\u0438\u0442\u0438
      \u0432\u043E\u043B\u044E \u043F\u043E\u043D\u0456 \u0434\u043E \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0448\u0438\u0445 \u0436\u0435
      \u0441\u0443\u0441\u0456\u0434\u0456\u0432. \u0427\u0435\u0440\u0435\u0437
      \u0437\u0435\u0431\u0440, \u044F\u043A\u0456 \u0436\u0438\u0432\u0443\u0442\u044C
      \u043F\u043B\u0456\u0447-\u043E-\u043F\u043B\u0456\u0447 \u0456\u0437 \u043D\u0430\u043C\u0438
      \u0432\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0456\u0442\u044C.
      \u0412\u0438\u043A\u043B\u0438\u043A\u0430\u044E\u0447\u0438 \u0432\u0441\u0456\u043C\u0430
      \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438 \u0436\u0430\u043B\u0456\u0441\u0442\u044C
      \u0456 \u0441\u043F\u0456\u0432\u0447\u0443\u0442\u0442\u044F \u0434\u043E
      \u043D\u0438\u0445, \u0432\u043E\u0440\u043E\u0433 \u0445\u043E\u0447\u0435
      \u043F\u043E\u0445\u0438\u0442\u043D\u0443\u0442\u0438 \u043D\u0430\u0448\u0443
      \u043D\u0435\u043F\u043E\u0445\u0438\u0442\u043D\u0456\u0441\u0442\u044C \u0443
      \u0437\u0430\u0441\u0443\u0434\u0436\u0435\u043D\u043D\u0456 \u0439\u043E\u0433\u043E
      \u043F\u0456\u0434\u043B\u0438\u0445 \u0434\u0456\u044F\u043D\u044C, \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0435\u043D\u0438\u0445
      \u043F\u043E\u0440\u043E\u0447\u043D\u043E\u044E \u043F\u0440\u0438\u0440\u043E\u0434\u043E\u044E
      \u0437\u0435\u0431\u0440. \u0406 \u0445\u043E\u0447 \u043D\u0430\u0448\u0456
      \u0437\u0435\u0431\u0440\u0438, \u043D\u0430\u0448\u0456 \u043F\u0456\u0434\u0434\u0430\u043D\u0456,
      \u0431\u0435\u0437 \u0441\u0443\u043C\u043D\u0456\u0432\u0456\u0432 \u043F\u0435\u0440\u0435\u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
      \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0456
      \u0442\u0430 \u0454 \u0437\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E
      \u0434\u043E\u0431\u0440\u043E\u0447\u0435\u0441\u043D\u0438\u043C\u0438 \u0439
      \u0431\u043B\u0430\u0433\u043E\u043D\u0430\u0434\u0456\u0439\u043D\u0438\u043C\u0438,
      \u0434\u0430\u043B\u0435\u043A\u043E \u043D\u0435 \u0432\u0441\u0456\u043C
      \u0434\u043E\u0431\u0440\u0438\u043C, \u0430\u043B\u0435 \u043F\u0440\u043E\u0441\u0442\u0438\u043C
      \u0443 \u0441\u0443\u0434\u0436\u0435\u043D\u043D\u044F\u0445 \u043F\u043E\u043D\u0456
      \u0431\u0443\u0434\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430
      \u0440\u0456\u0437\u043D\u0438\u0446\u044F \u043C\u0456\u0436 \u043D\u0430\u0448\u0438\u043C\u0438
      \u0437\u0435\u0431\u0440\u0430\u043C\u0438 \u0442\u0430 \u0447\u0443\u0436\u0438\u043C\u0438."
