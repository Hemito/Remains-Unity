  - m_Id: 2729435473
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u041D\u0430\u0443\u043A\u0430\"
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0454 \u0432\u0430\u0448\u0456
      \u043D\u0430\u0443\u043A\u043E\u0432\u0456 \u043F\u0456\u0437\u043D\u0430\u043D\u043D\u044F
      \u0432 \u0440\u0456\u0437\u043D\u0438\u0445 \u0433\u0430\u043B\u0443\u0437\u044F\u0445,
      \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C\u0443 \u0432 \u0442\u0438\u0445,
      \u0449\u043E \u0441\u0442\u043E\u0441\u0443\u044E\u0442\u044C\u0441\u044F \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0456\u043A\u0438
      \u0442\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0439\u043D\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439. [br]- \u0417
      \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u0443\u0441\u043F\u0456\u0448\u043D\u043E\u0433\u043E \u0437\u043B\u043E\u043C\u0443
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u043C\u043A\u0430
      \u0430\u0431\u043E \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u043E\u0433\u043E
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443 \u0431\u0443\u0434\u0435
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F.[br]-
      \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0435 \u0431\u0456\u043B\u044C\u0448
      \u0441\u043A\u043B\u0430\u0434\u043D\u0456 \u0441\u0438\u0441\u0442\u0435\u043C\u0438
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u0441\u0432\u043E\u0433\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0430,
      \u0441\u0442\u0432\u043E\u0440\u044E\u044E\u0447\u0438 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0456
      \u043C\u043E\u0434\u0443\u043B\u0456 \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435474
    m_Localized: "\u0421\u043A\u0440\u0438\u0442\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
