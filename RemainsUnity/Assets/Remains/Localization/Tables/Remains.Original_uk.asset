    m_Metadata:
      m_Items: []
  - m_Id: 2737824994
    m_Localized: "\u0423\u0441\u0443\u043D\u0443\u0442\u0438 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824995
    m_Localized: "\u041F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0442\u0438 \u043F\u0440\u043E
      \u0443\u0441\u043F\u0456\u0445 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824996
    m_Localized: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u0438 \u043F\u0440\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439
      \u041F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824997
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437
      \u041E\u0443\u043A\u043E\u043C \u0421\u0442\u0430\u043B\u0432\u043E\u0440\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824998
    m_Localized: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u0438 \u043F\u0440\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443 \u0436\u0438\u0442\u0435\u043B\u0456\u0432
      \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824999
    m_Localized: "\u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u043C\u0443
      \u041F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825000
    m_Localized: "\u0423 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0456\u0439 \u0440\u043E\u0437\u043C\u043E\u0432\u0456
      \u0437\u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u043C\u0438 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438
      \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u043C\u0443 \u041F\u043E\u043D\u0456\"
      \u043C\u043E\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u043A\u0430\u043B\u0456\u0431\u0440. \u0429\u043E\u0431 \u0442\u0430\u0431\u0456\u0440
      \u043D\u0435 \u0432\u0438\u044F\u0432\u0438\u0432\u0441\u044F \u0431\u0435\u0437\u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043C
      \u043F\u0435\u0440\u0435\u0434 \u043D\u043E\u0432\u043E\u044E \u0437\u0430\u0433\u0440\u043E\u0437\u043E\u044E,
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0436\u0438\u0442\u0438
      \u0437\u0430\u0445\u043E\u0434\u0456\u0432 \u0449\u043E\u0434\u043E \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043D\u044F
      \u0439\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u043E\u043D\u043E\u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825001
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437
      \u041E\u0443\u043A\u043E\u043C \u043F\u0440\u043E \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825002
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0442\u0430 \u0434\u043E\u0441\u043B\u0456\u0434\u0438\u0442\u0438
      \u0446\u0435\u0445 \u0437\u0456 \u0437\u0431\u043E\u0440\u0443 \u0437\u043D\u0430\u0440\u044F\u0434\u044C
      \u041C\u0435\u0439\u043D\u0422\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825003
    m_Localized: "\u0414\u043E\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u041E\u0443\u043A\u0443
      \u043F\u0440\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825004
    m_Localized: "\u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825005
    m_Localized: "\u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D \u043D\u0435
      \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043F\u0440\u043E\u0442\u0438\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043C\u043E\u0433\u0443\u0442\u043D\u043E\u0441\u0442\u0456
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u0410\u0441\u043A\u0430\u0440\u0456
      \u0432\u0438\u0440\u0456\u0448\u0438\u0432 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
      \u0440\u0430\u0434\u0443 \u0433\u0440\u043E\u043C\u0430\u0434\u0438, \u0449\u043E\u0431
      \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443
      \u0456 \u0437\u043D\u0430\u0439\u0442\u0438 \u0440\u0456\u0448\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825006
    m_Localized: "\u0414\u043E\u0447\u0435\u043A\u0430\u0442\u0438\u0441\u044F, \u043F\u043E\u043A\u0438
      \u0437\u0431\u0435\u0440\u0435\u0442\u044C\u0441\u044F \u0440\u0430\u0434\u0430
      \u0433\u0440\u043E\u043C\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825007
    m_Localized: "\u0412\u0456\u0434\u0432\u0456\u0434\u0430\u0442\u0438 \u0440\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825008
    m_Localized: "\u0414\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0443 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430
      \u043C\u0456\u0441\u0446\u0435\u0437\u043D\u0430\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0440\u0435\u0433\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
