  - m_Id: 2737824092
    m_Localized: "\u041D\u0435 \u0446\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443,
      @lp. \u0426\u0435\u0439 \u0431\u0443\u043D\u043A\u0435\u0440 \u0431\u0443\u0432
      \u0441\u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432\u0430\u043D\u0438\u0439
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u043C\u0456\u0441\u0442\u0443
      \u0432\u0456\u0434 \u0437\u0431\u0440\u043E\u0439\u043D\u043E\u0433\u043E \u043D\u0430\u043F\u0430\u0434\u0443
      \u0446\u0456\u043B\u043E\u0433\u043E \u0431\u0430\u0442\u0430\u043B\u044C\u0439\u043E\u043D\u0443.
      \u0419\u043E\u0433\u043E \u0432\u0445\u0456\u0434\u043D\u0456 \u0441\u0442\u0443\u043B\u043A\u0438
      \u0432 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u043F\u0440\u043E\u0431\u0438\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u0432\u0438\u0431\u0443\u0445\u043E\u043C
      \u0442\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0457 \u0436\u0430\u0440-\u0431\u043E\u043C\u0431\u0438.
      \u0414\u043B\u044F \u0439\u043E\u0433\u043E \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F
      \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0431\u0430\u0433\u0430\u0442\u043E\u043C\u0456\u0441\u044F\u0447\u043D\u0430
      \u043E\u0431\u043B\u043E\u0433\u0430 \u0456 \u0432\u0437\u044F\u0442\u0442\u044F
      \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043A\u0456\u0432 \u0437\u043C\u043E\u0440\u043E\u043C."
