      m_Items: []
  - m_Id: 2725241407
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043E\u0431\u0435\u0440\u0442\u043E\u0432\u0438\u0439 \u0431\u0430\u0440\u0430\u0431\u0430\u043D
      \u0456\u0437 \u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u0441\u0442\u0432\u043E\u043B\u0456\u0432,
      \u043C\u0430\u0454 \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0443 \u0432\u043E\u0433\u043D\u0435\u0432\u0443
      \u0441\u0438\u043B\u0443. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043F\u0430\u0442\u0440\u043E\u043D\u0438 \u0434\u0440\u0456\u0431\u043D\u043E\u0433\u043E
      \u043A\u0430\u043B\u0456\u0431\u0440\u0443, \u0442\u043E\u043C\u0443 \u043F\u0440\u043E\u0442\u0438
      \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0445 \u0446\u0456\u043B\u0435\u0439
      \u043D\u0435 \u0442\u0430\u043A \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430.
      \u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u043D\u0430 \u0440\u043E\u0437\u043A\u0440\u0443\u0442\u043A\u0443
      \u0441\u0442\u0432\u043E\u043B\u0456\u0432 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u043F\u0435\u0432\u043D\u0438\u0439 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241408
    m_Localized: "\"\u0411\u0443\u0440\u0435\u0432\u0456\u0439\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241409
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043C\u0456\u043D\u0456\u0433\u0430\u043D
      - \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u0430 \u043C\u0430\u0448\u0438\u043D\u0430,
      \u0437\u0434\u0430\u0442\u043D\u0430 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044E \u043A\u0440\u0438\u0432\u0430\u0432\u0443
      \u043C'\u044F\u0441\u043E\u0440\u0443\u0431\u043A\u0443 \u0432 \u043B\u0430\u0432\u0430\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430. \u042F\u043A\u0449\u043E,
      \u0437\u0432\u0456\u0441\u043D\u043E, \u0442\u0456 \u043D\u0435 \u0440\u043E\u0437\u0431\u0456\u0436\u0430\u0442\u044C\u0441\u044F
      \u044F\u043A \u043C\u0438\u0448\u0456, \u0449\u043E\u0439\u043D\u043E \u0434\u0456\u0437\u043D\u0430\u0432\u0448\u0438\u0441\u044C
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \"\u0411\u0443\u0440\u0435\u0432\u0456\u0439\"
      \u0437'\u044F\u0432\u0438\u043B\u0430\u0441\u044F \u043D\u0430 \u043F\u043E\u043B\u0456
      \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241410
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0438\u0439 \u043C\u0456\u043D\u0456\u0433\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241411
    m_Localized: "\u0411\u0430\u0433\u0430\u0442\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u0430
      \u043B\u0430\u0437\u0435\u0440\u043D\u0430 \u0433\u0430\u0440\u043C\u0430\u0442\u0430,
      \u0449\u043E \u043C\u0430\u0454 \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0443
      \u043C\u0456\u0446\u044C \u0456 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C,
      \u0430\u043B\u0435 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0430
      \u0456 \u0433\u0440\u043E\u043C\u0456\u0437\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241412
    m_Localized: "\"\u041F\u0440\u0430\u0432\u0435\u0434\u043D\u0438\u0439 \u0433\u043D\u0456\u0432\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241413
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u043C\u0456\u043D\u0456\u0433\u0430\u043D, \u0449\u043E \u043A\u043E\u043B\u0438\u0441\u044C
      \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u044F\u043A\u043E\u043C\u0443\u0441\u044C
      \u0432\u0438\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E\u043C\u0443
      \u0421\u0442\u0430\u043B\u0435\u0432\u043E\u043C\u0443 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0443.
      \u0411\u0456\u043B\u044C\u0448 \u0442\u043E\u0447\u043D\u0438\u0439 \u0456
      \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0438\u0439 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E
      \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241414
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u0439 \u043C\u0456\u043D\u0456\u0433\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241415
    m_Localized: "\u0417\u0431\u0440\u043E\u044F \u0432\u043E\u0456\u0441\u0442\u0438\u043D\u0443
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u0457 \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456,
      \u0437\u0434\u0430\u0442\u043D\u0430 \u0437\u0430 \u043B\u0456\u0447\u0435\u043D\u0456
      \u0441\u0435\u043A\u0443\u043D\u0434\u0438 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0446\u0456\u043B\u0438\u0439 \u0432\u043E\u0440\u043E\u0436\u0438\u0439 \u0437\u0430\u0433\u0456\u043D
      \u043D\u0430 \u043A\u0430\u043B\u044E\u0436\u0443 \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E
      \u0441\u043B\u0438\u0437\u0443. \u0410\u043B\u0435 \u0437\u0430 \u0441\u0432\u043E\u0454\u044E
      \u0432\u0430\u0433\u043E\u044E, \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u0430\u043C\u0438
      \u0456 \u0432\u0438\u0442\u0440\u0430\u0442\u043E\u044E \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432
      \u043D\u0435 \u043D\u0430\u0434\u0442\u043E \u0437\u0440\u0443\u0447\u043D\u0430
      \u044F\u043A \u0456\u043D\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043B\u044C\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241416
    m_Localized: "\"\u0420\u0435\u0432 \u0434\u0440\u0430\u043A\u043E\u043D\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241417
    m_Localized: "\u0414\u0435\u0445\u0442\u043E \u0439 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0441\u0445\u043E\u0436\u0456\u0441\u0442\u044C
      \u043C\u0456\u0436 \u0434\u0438\u0445\u0430\u043D\u043D\u044F\u043C \u0434\u0440\u0430\u043A\u043E\u043D\u0430
      \u0456 \u043F\u043E\u0442\u043E\u043A\u043E\u043C \u043F\u043B\u0430\u0437\u043C\u0438,
      \u0449\u043E \u0432\u0438\u0432\u0435\u0440\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u0446\u0438\u043C \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u043C
      \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F\u043C. \u0422\u0430 \u0449\u043E
      \u0442\u0430\u043C \u043A\u0430\u0437\u0430\u0442\u0438, \u043D\u0430\u0432\u0456\u0442\u044C
      \u0434\u0440\u0430\u043A\u043E\u043D\u0443 \u0431\u0443\u043B\u043E \u0431
      \u043D\u0435\u043F\u0435\u0440\u0435\u043B\u0438\u0432\u043A\u0438, \u044F\u043A\u0431\u0438
      \u0432\u0456\u043D \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0432 \u043F\u0456\u0434
      \u0439\u043E\u0433\u043E \u0432\u043E\u0433\u043E\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241418
    m_Localized: "\u0412\u043E\u0433\u043D\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241419
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u0449\u043E \u0432\u0440\u0430\u0436\u0430\u0454
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u0432\u043E\u0433\u043D\u044F\u043D\u0438\u043C
      \u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0435\u043C. \u041C\u043E\u0436\u0435
      \u043F\u0456\u0434\u043F\u0430\u043B\u0438\u0442\u0438 \u0446\u0456\u043B\u044C,
      \u0447\u0438\u043C \u0437\u0430\u0432\u0434\u0430\u0442\u0438 \u0457\u0439
      \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241420
    m_Localized: "\"\u0412\u0438\u043F\u0430\u043B\u044E\u0432\u0430\u0447\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241421
    m_Localized: "\u0423\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0435\u043D\u0438\u0439
      \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442, \u0449\u043E \u043C\u0430\u0454
      \u043D\u0438\u0437\u043A\u0443 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u0438\u0445
      \u0437\u043C\u0456\u043D. \u0417\u0430\u0432\u0434\u044F\u043A\u0438 \u0457\u043C
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044F
      \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F \u0456 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
      \u0433\u043E\u0440\u0456\u043D\u043D\u044F \u043F\u0430\u043B\u0438\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241422
    m_Localized: "\u0406\u043D\u0441\u0438\u043D\u0435\u0440\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241423
    m_Localized: "\u0424\u0443\u0433\u0430\u0441\u043D\u0438\u0439 \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442,
      \u0449\u043E \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u044E\u0454 \u0433\u043E\u0440\u044E\u0447\u0443
      \u0441\u0443\u043C\u0456\u0448 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u043C\u0438
      \u043F\u043E\u0440\u0446\u0456\u044F\u043C\u0438. \u0412\u043E\u0433\u043D\u044F\u043D\u0456
      \u0437\u0433\u0443\u0441\u0442\u043A\u0438 \u043F\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u0456
      \u0432\u0438\u0431\u0443\u0445\u0430\u044E\u0442\u044C, \u0440\u043E\u0437\u0431\u0440\u0438\u0437\u043A\u0443\u044E\u0447\u0438
      \u043F\u0430\u043B\u0430\u044E\u0447\u0435 \u043F\u0430\u043B\u0438\u0432\u043E
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E, \u0442\u0430\u043A \u0449\u043E
      \u0431\u043B\u0438\u0437\u044C\u043A\u043E \u043A\u0440\u0430\u0449\u0435 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u043D\u0435 \u0441\u0442\u043E\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241424
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0438\u0439 \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241425
    m_Localized: "\u0413\u0440\u0456\u0437\u043D\u0430 \u0437\u0431\u0440\u043E\u044F,
      \u0449\u043E \u0441\u0456\u0454 \u0436\u0430\u0445 \u0456 \u043F\u0430\u043D\u0456\u043A\u0443
      \u043D\u0430 \u043F\u043E\u043B\u0456 \u0431\u043E\u044E, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u043E\u0431\u0456\u0446\u044F\u0454 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0435\u043C\u0438\u043D\u0443\u0447\u0443, \u0430 \u0439 \u0431\u043E\u043B\u0456\u0441\u043D\u0443
      \u0441\u043C\u0435\u0440\u0442\u044C. \u0412\u0438\u0441\u0442\u0440\u0456\u043B\u044E\u0454
      \u0440\u0456\u0434\u043A\u0443 \u0433\u043E\u0440\u044E\u0447\u0443 \u0441\u0443\u043C\u0456\u0448
      \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0443 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C,
      \u043F\u0456\u0434\u043F\u0430\u043B\u044E\u044E\u0447\u0438 \u0432\u0441\u0435
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E, \u0456 \u0437\u0430\u0433\u0430\u0441\u0438\u0442\u0438
      \u0457\u0457 \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241426
    m_Localized: "\"\u041E\u0447\u0438\u0449\u0443\u0432\u0430\u043B\u044C\u043D\u0435
      \u041F\u043E\u043B\u0443\u043C'\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241427
    m_Localized: "\u0417\u043D\u0430\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u0433\u043B\u044F\u0434\u0443
      \u0431\u043E\u0439\u043E\u0432\u0438\u0439 \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442,
      \u0432\u0435\u0441\u044C \u0447\u043E\u0440\u043D\u0438\u0439 \u0432\u0456\u0434
      \u043A\u043E\u043F\u043E\u0442\u0456. \u041A\u043E\u043B\u0438\u0441\u044C
      \u0432\u0456\u043D \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u0441\u0443\u043C\u043D\u043E\u0437\u0432\u0456\u0441\u043D\u043E\u043C\u0443
      \u0432\u0430\u0442\u0430\u0436\u043A\u043E\u0432\u0456 \u0440\u0435\u0439\u0434\u0435\u0440\u0441\u044C\u043A\u043E\u0457
      \u0431\u0430\u043D\u0434\u0438 \u041F\u0430\u043B\u0456\u0457\u0432, \u044F\u043A\u0438\u0439
      \u0437\u0433\u043E\u0440\u0456\u0432 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043F\u043E\u0436\u0435\u0436\u0456 \u0443 \u0432\u043B\u0430\u0441\u043D\u043E\u043C\u0443
      \u043B\u0456\u0433\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241428
    m_Localized: "\u0416\u0430\u0440-\u044F\u0439\u0446\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241429
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0433\u043E
      \u0432 \u0441\u0430\u043C\u0456\u0439 \u0446\u0456\u0439 \u0437\u0431\u0440\u043E\u0457
      \u043D\u0435\u043C\u0430\u0454, \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0430
      \u043F\u0443\u0441\u043A\u043E\u0432\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430.
      \u0423\u0441\u044F \u0441\u0456\u043B\u044C \u0443 \u0457\u0457 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u0445
      - \u0436\u0430\u0440-\u044F\u0439\u0446\u044F\u0445, \u0443 \u044F\u043A\u0438\u0445
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0430 \u0444\u0430\u043D\u0442\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0440\u0443\u0439\u043D\u0456\u0432\u043D\u0430 \u0441\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241430
    m_Localized: "\"\u0422\u043E\u0432\u0441\u0442\u0443\u043D\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241431
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0439 \u0436\u0430\u0440-\u044F\u0439\u0446\u0435\u043C\u0435\u0442,
      \u0431\u0456\u043B\u044C\u0448 \u0442\u043E\u0447\u043D\u0438\u0439, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0438\u0439
      \u0456 \u043D\u0430\u0434\u0456\u0439\u043D\u0438\u0439. \u041D\u0430\u0447\u0435
      \u0446\u044F \u0436\u0430\u0445\u043B\u0438\u0432\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0449\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0432\u0430\u043B\u0430
      \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241432
    m_Localized: "\"\u0421\u043F\u0430\u043B\u0430\u0445\u0443\u0439\u043A\u0430\"|\"\u0417\u0430\u043F\u0430\u043B\u044C\u043D\u0438\u0447\u043A\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241433
    m_Localized: "\u042F\u043A\u0449\u043E \u0434\u043E \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E
      \u0430\u0435\u0440\u043E\u0437\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0431\u0430\u043B\u043E\u043D\u0447\u0438\u043A\u0430
      \u0456\u0437\u043E\u043B\u0435\u043D\u0442\u043E\u044E \u043F\u0440\u0438\u043A\u0440\u0456\u043F\u0438\u0442\u0438
      \u0437\u0430\u043F\u0430\u043B\u044C\u043D\u0438\u0447\u043A\u0443, \u0432\u0438\u0439\u0434\u0435
      \u0456\u043C\u043F\u0440\u043E\u0432\u0456\u0437\u043E\u0432\u0430\u043D\u0438\u0439
      \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442. \u041A\u043E\u0440\u0438\u0441\u0442\u0456
      \u0432\u0456\u0434 \u043D\u044C\u043E\u0433\u043E \u043D\u0435 \u0442\u0435
      \u0449\u043E\u0431 \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E,
      \u0437\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0445\u0456\u0431\u0430
      \u0449\u043E \u043F\u0430\u043B\u0438\u0442\u0438 \u0442\u0430\u0440\u0433\u0430\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241434
    m_Localized: "\"\u0414\u0440\u043E\u0442\u0438\u043A\u043E\u043C\u0435\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241435
    m_Localized: "\u0421\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F,
      \u0449\u043E \u0441\u0442\u0440\u0456\u043B\u044F\u0454 \u043E\u0442\u0440\u0443\u0454\u043D\u0438\u043C\u0438
      \u0434\u0440\u043E\u0442\u0438\u043A\u0430\u043C\u0438. \u0421\u0430\u043C\u0456
      \u0434\u0440\u043E\u0442\u0438\u043A\u0438 \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C
      \u043C\u0456\u043D\u0456\u043C\u0430\u043B\u044C\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0446\u0456\u043B\u0456 \u0456 \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438
      \u043F\u0440\u043E\u0431'\u044E\u0442\u044C \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0430\u0439\u043B\u0435\u0433\u0448\u0443 \u0431\u0440\u043E\u043D\u044E,
      \u0437\u0430\u0442\u0435 \u0441\u0442\u0440\u0456\u043B\u044F\u0454 \u0446\u044F
      \u0437\u0431\u0440\u043E\u044F \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u0431\u0435\u0437\u0448\u0443\u043C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241436
    m_Localized: "\u041A\u0438\u0441\u043B\u043E\u0442\u043D\u0430 \u0433\u0430\u0440\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241437
    m_Localized: "\u0417\u0431\u043E\u0447\u0435\u043D\u0430 \u043F\u043E\u0434\u043E\u0431\u0430
      \u0437\u0431\u0440\u043E\u0457, \u0449\u043E \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u044E\u0454
      \u0443 \u0432\u043E\u0440\u043E\u0433\u0430 \u043F\u043E\u0442\u043E\u043A\u043E\u043C
      \u0457\u0434\u043A\u043E\u0457 \u043A\u0438\u0441\u043B\u043E\u0442\u0438,
      \u044F\u043A\u0430 \u0440\u043E\u0437'\u0457\u0434\u0430\u0454 \u0431\u0440\u043E\u043D\u044E
      \u0456 \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u044F\u0454 \u0445\u0456\u043C\u0456\u0447\u043D\u0456
      \u043E\u043F\u0456\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241438
    m_Localized: "\"\u041F\u0438\u043B\u043E\u043C\u0435\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241439
    m_Localized: "\u0425\u0438\u0442\u0440\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F
      \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438 \u0434\u0438\u0441\u043A\u043E\u0432\u0438\u043C\u0438
      \u043F\u0438\u043B\u0430\u043C\u0438. \u041F\u0438\u043B\u0430, \u0449\u043E
      \u043B\u0435\u0442\u0438\u0442\u044C \u0437\u0456 \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u044E
      \u0441\u0438\u043B\u043E\u044E, \u0437\u0434\u0430\u0442\u043D\u0430 \u0437\u0430\u0432\u0434\u0430\u0442\u0438
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u043A\u0456\u043B\u044C\u043A\u043E\u043C
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C,
      \u044F\u043A\u0456 \u0441\u0442\u043E\u044F\u0442\u044C \u0432 \u043E\u0434\u043D\u0443
      \u043B\u0456\u043D\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241440
    m_Localized: "\u041A\u0430\u0440\u0442\u0435\u0447\u043D\u0430 \u0433\u0430\u0440\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241441
    m_Localized: "\u041D\u0435 \u0437\u043E\u0432\u0441\u0456\u043C \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E,
      \u044F\u043A \u0446\u044F \u0434\u0438\u0432\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u043C\u043E\u0436\u0435 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438,
      \u0430\u043B\u0435 \u0442\u0438\u043C \u043D\u0435 \u043C\u0435\u043D\u0448
      \u0432\u043E\u043D\u0430 \u043F\u0440\u0430\u0446\u044E\u0454. \u042F\u043A
      \u043A\u0430\u0440\u0442\u0435\u0447 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u043C\u0435\u0442\u0430\u043B\u043E\u0431\u0440\u0443\u0445\u0442, \u0430
      \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443
      \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0435\u043D\u0435\u0440\u0433\u0456\u044F \u043F\u0430\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241442
    m_Localized: "\u0417\u0430\u043B\u0456\u0437\u043D\u0438\u0447\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241443
    m_Localized: "\u0426\u044F \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0435
      \u043F\u043E\u043B\u0435, \u0449\u043E\u0431 \u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u044E
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u044E\u0432\u0430\u0442\u0438
      \u0437\u0430\u043B\u0456\u0437\u043D\u0438\u0447\u043D\u0456 \u043C\u0438\u043B\u0438\u0446\u0456.
      \u0414\u043B\u044F \u0441\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F \u0446\u0456\u0454\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0431\u0443\u0442\u0438 \u0434\u0443\u0436\u0435 \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0438\u043C
      \u043C\u0435\u0445\u0430\u043D\u0456\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241444
    m_Localized: "\u0414\u0440\u0443\u0436\u0431\u043E-\u0433\u0430\u0440\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241445
    m_Localized: "\u0426\u044F \u0437\u0431\u0440\u043E\u044F \u043D\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0442\u0430\u043A \u0442\u043E\u043C\u0443, \u0449\u043E \u0443 \u0432\u0441\u044F\u043A\u043E\u0433\u043E,
      \u0445\u0442\u043E \u0431\u0430\u0447\u0438\u0442\u044C \u0457\u0457 \u0443
      \u0432\u0430\u0448\u0438\u0445 \u043A\u043E\u043F\u0438\u0442\u0430\u0445,
      \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u0432\u0438\u043D\u0438\u043A\u0430\u0454
      \u0434\u0443\u043C\u043A\u0430, \u0449\u043E \u0437 \u0432\u0430\u043C\u0438
      \u043A\u0440\u0430\u0449\u0435 \u0434\u0440\u0443\u0436\u0438\u0442\u0438,
      \u043D\u0456\u0436 \u0432\u043E\u0440\u043E\u0433\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241446
    m_Localized: "\"\u0412\u0435\u043B\u0438\u043A\u0430 \u0404\u0431\u0443\u0447\u0430
      \u0413\u0430\u0440\u043C\u0430\u0442\u0430\"|\"\u0412\u0435\u043B\u0438\u043A\u0430
      \u0414\u043E\u0432\u0431\u0430\u043D\u0430 \u0413\u0430\u0440\u043C\u0430\u0442\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241447
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043D\u0430
      \u0433\u0435\u043D\u0456\u0430\u043B\u044C\u043D\u0438\u043C, \u0430\u043B\u0435
      \u044F\u0432\u043D\u043E \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0438\u043C
      \u0432\u0438\u043D\u0430\u0445\u0456\u0434\u043D\u0438\u043A\u043E\u043C. \u0412\u043E\u043D\u0430
      \u0442\u0430\u043A \u0441\u0430\u043C\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0430
      \u0434\u043B\u044F \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430, \u044F\u043A
      \u0456 \u0434\u043B\u044F \u0439\u043E\u0433\u043E \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u0431\u043E \u0441\u0442\u0440\u0456\u043B\u044F\u0454 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u043C\u0438,
      \u043D\u0435\u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u0438\u043C\u0438
      \u0456 \u0432\u0438\u0431\u0443\u0445\u043E\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C\u0438
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u043C\u0438 \u043A\u0443\u043B\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241448
    m_Localized: "\u0414\u0438\u043D\u0430\u043C\u0456\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241449
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430 \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u043D\u0430
      \u0448\u0430\u0448\u043A\u0430 \u0437 \u0434\u043E\u0432\u0433\u0438\u043C
      \u0433\u043D\u0456\u0442\u043E\u043C, \u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0434\u043B\u044F \u0433\u0456\u0440\u043D\u0438\u0447\u0438\u0445
      \u0440\u043E\u0431\u0456\u0442, \u043D\u0456\u0436 \u0434\u043B\u044F \u0431\u043E\u044E.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0437 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456\u0441\u0442\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241450
    m_Localized: "\u0421\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241451
    m_Localized: "\u041F\u0440\u0438\u043C\u0456\u0442\u0438\u0432\u043D\u0438\u0439
      \u0432\u0430\u0440\u0456\u0430\u043D\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u0438,
      \u044F\u0432\u043B\u044F\u0454 \u0441\u043E\u0431\u043E\u044E \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u043D\u0443
      \u0431\u0430\u043D\u043A\u0443, \u043D\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0443
      \u043F\u043E\u0440\u043E\u0445\u043E\u043C \u0456 \u0448\u043C\u0430\u0442\u043E\u0447\u043A\u0430\u043C\u0438
      \u043C\u0435\u0442\u0430\u043B\u0443. \u041B\u0435\u0433\u043A\u043E \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0456 \u0437 \u043F\u0456\u0434\u0440\u0443\u0447\u043D\u043E\u0433\u043E
      \u0441\u043C\u0456\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241452
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043A\u043E\u0432\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241453
    m_Localized: "\u0415\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u043F\u0440\u043E\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u0449\u043E \u0445\u043E\u0432\u0430\u044E\u0442\u044C\u0441\u044F \u0432
      \u0443\u043A\u0440\u0438\u0442\u0442\u044F\u0445. \u041D\u0430 \u0432\u0438\u0433\u043B\u044F\u0434
      \u0441\u0445\u043E\u0436\u0430 \u043D\u0430 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0435
      \u044F\u0431\u043B\u0443\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241454
    m_Localized: "\u0413\u0430\u0437\u043E\u0432\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241455
    m_Localized: "\u0426\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u043F\u0456\u0434
      \u0447\u0430\u0441 \u0432\u0438\u0431\u0443\u0445\u0443 \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454
      \u0445\u043C\u0430\u0440\u0443 \u0434\u0443\u0436\u0435 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0433\u043E
      \u0433\u0430\u0437\u0443. \u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430
      \u0439\u043E\u0433\u043E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043C\u043E\u0436\u0435 \u043F\u0440\u0438\u0437\u0432\u0435\u0441\u0442\u0438
      \u0434\u043E \u0448\u0432\u0438\u0434\u043A\u043E\u0457 \u0441\u043C\u0435\u0440\u0442\u0456.
      \u0423 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0430\u0445
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241456
    m_Localized: "\u041A\u0438\u0441\u043B\u043E\u0442\u043D\u0430 \u0431\u043E\u043C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241457
    m_Localized: "\u041F\u043B\u044F\u0448\u043A\u0430, \u043D\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0430
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0457\u0434\u043A\u043E\u044E
      \u0440\u0456\u0434\u0438\u043D\u043E\u044E. \u041F\u0456\u0434 \u0447\u0430\u0441
      \u043A\u0438\u0434\u043A\u0430 \u0440\u043E\u0437\u0431\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0437\u0430\u0431\u0440\u0438\u0437\u043A\u0443\u044E\u0447\u0438 \u0432\u0441\u0435
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E. \u0422\u043E\u0439, \u0445\u0442\u043E
      \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0443 \u0446\u0456
      \u043A\u0430\u043B\u044E\u0436\u0456, \u043E\u0442\u0440\u0438\u043C\u0430\u0454
      \u0441\u0438\u043B\u044C\u043D\u0456 \u0445\u0456\u043C\u0456\u0447\u043D\u0456
      \u043E\u043F\u0456\u043A\u0438. \u0422\u0430\u043A\u043E\u0436 \u0440\u0443\u0439\u043D\u0443\u0454
      \u0431\u0440\u043E\u043D\u044E \u0440\u043E\u0431\u043E\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241458
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u043E\u0432\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241459
    m_Localized: "\u0417\u0430\u043C\u0456\u0441\u0442\u044C \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438 \u0446\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0437\u0430\u0440\u044F\u0434,
      \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u0440\u043E\u0437\u043F\u043B\u0430\u0432\u0438\u0442\u0438
      \u0432\u0441\u0435 \u043D\u0430\u0432\u043A\u043E\u043B\u043E! \u041D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430 \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443
      \u0433\u0440\u0430\u043D\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241460
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241461
    m_Localized: "\u0413\u0440\u0430\u043D\u0430\u0442\u0430, \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0438\u0439
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441 \u0434\u043B\u044F \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F
      \u0440\u043E\u0431\u043E\u0442\u0456\u0432 \u0442\u0430 \u0456\u043D\u0448\u043E\u0457
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0456\u043A\u0438. \u041D\u0430
      \u0436\u0438\u0432\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u043D\u0435 \u0434\u0456\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241462
    m_Localized: "\u041A\u0440\u0456\u043E\u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241463
    m_Localized: "\u041F\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u0431\u0443\u0445\u0443
      \u0446\u0456\u0454\u0457 \u0433\u0440\u0430\u043D\u0430\u0442\u0438 \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u0454
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u043C\u0438\u0442\u0442\u0454\u0432\u043E
      \u043E\u0441\u0442\u0438\u0433\u0430\u0454 \u0434\u043E \u0435\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u043E
      \u043D\u0438\u0437\u044C\u043A\u043E\u0457 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438.
      \u0416\u0438\u0432\u0456 \u0456\u0441\u0442\u043E\u0442\u0438 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0456 \u0433\u0456\u043F\u043E\u0442\u0435\u0440\u043C\u0456\u0447\u043D\u0456
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241464
    m_Localized: "\u0417\u0430\u043F\u0430\u043B\u044C\u043D\u0438\u0439 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241465
    m_Localized: "\u041F\u043B\u044F\u0448\u043A\u0430, \u043D\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0430
      \u0433\u043E\u0440\u044E\u0447\u043E\u044E \u0440\u0456\u0434\u0438\u043D\u043E\u044E
      \u0456 \u0437\u0430\u0442\u043A\u043D\u0443\u0442\u0430 \u0433\u0430\u043D\u0447\u0456\u0440\u043A\u043E\u044E.
      \u041F\u0456\u0434\u043F\u0430\u043B\u044E\u0454\u0448, \u043A\u0438\u0434\u0430\u0454\u0448
      - \u043F\u0440\u043E\u0441\u0442\u043E, \u0434\u0435\u0448\u0435\u0432\u043E
      \u0439 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241466
    m_Localized: "\u0412\u043E\u0433\u043D\u044F\u043D\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241467
    m_Localized: "\u0413\u0440\u0430\u043D\u0430\u0442\u0430 \u0437\u0430\u043F\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0442\u0438\u043F\u0443. \u041F\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u0431\u0443\u0445\u0443
      \u0437\u0430\u0432\u0434\u0430\u0454 \u0448\u043A\u043E\u0434\u0438 \u0432\u043E\u0433\u043D\u0435\u043C
      \u0456 \u043F\u0456\u0434\u043F\u0430\u043B\u044E\u0454 \u0432\u0441\u0435
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241468
    m_Localized: "\u0421\u043F\u0430\u0440\u043A\u043B-\u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241469
    m_Localized: "\u041D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442
      \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u043E\u0457 \u0433\u0440\u0430\u043D\u0430\u0442\u0438
      \u0437\u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u0438\u043C \u0440\u0430\u0434\u0456\u0443\u0441\u043E\u043C
      \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F. \u042F\u043A \u0432\u0438\u0431\u0443\u0445\u043E\u0432\u0443
      \u0440\u0435\u0447\u043E\u0432\u0438\u043D\u0443 \u0432 \u043D\u0456\u0439
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u0430 \u0441\u0443\u043C\u0456\u0448
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456 \u0441\u043F\u0430\u0440\u043A\u043B-\u043A\u043E\u043B\u0438
      \u0420\u0410\u0414."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241470
    m_Localized: "\u0421\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0430 \u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241471
    m_Localized: "\u041C\u0456\u043D\u0430, \u0437\u0456\u0431\u0440\u0430\u043D\u0430
      \u0437 \u0440\u0456\u0437\u043D\u043E\u0433\u043E \u043C\u043E\u0442\u043B\u043E\u0445\u0443,
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u043E\u0433\u043E
      \u0437\u0430\u0440\u044F\u0434\u0443. \u0417\u0430 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u043C
      \u0434\u0456\u0457 \u0441\u0445\u043E\u0436\u0430 \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u044E
      \u043F\u0440\u043E\u0442\u0438\u043F\u0456\u0445\u043E\u0442\u043D\u043E\u044E
      \u043C\u0456\u043D\u043E\u044E, \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0435
      \u0442\u0430\u043A\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241472
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043A\u043E\u0432\u0430 \u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241473
    m_Localized: "\u041C\u0456\u043D\u0430 \u043D\u0435\u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u043E\u0457
      \u0434\u0456\u0457, \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E
      \u0441\u0432\u0456\u0439/\u0447\u0443\u0436\u0438\u0439. \u0412\u0438\u0431\u0443\u0445\u0430\u0454
      \u043F\u0440\u0438 \u043D\u0430\u0431\u043B\u0438\u0436\u0435\u043D\u043D\u0456
      \u0432\u043E\u0440\u043E\u0436\u043E\u0457 \u0446\u0456\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241474
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u043E\u0432\u0430 \u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241475
    m_Localized: "\u041F\u043E\u0442\u0443\u0436\u043D\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0432\u0435\u0440\u0441\u0456\u044F \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457
      \u043C\u0456\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241476
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241477
    m_Localized: "\u041C\u0456\u043D\u0430, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0430
      \u0434\u043B\u044F \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F \u0440\u043E\u0431\u043E\u0442\u0456\u0432,
      \u0457\u0457 \u0441\u0435\u043D\u0441\u043E\u0440 \u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0438\u0439
      \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u043D\u043E\u043C, \u0449\u043E
      \u0440\u0435\u0430\u0433\u0443\u0454 \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430
      \u043D\u0438\u0445. \u041D\u0430 \u0436\u0438\u0432\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u043D\u0435 \u043F\u043E\u0434\u0456\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241478
    m_Localized: "\u041A\u0440\u0456\u043E\u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241479
    m_Localized: "\u041F\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u0431\u0443\u0445\u0443
      \u0446\u0456\u0454\u0457 \u043C\u0456\u043D\u0438 \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u0454
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u043C\u0438\u0442\u0442\u0454\u0432\u043E
      \u043E\u0441\u0442\u0438\u0433\u0430\u0454 \u0434\u043E \u0435\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u043E
      \u043D\u0438\u0437\u044C\u043A\u043E\u0457 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438.
      \u0416\u0438\u0432\u0456 \u0456\u0441\u0442\u043E\u0442\u0438 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0456 \u0433\u0456\u043F\u043E\u0442\u0435\u0440\u043C\u0456\u0447\u043D\u0456
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
