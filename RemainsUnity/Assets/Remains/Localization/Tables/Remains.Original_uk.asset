      \u0446\u0456\u043B\u0456 \u043D\u0430 \u0434\u0430\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824095
    m_Localized: "\u042F\u043A\u0449\u043E \u0436 \u0443\u0441\u0435-\u0442\u0430\u043A\u0438
      \u0442\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u0448 \u0442\u0443\u0434\u0438
      \u043D\u0430\u0432\u0456\u0434\u0430\u0442\u0438\u0441\u044F... \u041F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0440\u0430\u0434\u0430 - \u0437\u0430\u0437\u0438\u0440\u043D\u0438
      \u0441\u043F\u0435\u0440\u0448\u0443 \u0434\u043E \u043F\u0438\u0441\u0430\u0440\u044F
      \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u0438. \u0423 \u043D\u0435\u0457
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0442\u0435, \u0449\u043E
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0442\u043E\u0431\u0456 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0434\u0430\u043B\u0456 \u0432\u0445\u043E\u0434\u0443. \u0410 \u0442\u0435\u043F\u0435\u0440
      \u043D\u0430\u043C \u0443\u0441\u0456\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824096
    m_Localized: "\u0417\u0430\u0433\u0440\u043E\u0437\u0430 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u043C\u0443
      \u043F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824097
    m_Localized: "@lp! \u0420\u0430\u0434\u0438\u0439 \u0442\u0435\u0431\u0435 \u0431\u0430\u0447\u0438\u0442\u0438.
      \u0422\u0438 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430 \u0437\u0456
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0441\u043F\u0440\u0430\u0432\u0430\u043C\u0438
      \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824098
    m_Localized: "\u0422\u0430\u043A, \u044F \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u0432\u0441\u0435, \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E.
      \u041E\u0434\u043D\u0430\u043A \u0442\u0435\u043F\u0435\u0440 \u0443 \u043D\u0430\u0441
      \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u043E\u0431\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824099
    m_Localized: "\"\u041D\u0430\u0441\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824100
    m_Localized: "\u042F \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u0442\u0440\u0438\u0432\u043E\u0436\u043D\u0456
      \u0437\u0432\u0456\u0441\u0442\u043A\u0438, \u0414\u0430\u0439\u043A\u0456\u0440\u0456.
      \u041D\u0430\u0441\u0442\u0430\u044E\u0442\u044C \u0441\u043A\u043B\u0430\u0434\u043D\u0456
      \u0447\u0430\u0441\u0438. \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0437\u0434\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044F \u0456\u0437 \u0437\u0435\u0431\u0440\u0430\u043C\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u041D\u0435 \u0432\u0441\u0456\u043C
      \u0446\u0435 \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u043B\u043E\u0441\u044F,
      \u0456 \u0437\u0430\u0440\u0430\u0437 \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u0438\u043C\u0438
      \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044F\u043C\u0438 \u0440\u043E\u0437\u0433\u043E\u0440\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u043E\u0433\u043E\u043D\u044C \u0433\u0440\u043E\u043C\u0430\u0434\u044F\u043D\u0441\u044C\u043A\u043E\u0457
      \u0432\u0456\u0439\u043D\u0438. \u0414\u043E\u0441\u0438\u0442\u044C \u0456\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0442\u0435, \u0449\u043E \u043D\u0430\u0448\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0442\u0430\u043A\u043E\u0436 \u0437\u0430\u0447\u0435\u043F\u0438\u0442\u044C
      \u043F\u043E\u043B\u0443\u043C'\u044F\u043C \u0446\u0438\u0445 \u0431\u043E\u0457\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824101
    m_Localized: "\"\u041D\u0430\u0448\u0435\", \u0437\u043D\u0430\u0447\u0438\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824102
    m_Localized: "\u0422\u0430\u043A, \u0434\u0456\u0439\u0441\u043D\u043E \u0432\u0430\u0436\u043A\u0438\u0439
      \u0447\u0430\u0441. \u0422\u0438 \u0431 \u043D\u0435 \u0441\u0442\u0430\u043B\u0430
      \u0431\u0430\u0437\u0456\u043A\u0430\u0442\u0438 \u0434\u0430\u0440\u0435\u043C\u043D\u043E,
      @lp. \u0420\u0430\u0437 \u0442\u0430\u043A, \u0442\u043E \u043D\u0430\u043C
      \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0441\u043B\u0456\u0434 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824103
    m_Localized: "\u042F \u0432\u043B\u0430\u0448\u0442\u0443\u044E \u043D\u0430\u043C
      \u043D\u043E\u0432\u0456 \u043F\u0430\u0442\u0440\u0443\u043B\u0456, \u0448\u0435\u0444\u0435,
      \u0442\u0430 \u0439 \u0441\u0430\u043C \u043B\u0456\u0442\u0430\u0442\u0438
      \u0447\u0430\u0441\u0442\u0456\u0448\u0435 \u0431\u0443\u0434\u0443 \u0442\u0435\u043F\u0435\u0440.
      \u0412\u043E\u0440\u043E\u0433 \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824104
    m_Localized: "\u0410 \u0449\u0435 \u043D\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E
      \u0440\u043E\u0437\u0434\u043E\u0431\u0443\u0442\u0438 \u0432\u0430\u0436\u0447\u0456
      \u0433\u0430\u0440\u043C\u0430\u0442\u0438. \u0426\u0438\u0445 \u0437\u0430\u043B\u0456\u0437\u043D\u043E\u0433\u0440\u0443\u0434\u0438\u0445
      \u043D\u0435 \u043F\u0440\u043E\u0431\u0438\u0442\u0438 \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043E\u043A. \u041E\u0441\u044C
      \u0443\u0436\u0435 \u043D\u0435 \u0447\u0435\u043A\u0430\u043B\u0438 \u0432\u0456\u0434
      \u043A\u043E\u0433\u043E \u0431\u0456\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824105
    m_Localized: "\u0427\u0438 \u043C\u043E\u0436\u0443 \u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824106
    m_Localized: "\u041C\u0438 \u0442\u0443\u0442 \u0437\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E
      \u0441\u0430\u043C\u0456 \u0437\u0432\u0438\u043A\u043B\u0438, \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0443\u0454\u043C\u043E\u0441\u044F
      \u044F\u043A\u043E\u0441\u044C. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E
      \u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0430 \u043F\u0456\u0434\u0441\u043E\u0431\u0438\u0442\u0438
      \u043D\u0430\u043C - \u0442\u0432\u043E\u0457 \u0433\u0430\u0440\u043C\u0430\u0442\u0438
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u0430\u0432\u0430\u0434\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824107
    m_Localized: "\u0410 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0442\u0438
      \u043C\u043E\u0436\u0435\u0448 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0421\u0442\u0430\u043B\u0432\u043E\u0440\u0442\u0443, \u043D\u0430\u0448\u043E\u043C\u0443
      \u0431\u0440\u043E\u043D\u043D\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824108
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u043C\u0430\u0454
      \u0440\u0430\u0446\u0456\u044E. \u041C\u0438 \u043F\u0440\u043E \u0446\u0435
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043D\u0456\u043A\u043E\u043C\u0443
      \u043D\u0435 \u043A\u0430\u0436\u0435\u043C\u043E, \u043E\u0434\u043D\u0430\u043A
      \u0442\u043E\u0431\u0456 \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0442\u0438.
      \u041E\u0443\u043A - \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0439 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0439
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440. \u041D\u0435 \u0437\u043D\u0430\u044E,
      \u0447\u043E\u043C\u0443 \u043F\u0456\u0448\u043E\u0432, \u0432\u0456\u043D
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0419\u043E\u0433\u043E
      \u0437\u043D\u0430\u043D\u043D\u044F \u043D\u0430\u043C \u0437\u0430\u0440\u0430\u0437
      \u0434\u0443\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C.
      \u0410 \u044F\u043A\u0449\u043E \u0439\u043E\u043C\u0443 \u0431\u0443\u0434\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430,
      \u0442\u043E \u0457\u0457 \u0441\u043B\u0456\u0434 \u043D\u0430\u0434\u0430\u0442\u0438
      \u043F\u043E\u0432\u043D\u043E\u044E \u043C\u0456\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824109
    m_Localized: "\u042F \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u044E \u0437
      \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824110
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, @lp. \u0412\u0438\u0433\u043B\u044F\u0434\u0430\u0454\u0448
      \u0442\u0440\u0438\u0432\u043E\u0436\u043D\u043E. \u0429\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824111
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442. \u0414\u0430\u0439\u043A\u0456\u0440\u0456
      \u0441\u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0442\u0438 - \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0439
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824112
    m_Localized: "\u0415\u043C\u043C... \u0414\u0456\u0439\u0441\u043D\u043E, \u0446\u0435
      \u0442\u0430\u043A. \u0428\u0435\u0440\u0438\u0444 \u043D\u0435 \u0441\u0442\u0430\u0432
      \u0431\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0442\u043E\u0431\u0456
      \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A. \u0412\u0438\u043A\u043B\u0430\u0434\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824113
    m_Localized: "\u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0432\u0435\u0434\u0443\u0442\u044C \u0431\u043E\u0457 \u043E\u0434\u0438\u043D
      \u0437 \u043E\u0434\u043D\u0438\u043C. \u0417\u0430 \u043E\u0434\u043D\u0443
      \u0437\u0456 \u0441\u0442\u043E\u0440\u0456\u043D \u0432\u0438\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C
      \u0437\u0435\u0431\u0440\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443.
      \u041C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043E\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F
      \u043F\u0456\u0434 \u0437\u0430\u0433\u0440\u043E\u0437\u043E\u044E \u043D\u0430\u043F\u0430\u0434\u0443
      \u0437 \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u0431\u043E\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824114
    m_Localized: "\u041E\u0443. \u0426\u0435... \u041E\u0441\u044C \u044F\u043A \u043A\u043E\u043F\u0438\u0442\u043E\u043C
      \u043F\u043E\u043C\u0456\u0436 \u043E\u0447\u0435\u0439. \u042F\u043A \u0442\u0430\u043A-\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824115
    m_Localized: "\u0414\u043E\u0432\u0433\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044F.
      \u042F\u043A\u0449\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u043E: \u0457\u0445\u043D\u0456\u0439
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430 \u0434\u0443\u0436\u0435
      \u043B\u044E\u0431\u0438\u0432 \u043B\u0456\u0437\u0442\u0438 \u043A\u0443\u0434\u0438
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0430 \u0456 \u043D\u0430\u0436\u0438\u0432\u0430\u0442\u0438
      \u0441\u043E\u0431\u0456 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824116
    m_Localized: "\u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824117
    m_Localized: "\u0422\u0430\u043A, \u0432\u0456\u043D. \u0422\u0438 \u0439\u043E\u0433\u043E
      \u0437\u043D\u0430\u0454\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824118
    m_Localized: "\u0412\u0456\u0440\u043D\u043E, \u0437\u043D\u0430\u0432. \u0410\u043B\u0435
      \u043D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0440\u043E\u0437\u043C\u043E\u0432\u0443
      \u043F\u0440\u043E \u043C\u043E\u0454 \u043C\u0438\u043D\u0443\u043B\u0435
      \u043C\u0438 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043C\u043E. \u0429\u043E
      \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0456\u0434 \u043C\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824119
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F:
      \u0449\u043E \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0456\u0434 \u041C\u0415\u041D\u0415. \u0422\u0438 \u0432 \u043D\u0430\u0441
      \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u0435\u043A\u0441\u043F\u0435\u0440\u0442
      \u0437\u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u0432 \u043E\u043A\u0440\u0443\u0437\u0456, \u0442\u043E\u0431\u0456 \u043A\u0440\u0430\u0449\u0435
      \u0437\u043D\u0430\u0442\u0438, \u044F\u043A \u043D\u0430\u043C \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u043D\u0438\u0445. \u042F\u043A\u0449\u043E \u0442\u043E\u0431\u0456
      \u0431\u0443\u0434\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430
      - \u044F \u0433\u043E\u0442\u043E\u0432\u0430 \u0457\u0457 \u043D\u0430\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824120
    m_Localized: "\u041D\u0443, \u0442\u0430\u043A \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u043F\u0440\u044F\u043C\u043E \u0432\u0441\u044E \u0441\u0445\u0435\u043C\u0443
      \u043D\u0435 \u043D\u0430\u043C\u0430\u043B\u044E\u0454\u0448, \u0437\u0432\u0456\u0441\u043D\u043E.
      \u0410\u043B\u0435 \u0434\u0435\u044F\u043A\u0456 \u0434\u0443\u043C\u043A\u0438
      \u0449\u043E\u0434\u043E \u0446\u044C\u043E\u0433\u043E \u0454..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824121
    m_Localized: "\u0417\u0430\u0433\u0440\u043E\u0437\u0430 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824122
    m_Localized: "\u0420\u0430\u0434\u0438\u0439 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456,
      @lp. \u0404 \u043D\u043E\u0432\u0438\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824123
    m_Localized: "\u041D\u0430 \u0436\u0430\u043B\u044C, \u0442\u0430\u043A. \u041E\u0441\u0442\u0430\u043D\u043D\u0456\u043C\u0438
      \u0434\u043D\u044F\u043C\u0438 \u044F \u043E\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F
      \u0437\u0430\u043C\u0456\u0448\u0430\u043D\u0430 \u0443 \u0441\u043F\u0440\u0430\u0432\u0430\u0445,
      \u044F\u043A\u0456 \u0432\u043E\u043B\u0456\u043B\u0430 \u0431 \u043D\u0435
      \u0447\u0456\u043F\u0430\u0442\u0438. \u0406 \u044F \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F
      \u0431\u0430\u0433\u0430\u0442\u043E \u0442\u0440\u0438\u0432\u043E\u0436\u043D\u0438\u0445
      \u0440\u0435\u0447\u0435\u0439, \u044F\u043A\u0438\u043C\u0438 \u044F \u0437\u043E\u0431\u043E\u0432'\u044F\u0437\u0430\u043D\u0430
      \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F \u0437 \u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824124
    m_Localized: "\u0429\u043E\u0441\u044C \u0441\u0442\u0430\u043B\u043E\u0441\u044F
      \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824125
    m_Localized: "\u041D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438. \u0419\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E \u0437\u043D\u0430\u0447\u043D\u043E \u0431\u0456\u043B\u044C\u0448\u0435,
      \u043D\u0456\u0436 \u0441\u0442\u0430\u0440\u0456 \u0440\u0443\u0457\u043D\u0438.
      \u041C\u0435\u043D\u0456 \u0441\u0442\u0430\u043B\u043E \u0432\u0456\u0434\u043E\u043C\u043E,
      \u0449\u043E \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u0435 \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u0443\u043A\u043B\u0430\u043B\u043E \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0439
      \u0441\u043E\u044E\u0437 \u0456\u0437 \u041B\u0435\u0433\u0456\u043E\u043D\u043E\u043C
      \u0456 \u041A\u0435\u0441\u0430\u0440\u0456\u0454\u043C. \u041F\u0440\u0438\u0447\u0438\u043D\u0438
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0456, \u043F\u0440\u043E\u0442\u0435
      \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u043E\u043C \u0441\u0442\u0430\u0432
      \u0437\u0431\u0440\u043E\u0439\u043D\u0438\u0439 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442
      \u0443\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432. \u041D\u0430
      \u0434\u0430\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0432\u0456\u043D
      \u043D\u0430\u0431\u0438\u0440\u0430\u0454 \u0432\u0441\u0435 \u0431\u0456\u043B\u044C\u0448\u0438\u0445
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0456\u0432. \u0417 \u043E\u0433\u043B\u044F\u0434\u0443
      \u043D\u0430 \u0442\u0435, \u0449\u043E \u0431\u0430\u0433\u0430\u0442\u043E
      \u043E\u0431'\u0454\u043A\u0442\u0456\u0432, \u044F\u043A\u0456 \u0457\u0445
      \u0446\u0456\u043A\u0430\u0432\u043B\u044F\u0442\u044C, \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u0443 \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u0456\u0439 \u0431\u043B\u0438\u0437\u044C\u043A\u043E\u0441\u0442\u0456
      \u0432\u0456\u0434 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430,
      \u044F \u0431\u043E\u044E\u0441\u044F, \u043D\u0430\u0434 \u0432\u0430\u043C\u0438
      \u043D\u0430\u0432\u0438\u0441\u043B\u0430 \u0437\u0430\u0433\u0440\u043E\u0437\u0430.
      \u042F\u043A\u0449\u043E \u043D\u0435 \u0437 \u0431\u043E\u043A\u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, \u0442\u043E
      \u0437 \u0431\u043E\u043A\u0443 \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824126
    m_Localized: "\u0422\u0440\u0438\u0432\u043E\u0436\u043D\u0456 \u0437\u0432\u0456\u0441\u0442\u043A\u0438.
      \u0414\u0443\u0436\u0435 \u0442\u0440\u0438\u0432\u043E\u0436\u043D\u0456.
      \u0422\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430 \u0443 \u0441\u0432\u043E\u0457\u0445
      \u0441\u043B\u043E\u0432\u0430\u0445, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824127
    m_Localized: "\u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824128
    m_Localized: "\u0422\u043E\u0434\u0456 \u043C\u0438 \u0431\u0443\u0434\u0435\u043C\u043E
      \u0437\u043C\u0443\u0448\u0435\u043D\u0456 \u0437\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438
      \u0441\u0432\u043E\u0457 \u0437\u0443\u0441\u0438\u043B\u043B\u044F \u043D\u0430
      \u0440\u043E\u0437\u0432\u0456\u0434\u0446\u0456 \u0442\u0430 \u043F\u0430\u0442\u0440\u0443\u043B\u044E\u0432\u0430\u043D\u043D\u0456.
      \u0423 \u043D\u0430\u0441 \u0456 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E
      \u043C\u0430\u043B\u043E \u0437\u0435\u0431\u0440 \u043D\u0430 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043D\u043D\u0456,
      \u0430 \u043D\u043E\u0432\u0430 \u0437\u0430\u0433\u0440\u043E\u0437\u0430
      \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u044F\u0454 \u043D\u0430\u0441 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0442\u043E\u0433\u043E, \u0449\u043E \u043C\u0430\u0454\u043C\u043E. \u042F
      \u043F\u0440\u043E\u0432\u0435\u0434\u0443 \u0440\u0430\u0434\u0443 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F,
      \u0456 \u043C\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u043C\u043E, \u0449\u043E
      \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0434\u043B\u044F \u0441\u0432\u043E\u0433\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C
      \u043D\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0442\u0432\u043E\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430,
      @lp. \u042F\u043A\u0449\u043E \u0442\u0438 \u0431\u0443\u0434\u0435\u0448 \u0433\u043E\u0442\u043E\u0432\u0430
      \u0457\u0457 \u043D\u0430\u0434\u0430\u0442\u0438. \u041D\u0430\u043C \u043D\u0456\u0447\u0438\u043C
      \u0442\u043E\u0431\u0456 \u0432\u0456\u0434\u043F\u043B\u0430\u0442\u0438\u0442\u0438,
      \u0430\u043B\u0435 \u043A\u043E\u0436\u043D\u0435 \u043A\u043E\u043F\u0438\u0442\u043E
      \u0431\u0443\u0434\u0435 \u043D\u0430 \u0440\u0430\u0445\u0443\u043D\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824129
    m_Localized: "\u042F \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443 \u0432\u0430\u043C
      \u0447\u0438\u043C \u0437\u043C\u043E\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824130
    m_Localized: "\u041D\u0430 \u0440\u0430\u0434\u0456 \u0443\u0445\u0432\u0430\u043B\u044E\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0432\u043A\u0440\u0430\u0439 \u0432\u0430\u0436\u043B\u0438\u0432\u0456 \u0434\u043B\u044F
      \u043D\u0430\u0441 \u0440\u0456\u0448\u0435\u043D\u043D\u044F. \u041C\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0438\u0440\u0456\u0448\u0443\u0432\u0430\u0442\u0438
      \u0434\u043E\u043B\u044E \u0433\u0440\u043E\u043C\u0430\u0434\u0438 \u0431\u0435\u0437
      \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u043B\u044C\u043E\u0432\u0438\u0445
      \u043B\u0456\u0434\u0435\u0440\u0456\u0432, \u0430 \u0432\u043E\u043D\u0438
      \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044F
      \u0437 \u0432\u0438\u043B\u0430\u0437\u043E\u043A \u0437\u0430 \u0457\u0436\u0435\u044E
      \u0456 \u043B\u0456\u043A\u0430\u043C\u0438. \u042F \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044E
      \u0442\u043E\u0431\u0456, \u043A\u043E\u043B\u0438 \u0432\u043E\u043D\u0438
      \u043F\u0440\u0438\u0439\u0434\u0443\u0442\u044C \u0456 \u043C\u0438 \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0441\u044F
      \u0437 \u043D\u0430\u0448\u0438\u043C\u0438 \u043F\u043B\u0430\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824131
    m_Localized: "\u0421\u0442\u0435\u0436 \u0437\u0430 \u0441\u0432\u043E\u0457\u043C\u0438
      \u0440\u0435\u0447\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824132
    m_Localized: "\u0421\u0443\u0432\u043E\u0440\u0456 \u0447\u0430\u0441\u0438 \u043D\u0430\u0441\u0442\u0430\u044E\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824133
    m_Localized: "\u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u043C\u0443
      \u043F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824134
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442\u044C \u0442\u0430\u043A,
      \u044F\u043A\u0449\u043E \u0432\u0436\u0435 \u043D\u0430\u043C \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438\u0441\u044F \u0432\u0456\u0434
      \u0442\u0430\u043A\u043E\u0433\u043E \u0432\u043E\u0440\u043E\u0433\u0430,
      \u044F\u043A \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438...
      \u041D\u0430\u043C \u0442\u043E\u0447\u043D\u043E \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u0432\u0435\u043B\u0438\u043A\u0456 \u0433\u0430\u0440\u043C\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824135
    m_Localized: "\u0423 \u043C\u0435\u043D\u0435 \u0454 \u043A\u0456\u043B\u044C\u043A\u0430
      \u043D\u0430\u0434\u0456\u0439\u043D\u0438\u0445 \u0437\u0430\u0441\u043E\u0431\u0456\u0432..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824136
    m_Localized: "\u041D\u0456, @lp. \u0412\u0415\u041B\u0418\u041A\u0406. \u042F\u043A\u0449\u043E
      \u043C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0437\u0431\u0440\u043E\u0457\u043C\u043E\u0441\u044F
      \u0430\u043D\u0442\u0438\u043C\u0435\u0445-\u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430\u043C\u0438,
      \u043C\u0438 \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0432\u0435\u0441\u0442\u0438 \u0431\u0456\u0439 \u043F\u0440\u043E\u0442\u0438
      \u0432\u043E\u043B\u043E\u0434\u0430\u0440\u0456\u0432 \u0441\u0438\u043B\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456 \u043D\u0430 \u0440\u0456\u0432\u043D\u0438\u0445.
      \u0410\u043B\u0435 \u043F\u043E\u0432\u0456\u0440: \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u043D\u0435 \u0437 \u0442\u0438\u0445, \u0445\u0442\u043E \u043F\u043E\u0431\u043E\u044F\u0442\u044C\u0441\u044F
      \u0431\u043E\u044E \u043D\u0430 \u0440\u0456\u0432\u043D\u0438\u0445. \u0412\u043E\u043D\u0438
      \u043D\u0435 \u0437\u0443\u043F\u0438\u043D\u044F\u0442\u044C\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0437\u0430\u0445\u043E\u0447\u0443\u0442\u044C \u0440\u043E\u0437\u0442\u0440\u043E\u0449\u0438\u0442\u0438
      \u043D\u0430\u0441, \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E
      \u043C\u0438 \u043F\u0435\u0440\u0435\u043C\u043E\u0436\u0435\u043C\u043E,
      \u043C\u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043C\u043E \u0437\u0430
      \u0442\u0430\u043A\u0443 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0443 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824137
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u043C\u0443\u0441\u0438\u0442\u0438
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u044F\u043A\u0449\u043E \u043D\u0435 \u0437\u043B\u044F\u043A\u0430\u0442\u0438\u0441\u044F,
      \u0442\u043E \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u0432\u0456\u0434\u043A\u043B\u0430\u0441\u0442\u0438
      \u0448\u0442\u0443\u0440\u043C \u0442\u0430\u0431\u043E\u0440\u0443 \u0432
      \u0434\u043E\u0432\u0433\u0438\u0439 \u044F\u0449\u0438\u043A. \u0426\u0435
      \u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F, \u0442\u0456\u043B\u044C\u043A\u0438
      \u044F\u043A\u0449\u043E \u0446\u0456\u043D\u0430 \u043D\u0430\u043F\u0430\u0434\u0443
      \u043D\u0430 \u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u0433\u043E \u041F\u043E\u043D\u0456
      \u0431\u0443\u0434\u0435 \u043D\u0435\u043F\u043E\u043C\u0456\u0440\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824138
    m_Localized: "\u042F\u043A\u0449\u043E \u0447\u0435\u0441\u043D\u043E, \u044F
      \u043F\u043E\u043A\u0438 \u0449\u043E \u0441\u043B\u0430\u0431\u043E \u0443\u044F\u0432\u043B\u044F\u044E,
      \u044F\u043A \u0446\u0435 \u043C\u043E\u0436\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824139
    m_Localized: "\u041D\u0430\u0448\u0435 \u0449\u0430\u0441\u0442\u044F, \u0449\u043E
      \u042F \u0443\u044F\u0432\u043B\u044F\u044E \u0446\u0435 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0434\u043E\u0431\u0440\u0435. \u0421\u043B\u0443\u0445\u0430\u0439 \u0441\u044E\u0434\u0438.
      \u041A\u043E\u043B\u0438 \u044F \u0431\u0443\u0432 \u0443 \u043B\u0430\u0432\u0430\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, \u044F, \u044F\u043A
      \u0456 \u0431\u0430\u0433\u0430\u0442\u043E \u0445\u0442\u043E, \u043C\u0430\u0432
      \u0434\u043E\u0441\u0442\u0443\u043F \u0434\u043E \u0430\u0440\u0445\u0456\u0432\u0443.
      \u0423 \u043D\u0430\u0441 \u0431\u0443\u043B\u0430 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0430
      \u0441\u0445\u0435\u043C\u0430 \u0443\u0441\u0442\u0440\u043E\u044E \u0432\u0441\u044C\u043E\u0433\u043E
      \u043D\u0430\u0448\u043E\u0433\u043E \u0417\u0430\u0432\u043E\u0434\u0443.
      \u0417 \u043D\u0435\u0457 \u043C\u0438 \u0437\u043D\u0430\u043B\u0438, \u0449\u043E
      \u043D\u0430 \u043E\u0434\u043D\u043E\u043C\u0443 \u0437 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0445
      \u044F\u0440\u0443\u0441\u0456\u0432 \u0431\u0443\u043B\u0438 \u0440\u043E\u0437\u043C\u0456\u0449\u0435\u043D\u0456
      \u043A\u043E\u043D\u0432\u0435\u0454\u0440\u0438 \u0437 \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430
      \u0441\u0442\u0432\u043E\u043B\u044C\u043D\u0438\u0445 \u0433\u0430\u0440\u043C\u0430\u0442
      \u0456 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432 \u0434\u043E
      \u043D\u0438\u0445 \u0434\u043B\u044F \u0444\u043B\u043E\u0442\u0443. \u042F\u043A\u0449\u043E
      \u0431\u0443\u0442\u0438 \u0442\u043E\u0447\u043D\u0438\u043C, \u0434\u043B\u044F
      \u0435\u0441\u043C\u0456\u043D\u0446\u0456\u0432. \u041C\u0430\u043B\u0438\u0439
      \u043A\u0430\u043B\u0456\u0431\u0440 \u0434\u043B\u044F \u043A\u043E\u0440\u0430\u0431\u043B\u0456\u0432.
      \u0414\u043E\u0441\u0438\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u0434\u043B\u044F \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824140
    m_Localized: "\u041D\u0430\u043C, \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u043C
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C, \u0441\u043B\u0456\u0434
      \u0431\u0443\u043B\u043E \u0431 \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F
      \u043D\u0438\u043C\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043D\u043E,
      \u0442\u0430 \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0430
      \u041F\u0443\u0441\u0442\u0446\u0456 \u0434\u043B\u044F \u043D\u0438\u0445
      \u0437\u043D\u0430\u0439\u0448\u043B\u043E\u0441\u044F \u0431 \u0437\u0430\u043C\u0430\u043B\u043E,
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0443\u043B\u0438 \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0456
      \u0441\u043F\u0440\u0430\u0432\u0438. \u0422\u0435\u043F\u0435\u0440 \u0446\u0435
      \u0437\u0456\u0433\u0440\u0430\u0454 \u043D\u0430 \u043D\u0430\u0448\u0443
      \u043A\u043E\u0440\u0438\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824141
    m_Localized: "\u0406 \u043C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430
      \u0440\u043E\u0437\u0432\u0456\u0434\u0430\u0442\u0438 \u0446\u0456 \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0447\u0456
      \u043B\u0456\u043D\u0456\u0457?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824142
    m_Localized: "\u042F\u043A\u0449\u043E \u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 - \u0442\u0430\u043A.
      \u042F \u0432\u043A\u0430\u0436\u0443 \u0442\u043E\u0431\u0456 \u0442\u043E\u0447\u043D\u0435
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445
      \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u044C, \u0430 \u0442\u0438
      \u0441\u043F\u0443\u0441\u0442\u0438\u0448\u0441\u044F \u0432\u043D\u0438\u0437
      \u0456 \u0434\u0456\u0437\u043D\u0430\u0454\u0448\u0441\u044F, \u0447\u0438
      \u0454 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0430\u0445 \u0445\u043E\u0447\u0430
      \u0431 \u043F\u0430\u0440\u043E\u0447\u043A\u0430 \u0446\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C.
      \u0406 \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0441\u044F,
      \u0449\u043E \u043A\u043E\u043B\u0438 \u0442\u0443\u0434\u0438 \u043F\u0456\u0434\u0443\u0442\u044C
      \u043D\u0430\u0448\u0456 \u0442\u044F\u0433\u043B\u043E\u0432\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0438,
      \u0457\u0445 \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435
      \u0432\u043E\u0433\u043E\u043D\u044C \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0445
      \u0442\u0443\u0440\u0435\u043B\u0435\u0439. \u042F \u0437\u043D\u0430\u044E,
      \u0443 \u0442\u0435\u0431\u0435 \u0446\u0435 \u0434\u043E\u0431\u0440\u0435
      \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824143
    m_Localized: "\"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439 \u043F\u043E\u043D\u0456\"
      \u0432 \u0431\u0435\u0437\u043F\u0435\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824144
    m_Localized: "\u0423\u0441\u0435 \u043F\u0443\u0447\u043A\u043E\u043C, \u041E\u0443\u043A.
      \u0421\u043A\u043B\u0430\u0434\u0438 \u0432\u0441\u0435 \u0449\u0435 \u043F\u043E\u0432\u043D\u0456,
      \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u043E, \u0456 \u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u043D\u0456 \u0442\u0443\u0440\u0435\u043B\u0456 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u043A\u043E\u043C\u0443 \u0442\u0430\u043C \u043D\u0435 \u0437\u0430\u0448\u043A\u043E\u0434\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824145
    m_Localized: "\u0414\u0443\u0436\u0435 \u0434\u043E\u0431\u0440\u0435. \u0427\u0435\u0441\u043D\u043E
      \u043A\u0430\u0436\u0443\u0447\u0438, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0438\u0433\u043B\u044F\u0434\u0443
      \u0446\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C \u0431\u0443\u043B\u043E
      \u0431 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E, \u0449\u043E\u0431
      \u0437\u043C\u0443\u0441\u0438\u0442\u0438 \u0431\u0456\u0439\u0446\u0456\u0432
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430 \u0442\u0440\u0438\u0447\u0456
      \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0430\u043F\u0430\u0434\u043E\u043C \u043D\u0430 \u043D\u0430\u0441,
      \u0430\u043B\u0435 \u043C\u0430\u0442\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0431\u0443\u0434\u0435 \u0437\u0430\u0439\u0432\u0438\u043C.
      \u0423 \u043D\u0430\u0441 \u043D\u0435\u043C\u0430\u0454 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438 \u0457\u0445 \u043D\u0430
      \u0448\u0430\u0441\u0456 \u0442\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u0443, \u0430\u043B\u0435
      \u0441\u0442\u0430\u0442\u0438\u0447\u043D\u043E\u0457 \u043E\u0431\u043E\u0440\u043E\u043D\u0438
      \u0431\u0443\u0434\u0435 \u0431\u0456\u043B\u044C\u0448 \u043D\u0456\u0436
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E. \u0422\u0435\u043F\u0435\u0440
      \u043D\u0430 \u043D\u0430\u0441 \u0447\u0435\u043A\u0430\u0454 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u043E\u0431\u043E\u0442\u0438, \u0456 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0449\u043E \u043C\u0438 \u043D\u0435 \u0437\u0430\u043F\u0456\u0437\u043D\u0438\u043B\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824146
    m_Localized: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u044F\u043A\u0449\u043E
      \u0449\u043E\u0441\u044C \u043F\u0456\u0434\u0435 \u043D\u0435 \u0442\u0430\u043A,
      \u044F \u0456 \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430
      \u0431\u0443\u0434\u0435\u043C\u043E \u0434\u043E\u0441\u0438\u0442\u044C \u0431\u043B\u0438\u0437\u044C\u043A\u043E,
      \u0449\u043E\u0431 \u043F\u0440\u0438\u0439\u0442\u0438 \u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824147
    m_Localized: "\u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437? \u042F\u043A\u0449\u043E
      \u0432\u0456\u043D \u0441\u0442\u043E\u0457\u0442\u044C \u0432 \u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0443, \u0442\u043E \u043C\u043E\u0436\u043D\u0430
      \u043D\u0435 \u0441\u0443\u043C\u043D\u0456\u0432\u0430\u0442\u0438\u0441\u044F.
      \u0423 \u0446\u044C\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u043B\u0438\u0441\u0430 \u0441\u043A\u0440\u0456\u0437\u044C \u0432\u0443\u0445\u0430.
      \u0414\u0443\u0436\u0435 \u0434\u0430\u0440\u0435\u043C\u043D\u043E \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u0432\u0438\u0440\u0456\u0448\u0438\u0432 \u0432\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u0438
      \u043F\u0440\u043E\u0442\u0438 \u043D\u044C\u043E\u0433\u043E: \u0437\u0430
      \u0432\u0441\u0456\u0454\u0457 \u043F\u043E\u0432\u0430\u0433\u0438, \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430 \u0437 \u043C\u0430\u0439\u0436\u0435
      \u0434\u0432\u043E\u0445\u0441\u043E\u0442\u0440\u0456\u0447\u043D\u0438\u043C
      \u0434\u043E\u0441\u0432\u0456\u0434\u043E\u043C \u0432\u0456\u043D \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u0437\u043C\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824148
    m_Localized: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438-\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0441\u0432\u0456\u0434\u043E\u043C?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824149
    m_Localized: "\u0422\u0438 \u043D\u0435 \u0432 \u043A\u0443\u0440\u0441\u0456,
      \u0442\u0430\u043A? \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437 - \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0438\u0439
      \u0433\u0443\u043B\u044C. \u0412\u0456\u043D \u0431\u0438\u0432\u0441\u044F
      \u0449\u0435 \u0443 \u0412\u0435\u043B\u0438\u043A\u0456\u0439 \u0432\u0456\u0439\u043D\u0456.
      \u0422\u043E\u0431\u0456 \u0441\u043B\u0456\u0434 \u0431\u0443\u043B\u043E
      \u0440\u0430\u043D\u0456\u0448\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u0438
      \u043C\u0435\u043D\u0456, \u0449\u043E \u0432\u0456\u043D - \u043D\u0430\u0448
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A. \u0423 \u043D\u044C\u043E\u0433\u043E
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439 \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442
      \u0441\u0435\u0440\u0435\u0434 \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432.
      \u0406 \u0432\u0456\u043D, \u043D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430,
      \u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0434\u043E \u043F\u043E\u043D\u0456
      \u041F\u0443\u0441\u0442\u043A\u0438 \u0434\u043E\u0441\u0438\u0442\u044C \u0434\u043E\u0431\u0440\u043E\u0441\u0435\u0440\u0434\u043D\u043E.
      \u042F\u043A\u0449\u043E \u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439
      \u041F\u043E\u043D\u0456 \u0431\u0443\u0434\u0435 \u0434\u0456\u0439\u0441\u043D\u043E
      \u0432\u0442\u044F\u0433\u043D\u0443\u0442\u0438\u0439 \u0443 \u0432\u0456\u0439\u043D\u0443,
      \u043D\u0430\u043C \u0441\u043B\u0456\u0434 \u0434\u043E\u043A\u043B\u0430\u0441\u0442\u0438
      \u0437\u0443\u0441\u0438\u043B\u044C \u0437\u0456 \u0441\u0432\u043E\u0433\u043E
      \u0431\u043E\u043A\u0443, \u0449\u043E\u0431 \u0437\u0430\u0440\u0443\u0447\u0438\u0442\u0438\u0441\u044F
      \u0439\u043E\u0433\u043E \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824150
    m_Localized: "\u041D\u0435 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043B\u0430
      \u044F \u0442\u0430\u043A\u043E\u0433\u043E, \u0437\u0432\u0456\u0441\u043D\u043E.
      \u0410\u043B\u0435 \u0442\u0438 \u043C\u0430\u0454\u0448 \u0440\u0430\u0446\u0456\u044E:
      \u044F\u043A\u0449\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0438 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u0438\u043C\u0443\u0442\u044C \u043D\u0430
      \u043C\u0438\u0440\u043D\u0456 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F,
      \u0432\u0456\u043D \u0432\u0442\u0440\u0443\u0442\u0438\u0442\u044C\u0441\u044F.
      \u041F\u0440\u0430\u0432\u0434\u0443 \u043A\u0430\u0436\u0443\u0447\u0438,
      \u0449\u043E\u043D\u0430\u0439\u043C\u0435\u043D\u0448\u0435 \u0449\u0435 \u043E\u0434\u043D\u0435
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F \u0442\u043E\u0447\u043D\u043E
      \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438.
      \u042F\u043A\u0449\u043E \u044F \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430, \u044F \u043A\u0440\u0430\u0449\u0435
      \u043F\u043E\u0441\u043F\u0456\u0448\u0443 \u0434\u043E \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824151
    m_Localized: "\u041D\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u0454\u0448 \u0434\u0430\u0440\u0435\u043C\u043D\u043E
      \u0447\u0430\u0441\u0443, \u0442\u0430\u043A? \u0417\u0432\u0456\u0441\u043D\u043E,
      \u0439\u0434\u0438. \u041C\u0438 \u0432\u0436\u0435 \u0441\u0430\u043C\u0456
      \u0442\u0443\u0442 \u0443\u043F\u043E\u0440\u0430\u0454\u043C\u043E\u0441\u044F.
      \u042F\u043A\u0449\u043E \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435\u0448
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430, \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0439
      \u0439\u043E\u043C\u0443 \u0432\u0456\u0434 \u043C\u0435\u043D\u0435 \u043F\u0440\u0438\u0432\u0456\u0442.
      \u0406 \u0434\u044F\u043A\u0443\u044E, \u0449\u043E \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043B\u0430
      \u043F\u0440\u043E \u043D\u044C\u043E\u0433\u043E. \u041C\u0430\u0431\u0443\u0442\u044C,
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430 \u043D\u043E\u0432\u0438\u043D\u0430
      \u0434\u043B\u044F \u043D\u0430\u0441 \u0437\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824152
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u043D\u044F,
      @lp. \u0422\u0438 \u0432\u0447\u0430\u0441\u043D\u043E: \u0443\u0441\u0456
      \u0447\u043B\u0435\u043D\u0438 \u043D\u0430\u0448\u043E\u0457 \u0440\u0430\u0434\u0438
      \u0432\u0436\u0435 \u043F\u0440\u0438\u0431\u0443\u043B\u0438 \u0437 \u0435\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0456\u0439.
      \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0432\u0435\u0447\u0435\u0440\u0456
      \u043C\u0438 \u0437\u0431\u0435\u0440\u0435\u043C\u043E\u0441\u044F \u0434\u043B\u044F
      \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u043D\u0430\u0448\u0438\u0445
      \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0438\u0445 \u0434\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824153
    m_Localized: "\u0426\u0435 \u0434\u043E\u0431\u0440\u0435. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824154
    m_Localized: "\u0420\u0430\u0434\u0430 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824155
    m_Localized: "\u041C\u0438 \u0432\u0441\u0456 \u0437\u043D\u0430\u0454\u043C\u043E,
      \u043D\u0430\u0432\u0456\u0449\u043E \u043C\u0438 \u0442\u0443\u0442. \u041D\u0435
      \u0431\u0443\u0434\u0435\u043C\u043E \u0442\u044F\u0433\u043D\u0443\u0442\u0438
      \u0447\u0430\u0441: @lp, \u043F\u043E\u0432\u0456\u0434\u0430\u0439 \u043D\u0430\u043C
      \u0443 \u0432\u0441\u0456\u0445 \u043F\u043E\u0434\u0440\u043E\u0431\u0438\u0446\u044F\u0445,
      \u0449\u043E \u0437\u0430 \u0437\u0430\u0433\u0440\u043E\u0437\u0430 \u043D\u0430\u0432\u0438\u0441\u043B\u0430
      \u043D\u0430\u0434 \u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824156
    m_Localized: "\u041C\u0435\u043D\u0456 \u043D\u0456\u0447\u043E\u0433\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0434\u043E\u0434\u0430\u0442\u0438 \u0434\u043E \u0442\u043E\u0433\u043E,
      \u0449\u043E \u044F \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0440\u0430\u043D\u0456\u0448\u0435.
      \u041B\u0435\u0433\u0456\u043E\u043D \u0456 \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u0435
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0443\u043A\u043B\u0430\u043B\u0438
      \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0439 \u0441\u043E\u044E\u0437.
      \u041D\u0430\u0432\u0456\u0449\u043E \u0456 \u043F\u0440\u043E\u0442\u0438
      \u043A\u043E\u0433\u043E - \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E.
      \u041E\u0434\u043D\u0430\u043A \u0432\u043E\u043D\u0438 \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043B\u0438
      \u043D\u0430\u043F\u0430\u0434 \u043D\u0430... \u043D\u0430 \u043C\u0456\u0439
      \u0434\u0456\u043C. \u0406 \u0446\u0435\u0439 \u0441\u043E\u044E\u0437 \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0432
      \u0440\u043E\u0437\u043A\u043E\u043B \u0443 \u043B\u0430\u0432\u0430\u0445
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0440\u0430\u0437 \u043C\u0456\u0436 \u043D\u0438\u043C\u0438
      \u0440\u043E\u0437\u0433\u043E\u0440\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0439
      \u0437\u0431\u0440\u043E\u0439\u043D\u0438\u0439 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442,
      \u044F\u043A\u0438\u0439 \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F \u0456\u043D\u0430\u043A\u0448\u0435,
      \u043E\u043A\u0440\u0456\u043C \u044F\u043A \u043F\u043E\u0432\u043D\u043E\u044E
      \u043F\u043E\u0440\u0430\u0437\u043A\u043E\u044E \u043E\u0434\u043D\u0456\u0454\u0457
      \u0437\u0456 \u0441\u0442\u043E\u0440\u0456\u043D. \u041D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435
      \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E \u0442\u0456
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438, \u044F\u043A\u0456
      \u0443\u043A\u043B\u0430\u043B\u0438 \u0441\u043E\u044E\u0437 \u0456\u0437
      \u041B\u0435\u0433\u0456\u043E\u043D\u043E\u043C, \u043F\u043E\u043F\u0440\u043E\u0441\u044F\u0442\u044C
      \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438 \u0437 \u0431\u043E\u043A\u0443
      \u043D\u043E\u0432\u0438\u0445 \u0434\u0440\u0443\u0437\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824157
    m_Localized: "\u042F\u043A \u0446\u0435 \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824158
    m_Localized: "\u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u044F \u043C\u043E\u0436\u0443
      \u0441\u0443\u0434\u0438\u0442\u0438, \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u0437\u0432\u0438\u043A\u043B\u0438 \u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0437\u0438\u0446\u0456\u0439\u043D\u0443
      \u0432\u0456\u0439\u043D\u0443. \u0412\u043E\u043D\u0438 \u0431\u0438\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0432\u0430\u0436\u043B\u0438\u0432\u0456 \u0431\u0430\u0437\u0438
      \u0456 \u0441\u043A\u043B\u0430\u0434\u0438, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0437\u0430 \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044E \u043D\u0430\u0432\u043A\u043E\u043B\u043E
      \u043D\u0438\u0445. \u041E\u0434\u043D\u0430 \u0437 \u0431\u0430\u0437 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0430
      \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u043E \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
      \u0437\u0432\u0456\u0434\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824159
    m_Localized: "\u0406 \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454
      \u0440\u0438\u0437\u0438\u043A \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E\u0433\u043E
      \u0437\u0456\u0442\u043A\u043D\u0435\u043D\u043D\u044F \u0437 \u043D\u0430\u0448\u0438\u043C\u0438
      \u0437\u0430\u0433\u043E\u043D\u0430\u043C\u0438 \u0430\u0431\u043E \u043D\u0430\u0432\u0456\u0442\u044C
      \u043F\u0440\u0438\u0442\u0443\u043B\u043A\u043E\u043C. \u042F\u043A\u0449\u043E
      \u0437 \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438 \u043C\u0438
      \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438 \u043C\u0438\u0440\u043D\u0438\u043C
      \u0448\u043B\u044F\u0445\u043E\u043C, \u0442\u043E \u041B\u0435\u0433\u0456\u043E\u043D
      \u0431\u0435\u0437 \u0440\u043E\u0437\u043C\u043E\u0432 \u043A\u0438\u043D\u0435
      \u0441\u0438\u043B\u0438 \u043D\u0430 \u043D\u0430\u0448\u0443 \u0437\u0430\u0447\u0438\u0441\u0442\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824160
    m_Localized: "\u0426\u044F \u0432\u0456\u0439\u043D\u0430 \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0442\u0440\u0438\u0432\u0430\u0442\u0438\u043C\u0435 \u0434\u043E\u0432\u0433\u043E.
      \u042F\u043A\u0449\u043E \u043C\u0438 \u0437\u0431\u0435\u0440\u0435\u043C\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432
      \u0456 \u043F\u0456\u0434\u0435\u043C\u043E \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447
      \u043D\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u043C\u0456\u0441\u044F\u0446\u0456\u0432,
      \u043C\u0438 \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u043F\u0435\u0440\u0435\u0447\u0435\u043A\u0430\u0442\u0438
      \u0446\u044E \u0431\u0443\u0440\u044E, \u0456 \u043F\u043E\u0442\u0456\u043C
      \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043C\u043E\u0441\u044F \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824161
    m_Localized: "\u041F\u043E\u0447\u0435\u043A\u0430\u0439, \u0441\u0443\u0434\u0438\u0442\u0438
      \u0449\u0435 \u0440\u0430\u043D\u043E. @lp, \u0437\u0432\u0456\u0434\u043A\u0438
      \u0442\u043E\u0431\u0456 \u0432\u0441\u0435 \u0446\u0435 \u0432\u0456\u0434\u043E\u043C\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824162
    m_Localized: "\u042F \u044F\u043A\u0440\u0430\u0437 \u0445\u043E\u0442\u0456\u043B\u0430
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u0446\u0435.
      \u041F\u043E-\u043F\u0435\u0440\u0448\u0435, \u044F \u0437\u043D\u0430\u0439\u043E\u043C\u0430
      \u0437 \u043B\u0456\u0434\u0435\u0440\u043E\u043C \u043E\u0434\u043D\u0456\u0454\u0457
      \u0437\u0456 \u0441\u0442\u043E\u0440\u0456\u043D \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0443.
      \u0422\u0456\u0454\u0457, \u0449\u043E \u043F\u0440\u043E\u0442\u0438 \u0434\u0440\u0443\u0436\u0431\u0438
      \u0437 \u041B\u0435\u0433\u0456\u043E\u043D\u043E\u043C. \u041F\u043E-\u0434\u0440\u0443\u0433\u0435...
      \u0443 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456 \u044F
      \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0447
      \u0437 \u043E\u0434\u043D\u0456\u0454\u044E \u0447\u0430\u043A\u043B\u0443\u043D\u043A\u043E\u044E
      \u0437 \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u0407\u0457 \u0437\u0432\u0430\u043B\u0438
      \u041C\u0447\u0430\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824163
    m_Localized: "\u0426\u0435 \u043F\u043E\u0433\u0430\u043D\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824164
    m_Localized: "\u042F\u043A\u0449\u043E \u041B\u0435\u0433\u0456\u043E\u043D \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0432
      \u0443 \u0446\u0435\u0439 \u0440\u0435\u0433\u0456\u043E\u043D \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0456\u0432,
      \u043C\u0438 \u0432\u0436\u0435 \u043F\u0456\u0434 \u0437\u0430\u0433\u0440\u043E\u0437\u043E\u044E.
      \u0411\u0430\u0433\u0430\u0442\u043E \u0437 \u043D\u0438\u0445 \u043C\u0430\u044E\u0442\u044C
      \u0434\u0430\u0440 \u043F\u0440\u043E\u0432\u0438\u0434\u0456\u043D\u043D\u044F.
      \u041D\u0430\u0448\u0435 \u0432\u0438\u044F\u0432\u043B\u0435\u043D\u043D\u044F
      \u0442\u0435\u043F\u0435\u0440 - \u0441\u043F\u0440\u0430\u0432\u0430 \u0447\u0430\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824165
    m_Localized: "... \u0406 \u043D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E
      \u0437\u0430\u0440\u0430\u0437 \u043C\u0438 \u043F\u0456\u0434\u0435\u043C\u043E
      \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447, \u043C\u0438 \u043D\u0435
      \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u043D\u0430\u0437\u0430\u0434, \u044F\u043A\u0449\u043E \u041B\u0435\u0433\u0456\u043E\u043D
      \u043F\u0435\u0440\u0435\u043C\u043E\u0436\u0435. \u0420\u0430\u0437 \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0438
      \u0442\u0443\u0442, \u0437\u043D\u0430\u0447\u0438\u0442\u044C \u041A\u0435\u0441\u0430\u0440\u0456\u0439
      \u0445\u043E\u0447\u0435 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0432 \u0446\u0438\u0445 \u043A\u0440\u0430\u044F\u0445 \u043D\u0430\u0434\u043E\u0432\u0433\u043E.
      \u041C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438.
      \u0417\u0430\u0440\u0430\u0437 \u0436\u0435, \u043F\u043E\u043A\u0438 \u043D\u0430\u0441
      \u043D\u0435 \u0432\u0438\u044F\u0432\u0438\u043B\u0438. \u0423 \u043D\u0430\u0441
      \u0454 \u0431\u0456\u0439\u0446\u0456, \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443
      \u0431\u043E\u0446\u0456 \u0440\u0430\u043F\u0442\u043E\u0432\u0456\u0441\u0442\u044C.
      \u041C\u0435\u043D\u0456 \u043D\u0430\u0431\u0440\u0438\u0434\u043B\u043E \u0432\u0436\u0435
      \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F! \u0412\u0434\u0430\u0440\u0438\u043C\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430, \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0454\u043C\u043E\u0441\u044F
      \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C, \u0456 \u043D\u0435\u0445\u0430\u0439
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u0439\u043E\u0433\u043E
      \u0434\u043E\u0431'\u044E\u0442\u044C! \u0414\u043E\u0441\u0438\u0442\u044C
      \u043D\u0430\u043C \u0442\u0456\u043A\u0430\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824166
    m_Localized: "... \u0434\u0443\u0440\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824167
    m_Localized: "\u0426\u0435 \u0441\u0430\u043C\u043E\u0433\u0443\u0431\u0441\u0442\u0432\u043E,
      \u041C\u0432\u0456\u043C\u0431\u0430\u0434\u0436\u0456. \u041D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u043A\u0430
      \u0431\u0443\u0434\u0435 \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443
      \u0431\u043E\u0446\u0456 \u043B\u0438\u0448\u0435 \u043E\u0434\u0438\u043D
      \u0440\u0430\u0437. \u0429\u043E\u0439\u043D\u043E \u041B\u0435\u0433\u0456\u043E\u043D
      \u0434\u0456\u0437\u043D\u0430\u0454\u0442\u044C\u0441\u044F \u043F\u0440\u043E
      \u043D\u0430\u0441, \u043C\u0438 \u043F\u0440\u0438\u0440\u0435\u0447\u0435\u043D\u0456.
      \u041D\u0430\u0441 \u0432\u0438\u0441\u0442\u0435\u0436\u0430\u0442\u044C \u0456
      \u043F\u0435\u0440\u0435\u0440\u0456\u0436\u0443\u0442\u044C, \u0440\u0430\u043D\u043E
      \u0447\u0438 \u043F\u0456\u0437\u043D\u043E. \u041C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u0437\u043D\u0430\u0454\u043C\u043E \u0442\u043E\u0447\u043D\u043E\u0433\u043E
      \u0441\u043F\u0456\u0432\u0432\u0456\u0434\u043D\u043E\u0448\u0435\u043D\u043D\u044F
      \u0441\u0438\u043B \u0443 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0456.
      \u041F\u043E\u043A\u0438 \u0449\u043E \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044F
      \u041C\u0448\u0430\u0443\u0440\u0456 \u0437\u0432\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0439\u043B\u043E\u0433\u0456\u0447\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824168
    m_Localized: "\u0410 \u044F\u043A\u0449\u043E \u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443
      \u0432\u0430\u043C? \u041D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E
      \u041B\u0435\u0433\u0456\u043E\u043D \u0434\u0456\u0437\u043D\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0445\u0442\u043E \u043D\u0430\u043F\u0430\u0432 \u043D\u0430 \u043D\u0438\u0445,
      \u044F - \u0432\u0441\u044C\u043E\u0433\u043E \u043B\u0438\u0448\u0435 \u043F\u043E\u043D\u0456,
      \u0456 \u043C\u043E\u0457 \u0434\u0456\u0457 \u043D\u0456\u044F\u043A \u043D\u0435
      \u0432\u0438\u0434\u0430\u0434\u0443\u0442\u044C \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824169
    m_Localized: "\u041F\u043E\u043E\u0434\u0438\u043D\u0446\u0456 \u0446\u0435 \u0431\u0443\u0434\u0435
      \u0441\u043A\u043B\u0430\u0434\u043D\u043E. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0442\u043E\u0447\u043D\u043E \u0437\u043D\u0430\u0442\u0438, \u043A\u0443\u0434\u0438
      \u0432\u0434\u0430\u0440\u0438\u0442\u0438. \u0406 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u0440\u0430\u0437\u0456 \u0448\u0430\u043D\u0441\u0438
      \u043D\u0430 \u0443\u0441\u043F\u0456\u0445 \u043D\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0432\u0438\u0441\u043E\u043A\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824170
    m_Localized: "\u0410\u043B\u0435 \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0443\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u044C \u043D\u0430\u0441.
      \u041D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E \u0446\u044F
      \u043F\u043E\u043D\u0456 \u0437\u0430\u0437\u043D\u0430\u0454 \u043D\u0435\u0432\u0434\u0430\u0447\u0456,
      \u041B\u0435\u0433\u0456\u043E\u043D \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438
      \u0431\u0440\u0430\u0442\u0438\u043C\u0435 \u0457\u0457 \u0436\u0438\u0432\u043E\u044E.
      \u0426\u0435 \u043D\u0435 \u0432 \u0439\u043E\u0433\u043E \u0441\u0442\u0438\u043B\u0456.
      \u0410\u043B\u0435 \u043C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0442\u0438\u0441\u044F \u043D\u0430
      \u0443\u0441\u043F\u0456\u0445. \u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u043C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u043F\u043E\u0447\u0430\u0442\u0438 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443
      \u0434\u043E \u0432\u0456\u0434\u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824171
    m_Localized: "\"\u041D\u0435 \u0432 \u0439\u043E\u0433\u043E \u0441\u0442\u0438\u043B\u0456\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824172
    m_Localized: "\u041F\u043E\u043F\u0440\u0438 \u0432\u0441\u0456 \u0441\u0432\u043E\u0457
      \u043D\u0435\u0434\u043E\u043B\u0456\u043A\u0438, \u041B\u0435\u0433\u0456\u043E\u043D
      \u043D\u0435 \u0441\u043F\u0440\u0438\u0439\u043C\u0430\u0454 \u0442\u043E\u0440\u0442\u0443\u0440
      \u0442\u0438\u0445, \u0445\u0442\u043E \u0434\u043E\u0441\u0438\u0442\u044C
      \u0445\u043E\u0440\u043E\u0431\u0440\u0438\u0439 \u0434\u043B\u044F \u0432\u0456\u0439\u043D\u0438
      \u0437 \u043D\u0438\u043C. \u0426\u0435 \u0434\u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u044F
      \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u044F, \u0441\u0432\u043E\u0433\u043E
      \u0440\u043E\u0434\u0443 \u0434\u0430\u043D\u0438\u043D\u0430 \u043F\u043E\u0432\u0430\u0433\u0438:
      \u0432\u0456\u0434\u0432\u0430\u0436\u043D\u0438\u0439 \u0432\u043E\u0440\u043E\u0433
      \u043F\u043E\u0432\u0438\u043D\u0435\u043D \u043F\u043E\u043C\u0435\u0440\u0442\u0438
      \u043D\u0430 \u043F\u043E\u043B\u0456 \u0431\u043E\u044E, \u0430 \u043D\u0435
      \u0432 \u043B\u0430\u043D\u0446\u044E\u0433\u0430\u0445. \u041D\u0430\u0432\u0456\u0442\u044C
      \u043F\u043E\u043D\u0456. \u0411\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u043E...
      \u0456 \u043D\u0435\u0440\u0430\u0446\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824173
    m_Localized: "\u0417\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F
      \u0441\u0443\u0449\u0430 \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u044F -
      \u043F\u043E\u043C\u0435\u0440\u0442\u0438 \u0432\u0456\u0434\u0432\u0430\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824174
    m_Localized: "... \u0412\u0456\u0434\u0434\u0430\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443
      \u0442\u043E\u043C\u0443, \u0449\u043E\u0431 \u043D\u0435 \u0432\u043C\u0438\u0440\u0430\u0442\u0438
      \u0437\u043E\u0432\u0441\u0456\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824175
    m_Localized: "\u041F\u0440\u043E\u0442\u0435 \u043C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0442\u043E\u0431\u0456 \u0441\u043A\u0430\u0437\u0430\u0442\u0438, \u0434\u0435
      \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0430\u0433\u0435\u043D\u0442\u0456\u0432 \u041B\u0435\u0433\u0456\u043E\u043D\u0443.
      \u0406 \u0448\u0443\u043A\u0430\u0442\u0438 \u043C\u0438 \u0457\u0445 \u0442\u0430\u043A\u043E\u0436
      \u043D\u0435 \u0431\u0443\u0434\u0435\u043C\u043E. \u0420\u0438\u0437\u0438\u043A
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0439.
      \u041F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u0434\u043E \u0432\u0456\u0434\u0445\u043E\u0434\u0443
      \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447 \u0437\u0430\u0439\u043C\u0435
      \u0447\u0438\u043C\u0430\u043B\u043E \u0447\u0430\u0441\u0443. \u042F\u043A\u0449\u043E
      \u0442\u0438 \u0432\u043F\u043E\u0440\u0430\u0454\u0448\u0441\u044F \u0456
      \u0437\u043C\u043E\u0436\u0435\u0448 \u044F\u043A\u0438\u043C\u043E\u0441\u044C
      \u0447\u0438\u043D\u043E\u043C \u0443\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
      \u043D\u0430\u0441 \u0437\u0430 \u0446\u0435\u0439 \u0447\u0430\u0441 - \u043C\u0438
      \u0431\u0443\u0434\u0435\u043C\u043E \u0432\u0434\u044F\u0447\u043D\u0456 \u0442\u043E\u0431\u0456.
      \u0410\u043B\u0435 \u0447\u0435\u043A\u0430\u0442\u0438 \u043C\u0438 \u043D\u0435
      \u043C\u043E\u0436\u0435\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824176
    m_Localized: "\u041C\u0430\u0431\u0443\u0442\u044C, \u044F \u0437\u043D\u0430\u044E,
      \u0445\u0442\u043E \u0437\u043C\u043E\u0436\u0435 \u043C\u0435\u043D\u0456
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824177
    m_Localized: "\u0425\u0430\u0439 \u0431\u0443\u0434\u0435 \u0442\u0430\u043A.
      @lp, \u043C\u0438 \u0432\u0441\u0456 \u0432\u043A\u0440\u0430\u0439 \u0432\u0434\u044F\u0447\u043D\u0456
      \u0442\u043E\u0431\u0456 \u0437\u0430 \u0440\u0456\u0448\u0443\u0447\u0456\u0441\u0442\u044C
      \u0456 \u043F\u0440\u043E\u0441\u0442\u044F\u0433\u043D\u0443\u0442\u0435 \u043A\u043E\u043F\u0438\u0442\u043E
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438. \u041C\u0438 \u043D\u0435
      \u0437\u0430\u0441\u0443\u0434\u0438\u043C\u043E \u0442\u0435\u0431\u0435,
      \u044F\u043A\u0449\u043E \u0442\u0438 \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0448\u0441\u044F
      \u0432\u0456\u0434 \u0441\u0432\u043E\u0457\u0445 \u043F\u043B\u0430\u043D\u0456\u0432,
      \u0430 \u044F\u043A\u0449\u043E \u043D\u0456, \u043F\u0430\u043C'\u044F\u0442\u0430\u0439,
      \u0449\u043E \u043A\u0440\u0430\u0449\u0435 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F, \u043D\u0435 \u0434\u043E\u0441\u044F\u0433\u043D\u0443\u0432\u0448\u0438
      \u043C\u0435\u0442\u0438, \u043D\u0456\u0436 \u0437\u0430\u0433\u0438\u043D\u0443\u0442\u0438,
      \u0431\u043E \u0442\u0432\u043E\u044F \u0441\u043C\u0435\u0440\u0442\u044C
      \u0431\u0443\u0434\u0435 \u043B\u0438\u0448\u0435 \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u043E\u044E
      \u0432\u0442\u0440\u0430\u0442\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824178
    m_Localized: "\u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824179
    m_Localized: "\u0417\u0434\u0440\u0430\u0441\u0442\u0443\u0439, \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0435.
      \u0423 \u043C\u0435\u043D\u0435 \u0434\u043E \u0442\u0435\u0431\u0435 \u0441\u043F\u0440\u0430\u0432\u0430,
      \u044F\u043A\u0430, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u0438\u0433\u0456\u0434\u043D\u0430
      \u043D\u0430\u043C \u043E\u0431\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824180
    m_Localized: "\u042F \u0441\u043B\u0443\u0445\u0430\u044E, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824181
    m_Localized: "\u0422\u0432\u043E\u0457 \u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0438
      \u0437\u043D\u0430\u044E\u0442\u044C \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u0440\u043E \u0434\u0456\u0457 \u041B\u0435\u0433\u0456\u043E\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824182
    m_Localized: "\u0422\u0456\u043B\u044C\u043A\u0438 \u0442\u0435, \u0449\u043E
      \u0432\u0456\u0434\u043E\u043C\u043E \u043F\u043E\u0441\u043B\u0456\u0434\u043E\u0432\u043D\u0438\u043A\u0430\u043C
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430. \u041C\u043E\u0457
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0438 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u044E\u0442\u044C
      \u043C\u0435\u043D\u0456 \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E,
      \u043E\u0434\u043D\u0430\u043A \u043D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u0441\u044F
      \u0432\u0438\u044F\u0432\u0438\u0442\u0438 \u0437\u0435\u0431\u0440 \u043F\u0430\u0442\u0440\u0443\u043B\u044F\u043C\u0438
      - \u043D\u0430\u0434\u0442\u043E \u043D\u0435\u0440\u0430\u0446\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u043E.
      \u041D\u0430 \u0434\u0430\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u041B\u0435\u0433\u0456\u043E\u043D \u0437\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u0432
      \u0441\u0432\u043E\u0457 \u0441\u0438\u043B\u0438 \u043D\u0430 \u043D\u0430\u0434\u0430\u043D\u043D\u0456
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438 \u043C\u043E\u0457\u043C \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u043C
      \u043F\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0430\u043C. \u0412\u0456\u043D
      \u0434\u043E\u0441\u0438\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0438\u0439
      \u0434\u043B\u044F \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E\u0433\u043E
      \u0431\u043E\u044E, \u0430\u043B\u0435 \u0432\u0432\u0430\u0436\u0430\u0454
      \u0437\u0430 \u043A\u0440\u0430\u0449\u0435 \u0441\u043A\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0434\u0456\u0457 \u043C\u043E\u0457\u0445 \u0441\u0438\u043B \u0434\u0438\u0432\u0435\u0440\u0441\u0456\u044F\u043C\u0438
      \u0456 \u0437\u0430\u0441\u0456\u0434\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824183
    m_Localized: "\u042F\u043A\u0456\u0441\u044C \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456
      \u043C\u0456\u0441\u0446\u044F \u0432 \u0457\u0445\u043D\u0456\u0439 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457
      \u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824184
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438.
      \u041C\u0430\u0431\u0443\u0442\u044C, \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F
      \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u043F\u043E\u043B\u044C\u043E\u0432\u043E\u0433\u043E
      \u0448\u0442\u0430\u0431\u0443 \u0432 \u0446\u044C\u043E\u043C\u0443 \u0440\u0435\u0433\u0456\u043E\u043D\u0456
      \u043C\u043E\u0433\u043B\u043E \u0431 \u0432\u043D\u0435\u0441\u0442\u0438
      \u043F\u043B\u0443\u0442\u0430\u043D\u0438\u043D\u0443 \u0432 \u0457\u0445\u043D\u0456
      \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0457 \u0456 \u0437\u043C\u0443\u0441\u0438\u0442\u0438
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u0437\u0433\u043E\u0440\u043D\u0443\u0442\u0438
      \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C. \u041E\u0434\u043D\u0430\u043A
      \u0437\u0435\u0431\u0440\u0438 \u043F\u0438\u043B\u044C\u043D\u043E \u0441\u0442\u0435\u0436\u0430\u0442\u044C
      \u0437\u0430 \u043A\u043E\u0436\u043D\u0438\u043C \u043A\u0440\u043E\u043A\u043E\u043C
      \u043C\u043E\u0457\u0445 \u0431\u0456\u0439\u0446\u0456\u0432, \u0456 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043A\u0430
      \u0432\u0438\u043D\u0438\u0449\u0443\u0432\u0430\u043B\u044C\u043D\u043E\u0457
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438 \u043C\u043E\u0436\u0435 \u043E\u0431\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u043A\u0440\u0430\u0445\u043E\u043C. \u0410\u0431\u043E \u0436 \u0432\u043E\u043D\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u043A\u0443\u044E\u0442\u044C
      \u0439\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824185
    m_Localized: "\u0422\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A \u0440\u043E\u0437\u043F\u0438\u0442\u0443\u0454\u0448 \u043C\u0435\u043D\u0435,
      \u0432\u0456\u0440\u043D\u043E? \u042F\u043A\u0449\u043E \u0442\u0438 \u043C\u0430\u0454\u0448
      \u043D\u0430\u043C\u0456\u0440 \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0442\u0438
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0435\u0431\u0440,
      \u044F \u043C\u043E\u0436\u0443 \u0432\u043A\u0430\u0437\u0430\u0442\u0438
      \u0442\u043E\u0431\u0456 \u0439\u043E\u0433\u043E \u043F\u043E\u0442\u043E\u0447\u043D\u0435
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F. \u041B\u0456\u043A\u0432\u0456\u0434\u0430\u0446\u0456\u044F
      \u043F\u043E\u043B\u044C\u043E\u0432\u043E\u0433\u043E \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u0430
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0454
      \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u0439 \u043F\u0440\u043E\u0441\u0442\u0456\u0440
      \u0434\u043B\u044F \u043D\u0430\u0448\u043E\u0433\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u0443,
      \u0430 \u0442\u0432\u043E\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u0432\u0435\u0434\u0435\u043D\u043D\u044F \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0445
      \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439 \u0434\u0430\u044E\u0442\u044C
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0456 \u0448\u0430\u043D\u0441\u0438
      \u043D\u0430 \u0443\u0441\u043F\u0456\u0445. \u0420\u043E\u0437\u0443\u043C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824186
    m_Localized: "\u0414\u044F\u043A\u0443\u044E. \u0422\u0430\u043A, \u044F \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u044E
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0456\u0432 \u041B\u0435\u0433\u0456\u043E\u043D\u0443
      \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C. \u0414\u043E \u0440\u0435\u0447\u0456,
      \u0442\u043E\u0431\u0456 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0432
      \u043F\u0440\u0438\u0432\u0456\u0442 \u043E\u0434\u0438\u043D \u043F\u043E\u043D\u0456.
      \u041E\u0443\u043A \u0421\u0442\u0430\u043B\u0432\u043E\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824187
    m_Localized: "\u041E\u0443\u043A? \u042F \u043F\u0430\u043C'\u044F\u0442\u0430\u044E
      \u0439\u043E\u0433\u043E. \u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043C\u0430\u043B\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824188
    m_Localized: "\u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D \u0443
      \u0431\u0435\u0437\u043F\u0435\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824189
    m_Localized: "\u0423 \u043C\u0435\u043D\u0435 \u0445\u043E\u0440\u043E\u0448\u0456
      \u043D\u043E\u0432\u0438\u043D\u0438, \u0410\u0441\u043A\u0430\u0440\u0456.
      \u042F \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0440\u0435\u0433\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0439
      \u0448\u0442\u0430\u0431 \u041B\u0435\u0433\u0456\u043E\u043D\u0443, \u0432\u0431\u0438\u043B\u0430
      \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u0456 \u0437\u0430\u0431\u0440\u0430\u043B\u0430 \u0432\u0441\u0456 \u043F\u0430\u043F\u0435\u0440\u0438,
      \u0449\u043E \u0437\u043D\u0430\u0439\u0448\u043B\u0430. \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430,
      \u044F \u043D\u0435 \u0437\u043D\u0430\u044E \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u043E\u0457.
      \u041F\u043E\u0434\u0438\u0432\u0438\u0448\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824190
    m_Localized: "\u0414\u0430\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824191
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824192
    m_Localized: "\u0426\u0435 \u043D\u0430\u043A\u0430\u0437\u0438 \u0456 \u0440\u0430\u043F\u043E\u0440\u0442\u0438.
      \u0414\u043E\u0441\u0438\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u043E.
      \u0410\u043B\u0435 \u0436\u043E\u0434\u043D\u043E\u0457 \u0437\u0433\u0430\u0434\u043A\u0438
      \u043F\u0440\u043E \u043D\u0430\u0441 \u0447\u0438 \u0456\u043D\u0448\u0438\u0445
      \u0456\u0437\u0433\u043E\u0457\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824193
    m_Localized: "\u0426\u0435 \u0434\u0443\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u0456
      \u043D\u043E\u0432\u0438\u043D\u0438 \u0434\u043B\u044F \u043D\u0430\u0441,
      @lp. \u042F \u0434\u043E\u0431\u0440\u0435 \u0437\u043D\u0430\u044E \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044E
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u0420\u043E\u0437\u0440\u0438\u0432
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F \u0434\u043B\u044F
      \u043D\u044C\u043E\u0433\u043E - \u0432\u0435\u043B\u0438\u043A\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430,
      \u0456 \u0432\u0456\u0434 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0456\u0432
      \u0432\u043E\u043D\u0438 \u043E\u0433\u043E\u0432\u0442\u0430\u044E\u0442\u044C\u0441\u044F
      \u0449\u0435 \u043D\u0435\u0441\u043A\u043E\u0440\u043E. \u0410 \u044F\u043A\u0431\u0438
      \u0437\u0435\u0431\u0440\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0432\u0438\u044F\u0432\u0438\u043B\u0438
      \u043D\u0430\u0441 \u0442\u0438\u043C \u0447\u0438 \u0456\u043D\u0448\u0438\u043C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C, \u043F\u0440\u043E \u0446\u0435
      \u0431\u0443\u043B\u043E \u0431 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u0442\u0443\u0442. \u0422\u0435\u043F\u0435\u0440 \u0443 \u043D\u0430\u0441
      \u0454 \u0433\u0430\u0440\u0430\u043D\u0442\u0456\u044F \u0442\u043E\u0433\u043E,
      \u0449\u043E \u043F\u043E\u043A\u0438 \u0449\u043E \u043C\u0438 \u0432 \u0431\u0435\u0437\u043F\u0435\u0446\u0456.
      \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
      \u043F\u0440\u0438\u0434\u0456\u043B\u0438\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0447\u0430\u0441\u0443 \u043D\u0430 \u0437\u0431\u043E\u0440\u0438 \u0456
      \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432.
      \u0410 \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u043D\u0430\u043C \u0456
      \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0439\u0442\u0438. \u0422\u0432\u043E\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430
      \u043D\u0435\u043E\u0446\u0456\u043D\u0435\u043D\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824194
    m_Localized: "\u0410\u043B\u0435 \u0432 \u043C\u0435\u043D\u0435 \u0442\u0435\u0436
      \u0454 \u043D\u043E\u0432\u0438\u043D\u0438 \u0434\u043B\u044F \u0442\u0435\u0431\u0435.
      \u041F\u043E\u043A\u0438 \u0442\u0438 \u0431\u0443\u043B\u0430 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u044F,
      \u0442\u0432\u043E\u044E \u043F\u043E\u0434\u0440\u0443\u0433\u0443 \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0432
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442. \u0426\u0435 \u0437\u0432\u0443\u0447\u0438\u0442\u044C
      \u0434\u0438\u0432\u043D\u043E, \u0442\u0430\u043A, \u0430\u043B\u0435 \u0432\u0456\u043D
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0438\u043B\u0435\u0442\u0456\u0432
      \u0456 \u0437\u0430\u043F\u0438\u0442\u0430\u0432 \u043F\u0440\u043E \u043D\u0435\u0457.
      \u0406 \u0439\u043E\u043C\u0443 \u0442\u0430\u043A\u043E\u0436 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F \u0437 \u0442\u043E\u0431\u043E\u044E.
      \u0417\u0430\u0440\u0430\u0437 \u0432\u0456\u043D \u0440\u0430\u0437\u043E\u043C
      \u0456\u0437 \u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u0443 \u0431\u0443\u0434\u0456\u0432\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824195
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0437\u0456 \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824196
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, @lp. \u0414\u043E\u0431\u0440\u0435,
      \u0449\u043E \u0442\u0438 \u043F\u0440\u0438\u0439\u0448\u043B\u0430 \u043D\u0435
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043F\u0456\u0437\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824197
    m_Localized: "\u0415-\u0435-\u0435... \u041F\u0440\u0438\u0432\u0456\u0442? \u041D\u0435
      \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u043C\u0438 \u0437\u043D\u0430\u0439\u043E\u043C\u0456,
      \u043C\u043E\u0436\u0435, \u0442\u043E\u0431\u0456 \u043A\u0440\u0430\u0449\u0435
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824198
    m_Localized: "\u0422\u0430\u043A, \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E,
      \u0432\u0438\u0431\u0430\u0447 \u043C\u0435\u043D\u0456 \u0437\u0430 \u043D\u0435\u0442\u0430\u043A\u0442\u043E\u0432\u043D\u0456\u0441\u0442\u044C.
      \u041C\u043E\u0454 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454 \u0456\u043C'\u044F
      \u043D\u0456\u0447\u043E\u0433\u043E \u0442\u043E\u0431\u0456 \u043D\u0435
      \u0441\u043A\u0430\u0436\u0435, \u0442\u043E\u043C\u0443 \u0437\u0432\u0438
      \u043C\u0435\u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447\u0435\u043C.
      \u042F\u043A\u0449\u043E \u0442\u0438 \u043F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448,
      \u043F\u0456\u0441\u043B\u044F \u0442\u0432\u043E\u0433\u043E \u0443\u0441\u043F\u0456\u0445\u0443
      \u0432 \u0421\u0442\u0456\u0439\u043B\u0456 88 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u043F\u0440\u043E\u0441\u0438\u0432 \u0442\u0435\u0431\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438
      \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440 \u0431\u0456\u043B\u044F
      \u0433\u0430\u0440\u0430\u0436\u0456\u0432 \u0425\u0435\u043D\u043A\u0456.
      \u042F \u0431\u0443\u0432 \u0442\u0438\u043C, \u0437 \u043A\u0438\u043C \u0442\u0438
      \u043C\u0430\u043B\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u043D\u0430\u0448\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0447
      \u0431\u0443\u043B\u0430 \u0437\u0456\u0440\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824199
    m_Localized: "\u042F\u043A \u0442\u0438 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u043C\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824200
    m_Localized: "\u0412\u0430\u0441. \u041D\u0430 \u0449\u0430\u0441\u0442\u044F,
      \u044F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0456 \u0442\u0435\u0431\u0435,
      \u0456 \u041E\u0431\u0440\u0430\u043D\u0443-24. \u0426\u0435 \u0431\u0443\u043B\u043E
      \u043D\u0435\u043B\u0435\u0433\u043A\u043E. \u041C\u0438 \u0437 \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E
      \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438, \u0442\u0435\u043F\u0435\u0440
      \u043D\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0437 \u0442\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824201
    m_Localized: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439. \u0412\u0435\u043B\u044C\u0432\u0435\u0442,
      \u0439\u043E\u043C\u0443 \u043C\u043E\u0436\u043D\u0430 \u0434\u043E\u0432\u0456\u0440\u044F\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824202
    m_Localized: "\u0422\u0430\u043A, \u0434\u0443\u043C\u0430\u044E, \u0449\u043E
      \u043C\u043E\u0436\u043D\u0430. \u0412\u0456\u043D \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0432
      \u043C\u0435\u043D\u0456 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E,
      \u0449\u043E\u0431 \u0443\u043F\u0435\u0432\u043D\u0438\u0442\u0438\u0441\u044F
      \u0432 \u0446\u044C\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824203
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u042F \u0437\u043D\u0430\u0439\u0448\u043B\u0430
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440,
      \u0430 \u0439 \u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430.
      \u0406 \u0427\u043E\u0440\u043D\u0443 \u041A\u043D\u0438\u0433\u0443 \u0442\u0435\u0436.
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043A\u0430\u0437\u0430\u0432
      \u0442\u043E\u0431\u0456, \u0449\u043E \u0432\u043E\u043D\u0438 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0430\u0436\u043B\u0438\u0432\u0456 \u0434\u043B\u044F \u043F\u0440\u043E\u0435\u043A\u0442\u0456\u0432?
      \u042F \u0432\u0432\u0430\u0436\u0430\u044E, \u0457\u0445 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u044F\u043A\u043E\u043C\u043E\u0433\u0430
      \u0448\u0432\u0438\u0434\u0448\u0435, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824204
    m_Localized: "... \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0440\u0430\u0437\u043E\u043C
      \u0456\u0437 \u041B\u0435\u0433\u0456\u043E\u043D\u043E\u043C \u043F\u043B\u0430\u043D\u0443\u044E\u0442\u044C
      \u043D\u0430\u043F\u0430\u0434 \u043D\u0430 \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456. \u041C\u0438 \u0437\u043D\u0430\u0454\u043C\u043E \u0446\u0435,
      @lp. \u041D\u0456, \u043F\u043E\u043A\u0438 \u0449\u043E \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438
      \u043C\u0430\u044E\u0442\u044C \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0432 \u0442\u0435\u0431\u0435. \u0411\u043E\u044E\u0441\u044F, \u0432\u043E\u043D\u0438
      \u0437\u0430\u0440\u0430\u0437 \u0431\u0443\u0434\u0443\u0442\u044C \u0442\u043E\u0431\u0456
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0432 \u043F\u0435\u0440\u0448\u0443
      \u0447\u0435\u0440\u0433\u0443. \u0406 \u044F \u043F\u043E\u044F\u0441\u043D\u044E,
      \u0447\u043E\u043C\u0443. \u0410\u043B\u0435 \u0441\u043F\u0435\u0440\u0448\u0443
      \u0434\u043E\u0437\u0432\u043E\u043B\u044C \u043C\u0435\u043D\u0456 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438
      \u0442\u043E\u0431\u0456 \u043F\u0440\u043E \u0442\u0435\u0431\u0435 \u0441\u0430\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824205
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u0443\u0436\u0435
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0432 \u0442\u043E\u0431\u0456,
      \u0449\u043E \u0442\u0435\u0431\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043D\u0430 \u043C\u0456\u0441\u0456\u044E \u0437\u0456 \u0437\u0431\u043E\u0440\u0443
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432, \u044F\u043A\u0438\u0445
      \u043D\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0430\u043B\u043E \u0434\u043B\u044F
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432
      \"\u0421\u043E\u043D\u0446\u0435\" \u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\".
      \u0422\u0430\u043A \u0441\u0430\u043C\u043E \u044F\u043A \u0456 \u0442\u0435,
      \u0449\u043E \u0442\u0438 \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u043E
      \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F \u043D\u0430 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0435
      \u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u0430\u043C'\u044F\u0442\u0456
      \u0437\u0430\u0440\u0430\u0434\u0438 \u0433\u0430\u0440\u0430\u043D\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0431\u0435\u0437\u043F\u0435\u043A\u0438 \u0441\u0432\u043E\u0433\u043E \u0431\u0443\u0434\u0438\u043D\u043A\u0443.
      \u0423 \u0446\u0456\u0454\u0457 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457
      \u0454 \u0456\u0441\u0442\u043E\u0442\u043D\u0438\u0439 \u043D\u0435\u0434\u043E\u043B\u0456\u043A:
      \u0443 \u0442\u0432\u043E\u0457\u0439 \u043F\u0430\u043C'\u044F\u0442\u0456
      \u043E\u0431\u0440\u0430\u0437\u0438 \u0431\u043B\u043E\u043A\u0443\u044E\u0442\u044C\u0441\u044F
      \u0446\u0456\u043B\u043A\u043E\u043C, \u0430 \u043D\u0435 \u043A\u043E\u0436\u0435\u043D
      \u043E\u043A\u0440\u0435\u043C\u0438\u0439 \u0457\u0445\u043D\u0456\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442.
      \u0426\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E \u0432\u0430\u0440\u0442\u043E
      \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438
      \u0442\u0432\u043E\u0457 \u0441\u043F\u043E\u0433\u0430\u0434\u0438, \u0456
      \u0442\u0438 \u0437\u0433\u0430\u0434\u0430\u0454\u0448 \u0443\u0441\u0435,
      \u0449\u043E \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0435 \u0437 \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0438\u043C
      \u0430\u0441\u043F\u0435\u043A\u0442\u043E\u043C. \u0414\u0438\u0432\u0438\u0441\u044C:
      \u0443 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430 \u0441\u0440\u0456\u0431\u043B\u044F\u0441\u0442\u043E-\u0441\u0456\u0440\u0430
      \u0433\u0440\u0438\u0432\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824206
    m_Localized: "... \u0456 \u0441\u0432\u0456\u0442\u043B\u043E-\u043B\u0456\u043B\u043E\u0432\u0430
      \u0448\u0435\u0440\u0441\u0442\u044C. \u0423 \u043D\u044C\u043E\u0433\u043E
      \u043A\u044C\u044E\u0442\u0456\u043C\u0430\u0440\u043A\u0430 \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456
      \u0445\u043E\u043A\u0435\u0439\u043D\u043E\u0457 \u043A\u043B\u044E\u0447\u043A\u0438,
      \u0432\u0456\u043D \u043D\u043E\u0441\u0438\u0442\u044C \u043E\u043A\u0443\u043B\u044F\u0440\u0438
      \u0456 \u0434\u0443\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u043E \u043B\u044E\u0431\u0438\u0442\u044C
      \u0441\u0432\u043E\u044E \u0440\u043E\u0431\u043E\u0442\u0443! \u0410 \u0449\u0435
      \u044F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u0434\u0436\u0435\u043C.
      \u041E \u0411\u043E\u0433\u0438\u043D\u0456, \u044F \u0434\u0456\u0439\u0441\u043D\u043E
      \u0439\u043E\u0433\u043E \u0437\u0433\u0430\u0434\u0430\u043B\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824207
    m_Localized: "\u0411\u0430\u0447\u0438\u0448? \u041E\u0434\u043D\u0430\u043A
      \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0435 \u0437\u0430\u0440\u0430\u0437
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u0437\u0433\u0430\u0434\u0430\u0442\u0438
      \u043D\u0435 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430,
      \u0430 \u0441\u0443\u0442\u044C \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432,
      \u043D\u0430\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F\u043C
      \u044F\u043A\u0438\u0445 \u0432\u0456\u043D \u043F\u0440\u0430\u0446\u044E\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824208
    m_Localized: "\u0423\u0441\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
      @lp. \u0417\u0430\u0440\u0430\u0437 \u043D\u0430 \u043D\u0430\u0441 \u043B\u044F\u0433\u0430\u0454
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0437\u0430 \u0437\u0430\u0445\u0438\u0441\u0442 \u043D\u0430\u0448\u043E\u0433\u043E
      \u0434\u043E\u043C\u0443. \u0406 \u044F\u043A \u0431\u0438 \u043C\u0435\u043D\u0456
      \u043D\u0435 \u0431\u0443\u043B\u043E \u0432\u0430\u0436\u043A\u043E \u0446\u0435
      \u0432\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u0438, \u0437\u0431\u0440\u043E\u044F,
      \u044F\u043A\u0443 \u043F\u0440\u0430\u0433\u043D\u0443\u0432 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A, \u043C\u043E\u0436\u0435
      \u0432\u0438\u044F\u0432\u0438\u0442\u0438\u0441\u044F \u043D\u0430\u0448\u043E\u044E
      \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u043E\u044E \u0432 \u0440\u0430\u0437\u0456,
      \u044F\u043A\u0449\u043E \u0449\u043E\u0441\u044C \u043F\u0456\u0434\u0435
      \u043D\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824209
    m_Localized: "\u041F\u0440\u043E\u0454\u043A\u0442\u0438 \"\u0421\u043E\u043D\u0446\u0435\"
      \u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\" \u0432\u0437\u0430\u0454\u043C\u043E\u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0456.
      \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\" - \u0446\u0435 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442, \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u0438\u0439
      \u043C\u0430\u0439\u0436\u0435 \u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u044E
      \u0431\u0440\u043E\u043D\u0435\u044E \u0456 \u043A\u0440\u0438\u043B\u0430\u043C\u0438,
      \u0437\u0434\u0430\u0442\u043D\u0438\u043C\u0438 \u043F\u0456\u0434\u043D\u044F\u0442\u0438
      \u0437\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043D\u0456 \u0430\u0431\u043E
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430 \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u044F.
      \u0410 \"\u0421\u043E\u043D\u0446\u0435\" - \u0446\u0435 \u043D\u0430\u0434\u0441\u043A\u043B\u0430\u0434\u043D\u0430,
      \u0437\u0430\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \"\u0412\u0435\u0441\u0435\u043B\u0446\u0456\"
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430, \u043C\u0435\u0442\u043E\u044E
      \u044F\u043A\u043E\u0457 \u0454 \u043F\u0440\u043E\u0442\u0438\u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0435
      \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043D\u044F \u0436\u0438\u0432\u0443\u0447\u043E\u0441\u0442\u0456
      \u0442\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439
      \u043D\u043E\u0441\u0456\u044F. \u0420\u0430\u0437\u043E\u043C \u0432\u043E\u043D\u0438
      \u0437\u0434\u0430\u0442\u043D\u0456 \u0434\u0430\u0442\u0438 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u043E\u0432\u0456
      \u043C\u0456\u0446\u044C, \u044F\u043A\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0454\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0438\u043C
      \u0441\u0438\u043B\u0430\u043C \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457
      \u0456 \u041B\u0443\u043D\u0438. \u0410\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432 \u043F\u043B\u0430\u043D\u0456 \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824210
    m_Localized: "\u0422\u0430\u043A, \u044F \u043F\u0430\u043C'\u044F\u0442\u0430\u044E
      \u0446\u0435. \u0426\u0456 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0456
      \u0432 \u0440\u043E\u0431\u043E\u0442\u0456, \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0435 \u0434\u0438\u0432\u043E.
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A, \u044F\u043A \u0456
      \u0439\u043E\u0433\u043E \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A\u0438,
      \u0432\u0456\u0440\u0438\u043B\u0438, \u0449\u043E \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u043E\u043D\u0438 \u0437\u0434\u0430\u0442\u043D\u0456 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
      \u043F\u043E\u0432\u043D\u0443 \u0431\u0435\u0437\u043F\u0435\u043A\u0443 \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456, \u043A\u043E\u043B\u0438 \u043F\u0440\u0438\u0439\u0434\u0435
      \u0447\u0430\u0441 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0441\u044F
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456. \u0406 \u0432\u043E\u043D\u0438...
      \u043C\u0438 \u0432\u0441\u0456 \u0445\u043E\u0442\u0456\u043B\u0438 \u043D\u0430\u0440\u0435\u0448\u0442\u0456
      \u043F\u0440\u0438\u043F\u0438\u043D\u0438\u0442\u0438 \u043D\u0430\u0448\u0443
      \u0456\u0437\u043E\u043B\u044F\u0446\u0456\u044E. \u0410\u043B\u0435 \u0431\u043E\u044F\u043B\u0438\u0441\u044F
      \u0446\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0431\u0435\u0437
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824211
    m_Localized: "\u041F\u043E\u043A\u0438 \u043C\u0438 \u0441\u0438\u0434\u0456\u043B\u0438
      \u0443 \u0441\u0432\u043E\u0454\u043C\u0443 \u0432\u0438\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0456\u0439
      \u0431\u0443\u0434\u0438\u043D\u043E\u0447\u043A\u0443, \u043F\u043E\u043D\u0456
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043B\u0438
      \u0439 \u043F\u043E\u043C\u0438\u0440\u0430\u043B\u0438, \u043F\u043E\u043A\u043E\u043B\u0456\u043D\u043D\u044F
      \u0437\u0430 \u043F\u043E\u043A\u043E\u043B\u0456\u043D\u043D\u044F\u043C,
      \u0447\u0435\u043A\u0430\u044E\u0447\u0438, \u043F\u043E\u043A\u0438 \u043C\u0438
      \u043D\u0435 \u0437\u0431\u0435\u0440\u0435\u043C\u043E \u0433\u0430\u0440\u043C\u0430\u0442\u0443
      \u0434\u043E\u0441\u0438\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0443,
      \u0449\u043E\u0431 \u043C\u0430\u0442\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043F\u0440\u0438\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0438 \u0457\u0445
      \u0443\u0441\u0456\u0445 \u0443 \u0440\u0430\u0437\u0456 \u0447\u043E\u0433\u043E.
      \u0429\u043E\u0431 \u043D\u0435 \u0442\u0430\u043A \u0441\u0442\u0440\u0430\u0448\u043D\u043E
      \u0431\u0443\u043B\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \"\u043F\u0440\u0438\u0432\u0456\u0442\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824212
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442, \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u043F\u043E\u0432\u043D\u043E \u043F\u043E\u043D\u0456, \u0432 \u0440\u043E\u0437\u043C\u043E\u0432\u0456
      \u0437 \u044F\u043A\u0438\u043C\u0438 \u0442\u0430\u043A\u0430 \u0433\u0430\u0440\u043C\u0430\u0442\u0430
      \u0441\u0442\u0430\u043D\u0435 \u0432 \u043F\u0440\u0438\u0433\u043E\u0434\u0456.
      \u0406 \u0446\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u044C \u0436\u0438\u0442\u0442\u044F
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043A\u0440\u0430\u0449\u0438\u043C \u0456 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824213
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824214
    m_Localized: "\u0414\u043E \u0434\u043E\u0431\u0440\u0430 \u0447\u0438 \u0434\u043E
      \u043B\u0438\u0445\u0430, \u0430\u043B\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F
      \u0441\u043A\u043B\u0430\u043B\u0430\u0441\u044F \u0441\u0430\u043C\u0435 \u0442\u0430\u043A.
      \u041F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u0434\u0432\u043E\u0445 \u0441\u043E\u0442\u0435\u043D\u044C
      \u0440\u043E\u043A\u0456\u0432 \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456
      \u0431\u0443\u043B\u043E \u0456\u0437\u043E\u043B\u044C\u043E\u0432\u0430\u043D\u0435
      \u0432\u0456\u0434 \u041F\u0443\u0441\u0442\u043A\u0438, \u0456 \u043F\u043E\u043D\u0456
      \u0432 \u043D\u044C\u043E\u043C\u0443 \u0437\u0431\u0435\u0440\u0435\u0433\u043B\u0438
      \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0432\u0456\u0434
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u043E\u0433\u043E
      \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.
      @lp, \u0442\u0438 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u0430\u043C\u0438\u0441\u043B\u044E\u0432\u0430\u043B\u0430\u0441\u044F,
      \u0447\u043E\u043C\u0443 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0432\u0435\u0441\u044C \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0430\u043B
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432 \u041C.\u0422.\u041D.?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824215
    m_Localized: "\u0422\u043E\u043C\u0443 \u0449\u043E \u0432\u043E\u043D\u0438
      \u0432\u043F\u0456\u0437\u043D\u0430\u044E\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u0442\u0443\u0440\u0443
      \u043C\u043E\u0433\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824216
    m_Localized: "\u0421\u0430\u043C\u0435 \u0442\u0430\u043A. \u0422\u0456\u043B\u044C\u043A\u0438
      \u041F\u0456\u043F\u0411\u0430\u043A\u0438 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432
      \u0421\u0442\u0456\u0439\u043B \u0443\u0441\u0435 \u0449\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C
      \u0443 \u0441\u043E\u0431\u0456 \u041F\u0417, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435
      \u0434\u043B\u044F \u0440\u043E\u0437\u043F\u0456\u0437\u043D\u0430\u0432\u0430\u043D\u043D\u044F
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430\u043C\u0438, \u0430
      \u0442\u0430\u043A\u043E\u0436 \u0431\u0435\u0437\u043B\u0456\u0447\u0447\u044E
      \u0456\u043D\u0448\u043E\u0433\u043E \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F
      \u041C.\u0422.\u041D. \u041F\u0430\u043C'\u044F\u0442\u044C \u0443 \u0442\u0438\u0445,
      \u044F\u043A\u0438\u043C\u0438 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u044E\u0442\u044C\u0441\u044F
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456 \u0449\u0430\u0441\u043B\u0438\u0432\u0447\u0438\u043A\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456, \u0431\u0443\u043B\u0430
      \u0441\u0442\u0435\u0440\u0442\u0430 \u0432\u0436\u0435 \u0431\u0435\u0437\u043B\u0456\u0447
      \u0440\u0430\u0437\u0456\u0432. \u0410\u043B\u0435 \u0446\u0435 - \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u0456
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437 \u0442\u0456\u0454\u044E
      \u0431\u0435\u0437\u043B\u0456\u0447\u0447\u044E \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432,
      \u043D\u0430\u0434 \u044F\u043A\u0438\u043C\u0438 \u0432\u0430\u0448\u0435
      \u0421\u0442\u0456\u0439\u043B\u043E \u0432\u0435\u043B\u043E \u0440\u043E\u0431\u043E\u0442\u0443
      \u0434\u043E \u043D\u0430\u0441\u0442\u0430\u043D\u043D\u044F \u041E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u0414\u043D\u044F. \u0423 \u0442\u043E\u043C\u0443 \u0447\u0438\u0441\u043B\u0456
      \u043F\u0440\u043E\u0454\u043A\u0442\u0438 \"\u0421\u043E\u043D\u0446\u0435\"
      \u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824217
    m_Localized: "\u0421\u0430\u043C\u0435 \u0432\u043E\u043D\u0438 \u0439 \u043F\u0440\u0438\u0432\u0430\u0431\u043B\u044E\u0432\u0430\u043B\u0438
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430. \u0410\u043B\u0435
      \u043F\u043E\u043A\u0438 \u0449\u043E \u0432\u0441\u0435 \u0449\u0435 \u0454
      \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438
      \u0432\u0441\u0435... \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u043E \u043C\u0438\u0440\u043D\u0438\u043C
      \u0448\u043B\u044F\u0445\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824218
    m_Localized: "\u041D\u0430\u0448\u043E\u043C\u0443 \u0421\u0442\u0456\u0439\u043B\u0443
      \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0454 \u043F\u0440\u044F\u043C\u0435
      \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F. \u042F\u043A
      \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438
      \u0446\u0435 \"\u043C\u0438\u0440\u043D\u0438\u043C \u0448\u043B\u044F\u0445\u043E\u043C\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824219
    m_Localized: "\u0404 \u0441\u043F\u043E\u0441\u0456\u0431. \u0410\u043B\u0435
      \u0436\u043E\u0434\u043D\u043E\u0457 \u0433\u0430\u0440\u0430\u043D\u0442\u0456\u0457
      \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824220
    m_Localized: "\u042F \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A
      \u043A\u043B\u0438\u0447\u0443 \u0441\u0435\u0431\u0435 \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447\u0435\u043C,
      @lp. \u0427\u0435\u0440\u0435\u0437 \u0441\u0438\u0441\u0442\u0435\u043C\u0443
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0456\u0432 \u044F
      \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456. \u0410 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0434\u0456\u0437\u043D\u0430\u0454\u0442\u044C\u0441\u044F \u0446\u0435 \u0432\u0456\u0434
      \u043C\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824221
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u0447\u043E\u043C\u0443 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u0432\u0438\u0440\u0456\u0448\u0438\u0432 \u043D\u0430\u043F\u0430\u0441\u0442\u0438
      \u043D\u0430 \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456. \u0406 \u0447\u043E\u043C\u0443
      \u0441\u0442\u0430\u0432 \u043C\u043E\u0436\u043B\u0438\u0432\u0438\u043C \u0439\u043E\u0433\u043E
      \u0441\u043E\u044E\u0437 \u0456\u0437 \u041A\u0435\u0441\u0430\u0440\u0456\u0454\u043C.
      \u041D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456 \u0437'\u044F\u0432\u0438\u043B\u0430\u0441\u044F
      \u0437\u0430\u0433\u0440\u043E\u0437\u0430, \u0437\u0434\u0430\u0442\u043D\u0430
      \u0437\u043C\u0443\u0441\u0438\u0442\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435\u043F\u0440\u0438\u043C\u0438\u0440\u0435\u043D\u043D\u0438\u0445
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u043E\u0431'\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E\u0442\u0438 \u0441\u0435\u0431\u0435. \u0410\u043D\u043A\u043B\u0430\u0432.
      \u041A\u043E\u043B\u0438 \u043D\u0430\u0441\u0442\u0430\u0432 \u041E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u0414\u0435\u043D\u044C, \u043F\u0435\u0433\u0430\u0441\u0438 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438 \u0441\u0432\u043E\u044E \u043A\u0440\u0430\u0457\u043D\u0443
      \u043F\u043E\u043C\u0438\u0440\u0430\u0442\u0438 \u0456 \u0437\u0430\u043A\u0440\u0438\u043B\u0438
      \u043D\u0435\u0431\u043E. \u0412\u0456\u0434\u0442\u043E\u0434\u0456 \u043D\u0430
      \u041F\u0443\u0441\u0442\u0446\u0456 \u043D\u0435 \u0431\u0443\u043B\u043E
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043E\u043D\u044F\u0447\u043D\u043E\u0433\u043E
      \u0434\u043D\u044F. \u0421\u0430\u043C\u0456 \u043F\u0435\u0433\u0430\u0441\u0438
      \u0432\u0436\u0435 \u0434\u0432\u0456 \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432
      \u0436\u0438\u0432\u0443\u0442\u044C \u043D\u0430\u0434 \u0445\u043C\u0430\u0440\u043D\u043E\u044E
      \u0437\u0430\u0432\u0456\u0441\u043E\u044E. \u042F \u043D\u0435 \u0437\u043D\u0430\u044E,
      \u0449\u043E \u0432 \u043D\u0438\u0445 \u0442\u0430\u043C \u043A\u043E\u0457\u0442\u044C\u0441\u044F,
      \u0430\u043B\u0435 \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E \u0449\u043E\u043D\u0430\u0439\u043C\u0435\u043D\u0448\u0435
      \u0447\u0430\u0441\u0442\u0438\u043D\u0430 \u0437 \u043D\u0438\u0445 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430,
      \u0449\u043E \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0439
      \u0456\u0437\u043E\u043B\u044F\u0446\u0456\u0457 \u0441\u043B\u0456\u0434 \u0441\u043A\u0456\u043D\u0447\u0438\u0442\u0438\u0441\u044F.
      \u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u0437\u0430\u0433\u0456\u043D \u043F\u0435\u0433\u0430\u0441\u0456\u0432,
      \u044F\u043A\u0456 \u043D\u0430\u0437\u0438\u0432\u0430\u044E\u0442\u044C \u0441\u0435\u0431\u0435
      \u0412\u0435\u043B\u0438\u043A\u0438\u043C \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C
      \u041F\u0435\u0433\u0430\u0441\u0456\u0432, \u0441\u043F\u0443\u0441\u0442\u0438\u0432\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E \u0431\u043B\u0438\u0437\u044C\u043A\u043E
      \u0447\u043E\u0442\u0438\u0440\u044C\u043E\u0445 \u043C\u0456\u0441\u044F\u0446\u0456\u0432
      \u0442\u043E\u043C\u0443 \u0456 \u0437\u0430\u0441\u043D\u0443\u0432\u0430\u0432
      \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0443 \u0431\u0430\u0437\u0443,
      \u043D\u0435 \u043F\u0456\u0434\u043F\u0443\u0441\u043A\u0430\u044E\u0447\u0438
      \u0434\u043E \u043D\u0435\u0457 \u043D\u0456\u043A\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824222
    m_Localized: "\u042F \u0437\u043D\u0430\u0439\u043E\u043C\u0430 \u0437 \u043E\u0434\u043D\u0438\u043C
      \u043F\u0435\u0433\u0430\u0441\u043E\u043C. \u0419\u043E\u0433\u043E \u0437\u0432\u0443\u0442\u044C
      \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456. \u0422\u0438 \u0437\u043D\u0430\u0454\u0448
      \u0439\u043E\u0433\u043E? \u0412\u0456\u043D \u043D\u0435 \u043C\u0430\u0454
      \u0434\u043E \u0446\u044C\u043E\u0433\u043E \u0432\u0456\u0434\u043D\u043E\u0448\u0435\u043D\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824223
    m_Localized: "\u0423 \u043D\u044C\u043E\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0430
      \u0456\u0441\u0442\u043E\u0440\u0456\u044F. \u0410\u043B\u0435 \u043D\u0456,
      \u043D\u0435 \u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824224
    m_Localized: "\u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0438\u0441\u044F
      \u0432\u0438\u0439\u0442\u0438 \u0437 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C
      \u043D\u0430 \u0437\u0432'\u044F\u0437\u043E\u043A, \u0430\u043B\u0435 \u043D\u0435
      \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0438 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456.
      \u041F\u0430\u043C'\u044F\u0442\u044C \u043F\u0440\u043E \u0441\u0442\u0430\u0440\u0443
      \u0437\u0440\u0430\u0434\u0443 \u043F\u0435\u0433\u0430\u0441\u0456\u0432 \u0456
      \u043F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u0456\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0438
      \u0437\u043C\u0443\u0441\u0438\u043B\u0438 \u0439\u043E\u0433\u043E \u0441\u043F\u0440\u0438\u0439\u043C\u0430\u0442\u0438
      \u043D\u043E\u0432\u0443 \u0441\u0438\u043B\u0443 \u044F\u043A \u0437\u0430\u0433\u0440\u043E\u0437\u0443
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u043C \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C
      \u0437\u0430\u0433\u0430\u043B\u043E\u043C \u0456 \u0441\u043E\u0431\u0456
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u0437\u043E\u043A\u0440\u0435\u043C\u0430.
      \u041F\u043E\u043F\u0440\u0438 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
      \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u044C \u0432\u043E\u0440\u043E\u0436\u043E\u0441\u0442\u0456
      \u0430\u043D\u043A\u043B\u0430\u0432\u0456\u0432\u0446\u0456\u0432 \u0434\u043E
      \u043F\u043E\u043D\u0456, \u0432\u0456\u043D \u043F\u043E\u0447\u0430\u0432
      \u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0432\u0456\u0439\u043D\u0438.
      \u042F\u043A \u043F\u0430\u0440\u0430\u043D\u043E\u0457\u0434\u0430\u043B\u044C\u043D\u0438\u0439
      \u043F\u0430\u0432\u0443\u043A, \u0432\u0456\u043D \u043F\u043B\u0456\u0432
      \u0441\u0432\u043E\u0454 \u043F\u0430\u0432\u0443\u0442\u0438\u043D\u043D\u044F
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F, \u0432\u0456\u0434\u043E\u043A\u0440\u0435\u043C\u043B\u044E\u044E\u0447\u0438
      \u0442\u0438\u0445, \u043A\u043E\u043C\u0443 \u0434\u043E\u0432\u0456\u0440\u044F\u0432,
      \u0432\u0456\u0434 \u0440\u0435\u0448\u0442\u0438, \u0456 \u043F\u043E\u0441\u0432\u044F\u0447\u0443\u044E\u0447\u0438
      \u0457\u0445 \u0443 \u0441\u0432\u043E\u0457 \u043F\u043B\u0430\u043D\u0438
      \u0449\u043E\u0434\u043E \u0430\u0442\u0430\u043A\u0438 \u0431\u0430\u0437\u0438
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824225
    m_Localized: "\u0410\u043B\u0435 \u0432\u0456\u043D \u0431\u0443\u0432 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u0439, \u0449\u043E\u0431 \u0442\u0432\u0435\u0440\u0435\u0437\u043E
      \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u0442\u0438 \u0441\u0432\u043E\u0457
      \u0441\u0438\u043B\u0438 \u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u0443
      \u0441\u0438\u043B\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430.
      \u0412\u0456\u043D \u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u0449\u043E
      \u0431\u0430\u0437\u0430 \u043C\u043E\u0436\u0435 \u0432\u0438\u044F\u0432\u0438\u0442\u0438\u0441\u044F
      \u043B\u0438\u0448\u0435 \u0432\u0435\u0440\u0445\u0456\u0432\u043A\u043E\u044E
      \u0430\u0439\u0441\u0431\u0435\u0440\u0433\u0430: \u0437\u0440\u0435\u0448\u0442\u043E\u044E,
      \u0439\u043E\u043C\u0443 \u043D\u0435 \u0431\u0443\u043B\u043E \u043D\u0456\u0447\u043E\u0433\u043E
      \u0432\u0456\u0434\u043E\u043C\u043E \u043F\u0440\u043E \u0442\u0435, \u044F\u043A
      \u043F\u0435\u0433\u0430\u0441\u0438 \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0438
      \u0446\u0456 \u0434\u0432\u0456 \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432
      \u0456 \u044F\u043A\u0443 \u0447\u0430\u0441\u0442\u043A\u0443 \u0432\u0456\u0434
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u043E\u0457 \u043C\u043E\u0433\u0443\u0442\u043D\u043E\u0441\u0442\u0456
      \u0432\u043E\u043D\u0438 \u0437\u0443\u043C\u0456\u043B\u0438 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438.
      \u0406 \u0432\u0456\u043D \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0441\u043E\u0431\u0456
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430 \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456
      \u041A\u0435\u0441\u0430\u0440\u0456\u044F, \u044F\u043A\u0438\u0439 \u0442\u0430\u043A\u043E\u0436
      \u0431\u0430\u0447\u0438\u0432 \u0432\u0435\u043B\u0438\u043A\u0443 \u0437\u0430\u0433\u0440\u043E\u0437\u0443
      \u0432 \u043F\u043E\u044F\u0432\u0456 \u043D\u043E\u0432\u043E\u0457 \u0441\u0438\u043B\u0438
      \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824226
    m_Localized: "\u0406 \u0442\u043E\u043C\u0443 \u0432\u0456\u043D \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u0432
      \u043D\u0430\u043F\u0430\u0434 \u043D\u0430 \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456, @lp. \u0412\u0456\u043D \u0437\u043D\u0430\u0432 \u043F\u0440\u043E
      \u043F\u0440\u043E\u0454\u043A\u0442\u0438, \u0456 \u0432\u0456\u043D \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u0432
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0457\u0445
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0438 \u0443
      \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u044E\u0432\u0430\u043D\u0456\u0439
      \u0432\u0456\u0439\u043D\u0456. \u0406 \u044F\u043A\u0449\u043E \u043D\u0435
      \u0431\u0443\u0434\u0435 \u0432\u0456\u0439\u043D\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824227
    m_Localized: "... \u043D\u0435 \u0431\u0443\u0434\u0435 \u0439 \u0437\u0430\u0433\u0440\u043E\u0437\u0438
      \u043D\u0430\u0448\u043E\u043C\u0443 \u0434\u043E\u043C\u0443. \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0432 \u043A\u0443\u0440\u0441\u0456 \u0432\u0441\u044C\u043E\u0433\u043E
      \u0446\u044C\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824228
    m_Localized: "\u0422\u0430\u043A. \u0406 \u0432\u0456\u043D \u043F\u0440\u043E\u0441\u0438\u0432
      \u043C\u0435\u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u0442\u043E\u0431\u0456
      \u043D\u043E\u0432\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F:
      \u0437'\u044F\u0441\u0443\u0432\u0430\u0442\u0438, \u043D\u0430\u0432\u0456\u0449\u043E
      \u0410\u043D\u043A\u043B\u0430\u0432 \u0441\u043F\u0443\u0441\u0442\u0438\u0432\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E, \u0456 \u044F\u043A
      \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0442\u0430\u043A, \u0449\u043E\u0431
      \u0432\u0456\u043D \u043F\u0456\u0448\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824229
    m_Localized: "\u041F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437 \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u0456 \u041B\u0435\u0433\u0456\u043E\u043D \u0432\u0435\u0434\u0443\u0442\u044C
      \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0443 \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0443
      \u043E\u0434\u0438\u043D \u0437 \u043E\u0434\u043D\u0438\u043C. \u0412\u043E\u043D\u0430
      \u0442\u0430\u043A\u043E\u0436 \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u0441\u0435\u043D\u0441, \u044F\u043A\u0449\u043E \u0410\u043D\u043A\u043B\u0430\u0432
      \u0437\u043D\u0438\u043A\u043D\u0435. \u0417 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C
      \u0441\u043C\u0435\u0440\u0442\u0456 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u043D\u0430\u0432\u0456\u0442\u044C \u0441\u044F\u0434\u0443\u0442\u044C \u0437\u0430
      \u0441\u0442\u0456\u043B \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0456\u0432.
      \u0422\u043E\u0436 \u0446\u0435 \u0431\u0443\u0434\u0435 \u0431\u043B\u0430\u0433\u043E\u043C
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824230
    m_Localized: "\u0410\u043B\u0435... \u0447\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E
      \u0446\u0435? \u042F\u043A \u0446\u044C\u043E\u0433\u043E \u0434\u043E\u0441\u044F\u0433\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824231
    m_Localized: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E. \u0417\u0456 \u043C\u043D\u043E\u044E
      \u0410\u043D\u043A\u043B\u0430\u0432 \u0442\u0430\u043A\u043E\u0436 \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443\u0432\u0430\u0442\u0438. \u0412\u043E\u043D\u0438
      \u0437\u0431\u0438\u0432\u0430\u044E\u0442\u044C \u0443\u0441\u0456\u0445 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0456\u0432,
      \u0449\u043E \u044F \u043F\u043E\u0441\u0438\u043B\u0430\u044E \u0434\u043E
      \u043D\u0438\u0445. \u041F\u0435\u0440\u0448, \u043D\u0456\u0436 \u0434\u0456\u044F\u0442\u0438,
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u0440\u043E \u043D\u0438\u0445
      \u0442\u0430 \u0457\u0445\u043D\u0456 \u0446\u0456\u043B\u0456. \u042F\u043A
      \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0412\u0435\u043B\u044C\u0432\u0435\u0442,
      \u043D\u0435\u043C\u0430\u0454 \u0436\u043E\u0434\u043D\u043E\u0457 \u0433\u0430\u0440\u0430\u043D\u0442\u0456\u0457,
      \u0449\u043E \u0446\u0435 \u0441\u043F\u0440\u0430\u0446\u044E\u0454. \u0410\u043B\u0435
      \u043F\u043E\u043A\u0438 \u0449\u043E \u0446\u0435 - \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439
      \u0432\u0430\u0440\u0456\u0430\u043D\u0442 \u0437 \u0443\u0441\u0456\u0445,
      \u0449\u043E \u0432 \u043D\u0430\u0441 \u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824232
    m_Localized: "\u0406 \u044F\u043A\u0449\u043E \u0432\u0456\u043D \u043D\u0435
      \u0441\u043F\u0440\u0430\u0446\u044E\u0454, \u043D\u0430\u043C \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u043E\u0431\u043E\u0440\u043E\u043D\u0438
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824233
    m_Localized: "\u042F \u043C\u043E\u0436\u0443 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u043D\u0430 \u0431\u0430\u0437\u0443 \u0456 \u0437'\u044F\u0441\u0443\u0432\u0430\u0442\u0438,
      \u0449\u043E \u043F\u0435\u0433\u0430\u0441\u0430\u043C \u0442\u0443\u0442
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824234
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0443 \u043D\u0430\u0441
      \u043D\u0435\u043C\u0430\u0454 \u0456\u043D\u0448\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0456\u0432.
      \u0410\u043B\u0435 \u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u0435,
      @lp. \u0412\u0441\u0456\u043C\u0430 \u0441\u0438\u043B\u0430\u043C\u0438 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
      \u0434\u043E\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F \u043C\u0438\u0440\u043D\u043E.
      \u041D\u0430\u043C \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u043A\u0440\u043E\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824235
    m_Localized: "\u0410 \u044F\u043A\u0449\u043E \u043C\u0438\u0440\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443 \u043D\u0435 \u0432\u0438\u0439\u0434\u0435,
      \u0442\u0438 \u0441\u0442\u0430\u043D\u0435\u0448 \u043F\u0435\u0440\u0448\u043E\u044E
      \u043B\u0456\u043D\u0456\u0454\u044E \u043E\u0431\u043E\u0440\u043E\u043D\u0438
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456. \u0422\u043E\u043C\u0443
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0442\u0435\u0431\u0435. \u0422\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0430
      \u0432\u0438\u0436\u0438\u0442\u0438 \u0456 \u0434\u043E\u0441\u044F\u0433\u0442\u0438
      \u0443\u0441\u043F\u0456\u0445\u0443. \u0406 \u0432\u043E\u043D\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0430\u0442\u044C
      \u0442\u0432\u043E\u0457 \u0448\u0430\u043D\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824236
    m_Localized: "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0446\u0435\u0445
      \u0437\u0456 \u0441\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F \u0433\u0430\u0440\u043C\u0430\u0442
      \u0442\u0443\u0442. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u043C\u0435\u043D\u0456 \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435\u0442\u044C\u0441\u044F
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u043E\u0433\u043E
      \u0437\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u0442\u0443\u0440\u0435\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824237
    m_Localized: "\u0425\u043E\u0447\u0430 \u0434\u0438\u0432\u043D\u043E, \u0449\u043E
      \u0446\u0435 \u043C\u0456\u0441\u0446\u0435 \u0434\u043E\u0441\u0456 \u043D\u0435
      \u0440\u043E\u0437\u0433\u0440\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824238
    m_Localized: "(\u0433\u043E\u043B\u043E\u0441 \u0456\u0437 \u0434\u0438\u043D\u0430\u043C\u0456\u043A\u0430)
      \u0423\u0432\u0430\u0433\u0430! \u0412\u0438\u044F\u0432\u043B\u0435\u043D\u043E
      \u043D\u0435\u0441\u0430\u043D\u043A\u0446\u0456\u043E\u043D\u043E\u0432\u0430\u043D\u0435
      \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F. \u0417\u0430\u0434\u0456\u044F\u043D\u043E
      \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0439 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
      144-F. \u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E. \u0410\u043D\u0442\u0438-\u043F\u043E\u043B\u044C\u043E\u0442\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E.
      \u0410\u043D\u0442\u0438-\u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u0439\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824239
    m_Localized: "\u041E\u0441\u044C \u0436\u0435 \u0457\u0431\u0443\u0447\u0430
      \u0441\u0438\u043B\u0430!| \u041E\u0441\u044C \u0436\u0435 \u044F\u0434\u0440\u0435\u043D\u0430
      \u043A\u043E\u0447\u0435\u0440\u0438\u0436\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824240
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824241
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442... \u044F \u0437\u0433\u0430\u0434\u0443\u044E,
      \u0449\u043E \u0449\u043E\u0441\u044C \u043F\u043E\u0434\u0456\u0431\u043D\u0435
      \u0431\u0443\u043B\u043E \u0432 \u043D\u0430\u0441 \u0443 \u0421\u0442\u0456\u0439\u043B\u0456.
      \u0426\u0435 \u043F\u043E\u0433\u0430\u043D\u043E... \u0434\u0443\u0436\u0435
      \u043F\u043E\u0433\u0430\u043D\u043E! \u0426\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u043A\u043E\u0436\u0435\u043D \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0443 \u0446\u044C\u043E\u043C\u0443
      \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u0456 \u0441\u0442\u0430\u0454
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C.
      \u041D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0438
      \u043D\u0430 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0443 \u043F\u0456\u0434\u043B\u043E\u0433\u0443,
      \u0442\u043E\u0440\u043A\u0430\u0442\u0438\u0441\u044F \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0441\u0442\u0456\u043D, \u0434\u0432\u0435\u0440\u0435\u0439, \u043C\u0435\u0431\u043B\u0456\u0432,
      \u0430 \u0442\u043E \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0456
      \u0440\u043E\u0437\u0440\u044F\u0434\u0438 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E
      \u0437\u0456\u043F\u0441\u0443\u044E\u0442\u044C \u043C\u0435\u043D\u0456 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F.
      \u041F\u0440\u0438\u0447\u043E\u043C\u0443 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0442\u043E\u0440\u043A\u0430\u0442\u0438\u0441\u044F \u0457\u0445 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C - \u0456\u043D\u0430\u043A\u0448\u0435
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0435
      \u043F\u043E\u043B\u0435 \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u043A\u043E\u043C \u0456 \u043C\u0435\u043D\u0456
      \u0434\u0456\u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F \u043D\u0430
      \u043F\u043E\u0432\u043D\u0443, \u043D\u0430\u0432\u0456\u0442\u044C \u0449\u0435
      \u0433\u0456\u0440\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824242
    m_Localized: "\u041F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u0445\u0456\u0431\u0430 \u0449\u043E \u0431\u0435\u0442\u043E\u043D, \u0434\u0435\u0440\u0435\u0432\u043E
      \u0456 \u043F\u043B\u0430\u0441\u0442\u0438\u043A. \u0422\u0456\u043B\u044C\u043A\u0438
      \u0446\u0456 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438 \u043D\u0435
      \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u044C \u0441\u0442\u0440\u0443\u043C,
      \u043D\u0430 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u0430 \u0441\u0442\u043E\u044F\u0442\u0438
      \u0430\u0431\u043E \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438
      \u0457\u0445 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824243
    m_Localized: "\u0410\u043B\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0454
      \u0456 \u0445\u043E\u0440\u043E\u0448\u0430 \u043D\u043E\u0432\u0438\u043D\u0430!
      \u042F\u043A\u0449\u043E \u0446\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0430 \u0442\u0430\u043A
      \u0441\u0430\u043C\u043E, \u044F\u043A \u0456 \u043D\u0430\u0448\u0430, \u0442\u043E
      \u0442\u0443\u0442 \u0434\u0435\u0441\u044C \u043C\u0430\u044E\u0442\u044C
      \u0431\u0443\u0442\u0438 \u043A\u0435\u0440\u0443\u044E\u0447\u0456 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0438,
      \u0437 \u044F\u043A\u0438\u0445 \u043C\u043E\u0436\u043D\u0430 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438
      \u0437\u0430\u0445\u0438\u0441\u0442. \u0423\u043F\u0435\u0432\u043D\u0435\u043D\u0430,
      \u0449\u043E \u0437\u043C\u043E\u0436\u0443 \u0457\u0445 \u0437\u043B\u0430\u043C\u0430\u0442\u0438.
      \u0429\u043E\u0431 \u0456\u0437 \u043C\u043E\u0457\u043C \u0434\u043E\u0441\u0432\u0456\u0434\u043E\u043C
      \u0456 \u043D\u0435 \u0432\u0438\u0439\u0448\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824244
    m_Localized: "\u0422\u0430\u043A-\u0442\u0430\u043A, \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F,
      \u0449\u043E \u0442\u0443\u0442 \u0443 \u043D\u0430\u0441? \u0421\u043F\u0435\u0446\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u044F...
      \u043A\u043E\u0440\u0430\u0431\u0435\u043B\u044C\u043D\u0430 \u0433\u0430\u0440\u043C\u0430\u0442\u0430,
      \u043C\u043E\u0434\u0435\u043B\u044C 8210 \"\u0412\u043E\u0440\u043E\u043D\".
      \u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0430 \u0434\u043B\u044F
      \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F \u0442\u043E\u0440\u043F\u0435\u0434\u043D\u0438\u0445
      \u043A\u0430\u0442\u0435\u0440\u0456\u0432 \u0442\u0430 \u0456\u043D\u0448\u0438\u0445
      \u043C\u0430\u043B\u043E\u043C\u0456\u0440\u043D\u0438\u0445 \u043A\u043E\u0440\u0430\u0431\u043B\u0456\u0432.
      \u041C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
      \u043D\u0430 \u0441\u0443\u0434\u043D\u0430\u0445 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0442\u0438\u043F\u0443 \u0430\u0431\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0434\u043B\u044F \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F
      \u043D\u0430\u0437\u0435\u043C\u043D\u0438\u0445 \u0432\u043E\u0433\u043D\u0435\u0432\u0438\u0445
      \u0442\u043E\u0447\u043E\u043A. \u0422\u0422\u0425: \u043A\u0430\u043B\u0456\u0431\u0440
      - 75 \u043C\u043C; \u0434\u043E\u0432\u0436\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430
      - 3.8 \u043C; \u043C\u0430\u0441\u0430 - 790 \u043A\u0433; \u043C\u0430\u0441\u0430
      \u0441\u043D\u0430\u0440\u044F\u0434\u0430 - 8.7 \u043A\u0433; \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0430
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C - 750 \u043C/\u0441;
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      - 15 \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456\u0432 \u043D\u0430 \u0445\u0432\u0438\u043B\u0438\u043D\u0443;
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438 - 6.1 \u043A\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824245
    m_Localized: "\u041E\u0441\u044C \u0446\u0435 \u043A\u0440\u0443\u0442\u043E!
      \u042F\u043A\u0449\u043E \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
      \u0445\u043E\u0447\u0430 \u0431 \u043F\u0430\u0440\u043E\u0447\u043A\u0443
      \u0442\u0430\u043A\u0438\u0445 \u0433\u0430\u0440\u043C\u0430\u0442 \u0431\u0456\u043B\u044F
      \u0442\u0430\u0431\u043E\u0440\u0443, \u0442\u043E \u0436\u043E\u0434\u0435\u043D
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440
      \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0441\u0443\u043D\u0435\u0442\u044C\u0441\u044F.
      \u0422\u0430 \u0449\u043E \u0442\u0430\u043C, \u043D\u0435\u0445\u0430\u0439
      \u0445\u043E\u0447 \u043D\u0430 \u0442\u0430\u043D\u043A\u0443 \u043F\u0440\u0438\u0457\u0436\u0434\u0436\u0430\u044E\u0442\u044C!
      \u0422\u0435\u043F\u0435\u0440 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439
      \u043F\u043E\u043D\u0456\" \u0442\u043E\u0447\u043D\u043E \u0441\u0442\u0430\u043D\u0435
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448 \u0443\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0438\u043C
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F\u043C \u0443 \u0446\u0456\u0439
      \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824246
    m_Localized: "\u041C\u0430\u0431\u0443\u0442\u044C, \u043A\u0430\u043B\u0456\u0431\u0440
      \u043D\u0430\u0432\u0456\u0442\u044C \u0442\u0440\u043E\u0445\u0438 \u0437\u0430\u0432\u0435\u043B\u0438\u043A\u0438\u0439...
      \u041D\u0443 \u0442\u0430 \u043B\u0430\u0434\u043D\u043E, \u0446\u0435 \u0432\u0436\u0435
      \u043D\u0435 \u043C\u043E\u044F \u0442\u0443\u0440\u0431\u043E\u0442\u0430,
      \u043F\u043E\u043D\u0456 \u0437 \u0442\u0430\u0431\u043E\u0440\u0443 \u044F\u043A-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0440\u043E\u0437\u0431\u0435\u0440\u0443\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824247
    m_Localized: "\u0417\u0432\u0435\u0440\u0442\u0430\u0454\u043C\u043E \u0432\u0430\u0448\u0443
      \u0443\u0432\u0430\u0433\u0443: \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439
      \u0434\u043B\u044F \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432
      \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F. \u041F\u0435\u0440\u0432\u0438\u043D\u043D\u0438\u043C
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F\u043C \u0454 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0432\u0456\u0434 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F
      \u043D\u0430 \u043E\u0431'\u0454\u043A\u0442 \u0432\u043E\u0440\u043E\u0436\u0438\u0445
      \u0430\u0433\u0435\u043D\u0442\u0456\u0432 \u0456 \u0432\u0438\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044F
      \u043D\u0438\u043C\u0438 \u0432\u0430\u0436\u043B\u0438\u0432\u043E\u0457 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457,
      \u0449\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0443
      \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u044E. \u0412\u0442\u043E\u0440\u0438\u043D\u043D\u0438\u043C
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F\u043C \u0454 \u0437\u0430\u0445\u0438\u0441\u0442
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443. \u0412\u0438\u0445\u043E\u0434\u044F\u0447\u0438
      \u0437 \u0446\u044C\u043E\u0433\u043E, \u043A\u043E\u0436\u0435\u043D \u0441\u043F\u0456\u0432\u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A
      \u0437\u043E\u0431\u043E\u0432'\u044F\u0437\u0430\u043D\u0438\u0439 \u0437\u043D\u0430\u0442\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0438
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u043E\u0433\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824248
    m_Localized: "\u041F\u043E\u0447\u0443\u0432\u0448\u0438 \u0441\u0438\u0433\u043D\u0430\u043B
      \u0442\u0440\u0438\u0432\u043E\u0433\u0438, \u043D\u0435\u0433\u0430\u0439\u043D\u043E
      \u0437\u0456\u0439\u0434\u0456\u0442\u044C \u0456\u0437 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u0457
      \u043F\u0456\u0434\u043B\u043E\u0433\u0438, \u043D\u0435 \u0442\u043E\u0440\u043A\u0430\u0439\u0442\u0435\u0441\u044F
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0441\u0442\u0456\u043D,
      \u0441\u0445\u043E\u0434\u0456\u0432, \u0434\u0432\u0435\u0440\u0435\u0439,
      \u043C\u0435\u0431\u043B\u0456\u0432 \u0442\u0430 \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F.
      \u041F\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044C \u043D\u0430 \u0431\u0435\u0442\u043E\u043D\u043D\u0443
      \u043F\u0456\u0434\u043B\u043E\u0433\u0443, \u0430 \u0442\u0430\u043C, \u0434\u0435
      \u0457\u0457 \u043D\u0435\u043C\u0430\u0454, \u0437\u0430\u043B\u0430\u0437\u044C\u0442\u0435
      \u043D\u0430 \u0434\u0435\u0440\u0435\u0432'\u044F\u043D\u0456 \u0430\u0431\u043E
      \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u0456 \u043F\u0438\u0441\u044C\u043C\u043E\u0432\u0456
      \u0441\u0442\u043E\u043B\u0438, \u0434\u0438\u0432\u0430\u043D\u0438 \u0430\u0431\u043E
      \u044F\u0449\u0438\u043A\u0438. \u0417\u0430\u043B\u0438\u0448\u0430\u0439\u0442\u0435\u0441\u044F
      \u0442\u0430\u043C \u0430\u0436 \u0434\u043E \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043D\u044F
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824249
    m_Localized: "\u0423\u0441\u0456\u043C \u043F\u0435\u0433\u0430\u0441\u0430\u043C
      \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E \u043F\u0456\u0434\u043D\u0456\u043C\u0430\u0442\u0438\u0441\u044F
      \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u044F, \u0443\u0441\u0456\u043C
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430\u043C - \u0442\u043E\u0440\u043A\u0430\u0442\u0438\u0441\u044F
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C \u0456 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
      \u041F\u043E\u0434\u0456\u0431\u043D\u0456 \u0434\u0456\u0457 \u043F\u0456\u0434
      \u0447\u0430\u0441 \u0434\u0456\u0457 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u043E\u0433\u043E
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0431\u0443\u0442\u0438 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C\u0438. \u0422\u0430\u043A\u043E\u0436
      \u043F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435, \u0449\u043E \u0433\u0443\u043C\u043E\u0432\u0435
      \u0432\u0437\u0443\u0442\u0442\u044F \u0430\u0431\u043E \u0437\u0430\u0445\u0438\u0441\u043D\u0456
      \u043A\u043E\u0441\u0442\u044E\u043C\u0438 \u043D\u0435 \u0432\u0440\u044F\u0442\u0443\u044E\u0442\u044C
      \u0432\u0430\u0441 \u0432\u0456\u0434 \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u043C \u0441\u0442\u0440\u0443\u043C\u043E\u043C,
      \u0445\u043E\u0447\u0430 \u0439 \u043F\u043E\u0441\u043B\u0430\u0431\u043B\u044F\u0442\u044C
      \u0439\u043E\u0433\u043E \u0432\u043F\u043B\u0438\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824250
    m_Localized: "\u041D\u0430 \u0447\u0430\u0441 \u0434\u0456\u0457 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u043E\u0433\u043E
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0440\u043E\u0431\u043E\u0442\u0438\u0437\u043E\u0432\u0430\u043D\u0430
      \u043E\u0445\u043E\u0440\u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u0443 \u0441\u0442\u0430\u043D \u0431\u043E\u0439\u043E\u0432\u043E\u0457
      \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0456. \u0423 \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u043E\u0441\u0442\u0456
      \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0445 \u0440\u043E\u0431\u043E\u0442\u0456\u0432
      \u043D\u0435 \u0440\u043E\u0431\u0456\u0442\u044C \u0440\u0456\u0437\u043A\u0438\u0445
      \u0440\u0443\u0445\u0456\u0432 \u0456 \u0442\u0440\u0438\u043C\u0430\u0439\u0442\u0435
      \u043D\u0430 \u0432\u0438\u0434\u0443 \u0432\u0430\u0448\u0456 ID-\u043A\u0430\u0440\u0442\u043A\u0438.
      \u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435, \u0449\u043E \u0432\u0456\u0434
      \u0437\u043D\u0430\u043D\u043D\u044F \u0442\u0430 \u0447\u0456\u0442\u043A\u043E\u0433\u043E
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0432\u0441\u0456\u0445
      \u0446\u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0430\u0448\u0435 \u0436\u0438\u0442\u0442\u044F \u0442\u0430 \u0431\u0435\u0437\u043F\u0435\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824251
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u043F\u0440\u043E \u0434\u0456\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824252
    m_Localized: "\u0422\u0456\u043B\u044C\u043A\u0438 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438.
      \u041D\u0435 \u0437\u043D\u0430\u0442\u0438 \u043F\u0440\u043E \u0441\u0432\u0456\u0439
      \u0434\u0456\u043C \u0442\u0430\u043A \u0434\u043E\u0432\u0433\u043E, \u0449\u043E\u0431
      \u0443 \u043F\u0456\u0434\u0441\u0443\u043C\u043A\u0443 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u043E\u0432\u043E\u0433\u043E \u0434\u043B\u044F \u0441\u0435\u0431\u0435
      \u043D\u0435 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824253
    m_Localized: "\u0422\u0438 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0440\u0430\u0434\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u043C\u0443
      \u0448\u0432\u0438\u0434\u043A\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824254
    m_Localized: "\u0410 \u0445\u0456\u0431\u0430 \u0442\u0438 \u0440\u0430\u0434\u0430,
      @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824255
    m_Localized: "\u042F? \u041D\u0435 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430.
      \u042F \u0445\u043E\u0447\u0443 \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
      \u0434\u0456\u043C. \u0410\u043B\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824256
    m_Localized: "\u0410\u043B\u0435 \u0437\u043D\u0430\u043D\u043D\u044F \u043F\u0440\u043E
      \u0442\u0435, \u0449\u043E \u043A\u043E\u0457\u0442\u044C\u0441\u044F \u0442\u0443\u0442,
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456, \u043D\u0435
      \u0434\u0430\u0441\u0442\u044C \u0442\u043E\u0431\u0456 \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E
      \u0441\u043F\u0430\u0442\u0438, \u0432\u0456\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824257
    m_Localized: "... \u0412\u0456\u0440\u043D\u043E. \u0406 \u0442\u0435, \u0449\u043E
      \u043C\u0438 \u0434\u0430\u0432\u043D\u043E \u043C\u043E\u0433\u043B\u0438
      \u0432\u0442\u0440\u0443\u0442\u0438\u0442\u0438\u0441\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824258
    m_Localized: "... \u043D\u0435 \u0434\u043E\u0434\u0430\u0454 \u0440\u0430\u0434\u043E\u0441\u0442\u0456
      \u0434\u043E \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u0432\u0435\u0447\u0456\u0440\u043A\u0438
      \u0437 \u043D\u0430\u0433\u043E\u0434\u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F.
      \u0422\u0438 \u043D\u0435 \u0431\u0435\u0437\u043D\u0430\u0434\u0456\u0439\u043D\u0430,
      @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824259
    m_Localized: "\u0422\u0438 \u043F\u0440\u043E \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824260
    m_Localized: "\u041F\u0440\u043E \u0442\u0435, \u0449\u043E \u0436\u0438\u0442\u0435\u043B\u0456
      \u041F\u0443\u0441\u0442\u043A\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0442\u0435\u0431\u0435, \u043A\u043E\u043B\u0438 \u043D\u0430\u0441\u0442\u0430\u043D\u0435
      \u0447\u0430\u0441 \u0421\u0442\u0456\u0439\u043B\u0443 \u041F\u0456 \u043D\u0430\u0440\u0435\u0448\u0442\u0456
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0441\u044F \u0441\u0432\u0456\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824261
    m_Localized: "\u042F\u043A\u0449\u043E \u0432\u043E\u043D\u043E \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C
      \u043D\u0435 \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u0438
      \u043D\u0430\u0448\u043E\u0457 \u0432\u043E\u043B\u0456. \u0423 \u043F\u0435\u0440\u0448\u0438\u0439
      \u0456 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824262
    m_Localized: "\u0423 \u043D\u0430\u0441 \u0443\u0441\u0435 \u0449\u0435 \u0454
      \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u0440\u043E\u0437\u0432'\u044F\u0437\u0430\u0442\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E \u044F\u043A\u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824263
    m_Localized: "\u041F\u043E\u043A\u0438 \u0442\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438\u043C\u0435\u0448
      \u0440\u043E\u0437\u0432\u0456\u0434\u043A\u0443 \u0431\u0430\u0437\u0438 \u0410\u043D\u043A\u043B\u0430\u0432\u0443,
      \u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443 \u0437\u0435\u0431\u0440\u0430\u043C
      \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430 \u0432 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F\u0445.
      \u0410 \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430\u0439\u0442\u043E\u0447\u043D\u0456\u0448\u0435 \u0440\u043E\u0437\u0432\u0456\u0434\u0430\u0442\u0438
      \u0434\u043B\u044F \u043D\u0430\u0441 \u043F\u043E\u0442\u043E\u0447\u043D\u0443
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E \u0432 \u0440\u0435\u0433\u0456\u043E\u043D\u0456.
      \u041C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0431\u0443\u0442\u0438
      \u0433\u043E\u0442\u043E\u0432\u0456 \u0434\u043E \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0440\u043E\u0437\u0432\u0438\u0442\u043A\u0443 \u043F\u043E\u0434\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824264
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437\u0456 \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824265
    m_Localized: "\u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824266
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824267
    m_Localized: "\u042F \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435 \u0437\u043E\u0432\u0441\u0456\u043C
      \u0440\u043E\u0437\u0443\u043C\u0456\u044E... \u041D\u0430\u0432\u0456\u0449\u043E
      \u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u0448 \u0421\u0442\u0456\u0439\u043B\u0443
      \u041F\u0456? \u0422\u0438 \u0436 \u043D\u0435 \u0437 \u043D\u0430\u0448\u0438\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824268
    m_Localized: "\u041D\u0456, \u0456 \u044F \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0456\u043A\u043E\u043B\u0438 \u0443 \u0432\u0430\u0441 \u043D\u0435
      \u0431\u0443\u0432\u0430\u0432. \u0421\u043A\u0430\u0436\u0456\u043C\u043E
      \u0442\u0430\u043A. \u042F \u0432\u0436\u0435 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0434\u0430\u0432\u043D\u043E \u0441\u0442\u0435\u0436\u0443 \u0437\u0430
      \u0432\u0430\u0448\u0438\u043C\u0438 \u0441\u043F\u0440\u043E\u0431\u0430\u043C\u0438
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0456\u0432.
      \u0406 \u044F \u0432\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u044E
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0456\u0437 \u0442\u0432\u043E\u0457\u043C
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824269
    m_Localized: "\u0427\u043E\u043C\u0443 \u0436 \u0442\u043E\u0434\u0456 \u043D\u0435
      \u0434\u043E\u0431\u0443\u0432 \u0457\u0445 \u0441\u0430\u043C? \u0426\u0435
      \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u043E \u0431 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u043C\u0438\u043D\u0443\u043B\u0438\u0445 \u041E\u0431\u0440\u0430\u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824270
    m_Localized: "\u0421\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0456\u0432
      \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0437\u0432\u0430\u0442\u0438
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C
      \u0434\u043B\u044F \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F
      \u0432 \u043C\u0456\u0441\u0446\u044F, \u0434\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F
      \u043F\u043E\u0434\u0456\u0431\u043D\u0456 \u0440\u0435\u0447\u0456. \u0410
      \u0456\u043D\u0448\u0438\u0445 \u0443 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454.
      \u0421\u043A\u0430\u0436\u0438 \u0441\u043F\u0430\u0441\u0438\u0431\u0456,
      \u0449\u043E \u044F \u0437'\u044F\u0441\u0443\u0432\u0430\u0432 \u0445\u043E\u0447\u0430
      \u0431 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u0435 \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F
      \u0446\u0438\u0445 \u0440\u0435\u043B\u0456\u043A\u0432\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824271
    m_Localized: "\u0422\u0438 \u0437'\u044F\u0441\u0443\u0432\u0430\u0432? \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0436\u0435 \u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E
      \u043F\u0440\u043E \u0446\u0435 \u0432\u0437\u044F\u0442\u043E \u0437 \u0430\u0440\u0445\u0456\u0432\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824272
    m_Localized: "\u041D\u0456\u0431\u0438 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u043C
      \u043F\u043E\u043D\u0456 \u0431\u0443\u043B\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u043E\u0448\u0438\u0440\u044E\u0432\u0430\u0442\u0438 \u043F\u043E\u0434\u0456\u0431\u043D\u0456
      \u0441\u0435\u043A\u0440\u0435\u0442\u0438 \u043F\u043E \u0432\u0441\u044F\u043A\u0438\u0445
      \u0442\u0430\u043C \u0430\u0440\u0445\u0456\u0432\u0430\u0445. \u041F\u0440\u043E
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u043B\u044C\u043D\u0438\u0445 \u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0445
      \u0440\u0435\u0447\u0435\u0439 \u0431\u0443\u043B\u0438 \u043E\u0431\u0456\u0437\u043D\u0430\u043D\u0456,
      \u043A\u0440\u0456\u043C \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0437\u0430\u0434\u0456\u044F\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443,
      \u0443 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u043E\u043C\u0443 \u0440\u0430\u0437\u0456
      \u043E\u0434\u0438\u043D\u0438\u0446\u0456 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448
      \u0432\u0438\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0445
      \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824273
    m_Localized: "\u0422\u0438 \u0442\u0430\u043A \u0456 \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0432.
      \u0427\u043E\u043C\u0443 \u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u0448
      \u043D\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824274
    m_Localized: "\u041E, \u0446\u0435 \u0433\u0430\u0440\u043D\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F.
      \u0410\u043B\u0435 \u043F\u043E\u043A\u0438 \u0449\u0435 \u0440\u0430\u043D\u043E
      \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438.
      \u042F\u043A\u0449\u043E \u0446\u0435 \u0432\u0438\u044F\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u043C, \u044F \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C
      \u0442\u043E\u0431\u0456 \u043F\u0440\u043E \u043C\u043E\u0457 \u0446\u0456\u043B\u0456.
      \u0410\u043B\u0435 \u043D\u0435 \u0440\u0430\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824275
    m_Localized: "\u041A\u043E\u043D\u0444\u043B\u0456\u043A\u0442 \u0437 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824276
    m_Localized: "\u041A\u0430\u043F\u0456\u0442\u0430\u043D\u0435! \u041A\u0430\u043F\u0456\u0442\u0430\u043D\u0435,
      \u0434\u0438\u0432\u0456\u0442\u044C\u0441\u044F! \u0429\u0435 \u043E\u0434\u043D\u0430
      \u0441\u043C\u0456\u0442\u0442\u0454\u0432\u0430! \u0414\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435,
      \u044F \u0457\u0457 \u043F\u0440\u0438\u0441\u0442\u0440\u0435\u043B\u044E?
      \u041C\u0438\u043D\u0443\u043B\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u0441\u0442\u0440\u0456\u043B\u044F\u043B\u0430
      \u0424\u043B\u0456\u0442\u0444\u0443\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824277
    m_Localized: "\u0414\u043E\u0437\u0432\u043E\u043B\u044F\u044E. \u0422\u0432\u043E\u044F
      \u0447\u0435\u0440\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824278
    m_Localized: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439\u0442\u0435! \u042F
      \u043F\u0440\u0438\u0439\u0448\u043B\u0430 \u0437 \u043C\u0438\u0440\u043E\u043C!
      \u042F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824279
    m_Localized: "... \u0456 \u0437 \u043C\u0438\u0440\u043E\u043C \u0442\u0438 \u0431\u0443\u0434\u0435\u0448
      \u0442\u0443\u0442 \u0441\u043F\u043E\u0447\u0438\u0432\u0430\u0442\u0438.
      \u041D\u0435 \u0432\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0438
      \u043D\u0430 \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044E \u0410\u043D\u043A\u043B\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824280
    m_Localized: "\u0427\u043E\u043C\u0443? \u0427\u043E\u043C\u0443 \u0437\u043D\u043E\u0432\u0443
      \u0432\u0441\u0435 \u0437\u0430\u043A\u0456\u043D\u0447\u0443\u0454\u0442\u044C\u0441\u044F
      \u0442\u0430\u043A? \u042F \u0436 \u0445\u043E\u0442\u0456\u043B\u0430... \u0431\u0443\u0442\u0438
      \u043C\u0438\u0440\u043D\u043E\u044E... \u0427\u043E\u043C\u0443 \u0432\u043E\u043D\u0438
      \u0432\u0441\u0456 \u043D\u0435 \u0445\u043E\u0447\u0443\u0442\u044C \u0436\u0438\u0442\u0438
      \u043C\u0438\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824281
    m_Localized: "\u0427\u043E\u043C\u0443 \u044F \u0437\u043D\u043E\u0432\u0443
      \u043C\u0430\u044E \u0432\u0431\u0438\u0432\u0430\u0442\u0438 \u043F\u043E\u043D\u0456?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824282
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0438\u0439 \u0446\u0435\u043D\u0442\u0440.
      \u041D\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441 \u043F\u043E\u043A\u0456\u043D\u0447\u0438\u0442\u0438
      \u0437 \u0446\u0438\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824283
    m_Localized: "\u041F\u043B\u0430\u043D\u0438 \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824284
    m_Localized: "\u0421\u0442\u0456\u0439 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456,
      \u0432\u0438\u0440\u043E\u0434\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824285
    m_Localized: "\u0422\u0438\u0445\u0456\u0448\u0435, \u0442\u0438\u0445\u0456\u0448\u0435!
      \u042F \u0437\u0434\u0430\u044E\u0441\u044F, \u044F \u0437\u0434\u0430\u044E\u0441\u044F!
      \u041D\u0435 \u0432\u0431\u0438\u0432\u0430\u0439 \u043C\u0435\u043D\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824286
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0443
      \u0442\u043E\u0431\u0456 \u0433\u0430\u0440\u0430\u043D\u0442\u0443\u0432\u0430\u0442\u0438.
      \u0429\u043E \u0432\u0438 \u0442\u0443\u0442 \u0440\u043E\u0431\u0438\u0442\u0435?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824287
    m_Localized: "\u0429\u043E? \u0425\u0442\u043E \"\u043C\u0438\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824288
    m_Localized: "\u0412\u0438, \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F,
      \u0447\u043E\u0440\u0442\u0438 \u0431 \u0432\u0430\u0441 \u043F\u043E\u0431\u0440\u0430\u043B\u0438!
      \u0410\u043D\u043A\u043B\u0430\u0432! \u0429\u043E \u0432\u0438 \u0440\u043E\u0431\u0438\u0442\u0435
      \u0442\u0443\u0442, \u0443 \u041F\u0443\u0441\u0442\u0446\u0456? \u041D\u0430\u0432\u0456\u0449\u043E
      \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824289
    m_Localized: "\u041C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E... \u041C\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0439\u043C\u0430\u043B\u0438\u0441\u044F
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F\u043C\u0438!
      \u041C\u0438 \u0432\u0438\u0432\u0447\u0430\u043B\u0438 \u0446\u0435 \u043C\u0456\u0441\u0446\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824290
    m_Localized: "\u0411\u0440\u0435\u0448\u0435\u0448. \u0412\u0438 \u0431 \u043D\u0435
      \u043F\u043E\u0441\u043B\u0430\u043B\u0438 \u0441\u044E\u0434\u0438 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432 \u0437\u0430\u0440\u0430\u0434\u0438
      \"\u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C\". \u0417\u0431\u0440\u0435\u0448\u0435\u0448
      \u043C\u0435\u043D\u0456 \u0449\u0435 \u0440\u0430\u0437 - \u043F\u043E\u0448\u043A\u043E\u0434\u0443\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824291
    m_Localized: "\u042F \u043D\u0435 \u0431\u0440\u0435\u0448\u0443! \u041D\u0435
      \u0431\u0440\u0435\u0448\u0443! \u0421\u043E\u043B\u0434\u0430\u0442\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u043D\u0430\u043C \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443! \u041D\u0435
      \u043E\u0431\u0440\u0430\u0436\u0430\u0439\u0441\u044F, \u0430\u043B\u0435
      \u0432\u0438 \u0442\u0443\u0442, \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456,
      \u0431\u0443\u0432\u0430\u0454\u0442\u0435 \u0434\u0443\u0436\u0435... \u043C\u043C\u043C...
      \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u043E
      \u0434\u043E\u0431\u0440\u043E\u0437\u0438\u0447\u043B\u0438\u0432\u0456. \u0410\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u043E
      \u0434\u043E\u0431\u0440\u043E\u0437\u0438\u0447\u043B\u0438\u0432\u0456, \u0442\u0430\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824292
    m_Localized: "\u041C\u0438? \u0412\u0430\u0448\u0456 \u0441\u043E\u043B\u0434\u0430\u0442\u0438
      \u0431\u0456\u043B\u044F \u0432\u0445\u043E\u0434\u0443 \u043D\u0430\u043F\u0430\u043B\u0438
      \u043D\u0430 \u043C\u0435\u043D\u0435, \u043D\u0435 \u0434\u0430\u0432\u0448\u0438
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0448\u0430\u043D\u0441\u0443 \u043D\u0430
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824293
    m_Localized: "\u0411\u043E \u0442\u0432\u0456\u0439 \u0437\u0435\u043C\u043D\u0438\u0439
      \u0440\u0456\u0434 \u0443\u0436\u0435 \u043D\u0435 \u0440\u0430\u0437 \u0442\u0430\u043A
      \u043E\u0431\u043C\u0430\u043D\u044E\u0432\u0430\u0432 \u043D\u0430\u0441 \u0456
      \u0432\u0431\u0438\u0432\u0430\u0432 \u043E\u0445\u043E\u0440\u043E\u043D\u0443!
      \u041E\u0439, \u0432\u0438\u0431\u0430\u0447! \u042F \u043C\u0430\u0432 \u043D\u0430
      \u0443\u0432\u0430\u0437\u0456 \"\u0434\u0435\u044F\u043A\u0456, \u0441\u0445\u043E\u0436\u0456
      \u043D\u0430 \u0442\u0435\u0431\u0435\". \u041D\u0435 \u0441\u0442\u0440\u0456\u043B\u044F\u0439
      \u0443 \u043C\u0435\u043D\u0435, \u043F\u0440\u043E\u0448\u0443, \u044F \u043D\u0435
      \u0445\u043E\u0442\u0456\u0432 \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u043D\u0456\u0447\u043E\u0433\u043E
      \u0442\u0430\u043A\u043E\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824294
    m_Localized: "\u0429\u043E \u0441\u0430\u043C\u0435 \u0432\u0438 \u0442\u0443\u0442
      \u0432\u0438\u0432\u0447\u0430\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824295
    m_Localized: "\u041D\u0443, \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448,
      \u043C\u0438... \u043F\u0435\u0433\u0430\u0441\u0438 \u0437\u0430\u043A\u0440\u0438\u043B\u0438\u0441\u044F
      \u0432\u0456\u0434 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0434\u0443\u0436\u0435
      \u0434\u0430\u0432\u043D\u043E. \u041C\u0438, \u0437\u0432\u0456\u0441\u043D\u043E,
      \u043F\u043E\u0433\u043B\u044F\u0434\u0430\u0454\u043C\u043E \u0441\u044E\u0434\u0438
      \u0437\u0432\u0435\u0440\u0445\u0443, \u043D\u0443, \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E.
      \u0410\u043B\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043F\u043E\u0433\u0430\u043D\u043E\u0433\u043E
      \u043C\u0438 \u043D\u0435 \u0445\u043E\u0442\u0456\u043B\u0438! \u0427\u0435\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824296
    m_Localized: "\u0417\u0430\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F \u0456
      \u0440\u043E\u0437\u043A\u0430\u0436\u0438 \u0432\u0441\u0435 \u043F\u043E
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443. \u042F \u043D\u0435 \u0431\u0443\u0434\u0443
      \u0437\u0430\u0440\u0430\u0437 \u0443 \u0442\u0435\u0431\u0435 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824297
    m_Localized: "\u0422\u043E\u0447\u043D\u043E? \u041E\u0442\u0436\u0435, \u043D\u0430\u043C
      \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u0432\u0438\u0432\u0447\u0438\u0442\u0438
      \u0432\u0430\u0441. \u0422\u043E\u0431\u0442\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E.
      \u042F\u043A \u0432\u0438 \u0437\u043C\u0456\u043D\u0438\u043B\u0438\u0441\u044F,
      \u0449\u043E \u0442\u0443\u0442 \u043D\u043E\u0432\u043E\u0433\u043E, \u0449\u043E
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438...
      \u041D\u0443, \u043A\u0443\u043F\u0438\u0442\u0438 \u0443 \u0432\u0430\u0441.
      \u041C\u0438 \u0432\u0438\u0432\u0447\u0430\u043B\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0434\u043B\u044F \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457 \u0437
      \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u044E \u0444\u0430\u0443\u043D\u043E\u044E,
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438, \u0441\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u0430
      \u043F\u043E\u043D\u0456. \u0429\u043E\u0431, \u044F\u043A\u0449\u043E \u043C\u0438
      \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0434\u043E \u0432\u0430\u0441, \u043C\u0438 \u0437\u043D\u0430\u043B\u0438,
      \u0447\u043E\u0433\u043E \u0447\u0435\u043A\u0430\u0442\u0438. \u041D\u0430\u043C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u043B\u043E \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u043D\u0430\u0437\u0435\u043C\u043D\u0443 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044E
      \u0434\u043B\u044F \u0446\u0438\u0445 \u0446\u0456\u043B\u0435\u0439, \u0456...
      \u043E\u0441\u044C, \u043C\u0438 \u0442\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824298
    m_Localized: "\u0429\u043E, \u0437\u043E\u0432\u0441\u0456\u043C-\u0437\u043E\u0432\u0441\u0456\u043C
      \u043C\u0438\u0440\u043D\u043E? \u0416\u043E\u0434\u043D\u0438\u0445 \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u044C
      \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u0439, \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432,
      \u0436\u0438\u0442\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824299
    m_Localized: "\u041D\u0443... \u0435\u043C\u043C... \u042F \u043D\u0435 \u0432\u0438\u0440\u0456\u0448\u0443\u044E
      \u0446\u0456 \u043F\u0438\u0442\u0430\u043D\u043D\u044F. \u042F \u043D\u0435
      \u0437\u043D\u0430\u044E \u043D\u0430\u0432\u0456\u0442\u044C! \u041F\u043E\u0432\u0456\u0440!
      \u0412\u0456\u0434\u043F\u0443\u0441\u0442\u0438 \u043C\u0435\u043D\u0435,
      \u0456 \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u044E \u0432\u043C\u043E\u0432\u0438\u0442\u0438
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0435
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438 \u0441\u044E\u0434\u0438
      \u043A\u0430\u0440\u0430\u043B\u044C\u043D\u0443 \u0435\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0456\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824300
    m_Localized: "\u041A\u0430\u0440\u0430\u043B\u044C\u043D\u0443 \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824301
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E, \u043D\u0456\u0447\u043E\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824302
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824303
    m_Localized: "\u0423 \u043D\u0430\u0441 \u0431\u0443\u043B\u043E \u0440\u043E\u0437\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F!
      \u042F\u043A\u0449\u043E \u0431\u0430\u0437\u0430 \u043F\u0456\u0434\u0434\u0430\u0441\u0442\u044C\u0441\u044F
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u043C\u0443 \u043D\u0430\u043F\u0430\u0434\u0443
      \u0456 \u0437\u0430\u0437\u043D\u0430\u0454 \u0437\u043D\u0430\u0447\u043D\u0438\u0445
      \u0432\u0442\u0440\u0430\u0442 \u0432 \u043E\u0441\u043E\u0431\u043E\u0432\u043E\u043C\u0443
      \u0441\u043A\u043B\u0430\u0434\u0456, \u043F\u0440\u043E \u0446\u0435 \u043D\u0435\u0433\u0430\u0439\u043D\u043E
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430\u0432\u0435\u0440\u0445! \u042F\u043A\u0431\u0438 \u044F \u043C\u0456\u0433,
      \u044F \u0431 \u043D\u0435 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0432
      \u043D\u0456\u0447\u043E\u0433\u043E \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438,
      \u044F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0432\u0456\u0439\u043D\u0438!
      \u042F \u0441\u043A\u0430\u0436\u0443, \u0449\u043E \u0432 \u043D\u0430\u0441
      \u0432\u0438\u043D\u0438\u043A\u043B\u043E... \u043D\u0435\u043F\u043E\u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F,
      \u0442\u0430\u043A! \u041D\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438
      \u043E\u0434\u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E. \u041C\u043E\u0436\u0435,
      \u043D\u0430\u0448 \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043F\u043E\u043C'\u044F\u043A\u0448\u0438\u0442\u044C\u0441\u044F \u0456
      \u043E\u0431\u043C\u0435\u0436\u0438\u0442\u044C\u0441\u044F \u0437\u0430\u0447\u0438\u0441\u0442\u043A\u043E\u044E
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0430\u0440\u0438 \u0441\u0456\u043B.
      \u0421\u043A\u0430\u0436\u0438, \u0437\u0432\u0456\u0434\u043A\u0438 \u0442\u0438,
      \u0456 \u0442\u0443\u0434\u0438 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u043F\u0440\u0438\u043B\u0435\u0442\u044F\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824304
    m_Localized: "\u0412\u0430\u0448\u0435 \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u043E...
      \u0412\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0430\u0440\u043C\u0456\u044E?
      \u0406 \u0432\u0431\u0438\u0432\u0430\u0442\u0438\u043C\u0435 \u0432\u0441\u0456\u0445
      \u043F\u0456\u0434\u0440\u044F\u0434 \u0437\u0430 \u0446\u0435\u0439 \u043D\u0430\u043F\u0430\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824305
    m_Localized: "\u0415\u043C... \u042F \u0437\u0430 \u043D\u0438\u0445 \u043D\u0435
      \u0433\u043E\u043B\u043E\u0441\u0443\u0432\u0430\u0432! \u042F \u0437\u0431\u0435\u0440\u0443
      \u0444\u043E\u0440\u0443\u043C, \u0442\u0430\u043A, \u0444\u043E\u0440\u0443\u043C,
      \u043C\u0438 \u043D\u0435 \u0434\u0430\u043C\u043E \u043F\u043E\u0441\u0438\u043B\u0430\u0442\u0438
      \u0432\u043D\u0438\u0437 \u0430\u0440\u043C\u0456\u044E! \u0423 \u0432\u0430\u0441
      \u0442\u0443\u0442 \u043D\u0430\u0432\u0456\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432
      \u0442\u043E\u043B\u043A\u043E\u043C \u043D\u0435\u043C\u0430\u0454!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824306
    m_Localized: "\u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u043C\u0438\u043B\u043E\u0441\u0442\u0438\u0432\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824307
    m_Localized: "\u0413\u044C\u044F\u0440\u0445! \u0417\u0434\u043E\u0445\u043D\u0438,
      \u0432\u0438\u0440\u043E\u0434\u043A\u0443! \u0426\u0435 \u0432\u0441\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0431\u0435! \u0427\u0435\u0440\u0435\u0437
      \u0432\u0430\u0441!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824308
    m_Localized: "\u0412\u0438\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824309
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442... \u042F... \u042F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824310
    m_Localized: "\u041C\u0438 \u0437\u043D\u0430\u0454\u043C\u043E, @lp. \u0425\u0430\u043E\u0441,
      \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0438\u0439 \u0442\u043E\u0431\u043E\u044E,
      \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0432 \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443 \u0431\u0430\u0437\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824311
    m_Localized: "\u0426\u0435 \u0431\u0443\u043B\u0430 \u0431\u0456\u0439\u043D\u044F,
      @lp. \u0416\u0430\u0445\u043B\u0438\u0432\u0430 \u0431\u0456\u0439\u043D\u044F.
      \u041C\u043E\u0436\u0435, \u043F\u0435\u0433\u0430\u0441\u0438 \u0439 \u0431\u0443\u043B\u0438
      \u0432\u043E\u0440\u043E\u0436\u0456 \u0434\u043E \u0442\u0435\u0431\u0435,
      \u0430\u043B\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824312
    m_Localized: "\u041C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0437\u0432\u0438\u043D\u0443\u0432\u0430\u0447\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u0437\u0430 \u0441\u043A\u043E\u0454\u043D\u0435, \u0412\u0435\u043B\u044C\u0432\u0435\u0442!
      \u041E\u0431\u0441\u0442\u0430\u0432\u0438\u043D\u0438 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
      \u0432\u043A\u0430\u0437\u0443\u0432\u0430\u043B\u0438 \u043D\u0430 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0456\u0432. \u041F\u0456\u0441\u043B\u044F
      \u0432\u0441\u0456\u0445 \u0436\u0430\u0445\u0456\u0432 \u041F\u0443\u0441\u0442\u043A\u0438
      \u043D\u0430 \u0457\u0457 \u043C\u0456\u0441\u0446\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824313
    m_Localized: "\u0404\u0434\u0438\u043D\u0435, \u0449\u043E \u0431\u0443\u043B\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \"\u043D\u0430 \u0457\u0457
      \u043C\u0456\u0441\u0446\u0456\" - \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456\u0441\u0442\u044C!
      \u041D\u0435\u0432\u0436\u0435 \u0442\u0438 \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448
      \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0438? \u041D\u0435\u0432\u0436\u0435
      \u0442\u0435\u0431\u0435 \u043D\u0435 \u0437\u0430\u0447\u0456\u043F\u0430\u0454
      \u0444\u0430\u043A\u0442 \u0437\u0430\u0433\u0438\u0431\u0435\u043B\u0456 \u0441\u0442\u0456\u043B\u044C\u043A\u043E\u0445
      \u043F\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824314
    m_Localized: "\u042F \u0431\u0430\u0447\u0438\u0432 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0434\u0456\u044F\u043D\u044C \u043D\u0435\u0437\u0440\u0456\u0432\u043D\u044F\u043D\u043D\u043E
      \u0433\u0456\u0440\u0448\u0438\u0445, \u0449\u043E\u0431 \u0442\u0432\u0435\u0440\u0435\u0437\u043E
      \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u0442\u0438 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E,
      \u044E\u043D\u0430 \u043B\u0435\u0434\u0456! \u0407\u0457 \u0440\u0456\u0448\u0435\u043D\u043D\u044F
      \u0431\u0443\u043B\u0438 \u043E\u0431\u0491\u0440\u0443\u043D\u0442\u043E\u0432\u0430\u043D\u0456!
      \u0426\u0435 \u043D\u0430\u0448\u0430 \u0432\u0438\u043D\u0430, \u0449\u043E
      \u043C\u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u043B\u0438
      \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u0445 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0456\u0432.
      \u041D\u0435 \u0447\u0430\u0441 \u0445\u0430\u043F\u0430\u0442\u0438\u0441\u044F
      \u0437\u0430 \u0433\u043E\u043B\u043E\u0432\u0443. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0434\u0456\u044F\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824315
    m_Localized: "\u041F\u0440\u043E\u0448\u0443... \u043D\u0435 \u0442\u0440\u0435\u0431\u0430.
      \u042F \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0449\u043E \u0437\u0440\u043E\u0431\u0438\u043B\u0430.
      \u042F \u043F\u043E\u043C\u0438\u043B\u0438\u043B\u0430\u0441\u044F \u0456
      \u0437\u0430\u0439\u0448\u043B\u0430 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0434\u0430\u043B\u0435\u043A\u043E. \u0410\u043B\u0435 \u0442\u043E\u0434\u0456...
      \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
      \u0432\u0447\u0438\u043D\u0438\u0442\u0438 \u0456\u043D\u0430\u043A\u0448\u0435.
      \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447 \u043C\u0430\u0454
      \u0440\u0430\u0446\u0456\u044E. \u041D\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0434\u0456\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824316
    m_Localized: "\u041C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0441\u043F\u043E\u0432\u0456\u0441\u0442\u0438\u0442\u0438
      \u0432\u0441\u0456\u0445 \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F.
      \u0412\u0441\u0456\u0445, \u043A\u043E\u0433\u043E \u043C\u043E\u0436\u0435\u043C\u043E.
      \u041D\u0430\u0431\u043B\u0438\u0436\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0439\u043D\u0430,
      \u0456 \u0432 \u043D\u0430\u0441 \u043C\u0430\u043B\u043E \u0447\u0430\u0441\u0443.
      \u0422\u0430\u043C, \u043D\u0430 \u0431\u0430\u0437\u0456, \u0442\u0438 \u0432\u0431\u0438\u043B\u0430
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u043E\u043D\u0456, \u043D\u0456\u0436 \u0434\u0435\u0441\u044F\u0442\u043A\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432 \u0410\u043D\u043A\u043B\u0430\u0432\u0443,
      @lp. \u041D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824317
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442! \u041D\u0435 \u043A\u0438\u0434\u0430\u0439\u0441\u044F
      \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u043C\u0438 \u0437\u0432\u0438\u043D\u0443\u0432\u0430\u0447\u0435\u043D\u043D\u044F\u043C\u0438.
      \u042F \u0432\u0436\u0435 \u043F\u0440\u0430\u0446\u044E\u044E \u043D\u0430\u0434
      \u0442\u0438\u043C, \u0449\u043E\u0431 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u0438
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456.
      \u0410 \u0442\u043E\u0431\u0456, @lp, \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u0438 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430.
      \u0406 \u0432\u0456\u0434\u0434\u0430\u0442\u0438 \u0439\u043E\u043C\u0443
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0439\u043E\u043C\u0443 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u043F\u0440\u043E\u0454\u043A\u0442\u0438 \"\u0421\u043E\u043D\u0446\u0435\"
      \u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\". \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0432\u0456\u043D \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u043E\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430\u043C \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824318
    m_Localized: "\u0412\u0438\u0431\u0430\u0447, @lp, \u0430\u043B\u0435 \u044F
      \u0437\u0430\u043B\u0438\u0448\u0443\u0441\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447\u0443. \u0425\u043E\u0447
      \u0431\u0438 \u044F\u043A \u044F \u0445\u043E\u0442\u0456\u043B\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0434\u043E\u0434\u043E\u043C\u0443,
      \u043C\u043E\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0438\u043C\u0438 \u0442\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824319
    m_Localized: "\u0413\u0430\u0440\u0430\u0437\u0434. \u0422\u043E\u0434\u0456
      \u044F \u0432\u0438\u0457\u0434\u0443 \u043D\u0435\u0433\u0430\u0439\u043D\u043E.
      ... \u041F\u0440\u043E\u0431\u0430\u0447 \u043C\u0435\u043D\u0435, \u0412\u0435\u043B\u044C\u0432\u0435\u0442.
      \u042F... \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
      \u0431\u0443\u0442\u0438 \u043C\u0438\u043B\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824320
    m_Localized: "\u041D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u0440\u043E\u0441\u0438\u0442\u0438
      \u0432\u0438\u0431\u0430\u0447\u0435\u043D\u043D\u044F \u0443 \u043C\u0435\u043D\u0435.
      \u0422\u0438 \u0441\u0430\u043C\u0430 \u0431\u0443\u0434\u0435\u0448 \u0441\u043E\u0431\u0456
      \u0441\u0443\u0434\u0434\u0435\u044E. \u0406 \u043D\u0456\u0445\u0442\u043E
      \u043D\u0435 \u0431\u0443\u0434\u0435 \u0434\u043E \u0442\u0435\u0431\u0435
      \u0442\u0430\u043A \u0441\u0443\u0432\u043E\u0440\u0438\u0439, \u044F\u043A
      \u0442\u0438 \u0441\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824321
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436, @lp, \u0445\u043E\u0447 \u0442\u0438
      \u0456 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043B\u0430 \u0440\u0456\u0437\u0430\u043D\u0438\u043D\u0443
      \u0442\u0430\u043C, \u043D\u0430 \u0431\u0430\u0437\u0456, \u0442\u0438 \u043F\u043E\u0449\u0430\u0434\u0438\u043B\u0430
      \u0442\u043E\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430,
      \u0449\u043E \u0441\u043A\u043B\u0430\u0432 \u0437\u0431\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824322
    m_Localized: "\u0422\u0430\u043A. \u042F \u043F\u043E\u0449\u0430\u0434\u0438\u043B\u0430
      \u0439\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824323
    m_Localized: "\u041B\u0438\u0448\u0435 \u043E\u0434\u0438\u043D \u043A\u0440\u043E\u043A
      \u0443\u043F\u0435\u0440\u0435\u0434 \u043F\u0456\u0441\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E,
      \u0449\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F. \u0410\u043B\u0435
      \u0446\u0435\u0439 \u043A\u0440\u043E\u043A \u0437\u0431\u0435\u0440\u0456\u0433
      \u0436\u0438\u0442\u0442\u044F \u043F\u043E\u043D\u0456. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824324
    m_Localized: "\u041D\u0435\u0445\u0430\u0439 \u0442\u0438 \u0456 \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u043F\u043E\u043C\u0438\u043B\u043A\u0443, @lp, \u0430\u043B\u0435 \u0446\u0435\u0439
      \u0432\u0447\u0438\u043D\u043E\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043F\u0440\u043E \u0442\u0435\u0431\u0435 \u0431\u0430\u0433\u0430\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824325
    m_Localized: "\u0422\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440,
      \u044F\u043A\u043E\u0433\u043E \u0442\u0438 \u0432\u0431\u0438\u043B\u0430...
      \u0432\u0456\u043D \u0442\u043E\u0434\u0456 \u0437\u0434\u0430\u0432\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824326
    m_Localized: "\u0422\u0430\u043A. \u042F \u0432\u0431\u0438\u043B\u0430 \u0439\u043E\u0433\u043E,
      \u0442\u043E\u043C\u0443 \u0449\u043E... \u043D\u0435 \u0437\u043D\u0430\u044E.
      \u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u0446\u0435 \u0449\u043E\u0441\u044C
      \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u044C. \u042F \u043D\u0435
      \u0437\u043E\u0432\u0441\u0456\u043C \u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430
      \u0442\u043E\u0434\u0456, \u0449\u043E \u0440\u043E\u0431\u043B\u044E. \u0406
      \u044F \u043D\u0435 \u043F\u043E\u0432\u0456\u0440\u0438\u043B\u0430 \u0439\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824327
    m_Localized: "\u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447
      \u043C\u0430\u0432 \u0440\u0430\u0446\u0456\u044E, \u043A\u043E\u043B\u0438
      \u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0432 \u0442\u0435\u0431\u0435
      \u0431\u0443\u043B\u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u0434\u043B\u044F
      \u0446\u044C\u043E\u0433\u043E \u043D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0410\u043B\u0435 \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438. \u0404
      \u043C\u0435\u0436\u0456, \u044F\u043A\u0456 \u043A\u0440\u0430\u0449\u0435
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0442\u0438\u043D\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824328
    m_Localized: "\u0428\u043B\u044F\u0445 \u0434\u043E\u0434\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824329
    m_Localized: "\u042F\u043A \u044F \u043C\u043E\u0436\u0443 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0434\u043E \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824330
    m_Localized: "\u0426\u0435 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0435,
      \u043D\u0456\u0436 \u0442\u0438 \u043C\u043E\u0433\u043B\u0430 \u0431 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438.
      \u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u0439\u043D\u0430
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430, \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0430
      \u0432 \u0421\u0438\u0441\u0442\u0435\u043C\u0443 \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0416\u0438\u0442\u0442\u044F \u041C\u0422\u041D, \u043F\u043E\u0432\u0435\u0440\u043D\u0435
      \u0442\u0435\u0431\u0435 \u0434\u043E\u0434\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824331
    m_Localized: "\u0422\u0435\u0440\u043C\u0456\u043D\u0430\u043B? \u042F\u043A
      \u0432\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824332
    m_Localized: "\u0415-\u0435-\u0435... \u0427\u0438 \u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824333
    m_Localized: "\u042F \u0432\u043C\u0456\u044E \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0457 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0442\u0443\u0434\u0438, \u0434\u0435 \u0431\u0443\u043B\u0430 \u0440\u0430\u043D\u0456\u0448\u0435.
      \u042F \u0439 \u0433\u0430\u0434\u043A\u0438 \u043D\u0435 \u043C\u0430\u044E,
      \u0434\u0435 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043C\u0456\u0439 \u0434\u0456\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824334
    m_Localized: "\u0414\u043B\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F
      \u0434\u043E\u0434\u043E\u043C\u0443 \u0442\u043E\u0431\u0456 \u043D\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0439\u043E\u0433\u043E \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0438.
      \u0414\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0442\u043E\u0433\u043E,
      \u0449\u043E\u0431 \u041F\u0456\u043F\u0411\u0430\u043A \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0432
      \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C\u0443
      \u043D\u043E\u0441\u0456\u0457 \u0456 \u043C\u0456\u0441\u0442\u0438\u0432
      \u043A\u043E\u0434\u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0434\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824335
    m_Localized: "\u0406 \u0432 \u043C\u0435\u043D\u0435 \u0454 \u0446\u0456 \u043A\u043E\u0434\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824336
    m_Localized: "\u041D\u0456. \u0410\u043B\u0435 \u0432\u043E\u043D\u0438 \u0454
      \u0432 \u043C\u0435\u043D\u0435. \u041F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437
      \u0432\u043E\u043D\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0432\u0456\u0439 \u041F\u0456\u043F\u0411\u0430\u043A.
      \u0429\u0435 \u0442\u0440\u043E\u0445\u0438... \u0432\u0441\u0435, \u0433\u043E\u0442\u043E\u0432\u043E.
      \u0422\u0435\u043F\u0435\u0440 \u043C\u043E\u0436\u0435\u0448 \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u043A\u0430\u0440\u0442\u043E\u044E \u041F\u0456\u043F\u0411\u0430\u043A\u0430
      \u0456 \u0432\u0438\u0440\u0443\u0448\u0430\u0442\u0438 \u0434\u043E\u0434\u043E\u043C\u0443.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0449\u0435 \u043F\u043E\u0431\u0430\u0447\u0438\u043C\u043E\u0441\u044F,
      @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824337
    m_Localized: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439! \u0422\u0438 \u0442\u0430\u043A
      \u0456 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u0432, \u0445\u0442\u043E
      \u0436 \u0442\u0438 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456.
      \u042F\u043A\u0449\u043E \u0442\u0438 \u043D\u0435 \u043C\u0435\u0448\u043A\u0430\u043D\u0435\u0446\u044C
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456, \u0442\u043E \u044F\u043A\u0435
      \u0432\u0456\u0434\u043D\u043E\u0448\u0435\u043D\u043D\u044F \u0442\u0438 \u0434\u043E
      \u043D\u044C\u043E\u0433\u043E \u043C\u0430\u0454\u0448? \u042F\u043A\u0456
      \u0432 \u0442\u0435\u0431\u0435 \u0441\u0442\u043E\u0441\u0443\u043D\u043A\u0438
      \u0437 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C,
      \u0437\u0432\u0456\u0434\u043A\u0438 \u043A\u043E\u0434\u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u0443
      \u0456 \u0432\u0441\u044F \u0442\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F,
      \u044F\u043A\u0443 \u0442\u0438 \u043C\u0435\u043D\u0456 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0432?
      \u0422\u043E\u0431\u0456 \u043D\u0435 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0449\u043E \u044F \u043C\u0430\u044E \u043F\u0440\u0430\u0432\u043E \u0437\u043D\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824338
    m_Localized: "\u0422\u0430\u043A, \u043D\u0430\u043C \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432\u0430\u0440\u0442\u043E \u0446\u0435 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F.
      \u0414\u043E\u0432\u0456\u0440\u0430 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
      \u043E\u0431\u043E\u043F\u0456\u043B\u044C\u043D\u043E\u044E, \u0447\u0438
      \u043D\u0435 \u0442\u0430\u043A? \u0422\u0438 \u0437\u043D\u0430\u0454\u0448
      \u043F\u0440\u043E \u043D\u0430\u0441 \u0442\u0430\u043A \u0431\u0430\u0433\u0430\u0442\u043E,
      \u0430\u043B\u0435 \u043C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824339
    m_Localized: "*** \u0421\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442 \u0432\u0438\u0434\u0430\u0454
      \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0456 \u0437\u0432\u0443\u043A\u0438.
      \u041C\u0430\u0431\u0443\u0442\u044C, \u0441\u043F\u0456\u0432\u0440\u043E\u0437\u043C\u043E\u0432\u043D\u0438\u043A
      \u043D\u0430 \u0456\u043D\u0448\u043E\u043C\u0443 \u043A\u0456\u043D\u0446\u0456
      \u043B\u0456\u043D\u0456\u0457 \u0437\u0432'\u044F\u0437\u043A\u0443 \u0433\u043B\u0438\u0431\u043E\u043A\u043E
      \u0437\u0456\u0442\u0445\u043D\u0443\u0432 ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824340
    m_Localized: "\u041D\u0443 \u0434\u043E\u0431\u0440\u0435. \u0412\u0438 \u043C\u0430\u0454\u0442\u0435
      \u0440\u0430\u0446\u0456\u044E, \u044F \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C
      \u0432\u0430\u043C \u043F\u0440\u043E \u0441\u0435\u0431\u0435. \u0414\u0435\u0449\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824341
    m_Localized: "\u041D\u0430\u0439\u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456\u0448\u0435
      \u0437 \u0442\u043E\u0433\u043E, \u0449\u043E \u0432\u0430\u043C \u0441\u043B\u0456\u0434
      \u0437\u043D\u0430\u0442\u0438 \u043F\u0440\u043E \u043C\u0435\u043D\u0435,
      \u0442\u0430\u043A \u0446\u0435 \u0442\u0435, \u0449\u043E \u044F - \u0434\u0440\u0430\u043A\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824342
    m_Localized: "\u0414\u0440\u0430\u043A\u043E\u043D?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824343
    m_Localized: "\u0414\u0440\u0430\u043A\u043E\u043D? \u0410\u043B\u0435 \u0436...
      \u042F \u0447\u0438\u0442\u0430\u043B\u0430 \u043F\u0440\u043E \u0432\u0430\u0441
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 \u043A\u043D\u0438\u0436\u043A\u0430\u0445!
      \u0412\u0438 \u0432\u0441\u0435 \u0449\u0435 \u0456\u0441\u043D\u0443\u0454\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824344
    m_Localized: "\u042F \u043D\u0435 \u0431\u0430\u0447\u0438\u0432 \u043D\u0456\u043A\u043E\u0433\u043E
      \u0437\u0456 \u0441\u0432\u043E\u0433\u043E \u0440\u043E\u0434\u0443 \u0432\u0436\u0435
      \u0434\u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u044F - \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0456\u0437 \u0434\u0440\u0430\u043A\u043E\u043D\u0456\u0432
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u043A\u0440\u0430\u0457. \u0410\u043B\u0435
      \u043D\u0435 \u043C\u0435\u043D\u0448 \u0432\u0430\u0436\u043B\u0438\u0432\u043E
      \u0442\u0435, \u0449\u043E, \u044F\u043A \u0434\u0440\u0430\u043A\u043E\u043D,
      \u044F \u043C\u043E\u0436\u0443 \u043F\u0440\u043E\u0436\u0438\u0442\u0438
      \u0434\u0443\u0436\u0435 \u0434\u043E\u0432\u0433\u0438\u0439 \u0442\u0435\u0440\u043C\u0456\u043D.
      \u042F \u043F\u0430\u043C'\u044F\u0442\u0430\u044E \u0449\u0435 \u0442\u0443
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E, \u0449\u043E \u0431\u0443\u043B\u0430
      \u0434\u043E \u0432\u0456\u0439\u043D\u0438 \u0456\u0437 \u0437\u0435\u0431\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824345
    m_Localized: "\u0406... \u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043F\u0440\u043E\u0436\u0438\u0432 \u043F\u043E\u043D\u0430\u0434 \u0434\u0432\u0456
      \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824346
    m_Localized: "\u042F \u0431\u0443\u0432 \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u043E\u043C
      \u0422\u0432\u0430\u0439\u043B\u0430\u0439\u0442 \u0421\u043F\u0430\u0440\u043A\u043B,
      \u0433\u043B\u0430\u0432\u0438 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0422\u0430\u0454\u043C\u043D\u0438\u0445 \u041D\u0430\u0443\u043A. \u0406
      \u043D\u0435\u0445\u0430\u0439 \u0421\u0442\u0456\u0439\u043B\u0430 \u0437\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E
      \u0431\u0443\u043B\u0438 \u043F\u043E\u0437\u0430 \u043D\u0430\u0448\u043E\u044E
      \u044E\u0440\u0438\u0441\u0434\u0438\u043A\u0446\u0456\u0454\u044E, \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456 \u0431\u0443\u043B\u043E \u0434\u0443\u0436\u0435 \u043C\u0456\u0446\u043D\u043E
      \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0435 \u0437 \u043D\u0430\u043C\u0438.
      \u0429\u043E\u0439\u043D\u043E \u044F \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u0441\u043F\u043E\u0441\u0456\u0431 \u0437\u0432'\u044F\u0437\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0432\u0430\u043C\u0438 \u043F\u0456\u0441\u043B\u044F \u041E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u0414\u043D\u044F, \u044F \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0432
      \u0432\u0430\u043C \u0447\u0438\u043C \u043C\u0456\u0433. \u0423 \u0442\u043E\u043C\u0443
      \u0447\u0438\u0441\u043B\u0456 \u0456 \u0437 \u043F\u043E\u0448\u0443\u043A\u043E\u043C
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824347
    m_Localized: "\u0422\u043E\u0431\u0442\u043E \u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u0448
      \u043D\u0430\u043C, \u0431\u043E \u0444\u0430\u043A\u0442\u0438\u0447\u043D\u043E
      \u0441\u0442\u043E\u044F\u0432 \u0431\u0456\u043B\u044F \u043D\u0430\u0448\u0438\u0445
      \u0432\u0438\u0442\u043E\u043A\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824348
    m_Localized: "\u0406 \u0442\u0430\u043A, \u0456 \u043D\u0456. \u042F \u0440\u0456\u0434\u043A\u043E
      \u043F\u0435\u0440\u0435\u0442\u0438\u043D\u0430\u0432\u0441\u044F \u0437\u0456
      \u0421\u0442\u0456\u0439\u043B\u043E\u043C \u041F\u0456 \u0434\u043E \u043A\u0456\u043D\u0446\u044F
      \u0432\u0456\u0439\u043D\u0438. \u0410\u043B\u0435 \u043A\u043E\u043B\u0438
      \u0441\u0432\u0456\u0442 \u0437\u043D\u0438\u0449\u0438\u043B\u0438, \u044F
      \u0441\u0442\u0430\u0432 \u0445\u0430\u043F\u0430\u0442\u0438\u0441\u044F \u0437\u0430
      \u0432\u0441\u0456 \u0439\u043E\u0433\u043E \u0443\u043B\u0430\u043C\u043A\u0438,
      \u0449\u043E \u043C\u0456\u0433 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438.
      \u0417\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E \u044F \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u0437\u0443\u043C\u0456\u0432 \u0437\u0440\u043E\u0431\u0438\u0442\u0438.
      \u041E\u0434\u043D\u0430\u043A \u043F\u043E\u043A\u0438 \u0436\u0438\u0432\u0435
      \u0432\u0430\u0448\u0435 \u0421\u0442\u0456\u0439\u043B\u043E, \u0443 \u0441\u0432\u0456\u0442\u0456
      \u0454 \u0449\u0435 \u043E\u0434\u0438\u043D \u0448\u043C\u0430\u0442\u043E\u0447\u043E\u043A
      \u0432\u0456\u0434 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457,
      \u044F\u043A\u0443 \u044F \u043F\u0430\u043C'\u044F\u0442\u0430\u044E. \u042F
      \u0445\u043E\u0447\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u0439\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824349
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436... \u0414\u0440\u0430\u043A\u043E\u043D..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824350
    m_Localized: "\u041E\u0434\u043D\u0430\u043A \u0437\u0430\u0440\u0430\u0437 \u0443\u0441\u0435
      \u0446\u0435 \u043D\u0435 \u043C\u0430\u0454 \u0436\u043E\u0434\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F. \u042F \u043D\u0430\u0434\u0442\u043E
      \u0434\u0430\u043B\u0435\u043A\u043E, \u0449\u043E\u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0432\u0430\u043C \u0456\u043D\u0430\u043A\u0448\u0435, \u043D\u0456\u0436
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0456\u0432,
      \u0456 \u044F... \u043D\u0435 \u043C\u043E\u0436\u0443 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438
      \u0441\u0432\u043E\u0454 \u0436\u0438\u0442\u043B\u043E. \u0412\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0435
      \u0437\u0430\u0440\u0430\u0437 \u0442\u0435, \u0449\u043E \u043C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u0434\u0456\u044F\u0442\u0438. @lp, \u0442\u0435\u043F\u0435\u0440 \u0442\u0438
      \u043C\u043E\u0436\u0435\u0448 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E\u0434\u043E\u043C\u0443 \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B
      \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.
      \u042F \u0434\u043E\u043F\u043E\u043C\u0456\u0433 \u0432\u0430\u043C \u0447\u0438\u043C
      \u043C\u0456\u0433, \u0456 \u0437\u0430\u0440\u0430\u0437 \u043C\u0435\u043D\u0456
      \u0432\u0436\u0435 \u0447\u0430\u0441 \u043B\u0435\u0442\u0456\u0442\u0438.
      \u0410\u043B\u0435 \u0431\u0443\u0434\u0435\u043C\u043E \u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0437\u0432'\u044F\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824351
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824352
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824353
    m_Localized: "\u041E\u0446\u0435 \u0442\u0430\u043A \u0441\u043F\u0440\u0430\u0432\u0438...
      \u0422\u0430\u043A\u043E\u0433\u043E \u044F \u0442\u043E\u0447\u043D\u043E
      \u043D\u0435 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824354
    m_Localized: "\u0422\u0430\u043A! \u041D\u0430\u0440\u0435\u0448\u0442\u0456,
      \u044F \u0432\u0434\u043E\u043C\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824355
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A? \u0426\u0435
      \u0436 \u0412\u0438? \u0422\u0430\u043A... \u0442\u0435\u043F\u0435\u0440 \u044F
      \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0432\u0441\u0435 \u0437\u0433\u0430\u0434\u0430\u043B\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824356
    m_Localized: "\u041E\u0445, \u043C\u043E\u044F \u0433\u043E\u043B\u043E\u0432\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824357
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, @lp. \u041F\u0456\u0441\u043B\u044F
      \u0441\u0442\u0456\u043B\u044C\u043A\u043E\u0445 \u043C\u0456\u0441\u044F\u0446\u0456\u0432...
      \u044F \u0440\u0430\u0434\u0438\u0439 \u0442\u0435\u0431\u0435 \u0431\u0430\u0447\u0438\u0442\u0438.
      \u041D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F, \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u0431\u0456\u043B\u044C - \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0431\u0456\u0447\u043D\u0438\u0439 \u0435\u0444\u0435\u043A\u0442
      \u0432\u0456\u0434 \u0440\u043E\u0437\u0441\u0456\u044E\u0432\u0430\u043D\u043D\u044F
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043F\u0430\u043C'\u044F\u0442\u0456,
      \u0437\u0430\u0440\u0430\u0437 \u0443\u0441\u0435 \u043C\u0438\u043D\u0435.
      \u0406, \u0437\u0432\u0456\u0441\u043D\u043E \u0436, \u0432\u0456\u0442\u0430\u044E
      \u0437 \u0443\u0441\u043F\u0456\u0448\u043D\u0438\u043C \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F\u043C
      \u0442\u0432\u043E\u0454\u0457 \u043C\u0456\u0441\u0456\u0457. \u042F... \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043F\u0438\u0448\u0430\u044E\u0441\u044F \u0442\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824358
    m_Localized: "\u0414\u044F\u043A\u0443\u044E... \u042F \u0442\u0435\u0436 \u0440\u0430\u0434\u0430
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E\u0434\u043E\u043C\u0443.
      \u0410\u043B\u0435 \u043D\u0430\u043C \u0442\u0440\u0435\u0431\u0430 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0447\u043E\u0433\u043E \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824359
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E, @lp. \u0417\u0440\u043E\u0431\u0438\u043C\u043E
      \u0446\u0435 \u043D\u0435\u0432\u0456\u0434\u043A\u043B\u0430\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824360
    m_Localized: "\u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0454 \u043C\u0435\u043D\u0456
      \u0434\u043E\u0441\u0438\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0440\u043E
      \u0442\u0435, \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0430\u043B\u0435, \u0421\u0432\u044F\u0442\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F,
      \u0432\u0456\u043D \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0432
      \u043C\u0435\u043D\u0456 \u0442\u0430\u043A\u0438\u0445 \u043F\u043E\u0434\u0440\u043E\u0431\u0438\u0446\u044C!
      \u0422\u043E\u0431\u0442\u043E \u0442\u0438 \u0445\u043E\u0447\u0435\u0448
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438, \u0449\u043E \u0441\u043A\u043E\u0440\u043E
      \u043F\u0435\u0433\u0430\u0441\u0438 \u0441\u043F\u0443\u0441\u0442\u044F\u0442\u044C\u0441\u044F
      \u0437 \u0445\u043C\u0430\u0440 \u0456 \u043F\u043E\u0447\u043D\u0443\u0442\u044C
      \u0432\u0456\u0439\u043D\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824361
    m_Localized: "\u0422\u0430\u043A, \u0441\u0430\u043C\u0435 \u0442\u0430\u043A.
      \u041C\u0456\u0439 \u043D\u0430\u043F\u0430\u0434 \u043D\u0430 \u0431\u0430\u0437\u0443,
      \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0441\u043F\u0440\u043E\u0432\u043E\u043A\u0443\u0454 \u0410\u043D\u043A\u043B\u0430\u0432
      \u043D\u0430 \u043A\u0430\u043C\u043F\u0430\u043D\u0456\u044E \u0432\u0456\u0434\u043F\u043B\u0430\u0442\u0438.
      \u0421\u043A\u043E\u0440\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044F
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u0438\u0442\u0432\u0438. \u0410\u0431\u043E
      \u0431\u0456\u0439\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824362
    m_Localized: "\u0423 \u044F\u043A\u0456 \u0447\u0430\u0441\u0438 \u043D\u0430\u043C
      \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0436\u0438\u0442\u0438!
      \u0410\u043B\u0435 \u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F,
      \u043B\u044E\u0431\u0430. \u0422\u0435\u043F\u0435\u0440 \u0442\u0438 \u0442\u0443\u0442,
      \u0443\u0434\u043E\u043C\u0430 \u0456 \u0432 \u0431\u0435\u0437\u043F\u0435\u0446\u0456.
      \u0422\u0443\u0442 \u0442\u0438 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u0435\u0448,
      \u043F\u0440\u043E\u0439\u0434\u0435\u0448 \u043A\u0443\u0440\u0441 \u0440\u0435\u0430\u0431\u0456\u043B\u0456\u0442\u0430\u0446\u0456\u0457,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u0442\u0432\u043E\u0454 \u0436\u0438\u0442\u0442\u044F
      \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0442\u044C\u0441\u044F \u0432 \u043A\u043E\u043B\u0438\u0448\u043D\u0454,
      \u043C\u0438\u0440\u043D\u0435 \u0440\u0443\u0441\u043B\u043E. \u0406 \u0437\u0430
      \u0442\u0432\u043E\u0457\u043C \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C
      \u043C\u0438 \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0441\u0442\u0435\u0440\u0442\u0438
      \u043F\u0430\u043C'\u044F\u0442\u044C \u043F\u0440\u043E \u043A\u043E\u0448\u043C\u0430\u0440\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824363
    m_Localized: "\u0412\u0438\u0431\u0430\u0447\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824364
    m_Localized: "\u0425\u0456\u0431\u0430 \u0442\u0438 \u043D\u0435 \u0440\u0430\u0434\u0430
      \u043E\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F \u0442\u0443\u0442 \u0437\u043D\u043E\u0432\u0443?
      \u0422\u0456\u043B\u044C\u043A\u0438 \u0443\u044F\u0432\u0438: \u0442\u0435\u043F\u0435\u0440,
      \u043A\u043E\u043B\u0438 \u0442\u0438 \u0437\u0434\u043E\u0431\u0443\u043B\u0430
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438, \u043D\u0430\u043C
      \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u0442\u0430\u043A\u0438\u0439 \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u0438\u0439
      \u043F\u0440\u043E\u0435\u043A\u0442! \u041C\u0438 \u0432\u0441\u0456 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0440\u043E\u043A\u0456\u0432 - \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0442\u043E\u043B\u0456\u0442\u044C \u0431\u0438\u043B\u0438\u0441\u044F
      \u043D\u0430\u0434 \u0432\u0438\u0440\u0456\u0448\u0435\u043D\u043D\u044F\u043C
      \u0446\u044C\u043E\u0433\u043E \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F!
      \u041A\u043E\u043B\u0438 \u043C\u0438 \u0431\u0443\u043B\u0438 \u0442\u0430\u043A
      \u0431\u043B\u0438\u0437\u044C\u043A\u0456 \u0434\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E\u0435\u043A\u0442\u0443? \u042F \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
      @lp, \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F
      \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u0438.
      \u0410\u043B\u0435 \u043C\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u043C\u043E
      \u0442\u043E\u0431\u0456. \u041C\u0456\u0441\u0456\u0441 \u0425\u0430\u0440\u0442\u0440\u043E\u0443\u0441
      \u043D\u0430\u0434\u0430\u0441\u0442\u044C \u0442\u043E\u0431\u0456 \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u0439\u043D\u0443
      \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443,
      \u0442\u0432\u043E\u0457 \u043A\u043E\u043B\u0435\u0433\u0438 \u0456 \u0440\u0456\u0434\u043D\u0456
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C \u0442\u043E\u0431\u0456
      \u0437\u043D\u043E\u0432\u0443 \u0441\u0442\u0430\u0442\u0438 \u043D\u0430
      \u043D\u043E\u0433\u0438. \u0422\u0435\u0431\u0435 \u0431\u0443\u0434\u0443\u0442\u044C
      \u043F\u043E\u0432\u0430\u0436\u0430\u0442\u0438, @lp. \u041F\u043E\u0447\u0438\u0442\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u044F\u043A \u0433\u0435\u0440\u043E\u044F, \u043F\u0435\u0440\u0448\u043E\u0433\u043E
      \u041E\u0431\u0440\u0430\u043D\u043E\u0433\u043E, \u044F\u043A\u0438\u0439
      \u0437\u043C\u0456\u0433 \u0434\u043E\u0441\u044F\u0433\u0442\u0438 \u043C\u0435\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824365
    m_Localized: "\u0406... \u0432\u0438 \u0445\u043E\u0447\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438 \u043F\u043E\u043D\u0456 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u0432\u043C\u0438\u0440\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824366
    m_Localized: "\u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u043C\u0435\u043D\u0456
      \u0432\u0456\u0434\u043E\u043C\u043E, \"\u0432\u043C\u0438\u0440\u0430\u0442\u0438\"
      \u0434\u043B\u044F \u043D\u0438\u0445 - \u0446\u0456\u043B\u043A\u043E\u043C
      \u0437\u0432\u0438\u0447\u043D\u0438\u0439 \u0441\u0442\u0430\u043D. \u0414\u0432\u0456
      \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432 \u0432\u043E\u043D\u0438
      \u0432\u0438\u043D\u0438\u0449\u0443\u0432\u0430\u043B\u0438 \u043E\u0434\u043D\u0435
      \u043E\u0434\u043D\u043E\u0433\u043E \u044F\u043A \u043C\u043E\u0433\u043B\u0438.
      \u041D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E \u0442\u0432\u043E\u0433\u043E
      \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824367
    m_Localized: "\u042F\u043A \u0432\u0438 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438?
      \u042F\u043A \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438 \u0437\u0430\u0440\u0430\u0437,
      \u0443 \u0442\u0430\u043A\u0443 \u0445\u0432\u0438\u043B\u0438\u043D\u0443,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u0438\u0441\u044F
      \u0442\u0443\u0442 \u0456 \u0437\u0430\u0439\u043C\u0430\u0442\u0438\u0441\u044F
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0441\u043F\u0440\u0430\u0432\u0430\u043C\u0438,
      \u044F\u043A \u043D\u0456 \u0432 \u0447\u043E\u043C\u0443 \u043D\u0435 \u0431\u0443\u0432\u0430\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824368
    m_Localized: "\u0422\u0438\u0445\u0456\u0448\u0435, \u0442\u0438\u0445\u0456\u0448\u0435!
      \u041D\u0435 \u0441\u0435\u0440\u0434\u044C\u0441\u044F. \u042F \u0442\u0430\u043A
      \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0442\u0438 \u0432\u0441\u0442\u0438\u0433\u043B\u0430
      \u043F\u0440\u0438\u0432'\u044F\u0437\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0443 \u0442\u0432\u043E\u0457\u0445
      \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u0445 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u0454 \u044F\u043A\u0435\u0441\u044C
      \u0440\u0430\u0446\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u0435 \u0437\u0435\u0440\u043D\u043E.
      \u0410\u043B\u0435 \u044F\u043A\u0449\u043E \u0440\u043E\u0437\u0433\u043B\u044F\u0434\u0430\u0442\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E \u0437\u0430\u0433\u0430\u043B\u043E\u043C,
      \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0440\u043E\u0437\u0443\u043C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824369
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u042F \u0441\u043F\u0440\u043E\u0431\u0443\u044E
      \u043F\u043E\u0431\u0443\u0442\u0438 \u0437\u0430\u0440\u0430\u0437 \u0441\u0442\u0440\u0438\u043C\u0430\u043D\u043E\u044E.
      \u0410\u043B\u0435 \u0412\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u043C\u0435\u043D\u0435 \u0432\u0438\u0441\u043B\u0443\u0445\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824370
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u0449\u043E \u043D\u0430\u0448\u0435
      \u0421\u0442\u0456\u0439\u043B\u043E \u043C\u0430\u0439\u0436\u0435 \u0434\u0432\u0430
      \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F \u0437\u0430\u043B\u0438\u0448\u0430\u043B\u043E\u0441\u044F
      \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u043C. \u0417\u043D\u0430\u044E,
      \u0449\u043E \u043D\u0430\u0448\u043E\u044E \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u044E
      \u043C\u0435\u0442\u043E\u044E \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0443\u0432
      \u043F\u0440\u043E\u0454\u043A\u0442 \"\u0421\u043E\u043D\u0446\u0435\", \u0456
      \u0449\u043E \u043C\u0438 \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u043B\u0438\u0441\u044F
      \u0432\u0456\u0434 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432 \u0434\u043E\u0442\u0438,
      \u0434\u043E\u043A\u0438 \u043D\u0435 \u0443\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u043C\u043E
      \u0441\u0435\u0431\u0435 \u043D\u0438\u043C. \u0410\u043B\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0440\u0430\u0437 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u0456\u0441\u043D\u0443\u044E\u0442\u044C \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0442\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0457,
      \u0437 \u044F\u043A\u0438\u043C\u0438 \u043C\u0438 \u043C\u043E\u0433\u043B\u0438
      \u0431 \u0443\u043A\u043B\u0430\u0441\u0442\u0438 \u043C\u0456\u0446\u043D\u0438\u0439
      \u043C\u0438\u0440. \u0412\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u043D\u0430\u043C \u043D\u0430\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u0437\u0432'\u044F\u0437\u043E\u043A \u0456\u0437 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0435\u044E,
      \u0430 \u043C\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u043C\u043E
      \u0457\u043C \u0436\u0438\u0442\u0438 \u0456 \u043F\u0440\u043E\u0446\u0432\u0456\u0442\u0430\u0442\u0438.
      \u0406 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0440\u0430\u0437
      \u0457\u043C \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0454 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0430
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0430. \u041C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430
      \u0456 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u0457\u0445.
      \u0406\u043D\u0430\u043A\u0448\u0435 \u043D\u0430\u043C \u043C\u043E\u0436\u0435
      \u0432\u0438\u044F\u0432\u0438\u0442\u0438\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0456\u043A\u0443\u0434\u0438 \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u0438
      \u0456 \u043D\u0456 \u0437 \u043A\u0438\u043C \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u0438
      \u043D\u0430 \u043A\u043E\u043D\u0442\u0430\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824371
    m_Localized: "\u041E\u0441\u044C \u0442\u0435\u043F\u0435\u0440 \u044F \u0447\u0443\u044E
      \u043C\u043E\u044E \u0443\u0447\u0435\u043D\u0438\u0446\u044E! \u0422\u0438
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0432\u043C\u0456\u043B\u0430 \u0434\u043E\u043D\u0435\u0441\u0442\u0438
      \u0441\u0432\u043E\u044E \u0434\u0443\u043C\u043A\u0443, \u0456 \u044F \u0437\u0430\u0432\u0436\u0434\u0438
      \u0446\u0456\u043D\u0443\u0432\u0430\u0432 \u0443 \u0442\u043E\u0431\u0456
      \u0446\u0435. \u0410\u043B\u0435 \u0442\u0438 \u0443\u043F\u0443\u0441\u043A\u0430\u0454\u0448
      \u043E\u0434\u0438\u043D \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0439 \u0430\u0441\u043F\u0435\u043A\u0442.
      \u041C\u0438 \u0442\u0435\u0436 \u043D\u0435 \u0432\u0441\u0435\u0441\u0438\u043B\u044C\u043D\u0456,
      @lp. \u041C\u0438 \u043D\u0435 \u0437\u043D\u0430\u0454\u043C\u043E, \u044F\u043A\u0443
      \u043C\u0456\u0446\u044C \u043C\u0430\u0454 \u0446\u0435\u0439 \u0442\u0430\u043A
      \u0437\u0432\u0430\u043D\u0438\u0439 \u0410\u043D\u043A\u043B\u0430\u0432,
      \u0456 \u043D\u0435 \u0437\u043D\u0430\u0454\u043C\u043E, \u044F\u043A \u0434\u0430\u043B\u0435\u043A\u043E
      \u0432\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0430\u0439\u0442\u0438
      \u0443 \u0441\u0432\u043E\u0457\u0439 \u0432\u0456\u0439\u043D\u0456. \u0422\u0430\u043A,
      \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0438
      \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0439\u043D\u0438\u0445 \u0434\u0440\u0443\u0437\u0456\u0432,
      \u044F\u043A\u0449\u043E \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u043C\u043E
      \u0457\u043C. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E \u043C\u0438 \u0457\u043C
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u043C\u043E, \u043C\u0438
      \u0437\u0456\u0442\u043A\u043D\u0435\u043C\u043E\u0441\u044F \u0456\u0437 \u0437\u0430\u0433\u0440\u043E\u0437\u043E\u044E
      \u0437\u0430\u0433\u0438\u043D\u0443\u0442\u0438 \u0440\u0430\u0437\u043E\u043C
      \u0456\u0437 \u043D\u0438\u043C\u0438. \u0406 \u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0446\u044F \u0437\u0430\u0433\u0440\u043E\u0437\u0430
      \u0431\u0443\u0434\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824372
    m_Localized: "\u041C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438 \u0441\u043E\u0431\u0456
      \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u0442\u0438 \u0421\u0442\u0456\u0439\u043B\u043E\u043C
      \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0431\u0435\u0437\u0440\u043E\u0437\u0441\u0443\u0434\u043D\u043E.
      \u0421\u0430\u043C\u0430 \u0434\u0443\u043C\u043A\u0430 \u043F\u0440\u043E
      \u043C\u043E\u0436\u043B\u0438\u0432\u0443 \u0437\u0430\u0433\u0438\u0431\u0435\u043B\u044C
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456 \u0456 \u0432\u0441\u0456\u0445
      \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0445 \u043D\u0430\u043C\u0438
      \u0437\u043D\u0430\u043D\u044C... \u042F\u043A\u0449\u043E \u043C\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u043C\u043E\u0441\u044F
      \u0442\u0443\u0442 \u0456 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043C\u043E
      \u043F\u0440\u043E\u0435\u043A\u0442, \u0443 \u043D\u0430\u0441 \u0431\u0443\u0434\u0435
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u0448\u0430\u043D\u0441\u0456\u0432 \u043D\u0430 \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F.
      \u0426\u0435 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824373
    m_Localized: "\u042F... \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E \u0445\u0456\u0434
      \u0412\u0430\u0448\u0438\u0445 \u0434\u0443\u043C\u043E\u043A. \u0412\u0438
      \u043C\u0430\u0454\u0442\u0435 \u0440\u0430\u0446\u0456\u044E. \u041D\u0435
      \u043C\u043E\u0436\u043D\u0430 \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F\u043C\u0438 \u043F\u043E\u043D\u0456, \u044F\u043A\u0456
      \u0436\u0438\u0432\u0443\u0442\u044C \u0442\u0443\u0442, \u0437\u0430\u0440\u0430\u0434\u0438
      \u0432\u0456\u0439\u043D\u0438, \u044F\u043A\u0430 \u0457\u0445 \u043D\u0435
      \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F. \u0422\u043E\u0434\u0456
      \u044F \u0432\u0456\u0434\u0434\u0430\u043C \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438,
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456 \u0434\u043B\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432, \u0456 \u043F\u043E\u043A\u0438\u043D\u0443
      \u0446\u0435 \u043C\u0456\u0441\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824374
    m_Localized: "\u0429\u043E? \u0422\u0438 \u043F\u0440\u0438 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0440\u043E\u0437\u0443\u043C\u0456, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824375
    m_Localized: "\u041C\u043E\u0436\u0435, \u0432\u0438 \u0442\u0443\u0442 \u0456
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0438\u0434\u0456\u0442\u0438
      \u0443 \u0441\u0432\u043E\u0454\u043C\u0443 \u043F\u0440\u0438\u0442\u0443\u043B\u043A\u0443,
      \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u044E\u0447\u0438\u0441\u044C
      \u043C\u0438\u0440\u043E\u043C \u0456 \u0441\u043F\u043E\u043A\u043E\u0454\u043C,
      \u0430\u043B\u0435 \u0437 \u043C\u043E\u0454\u0457 \u0432\u0438\u043D\u0438
      \u0442\u0430\u043C, \u043D\u0430\u0433\u043E\u0440\u0456, \u0441\u043A\u043E\u0440\u043E
      \u043F\u043E\u0447\u043D\u0443\u0442\u044C \u0443\u0431\u0438\u0432\u0430\u0442\u0438!
      \u0406 \u044F \u043D\u0435 \u043C\u043E\u0436\u0443 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0442\u0443\u0442, \u0437\u043D\u0430\u044E\u0447\u0438, \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824376
    m_Localized: "\u042F \u043D\u0435 \u0434\u043E\u0437\u0432\u043E\u043B\u044E
      \u0442\u043E\u0431\u0456, @lp! \u0414\u043B\u044F \u0442\u0432\u043E\u0433\u043E
      \u0436 \u0431\u043B\u0430\u0433\u0430 \u044F \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u044F\u044E
      \u0442\u043E\u0431\u0456 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u0438 \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456! \u0422\u043E\u0431\u0456 \u0431\u0443\u0434\u0435 \u043D\u0430\u0434\u0430\u043D\u0430
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0430 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430, \u043C\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043C\u043E
      \u043A\u0443\u0440\u0441 \u0440\u0435\u0430\u0431\u0456\u043B\u0456\u0442\u0430\u0446\u0456\u0457!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824377
    m_Localized: "\u0422\u0430\u043A? \u041D\u0443 \u0442\u0430\u043A \u0437\u043C\u0443\u0441\u044C
      \u043C\u0435\u043D\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u0446\u0435\u0439
      \u043D\u0430\u043A\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824378
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824379
    m_Localized: "\u0422\u0438 \u0440\u043E\u0431\u0438\u0448 \u0432\u0435\u043B\u0438\u043A\u0443
      \u043F\u043E\u043C\u0438\u043B\u043A\u0443, @lp. \u041F\u0443\u0441\u0442\u043A\u0430
      \u0432\u0436\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0442\u0440\u0430\u0432\u043C\u0443\u0432\u0430\u043B\u0430
      \u0442\u0435\u0431\u0435. \u0422\u0432\u043E\u044F \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454 \u0445\u0443\u0444\u0444\u0456\u043D\u0433\u0442\u043E\u043D\u0441\u044C\u043A\u0438\u0439
      \u0441\u0438\u043D\u0434\u0440\u043E\u043C. \u042F \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0430\u044E
      \u0442\u0435\u0431\u0435. \u041D\u0435 \u0439\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824380
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438 \u044F
      \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u044E\u0441\u044F. \u0411\u0435\u0440\u0456\u0442\u044C
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0412\u0430\u043C \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u043F\u0440\u043E\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824381
    m_Localized: "\u0429\u043E \u0436... \u0442\u0430\u043A\u0443 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u044F \u0442\u0435\u0436 \u043D\u0435 \u0432\u0456\u0434\u043A\u0438\u0434\u0430\u0432.
      \u0425\u0430\u0439 \u0437\u043C\u0438\u043B\u043E\u0441\u0442\u0438\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434 \u0442\u043E\u0431\u043E\u044E \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824382
    m_Localized: "\u041F\u043E\u043A\u0438 \u0442\u0438 \u043D\u0435 \u043F\u0456\u0448\u043B\u0430...
      \u0422\u043E\u0431\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u043D\u0430\u0439\u0442\u0438
      \u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u0420\u0435\u043C\u0435\u0434\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824383
    m_Localized: "\u0422\u0430\u043A, \u043C\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0438\u0441\u044F,
      \u0434\u0430\u043B\u0435\u043A\u043E \u0437\u0432\u0456\u0434\u0441\u0438.
      \u0417 \u043D\u0435\u044E \u0432\u0441\u0435 \u0433\u0430\u0440\u0430\u0437\u0434,
      \u0430\u043B\u0435, \u044F\u043A \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u0430\u0454 \u043D\u0430\u043C\u0456\u0440\u0443
      \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824384
    m_Localized: "\u042F \u0442\u0430\u043A \u0456 \u0434\u0443\u043C\u0430\u0432.
      \u0417 \u043C\u043E\u0433\u043E \u0431\u043E\u043A\u0443 \u0431\u0443\u043B\u043E
      \u043F\u043E\u043C\u0438\u043B\u043A\u043E\u044E \u0432\u0456\u0434\u043F\u0443\u0441\u043A\u0430\u0442\u0438
      \u0457\u0457, \u0445\u043E\u0447\u0430 \u0432\u043E\u043D\u0430 \u0456 \u0437\u0433\u043E\u043B\u043E\u0441\u0438\u043B\u0430\u0441\u044F
      \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435\u043C. \u0422\u0435\u043F\u0435\u0440
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u0449\u043E \u0457\u0457
      \u043C\u0435\u0442\u043E\u044E \u0431\u0443\u043B\u043E \u0432\u0441\u044C\u043E\u0433\u043E
      \u043B\u0438\u0448\u0435 \u0432\u0442\u0435\u043A\u0442\u0438 \u0432\u0456\u0434
      \u043D\u0430\u0441... \u0445\u043E\u0447\u0430 \u044F \u0434\u043E\u0441\u0456
      \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0447\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824385
    m_Localized: "\u041C\u0430\u0431\u0443\u0442\u044C, \u0434\u0435\u044F\u043A\u0456
      \u043F\u043E\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0456 \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
      \u0449\u043E\u0431 \u0436\u0438\u0442\u0438 \u0432 \u043A\u043B\u0456\u0442\u0446\u0456,
      \u043D\u0435\u0445\u0430\u0439 \u043D\u0430\u0432\u0456\u0442\u044C \u0446\u044F
      \u043A\u043B\u0456\u0442\u043A\u0430 \u0431\u0443\u0434\u0435 \u0456\u0437
      \u0437\u043E\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824386
    m_Localized: "\u041A\u043B\u0456\u0442\u043A\u0430? \u041C\u0438 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0431\u0443\u043B\u0438 \u043A\u043B\u0456\u0442\u043A\u043E\u044E!
      \u041C\u0438 - \u0432\u0430\u0448 \u0434\u0456\u043C. \u0406 \u0437\u0430\u043B\u0438\u0448\u0438\u043C\u043E\u0441\u044F
      \u043D\u0438\u043C, \u0449\u043E \u0431 \u043D\u0435 \u0441\u0442\u0430\u043B\u043E\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824387
    m_Localized: "\u0419\u043E\u0443, @lp, \u044F\u043A \u0436\u0435 \u044F \u0440\u0430\u0434\u0438\u0439,
      \u0449\u043E \u0442\u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F!
      \u0422\u0438 \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u043C\u0456\u043D\u0438\u043B\u0430\u0441\u044F,
      \u0432\u0442\u0456\u043C, \u043F\u0440\u043E \u0449\u043E \u044F?! \u0417\u0432\u0456\u0441\u043D\u043E,
      \u0445\u0442\u043E \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E \u0431
      \u0437\u043C\u0456\u043D\u0438\u0432\u0441\u044F, \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
      \u0456\u0437 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824388
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u0422\u0440\u0430\u043D\u0437\u0438\u0441\u0442\u043E\u0440\u0435.
      \u0410 \u043E\u0441\u044C \u0442\u0438 \u043D\u0435 \u0437\u043C\u0456\u043D\u0438\u0432\u0441\u044F
      \u043D\u0456 \u043A\u0440\u0430\u043F\u043B\u0456. \u0422\u0430\u043A \u0441\u0430\u043C\u043E
      \u0432\u043E\u0437\u0438\u0448\u0441\u044F \u0437\u0456 \u0441\u0432\u043E\u0457\u043C\u0438
      \u043C\u0456\u043A\u0440\u043E\u0441\u0445\u0435\u043C\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824389
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E, \u0446\u0435
      \u0436 \u043C\u043E\u044F \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C,
      \u0430 \u0447\u0438\u043C \u0436\u0435 \u043C\u0435\u043D\u0456 \u0449\u0435
      \u0437\u0430\u0439\u043C\u0430\u0442\u0438\u0441\u044F? \u0427\u0435\u043A\u0430\u044E
      \u043D\u0435 \u0434\u043E\u0447\u0435\u043A\u0430\u044E\u0441\u044F, \u043A\u043E\u043B\u0438
      \u0437\u043C\u043E\u0436\u0443 \u043F\u043E\u0447\u0430\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u0443
      \u0437 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u043C \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440\u043E\u043C.
      \u0410\u0434\u0436\u0435 \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454
      \u0434\u0438\u0432\u043E, \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u043E
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439. \u041A\u043E\u043B\u0438
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0432
      \u043D\u0430\u043C, \u0449\u043E \u0442\u043E\u0431\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u0439\u043E\u0433\u043E \u0434\u043E\u0431\u0443\u0442\u0438, \u044F \u043B\u0435\u0434\u0432\u0435
      \u0437 \u0433\u043B\u0443\u0437\u0434\u0443 \u043D\u0435 \u0437'\u0457\u0445\u0430\u0432
      \u0432\u0456\u0434 \u0440\u0430\u0434\u043E\u0441\u0442\u0456. \u0417\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F,
      \u044F \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0432\u0456\u0440\u0438\u0432
      \u0443 \u0442\u0432\u0456\u0439 \u0443\u0441\u043F\u0456\u0445, \u0437\u0430
      \u043C\u043E\u0457\u043C\u0438 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u0430\u043C\u0438
      \u0439\u043E\u0433\u043E \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430 3720 \u0434\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824390
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u0443\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u043C\u0435\u043D\u0456 \u043F\u0440\u043E \u0448\u0430\u043D\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824391
    m_Localized: "\u0425\u0435\u0435\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824392
    m_Localized: "\u041A\u0440\u0430\u0449\u0435 \u043F\u043E\u044F\u0441\u043D\u0438,
      \u044F\u043A\u0443 \u0441\u0430\u043C\u0435 \u0440\u043E\u043B\u044C \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440
      \u0432\u0456\u0434\u0456\u0433\u0440\u0430\u0454 \u0432 \u043F\u0440\u043E\u0454\u043A\u0442\u0456
      \"\u0421\u043E\u043D\u0446\u0435\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824393
    m_Localized: "\u041D\u0443 \u044F\u043A \u0446\u0435 \u044F\u043A\u0443? \u0421\u0430\u043C\u0435
      \u0432\u0456\u043D \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430
      \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\" \u043D\u0430 \u0441\u0443\u043F\u0435\u0440-\u0431\u0456\u0439\u0446\u044F.
      \u0412\u0456\u043D \u043F\u0440\u043E\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u043C\u0435
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E \u043D\u0430 \u043F\u043E\u043B\u0456
      \u0431\u043E\u044E \u0430\u0436 \u0434\u043E \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u0457
      \u0442\u0440\u0430\u0454\u043A\u0442\u043E\u0440\u0456\u0457 \u043A\u043E\u0436\u043D\u043E\u0457
      \u043A\u0443\u043B\u0456 \u0442\u0430 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0438\u0445
      \u0442\u043E\u0447\u043E\u043A \u043A\u043E\u0436\u043D\u043E\u0433\u043E \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430.
      \u0411\u0443\u0434\u0435 \u043E\u0431\u0447\u0438\u0441\u043B\u044E\u0432\u0430\u0442\u0438,
      \u044F\u043A \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F, \u044F\u043A
      \u0446\u0456\u043B\u0438\u0442\u0438\u0441\u044F, \u044F\u043A \u043A\u0435\u0440\u0443\u0432\u0430\u0442\u0438
      \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0443\u0445\u043E\u043C, \u043D\u0430
      \u0437\u0435\u043C\u043B\u0456 \u0456 \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456,
      \u0431\u0443\u0434\u0435 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0442\u0438
      \u0440\u0443\u0445\u0438 \u043A\u043E\u0436\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430.
      \u0426\u0435 \u044F\u043A \u0417.\u041F.\u0421., \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432 \u0442\u0438\u0441\u044F\u0447\u0443 \u0440\u0430\u0437\u0456\u0432
      \u043A\u0440\u0443\u0442\u0456\u0448\u0435, \u0456 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0432\u0441\u0435 \u0431\u0443\u0434\u0435 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C\u0443
      \u0447\u0430\u0441\u0456! \u0423 \u043D\u0430\u0441 \u0443\u0436\u0435 \u0454
      \u0432\u0441\u0456 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0438,
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u0443\u0436\u0435 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824394
    m_Localized: "\u0421\u0442\u0440\u0430\u0448\u043D\u043E \u0443\u044F\u0432\u0438\u0442\u0438
      \u0442\u0430\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824395
    m_Localized: "\u041D\u0443... \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440 \u0456\u0441\u043D\u0443\u0454
      \u0432 \u0454\u0434\u0438\u043D\u043E\u043C\u0443 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0456,
      \u043D\u0456\u0447\u043E\u0433\u043E \u043F\u043E\u0434\u0456\u0431\u043D\u043E\u0433\u043E
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0434\u0435 \u043D\u0435\u043C\u0430\u0454
      \u0456 \u0431\u043B\u0438\u0437\u044C\u043A\u043E. \u0426\u0435 \u0436 \u044F\u043A
      \u0446\u0456\u043B\u0438\u0439 \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C
      \u0443 \u0442\u0435\u0431\u0435 \u0432 \u043A\u0438\u0448\u0435\u043D\u0456!
      \u0406 \u0432\u0456\u043D \u0442\u0435\u043F\u0435\u0440 \u0443 \u043D\u0430\u0441,
      \u0442\u043E\u0436 \u043C\u043E\u0436\u043D\u0430 \u043D\u0435 \u0431\u043E\u044F\u0442\u0438\u0441\u044F,
      \u0449\u043E \u043D\u0438\u043C \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u043E\u0440\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824396
    m_Localized: "\u0412\u0456\u043D \u0434\u0456\u0439\u0441\u043D\u043E \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439? \u0410 \u044F
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0430
      \u0439\u043E\u0433\u043E \u044F\u043A \u043C\u043E\u0434\u0443\u043B\u044C
      \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u043D\u044F \u0434\u043B\u044F
      \u0441\u0432\u043E\u0433\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824398
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824399
    m_Localized: "... @lp, \u0430 \u0442\u0438 \u043D\u0438\u043C \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E
      \u0446\u0432\u044F\u0445\u0438 \u043D\u0435 \u0437\u0430\u0431\u0438\u0432\u0430\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824400
    m_Localized: "\u041D\u0443 \u043C\u043E\u0436\u0435 \u0440\u0430\u0437\u043E\u043A
      \u0456 \u0431\u0443\u043B\u043E... \u0423 \u043C\u0435\u043D\u0435 \u0442\u0430\u043C,
      \u043D\u0430\u0433\u043E\u0440\u0456, \u0437\u043D\u0430\u0454\u0448, \u0431\u0443\u043B\u0438
      \u0440\u0456\u0437\u043D\u0456 \u043F\u0440\u0438\u0433\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824401
    m_Localized: "... \u041D\u0435 \u0440\u043E\u0431\u0438 \u0442\u0430\u043A \u0431\u0456\u043B\u044C\u0448\u0435,
      \u0433\u0430\u0440\u0430\u0437\u0434? \u0414\u0430\u0432\u0430\u0439 \u044F
      \u043A\u0440\u0430\u0449\u0435 \u0434\u0430\u043C \u0442\u043E\u0431\u0456
      \u0441\u0432\u0456\u0439 \u043C\u043E\u0434\u0443\u043B\u044C \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u043D\u044F.
      \u0412\u0456\u043D \u0440\u043E\u0431\u0438\u0442\u0438\u043C\u0435 \u0432\u0441\u0435
      \u0442\u0435 \u0441\u0430\u043C\u0435, \u0437 \u0442\u0456\u0454\u044E \u043B\u0438\u0448\u0435
      \u0440\u0456\u0437\u043D\u0438\u0446\u0435\u044E, \u0449\u043E \u043D\u0435
      \u0454 \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0446\u0456\u043D\u043D\u043E\u044E,
      \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u043E\u044E \u0443 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0440\u043E\u0434\u0456 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824402
    m_Localized: "\u0413\u0430\u0440\u0430\u0437\u0434, \u043E\u0445\u043E\u043B\u043E\u043D\u044C.
      \u0417\u043D\u0430\u0454\u0448, \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0435
      \u0441\u0438\u0434\u0456\u043D\u043D\u044F \u0432 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u0456
      \u0440\u043E\u0431\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u044F\u043A\u0438\u043C\u043E\u0441\u044C
      \u043D\u0435\u0440\u0432\u043E\u0432\u0438\u043C. \u0411\u0443\u043B\u0430
      \u0440\u0430\u0434\u0430 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438\u0441\u044F,
      \u043D\u0435 \u0437\u0430\u043F\u0440\u0430\u0446\u044E\u0439\u0441\u044F \u0434\u043E
      \u0441\u043C\u0435\u0440\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824403
    m_Localized: "@lp, \u0442\u0430\u043A \u043E\u0441\u044C \u043A\u043E\u043C\u0443
      \u043C\u0438 \u0437\u043E\u0431\u043E\u0432'\u044F\u0437\u0430\u043D\u0456
      \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F\u043C\u0438 \u0431\u0440\u043E\u043D\u0456
      \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\"! \u041D\u0435 \u0443\u044F\u0432\u043B\u044F\u0454\u0448,
      \u044F\u043A \u0434\u043E\u0432\u0433\u043E \u044F \u0447\u0435\u043A\u0430\u043B\u0430
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456 \u0437\u0430\u0437\u0438\u0440\u043D\u0443\u0442\u0438
      \u0432 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824404
    m_Localized: "\u041B\u0430\u0439\u043C \u0424\u0456\u0437\u0437\u0456, \u044F\u043A
      \u0441\u043F\u0440\u0430\u0432\u0438 \u0432 \u043B\u0438\u0432\u0430\u0440\u043D\u043E\u043C\u0443
      \u0446\u0435\u0445\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824405
    m_Localized: "\u0420\u043E\u0431\u043E\u0442\u0430 \u043A\u0438\u043F\u0438\u0442\u044C,
      \u0431\u0440\u043E\u043D\u044F \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\"
      \u043C\u0430\u0439\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0430. \u042F\u043A\u0449\u043E
      \u0432\u0441\u0435 \u0437\u0440\u043E\u0431\u0438\u043C\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
      \u0442\u043E \u0446\u0435 \u0431\u0443\u0434\u0435 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
      \u0448\u0435\u0434\u0435\u0432\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824406
    m_Localized: "\u0426\u044F \u0431\u0440\u043E\u043D\u044F \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0442\u0430\u043A\u0430 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0430?
      \u042F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E, \u043C\u0435\u043D\u0435
      \u043D\u0435\u043B\u0435\u0433\u043A\u043E \u0437\u0434\u0438\u0432\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824407
    m_Localized: "\u041F\u043E\u0432\u0456\u0440, \u0446\u044F \u0431\u0440\u043E\u043D\u044F
      \u0431\u0443\u0434\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u044E.
      \u041F\u043E-\u043F\u0435\u0440\u0448\u0435, \u0432\u043E\u043D\u0430 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430
      \u043A\u0440\u0438\u043B\u0430\u043C\u0438 \u0456 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C
      \u0441\u0432\u043E\u0454\u043C\u0443 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0435\u0432\u0456
      \u043B\u0456\u0442\u0430\u0442\u0438. \u041F\u043E-\u0434\u0440\u0443\u0433\u0435,
      \u0442\u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438,
      \u044F\u043A\u0456 \u0442\u0438 \u0437\u0434\u043E\u0431\u0443\u043B\u0430,
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0430\u0442\u044C
      \u0457\u0457 \u0437\u0430\u0445\u0438\u0441\u043D\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456.
      \u041D\u0443 \u0456 \u043F\u043E-\u0442\u0440\u0435\u0442\u0454, \u0432\u043E\u043D\u0430
      \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u043D\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0432\u0430\u0442\u0438
      \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u043C\u0456\u0446\u044C \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430
      \u0430\u0431\u043E \u0441\u0438\u043B\u0443 \u0439\u043E\u0433\u043E \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824408
    m_Localized: "\u0422\u043E\u043C\u0443 \u0442\u043E \u043C\u0438 \u0439 \u0445\u043E\u0447\u0435\u043C\u043E
      \u043D\u0430\u0437\u0432\u0430\u0442\u0438 \u0457\u0457 \"\u0411\u0440\u043E\u043D\u0435\u044E
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\". \u0422\u043E\u0439, \u0445\u0442\u043E
      \u0457\u0457 \u043E\u0434\u044F\u0433\u043D\u0435, \u0437\u0430 \u0441\u0438\u043B\u043E\u044E
      \u043D\u0435 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0438\u043C \u0431\u043E\u0433\u0438\u043D\u044F\u043C \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457
      \u0442\u0430 \u041B\u0443\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824409
    m_Localized: "\u0417\u0432\u0443\u0447\u0438\u0442\u044C \u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0435. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0449\u043E \u0442\u0430\u043A\u0430 \u043C\u0456\u0446\u044C \u043D\u0435
      \u0431\u0443\u0434\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0430
      \u043D\u0430 \u0437\u043B\u043E. \u0422\u0430\u043C, \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u044F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E \u043D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0430...
      \u0442\u0430 \u0439 \u0441\u0430\u043C\u0430 \u0441\u0442\u0430\u043B\u0430
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u044E \u0456\u0441\u0442\u043E\u0442\u043D\u043E\u0457
      \u0439\u043E\u0433\u043E \u0447\u0430\u0441\u0442\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824410
    m_Localized: "\u0412\u0430\u0436\u043A\u043E \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F,
      \u0442\u0430\u043A? \u042F\u043A \u0442\u0430\u043C... \u043D\u0430\u0433\u043E\u0440\u0456?
      \u0414\u0443\u0436\u0435 \u043F\u043E\u0433\u0430\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824411
    m_Localized: "\u042F\u043A \u0442\u043E\u0431\u0456 \u0441\u043A\u0430\u0437\u0430\u0442\u0438?
      \u0406 \u0442\u0430\u043A, \u0456 \u043D\u0456. \u041D\u0430\u0433\u043E\u0440\u0456
      \u0436\u0438\u0442\u0442\u044F \u0441\u0443\u0432\u043E\u0440\u0435. \u0406
      \u0434\u0443\u0436\u0435 \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0435.
      \u0414\u0443\u0436\u0435 \u0447\u0430\u0441\u0442\u043E \u0430\u0431\u043E
      \u0432\u0431\u0438\u0432\u0430\u0454\u0448 \u0442\u0438, \u0430\u0431\u043E
      \u0432\u0431'\u044E\u0442\u044C \u0442\u0435\u0431\u0435. \u0410\u043B\u0435
      \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441, \u0446\u0435 \u0436\u0438\u0442\u0442\u044F...
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454. \u041D\u0435 \u0437\u043D\u0430\u044E,
      \u044F\u043A \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824412
    m_Localized: "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E.
      \u041E\u0441\u044C \u0441\u0430\u043C\u0435 \u0442\u043E\u043C\u0443 \u043C\u0438
      \u0456 \u0441\u0442\u0432\u043E\u0440\u044E\u0454\u043C\u043E \"\u0411\u0440\u043E\u043D\u044E
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824413
    m_Localized: "\u041D\u0456. \u0411\u043E\u044E\u0441\u044F, \u0449\u043E \u0442\u0438
      \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824414
    m_Localized: "\u041E, @lp, \u044F \u0440\u0430\u0434\u0430, \u0449\u043E \u0442\u0438
      \u0437\u0430\u0432\u0456\u0442\u0430\u043B\u0430 \u0434\u043E \u043C\u0435\u043D\u0435.
      \u042F \u0447\u0443\u043B\u0430, \u0442\u0438 \u043C\u0430\u0454\u0448 \u043D\u0430\u043C\u0456\u0440
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824415
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u043C\u0456\u0441\u0456\u0441
      \u0425\u0430\u0440\u0442\u0440\u043E\u0443\u0441. \u0422\u0430\u043A, \u044F
      \u043C\u0430\u044E \u044F\u043A\u043E\u043C\u043E\u0433\u0430 \u0448\u0432\u0438\u0434\u0448\u0435
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F, \u0443
      \u043C\u0435\u043D\u0435 \u0442\u0430\u043C \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
      \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0456 \u0441\u043F\u0440\u0430\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824416
    m_Localized: "\u042F \u044F\u043A\u043E\u0441\u044C \u0437\u043C\u043E\u0436\u0443
      \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0442\u0438 \u0442\u0435\u0431\u0435
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824417
    m_Localized: "\u041D\u0435 \u0434\u0443\u043C\u0430\u044E. \u0412\u0438\u0431\u0430\u0447\u0442\u0435,
      \u0430\u043B\u0435 \u043C\u0435\u043D\u0456 \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
      \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430.
      \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u043D\u0435 \u0437\u0430\u0440\u0430\u0437.
      \u0422\u0430\u043C, \u043D\u0430\u0433\u043E\u0440\u0456 \u0441\u043A\u043E\u0440\u043E
      \u0432\u0456\u0434\u0431\u0443\u0434\u0443\u0442\u044C\u0441\u044F \u0436\u0430\u0445\u043B\u0438\u0432\u0456
      \u0440\u0435\u0447\u0456, \u0456... \u044F\u043A\u043E\u044E\u0441\u044C \u043C\u0456\u0440\u043E\u044E...
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u0454 \u043C\u043E\u044F \u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824418
    m_Localized: "\u0420\u043E\u0437\u0443\u043C\u0456\u044E. \u0422\u043E\u0434\u0456
      \u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443 \u0442\u0435\u0431\u0435
      \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u0442\u0438 \u0456 \u043D\u0430\u0431\u0440\u0438\u0434\u0430\u0442\u0438
      \u0441\u0432\u043E\u0457\u043C\u0438 \u043F\u043E\u0440\u0430\u0434\u0430\u043C\u0438,
      \u0442\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435, \u0449\u043E \u044F
      \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435
      \u0432\u043F\u0440\u0430\u0432\u0456 \u0457\u0445 \u0442\u043E\u0431\u0456
      \u0434\u0430\u0432\u0430\u0442\u0438. \u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
      \u0449\u043E \u0442\u0438 \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0430
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E, \u043F\u0440\u043E
      \u0449\u043E \u044F \u043D\u0435 \u043C\u0430\u044E \u043D\u0456 \u043D\u0430\u0439\u043C\u0435\u043D\u0448\u043E\u0433\u043E
      \u043F\u043E\u043D\u044F\u0442\u0442\u044F, \u0442\u043E\u043C\u0443 \u044F
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0437\u0434\u0430\u0442\u043D\u0430
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043E\u0446\u0456\u043D\u0438\u0442\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E \u0456 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438
      \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u0437\u0430 \u0442\u0435\u0431\u0435.
      \u0410\u0434\u0436\u0435 \u0442\u043E\u0431\u043E\u044E \u0440\u0443\u0445\u0430\u0454
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824419
    m_Localized: "\u041D\u0430\u043F\u0435\u0432\u043D\u043E. \u0410 \u0449\u0435
      \u0442\u0430\u043C \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
      \u043C\u043E\u0457 \u0434\u0440\u0443\u0437\u0456, \u044F\u043A\u0438\u043C
      \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u043C\u043E\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824420
    m_Localized: "\u0422\u043E\u0434\u0456 \u0439\u0434\u0438. \u0406\u043D\u0430\u043A\u0448\u0435
      \u0442\u0438 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0448
      \u043F\u0440\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u0441\u0435\u0431\u0435
      \u0437\u0430 \u0442\u0435, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824421
    m_Localized: "\u0411\u0430\u0447\u0438\u0442\u044C \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F,
      \u0432\u0441\u0456 \u043C\u0438 \u0432\u0441\u0435 \u0441\u0432\u043E\u0454
      \u0436\u0438\u0442\u0442\u044F \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0438\u043C
      \u0456 \u0437\u0430\u0439\u043C\u0430\u043B\u0438\u0441\u044F, \u0449\u043E
      \u0437\u0430\u043B\u0438\u0448\u0430\u043B\u0438\u0441\u044F \u043E\u0441\u0442\u043E\u0440\u043E\u043D\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824422
    m_Localized: "\u0414\u044F\u043A\u0443\u044E. \u041C\u0435\u043D\u0456 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0441\u0442\u0430\u043B\u043E \u0442\u0440\u043E\u0445\u0438 \u043B\u0435\u0433\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824423
    m_Localized: "\u041E\u0441\u044C \u0456 \u0434\u043E\u0431\u0440\u0435. \u0422\u043E\u0434\u0456
      \u0434\u043E\u0437\u0432\u043E\u043B\u044C \u0443\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443 \u043F\u043E\u0440\u0430\u0434\u0443.
      \u041D\u0435 \u0439\u0434\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0440\u0430\u0437,
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u043F\u0430\u0440\u0430
      \u0433\u043E\u0434\u0438\u043D \u0449\u043E\u0441\u044C \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u044C.
      \u041F\u0440\u043E\u0433\u0443\u043B\u044F\u0439\u0441\u044F \u0421\u0442\u0456\u0439\u043B\u043E\u043C,
      \u043F\u043E\u0431\u0430\u0447\u0441\u044F \u0437\u0456 \u0437\u043D\u0430\u0439\u043E\u043C\u0438\u043C\u0438,
      \u0437\u0430\u0437\u0438\u0440\u043D\u0438 \u0443 \u0441\u0432\u043E\u044E
      \u043A\u0456\u043C\u043D\u0430\u0442\u0443. \u0423\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438
      \u0442\u0443\u0442 \u0442\u0432\u0456\u0439 \u0434\u0456\u043C, \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0447\u0430\u0441\u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F
      \u0434\u043E\u0434\u043E\u043C\u0443, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u043D\u043E \u043F\u043E\u0437\u043D\u0430\u0447\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824424
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u044F \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u044E\u0441\u044F
      \u0432\u0430\u0448\u043E\u044E \u043F\u043E\u0440\u0430\u0434\u043E\u044E.
      \u0406 \u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0442\u0435\u0441\u044F
      \u0437\u0430 \u043C\u0435\u043D\u0435, \u043C\u0438 \u0449\u0435 \u043F\u043E\u0431\u0430\u0447\u0438\u043C\u043E\u0441\u044F,
      \u0442\u043E\u0434\u0456 \u0439 \u0431\u0443\u0434\u0435 \u0447\u0430\u0441
      \u0434\u043B\u044F \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0438\u0445 \u0440\u043E\u0437\u043C\u043E\u0432
      \u0434\u043E \u0434\u0443\u0448\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824425
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u043D\u044F,
      \u043F\u0440\u043E\u0444\u0435\u0441\u043E\u0440\u0435. \u042F \u0412\u0430\u0441
      \u043D\u0435 \u043D\u0430\u0434\u0442\u043E \u0432\u0456\u0434\u0432\u043E\u043B\u0456\u043A\u0430\u044E
      \u0432\u0456\u0434 \u0441\u043F\u0440\u0430\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824426
    m_Localized: "\u0429\u043E? \u0410, @lp, \u043D\u0443 \u0449\u043E \u0442\u0438,
      \u0449\u043E \u0442\u0438... \u0422\u0430\u043A \u0437\u043D\u0430\u0447\u0438\u0442\u044C
      \u0442\u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F,
      \u0432\u0438\u043A\u043E\u043D\u0430\u0432\u0448\u0438 \u0432\u0435\u043B\u0438\u043A\u0443
      \u043C\u0456\u0441\u0456\u044E? \u042F \u0432 \u0442\u0435\u0431\u0435 \u0432\u0456\u0440\u0438\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824427
    m_Localized: "\u0422\u0430\u043A-\u0442\u0430\u043A, \u0456 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F, \u0430
      \u0437 \u0442\u0438\u043C\u0438 \u0441\u0430\u043C\u0438\u043C\u0438 \u0434\u043E\u0432\u0431\u0430\u043D\u0438\u043C\u0438
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430\u043C\u0438. \u0412\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0443\u044F\u0432\u043B\u044F\u0454\u0442\u0435,
      \u044F\u043A\u0438\u0445 \u0442\u0440\u0443\u0434\u043D\u043E\u0449\u0456\u0432
      \u043C\u0435\u043D\u0456 \u043A\u043E\u0448\u0442\u0443\u0432\u0430\u043B\u043E
      \u0457\u0445 \u0434\u043E\u0431\u0443\u0442\u0438! \u041D\u0435\u0432\u0436\u0435
      \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u043B\u043E \u043D\u0456\u044F\u043A
      \u043E\u0431\u0456\u0439\u0442\u0438\u0441\u044F \u0431\u0435\u0437 \u043D\u0438\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824428
    m_Localized: "\u041E\u0445, \u044F\u043A\u0431\u0438 \u043C\u043E\u0436\u043D\u0430
      \u0431\u0443\u043B\u043E... \u0420\u043E\u0437\u0443\u043C\u0456\u0454\u0448,
      \u0446\u0456 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438 - \u0449\u043E\u0441\u044C
      \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0435,
      \u0457\u0445 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u043D\u0456\u0447\u0438\u043C
      \u0437\u0430\u043C\u0456\u043D\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824429
    m_Localized: "\u0422\u043E\u0434\u0456 \u043C\u043E\u0436\u0435\u0442\u0435 \u0445\u043E\u0447\u0430
      \u0431 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456\u0448\u0435 \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438,
      \u0437\u0430\u0440\u0430\u0434\u0438 \u0447\u043E\u0433\u043E \u043C\u0435\u043D\u0456
      \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044F \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u0442\u0438
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824430
    m_Localized: "\u041E, \u0437\u0432\u0456\u0441\u043D\u043E. \u0410\u043C\u0443\u043B\u0435\u0442
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430 - \u0434\u0430\u0432\u043D\u044F
      \u0439 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0432 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0432\u0456\u0434\u043D\u043E\u0448\u0435\u043D\u043D\u044F\u0445 \u0440\u0456\u0447.
      \u041D\u0430\u043C \u0447\u0438\u043C\u0430\u043B\u043E \u0432\u0456\u0434\u043E\u043C\u043E
      \u043F\u0440\u043E \u043D\u044C\u043E\u0433\u043E \u0437\u0456 \u0437\u0432\u0456\u0442\u0456\u0432
      \u043F\u0440\u043E \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0422\u0430\u0454\u043C\u043D\u0438\u0445
      \u041D\u0430\u0443\u043A. \u0419\u043E\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u0443
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u0456 \u0434\u0443\u0436\u0435 \u0447\u0438\u0441\u0442\u0438\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B
      \u0430\u0440\u043A\u0430\u043D\u0456\u0442\u0443 - \u043C\u0456\u043D\u0435\u0440\u0430\u043B\u0443
      \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u043E\u0433\u043E,
      \u043D\u0430\u0432\u0456\u0442\u044C, \u043C\u043E\u0436\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E. \u0426\u0435\u0439
      \u043C\u0456\u043D\u0435\u0440\u0430\u043B \u043C\u0430\u0454 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u043E\u0440\u0430\u0437\u043E\u0432\u043E \u043F\u043E\u0441\u0438\u043B\u044E\u0432\u0430\u0442\u0438
      \u0440\u0456\u0437\u043D\u0456 \u0441\u043F\u0440\u044F\u043C\u043E\u0432\u0430\u043D\u0456
      \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u0435\u043D\u0435\u0440\u0433\u0456\u0457,
      \u0437\u043E\u043A\u0440\u0435\u043C\u0430 \u0439 \u043C\u0430\u0433\u0456\u044E
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824431
    m_Localized: "\u041E\u0434\u043D\u0430\u043A \u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0437\u0431\u0443\u0440\u0435\u043D\u043D\u044F, \u0449\u043E \u0432\u0438\u043D\u0438\u043A\u0430\u044E\u0442\u044C
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443, \u0432\u043A\u0440\u0430\u0439
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0442\u044C
      \u043D\u0430 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0456\u0441\u0442\u044C
      \u0441\u0430\u043C\u043E\u0433\u043E \u043C\u0430\u0433\u0430, \u0441\u043F\u043E\u0442\u0432\u043E\u0440\u044E\u044E\u0447\u0438
      \u0439\u043E\u0433\u043E \u043C\u0438\u0441\u043B\u0435\u043D\u043D\u044F \u0456
      \u0441\u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0442\u044F. \u0422\u0432\u043E\u0440\u0446\u044F\u043C
      \u0410\u043C\u0443\u043B\u0435\u0442\u0430 \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u0443\u0441\u0443\u043D\u0443\u0442\u0438 \u0446\u0435\u0439 \u0435\u0444\u0435\u043A\u0442,
      \u0442\u043E\u043C\u0443 \u0439\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F\u043C\u0438
      \u0432\u0432\u0430\u0436\u0430\u043B\u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u043C,
      \u0449\u043E \u043F\u043E\u043D\u0435\u0432\u043E\u043B\u044E\u0454 \u0434\u0443\u0448\u0443
      \u0441\u0432\u043E\u0433\u043E \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430.
      \u0410\u043B\u0435 \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443 \u0431\u043E\u0446\u0456
      \u0432\u0441\u044F \u043C\u0456\u0446\u044C \u044F\u043A \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u043E\u0457,
      \u0442\u0430\u043A \u0456 \u0441\u0443\u0447\u0430\u0441\u043D\u043E\u0457
      \u043D\u0430\u0443\u043A\u0438, \u0456 \u043C\u0435\u043D\u0456 \u0432\u0456\u0434\u043E\u043C\u0456
      \u0441\u043F\u043E\u0441\u043E\u0431\u0438, \u044F\u043A \u043C\u043E\u0436\u043D\u0430
      \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0443\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043D\u0430\u0448\u043E\u0457
      \"\u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824432
    m_Localized: "\u041D\u0443 \u0430 \u0449\u043E \u0449\u043E\u0434\u043E \u0427\u043E\u0440\u043D\u043E\u0457
      \u041A\u043D\u0438\u0433\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824433
    m_Localized: "\u0410, \u0446\u0435\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
      - \u0449\u043E\u0441\u044C \u0437\u043E\u0432\u0441\u0456\u043C \u0437 \u0456\u043D\u0448\u043E\u0457
      \u043E\u043F\u0435\u0440\u0438, \u0430\u043B\u0435 \u0442\u0435\u0436 \u0432\u0435\u043B\u044C\u043C\u0438
      \u043F\u0440\u0438\u043C\u0456\u0442\u043D\u0435. \u0414\u043E\u0432\u0433\u0438\u0439
      \u0447\u0430\u0441 \u043F\u043E\u043D\u0456 \u0432\u0432\u0430\u0436\u0430\u043B\u0438
      \u0437\u0435\u0431\u0440 \u043C\u0430\u043B\u043E \u043D\u0435 \u0442\u0443\u043F\u0438\u043C\u0438
      \u0434\u0438\u043A\u0443\u043D\u0430\u043C\u0438, \u0434\u044F\u043A\u0443\u044E\u0447\u0438
      \u043F\u0440\u043E\u043F\u0430\u0433\u0430\u043D\u0434\u0438\u0441\u0442\u0441\u044C\u043A\u0456\u0439
      \u043C\u0430\u0448\u0438\u043D\u0456 \u0447\u0430\u0441\u0456\u0432 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432.
      \u0426\u0435, \u0441\u0430\u043C\u043E \u0441\u043E\u0431\u043E\u044E, \u043F\u043E\u0432\u043D\u0430
      \u043D\u0456\u0441\u0435\u043D\u0456\u0442\u043D\u0438\u0446\u044F. \u0417\u0435\u0431\u0440\u0438
      \u043E\u0431\u0456\u0439\u0448\u043B\u0438 \u043D\u0430\u0441 \u0443 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0433\u0430\u043B\u0443\u0437\u044F\u0445 \u0437\u043D\u0430\u043D\u043D\u044F,
      \u0457\u0445\u043D\u0454 \u0448\u0430\u043C\u0430\u043D\u0441\u0442\u0432\u043E,
      \u0430\u043B\u0445\u0456\u043C\u0456\u044F \u0456 \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0456\u044F
      \u043D\u0456\u0447\u0438\u043C \u043D\u0435 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430\u0448\u0456\u0439 \u043C\u0430\u0433\u0456\u0457. \u0406\u043D\u0430\u043A\u0448\u0435
      \u044F\u043A \u0431\u0438 \u0412\u0435\u043B\u0438\u043A\u0430 \u0412\u0456\u0439\u043D\u0430
      \u043C\u043E\u0433\u043B\u0430 \u0442\u044F\u0433\u043D\u0443\u0442\u0438\u0441\u044F
      \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u043E\u043A\u0456\u0432 \u0456
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F \u0442\u0430\u043A,
      \u044F\u043A \u0432\u043E\u043D\u0430 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824434
    m_Localized: "\u041F\u043E\u0432\u0456\u0440\u0442\u0435, \u043F\u0440\u043E\u0444\u0435\u0441\u043E\u0440\u0435,
      \u044F \u0437\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u0456 \u0442\u0438\u0436\u043D\u0456
      \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F \u043F\u0440\u043E \u0437\u0435\u0431\u0440
      \u0431\u0430\u0433\u0430\u0442\u043E \u0442\u0430\u043A\u043E\u0433\u043E,
      \u043F\u0440\u043E \u0449\u043E \u0442\u043E\u0447\u043D\u043E \u043D\u0435
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u0443 \u0432\u0430\u0448\u0438\u0445
      \u043A\u043D\u0438\u0433\u0430\u0445. \u0414\u0435\u0449\u043E \u0437 \u0446\u044C\u043E\u0433\u043E
      \u044F \u0431 \u0432\u043E\u043B\u0456\u043B\u0430 \u0456 \u043D\u0435 \u0437\u043D\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824435
    m_Localized: "\u0414\u0443\u0436\u0435 \u0446\u0456\u043A\u0430\u0432\u043E.
      \u042F \u0431\u0443\u0432 \u0431\u0438 \u0432\u043A\u0440\u0430\u0439 \u0432\u0434\u044F\u0447\u043D\u0438\u0439,
      \u044F\u043A\u0431\u0438 \u0442\u0438 \u0432\u0438\u043A\u043B\u0430\u043B\u0430
      \u0446\u0456 \u043D\u043E\u0432\u043E\u043F\u0440\u0438\u0434\u0431\u0430\u043D\u0456
      \u0437\u043D\u0430\u043D\u043D\u044F \u0432 \u043F\u0438\u0441\u044C\u043C\u043E\u0432\u043E\u043C\u0443
      \u0432\u0438\u0433\u043B\u044F\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824436
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043F\u0456\u0437\u043D\u0456\u0448\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824437
    m_Localized: "\u0410\u0430\u0430\u0430... \u043D\u0443 \u0434\u043E\u0431\u0440\u0435.
      \u0422\u0430\u043A \u043E\u0442, \u0427\u043E\u0440\u043D\u0430 \u041A\u043D\u0438\u0433\u0430.
      \u0412\u043E\u043D\u0430 \u0431\u0443\u043B\u0430 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u0431\u0430\u0433\u0430\u0442\u043E \u0441\u0442\u043E\u043B\u0456\u0442\u044C
      \u0442\u043E\u043C\u0443 \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0438\u043C
      \u0437\u0435\u0431\u0440\u043E\u044E-\u0430\u043B\u0445\u0456\u043C\u0456\u043A\u043E\u043C,
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430 \u043A\u0440\u043E\u0432'\u044E,
      \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0435\u043D\u0430 \u0432 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0443
      \u0448\u043A\u0456\u0440\u0443 \u0456 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0430
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E\u0433\u043E
      \u043D\u0430\u043C \u0437\u043B\u043E\u0433\u043E \u0448\u0430\u043C\u0430\u043D\u0441\u0442\u0432\u0430.
      \u0410\u043B\u0435 \u0446\u0435 \u0442\u0430\u043A, \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0439
      \u0431\u0456\u043A. \u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456,
      \u043F\u0440\u043E \u043D\u0435\u0457 \u043D\u0430\u043C \u0432\u0456\u0434\u043E\u043C\u043E
      \u043D\u0435 \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E.
      \u0410\u043B\u0435 \u0439 \u0442\u0435, \u0449\u043E \u0432\u0456\u0434\u043E\u043C\u043E,
      \u0432\u0440\u0430\u0436\u0430\u0454 \u0443\u044F\u0432\u0443. \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u0437 \u0457\u0457 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0431\u0438\u0442\u0438 \u0440\u0435\u0447\u0456
      \u043C\u0430\u0439\u0436\u0435 \u043D\u0435\u0440\u0443\u0439\u043D\u0456\u0432\u043D\u0438\u043C\u0438.
      \u0422\u0456\u043B\u044C\u043A\u0438 \u0443\u044F\u0432\u0438, \u044F\u043A
      \u0446\u044E \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u0456\u0441\u0442\u044C
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0438 \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0456
      \u0431\u0440\u043E\u043D\u0456! \u0421\u0430\u043C\u0443 \u043A\u043D\u0438\u0433\u0443
      \u0442\u0435\u0436 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0437\u043D\u0438\u0449\u0438\u0442\u0438
      \u0436\u043E\u0434\u043D\u0438\u043C \u0432\u0456\u0434\u043E\u043C\u0438\u043C
      \u043D\u0430\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824438
    m_Localized: "\u0410\u043B\u0435 \u0447\u043E\u043C\u0443 \u0436 \u0442\u043E\u0434\u0456
      \u0437\u0435\u0431\u0440\u0438 \u0441\u0430\u043C\u0456 \u043D\u0435 \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u043B\u0438
      \u0442\u0430\u043A\u043E\u0457 \u0431\u0440\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824439
    m_Localized: "\u0413\u0430\u0440\u043D\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F.
      \u041C\u0430\u0431\u0443\u0442\u044C, \u0437\u043D\u0430\u043D\u043D\u044F,
      \u0449\u043E \u043C\u0456\u0441\u0442\u044F\u0442\u044C\u0441\u044F \u0432
      \u0427\u043E\u0440\u043D\u0456\u0439 \u041A\u043D\u0438\u0437\u0456, \u0432\u0432\u0430\u0436\u0430\u043B\u0438\u0441\u044F
      \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u0438\u043C\u0438 \u0456
      \u0442\u0430\u0454\u043C\u043D\u0438\u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0441\u0435\u0440\u0435\u0434 \u0441\u0430\u043C\u0438\u0445 \u0437\u0435\u0431\u0440.
      \u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0447\u0430\u0440\u0438
      \u0446\u0456, \u0431\u0435\u0437\u0441\u0443\u043C\u043D\u0456\u0432\u043D\u043E,
      \u0437\u043B\u0456 \u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0430\u0436\u0430\u0434\u0430\u0442\u0438
      \u0447\u0438\u043C\u0430\u043B\u0443 \u0446\u0456\u043D\u0443, \u0441\u043A\u0430\u0436\u0456\u043C\u043E,
      \u0447\u0430\u0441\u0442\u043A\u0443 \u0434\u0443\u0448\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u0442\u0435\u043B\u044F.
      \u0412\u0442\u0456\u043C, \u0437\u0430 \u0446\u0456\u043D\u043E\u044E \u043C\u0438
      \u043D\u0435 \u043F\u043E\u0441\u0442\u043E\u0457\u043C\u043E, \u044F \u0441\u0430\u043C
      \u0457\u0457 \u0441\u043F\u043B\u0430\u0447\u0443, \u044F\u043A\u0449\u043E
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824440
    m_Localized: "\u0406 \u0446\u0435 \u0449\u0435 \u0434\u0430\u043B\u0435\u043A\u043E
      \u043D\u0435 \u0432\u0441\u0435. \u0410\u043B\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u044F \u0437\u043C\u043E\u0436\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u0438
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E,
      \u044F\u043A \u043F\u043E\u0431\u0430\u0447\u0443 \u041A\u043D\u0438\u0433\u0443
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E. \u041C\u0430\u0433\u0438
      \u0437 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0421\u0442\u0438\u043B\u044E, \u044F\u043A\u0456 \u0432\u0438\u0432\u0447\u0430\u043B\u0438
      \u0457\u0457, \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u0438\u043B\u0438
      \u0432\u0441\u0456 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438
      \u0441\u0432\u043E\u0457\u0445 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C,
      \u0456 \u0434\u043E \u043D\u0430\u0441 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u0435\u044F\u043A\u0456 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0438
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457. \u0425\u043E\u0447\u0430
      \u0446\u0435 \u044F\u043A\u0440\u0430\u0437 \u043C\u0435\u043D\u0435 \u0430\u043D\u0456\u0442\u0440\u043E\u0445\u0438
      \u043D\u0435 \u0434\u0438\u0432\u0443\u0454. \u0406 \u0441\u0430\u043C\u0430
      \u041A\u043D\u0438\u0433\u0430, \u0456 \u0437\u043D\u0430\u043D\u043D\u044F,
      \u0449\u043E \u043C\u0456\u0441\u0442\u044F\u0442\u044C\u0441\u044F \u0432
      \u043D\u0456\u0439, \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E,
      \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824441
    m_Localized: "\u0429\u043E \u0436, \u043F\u0440\u043E\u0444\u0435\u0441\u043E\u0440\u0435,
      \u0442\u0435\u043F\u0435\u0440 \u044F \u043A\u0440\u0430\u0449\u0435 \u0431\u0430\u0447\u0443
      \u0432\u0441\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u0443. \u0423\u0434\u0430\u0447\u0456
      \u0443 \u0432\u0430\u0448\u0438\u0445 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824442
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u0442\u0430 \u0410\u043D\u043A\u043B\u0430\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824443
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456? \u0410 \u0442\u0438
      \u0449\u043E \u0442\u0443\u0442 \u0440\u043E\u0431\u0438\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824444
    m_Localized: "\u0417\u0434\u0430\u0440\u043E\u0432, @lp! \u041D\u0435 \u0447\u0435\u043A\u0430\u043B\u0430,
      \u0442\u0430\u043A? \u0420\u0430\u0434\u0438\u0439 \u0442\u0435\u0431\u0435
      \u0431\u0430\u0447\u0438\u0442\u0438, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824445
    m_Localized: "\u041F\u043E\u043A\u0438 \u0442\u0438 \u0431\u0443\u043B\u0430
      \u0432 \u0421\u0442\u0456\u0439\u043B\u0456, \u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0447
      \u0441\u043F\u043E\u0432\u0456\u0441\u0442\u0438\u0432 \u043F\u0440\u043E \u0448\u0432\u0438\u0434\u043A\u0435
      \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F \u0432\u0441\u0456\u0445,
      \u0434\u043E \u043A\u043E\u0433\u043E \u043C\u043E\u0433\u043B\u0438 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u0439\u043E\u0433\u043E \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0438.
      \u041D\u0430 \u043D\u0430\u0448 \u043F\u043E\u0434\u0438\u0432, \u0442\u0430\u0431\u0456\u0440
      \u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u0433\u043E \u043F\u043E\u043D\u0456
      \u0437\u0430\u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u0432 \u0443
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C \u043E\u0431'\u0454\u0434\u043D\u0430\u0442\u0438
      \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824446
    m_Localized: "\u041D\u0443, \u0442\u0438\u043F\u0443 \u0442\u043E\u0433\u043E,
      \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824447
    m_Localized: "\"\u041E\u0431'\u0454\u0434\u043D\u0430\u0442\u0438 \u0441\u0438\u043B\u0438\"?
      \u0417 \u043A\u0438\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824448
    m_Localized: "\u0417\u0456 \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u043C\u0438
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430...
      \u0456 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430.
      \u0417\u0435\u0431\u0440\u0438, \u044F\u043A\u0456 \u0436\u0438\u0432\u0443\u0442\u044C
      \u0442\u0443\u0442, \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0438, \u0449\u043E
      \u0437 \u043D\u0438\u0445 \u0434\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824449
    m_Localized: "\u041D\u0430\u0448\u0456 \u043F\u043E\u043D\u0456 \u0431\u0443\u043B\u0438
      \u0432\u0441\u0456\u043C\u0430 \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438
      \"\u0437\u0430\", @lp. \u041D\u0430\u0448 \u0437\u0430\u0433\u0456\u043D \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0445
      \u0441\u0442\u0440\u0456\u043B\u044C\u0446\u0456\u0432 \u0443\u0436\u0435 \u043C\u0430\u0454
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u0438 \u0434\u043E \u0442\u0430\u0431\u043E\u0440\u0443
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824450
    m_Localized: "\u0426\u0435, \u043D\u0430\u043F\u0435\u0432\u043D\u043E, \u0434\u043E\u0431\u0440\u0435...
      \u0430\u043B\u0435 \u0447\u043E\u043C\u0443, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456?
      \u041D\u0430 \u0449\u043E \u0432\u0438 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0454\u0442\u0435?
      \u0410\u043D\u043A\u043B\u0430\u0432 - \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u0439
      \u0432\u043E\u0440\u043E\u0433, \u0456 \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0439\u043E\u0433\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824451
    m_Localized: "\u0406 \u0448\u043E \u043D\u0430\u043C \u0442\u0435\u043F\u0435\u0440,
      \u0441\u0438\u0434\u0456\u0442\u0438 \u0432 \u043A\u0443\u0442\u043A\u0443
      \u0456 \u043D\u0435 \u0441\u0443\u043D\u0443\u0442\u0438\u0441\u044F? \u0422\u0432\u0456\u0439
      \u0434\u0440\u0443\u0433 \u0437\u0456 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u043E\u043C
      \u0441\u043A\u0430\u0437\u0430\u0432, \u0448\u043E \u0410\u043D\u043A\u043B\u0430\u0432
      \u0431\u0443\u0434\u0435 \u043C\u0441\u0442\u0438\u0442\u0438\u0441\u044F \u0432\u0441\u0456\u043C
      \u043F\u0456\u0434\u0440\u044F\u0434, \u0456 \u0437\u043D\u0430\u0454\u0448,
      \u044F \u0439\u043E\u043C\u0443 \u043F\u043E\u0432\u0456\u0440\u044E. \u042F
      \u0436 \u0441\u0430\u043C \u0442\u0430\u043C \u0431\u0443\u0432, \u044F \u0437\u043D\u0430\u044E
      \u0457\u0445\u043D\u0456 \u043F\u043E\u0440\u044F\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824452
    m_Localized: "\u0422\u0438 \u0431\u0443\u0432 \u0441\u043E\u043B\u0434\u0430\u0442\u043E\u043C
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824453
    m_Localized: "\u041A\u0430\u043F\u0456\u0442\u0430\u043D \u0414\u0435\u0434\u0448\u043E\u0442
      \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456, \u0443 \u0441\u0430\u043C\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0439
      \u0432\u0456\u0434\u0441\u0442\u0430\u0432\u0446\u0456. \u0414\u043E \u0432\u0430\u0448\u0438\u0445
      \u043F\u043E\u0441\u043B\u0443\u0433. \u041C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \"\u043A\u0435\u043F\", \u043D\u0435 \u043E\u0431\u0440\u0430\u0436\u0443\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824454
    m_Localized: "\u0427\u043E\u043C\u0443 \u0442\u0438 \u043F\u0456\u0448\u043E\u0432
      \u0437\u0432\u0456\u0434\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824455
    m_Localized: "\u041D\u0443, \u0437\u043D\u0430\u0454\u0448, \u0442\u0438 \u0441\u0430\u043C\u0430
      \u0431\u0430\u0447\u0438\u043B\u0430 \u0457\u0445\u043D\u0456 \u043F\u043E\u0440\u044F\u0434\u043A\u0438.
      \u042F \u0434\u0430\u0432\u043D\u043E \u043F\u0456\u0448\u043E\u0432, \u0442\u043E\u0434\u0456
      \u043F\u0440\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E \u043D\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u043D\u0430\u0432\u0456\u0442\u044C,
      \u0430\u043B\u0435 \u0432\u0441\u0435 \u0436. \u041F\u043E\u0432\u0456\u0440,
      @lp, \u0432\u0456\u0434 \u043D\u0438\u0445 \u043D\u0430\u043C \u043D\u0456\u0447\u043E\u0433\u043E
      \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043D\u0435 \u0441\u0432\u0456\u0442\u0438\u043B\u043E
      \u0431 \u0437\u0430 \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0443.
      \u041C\u043E\u0436\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u0449\u043E \u0446\u0435 \u0442\u0438\u043F \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0435
      \u0434\u043B\u044F \u043C\u0435\u043D\u0435 \u0442\u0435\u043F\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824456
    m_Localized: "\u0412\u0438 \u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0456\u0442\u0438. \u041F\u043E\u0434\u0430\u043B\u0456. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0437 \u0442\u043E\u0431\u043E\u044E, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456,
      \u0430\u0434\u0436\u0435 \u044F\u043A\u0449\u043E \u0442\u0438 \u0434\u043E\u0431\u0440\u0435
      \u0437\u043D\u0430\u0454\u0448 \u0410\u043D\u043A\u043B\u0430\u0432, \u0442\u0438
      \u043C\u0456\u0433 \u0431\u0438 \u0432\u043A\u0430\u0437\u0430\u0442\u0438,
      \u043A\u0443\u0434\u0438 \u043D\u0435 \u0434\u043E\u0431\u0435\u0440\u0443\u0442\u044C\u0441\u044F
      \u0439\u043E\u0433\u043E \u0437\u0430\u0433\u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824457
    m_Localized: "\u041D\u0435 \u043F\u043E \u043D\u0430\u0448\u043E\u043C\u0443
      \u0446\u0435, @lp. \u0406 \u043D\u0456\u043A\u0443\u0434\u0438 \u043D\u0430\u043C
      \u0456\u0442\u0438 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E. \u0422\u0430
      \u0439 \u0449\u0435, \u043C\u0438 \u0432\u0441\u0456 \u0437\u043D\u0430\u0454\u043C\u043E
      \u043E\u0434\u043D\u0443 \u043F\u043E\u043D\u0456, \u044F\u043A\u0430 \u0431
      \u0442\u0430\u043A \u043D\u0435 \u0432\u0447\u0438\u043D\u0438\u043B\u0430.
      \u0417\u043D\u0430\u0454\u0448, @lp, \u0442\u0438 \u043C\u043E\u0436\u0435\u0448
      \u043D\u0435 \u043F\u043E\u043C\u0456\u0447\u0430\u0442\u0438 \u0437\u0430
      \u0441\u043E\u0431\u043E\u044E \u043D\u0456\u0447\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E,
      \u0430\u043B\u0435 \u0442\u0432\u0456\u0439 \u043F\u0440\u0438\u043A\u043B\u0430\u0434
      \u0443 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u043F\u0435\u0440\u0435\u0434
      \u043E\u0447\u0438\u043C\u0430 \u0441\u0442\u043E\u0457\u0442\u044C. \u042F
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0437\u0434\u0438\u0432\u0443\u0432\u0430\u0432\u0441\u044F,
      \u043A\u043E\u043B\u0438 \u0434\u0456\u0437\u043D\u0430\u0432\u0441\u044F,
      \u0448\u043E \u0437\u0435\u0431\u0440\u0430\u043C \u0456\u0437 \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438
      \u0442\u0438 \u0442\u0435\u0436 \u0432\u0441\u0442\u0438\u0433\u043B\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438. \u041D\u0430\u043C
      \u0431\u0443\u043B\u043E \u0449\u043E \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824458
    m_Localized: "... \u0414\u044F\u043A\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824459
    m_Localized: "\u0410\u043B\u0435 \u0432\u0441\u0435 \u0436 \u0441\u0430\u043C\u0435
      \u044F \u0441\u0432\u043E\u0457\u043C\u0438 \u0434\u0456\u044F\u043C\u0438
      \u0441\u043F\u0440\u043E\u0432\u043E\u043A\u0443\u0432\u0430\u043B\u0430 \u0410\u043D\u043A\u043B\u0430\u0432.
      \u0412\u0438 \u0432\u0441\u0456 \u0442\u0435\u043F\u0435\u0440 \u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0446\u0456
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824460
    m_Localized: "\u0417\u0430\u0431\u0443\u0434\u044C \u0446\u0435, @lp. \u042F
      \u0442\u043E\u0431\u0456 \u043A\u0430\u0436\u0443. \u0417\u0430\u0431\u0443\u0434\u044C.
      \u042F\u043A\u0449\u043E \u0432\u0436\u0435 \u0446\u0456 \u0441\u043E\u043B\u0434\u0430\u0444\u043E\u043D\u0438
      \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044F \u0441\u044E\u0434\u0438,
      \u0437\u043D\u0430\u0447\u0438\u0442\u044C, \u0437 \u0432\u043B\u0430\u0441\u043D\u043E\u0457
      \u0432\u043E\u043B\u0456 \u0432\u043E\u043D\u0438 \u043D\u0435 \u043F\u0456\u0434\u0443\u0442\u044C
      \u0443\u0436\u0435. \u041F\u043E\u0432\u0456\u0440, \u044F \u0437\u043D\u0430\u044E.
      \u041D\u0456\u0447\u043E\u0433\u043E \u0442\u0438 \u043D\u0435 \u0441\u043F\u0440\u043E\u0432\u043E\u043A\u0443\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824461
    m_Localized: "\u0422\u0443\u0442 \u0432\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0430
      \u0432 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u0445, \u0431\u0443\u0434\u044C-\u044F\u043A\u0430
      \u0432\u0456\u0439\u043D\u0430 \u0437\u0430\u0432\u0436\u0434\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0438\u0445. \u041F\u0435\u0433\u0430\u0441\u0438 \u0434\u043E\u0432\u0433\u043E
      \u0436\u0438\u043B\u0438 \u043D\u0430 \u0445\u043C\u0430\u0440\u0430\u0445,
      \u0430\u043B\u0435 \u0432\u0456\u0447\u043D\u043E \u0442\u0430\u043A \u0442\u0440\u0438\u0432\u0430\u0442\u0438
      \u043D\u0435 \u043C\u043E\u0433\u043B\u043E. \u0423 \u0445\u043C\u0430\u0440\u0430\u0445,
      \u0437\u043D\u0430\u0454\u0448, \u043D\u0435\u043C\u0430\u0454 \u043D\u0456
      \u043C\u0435\u0442\u0430\u043B\u0443, \u043D\u0456 \u0432\u0443\u0433\u0456\u043B\u043B\u044F,
      \u0442\u0430 \u0439 \u0456\u0437 \u0457\u0436\u0435\u044E, \u043F\u0440\u044F\u043C
      \u0441\u043A\u0430\u0436\u0443, \u0442\u0443\u0433\u043E\u0432\u0430\u0442\u043E.
      \u0412\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F \u0431 \u0432\u0456\u0434\u0431\u0443\u043B\u043E\u0441\u044F
      \u0437\u0430 \u0431\u0443\u0434\u044C-\u0448\u043E, \u043D\u0435 \u0449\u0430\u0441,
      \u0442\u0430\u043A \u0447\u0435\u0440\u0435\u0437 \u0440\u0456\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824462
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u043F\u0440\u0438\u043B\u0435\u0442\u0456\u0432
      \u0441\u044E\u0434\u0438, \u0449\u043E\u0431 \u0443\u0437\u0433\u043E\u0434\u0438\u0442\u0438
      \u0434\u0456\u0457 \u0437 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u043E\u043C.
      \u0410\u043B\u0435 \u0410\u0441\u043A\u0430\u0440\u0456 \u0432\u0436\u0435
      \u0442\u0435\u0436 \u043C\u0430\u0454 \u043D\u0430\u0431\u043B\u0438\u0436\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u0442\u0430\u0431\u043E\u0440\u0443 \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, @lp. \u0423 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430
      \u0454 \u043F\u043B\u0430\u043D, \u044F\u043A \u043C\u043E\u0436\u043D\u0430
      \u043E\u0431'\u0454\u0434\u043D\u0430\u0442\u0438 \u043D\u0430\u0448\u0456
      \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824463
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u043D\u0443 \u0430 \u0437\u0435\u0431\u0440\u0438-\u0442\u043E
      \u0447\u043E\u043C\u0443 \u0445\u043E\u0447\u0443\u0442\u044C \u0432\u0456\u0439\u043D\u0438?
      \u0412\u043E\u043D\u0438 \u0436 \u0437\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044F
      \u0439\u0442\u0438 \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824464
    m_Localized: "\u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438,
      \u0446\u0435 \u044F \u0457\u0445 \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824465
    m_Localized: ??!
    m_Metadata:
      m_Items: []
  - m_Id: 2737824466
    m_Localized: "\u0417\u0435\u0431\u0440\u0438 \u0442\u0443\u0442 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043A\u0440\u0430\u0449\u0435, \u0430\u043B\u0435 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432\u0456\u0434\u0445\u0456\u0434 \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447
      - \u0446\u0435 \u043C\u0430\u0439\u0436\u0435 \u0432\u0456\u0440\u043D\u0430
      \u0441\u043C\u0435\u0440\u0442\u044C \u0434\u043B\u044F \u0431\u0456\u043B\u044C\u0448\u043E\u0441\u0442\u0456
      \u0437 \u043D\u0438\u0445. \u0411\u0438\u0442\u0438\u0441\u044F \u0442\u0443\u0442
      \u0437\u0430 \u0448\u0430\u043D\u0441 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      - \u0457\u0445\u043D\u044F \u0454\u0434\u0438\u043D\u0430 \u0441\u043A\u0456\u043B\u044C\u043A\u0438-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0440\u0435\u0430\u043B\u044C\u043D\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0432\u0438\u0436\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824467
    m_Localized: "\u0410\u043B\u0435 \u0436 \u0442\u0438 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0431\u0443\u043B\u0430 \u043F\u0440\u043E\u0442\u0438 \u043D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0429\u043E \u0437\u043C\u0456\u043D\u0438\u043B\u043E\u0441\u044F \u0437\u0430\u0440\u0430\u0437?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824468
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E. \u0410\u043B\u0435 \u043A\u043E\u043B\u0438
      \u043C\u043E\u0432\u0430 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u043F\u0440\u043E
      \u0432\u0438\u0431\u0456\u0440 \u043C\u0456\u0436 \u0432\u0456\u0439\u043D\u043E\u044E
      \u0456 \u0437\u0430\u0433\u0438\u0431\u0435\u043B\u043B\u044E... \u042F \u043D\u0435
      \u0434\u0443\u0440\u0430, @lp. \u0410 \u043F\u043E\u043D\u0456 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u0437\u0430\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u044E\u0442\u044C \u043D\u0430
      \u0436\u0438\u0442\u0442\u044F \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436 \u0446\u0456 \u043F\u0435\u0440\u043D\u0430\u0442\u0456
      \u043C\u0456\u043B\u0456\u0442\u0430\u0440\u0438\u0441\u0442\u0438. \u041D\u0435\u0445\u0430\u0439
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u043C \u0432\u0438\u0431\u043E\u0440\u043E\u043C
      \u0431\u0443\u043B\u043E \u0431 \u043D\u0435 \u0431\u0438\u0442\u0438\u0441\u044F
      \u0437\u043E\u0432\u0441\u0456\u043C, \u0430\u043B\u0435 \u044F\u043A\u0449\u043E
      \u0446\u0435 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u043A\u0440\u0430\u0449\u0435
      \u0432\u0436\u0435 \u0432\u0437\u044F\u0442\u0438\u0441\u044F \u0437\u0430
      \u0437\u0431\u0440\u043E\u044E \u043F\u0435\u0440\u0448\u0438\u043C\u0438.
      \u0406 \u0449\u0435. \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u0437\u0430\u0437\u043D\u0430\u0447\u0438\u0432,
      \u0449\u043E \u0442\u0438 \u0431\u0443\u043B\u0430 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C
      \u0434\u043B\u044F \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u0443
      \u0439\u043E\u0433\u043E \u0442\u0430\u0431\u043E\u0440\u0456. \u041F\u043E\u0432\u0456\u0440,
      \u0442\u0443\u0442 \u0442\u0435\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824469
    m_Localized: "\u0422\u0432\u043E\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430
      \u043C\u0430\u0454 \u0440\u0430\u0446\u0456\u044E, @lp. \u041C\u043E\u0436\u0435,
      \u044F\u043A\u0431\u0438 \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456
      \u0431\u0443\u043B\u043E \u0431 \u0431\u0456\u043B\u044C\u0448\u0435 \u0442\u0430\u043A\u0438\u0445,
      \u044F\u043A \u0432\u0438 \u0437 \u043D\u0435\u044E, \u043D\u0430\u043C \u0442\u0443\u0442
      \u0436\u0438\u043B\u043E\u0441\u044F \u0431 \u043B\u0435\u0433\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824470
    m_Localized: "\u0422\u0430\u043A, @lp, \u044F \u0449\u0430 \u0432\u0456\u0434\u043B\u0456\u0442\u0430\u044E
      \u0442\u0435\u0436 \u0434\u043E \u0432\u0441\u0456\u0445 \u043D\u0430 \u043F\u043E\u0440\u0430\u0434\u0443.
      \u041E\u0443\u043A \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0432
      \u043D\u0430\u043C \u043F\u0440\u043E \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430,
      \u044F\u043A\u0448\u043E \u043D\u0435 \u043D\u0430\u0431\u0440\u0435\u0445\u0430\u0432,
      \u0442\u043E \u043A\u0440\u0430\u0449\u0435 \u043F\u043E\u0441\u043B\u0443\u0445\u0430\u0442\u0438,
      \u0448\u043E \u0432\u0456\u043D \u0442\u0430\u043C \u043F\u043B\u0430\u043D\u0443\u0454.
      \u0406 \u0434\u0443\u043C\u0430\u044E, \u0442\u0438 \u0442\u0430\u043C \u0442\u0435\u0436
      \u0437\u0430\u0439\u0432\u043E\u044E \u043D\u0435 \u0431\u0443\u0434\u0435\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824471
    m_Localized: "\u0422\u0432\u043E\u0457 \u0431\u043E\u0439\u043E\u0432\u0456 \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u0439\u043E\u043C\u0443 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0438\u0441\u044F.
      \u0417\u0430 \u043D\u0430\u0441 \u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F,
      @lp, \u0442\u0443\u0442 \u0454, \u043A\u043E\u043C\u0443 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0443\u0432\u0430\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824472
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442, \u0449\u043E\u0434\u043E
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824473
    m_Localized: "\u041D\u0435 \u043F\u043E\u0433\u043E\u0434\u0438\u0432\u0441\u044F,
      \u0442\u0430\u043A? \u0412\u0438\u0440\u0456\u0448\u0438\u0432 \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u0441\u044F
      \u0456 \u0441\u0438\u0434\u0456\u0442\u0438 \u0434\u0430\u043B\u0456, \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0447\u0438\u0441\u044C,
      \u0449\u043E \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u043D\u0435
      \u0447\u0456\u043F\u0430\u0442\u0438\u043C\u0443\u0442\u044C? \u0426\u0435
      \u043D\u0435 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F \u0434\u043B\u044F
      \u043C\u0435\u043D\u0435, @lp. \u0419\u043E\u043C\u0443 \u0431 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E \u0441\u043C\u0456\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0441\u0442\u0430\u0442\u0438 \u043D\u0430 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0442\u0438\u0445, \u0445\u0442\u043E \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454.
      \u041D\u0435 \u0437\u0432\u0438\u043D\u0443\u0432\u0430\u0447\u0443\u0439 \u0441\u0435\u0431\u0435
      \u0437\u0430 \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824474
    m_Localized: "\u0414\u043E\u0431\u0440\u0435. \u0422\u043E\u0434\u0456 \u044F,
      \u043D\u0430\u043F\u0435\u0432\u043D\u043E, \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u044E\u0441\u044F
      \u0434\u043E \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456. \u042F\u043A\u0449\u043E
      \u0454 \u0449\u043E\u0441\u044C, \u0447\u0438\u043C \u044F \u043C\u043E\u0436\u0443
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0443,
      \u044F \u0437\u0440\u043E\u0431\u043B\u044E \u0446\u0435, \u043E\u0431\u0456\u0446\u044F\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824475
    m_Localized: "\u042F \u043D\u0435 \u0441\u0443\u043C\u043D\u0456\u0432\u0430\u044E\u0441\u044F
      \u0432 \u0446\u044C\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824476
    m_Localized: "\u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430 \u0440\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824477
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, @lp. \u042F \u0437\u043C\u0443\u0448\u0435\u043D\u0438\u0439
      \u0432\u0438\u0437\u043D\u0430\u0442\u0438, \u0442\u0438 \u0437\u043D\u043E\u0432\u0443
      \u0437\u043C\u043E\u0433\u043B\u0430 \u043C\u0435\u043D\u0435 \u0437\u0434\u0438\u0432\u0443\u0432\u0430\u0442\u0438.
      \u0417\u0430\u0432\u0434\u044F\u043A\u0438 \u0442\u043E\u0431\u0456 \u0456
      \u0442\u0432\u043E\u0457\u043C \u0434\u0440\u0443\u0437\u044F\u043C \u0443
      \u043C\u0435\u043D\u0435 \u043D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u043E
      \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F \u043D\u043E\u0432\u0456
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824478
    m_Localized: "... \u0456 \u043D\u043E\u0432\u0456 \u0432\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824479
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456 \u0441\u043A\u0430\u0437\u0430\u0432,
      \u0449\u043E \u0442\u0435\u0431\u0435 \u0432\u0436\u0435 \u0432\u0432\u0435\u043B\u0438
      \u0432 \u043A\u0443\u0440\u0441 \u0441\u043F\u0440\u0430\u0432\u0438. \u041D\u0435
      \u0431\u0443\u0434\u0435\u043C\u043E \u0433\u0430\u044F\u0442\u0438 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824480
    m_Localized: "\u041E\u0442\u0436\u0435. \u042F\u043A \u044F \u0432\u0436\u0435
      \u0441\u043A\u0430\u0437\u0430\u0432, \u0441\u043F\u0456\u043B\u044C\u043D\u0430
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0437\u043D\u0430\u0447\u0430\u0454
      \u0441\u043F\u0456\u043B\u044C\u043D\u0456 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438.
      \u042F\u043A\u0449\u043E \u043C\u0438 \u043F\u043B\u0430\u043D\u0443\u0454\u043C\u043E
      \u0432\u0435\u0441\u0442\u0438 \u0441\u043F\u0456\u043B\u044C\u043D\u0456 \u0431\u043E\u0439\u043E\u0432\u0456
      \u0434\u0456\u0457, \u043D\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E
      \u0441\u043F\u0435\u0440\u0448\u0443 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0437 \u043F\u043E\u0442\u043E\u0447\u043D\u0438\u043C\u0438 \u0437\u0430\u0433\u0440\u043E\u0437\u0430\u043C\u0438,
      \u0456 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0446\u0435 \u043F\u0435\u0440\u0448,
      \u043D\u0456\u0436 \u0410\u043D\u043A\u043B\u0430\u0432 \u043F\u0435\u0440\u0435\u0439\u0434\u0435
      \u0434\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0445 \u0434\u0456\u0439.
      \u041D\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u043D\u0430\u043F\u0430\u0441\u0442\u0438
      \u0456 \u0437\u0430\u0445\u043E\u043F\u0438\u0442\u0438 \u0444\u043E\u0440\u0442
      \u0420\u043E\u043A\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824481
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u043F\u0443\u0441\u0442\u0438\u0442\u0438,
      \u0449\u043E \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0441\u044F
      \u043F\u043E\u0437\u0431\u0443\u0442\u0438\u0441\u044F \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0456\u0432
      \u0432\u0430\u0448\u0438\u043C\u0438 \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438.
      \u041E\u0434\u043D\u0430\u043A \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u044E
      \u0437\u0430\u043C\u0438\u0441\u043B\u0438\u0442\u0438\u0441\u044F \u043D\u0430\u0434
      \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u043C: \u043F\u043E\u0441\u043B\u0456\u0434\u043E\u0432\u043D\u0438\u043A\u0438
      \u043D\u0438\u043D\u0456 \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u0456 \u041B\u0435\u0433\u0456\u043E\u043D \u041A\u0435\u0441\u0430\u0440\u0456\u044F
      \u0432\u0435\u0434\u0443\u0442\u044C \u043D\u0435\u043F\u0440\u0438\u043C\u0438\u0440\u0435\u043D\u043D\u0443
      \u0432\u0456\u0439\u043D\u0443 \u0437 \u043C\u043E\u0457\u043C\u0438 \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438,
      \u0456 \u0434\u043E\u0442\u0438, \u0434\u043E\u043A\u0438 \u0431\u0443\u0434\u044C-\u0445\u0442\u043E
      \u0437 \u043D\u0430\u0441 \u043D\u0435 \u0432\u0438\u0437\u043D\u0430\u0454
      \u043A\u0430\u043F\u0456\u0442\u0443\u043B\u044F\u0446\u0456\u0457, \u0432\u043E\u043D\u0430
      \u043D\u0435 \u0432\u0449\u0443\u0445\u043D\u0435. \u042F\u043A\u0449\u043E
      \u043C\u0438 \u043D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043C\u043E
      \u0432\u0456\u0439\u043D\u0443 \u0437\u0430\u0440\u0430\u0437, \u043C\u043E\u0457
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438 \u043D\u0435
      \u043F\u0440\u043E\u043C\u0438\u043D\u0443\u0442\u044C \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044E
      \u0432\u0434\u0430\u0440\u0438\u0442\u0438 \u043D\u0430\u043C \u0443 \u0441\u043F\u0438\u043D\u0443
      \u0432 \u043D\u0430\u0439\u043D\u0435\u0441\u043F\u0440\u0438\u044F\u0442\u043B\u0438\u0432\u0456\u0448\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824482
    m_Localized: "\u0414\u043E\u0434\u0430\u043C, \u0449\u043E \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044F
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043D\u0430\u0448\u043E\u0433\u043E
      \u0443\u043A\u0440\u0456\u043F\u0440\u0430\u0439\u043E\u043D\u0443 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E
      \u043A\u0438\u0448\u0438\u0442\u044C \u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0430\u043C\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u0417 \u0436\u0430\u043B\u0435\u043C
      \u0437\u043C\u0443\u0448\u0435\u043D\u0430 \u0432\u0438\u0437\u043D\u0430\u0442\u0438,
      \u0449\u043E \u0436\u043E\u0434\u043D\u0456 \u043D\u0430\u0448\u0456 \u0437\u0430\u0445\u043E\u0434\u0438
      \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u043B\u0438 \u0434\u043E \u0443\u0441\u0443\u043D\u0435\u043D\u043D\u044F
      \u0446\u0456\u0454\u0457 \u0437\u0430\u0433\u0440\u043E\u0437\u0438. \u0426\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E \u043D\u0435\u0437\u0430\u043B\u0435\u0436\u043D\u043E
      \u0432\u0456\u0434 \u0442\u043E\u0433\u043E, \u044F\u043A\u0435 \u0440\u0456\u0448\u0435\u043D\u043D\u044F
      \u043C\u0438 \u0443\u0445\u0432\u0430\u043B\u0438\u043C\u043E \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456,
      \u041A\u0435\u0441\u0430\u0440\u0456\u044E \u0431\u0443\u0434\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043E
      \u043F\u0440\u043E \u043D\u0430\u0448 \u0456\u0437 \u0432\u0430\u043C\u0438
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442. \u0412\u0438 \u0432\u0441\u0456
      \u0432\u0436\u0435 \u0432 \u0441\u043F\u0438\u0441\u043A\u0443 \u0437\u0430\u0433\u0440\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824483
    m_Localized: "\u0414\u044F\u043A\u0443\u044E, \u043F\u0438\u0441\u0430\u0440.
      \u041E\u0434\u043D\u0430\u043A \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F
      \u0430\u0436 \u043D\u0456\u044F\u043A \u043D\u0435 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0430\u0436\u043A\u0430, \u044F\u043A \u043C\u043E\u0433\u043B\u043E
      \u0431 \u0437\u0434\u0430\u0442\u0438\u0441\u044F. \u041C\u043E\u0457 \u0432\u0456\u0439\u0441\u044C\u043A\u0430
      \u043D\u0430 \u0434\u0430\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0434\u043E\u0441\u044F\u0433\u043B\u0438 \u0437\u043D\u0430\u0447\u043D\u043E\u0457
      \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u0430\u043B\u044C\u043D\u043E\u0457
      \u0442\u0430 \u0447\u0438\u0441\u0435\u043B\u044C\u043D\u043E\u0457 \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0438
      \u043D\u0430\u0434 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C.
      \u0421\u0442\u0440\u043E\u0433\u043E \u043A\u0430\u0436\u0443\u0447\u0438,
      \u0432\u043E\u0440\u043E\u0433 \u0443\u0436\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u0432.
      \u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u0437\u0430\u043B\u0438\u0448\u043A\u0438
      \u0439\u043E\u0433\u043E \u043E\u043F\u043E\u0440\u0443. \u0406 \u0442\u0443\u0442
      \u043C\u0438 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454\u043C\u043E\u0441\u044F
      \u0434\u043E \u0444\u043E\u0440\u0442\u0443 \u0420\u043E\u043A\u0441. \u041D\u0430\u0440\u0430\u0437\u0456
      \u0446\u044F \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0430 \u0444\u043E\u0440\u0442\u0435\u0446\u044F
      \u0454 \u0448\u0442\u0430\u0431-\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043E\u044E
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u0456 \u0454\u0434\u0438\u043D\u043E\u044E \u0446\u0438\u0442\u0430\u0434\u0435\u043B\u043B\u044E,
      \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F \u0432
      \u0457\u0445\u043D\u0456\u0445 \u043A\u043E\u043F\u0438\u0442\u0430\u0445.
      \u0423 \u043D\u0456\u0439 \u0437\u043E\u0441\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u0456
      \u0457\u0445\u043D\u0456 \u043E\u0441\u043D\u043E\u0432\u043D\u0456 \u0441\u0438\u043B\u0438,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0437\u043D\u0430\u0447\u043D\u0456
      \u043F\u0456\u0434\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u043D\u044F \u0437
      \u0431\u043E\u043A\u0443 \u041B\u0435\u0433\u0456\u043E\u043D\u0443. \u0420\u0435\u0448\u0442\u0430
      \u043F\u0456\u0434\u0440\u043E\u0437\u0434\u0456\u043B\u0456\u0432 \u0440\u043E\u0437\u0441\u0456\u044F\u043D\u0456
      \u043F\u043E \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445
      \u0431\u0430\u0437\u0430\u0445 \u0456 \u043F\u0443\u043D\u043A\u0442\u0430\u0445
      \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F.
      \u0412\u0437\u044F\u0442\u0442\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u043C
      \u0444\u043E\u0440\u0442\u0443 \u0420\u043E\u043A\u0441 \u043E\u0437\u043D\u0430\u0447\u0430\u0454
      \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u043D\u044F \u0443\u0434\u0430\u0440\u0443,
      \u043F\u0456\u0441\u043B\u044F \u044F\u043A\u043E\u0433\u043E \u0432\u043E\u0440\u043E\u0433
      \u0443\u0436\u0435 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435 \u0431\u0438\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824484
    m_Localized: "\u0417\u0430 \u0432\u0441\u0456\u0454\u0457 \u043F\u043E\u0432\u0430\u0433\u0438,
      \u0437\u043E\u0440\u044F\u043D\u0438\u0439 \u043F\u0430\u043B\u0430\u0434\u0438\u043D\u0435,
      \u0444\u043E\u0440\u0442 \u0420\u043E\u043A\u0441 - \u043E\u0434\u043D\u0430
      \u0437 \u043D\u0430\u0439\u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0445
      \u0444\u043E\u0440\u0442\u0435\u0446\u044C \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457
      \u0437\u0430 \u0432\u0441\u044E \u0457\u0457 \u0456\u0441\u0442\u043E\u0440\u0456\u044E.
      \u0407\u0457 \u0441\u0442\u0456\u043D\u0438 \u043D\u0435\u043F\u0440\u0438\u0441\u0442\u0443\u043F\u043D\u0456,
      \u0430 \u0430\u0440\u0442\u0438\u043B\u0435\u0440\u0456\u0439\u0441\u044C\u043A\u0456
      \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F \u0432\u0441\u0435\u043F\u0440\u0438\u0433\u043D\u0456\u0447\u0443\u0432\u0430\u043B\u044C\u043D\u0456.
      \u042F\u043A\u0449\u043E \u043C\u0438 \u0441\u043F\u0440\u043E\u0431\u0443\u0454\u043C\u043E
      \u0448\u0442\u0443\u0440\u043C\u0443\u0432\u0430\u0442\u0438 \u0457\u0457 \u043D\u0430\u044F\u0432\u043D\u0438\u043C\u0438
      \u0441\u0438\u043B\u0430\u043C\u0438, \u0446\u0435 \u0431\u0443\u0434\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0456\u0439\u043D\u044F. \u0413\u0430\u0434\u0430\u044E,
      \u0443 \u0432\u0430\u0441 \u0454 \u0456\u043D\u0448\u0438\u0439 \u043F\u043B\u0430\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824485
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0434\u0456, \u0430\u0442\u0430\u043A\u0430
      \u0432 \u043B\u043E\u0431 \u043D\u0435\u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043D\u0430
      \u043D\u0456 \u0432 \u044F\u043A\u043E\u043C\u0443 \u0440\u043E\u0437\u0433\u043B\u044F\u0434\u0456.
      \u0414\u043E \u043D\u043E\u0432\u0438\u043D \u043F\u0440\u043E \u0448\u0432\u0438\u0434\u043A\u0435
      \u043F\u0440\u0438\u0431\u0443\u0442\u0442\u044F \u0410\u043D\u043A\u043B\u0430\u0432\u0443
      \u044F \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0432
      \u0431\u0440\u0430\u0442\u0438 \u0446\u044E \u0444\u043E\u0440\u0442\u0435\u0446\u044E
      \u0437\u043C\u043E\u0440\u043E\u043C, \u043E\u0434\u043D\u0430\u043A \u0442\u0435\u043F\u0435\u0440
      \u0446\u0435\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442 \u0442\u0430\u043A\u043E\u0436
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0438\u0439. \u0422\u043E\u043C\u0443
      \u043D\u0430\u043C \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u043E\u043A\u043B\u0430\u0441\u0442\u0438\u0441\u044F \u043D\u0430 \u0456\u043D\u0448\u0438\u0439
      \u043F\u043B\u0430\u043D \u0434\u0456\u0439. \u042F\u043A\u0449\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0447\u0435\u0441\u043D\u043E, \u0432\u0456\u043D \u0440\u0438\u0437\u0438\u043A\u043E\u0432\u0430\u043D\u0438\u0439,
      \u043F\u0440\u043E\u0442\u0435 \u0456\u043D\u0448\u043E\u0433\u043E \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0443
      \u0432 \u043D\u0430\u0441 \u043D\u0435\u043C\u0430\u0454. \u041F\u0440\u043E\u0448\u0443,
      \u043F\u0438\u0441\u0430\u0440 \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824486
    m_Localized: "\u041C\u0438 \u0432\u043E\u043B\u043E\u0434\u0456\u0454\u043C\u043E
      \u0434\u043E\u0441\u0438\u0442\u044C \u0434\u043E\u043A\u043B\u0430\u0434\u043D\u0438\u043C
      \u043F\u043B\u0430\u043D\u043E\u043C \u0444\u043E\u0440\u0442\u0435\u0446\u0456
      \u0439 \u0443 \u0432\u0441\u0456\u0445 \u043F\u043E\u0434\u0440\u043E\u0431\u0438\u0446\u044F\u0445
      \u0437\u043D\u0430\u0454\u043C\u043E \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438
      \u0457\u0457 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0432\u0430\u043D\u043D\u044F.
      \u0424\u043E\u0440\u0442 \u0420\u043E\u043A\u0441 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448 \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0438\u043C\u0438
      \u0430\u0440\u0442\u0438\u043B\u0435\u0440\u0456\u0439\u0441\u044C\u043A\u0438\u043C\u0438
      \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F\u043C\u0438, \u044F\u043A\u0456
      \u0432\u0441\u0442\u0438\u0433\u043B\u0430 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044F \u0434\u043E \u0441\u0432\u043E\u0454\u0457
      \u0437\u0430\u0433\u0438\u0431\u0435\u043B\u0456. \u0426\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u0432\u0441\u0456 \u0440\u0443\u0448\u0456\u0439\u043D\u043E-\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u043B\u044C\u043D\u0456
      \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043E\u043A
      \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C \u043D\u0430 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u0430\u0445.
      \u0422\u0435 \u0436 \u0441\u0430\u043C\u0435 \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0445 \u0432\u043E\u0440\u0456\u0442
      \u0444\u043E\u0440\u0442\u0435\u0446\u0456. \u041D\u0430 \u0432\u0438\u043F\u0430\u0434\u043E\u043A
      \u043F\u0435\u0440\u0435\u0431\u043E\u0457\u0432 \u0437 \u043F\u043E\u0434\u0430\u0447\u0435\u044E
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457 \u0432\u0441\u0456 \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u0456
      \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u0456
      \u0454\u043C\u043D\u0438\u043C\u0438 \u0430\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u043D\u0438\u043C\u0438
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F\u043C\u0438, \u043E\u0434\u043D\u0430\u043A
      \u0437\u0430 \u0434\u0432\u0456 \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432
      \u0432\u043E\u043D\u0438 \u0437\u0430\u0437\u043D\u0430\u043B\u0438 \u043D\u0435\u043F\u043E\u043F\u0440\u0430\u0432\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u0432\u0456\u0434 \u0443\u043C\u043E\u0432
      \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u044C\u043E\u0433\u043E
      \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0430. \u041C\u0438
      \u0434\u0430\u0432\u043D\u043E \u043A\u0438\u043D\u0443\u043B\u0438 \u0432\u0441\u0456
      \u0441\u043F\u0440\u043E\u0431\u0438 \u0457\u0445 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438.
      \u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E, \u044F\u043A\u0449\u043E
      \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u0432\u0456\u0434 \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0433\u043E
      \u0434\u0436\u0435\u0440\u0435\u043B\u0430 \u0435\u043D\u0435\u0440\u0433\u0456\u0457,
      \u0457\u0445\u043D\u0454 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0432\u0430\u043D\u043D\u044F
      \u0431\u0443\u0434\u0435 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824487
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0456\u0448\u0435 \u043A\u0430\u0436\u0443\u0447\u0438,
      \u044F\u043A\u0449\u043E \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438
      \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0438 - \u0433\u0430\u0440\u043C\u0430\u0442\u0438
      \u0437\u0430\u043C\u043E\u0432\u043A\u043D\u0443\u0442\u044C, \u0432\u0456\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824488
    m_Localized: "\u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E. \u041D\u0430\u0440\u0430\u0437\u0456
      \u0432\u0441\u0456 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0436\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434 \u0454\u0434\u0438\u043D\u043E\u0457 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0456\u0457.
      \u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0432 \u0442\u043E\u043C\u0443,
      \u0449\u043E \u0432\u043E\u043D\u0430 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0430
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0444\u043E\u0440\u0442\u0443.
      \u0429\u043E\u0431 \u0457\u0457 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438,
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443 \u0444\u043E\u0440\u0442\u0435\u0446\u0456.
      \u041D\u0430\u043C \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u043E\u043A\u043B\u0430\u0441\u0442\u0438\u0441\u044F \u043D\u0430 \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u0430,
      \u044F\u043A\u0438\u0439 \u0437\u043C\u043E\u0436\u0435 \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438
      \u0441\u0442\u0456\u043D\u0438 \u0444\u043E\u0440\u0442\u0435\u0446\u0456,
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0456\u0457
      \u0456 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u043F\u043E\u0434\u0430\u0447\u0443
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824489
    m_Localized: "\u0406 \u0432 \u0446\u044C\u043E\u043C\u0443 \u0432\u0441\u044F
      \u0437\u0430\u043A\u043E\u0432\u0438\u043A\u0430, \u0442\u0430\u043A? \u0417\u043D\u0430\u0454\u0442\u0435,
      \u044F \u0447\u043E\u0433\u043E\u0441\u044C \u043D\u0435 \u0431\u0430\u0447\u0443,
      \u044F\u043A \u0446\u0435 \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438.
      \u042F, \u0437\u0432\u0456\u0441\u043D\u043E, \u043C\u043E\u0436\u0443 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u043E\u043B\u0435\u0442\u0456\u0442\u0438 \u043D\u0430\u0434 \u043D\u0438\u043C\u0438
      \u0437 \u0431\u043E\u043C\u0431\u043E\u0447\u043A\u043E\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824490
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442,
      \u0430\u043B\u0435, \u043D\u0430 \u0436\u0430\u043B\u044C, \u0444\u043E\u0440\u0442
      \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439 \u0437\u0435\u043D\u0456\u0442\u043D\u0438\u043C\u0438
      \u0433\u0430\u0440\u043C\u0430\u0442\u0430\u043C\u0438. \u0421\u043F\u0440\u043E\u0431\u0430
      \u0434\u043E\u043B\u0435\u0442\u0456\u0442\u0438 \u0434\u043E \u0446\u0456\u043B\u0456
      \u0437 \u0431\u043E\u043C\u0431\u043E\u044E \u043F\u0440\u0438\u0440\u0435\u0447\u0435\u043D\u0430
      \u043D\u0430 \u043F\u0440\u043E\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824491
    m_Localized: "\u041C\u0438 \u0442\u0430\u043A\u043E\u0436 \u043D\u0435 \u0432\u043E\u043B\u043E\u0434\u0456\u0454\u043C\u043E
      \u0436\u043E\u0434\u043D\u0438\u043C\u0438 \u0430\u0440\u0442\u0438\u043B\u0435\u0440\u0456\u0439\u0441\u044C\u043A\u0438\u043C\u0438
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430\u043C\u0438, \u0437\u0434\u0430\u0442\u043D\u0438\u043C\u0438
      \u0437\u0434\u0456\u0439\u0441\u043D\u0438\u0442\u0438 \u0437\u0430\u043A\u0438\u0434
      \u0441\u043D\u0430\u0440\u044F\u0434\u0430 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044E,
      \u0432\u0438\u0449\u0443 \u0437\u0430 \u0440\u0430\u0434\u0456\u0443\u0441
      \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F \u0433\u0430\u0440\u043C\u0430\u0442
      \u0444\u043E\u0440\u0442\u0443. \u0421\u0430\u043C\u0435 \u0442\u043E\u043C\u0443
      \u044F \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u044E \u0437\u0430\u0440\u0430\u0437
      \u043F\u043E\u0447\u0443\u0442\u0438 \u0432\u0430\u0448\u0456 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824492
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0443 \u043C\u0435\u043D\u0435
      \u0454 \u0440\u0456\u0448\u0435\u043D\u043D\u044F. \u0423 \u0434\u0430\u0432\u043D\u0438\u043D\u0443,
      \u0449\u0435 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u043E\u043B\u0438
      \u043C\u043E\u044F \u0431\u0430\u0442\u044C\u043A\u0456\u0432\u0449\u0438\u043D\u0430
      \u0432\u0435\u043B\u0430 \u0432\u0456\u0439\u043D\u0443 \u0437 \u0432\u0430\u0448\u043E\u044E,
      \u043D\u0430\u0448\u043E\u043C\u0443 \u043D\u0430\u0440\u043E\u0434\u0443 \u043D\u0435
      \u0440\u0430\u0437 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044F
      \u0431\u043E\u0440\u043E\u0442\u0438\u0441\u044F \u0437 \u0432\u043E\u0440\u043E\u0433\u0430\u043C\u0438,
      \u044F\u043A\u0456 \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u043B\u0438\u0441\u044F
      \u043D\u0430 \u0441\u0432\u043E\u0457 \u0446\u0438\u0442\u0430\u0434\u0435\u043B\u0456.
      \u041C\u0438 \u0437\u043D\u0430\u0454\u043C\u043E \u0441\u043F\u043E\u0441\u0456\u0431,
      \u044F\u043A \u043C\u043E\u0436\u043D\u0430 \u043F\u0435\u0440\u0435\u043C\u0430\u0433\u0430\u0442\u0438
      \u0457\u0445. \u041D\u0430\u0448\u0456 \u0448\u0430\u043C\u0430\u043D\u0438
      \u0432\u0438\u043D\u0430\u0439\u0448\u043B\u0438 \u0437\u0456\u043B\u043B\u044F,
      \u0437\u0434\u0430\u0442\u043D\u0435 \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u0442\u0435\u0440\u043C\u0456\u043D \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0442\u043E\u0433\u043E, \u0445\u0442\u043E \u0432\u0438\u043F\u0438\u0432,
      \u043D\u0430 \u0456\u043D\u0448\u0443 \u0456\u0441\u0442\u043E\u0442\u0443.
      \u0419\u043E\u0433\u043E \u0434\u0443\u0448\u0430 \u0456 \u0440\u043E\u0437\u0443\u043C
      \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u044C\u0441\u044F \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u043C\u0438,
      \u0430\u043B\u0435 \u0442\u0456\u043B\u043E \u0437\u043C\u0456\u043D\u0438\u0442\u044C\u0441\u044F.
      \u041D\u0430\u0448\u0456 \u043E\u0431\u0440\u0430\u043D\u0456 \u0432\u043E\u0457\u043D\u0438
      \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u043B\u0438\u0441\u044F
      \u043D\u0430 \u043C\u0438\u0448\u0435\u0439, \u043F\u0442\u0430\u0445\u0456\u0432
      \u0430\u0431\u043E \u043A\u043E\u043C\u0430\u0445, \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u043B\u0438
      \u0443 \u0444\u043E\u0440\u0442\u0435\u0446\u044E, \u0430 \u043F\u043E\u0442\u0456\u043C,
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438 \u0441\u0432\u0456\u0439
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434,
      \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u043B\u0438 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438. \u041D\u0430\u0448
      \u0430\u043B\u0445\u0456\u043C\u0456\u043A, \u0417\u0430\u043C\u0431\u0435\u0437\u0456,
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u043E\u0434\u043D\u0443 \u043F\u043E\u0440\u0446\u0456\u044E
      \u0446\u044C\u043E\u0433\u043E \u0437\u0456\u043B\u043B\u044F \u0441\u0430\u043C\u0435
      \u0434\u043B\u044F \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u0445 \u0432\u0438\u043F\u0430\u0434\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824493
    m_Localized: "\u041D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u043C\u0438
      \u043C\u043E\u0436\u0435\u043C\u043E \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0432\u0456\u0434\u0432\u0430\u0440\u0438 \u0432\u0441\u044F\u043A\u0438\u0445
      \u0448\u0430\u043C\u0430\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824494
    m_Localized: "\u041C\u0438 \u0432\u0430\u0441 \u043F\u043E\u0447\u0443\u043B\u0438,
      \u043F\u0438\u0441\u0430\u0440. \u0412\u043E\u0436\u0434\u044C \u0410\u0441\u043A\u0430\u0440\u0456,
      \u0447\u0438 \u0454 \u044F\u043A\u0456\u0441\u044C \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0449\u0456 \u0443
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u0456 \u0446\u044C\u043E\u0433\u043E
      \u0437\u0456\u043B\u043B\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824495
    m_Localized: "\u0422\u0430\u043A, \u0454. \u041F\u0435\u0440\u0448\u0435 - \u0447\u0430\u0441
      \u0439\u043E\u0433\u043E \u0434\u0456\u0457. \u0417\u0456\u043B\u043B\u044F,
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0430\u043D\u0435 \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u043C\u0438
      \u0448\u0430\u043C\u0430\u043D\u0430\u043C\u0438 \u0434\u0430\u0432\u043D\u0438\u043D\u0438,
      \u043C\u043E\u0433\u043B\u043E \u043F\u0440\u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0432\u043E\u0457\u043D\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u0434\u043D\u0456\u0432
      \u0432 \u0456\u043D\u0448\u0456\u0439 \u0444\u043E\u0440\u043C\u0456, \u0430\u043B\u0435
      \u043C\u0438 \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0449\u043E\u0441\u044C \u0431\u0456\u043B\u044C\u0448\u0435,
      \u043D\u0456\u0436 \u043A\u0456\u043B\u044C\u043A\u0430 \u0445\u0432\u0438\u043B\u0438\u043D.
      \u0414\u0440\u0443\u0433\u0435 - \u0432\u043E\u0457\u043D \u0432 \u043E\u0431\u0440\u0430\u0437\u0456
      \u0434\u0440\u0456\u0431\u043D\u043E\u0457 \u0442\u0432\u0430\u0440\u0438\u043D\u0438
      \u0445\u043E\u0447\u0430 \u0456 \u0431\u0443\u0434\u0435 \u043C\u0435\u043D\u0448
      \u043F\u043E\u043C\u0456\u0442\u043D\u0438\u0439, \u0431\u0443\u0434\u0435
      \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u0434\u0443\u0436\u0435 \u0441\u043B\u0430\u0431\u043A\u0438\u0439
      \u0456 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0438\u0439. \u0410\u043B\u0435
      \u0437\u0430\u0442\u0435 \u0432\u0456\u043D \u0437\u043C\u043E\u0436\u0435
      \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438 \u0443 \u0444\u043E\u0440\u0442\u0435\u0446\u044E
      \u0447\u0435\u0440\u0435\u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0449\u0456\u043B\u0438\u043D\u0443, \u0442\u0440\u0443\u0431\u0443 \u0456
      \u043D\u0430\u0432\u0456\u0442\u044C \u0449\u0443\u0440\u044F\u0447\u0443 \u043D\u043E\u0440\u0443,
      \u044F\u043A\u0456 \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u0454
      \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824496
    m_Localized: "\u0425\u043C\u043C... \u0445\u043E\u0447\u0430 \u043C\u0435\u043D\u0456
      \u0439 \u043D\u0435 \u0434\u0443\u0436\u0435 \u0434\u043E \u0434\u0443\u0448\u0456
      \u0446\u0435\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442, \u043C\u0443\u0448\u0443
      \u0432\u0438\u0437\u043D\u0430\u0442\u0438, \u0449\u043E \u0432 \u043D\u0430\u0441
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u043C\u0430\u0454 \u0456\u043D\u0448\u043E\u0433\u043E
      \u0432\u0438\u0431\u043E\u0440\u0443. \u0417\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438, \u0445\u0442\u043E \u0436
      \u0441\u0442\u0430\u043D\u0435 \u043D\u0430\u0448\u0438\u043C \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824497
    m_Localized: "\u042F \u043C\u043E\u0436\u0443 \u043D\u0438\u043C \u0441\u0442\u0430\u0442\u0438.
      \u042F\u043A\u0449\u043E \u0446\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u043D\u0430\u043C \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438,
      \u0442\u043E \u044F \u0437\u0433\u043E\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824498
    m_Localized: "\u0425\u043E\u0440\u043E\u0431\u0440\u0456 \u0441\u043B\u043E\u0432\u0430,
      @lp. \u0417 \u043E\u0433\u043B\u044F\u0434\u0443 \u043D\u0430 \u043F\u0440\u043E\u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432\u0430\u043D\u0456
      \u0442\u043E\u0431\u043E\u044E \u0431\u043E\u0439\u043E\u0432\u0456 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456,
      \u044F \u0432\u0432\u0430\u0436\u0430\u044E, \u0442\u043E\u0431\u0456 \u043C\u043E\u0436\u043D\u0430
      \u0434\u043E\u0432\u0456\u0440\u0438\u0442\u0438 \u0446\u044E \u043C\u0456\u0441\u0456\u044E.
      \u041E\u0434\u043D\u0430\u043A \u044F\u043A\u0449\u043E \u0442\u0438 \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u0454\u0448,
      \u044F \u043D\u0435 \u0441\u043A\u0430\u0436\u0443 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043F\u0440\u043E\u0442\u0438. \u0414\u043B\u044F \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0442\u0443\u0442 \u0442\u0438 - \u0434\u043E\u0431\u0440\u0438\u0439 \u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0439
      \u0430\u0431\u043E \u043D\u0430\u0432\u0456\u0442\u044C \u0434\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824499
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438 \u044F
      \u043F\u0456\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824500
    m_Localized: "\u042F \u043C\u043E\u0436\u0443 \u0442\u0435\u0431\u0435 \u0432\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u0438
      \u0437\u0432\u0456\u0434\u0442\u0438 \u043F\u043E\u0442\u0456\u043C, \u043A\u043E\u043B\u0438
      \u0441\u043F\u0440\u0430\u0432\u0443 \u0431\u0443\u0434\u0435 \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E.
      \u0420\u0430\u0437 \u0443\u0436\u0435 \u0432\u0441\u0456 \u0433\u0430\u0440\u043C\u0430\u0442\u0438
      \u0443 \u043D\u0438\u0445 \u043D\u0430 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0446\u0456,
      \u0437\u043D\u0430\u0447\u0438\u0442\u044C, \u0456 \u0437\u0435\u043D\u0456\u0442\u043A\u0438
      \u0442\u0435\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824501
    m_Localized: "\u041E\u0442\u0436\u0435, \u043D\u0456 \u0432 \u043A\u043E\u0433\u043E
      \u0437 \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0445 \u043D\u0435\u043C\u0430\u0454
      \u0437\u0430\u043F\u0435\u0440\u0435\u0447\u0435\u043D\u044C \u043F\u0440\u043E\u0442\u0438
      \u0446\u044C\u043E\u0433\u043E \u043F\u043B\u0430\u043D\u0443? \u041D\u0456?
      \u041E\u0434\u043D\u043E\u0433\u043E\u043B\u043E\u0441\u043D\u043E? \u0422\u043E\u0434\u0456
      \u0432\u0438\u0440\u0456\u0448\u0435\u043D\u043E. \u0429\u043E\u0439\u043D\u043E
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u0456 \u0437 \u043B\u0430\u0434\u0443,
      \u043C\u0438 \u0446\u0435 \u043F\u043E\u0431\u0430\u0447\u0438\u043C\u043E.
      \u041D\u0430\u0448\u0456 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0456 \u0437\u0430\u0433\u043E\u043D\u0438
      \u043C\u0430\u044E\u0442\u044C \u0431\u0443\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0456
      \u0432\u0434\u0430\u0440\u0438\u0442\u0438 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436, \u043D\u0435 \u0434\u0430\u044E\u0447\u0438 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432\u0456
      \u0447\u0430\u0441\u0443 \u043D\u0430 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u0457.
      \u0417 \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u0438\u043C\u0438 \u0433\u0430\u0440\u043C\u0430\u0442\u0430\u043C\u0438
      \u0456 \u043D\u0435\u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0438\u043C\u0438
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u0446\u0435 \u0431\u0443\u0434\u0435
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u043B\u0435\u0433\u043A\u043E. \u0417\u0430 \u0441\u043F\u0440\u0430\u0432\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824502
    m_Localized: "\u0423\u0432\u0430\u0433\u0430! \u041F\u0456\u0441\u043B\u044F
      \u0442\u043E\u0433\u043E, \u044F\u043A \u0432\u0438 \u0432\u0432\u0456\u0439\u0434\u0435\u0442\u0435
      \u0443 \u0444\u043E\u0440\u0442 \u0420\u043E\u043A\u0441, \u0443 \u0432\u0430\u0441
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435
      \u0447\u0430\u0441\u0443 \u0437\u0430\u0439\u043C\u0430\u0442\u0438\u0441\u044F
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u043C\u0438 \u0456\u043D\u0448\u0438\u043C\u0438
      \u0441\u043F\u0440\u0430\u0432\u0430\u043C\u0438, \u043A\u0440\u0456\u043C
      \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0457 \u043C\u0456\u0441\u0456\u0457,
      \u0434\u043E \u0441\u0430\u043C\u043E\u0457 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0438
      \u0443 \u0432\u0456\u0439\u043D\u0456. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0433\u0440\u0443 \u0432
      \u043E\u043A\u0440\u0435\u043C\u0438\u0439 \u0441\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824503
    m_Localized: "\u041E\u0441\u044C \u0432\u043E\u043D\u0430, \u043F\u0430\u043D\u0435\u043B\u044C
      \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430\u043C\u0438.
      \u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u043A\u043D\u043E\u043F\u043E\u043A...
      \u0425\u043C, \u0430 \u0449\u043E, \u044F\u043A \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0446\u044E, \u0432\u0435\u043B\u0438\u043A\u0443 \u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u0443?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824504
    m_Localized: "\u0425\u0430, \u0441\u0445\u043E\u0436\u0435, \u0446\u0435 \u0432\u043E\u043D\u0430!
      \u0417\u0430\u0432\u0436\u0434\u0438 \u043F\u0440\u0430\u0446\u044E\u0454!
      \u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F, \u044F\u043A
      \u0432\u0438 \u043F\u043E\u043F\u0440\u0430\u0446\u044E\u0454\u0442\u0435 \u0431\u0435\u0437
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824505
    m_Localized: "\u041C\u0430\u0431\u0443\u0442\u044C, \u0447\u0430\u0441 \u0456\u0442\u0438
      \u0437\u0432\u0456\u0434\u0441\u0438. \u041A\u0440\u0430\u0449\u0435 \u043D\u0435
      \u0433\u0430\u044F\u0442\u0438 \u0447\u0430\u0441\u0443, \u0430 \u0442\u043E
      \u0449\u0435 \u0457\u0445\u043D\u0454 \u043F\u0456\u0434\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u043D\u044F
      \u043F\u0440\u0438\u0441\u043F\u0456\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824506
    m_Localized: "\u0410, \u043E\u0441\u044C \u0442\u0438 \u0434\u0435, @lp! \u042F
      \u0442\u0435\u0431\u0435 \u044F\u043A\u0440\u0430\u0437 \u0448\u0443\u043A\u0430\u0432.
      \u0414\u0430\u0432\u0430\u0439-\u043D\u043E, \u0445\u043E\u0434\u0443 \u0437\u0432\u0456\u0434\u0441\u0438,
      \u0430 \u0442\u043E \u0449\u0430 \u0442\u0443\u0442 \u043F\u043E\u0447\u043D\u0435\u0442\u044C\u0441\u044F
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044F \u0441\u043F\u0435\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824507
    m_Localized: "\u042F \u0447\u0443\u043B\u0430, \u0449\u043E \u0433\u0430\u0440\u043C\u0430\u0442\u0438
      \u043D\u0456\u0431\u0438 \u044F\u043A \u0437\u0430\u043C\u043E\u0432\u043A\u043B\u0438.
      \u0423\u0441\u0435 \u0432\u0438\u0439\u0448\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824508
    m_Localized: "\u042F\u043A \u0442\u0456\u043B\u044C\u043A\u0438 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u0449\u043E \u0442\u0432\u043E\u044F
      \u0434\u0438\u0432\u0435\u0440\u0441\u0456\u044F \u0432\u0434\u0430\u043B\u0430\u0441\u044F,
      \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u0432\u0456\u0434\u0434\u0430\u0432
      \u043D\u0430\u043A\u0430\u0437 \u043F\u0440\u043E \u0430\u0442\u0430\u043A\u0443.
      \u041F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437 \u0439\u043E\u0433\u043E
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u0432\u0436\u0435 \u0448\u0442\u0443\u0440\u043C\u0443\u044E\u0442\u044C
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0444\u043E\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824509
    m_Localized: "\u042F \u043C\u043E\u0436\u0443 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0457\u043C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824510
    m_Localized: "\u0422\u0438 \u0439 \u0442\u0430\u043A \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436 \u0431\u0443\u0434\u044C-\u0445\u0442\u043E
      \u0437 \u043D\u0430\u0441. \u0417\u0430\u043B\u0456\u0437\u043D\u043E\u043B\u043E\u0431\u0456
      \u0441\u0430\u043C\u0456 \u0432\u043F\u043E\u0440\u0430\u044E\u0442\u044C\u0441\u044F,
      \u0446\u0435 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u0457\u0445\u043D\u044F
      \u0440\u043E\u0431\u043E\u0442\u0430. \u041F\u0440\u043E\u043F\u043E\u043D\u0443\u044E
      \u043A\u0440\u0430\u0449\u0435 \u0432\u0430\u043B\u0438\u0442\u0438, \u043F\u043E\u043A\u0438
      \u043C\u043E\u0436\u043D\u0430, \u044F\u043A\u0449\u043E \u0432 \u0442\u0435\u0431\u0435,
      \u0437\u0432\u0456\u0441\u043D\u043E, \u043D\u0435\u043C\u0430\u0454 \u044F\u043A\u0438\u0445\u043E\u0441\u044C
      \u0456\u043D\u0448\u0438\u0445 \u043F\u043B\u0430\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824511
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824512
    m_Localized: "\u0406... \u042F\u043A \u0443\u0441\u0435 \u043F\u0440\u043E\u0439\u0448\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824513
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u043E\u0433\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824514
    m_Localized: "\u0423\u0441\u0435 \u043F\u0440\u043E\u0439\u0448\u043B\u043E \u0437\u0430
      \u043F\u043B\u0430\u043D\u043E\u043C. \u041C\u0438 \u0437\u0434\u0456\u0439\u0441\u043D\u0438\u043B\u0438
      \u043C\u0430\u0440\u0448-\u043A\u0438\u0434\u043E\u043A \u0434\u043E \u0444\u043E\u0440\u0442\u0435\u0446\u0456
      \u0442\u0456\u0454\u0457 \u0441\u0430\u043C\u043E\u0457 \u0445\u0432\u0438\u043B\u0438\u043D\u0438,
      \u043A\u043E\u043B\u0438 \u0431\u0443\u043B\u043E \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043E
      \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F \u0433\u0430\u0440\u043C\u0430\u0442,
      \u0456 \u0437\u043C\u043E\u0433\u043B\u0438 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u0432\u043E\u0440\u0456\u0442, \u043F\u0435\u0440\u0448 \u043D\u0456\u0436
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u0437\u0430\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u0432
      \u0457\u0445 \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u043E. \u041F\u0456\u0441\u043B\u044F
      \u043D\u0430\u0448\u043E\u0433\u043E \u0443\u0441\u043F\u0456\u0448\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443
      \u0446\u0438\u0442\u0430\u0434\u0435\u043B\u0456 \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0441\u043A\u043B\u0430\u043B\u0430
      \u0437\u0431\u0440\u043E\u044E, \u0456 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0435\u0431\u0440\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0437\u0440\u043E\u0431\u0438\u043B\u0438
      \u0441\u043F\u0440\u043E\u0431\u0443 \u043F\u0440\u043E\u0440\u0438\u0432\u0443.
      \u041E\u0434\u043D\u0430\u043A \u0437 \u0454\u0434\u0438\u043D\u0438\u043C
      \u0432\u0438\u0445\u043E\u0434\u043E\u043C \u043F\u0456\u0434 \u043D\u0430\u0448\u0438\u043C
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u0446\u0435 \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824515
    m_Localized: "\u0419\u0456\u0456-\u0445\u0430! \u041E\u0441\u044C \u0442\u0430\u043A
      \u0446\u0435 \u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u041F\u0443\u0441\u0442\u0438\u0449\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824516
    m_Localized: "\u0426\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E
      \u0442\u0435\u043F\u0435\u0440 \u0432\u043E\u0440\u043E\u0433\u0438 \u043A\u0430\u043F\u0456\u0442\u0443\u043B\u044E\u044E\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824517
    m_Localized: "\u041F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438. \u041E\u0434\u043D\u0430\u043A
      \u0444\u0430\u043A\u0442 \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0442\u0456 \u0441\u0438\u043B\u0438, \u0449\u043E
      \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F \u0432\u0456\u0440\u043D\u0438\u043C\u0438
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0443, \u0442\u0430 \u0457\u0445\u043D\u0456
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0438 \u0432\u0438\u0440\u0456\u0448\u0430\u0442\u044C
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0443,
      \u0443 \u043D\u0438\u0445 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435\u043C\u0430\u0454
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456 \u0445\u043E\u0447
      \u044F\u043A\u043E\u0441\u044C \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E
      \u043D\u0430\u043C \u043D\u0430\u0448\u043A\u043E\u0434\u0438\u0442\u0438.
      \u0407\u0445\u043D\u0456 \u0440\u043E\u0437\u0440\u0456\u0437\u043D\u0435\u043D\u0456
      \u0456 \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u043E \u043D\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u0456
      \u043F\u0456\u0434\u0440\u043E\u0437\u0434\u0456\u043B\u0438 \u0442\u0435\u043F\u0435\u0440
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u043C\u0430\u044E\u0442\u044C
      \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F.
      \u041C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043D\u0435 \u0431\u043E\u044F\u0442\u0438\u0441\u044F
      \u0443\u0434\u0430\u0440\u0443 \u0432 \u0441\u043F\u0438\u043D\u0443 \u0432
      \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0456\u0439 \u0432\u0456\u0439\u043D\u0456
      \u0437 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824518
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0446\u0435 \u0442\u0440\u0435\u0431\u0430
      \u0432\u0456\u0434\u0441\u0432\u044F\u0442\u043A\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824519
    m_Localized: "\u0411\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E. \u041C\u043E\u0457\u043C
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824520
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043C\u043E\u0457
      \u0441\u043E\u0440\u0430\u0442\u043D\u0438\u043A\u0438 \u043F\u043E\u0433\u043E\u0434\u044F\u0442\u044C\u0441\u044F
      \u0441\u043A\u043B\u0430\u0441\u0442\u0438 \u0432\u0430\u043C \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824521
    m_Localized: "\u041D\u0435\u0445\u0430\u0439 \u0443 \u043D\u0430\u0441 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443
      \u0432\u0430\u0436\u043A\u0456 \u0447\u0430\u0441\u0438, \u0430\u043B\u0435
      \u0447\u0430\u0441\u0442\u043A\u0430 \u043F\u0440\u0430\u0432\u0434\u0438 \u0443
      \u0432\u0430\u0448\u0438\u0445 \u0441\u043B\u043E\u0432\u0430\u0445 \u0454.
      \u0421\u0438\u043B\u0438 \u043D\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824522
    m_Localized: "\u0422\u043E\u0436 \u043C\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824523
    m_Localized: "\u0412\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824524
    m_Localized: "\u041F\u043E\u0433\u0430\u043D\u0456 \u043D\u043E\u0432\u0438\u043D\u0438,
      \u0434\u0440\u0443\u0437\u0456. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435, @lp. \u0410\u043D\u043A\u043B\u0430\u0432
      \u043F\u043E\u0447\u0430\u0432 \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F.
      \u0406... \u0431\u043E\u044E\u0441\u044F, \u0449\u043E \u0439\u043E\u0433\u043E
      \u043E\u0441\u043D\u043E\u0432\u043D\u0430 \u0446\u0456\u043B\u044C - \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824525
    m_Localized: "\u0429\u043E? \u042F\u043A... \u0427\u043E\u043C\u0443? \u0417\u0432\u0456\u0434\u043A\u0438
      \u0432\u043E\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824526
    m_Localized: "\u041C\u043E\u0436\u0443 \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0434\u043E\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
      \u041C\u043E\u0457 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0438
      \u0437\u0430\u0444\u0456\u043A\u0441\u0443\u0432\u0430\u043B\u0438 \u0441\u043F\u0443\u0441\u043A
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u043E\u0457 \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456
      \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432 \u0456 \u0442\u0435\u0445\u043D\u0456\u043A\u0438
      \u043F\u0435\u0433\u0430\u0441\u0456\u0432 \u0443 \u043A\u0456\u043B\u044C\u043A\u043E\u0445
      \u0440\u0430\u0439\u043E\u043D\u0430\u0445. \u041E\u0434\u043D\u0435 \u0437
      \u043D\u0438\u0445 - \u043C\u0456\u0441\u0446\u0435, \u0434\u0435 \u0437\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0439
      \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0439 \u0432\u0445\u0456\u0434 \u0434\u043E
      \u0442\u0432\u043E\u0433\u043E \u0434\u043E\u043C\u0443. \u0421\u0445\u043E\u0436\u0435,
      \u0432\u043E\u043D\u0438 \u0437\u043D\u0430\u044E\u0442\u044C, \u043A\u0443\u0434\u0438
      \u0439\u0442\u0438 \u0456 \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u0438.
      \u0412\u043E\u043D\u0438 \u0433\u043E\u0442\u0443\u044E\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E\u0440\u0432\u0430\u0442\u0438\u0441\u044F \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824527
    m_Localized: "\u041C\u0438 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0441\u0442\u0430\u0442\u0438\u0441\u044F. \u0412\u0438\u0441\u0442\u0443\u043F\u0430\u0454\u043C\u043E
      \u043D\u0435\u0433\u0430\u0439\u043D\u043E, \u0432\u0441\u0456 \u0440\u0430\u0437\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824528
    m_Localized: "\u042F \u043C\u043E\u0436\u0443 \u0432\u0438\u0440\u0443\u0448\u0438\u0442\u0438
      \u0432 \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B. \u042F \u043F\u043E\u0432\u0438\u043D\u043D\u0430
      \u0431\u0443\u0442\u0438 \u0442\u0430\u043C \u0432\u0436\u0435 \u0437\u0430\u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824529
    m_Localized: "\u0422\u043E\u0434\u0456 \u044F \u043F\u043E\u043A\u0430\u0436\u0443
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0456\u043D\u0448\u0438\u043C. \u0423\u0434\u0430\u0447\u0456,
      @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824530
    m_Localized: "@lp? \u0421\u043B\u0430\u0432\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457,
      \u0446\u0435 \u0442\u0438! \u041F\u043E\u0447\u0435\u043A\u0430\u0439, \u044F
      \u0437\u0430\u0440\u0430\u0437 \u0432\u0438\u043C\u043A\u043D\u0443 \u043F\u043E\u043B\u0435
      \u0456 \u0432\u043F\u0443\u0449\u0443 \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824531
    m_Localized: "\u041D\u0430\u043F\u0430\u0434 \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824532
    m_Localized: "\u0420\u043E\u0437\u043A\u0430\u0436\u0456\u0442\u044C, \u0442\u0456\u043B\u044C\u043A\u0438
      \u0448\u0432\u0438\u0434\u043A\u043E, \u0449\u043E \u0442\u0443\u0442 \u0441\u0442\u0430\u043B\u043E\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824533
    m_Localized: "\u0412\u043E\u043D\u0438 \u043D\u0430\u043F\u0430\u043B\u0438 \u043D\u0430
      \u043D\u0430\u0441, \u043F\u0435\u0433\u0430\u0441\u0438 \u0432 \u0434\u0438\u0432\u043D\u0456\u0439
      \u0431\u0440\u043E\u043D\u0456... \u041C\u0438 \u0432\u0441\u0456 \u0437\u0430\u0439\u043C\u0430\u043B\u0438\u0441\u044F
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0441\u043F\u0440\u0430\u0432\u0430\u043C\u0438,
      \u0432\u0441\u0435 \u0431\u0443\u043B\u043E \u044F\u043A \u0437\u0430\u0432\u0436\u0434\u0438.
      \u0420\u0430\u043F\u0442\u043E\u043C \u043C\u0438 \u043F\u043E\u0447\u0443\u043B\u0438
      \u0433\u0443\u0440\u043A\u0456\u0442 \u0456 \u0437\u0435\u043C\u043B\u044F
      \u043F\u0456\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u0437\u0434\u0440\u0438\u0433\u043D\u0443\u043B\u0430\u0441\u044F.
      \u041F\u043E\u0442\u0456\u043C \u0443\u0432\u0456\u043C\u043A\u043D\u0443\u0432\u0441\u044F
      \u0441\u0438\u0433\u043D\u0430\u043B \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u043E\u0457
      \u0442\u0440\u0438\u0432\u043E\u0433\u0438, \u0430\u043B\u0435 \u0442\u0443\u0442
      \u0436\u0435 \u0437\u043C\u043E\u0432\u043A. \u041C\u0438 \u0434\u0443\u043C\u0430\u0454\u043C\u043E,
      \u0449\u043E \u0432\u043E\u043D\u0438 \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u043B\u0438
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044E \u0441\u0442\u0456\u043D\u0443,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u044F\u043A\u0438\u043C\u043E\u0441\u044C
      \u0447\u0438\u043D\u043E\u043C \u0434\u0456\u0441\u0442\u0430\u043B\u0438 \u0434\u043E\u0441\u0442\u0443\u043F
      \u0434\u043E \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0443 \u0434\u0432\u0435\u0440\u0435\u0439
      \u0421\u0442\u0456\u0439\u043B\u0430 \u0456 \u043D\u0430\u0448\u043E\u0457
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438.
      \u041D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u044F\u043A \u0446\u0435
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E... \u0410 \u0447\u0435\u0440\u0435\u0437
      \u043F'\u044F\u0442\u044C \u0445\u0432\u0438\u043B\u0438\u043D \u043F\u043E\u0447\u0430\u0432\u0441\u044F
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u043A\u043E\u0448\u043C\u0430\u0440!
      \u0412\u043E\u043D\u0438 \u0443\u0432\u0456\u0440\u0432\u0430\u043B\u0438\u0441\u044F
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443, \u0432\u0431\u0438\u0432\u0430\u044E\u0447\u0438
      \u0432\u0441\u0456\u0445, \u0445\u0442\u043E \u0442\u0440\u0430\u043F\u043B\u044F\u0432\u0441\u044F
      \u0457\u043C \u043D\u0430 \u0448\u043B\u044F\u0445\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824534
    m_Localized: "\u041D\u0430 \u0449\u0430\u0441\u0442\u044F, \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u0449\u043E \u0446\u0435
      \u043D\u0430\u043F\u0430\u0434 \u0437\u0437\u043E\u0432\u043D\u0456, \u0449\u0435
      \u043F\u0456\u0441\u043B\u044F \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0432\u0438\u0431\u0443\u0445\u0443,
      \u0456 \u0432\u0441\u0442\u0438\u0433 \u0434\u0430\u0442\u0438 \u043E\u0433\u043E\u043B\u043E\u0448\u0435\u043D\u043D\u044F
      \u043F\u043E \u0433\u0443\u0447\u043D\u043E\u043C\u0443 \u0437\u0432'\u044F\u0437\u043A\u0443.
      \u041C\u0438 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0454\u043C\u043E\u0441\u044F,
      \u0449\u043E \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0436\u0438\u0442\u0435\u043B\u0456\u0432
      \u0441\u0442\u0456\u0439\u043B\u0430 \u0441\u0445\u043E\u0432\u0430\u043B\u0438\u0441\u044F
      \u0432 \u0446\u0435\u0445\u0430\u0445 \u0456 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044F\u0445.
      \u0422\u0438 \u0436 \u0437\u043D\u0430\u0454\u0448, \u0432\u043E\u043D\u0438
      \u043C\u0430\u044E\u0442\u044C \u0432\u043B\u0430\u0441\u043D\u0456 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u0456
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0443,
      \u0441\u0438\u043B\u043E\u0432\u0456 \u043F\u043E\u043B\u044F \u0447\u0438
      \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0456 \u0434\u0432\u0435\u0440\u0456.
      \u0423\u0442\u0456\u043C, \u044F\u043A\u0438\u0439 \u0441\u0435\u043D\u0441?
      \u0422\u0443\u0442 \u043D\u0435\u043C\u0430\u0454 \u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432,
      \u043D\u0435\u043C\u0430\u0454 \u0457\u0436\u0456, \u043D\u0435\u043C\u0430\u0454
      \u0436\u043E\u0434\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457. \u0421\u043A\u0456\u043B\u044C\u043A\u0438
      \u0431 \u043C\u0438 \u043D\u0435 \u0432\u0456\u0434\u0441\u0438\u0434\u0436\u0443\u0432\u0430\u043B\u0438\u0441\u044F,
      \u0440\u0430\u043D\u043E \u0447\u0438 \u043F\u0456\u0437\u043D\u043E \u0432\u043E\u043D\u0438
      \u043D\u0430\u0441 \u0434\u0456\u0441\u0442\u0430\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824535
    m_Localized: "\u0422\u0440\u0438\u0447\u0456 \u043F\u0438\u0437\u0434\u043E\u043F\u0440\u043E\u0457\u0431\u0430\u043D\u043D\u0456
      \u0432\u0438\u0431\u043B\u044F\u0434\u043A\u0438! \u041D\u0430 \u0432\u0430\u0441
      \u043D\u0430\u043F\u0430\u0432 \u0410\u043D\u043A\u043B\u0430\u0432, \u0456
      \u0446\u0435\u0439 \u0432\u043E\u0440\u043E\u0433 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435\u0432'\u0454\u0431\u0438\u0447\u043D\u043E \u0441\u0438\u043B\u044C\u043D\u0438\u0439!|
      \u0414\u0438\u0441\u043A\u043E\u0440\u0434\u043E\u0432\u0435 \u043A\u043E\u0434\u043B\u043E!
      \u041D\u0430 \u0432\u0430\u0441 \u043D\u0430\u043F\u0430\u0432 \u0410\u043D\u043A\u043B\u0430\u0432,
      \u0456 \u0446\u0435\u0439 \u0432\u043E\u0440\u043E\u0433 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0441\u0438\u043B\u044C\u043D\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824536
    m_Localized: "\u0414\u0435 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824537
    m_Localized: "\u0412\u0456\u043D \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u0438\u0439,
      @lp... \u0411\u043E\u044E\u0441\u044F, \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E.
      \u041C\u0438 \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u0430\u043B\u0438 \u0441\u044E\u0434\u0438,
      \u0443 \u0446\u0435\u0445 \u043D\u043E\u043C\u0435\u0440 \u043E\u0434\u0438\u043D,
      \u0431\u043E \u0441\u0430\u043C\u0435 \u0442\u0443\u0442 \u0432\u0435\u043B\u0430\u0441\u044F
      \u0440\u043E\u0431\u043E\u0442\u0430 \u043D\u0430\u0434 \u043F\u0440\u043E\u0454\u043A\u0442\u043E\u043C
      \"\u0421\u043E\u043D\u0446\u0435\". \u0406 \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u043B\u0438
      \u043D\u0430 \u0433\u0440\u0443\u043F\u0443 \u0432\u043E\u0440\u043E\u0433\u0456\u0432.
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043E\u0442\u0440\u0438\u043C\u0430\u0432
      \u0437\u0430\u0440\u044F\u0434 \u043F\u043B\u0430\u0437\u043C\u0438 \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0433\u0440\u0443\u0434\u0438, \u0430\u043B\u0435 \u043C\u0435\u043D\u0456
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043C\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u0435\u043D\u043D\u044F,
      \u0456, \u043F\u043E\u043A\u0438 \u0432\u043E\u0440\u043E\u0433 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0432
      \u0434\u043E \u0442\u044F\u043C\u0438, \u0432\u0456\u0434\u0442\u044F\u0433\u043D\u0443\u0442\u0438
      \u0439\u043E\u0433\u043E \u0441\u044E\u0434\u0438, \u043F\u0456\u0434 \u0437\u0430\u0445\u0438\u0441\u0442
      \u043F\u043E\u043B\u044F. \u0410\u043B\u0435, \u0431\u043E\u044E\u0441\u044F,
      \u0439\u043E\u043C\u0443 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u043D\u0435
      \u0432\u0438\u0436\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824538
    m_Localized: "\u0410\u043B\u0435 \u0447\u043E\u043C\u0443 \u0432\u0438 \u043D\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0438 \u0431\u0440\u043E\u043D\u044E
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430? \u0412\u043E\u043D\u0430
      \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824539
    m_Localized: "\u041F\u0440\u043E\u0444\u0435\u0441\u043E\u0440 \u0411\u0440\u0430\u0443\u043D\u0456,
      \u0422\u0440\u0430\u043D\u0437\u0438\u0441\u0442\u043E\u0440 \u0456 \u041B\u0430\u0439\u043C
      \u0424\u0456\u0437\u0437\u0456 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u044E\u0442\u044C
      \u0440\u043E\u0431\u043E\u0442\u0443 \u043D\u0430\u0434 \u043D\u0435\u044E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0440\u0430\u0437. \u0422\u0430\u043C,
      \u0443 \u0441\u0443\u0441\u0456\u0434\u043D\u044C\u043E\u043C\u0443 \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u0456.
      \u041C\u043E\u0436\u0435\u0448 \u0437\u0430\u0439\u0442\u0438 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0446\u0435 \u0449\u0435 \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824540
    m_Localized: "\u0410, @lp... \u0422\u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F...
      \u0421\u0432\u044F\u0442\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F...
      \u041F\u043E\u0434\u0443\u043C\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438,
      \u044F\u043A \u0431\u0435\u0437\u0433\u043B\u0443\u0437\u0434\u043E \u0432\u0441\u0435
      \u0432\u0438\u0439\u0448\u043B\u043E... \u0423\u0441\u0456 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0456\u0442\u0442\u044F
      \u0440\u043E\u0431\u043E\u0442\u0438, \u0443\u0441\u044F \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0456\u0441\u0442\u044C...
      \u0432\u0441\u0435 \u0434\u0430\u0440\u0435\u043C\u043D\u043E. \u0423\u0441\u0456
      \u043D\u0430\u0448\u0456 \u0437\u043D\u0430\u043D\u043D\u044F, \u0443\u0441\u0456
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 \u0434\u0456\u0441\u0442\u0430\u043D\u0443\u0442\u044C\u0441\u044F...
      \u0432\u0431\u0438\u0432\u0446\u044F\u043C-\u043C\u0456\u043B\u0456\u0442\u0430\u0440\u0438\u0441\u0442\u0430\u043C
      \u0437-\u0437\u0430 \u0445\u043C\u0430\u0440... \u0410 \u0432\u0441\u0456\u0445
      \u043D\u0430\u0441 \u0447\u0435\u043A\u0430\u0454 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u043C\u0435\u0440\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824541
    m_Localized: "\u041D\u0443 \u0432\u0436\u0435 \u043D\u0456! \u042F \u043D\u0435
      \u0434\u043E\u043F\u0443\u0449\u0443 \u0442\u0430\u043A\u043E\u0433\u043E!
      \u041D\u0435 \u0432\u0441\u0435 \u0449\u0435 \u0432\u0442\u0440\u0430\u0447\u0435\u043D\u043E,
      \u043C\u043E\u0457 \u0434\u0440\u0443\u0437\u0456 \u0437 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C \u043D\u0430\u043C,
      \u0440\u0430\u0437\u043E\u043C \u043C\u0438 \u0432\u0456\u0434\u0456\u0431'\u0454\u043C\u043E
      \u0446\u044E \u0430\u0442\u0430\u043A\u0443! \u0406 \u044F\u043A \u0436\u0435
      \u0431\u0440\u043E\u043D\u044F \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824542
    m_Localized: "\u041C\u0438 \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0438
      \u0457\u0457 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438, \u043D\u0435
      \u0432\u0441\u0442\u0438\u0433\u043B\u0438 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438,
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438... \u0410\u043B\u0435
      \u0432\u0441\u0435 \u0436... \u0445\u0456\u0431\u0430 \u0432\u0436\u0435 \u043C\u043E\u0436\u0435
      \u0441\u0442\u0430\u0442\u0438 \u0433\u0456\u0440\u0448\u0435? \u0422\u0438
      \u043C\u0430\u0454\u0448 \u0440\u0430\u0446\u0456\u044E... \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439
      \u0457\u0457. \u0423\u0431\u0438\u0439 \u0446\u044E \u043C\u0435\u0440\u0437\u043E\u0442\u0443...
      \u0423 \u0442\u0435\u0431\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0431\u043E\u0439\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u0441\u0432\u0456\u0434\u0443, \u043D\u0456\u0436 \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0436\u0438\u0442\u0435\u043B\u044F \u0441\u0442\u0456\u0439\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824543
    m_Localized: "\u0414\u044F\u043A\u0443\u044E \u0437\u0430 \u0434\u043E\u0432\u0456\u0440\u0443,
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A."
