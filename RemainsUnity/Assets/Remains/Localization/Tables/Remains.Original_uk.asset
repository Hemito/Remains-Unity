    m_Localized: "\u0428\u043A\u043E\u0434\u0443, \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0443
      \u0432\u0456\u0434 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457,
      \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0437\u0446\u0456\u043B\u0438\u0442\u0438
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C\u0438 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u0430\u043C\u0438.
      \u0414\u043B\u044F \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044F \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457
      \u0437 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0439\u0442\u0435
      \u0430\u043D\u0442\u0438\u0440\u0430\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018285
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043B\u0435\u0432\u0456\u0442\u0443\u0432\u0430\u0442\u0438
      \u0432\u0430\u0448\u0443 \u0437\u0431\u0440\u043E\u044E \u0432\u0438\u0449\u0435,
      \u0449\u043E\u0431 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438, \u0441\u0445\u043E\u0432\u0430\u0432\u0448\u0438\u0441\u044C
      \u0437\u0430 \u044F\u043A\u0438\u043C-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0443\u043A\u0440\u0438\u0442\u0442\u044F\u043C. \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E
      \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0456\u0448\u0443
      [W]. \u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E
      [S] \u0456 [W], \u0449\u043E\u0431 \u0440\u043E\u0431\u0438\u0442\u0438 \u0446\u0435
      \u043B\u0435\u0436\u0430\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018286
    m_Localized: "\u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0432\u0430\u0448\u0438\u0445
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u043C\u0430\u044E\u0442\u044C \u0441\u043B\u0443\u0445.
      \u0412\u0438 \u0432\u0438\u0434\u0430\u0454\u0442\u0435 \u0448\u0443\u043C
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0456 \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E \u0431\u0456\u0433\u0443,
      \u043F\u043E\u0447\u0443\u0432\u0448\u0438 \u044F\u043A\u0438\u0439, \u0432\u043E\u043D\u0438,
      \u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u0430 \u0432\u0441\u0435, \u0441\u0442\u0440\u0438\u0432\u043E\u0436\u0430\u0442\u044C\u0441\u044F
      \u0456 \u043F\u043E\u0431\u0456\u0436\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0442\u0438,
      \u0449\u043E \u0436 \u0439\u043E\u0433\u043E \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018287
    m_Localized: "\u0421\u0430\u043C\u043E\u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u044F
      \u043C\u043E\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0432\u0430\u043C \u0434\u043E\u0441\u044F\u0433\u0442\u0438 \u0442\u0438\u0445
      \u043C\u0456\u0441\u0446\u044C, \u043A\u0443\u0434\u0438 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0441\u0442\u0440\u0438\u0431\u043A\u0456\u0432 \u0456 \u0441\u0445\u043E\u0434\u0456\u0432,
      \u0430\u043B\u0435 \u0432\u043E\u043D\u0430 \u0437\u0430\u0431\u0438\u0440\u0430\u0454
      \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457. \u0414\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0441\u0430\u043C\u043E\u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u0457
      \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u0456 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 [\u043F\u0440\u043E\u0431\u0456\u043B]
      \u0443 \u0441\u0442\u0440\u0438\u0431\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018288
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437\u0430 \u044F\u0449\u0438\u043A\u0430\u043C\u0438, \u043C\u0435\u0431\u043B\u044F\u043C\u0438
      \u0456 \u0432 \u0441\u0442\u0456\u043D\u043D\u0438\u0445 \u043D\u0456\u0448\u0430\u0445.
      \u0426\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0432\u0430\u043C
      \u0441\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F \u0432\u0456\u0434 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
      \u0456 \u0434\u0430\u0441\u0442\u044C \u0434\u0435\u044F\u043A\u0435 \u0443\u043A\u0440\u0438\u0442\u0442\u044F
      \u0432\u0456\u0434 \u043A\u0443\u043B\u044C. \u0429\u043E\u0431 \u0437\u0430\u0439\u043D\u044F\u0442\u0438
      \u0443\u043A\u0440\u0438\u0442\u0442\u044F, \u043F\u0456\u0434\u0456\u0439\u0434\u0456\u0442\u044C
      \u0434\u043E \u043D\u044C\u043E\u0433\u043E \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      [W]."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018289
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0441\u043A\u0440\u043E\u043B \u043C\u0438\u0448\u0456 \u0434\u043B\u044F
      \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u043D\u043D\u044F \u0437\u0431\u0440\u043E\u0457.
      \u041F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456.
      \u0417\u0431\u0440\u043E\u044E \u0437\u043B\u0430\u043C\u0430\u043D\u0443,
      \u0431\u0435\u0437 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432
      \u0430\u0431\u043E \u0437 \u043D\u0430\u0434\u0442\u043E \u0432\u0438\u0441\u043E\u043A\u0438\u043C\u0438
      \u0432\u0438\u043C\u043E\u0433\u0430\u043C\u0438 \u043D\u0435 \u0431\u0443\u0434\u0435
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018290
    m_Localized: "\u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u0442\u0440\u0430\u0432\u043C\u0438,
      \u044F\u043A\u0449\u043E \u0437\u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0456\u0454\u0442\u0435
      \u0456 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0442\u0435\u0441\u044F \u043D\u0430
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443 \u0442\u043E\u0447\u043A\u0443,
      \u0430 \u0446\u0435 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u044C
      \u0432\u0438\u0442\u0440\u0430\u0442\u0438 \u043D\u0430 \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F.
      \u041A\u0440\u0430\u0449\u0435 \u0441\u0442\u0435\u0436\u0442\u0435 \u0437\u0430
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F\u043C \u0456 \u0432\u0447\u0430\u0441\u043D\u043E
      \u043F\u0440\u0438\u0439\u043C\u0430\u0439\u0442\u0435 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456
      \u0437\u0456\u043B\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018291
    m_Localized: "\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437 \u043C\u043E\u0436\u0435
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0432\u0430\u043C \u0443
      \u0431\u043E\u044E. \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u043C\u043E\u0436\u043D\u0430 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u0438
      \u043D\u0430 \u0432\u043E\u0440\u043E\u0433\u0430 \u044F\u043A\u0438\u0439-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0432\u0430\u0436\u043A\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.
      \u0410 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0442\u0430\u043A\u043E\u0436
      \u0436\u0431\u0443\u0440\u043B\u044F\u0442\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
      \u0432 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432,
      \u0442\u0430 \u0439 \u0441\u0430\u043C\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u0442\u0430\u043A\u043E\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018292
    m_Localized: "\u0412\u0430\u043C \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0442\u0438\u0441\u044F
      \u0440\u0456\u0437\u043D\u0456 \u0442\u0438\u043F\u0438 \u043D\u0430\u0431\u043E\u0457\u0432,
      \u044F\u043A\u0456 \u0431\u0443\u0434\u0443\u0442\u044C \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456
      \u0432 \u0442\u0456\u0439 \u0447\u0438 \u0456\u043D\u0448\u0456\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457.
      \u0422\u0430\u043A, \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0456
      \u043D\u0430\u0431\u043E\u0457 \u0431\u0443\u0434\u0443\u0442\u044C \u0431\u0456\u043B\u044C\u0448
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456 \u043F\u0440\u043E\u0442\u0438
      \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0445 \u0446\u0456\u043B\u0435\u0439,
      \u0430 \u0435\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u0456 -
      \u043F\u0440\u043E\u0442\u0438 \u0446\u0456\u043B\u0435\u0439 \u0431\u0435\u0437
      \u0431\u0440\u043E\u043D\u0456. \u0417\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438
      \u043D\u0430\u0431\u043E\u0457 \u043C\u043E\u0436\u043D\u0430 \u0437 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E
      \u0430\u0431\u043E \u0441\u043A\u0440\u043E\u043B\u043B\u043E\u043C \u043C\u0438\u0448\u0456
      \u0437\u0430 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u043E\u0457 \u043A\u043B\u0430\u0432\u0456\u0448\u0456
      Shift."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018293
    m_Localized: "\u041D\u0435\u043C\u0456\u0446\u043D\u0456 \u0441\u0442\u0456\u043D\u0438
      \u0442\u0430 \u0434\u0432\u0435\u0440\u0456 \u043C\u043E\u0436\u043D\u0430
      \u043F\u0440\u043E\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043A\u0443\u0432\u0430\u043B\u0434\u0438,
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438 \u0430\u0431\u043E \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u043E\u0457
      \u0433\u0430\u0440\u043C\u0430\u0442\u0438. \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0441\u0442\u0456\u043D\u0438 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0437\u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018294
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0437\u0430\u0445\u0438\u0449\u0430\u0454
      \u0432\u0456\u0434 \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      - \u043A\u0443\u043B\u044C, \u0443\u0434\u0430\u0440\u0456\u0432, \u043F\u043E\u0440\u0456\u0437\u0456\u0432
      \u0456 \u043E\u0441\u043A\u043E\u043B\u043A\u0456\u0432. \u041A\u0443\u043B\u0456
      \u0434\u0440\u0456\u0431\u043D\u043E\u0433\u043E \u043A\u0430\u043B\u0456\u0431\u0440\u0443
      \u0456 \u0441\u043B\u0430\u0431\u043A\u0456 \u0443\u0434\u0430\u0440\u0438
      \u043D\u0435 \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u043C
      \u0432\u043E\u0440\u043E\u0433\u0430\u043C \u0436\u043E\u0434\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018295
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u0432\u043E\u0433\u043D\u044E, \u043B\u0430\u0437\u0435\u0440\u0456\u0432
      \u0456 \u043F\u043B\u0430\u0437\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018296
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438
      \u0437\u0430\u043C\u043A\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0438. \u0410\u043B\u0435 \u043A\u0440\u0430\u0449\u0435
      \u0437\u0430\u0432\u0436\u0434\u0438 \u043C\u0430\u0442\u0438 \u0437\u0430\u043F\u0430\u0441
      \u0448\u043F\u0438\u043B\u044C\u043E\u043A - \u0434\u0456\u044E\u0447\u0438
      \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u043E\u044E \u0456 \u0448\u043F\u0438\u043B\u044C\u043A\u043E\u044E,
      \u0432\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0437\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438
      \u0437\u0430\u043C\u043E\u043A \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0430\u043A\u0443\u0440\u0430\u0442\u043D\u0456\u0448\u0435, \u0449\u043E
      \u0434\u0430\u0441\u0442\u044C \u0432\u0430\u043C \u0431\u0456\u043B\u044C\u0448\u0435
      \u0441\u043F\u0440\u043E\u0431 \u0434\u043E \u0442\u043E\u0433\u043E, \u044F\u043A
      \u0432\u0456\u043D \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018297
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0434\u043E \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u0442\u0430\u0431\u043E\u0440\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B
      \u041C\u0422\u041D, \u0449\u043E \u0441\u0432\u0456\u0442\u0438\u0442\u044C\u0441\u044F,
      \u0430\u0431\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0447\u0438
      \u0440\u0443\u043D\u0443 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018298
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432
      \u0434\u0443\u0436\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E \u0432\u0431\u0438\u0442\u0438
      \u043A\u0443\u043B\u044F\u043C\u0438, \u0430\u043B\u0435 \u0432\u043E\u043D\u0438
      \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456 \u0434\u043B\u044F \u0432\u043E\u0433\u043D\u044E
      \u0442\u0430 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018299
    m_Localized: "\u0420\u043E\u043B\u0435\u0440\u0438 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456
      \u0434\u043B\u044F \u0432\u0438\u0431\u0443\u0445\u0456\u0432 \u0456 \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0430 \u0442\u0430\u043A\u043E\u0436 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0447\u043D\u043E
      \u043D\u0435 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u044F\u0442\u044C \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018300
    m_Localized: "\u0417\u0431\u0440\u043E\u044E, \u044F\u043A\u043E\u044E \u0432\u0438
      \u043D\u0435 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0454\u0442\u0435\u0441\u044F,
      \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u0442\u0438
      \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0456 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043F\u0440\u0430\u0432\u043E\u0457
      \u043A\u043D\u043E\u043F\u043A\u0438 \u043C\u0438\u0448\u0456. \u041F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F \u043D\u0435 \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F
      \u0432 \u0441\u043F\u0438\u0441\u043A\u0443 \u0456 \u0441\u0435\u043B\u0435\u043A\u0442\u043E\u0440\u0456
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018301
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0442\u043E\u0447\u043D\u0430, \u0430\u043B\u0435 \u043C\u0430\u043B\u043E\u043F\u043E\u0442\u0443\u0436\u043D\u0430.
      \u041F\u043B\u0430\u0437\u043C\u043E\u0432\u0430 \u0436, \u043D\u0430\u0432\u043F\u0430\u043A\u0438,
      \u0437\u0430\u0432\u0434\u0430\u0454 \u0432\u0435\u043B\u0438\u043A\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438, \u0432\u0456\u0434 \u044F\u043A\u043E\u0457
      \u043C\u0430\u0439\u0436\u0435 \u043D\u0435\u043C\u0430\u0454 \u0437\u0430\u0445\u0438\u0441\u0442\u0443,
      \u0430\u043B\u0435 \u0437 \u043D\u0435\u0457 \u0432\u0430\u0436\u0447\u0435
      \u043F\u043E\u0446\u0456\u043B\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018302
    m_Localized: "\u0410\u0442\u0430\u043A\u0438 \u043A\u043E\u043B\u044E\u0447\u043E-\u0440\u0456\u0436\u0443\u0447\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0442\u0438
      \u0435\u0444\u0435\u043A\u0442 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0456,
      \u0430\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 \u0442\u0438\u0445
      \u0456\u0441\u0442\u043E\u0442, \u0443 \u044F\u043A\u0438\u0445 \u0454 \u043A\u0440\u043E\u0432.
      \u0414\u043B\u044F \u0437\u0443\u043F\u0438\u043D\u043A\u0438 \u043A\u0440\u043E\u0432\u0456
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0456 \u0431\u0438\u043D\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018303
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0435\u0441\u0442\u0438
      \u0437 \u0441\u043E\u0431\u043E\u044E \u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0443
      \u043A\u043E\u0436\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0443 \u0437\u0431\u0440\u043E\u0457.
      \u042F\u043A\u0449\u043E \u0432\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u0435
      \u0437\u0431\u0440\u043E\u044E, \u044F\u043A\u0443 \u0432\u0438 \u0432\u0436\u0435
      \u043C\u0430\u0454\u0442\u0435, \u0432\u043E\u043D\u0430 \u043F\u0456\u0434\u0435
      \u043D\u0430 \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0438 \u0434\u043B\u044F
      \u0440\u0435\u043C\u043E\u043D\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018304
    m_Localized: "\u041A\u043E\u0436\u043D\u0430 \u0437\u0431\u0440\u043E\u044F \u043C\u043E\u0436\u0435
      \u0437\u0434\u0456\u0439\u0441\u043D\u0438\u0442\u0438 \u0434\u0435\u044F\u043A\u0443
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456\u0432
      \u0430\u0431\u043E \u0443\u0434\u0430\u0440\u0456\u0432, \u043F\u0435\u0440\u0448
      \u043D\u0456\u0436 \u0437\u043B\u0430\u043C\u0430\u0454\u0442\u044C\u0441\u044F.
      \u0414\u043B\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0443 \u0432\u0430\u043C
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0437\u043D\u0430\u0439\u0442\u0438
      \u0456\u043D\u0448\u0443 \u0442\u0430\u043A\u0443 \u0441\u0430\u043C\u0443
      \u0437\u0431\u0440\u043E\u044E \u0434\u043B\u044F \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u043D\u043D\u044F
      \u043D\u0430 \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0438,
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438 \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u0438\u0439
      \u043D\u0430\u0431\u0456\u0440 \u0430\u0431\u043E \u0436 \u0432\u0456\u0434\u0440\u0435\u043C\u043E\u043D\u0442\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u043D\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0456
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0456\u0432
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018305
    m_Localized: "\u0423 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u0432\u0438\u0434\u0456\u0432
      \u0437\u0431\u0440\u043E\u0457 \u0454 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0456
      \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438, \u043A\u0440\u0430\u0449\u0456
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456. \u042F\u043A\u0449\u043E
      \u0432\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u0435 \u0430\u0431\u043E
      \u043A\u0443\u043F\u0438\u0442\u0435 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439
      \u0432\u0430\u0440\u0456\u0430\u043D\u0442 \u0437\u0431\u0440\u043E\u0457,
      \u0442\u043E \u0432\u0456\u043D \u0437\u0430\u043C\u0456\u043D\u0438\u0442\u044C
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018306
    m_Localized: "\u0415\u043A\u0456\u043F\u0456\u0440\u043E\u0432\u0430\u043D\u0430
      \u0432\u0430\u0436\u043A\u0430 \u0437\u0431\u0440\u043E\u044F \u0443\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0454
      \u0432\u0430\u0448 \u0431\u0456\u0433. \u041E\u0434\u043D\u0430\u043A, \u0432\u0438\u0432\u0447\u0438\u0432\u0448\u0438
      \u0437\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044C \"\u0420\u043E\u0437\u043C\u0456\u0440
      \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F\", \u043C\u043E\u0436\u043D\u0430
      \u0443\u0441\u0443\u043D\u0443\u0442\u0438 \u0446\u0435\u0439 \u0435\u0444\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018307
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u043A\u0438\u043D\u0443\u0442\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0443
      \u0430\u0431\u043E \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
      \u043C\u0456\u043D\u0443 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043A\u043B\u0430\u0432\u0456\u0448\u0456 [G], \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0432 \u0446\u0435\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u0435
      \u0456\u043D\u0448\u0443 \u0437\u0431\u0440\u043E\u044E. \u0411\u0443\u0434\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E \u043E\u0441\u0442\u0430\u043D\u043D\u044E
      \u0435\u043A\u0456\u043F\u0456\u0440\u043E\u0432\u0430\u043D\u0443 \u0433\u0440\u0430\u043D\u0430\u0442\u0443
      \u0430\u0431\u043E \u043C\u0456\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018308
    m_Localized: "\u0412\u043E\u0440\u043E\u0436\u0456 \u043C\u0456\u043D\u0438 \u0432\u0438\u0434\u043D\u043E
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0437 \u0431\u043B\u0438\u0437\u044C\u043A\u043E\u0457
      \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456. \u041F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0439\u0442\u0435\u0441\u044F
      \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E, \u0456\u043D\u0430\u043A\u0448\u0435
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u0438
      \u043C\u0456\u043D\u0443 \u043D\u0430\u0434\u0442\u043E \u043F\u0456\u0437\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018309
    m_Localized: "\u0423\u0441\u0456 \u0440\u043E\u0431\u043E\u0442\u0438 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456
      \u0434\u043E \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      - \u0432\u043E\u043D\u0430 \u0437\u0430\u0432\u0434\u0430\u0454 \u0457\u043C
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0456 \u043C\u043E\u0436\u0435 \u043D\u0430 \u043F\u0435\u0432\u043D\u0438\u0439
      \u0447\u0430\u0441 \u043F\u0430\u0440\u0430\u043B\u0456\u0437\u0443\u0432\u0430\u0442\u0438.
      \u041D\u0430 \u0436\u0438\u0432\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u0432\u043E\u043D\u0430 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0456\u044F\u043A
      \u043D\u0435 \u0434\u0456\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018310
    m_Localized: "\u0420\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u0438
      \u043C\u0430\u044E\u0442\u044C \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435
      \u043E\u0442\u0440\u0443\u0439\u043D\u0435 \u0436\u0430\u043B\u043E. \u041D\u0435
      \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u0439\u0442\u0435 \u043F\u0456\u0434
      \u0439\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0438, \u0430 \u044F\u043A\u0449\u043E
      \u0432\u0436\u0435 \u0446\u0435 \u0441\u0442\u0430\u043B\u043E\u0441\u044F,
      \u043F\u0440\u0438\u0439\u043C\u0456\u0442\u044C \u0430\u043D\u0442\u0438\u0434\u043E\u0442.
      \u041E\u0442\u0440\u0443\u0442\u0430 \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435\u043A\u043E\u0440\u0438\u0441\u043D\u0430
      \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432'\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018311
    m_Localized: "\u0421\u0438\u043B\u0430 \u043A\u0438\u0434\u043A\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0438
      \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F
      \u043A\u0443\u0440\u0441\u043E\u0440\u0443 \u0449\u043E\u0434\u043E \u0433\u0440\u0430\u0432\u0446\u044F.
      \u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438
      \u044F\u043A \u0441\u0432\u043E\u0457, \u0442\u0430\u043A \u0456 \u0432\u043E\u0440\u043E\u0436\u0456
      \u0433\u0440\u0430\u043D\u0430\u0442\u0438. \u042F\u043A\u0449\u043E \u0432\u0441\u0442\u0438\u0433\u043D\u0435\u0442\u0435,
      \u0437\u0432\u0456\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018312
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443
      \u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043E\u0434\u043D\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
      \u043D\u0430 \u0456\u043D\u0448\u0456, \u0449\u043E\u0431 \u0437\u0430\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0431\u0456\u043B\u044C\u0448\u0443 \u0432\u0438\u0441\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018313
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438
      \u0456 \u0432\u0430\u0448\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432.
      \u0410\u043B\u0435 \u0432\u043E\u043D\u0438 \u0437\u0456 \u0441\u0432\u043E\u0433\u043E
      \u0431\u043E\u043A\u0443 \u043D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0432\u0438\u0440\u0432\u0430\u0442\u0438\u0441\u044F \u0437 \u0432\u0430\u0448\u043E\u0433\u043E
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F. \u0429\u043E
      \u0432\u0438\u0449\u043E\u044E \u0454 \u0432\u0430\u0448\u0430 \u043D\u0430\u0432\u0438\u0447\u043A\u0430
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443, \u0442\u043E
      \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435 \u0457\u043C \u0431\u0443\u0434\u0435
      \u0446\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018314
    m_Localized: "\u041F\u0456\u0434\u0432\u0438\u0449\u0438\u0432\u0448\u0438 \u0441\u0432\u043E\u044E
      \u043D\u0430\u0432\u0438\u0447\u043A\u0443 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443,
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438
      \u0437 \u0457\u0457 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456 \u043C\u0456\u043D\u0438.
      \u0410\u043B\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435,
      \u0449\u043E \u0457\u0445\u043D\u0456\u0439 \u0441\u0435\u043D\u0441\u043E\u0440
      \u043C\u043E\u0436\u0435 \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0441\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438, \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0432\u0448\u0438
      \u0432\u0438\u0431\u0443\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018315
    m_Localized: "\u041F\u0456\u0434\u0432\u0438\u0449\u0438\u0432\u0448\u0438 \u0441\u0432\u043E\u044E
      \u043D\u0430\u0432\u0438\u0447\u043A\u0443 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443,
      \u0432\u0438 \u0437\u0430 \u0457\u0457 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438
      \u0442\u0443\u0440\u0435\u043B\u044C \u0432\u0456\u0434 \u0457\u0457 \u043E\u0441\u043D\u043E\u0432\u0438
      \u0456 \u0432\u0438\u0432\u0435\u0441\u0442\u0438 \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C \u0457\u0457 \u0437 \u043B\u0430\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018316
    m_Localized: "\u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u0447\u0430\u0441 \u043C\u043E\u0436\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0432\u0430\u0441 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u043C.
      \u0410\u043B\u0435 \u0432\u0430\u0441 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E
      \u043C\u043E\u0436\u0443\u0442\u044C \u043F\u043E\u0447\u0443\u0442\u0438 \u0456
      \u043F\u043E\u0447\u0430\u0442\u0438 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438
      \u043D\u0430 \u0437\u0432\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018317
    m_Localized: "\u0421\u0444\u0435\u0440\u0438 \u043F\u0430\u043C'\u044F\u0442\u0456
      \u0442\u0430 \u0434\u0435\u044F\u043A\u0456 \u043A\u043D\u0438\u0436\u043A\u0438
      \u043C\u0456\u0441\u0442\u044F\u0442\u044C \u0446\u0456\u043D\u043D\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456,
      \u044F\u043A\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u0442\u0438
      \u0432\u0430\u0448\u0456 \u043D\u0430\u0432\u0438\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018318
    m_Localized: "\u0412\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430 \u0421-4
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0439\u043C\u0456\u0446\u043D\u0456\u0448\u0443
      \u0431\u0435\u0442\u043E\u043D\u043D\u0443 \u0430\u0431\u043E \u043A\u0430\u043C'\u044F\u043D\u0443
      \u0441\u0442\u0456\u043D\u0443. \u041C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0456 \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0443 \u0431\u043E\u043C\u0431\u0443,
      \u0430\u043B\u0435 \u0432\u043E\u043D\u0430 \u0437\u043D\u0430\u0447\u043D\u043E
      \u043C\u0435\u043D\u0448 \u043F\u043E\u0442\u0443\u0436\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018319
    m_Localized: "\u0412\u0438 \u0434\u0430\u043B\u0435\u043A\u043E \u043D\u0435
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0432\u043B\u0443\u0447\u0430\u0442\u0438
      \u0443 \u0432\u043E\u0440\u043E\u0433\u0430. \u041D\u0430 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F \u0432\u043F\u043B\u0438\u0432\u0430\u0454
      \u0442\u0438\u043F \u0437\u0431\u0440\u043E\u0457 \u0456 \u0432\u0430\u0448
      \u0440\u0456\u0432\u0435\u043D\u044C \u043D\u0430\u0432\u0438\u0447\u043A\u0438.
      \u0429\u043E\u0431 \u0432\u043B\u0443\u0447\u0438\u0442\u0438 \u0437\u0456
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \u043E\u0431\u0440\u0456\u0437\u0443, \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u0456\u0434\u0456\u0439\u0442\u0438 \u0434\u043E \u0432\u043E\u0440\u043E\u0433\u0430
      \u0431\u043B\u0438\u0436\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018320
    m_Localized: "[Shift]+[\u043A\u043B\u0456\u043A] \u043F\u043E \u043D\u0430\u0437\u0432\u0456
      \u0442\u043E\u0432\u0430\u0440\u0443 \u0443 \u0432\u0456\u043A\u043D\u0456
      \u0442\u043E\u0440\u0433\u0456\u0432\u043B\u0456 \u0432\u0438\u0431\u0435\u0440\u0435
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0443
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0443
      \u0434\u043B\u044F \u043A\u0443\u043F\u0456\u0432\u043B\u0456 \u0430\u0431\u043E
      \u043F\u0440\u043E\u0434\u0430\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018321
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u044F\u043A\u0443 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u0440\u0435\u0439\u0434\u0435\u0440\u0438, \u0437\u0430\u0432\u0436\u0434\u0438
      \u043F\u0430\u0440\u0448\u0438\u0432\u043E\u0457 \u044F\u043A\u043E\u0441\u0442\u0456
      \u0456 \u0432 \u0436\u0430\u0445\u043B\u0438\u0432\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456.
      \u0413\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0430 \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0438.
      \u0425\u043E\u0440\u043E\u0448\u0443 \u0437\u0431\u0440\u043E\u044E \u043C\u043E\u0436\u043D\u0430
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0432 \u043D\u0435\u0440\u043E\u0437\u0433\u0440\u0430\u0431\u043E\u0432\u0430\u043D\u0438\u0445
      \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0430\u0445, \u0430 \u0456\u043D\u043E\u0434\u0456
      \u0439 \u0443 \u0441\u0435\u0439\u0444\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018322
    m_Localized: "\u041F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u043C\u0435\u043D\u0448 \u0442\u043E\u0447\u043D\u0430, \u0437\u0430\u0432\u0434\u0430\u0454
      \u043C\u0435\u043D\u0448\u043E\u0457 \u0448\u043A\u043E\u0434\u0438, \u0430
      \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435 \u0434\u0430\u0442\u0438
      \u043E\u0441\u0456\u0447\u043A\u0443 \u0430\u0431\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018323
    m_Localized: "\u0421\u0435\u0439\u0444\u0438 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0456, \u0430 \u0456\u043D\u043E\u0434\u0456
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u043C\u0456\u043D\u043E\u0432\u0430\u043D\u0456
      \u0430\u0431\u043E \u043F\u0456\u0434 \u0441\u0438\u0433\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0454\u044E.
      \u0412\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0437\u043B\u043E\u043C\u0443,
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438 \u0430\u0431\u043E \u0441\u043A\u0440\u0438\u0442\u043D\u043E\u0441\u0442\u0456,
      \u0449\u043E\u0431 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u0432\u043C\u0456\u0441\u0442\u0443.
      \u0410\u043B\u0435 \u0446\u0435, \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E,
      \u0442\u043E\u0433\u043E \u0432\u0430\u0440\u0442\u0435, \u0430\u0434\u0436\u0435
      \u0449\u043E \u043A\u0440\u0430\u0449\u0438\u0439 \u0437\u0430\u043C\u043E\u043A,
      \u0442\u043E \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435 \u0432\u0438\u044F\u0432\u043B\u0435\u043D\u043D\u044F
      \u0432 \u0441\u0435\u0439\u0444\u0456 \u0446\u0456\u043D\u043D\u0438\u0445
      \u0440\u0435\u0447\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018324
    m_Localized: "\u0412\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0431\u0435\u0437\u043B\u0456\u0447 \u0432\u0438\u0434\u0456\u0432 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432.
      \u0426\u0435 \u043C\u043E\u0436\u0435 \u0441\u0442\u0430\u0442\u0438 \u0432\u0435\u043B\u0438\u043A\u043E\u044E
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u044E - \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0443 \u0432\u0430\u0441 \u0454 \u043A\u0440\u0443\u0442\u0430
      \u0433\u0430\u0440\u043C\u0430\u0442\u0430, \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438
      \u0437 \u043D\u0435\u0457 \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438
      \u043D\u0456\u0447\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018325
    m_Localized: "\u0414\u0438\u043A\u0456 \u0433\u0443\u043B\u0456 \u043B\u044E\u0431\u043B\u044F\u0442\u044C
      \u0437\u0430\u043A\u043E\u043F\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0432
      \u0437\u0435\u043C\u043B\u044E. \u041D\u0456\u0449\u043E \u043D\u0435 \u0432\u0438\u0434\u0430\u0441\u0442\u044C
      \u0457\u0445\u043D\u044C\u043E\u0457 \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u043E\u0441\u0442\u0456
      \u0434\u043E\u0442\u0438, \u0434\u043E\u043A\u0438 \u0432\u043E\u043D\u0438
      \u043D\u0435 \u0432\u0438\u043A\u043E\u043F\u0430\u044E\u0442\u044C\u0441\u044F
      \u0456 \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018326
    m_Localized: "\u0412\u0438 \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0438\u0441\u044F
      \u0437 \u0436\u0430\u0445\u043B\u0438\u0432\u0438\u043C \u0441\u043B\u0438\u0437\u043E\u043C?
      \u041F\u0430\u043B\u0456\u0442\u044C \u0439\u043E\u0433\u043E \u0432\u043E\u0433\u043D\u0435\u043C,
      \u0430 \u044F\u043A\u0449\u043E \u0446\u0435 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0442\u043E \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u043D\u0435
      \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0439\u0442\u0435 \u043D\u0430 \u043D\u044C\u043E\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018327
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0456 \u0440\u043E\u0437\u0440\u044F\u0434\u0438
      \u0437\u0430\u043F\u043E\u0434\u0456\u044E\u0442\u044C \u0432\u0430\u043C \u0437\u043D\u0430\u0447\u043D\u043E
      \u043C\u0435\u043D\u0448\u0435 \u0448\u043A\u043E\u0434\u0438, \u044F\u043A\u0449\u043E
      \u0432\u0438 \u043D\u0435 \u0442\u043E\u0440\u043A\u0430\u0454\u0442\u0435\u0441\u044C
      \u0437\u0435\u043C\u043B\u0456, \u0456 \u0437\u043D\u0430\u0447\u043D\u043E
      \u0431\u0456\u043B\u044C\u0448\u0435, \u044F\u043A\u0449\u043E \u0432\u0438
      \u043D\u0430\u043C\u043E\u043A\u043D\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018328
    m_Localized: "\u0413\u0443\u043B\u0456, \u0449\u043E \u0441\u0432\u0456\u0442\u044F\u0442\u044C\u0441\u044F,
      \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0456! \u0410\u0442\u0430\u043A\u0443\u044E\u0447\u0438
      \u0432\u0430\u0441, \u0432\u043E\u043D\u0438 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438, \u0430 \u0439 \u043E\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u044E\u0442\u044C
      \u0432\u0430\u0441 \u0434\u043E\u0437\u043E\u044E \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018329
    m_Localized: "\u041C\u0435\u0442\u0430\u043B\u0435\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0456\u0434
      \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0456 \u043B\u0430\u0437\u0435\u0440\u0456\u0432, \u0430\u043B\u0435 \u0432\u043E\u043D\u0430
      \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043A\u0430, \u0430 \u043A\u0440\u0456\u043C
      \u0442\u043E\u0433\u043E, \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454
      \u0432\u0430\u0448\u0443 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0434\u043E \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018330
    m_Localized: "\u041A\u0438\u0441\u043B\u043E\u0442\u0430 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0430\u0432\u0434\u0430\u0454 \u0448\u043A\u043E\u0434\u0438, \u0430
      \u0439 \u0448\u0432\u0438\u0434\u043A\u043E \u0440\u0443\u0439\u043D\u0443\u0454
      \u0431\u0440\u043E\u043D\u044E, \u044F\u043A \u0432\u0430\u0448\u0443, \u0442\u0430\u043A
      \u0456 \u0432\u0430\u0448\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018331
    m_Localized: "\u042F\u043A\u0449\u043E \u0432\u0438 \u0441\u0442\u0440\u0456\u043B\u044F\u0454\u0442\u0435
      \u043D\u0430 \u0431\u0456\u0433\u0443 \u0430\u0431\u043E \u0441\u043E\u0431\u0456
      \u0437\u0430 \u0441\u043F\u0438\u043D\u0443, \u0442\u043E \u0446\u0435 \u0437\u043D\u0438\u0436\u0443\u0454
      \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C. \u042F\u043A\u0449\u043E
      \u0436 \u0432\u0438 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u043D\u0435\u0440\u0443\u0445\u043E\u043C\u043E \u0441\u0442\u043E\u0457\u0442\u0435
      \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0437\u0456, \u0442\u043E \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C
      \u0437\u0440\u043E\u0441\u0442\u0430\u0454. \u041D\u0430 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0417.\u041F.\u0421. \u0432\u0441\u0435 \u0446\u0435
      \u043D\u0456\u044F\u043A \u043D\u0435 \u0432\u043F\u043B\u0438\u0432\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018332
    m_Localized: "\u042F\u043A\u0449\u043E \u0432\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u043B\u0438
      \u0437\u0430\u043C\u043E\u043A \u043D\u0430 \u044F\u043A\u043E\u043C\u0443\u0441\u044C
      \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0456 \u0430\u0431\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0439\u043E\u0433\u043E \u0437\u043B\u0430\u043C\u0430\u0442\u0438, \u0442\u043E
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0439\u043E\u0433\u043E \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0438.
      \u0406 \u0440\u0435\u0447\u0456 \u0437 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430,
      \u0456 \u0441\u0430\u043C\u0430 \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0430
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0431\u0443\u0434\u0443\u0442\u044C
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018333
    m_Localized: "\u0421\u0435\u0439\u0444\u0438, \u044F\u043A\u0456 \u043D\u0456\u044F\u043A
      \u043D\u0435 \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0437\u043B\u0430\u043C\u0430\u0442\u0438,
      \u043C\u043E\u0436\u043D\u0430 \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0431\u043E\u043C\u0431\u0438
      \u0430\u0431\u043E \u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u0437\u0432'\u044F\u0437\u043E\u043A
      \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u0443. \u0410\u043B\u0435 \u0439\u043E\u0433\u043E
      \u0432\u043C\u0456\u0441\u0442, \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0431\u0443\u0434\u0435 \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018334
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0435 \u043F\u043E\u043B\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438,
      \u043E\u0434\u043D\u0430\u043A \u0443 \u0440\u0430\u0437\u0456 \u043D\u0435\u0432\u0434\u0430\u0447\u0456
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0443\u0434\u0430\u0440 \u0441\u0442\u0440\u0443\u043C\u043E\u043C. \u041D\u0430
      \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C \u0443\u0441\u043F\u0456\u0445\u0443
      \u0432\u043F\u043B\u0438\u0432\u0430\u0454 \u0440\u0456\u0432\u0435\u043D\u044C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \"\u0420\u0435\u043C\u043E\u043D\u0442\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018335
    m_Localized: "\u0412\u0438\u0432\u0447\u0438\u0432\u0448\u0438 \u043D\u0430\u0432\u0438\u0447\u043A\u0443
      \"\u0422\u043E\u0440\u0433\u0456\u0432\u043B\u044F\", \u0432\u0438 \u043D\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u043D\u0438\u0437\u0438\u0442\u0435
      \u0446\u0456\u043D\u0438 \u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u0438
      \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432, \u0430 \u0439
      \u0440\u043E\u0437\u0448\u0438\u0440\u0438\u0442\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439
      \u0430\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018336
    m_Localized: "\u041C\u0430\u0439\u0436\u0435 \u0432 \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0432\u0438\u0434\u0443 \u0437\u0431\u0440\u043E\u0457 \u0454 \u0432\u0438\u043C\u043E\u0433\u0438
      \u0434\u043E \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438.
      \u0417\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0437\u0431\u0440\u043E\u044F
      \u0432\u0442\u0440\u0430\u0447\u0430\u0442\u0438\u043C\u0435 \u0441\u0432\u043E\u044E
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C -
      \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0435 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438\u043C\u0435
      \u0443\u0434\u0430\u0440\u0456\u0432, \u043F\u0440\u043E\u043C\u0430\u0445\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F
      \u0456 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438\u043C\u0435 \u043C\u0435\u043D\u0448\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018337
    m_Localized: "\u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0432\u0438\u0434\u0456\u0432
      \u0431\u0440\u043E\u043D\u0456 \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u0442\u0438.
      \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0432\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \"\u043F\u0456\u0434\u0433\u043E\u043D\u043A\u0430
      \u0431\u0440\u043E\u043D\u0456\", \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438
      \u0442\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018338
    m_Localized: "\u0428\u0443\u043A\u0430\u0439\u0442\u0435 \u0430\u0431\u043E \u043A\u0443\u043F\u0443\u0439\u0442\u0435
      \u0441\u0445\u0435\u043C\u0438 \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u0417\u0456\u0431\u0440\u0430\u0442\u0438
      \u0457\u0457 \u043C\u043E\u0436\u043D\u0430 \u043D\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0456,
      \u044F\u043A\u0449\u043E \u0454 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438. \u0415\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434 \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0420\u0435\u043C\u043E\u043D\u0442\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018339
    m_Localized: "\u041F\u043E\u0441\u0438\u043B\u0435\u043D\u0430 \u0442\u0443\u0440\u0435\u043B\u044C
      \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0430
      \u0431\u0440\u043E\u043D\u0435\u044E \u0456 \u0441\u0438\u043B\u043E\u0432\u0438\u043C
      \u043F\u043E\u043B\u0435\u043C, \u0430\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437 \u043E\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u043A\u0443. \u0407\u0457
      \u0434\u0443\u0436\u0435 \u043B\u0435\u0433\u043A\u043E \u0437\u043D\u0438\u0449\u0438\u0442\u0438,
      \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0438 \u0437\u0437\u0430\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018340
    m_Localized: "\u0420\u043E\u0431\u043E\u0442\u0438-\u0432\u0430\u0440\u0442\u043E\u0432\u0456
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456!
      \u0412\u043E\u043D\u0438 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0456 \u043C\u0456\u0446\u043D\u043E\u044E
      \u0431\u0440\u043E\u043D\u0435\u044E \u0456 \u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
      \u0432\u0438\u0434\u0430\u043C\u0438 \u0432\u0430\u0436\u043A\u043E\u0433\u043E
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F. \u041D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u0439\u0442\u0435
      \u0437 \u043D\u0438\u043C\u0438 \u0432 \u0431\u0456\u0439, \u043D\u0435 \u043C\u0430\u044E\u0447\u0438
      \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u043E\u0457 \u0430\u0431\u043E
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018341
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u043E\u0437\u0440\u044F\u0434\u0438\u0442\u0438
