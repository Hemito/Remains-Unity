      \u0456 \u0437\u043E\u0432\u0441\u0456\u043C \u0432\u0438\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0438\u043C \u043D\u0430\u0432\u0456\u0442\u044C
      \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0437\u0430\u0434\u0456\u044F\u043D\u043D\u044F \u0432\u0441\u0456\u0445 \u043D\u0430\u044F\u0432\u043D\u0438\u0445
      \u0443 \u043D\u0430\u0441 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432."
