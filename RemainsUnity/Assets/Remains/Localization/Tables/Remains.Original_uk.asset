      m_Items: []
  - m_Id: 2737823868
    m_Localized: "\u041C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438. \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u043A\u0440\u0430\u0449\u043E\u0433\u043E \u043B\u0456\u043A\u0430\u0440\u044F
      \u043C\u0438 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435\u043C\u043E.
      \u042F \u0440\u043E\u0437\u0443\u043C\u0456\u044E, @lp, \u0449\u043E \u0432
      \u0442\u0435\u0431\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0441\u043F\u0440\u0430\u0432,
      \u0430\u043B\u0435 \u0447\u0438 \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
      \u0431 \u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823869
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E, \u0412\u0435\u043B\u044C\u0432\u0435\u0442,
      \u043F\u0440\u043E \u0449\u043E \u0440\u043E\u0437\u043C\u043E\u0432\u0430?
      \u041E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u044E
      \u0414\u043E\u043A\u0430 \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u043C
      \u0447\u0430\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823870
    m_Localized: "\u041F\u043E\u043A\u0432\u0430\u043F\u0441\u044F, \u0431\u0443\u0434\u044C
      \u043B\u0430\u0441\u043A\u0430. \u041D\u0435\u0432\u0456\u0434\u043E\u043C\u043E,
      \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0432 \u043D\u0430\u0441 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0447\u0430\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823871
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u0434\u043E\u043A. \u0404
      \u0441\u043F\u0440\u0430\u0432\u0430, \u0434\u0443\u0436\u0435 \u0442\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823872
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438. \u041A\u043E\u043C\u0443\u0441\u044C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823873
    m_Localized: "\u0422\u0430\u043A. \u0412 \u043E\u0434\u043D\u043E\u0433\u043E...
      \u043F\u043E\u043D\u0456... \u043F\u0438\u043B\u043E\u0432\u0430 \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0430.
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0430,
      \u0430 \u0456\u043D\u0430\u043A\u0448\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823874
    m_Localized: "\u0410 \u0456\u043D\u0430\u043A\u0448\u0435 \u0432\u0456\u043D
      \u0432\u0456\u0434\u043A\u0438\u043D\u0435 \u043A\u043E\u043F\u0438\u0442\u0430.
      \u0412\u0441\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E.
      \u0410\u043B\u0435 \u0442\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430,
      \u0449\u043E \u0432 \u043D\u044C\u043E\u0433\u043E \u0441\u0430\u043C\u0435
      \u0446\u044F \u0445\u0432\u043E\u0440\u043E\u0431\u0430? \u0412\u043E\u043D\u0430
      \u0434\u043E\u0441\u0438\u0442\u044C \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823875
    m_Localized: "\u0417\u0430 \u0432\u0441\u0456\u043C\u0430 \u043E\u0437\u043D\u0430\u043A\u0430\u043C\u0438
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823876
    m_Localized: "\"\u0417\u0430 \u0432\u0441\u0456\u043C\u0430 \u043E\u0437\u043D\u0430\u043A\u0430\u043C\u0438\"?
      \u0417\u043D\u0430\u0447\u0438\u0442\u044C, \u0442\u0438 \u0442\u0435\u043F\u0435\u0440
      \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u0438\u0441\u044F
      \u0432 \u043B\u0456\u043A\u0430\u0440\u0456? \u0422\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448,
      \u0449\u043E \u0446\u0435 \u043D\u0435 \u0456\u0433\u0440\u0430\u0448\u043A\u0438?
      \u0412\u0456\u0434 \u0442\u0432\u043E\u0433\u043E \u0440\u0456\u0448\u0435\u043D\u043D\u044F
      \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0441\u0430\u043C\u0435 \u0436\u0438\u0442\u0442\u044F
      \u043F\u043E\u043D\u0456, \u0456 \u044F\u043A\u0449\u043E \u0442\u0438 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0443\u0454\u0448 \u0445\u0432\u043E\u0440\u043E\u0431\u0443,
      \u043F\u0430\u0446\u0456\u0454\u043D\u0442 \u043C\u043E\u0436\u0435 \u0437\u0430\u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u043C\u0435\u0440\u0442\u0438, \u043F\u043E\u043A\u0438 \u0442\u0438
      \u0433\u0430\u0434\u0430\u0454\u0448, \u0447\u043E\u043C\u0443 \u0446\u0435
      \u0442\u0432\u043E\u0454 \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823877
    m_Localized: "\u0414\u043E\u043A, \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
      \u0449\u043E \u0446\u0435 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0430
      \u0440\u0456\u0447 \u0456 \u044F \u043D\u0435 \u0432\u043E\u043B\u043E\u0434\u0456\u044E
      \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u044E \u043E\u0441\u0432\u0456\u0442\u043E\u044E,
      \u0449\u043E\u0431 \u043F\u0440\u0435\u0442\u0435\u043D\u0434\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0437\u0432\u0430\u043D\u043D\u044F \u043B\u0456\u043A\u0430\u0440\u044F.
      \u041E\u0434\u043D\u0430\u043A \u044F \u0434\u043E\u0441\u0438\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u0430\u0441\u0443 \u0432\u0438\u0432\u0447\u0430\u043B\u0430
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438 \u0437 \u043F\u0438\u0442\u0430\u043D\u044C
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0438, \u0456 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u0438
      \u0445\u0432\u043E\u0440\u043E\u0457 \u0442\u043E\u0447\u043D\u043E \u0437\u0431\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F
      \u0437 \u043E\u043F\u0438\u0441\u043E\u043C \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u0456\u0432
      \u043F\u0438\u043B\u043E\u0432\u043E\u0457 \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0438:
      \u0443 \u0445\u0432\u043E\u0440\u043E\u0457 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u043F\u0435\u0432\u043D\u0430 \u0441\u043B\u044C\u043E\u0437\u043E\u0442\u0435\u0447\u0430,
      \u043F\u043E\u0447\u0435\u0440\u0432\u043E\u043D\u0456\u043D\u043D\u044F \u0441\u043B\u0438\u0437\u043E\u0432\u043E\u0457
      \u043E\u0431\u043E\u043B\u043E\u043D\u043A\u0438 \u043E\u043A\u0430 \u0442\u0430
      \u0437\u0430\u043F\u0430\u043B\u0435\u043D\u043D\u044F \u043F\u043E\u0432\u0456\u043A,
      \u044F\u043A \u0443 \u0440\u0430\u0437\u0456 \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u043D\u043D\u044F
      \u043F\u0456\u0441\u043A\u0443, \u0445\u043E\u0447\u0430 \u043F\u0440\u0438
      \u043E\u0433\u043B\u044F\u0434\u0456 \u043E\u0447\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0456\u0445
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432 \u0456 \u0441\u043C\u0456\u0442\u0442\u044F
      \u043F\u0456\u0434 \u043F\u043E\u0432\u0456\u043A\u0430\u043C\u0438 \u0442\u0430
      \u0432 \u043A\u0443\u0442\u043E\u0447\u043A\u0430\u0445 \u043D\u0435 \u0432\u0438\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F,
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043F\u043E\u043C\u0456\u0442\u043D\u043E
      \u0432\u0438\u0449\u0430 \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456
      \u0437\u0430\u0441\u0442\u0443\u0434\u043D\u0456 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438
      \u0442\u0430 \u0431\u0456\u043B\u044C\u0448\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0456 \u043F\u0456\u0434
      \u0447\u0430\u0441 \u0432\u0456\u0440\u0443\u0441\u043D\u043E\u0457 \u0456\u043D\u0444\u0435\u043A\u0446\u0456\u0457,
      \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u044F \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0430
      \u0434\u043B\u044F \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u0445 \u0445\u0432\u043E\u0440\u043E\u0431
      \u043F\u0456\u0442\u043B\u0438\u0432\u0456\u0441\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823878
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u0437\u0443\u043F\u0438\u043D\u0438\u0441\u044C.
      \u042F\u043A\u0449\u043E \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u0438, \u0442\u043E \u044F \u043F\u043E\u0433\u043E\u0434\u0436\u0443\u0441\u044F,
      \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0443 \u043F\u0430\u0446\u0456\u0454\u043D\u0442\u0430 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043F\u0438\u043B\u043E\u0432\u0430 \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0430.
      \u042F \u043D\u0435 \u043C\u043E\u0436\u0443 \u043D\u0456\u0447\u043E\u0433\u043E
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u0442\u043E\u0447\u043D\u043E \u0431\u0435\u0437
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E\u0433\u043E \u043E\u0433\u043B\u044F\u0434\u0443,
      \u0430\u043B\u0435 \u0446\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0434\u043E\u0432\u0456\u0440\u0438\u043C\u043E\u0441\u044F \u0442\u0432\u043E\u0457\u043C
      \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823879
    m_Localized: "\u041F'\u044F\u0442\u044C \u0442\u0438\u0441\u044F\u0447 \u043A\u0440\u0438\u0448\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823880
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E \u0441\u043E\u0431\u0456!
      \u0410 \u0447\u0438 \u043D\u0435 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823881
    m_Localized: "\u041C\u0435\u043D\u0456 \u043E\u0434\u043D\u0430 \u0430\u043C\u043F\u0443\u043B\u0430
      \u0446\u0456\u0454\u0457 \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0438
      \u043E\u0431\u0456\u0439\u0448\u043B\u0430\u0441\u044F \u0432 \u0447\u043E\u0442\u0438\u0440\u0438
      \u0442\u0438\u0441\u044F\u0447\u0456 \u043F'\u044F\u0442\u0441\u043E\u0442
      \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430,
      \u0449\u043E \u043F\u0440\u043E\u0457\u0436\u0434\u0436\u0430\u0432 \u043F\u043E\u0432\u0437,
      \u0456 \u044F \u043A\u0443\u043F\u0438\u0432 \u0457\u0457, \u043D\u0435 \u0437\u043D\u0430\u044E\u0447\u0438,
      \u0447\u0438 \u0431\u0443\u0434\u0443\u0442\u044C \u0443 \u043C\u0435\u043D\u0435
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0445\u043E\u0447 \u043A\u043E\u043B\u0438\u0441\u044C
      \u043F\u0430\u0446\u0456\u0454\u043D\u0442\u0438 \u0437 \u0442\u0430\u043A\u043E\u044E
      \u0445\u0432\u043E\u0440\u043E\u0431\u043E\u044E. \u0406 \u044F \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0432
      \u0457\u0457 \u0432\u0435\u0441\u044C \u0446\u0435\u0439 \u0447\u0430\u0441
      \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445,
      \u043D\u0430 \u0449\u043E, \u043C\u0456\u0436 \u0456\u043D\u0448\u0438\u043C,
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454\u0442\u044C\u0441\u044F \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0435\u043D\u0435\u0440\u0433\u0456\u044F.
      \u0410 \u043F\u0430\u043B\u0438\u0432\u043E \u0434\u043B\u044F \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0456\u0432
      \u0442\u0435\u0436 \u043D\u0435 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0435,
      \u0437\u043D\u0430\u0454\u0448. \u0422\u043E\u0436 \u043A\u0440\u0430\u0449\u0435
      \u0441\u043A\u0430\u0436\u0438 \"\u0441\u043F\u0430\u0441\u0438\u0431\u0456\"
      \u0437\u0430 \u0442\u0435, \u0449\u043E \u044F \u043F\u0440\u043E\u0434\u0430\u044E
      \u0442\u043E\u0431\u0456 \u043B\u0456\u043A\u0438 \u0444\u0430\u043A\u0442\u0438\u0447\u043D\u043E
      \u0437\u0430 \u0441\u043E\u0431\u0456\u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044E
      \u0456 \u043D\u0435 \u043D\u0430\u0433\u0430\u0434\u0443\u044E \u0437\u0430\u0439\u0432\u0438\u0439
      \u0440\u0430\u0437 \u043F\u0440\u043E \u0442\u0432\u043E\u0457 \u0434\u043E\u0445\u043E\u0434\u0438
      \u0432\u0456\u0434 \u043F\u0440\u043E\u0434\u0430\u0436\u0443 \u0445\u0430\u0431\u0430\u0440\u0430
      \u0437 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445 \u0440\u0443\u0457\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823882
    m_Localized: "\u0410 \u0449\u043E\u0431 \u0442\u0435\u0431\u0435, \u043D\u0443
      \u0434\u043E\u0431\u0440\u0435! \u0414\u0430\u0432\u0430\u0439 \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0443,
      \u044F \u0437\u0430\u043F\u043B\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823883
    m_Localized: "\u0412\u0438 \u0440\u043E\u0431\u0438\u0442\u0435 \u043F\u0430\u0446\u0456\u0454\u043D\u0442\u0446\u0456
      \u0443\u043A\u043E\u043B \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0438
      \u0456 \u043C\u0430\u0439\u0436\u0435 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436 \u043F\u043E\u043C\u0456\u0447\u0430\u0454\u0442\u0435 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u0456
      \u0437\u043C\u0456\u043D\u0438. \u0407\u0457 \u0434\u0438\u0445\u0430\u043D\u043D\u044F
      \u0441\u0442\u0430\u0454 \u0440\u0456\u0432\u043D\u0438\u043C \u0456 \u0433\u043B\u0438\u0431\u043E\u043A\u0438\u043C,
      \u0430 \u0436\u0430\u0440 \u0441\u043F\u0430\u0434\u0430\u0454. \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043A\u0440\u0438\u0437\u0430 \u043C\u0438\u043D\u0443\u043B\u0430 \u0456
      \u0442\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0430 \u043F\u0456\u0434\u0435
      \u043D\u0430 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823884
    m_Localized: "\u041E\u0441\u044C \u0442\u0430\u043A, \u0417\u0456\u0440\u043E,
      \u043E\u0434\u0443\u0436\u0443\u0439. \u0414\u043E \u0447\u043E\u0433\u043E
      \u0436 \u0446\u0435 \u043F\u0440\u0438\u0454\u043C\u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F,
      \u043A\u043E\u043B\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u0448
      \u0456\u043D\u0448\u0438\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823885
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u0434\u0435
      \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0442\u0438 \u0457\u0457 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u043D\u044C-\u0434\u0440\u0443\u0433\u0438\u0439 \u0456 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438,
      \u044F\u043A \u0456\u0434\u0443\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823886
    m_Localized: "@lp! \u042F\u043A \u0434\u043E\u0431\u0440\u0435, \u0449\u043E
      \u0442\u0438 \u0437\u0430\u0439\u0448\u043B\u0430. \u0426\u0435 \u0449\u043E\u0434\u043E
      \u0417\u0456\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823887
    m_Localized: "\u0410? \u0429\u043E \u0442\u0430\u043A\u0435? \u0407\u0439 \u043A\u0440\u0430\u0449\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823888
    m_Localized: "\u0422\u0430\u043A! \u041D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0457\u0439 \u0449\u0435 \u0434\u043E\u0432\u0433\u043E \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043B\u0435\u0436\u0430\u0442\u0438 \u0432 \u043B\u0456\u0436\u043A\u0443,
      \u0430\u043B\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0430 \u043C\u0438\u043D\u0443\u043B\u0430,
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u043D\u0435\u043C\u0430\u0454 \u0436\u043E\u0434\u043D\u0438\u0445
      \u0441\u0443\u043C\u043D\u0456\u0432\u0456\u0432. \u0406 \u0432 \u0446\u044C\u043E\u043C\u0443
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0432\u043E\u044F \u0437\u0430\u0441\u043B\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823889
    m_Localized: "\u041D\u0443 \u0449\u043E \u0442\u0438, \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823890
    m_Localized: "\u041D\u0456, @lp! \u0412\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u0447\u0438\u0454\u0441\u044C \u0436\u0438\u0442\u0442\u044F - \u0446\u0435
      \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u0456!
      \u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438, \u043F\u0456\u0434
      \u0447\u0430\u0441 \u043D\u0430\u0448\u043E\u0457 \u043F\u0435\u0440\u0448\u043E\u0457
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456 \u0442\u0438 \u0437\u0434\u0430\u043B\u0430\u0441\u044F
      \u043C\u0435\u043D\u0456 \u043D\u0456\u0447\u0438\u043C \u043D\u0435 \u043A\u0440\u0430\u0449\u043E\u044E
      \u0437\u0430 \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432
      \u041F\u0443\u0441\u0442\u043E\u043A, \u044F\u043A\u0456 \u0432\u043C\u0456\u044E\u0442\u044C
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F. \u0410\u043B\u0435 \u0442\u0438 \u0434\u043E\u0432\u0435\u043B\u0430,
      \u0449\u043E \u0437\u0434\u0430\u0442\u043D\u0430 \u043D\u0430 \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823891
    m_Localized: "\u041E\u0441\u044C, \u0443 \u043C\u0435\u043D\u0435 \u0454 \u0434\u043B\u044F
      \u0442\u0435\u0431\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A. \u0426\u0435 \u0444\u0456\u0433\u0443\u0440\u043A\u0430
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u043E\u0457 \u043F\u043E\u043D\u0456,
      \u0447\u0438\u0457 \u0434\u043E\u0431\u0440\u043E\u0442\u0430 \u0456 \u0441\u043F\u0456\u0432\u0447\u0443\u0442\u0442\u044F
      \u043D\u0435 \u0437\u043D\u0430\u043B\u0438 \u043C\u0435\u0436 - \u0424\u043B\u0430\u0442\u0442\u0435\u0440\u0448\u0430\u0439,
      \u0433\u043E\u043B\u043E\u0432\u0438 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u041C\u0438\u0440\u0443. \u041D\u0435\u0445\u0430\u0439 \u0432\u043E\u043D\u0430
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0443\u0434\u0435 \u0437 \u0442\u043E\u0431\u043E\u044E,
      \u0442\u0430\u043A \u0441\u0430\u043C\u043E \u044F\u043A \u0456 \u0437\u0456
      \u043C\u043D\u043E\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823892
    m_Localized: "\u0423\u0441\u0435 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
      \u041D\u0435\u0445\u0430\u0439 \u0442\u0435\u043F\u0435\u0440 \u043F\u043E\u0441\u043F\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823893
    m_Localized: "\u0407\u0439 \u0442\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u043E
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435 \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823894
    m_Localized: "\u0417\u0434\u0440\u0430\u0441\u0442\u0443\u0439. \u0426\u0435
      \u0436 \u0442\u0438 @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823895
    m_Localized: "\u0422\u0438 \u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044F?
      \u0420\u0430\u0434\u0430 \u0431\u0430\u0447\u0438\u0442\u0438 \u0446\u0435.
      \u041F\u0440\u0438\u0432\u0456\u0442! \u0422\u0430\u043A, \u0446\u0435 \u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823896
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u0441\u043A\u0430\u0437\u0430\u043B\u0430
      \u043C\u0435\u043D\u0456, \u0449\u043E \u0442\u0438 \u0437\u0434\u043E\u0431\u0443\u043B\u0430
      \u0442\u0456 \u043B\u0456\u043A\u0438, \u0449\u043E \u043C\u0435\u043D\u0435
      \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823897
    m_Localized: "\u041D\u0443, \u0443 \u0446\u044C\u043E\u043C\u0443 \u043D\u0435
      \u0431\u0443\u043B\u043E \u043D\u0456\u0447\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E
      \u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823898
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043D\u0435 \u0431\u0443\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823899
    m_Localized: "\u042F\u043A \u0442\u0438 \u0441\u0435\u0431\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823900
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u043E\u0431\u0456
      \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0431\u0443\u043B\u043E \u043D\u0435\u0441\u043A\u043B\u0430\u0434\u043D\u043E
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438 \u0442\u0456 \u043B\u0456\u043A\u0438.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u043C\u043E\u0433\u043B\u0430
      \u0431 \u043E\u0434\u0443\u0436\u0430\u0442\u0438 \u0456 \u0431\u0435\u0437
      \u043D\u0438\u0445. \u041C\u043E\u0436\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823901
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u044F\u043A \u0446\u0435
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438. \u042F... \u0437\u0434\u0438\u0432\u043E\u0432\u0430\u043D\u0430.
      \u041C\u0438 \u0442\u0443\u0442, \u0443 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0456,
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454\u043C\u043E
      \u043E\u0434\u043D\u0435 \u043E\u0434\u043D\u043E\u043C\u0443. \u0422\u0430\u043A
      \u0456 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438, \u0431\u0435\u0437 \u0446\u044C\u043E\u0433\u043E
      \u043D\u0430\u043C \u043D\u0435 \u0432\u0438\u0436\u0438\u0442\u0438. \u0410\u043B\u0435
      \u043C\u0438 \u0436\u0438\u0432\u0435\u043C\u043E \u0440\u0430\u0437\u043E\u043C.
      \u041C\u0438 \u0432\u0441\u0456 \u0440\u0430\u0437\u043E\u043C. \u0410 \u0442\u0438
      \u0436... \u043B\u0438\u0448\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0430
      \u043F\u043E\u0432\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823902
    m_Localized: "\u041D\u0443, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u0433\u043B\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438, \u0456 \u044F \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0449\u043E \u043C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u0446\u0435
      \u0437\u0440\u043E\u0431\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823903
    m_Localized: "\u0422\u043E\u0431\u0456 \u0437 \u0446\u044C\u043E\u0433\u043E
      \u043D\u0435 \u0431\u0443\u043B\u043E \u0436\u043E\u0434\u043D\u043E\u0457
      \u043A\u043E\u0440\u0438\u0441\u0442\u0456. \u041D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0456 - \u0442\u0438 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0430,
      \u043D\u0435 \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C. \u0423 \u043D\u0430\u0448\u043E\u043C\u0443
      \u0441\u0432\u0456\u0442\u0456 \u0446\u0435 \u043C\u043E\u0436\u0435 \u043E\u0431\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u043F\u043E\u0433\u0430\u043D\u043E, \u0446\u0435 \u0432\u0441\u0456 \u0437\u043D\u0430\u044E\u0442\u044C.
      \u0412\u0438\u0436\u0438\u0432\u0430\u0442\u0438 \u043D\u0435\u043B\u0435\u0433\u043A\u043E,
      \u043A\u043E\u0436\u0435\u043D \u0448\u043C\u0430\u0442\u043E\u043A \u0446\u0456\u043D\u043D\u0438\u0439.
      \u0412\u0438 \u0437 \u0442\u0432\u043E\u0454\u044E \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u044E
      \u0442\u0430\u043A\u0456... \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u0456.
      \u0422\u0430\u043A, \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u0456.
      \u042F\u043A\u0431\u0438 \u0432\u0438 \u0431\u0443\u043B\u0438 \u0434\u0443\u0440\u043D\u0456,
      \u0446\u0435 \u0431\u0443\u043B\u043E \u0431 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E.
      \u0410\u043B\u0435 \u0434\u0443\u0440\u043D\u0456 \u0434\u043E\u0432\u0433\u043E
      \u043D\u0435 \u0436\u0438\u0432\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823904
    m_Localized: "\u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u0430
      \u043D\u0430\u043C \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E.
      \u041F\u0440\u043E \u0442\u0435, \u044F\u043A\u0438\u043C \u0441\u0432\u0456\u0442
      \u0431\u0443\u0432, \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438. \u041D\u0435
      \u0437\u043D\u0430\u044E, \u044F \u043D\u0435 \u0434\u0443\u043C\u0430\u044E,
      \u0449\u043E \u0442\u0430\u043A \u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0442\u0438
      \u0437\u0430\u0440\u0430\u0437. \u0410\u043B\u0435 \u0432\u0430\u043C \u0434\u0432\u043E\u043C
      \u0446\u0435 \u044F\u043A\u043E\u0441\u044C \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F.
      \u0414\u044F\u043A\u0443\u044E \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443.
      \u0429\u043E \u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0430
      \u043C\u0435\u043D\u0456, \u0445\u043E\u0447 \u0456 \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u0437\u043D\u0430\u043B\u0430. \u0406 \u0449\u043E \u0436\u0438\u0432\u0435\u0448
      \u043D\u0435 \u0442\u0430\u043A, \u044F\u043A \u043C\u0438. \u0422\u0438 \u0456
      \u0412\u0435\u043B\u044C\u0432\u0435\u0442... \u044F \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E
      \u0432\u0430\u0441, \u0430\u043B\u0435 \u043C\u0435\u043D\u0456 \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u0430\u0447\u0438\u0442\u0438, \u0449\u043E \u0443 \u0432\u0430\u0441
      \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C \u0436\u0438\u0442\u0438 \u043E\u0441\u044C
      \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823905
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0438 \u0434\u0430\u0441\u0442\u044C
      \u0442\u043E\u0431\u0456 \u0449\u043E\u0441\u044C \u0442\u0430\u043A\u0430
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C, \u0430\u043B\u0435
      \u043C\u0435\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0438\u0454\u043C\u043D\u043E
      \u0431\u0430\u0447\u0438\u0442\u0438, \u0449\u043E \u043A\u043E\u043C\u0443\u0441\u044C
      \u0441\u0442\u0430\u043B\u043E \u043A\u0440\u0430\u0449\u0435 \u0436\u0438\u0442\u0438.
      \u041A\u043E\u043C\u0443\u0441\u044C, \u0445\u0442\u043E \u043D\u0435 \u043B\u0430\u043C\u0430\u0454
      \u0436\u0438\u0442\u0442\u044F \u0456\u043D\u0448\u0438\u043C \u043F\u043E\u043D\u0456.
      \u0410\u0431\u043E \u0437\u0435\u0431\u0440\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823906
    m_Localized: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E \u0442\u0435\u0431\u0435,
      \u043C\u043E\u0436\u0435, \u0456 \u043D\u0435 \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F
      \u043D\u0456\u043A\u043E\u043B\u0438. \u0410\u043B\u0435 \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0442\u0435 \u0441\u0430\u043C\u0435.
      \u0423 \u0446\u044C\u043E\u043C\u0443 \u0432\u0438 \u0437 \u043D\u0435\u044E
      \u0441\u0445\u043E\u0436\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823907
    m_Localized: "\u041F\u0440\u043E \u0420\u043E\u0436\u0435\u0432\u0443 \u0425\u043C\u0430\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823908
    m_Localized: "\u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442! \u041A\u043E\u043B\u0438\u0448\u043D\u044F
      \u0441\u0442\u043E\u043B\u0438\u0446\u044F \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457...
      \u041D\u0430\u043F\u0435\u0432\u043D\u043E, \u043A\u043E\u043B\u0438\u0441\u044C
      \u0446\u0435 \u0431\u0443\u043B\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0435
      \u043C\u0456\u0441\u0442\u043E. \u0429\u043E \u0436 \u0432\u043E\u043D\u0438
      \u0437\u0440\u043E\u0431\u0438\u043B\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823909
    m_Localized: "\u0423 \u0440\u0443\u0457\u043D\u0430\u0445 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430
      \u043D\u0430 \u0432\u0430\u0441 \u0447\u0435\u043A\u0430\u0454 \u0431\u0435\u0437\u043B\u0456\u0447
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A, \u0433\u043E\u043B\u043E\u0432\u043D\u0456
      \u0437 \u044F\u043A\u0438\u0445 - \u0420\u043E\u0436\u0435\u0432\u0430 \u0425\u043C\u0430\u0440\u0430
      \u0456 \u0442\u0435\u043C\u043D\u0430 \u043C\u0430\u0433\u0456\u044F. \u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435,
      \u0449\u043E \u0432\u0456\u0434 \u0442\u0435\u043C\u043D\u043E\u0457 \u043C\u0430\u0433\u0456\u0457
      \u0431\u0440\u043E\u043D\u044F \u043D\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454,
      \u0430 \u0434\u0456\u044E \u0420\u043E\u0436\u0435\u0432\u043E\u0457 \u0425\u043C\u0430\u0440\u0438
      \u043B\u0438\u0448\u0435 \u043F\u043E\u0441\u0438\u043B\u044E\u0454! \u0414\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0456
      \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0438, \u044F\u043A\u0456 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u043B\u0438
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442, \u043D\u0430\u0441\u0442\u0456\u0439\u043D\u043E
      \u0440\u0430\u0434\u044F\u0442\u044C \u043D\u0435 \u043D\u0430\u0434\u044F\u0433\u0430\u0442\u0438
      \u043D\u0456\u044F\u043A\u043E\u0457 \u0431\u0440\u043E\u043D\u0456 \u0437\u043E\u0432\u0441\u0456\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823910
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0447\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823911
    m_Localized: "\u0429\u043E \u0446\u0435... \u0430\u0440\u0433\u0445! \u042F \u0447\u0443\u044E
      \u044F\u043A\u0438\u0439\u0441\u044C \u043D\u0435\u043F\u0440\u0438\u0454\u043C\u043D\u0438\u0439
      \u0437\u0432\u0443\u043A, \u0449\u043E \u0437\u0434\u0430\u0432\u043B\u044E\u0454
      \u0433\u043E\u043B\u043E\u0432\u0443 \u043D\u0435\u043C\u043E\u0432 \u043B\u0435\u0449\u0430\u0442\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823912
    m_Localized: "\u0422\u0430\u043A, \u043E\u0441\u044C \u0432\u0456\u043D, \u0440\u0443\u043F\u043E\u0440
      \u0433\u0443\u0447\u043D\u043E\u043C\u043E\u0432\u0446\u044F, \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0439
      \u0448\u0443\u043C \u0456\u0434\u0435 \u0437 \u043D\u044C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823913
    m_Localized: "\u0411\u043B\u0438\u0436\u0447\u0435 \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u0438
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E. \u0426\u0456\u043A\u0430\u0432\u043E,
      \u0447\u0438 \u0437\u043C\u043E\u0436\u0443 \u044F \u0432\u043B\u0443\u0447\u0438\u0442\u0438
      \u0432 \u043D\u044C\u043E\u0433\u043E \u0437 \u0446\u0456\u0454\u0457 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823914
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0437\u0456 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823915
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043A\u043E.
      \u0413\u0430\u0434\u0430\u044E, \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438
      \u0445\u0442\u043E\u0441\u044C \u0456\u0437 \u043D\u0430\u0441 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u0432
      \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438 \u0440\u043E\u0437\u0443\u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u043D\u0456 \u0432 \u0446\u044C\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823916
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0429\u043E
      \u043C\u043E\u0433\u043B\u043E \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0438\u0441\u044F
      \u0442\u0430\u043A\u0438\u043C, \u044F\u043A \u0432\u0438, \u0443 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823917
    m_Localized: "\u0422\u0430\u043A\u0438\u043C, \u044F\u043A \u043C\u0438? \u0421\u0445\u043E\u0436\u0435,
      \u0442\u0438 \u0432\u0436\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430\u0441\u044F
      \u0437 \u043D\u0430\u0448\u0438\u043C\u0438 \u0442\u043E\u0432\u0430\u0440\u0438\u0448\u0430\u043C\u0438
      \u0440\u0430\u043D\u0456\u0448\u0435, \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823918
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430\u0441\u044F.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u0442\u043E\u0434\u0456 \u043C\u0438
      \u043D\u0435 \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u0457
      \u043C\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823919
    m_Localized: "\u0414\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F,
      \u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u041F\u0430\u043B\u0430\u0434\u0438\u043D\u0435.
      \u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u044F \u043C\u043E\u0436\u0443
      \u0441\u0443\u0434\u0438\u0442\u0438, \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438
      \u0442\u0430 \u043F\u043E\u043D\u0456, \u0449\u043E \u0432\u0431\u0438\u043B\u0430
      \u0420\u0456\u0432\u0435\u043D \u0414\u0430\u0439\u043C\u043E\u043D\u0434 \u0456
      \u0421\u043A\u0430\u0440\u043B\u0435\u0442 \u0420\u043E\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823920
    m_Localized: "\u041D\u0435\u0432\u0436\u0435? \u0426\u0435 \u0442\u0430\u043A,
      \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043A\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823921
    m_Localized: "\u0429\u043E? \u041D\u0456! \u042F \u043D\u0435 \u0446\u0435 \u043C\u0430\u043B\u0430
      \u043D\u0430 \u0443\u0432\u0430\u0437\u0456, \u043A\u043E\u043B\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823922
    m_Localized: "\u042F \u0431\u0430\u0447\u0438\u0432 \u0457\u0457 \u043D\u0430
      \u0437\u0430\u043F\u0438\u0441\u0456 \u043A\u0430\u043C\u0435\u0440\u0438 \u0431\u0440\u043E\u043D\u0456
      \u0421\u043A\u0430\u0440\u043B\u0435\u0442\u0442 \u0420\u043E\u0443\u0437.
      \u041F\u043E\u043C\u0438\u043B\u043A\u0438 \u0431\u0443\u0442\u0438 \u043D\u0435
      \u043C\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823923
    m_Localized: "\u0422\u0456\u043B\u044C\u043A\u0438 \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435!.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823924
    m_Localized: "\u041D\u0435 \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u0439 \u0456\u0437
      \u0432\u0438\u0441\u043D\u043E\u0432\u043A\u0430\u043C\u0438. \u041C\u0438
      \u043D\u0435 \u0432\u043E\u0440\u043E\u0433\u0438 \u0442\u043E\u0431\u0456,
      \u044F\u043A \u0442\u0438 \u043C\u043E\u0433\u043B\u0430 \u0431 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823925
    m_Localized: "\u0423\u0431\u0438\u0442\u0456 \u0442\u043E\u0431\u043E\u044E \u043B\u0438\u0446\u0430\u0440\u0456
      \u0434\u0430\u0432\u043D\u043E \u0431\u0443\u043B\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u044E.
      \u0411\u0430 \u0431\u0456\u043B\u044C\u0448\u0435, \u0432\u043E\u043D\u0438
      \u0431\u0443\u043B\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u043C\u0438
      \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0430\u043C\u0438
      \u043D\u0430\u0448\u043E\u0433\u043E \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0438,
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430. \u042F \u043D\u0435
      \u043C\u043E\u0436\u0443 \u0441\u0445\u0432\u0430\u043B\u0438\u0442\u0438 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E
      \u0447\u043B\u0435\u043D\u0456\u0432 \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0430,
      \u043E\u0434\u043D\u0430\u043A \u0442\u0430\u043A \u0441\u0442\u0430\u043B\u043E\u0441\u044F,
      \u0449\u043E \u0437 \u043E\u0433\u043B\u044F\u0434\u0443 \u043D\u0430... \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u043F\u043E\u0442\u043E\u0447\u043D\u043E\u0457 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u043D\u0430\u0448\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0442\u0432\u043E\u0457
      \u0434\u0456\u0457 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043A\u043E\u0440\u0438\u0441\u0442\u0456, \u043D\u0456\u0436 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823926
    m_Localized: "\u042F \u0431\u0430\u0447\u0443, \u0436\u0438\u0432\u0435\u0442\u0435
      \u0432\u0438 \u0434\u0443\u0436\u0435 \u0434\u0440\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823927
    m_Localized: "\u0411\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E. \u041E\u0434\u043D\u0430\u043A
      \u043C\u0438 \u0442\u0430\u043A \u0456 \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0438\u0441\u044F.
      \u042F\u043A \u0442\u0432\u043E\u0454 \u0456\u043C'\u044F, \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043A\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823928
    m_Localized: "\u041C\u0435\u043D\u0435 \u0437\u0432\u0443\u0442\u044C @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823929
    m_Localized: "\u0420\u0430\u0434\u0438\u0439 \u0437\u043D\u0430\u0439\u043E\u043C\u0441\u0442\u0432\u0443.
      \u041C\u043E\u0454 \u0456\u043C'\u044F \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437,
      \u044F - \u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u041F\u0430\u043B\u0430\u0434\u0438\u043D
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F.
      \u041C\u043E\u0457 \u043F\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0438,
      \u044F\u043A\u0438\u0445 \u0442\u0438 \u0431\u0430\u0447\u0438\u0448 \u043F\u0435\u0440\u0435\u0434
      \u0441\u043E\u0431\u043E\u044E - \u0413\u0440\u0456\u043D \u0412\u0430\u0439\u0437\u0440,
      \u0413\u0440\u0430\u0443\u043D\u0434\u0448\u0438\u0440 \u0456 \u0413\u0440\u0435\u0439\u0442
      \u0413\u0435\u0439\u0434\u0436. \u0422\u0430\u043A \u0441\u0442\u0430\u043B\u043E\u0441\u044F,
      \u0449\u043E \u043D\u0430\u0440\u0430\u0437\u0456 \u044F \u0456 \u043C\u043E\u0457
      \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0438 \u0441\u0435\u0440\u0435\u0434
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u0443... \u0434\u0435\u044F\u043A\u0456\u0439 \u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457
      \u0434\u043E \u0431\u0456\u043B\u044C\u0448\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823930
    m_Localized: "\u041C\u0438 \u043D\u0435 \u0432\u043E\u0440\u043E\u0433\u0443\u0454\u043C\u043E
      \u0443 \u0437\u0432\u0438\u0447\u043D\u043E\u043C\u0443 \u0434\u043B\u044F
      \u0432\u0430\u0441, \u043F\u0440\u043E\u0441\u0442\u0438\u0445 \u043F\u043E\u043D\u0456,
      \u0441\u0435\u043D\u0441\u0456 \u0441\u043B\u043E\u0432\u0430. \u041E\u0434\u043D\u0430\u043A
      \u0456\u0434\u0435\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0456 \u0440\u043E\u0437\u0431\u0456\u0436\u043D\u043E\u0441\u0442\u0456,
      \u043D\u0430 \u0436\u0430\u043B\u044C, \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0430\u044E\u0442\u044C
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u044E \u043D\u0435\u043F\u043E\u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F
      \u0456 \u043A\u043E\u043D\u0444\u0440\u043E\u043D\u0442\u0430\u0446\u0456\u0457.
      \u041D\u0430 \u0434\u0430\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0432\u043E\u0440\u043E\u0433 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      - \u0440\u0430\u0434\u0448\u0435 \u043D\u0430\u0448 \u0434\u0440\u0443\u0433.
      \u042F\u043A\u0449\u043E \u0432\u0456\u043D \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u0434\u043E \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823931
    m_Localized: "\u0426\u0435 \u0434\u0438\u0432\u043B\u044F\u0447\u0438\u0441\u044C
      \u0449\u043E \u043F\u0456\u0434 \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u0435\u044E
      \u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823932
    m_Localized: "\u041F\u043E\u0447\u043D\u0435\u043C\u043E \u0437 \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0442\u043E\u0431\u0456 \u043C\u043E\u0433\u043B\u043E \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0438\u0441\u044F
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u043C\u0456\u0441\u0442\u0456. \u042F
      \u043D\u0435 \u0432\u043F\u0435\u0440\u0448\u0435 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u044E
      \u0446\u0435 \u043C\u0456\u0441\u0446\u0435, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u044F \u0437\u043C\u043E\u0436\u0443 \u043F\u043E\u043B\u0435\u0433\u0448\u0438\u0442\u0438
      \u0442\u0432\u043E\u0457 \u043F\u043E\u0448\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823933
    m_Localized: "\u042F\u043A\u0449\u043E \u0442\u0443\u0442 \u043D\u0435\u043C\u0430\u0454
      \u043E\u0431\u043C\u0430\u043D\u0443, \u0442\u043E \u0446\u0435 \u0431\u0443\u043B\u043E
      \u0431 \u0434\u0443\u0436\u0435 \u043C\u0438\u043B\u043E \u0437 \u0432\u0430\u0448\u043E\u0433\u043E
      \u0431\u043E\u043A\u0443. \u041C\u0435\u043D\u0456 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F
      \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E \u043E\u0444\u0456\u0441\u0443
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0421\u0442\u0438\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823934
    m_Localized: "\u0406\u0437 \u0446\u0438\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C
      \u043D\u0435 \u0431\u0443\u0434\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u0441\u0443\u0432\u0430\u0439\u0441\u044F \u0432\u043F\u0435\u0440\u0435\u0434
      \u0446\u0456\u0454\u044E \u0432\u0443\u043B\u0438\u0446\u0435\u044E, \u043F\u043E\u0442\u0456\u043C
      \u043D\u0430 \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u043F\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u0442\u0456
      \u0437\u0432\u0435\u0440\u043D\u0438 \u043B\u0456\u0432\u043E\u0440\u0443\u0447,
      \u0456 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0438
      \u0442\u0438 \u0432\u0438\u0439\u0434\u0435\u0448 \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u043C\u0456\u0441\u044C\u043A\u0438\u0439 \u043F\u0440\u043E\u0441\u043F\u0435\u043A\u0442.
      \u0419\u0434\u0438 \u043D\u0438\u043C, \u0456 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u0442\u0438 \u0434\u043E\u0441\u044F\u0433\u043D\u0435\u0448
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u044C\u043A\u043E\u0457
      \u0410\u043B\u0435\u0457. \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0421\u0442\u0438\u043B\u044E \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823935
    m_Localized: "\u0414\u044F\u043A\u0443\u044E \u0437\u0430 \u043D\u0430\u0432\u043E\u0434\u043A\u0443.
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0432\u043E\u043D\u0430
      \u043C\u0435\u043D\u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823936
    m_Localized: "\u041C\u0438 \u0456\u0437 \u0437\u0430\u0433\u043E\u043D\u043E\u043C
      \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454\u043C\u043E\u0441\u044F
      \u0432 \u043D\u0430\u0448 \u0442\u0430\u0431\u0456\u0440 \u043F\u0456\u0441\u043B\u044F
      \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457 \u0432\u0438\u043B\u0430\u0437\u043A\u0438.
      \u042F\u043A\u0449\u043E \u0442\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448
      \u0440\u043E\u0437\u0432\u0438\u043D\u0443\u0442\u0438 \u043D\u0430\u0448\u0443
      \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u044E, \u043C\u043E\u0436\u0435\u0448
      \u0437\u0430\u0441\u043A\u043E\u0447\u0438\u0442\u0438 \u043D\u0430 \u0432\u043E\u0433\u043D\u0438\u043A.
      \u041D\u0430\u0440\u0430\u0437\u0456 \u043C\u0438 \u0431\u0430\u0437\u0443\u0454\u043C\u043E\u0441\u044F
      \u0432 \u0441\u0442\u0430\u0440\u0456\u0439 \u0432\u043E\u0434\u043E\u043E\u0447\u0438\u0441\u043D\u0456\u0439
      \u0441\u0442\u0430\u043D\u0446\u0456\u0457 \u043D\u0430 \u043F\u0456\u0432\u0434\u0435\u043D\u044C
      \u0432\u0456\u0434 \u043C\u0456\u0441\u0442\u0430, \u043F'\u044F\u0442\u044C
      \u043C\u0438\u043B\u044C \u043F\u0456\u0448\u043A\u0438 \u043F\u043E \u043F\u043E\u043D\u0456\u0432\u0456\u043B\u043B\u044C\u0441\u044C\u043A\u0456\u0439
      \u0437\u0430\u043B\u0456\u0437\u043D\u0438\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823937
    m_Localized: "\u042F\u043A\u0449\u043E \u0431\u0443\u0434\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C,
      \u044F \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u044E \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823938
    m_Localized: "\u0417\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823939
    m_Localized: "\u041F\u0440\u043E\u0442\u0435, \u0437\u0430\u0440\u0430\u0434\u0438
      \u0447\u043E\u0433\u043E \u0432\u0438 \u0442\u0443\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823940
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442\u0443 \u043D\u0435\u043C\u0430\u0454
      - \u043C\u0438 \u0442\u0443\u0442 \u0437\u0430\u0440\u0430\u0434\u0438 \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u044C,
      \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F \u0441\u0445\u043E\u0432\u0430\u043D\u0456
      \u0425\u043C\u0430\u0440\u043E\u044E \u0432 \u0446\u044C\u043E\u043C\u0443
      \u043C\u0456\u0441\u0442\u0456 \u043F\u0456\u0441\u043B\u044F \u0412\u0456\u0439\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823941
    m_Localized: "\u0414\u043E \u041E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u0414\u043D\u044F \u0432 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457
      \u0431\u0443\u0440\u0445\u043B\u0438\u0432\u043E \u0440\u043E\u0437\u0432\u0438\u0432\u0430\u043B\u0438\u0441\u044F
      \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u0456 \u043D\u0430\u0443\u043A\u043E\u0432\u043E-\u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u0456
      \u043F\u0440\u043E\u0454\u043A\u0442\u0438. \u0412\u043E\u043D\u0438 \u0431\u0443\u043B\u0438
      \u0440\u043E\u0437\u0434\u0456\u043B\u0435\u043D\u0456 \u043C\u0456\u0436 \u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
      \u0432\u0435\u043B\u0438\u043A\u0438\u043C\u0438 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F\u043C\u0438.
      \u041E\u0434\u043D\u0456\u0454\u044E \u0437 \u0442\u0430\u043A\u0438\u0445
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0439 \u0431\u0443\u043B\u0430
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u044F \"\u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A\",
      \u044F\u043A\u0430 \u043F\u0435\u0440\u0435\u0434\u0443\u0441\u0456\u043C \u0437\u0430\u0439\u043C\u0430\u043B\u0430\u0441\u044F
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F\u043C \u0421\u0442\u0456\u0439\u043B
      - \u043C\u0456\u0441\u0442\u043A\u0438\u0445 \u0456 \u0447\u0443\u0434\u043E\u0432\u043E
      \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u0445 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0445
      \u0441\u0445\u043E\u0432\u0438\u0449, \u0449\u043E \u043C\u0430\u043B\u0438
      \u043D\u0430 \u043C\u0435\u0442\u0456 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F \u043F\u043E\u043D\u0456 \u0432 \u0440\u0430\u0437\u0456
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C.
      \u041E\u0434\u043D\u0430\u043A \u0443 \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A
      \u0442\u0430\u043A\u043E\u0436 \u0437\u0430\u0439\u043C\u0430\u043B\u0438\u0441\u044F
      \u043D\u0430\u0443\u043A\u043E\u0432\u043E\u044E \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044E,
      \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u043E\u044E
      \u0437 \u0436\u0438\u0442\u0442\u044F\u043C \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E.
      \u041E\u0434\u043D\u0438\u043C \u0456\u0437 \u0442\u0430\u043A\u0438\u0445
      \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432 \u0431\u0443\u043B\u043E \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E\u043C\u0438\u0441\u043B\u043E\u0432\u0438\u0445 \u0433\u0456\u0434\u0440\u043E\u043F\u043E\u043D\u043D\u0438\u0445
      \u0444\u0435\u0440\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823942
    m_Localized: "\u041F\u043E\u0434\u0456\u0431\u043D\u0456 \u0444\u0435\u0440\u043C\u0438
      \u0434\u0430\u043B\u0438 \u0431 \u0437\u043C\u043E\u0433\u0443 \u0432\u0438\u0440\u043E\u0449\u0443\u0432\u0430\u0442\u0438
      \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456 \u0440\u043E\u0441\u043B\u0438\u043D\u043D\u0456
      \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0438 \u0431\u0435\u0437 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E\u0441\u0442\u0456
      \u0432 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u043E\u043C\u0443 \u0491\u0440\u0443\u043D\u0442\u043E\u0432\u043E\u043C\u0443
      \u043F\u043E\u043A\u0440\u0438\u0432\u0456 \u0442\u0430 \u0441\u043E\u043D\u044F\u0447\u043D\u043E\u043C\u0443
      \u0441\u0432\u0456\u0442\u043B\u0456. \u0426\u044F \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0430
      \u0431\u0443\u043B\u0430 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u043E\u044E
      \u0437\u0430 \u0448\u0442\u0443\u0447\u043D\u0456 \u0441\u0430\u0434\u0438,
      \u044F\u043A\u0456 \u0431\u0443\u043B\u043E \u0432\u043F\u0440\u043E\u0432\u0430\u0434\u0436\u0435\u043D\u043E
      \u0432 \u0431\u0456\u043B\u044C\u0448\u043E\u0441\u0442\u0456 \u0421\u0442\u0456\u0439\u043B
      \u044F\u043A \u043E\u0441\u043D\u043E\u0432\u043D\u0435 \u0434\u0436\u0435\u0440\u0435\u043B\u043E
      \u0457\u0436\u0456, \u043F\u0440\u043E\u0442\u0435 \u043F\u0440\u043E\u043C\u0438\u0441\u043B\u043E\u0432\u0456
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0435
      \u0431\u0443\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823943
    m_Localized: "\u041C\u0438 \u0434\u0456\u0437\u043D\u0430\u043B\u0438\u0441\u044F
      \u043F\u0440\u043E \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0442\u0430\u043A\u043E\u0433\u043E
      \u043F\u0440\u043E\u0454\u043A\u0442\u0443 \u0437 \u043B\u043E\u0433\u0456\u0432
      \u043A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440\u0456\u0432 \u0432 \u0456\u043D\u0448\u0438\u0445
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F\u0445 \"\u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A\",
      \u043E\u0434\u043D\u0430\u043A \u0446\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438
      \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u043B\u0438 \u0443 \u0432\u0456\u0434\u043E\u043C\u0441\u0442\u0432\u0456
      \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u0457,
      \u0442\u043E\u0436 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456 \u0434\u0430\u043D\u0456
      \u043F\u0440\u043E \u0444\u0435\u0440\u043C\u0438 \u0442\u0430 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0438
      \u043C\u0456\u0441\u0446\u044F \u0457\u0445\u043D\u0456\u0445 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u044C
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u044F\u0432\u0438\u0442\u0438 \u043B\u0438\u0448\u0435
      \u0432 \u043D\u044C\u043E\u043C\u0443. \u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E,
      \u043C\u0438 \u0440\u043E\u0437\u043F\u043E\u0447\u0430\u043B\u0438 \u043F\u043E\u0448\u0443\u043A\u0438
      \u0446\u044C\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u043C\u043E\u0457 \u0437\u043D\u0430\u043D\u043D\u044F
      \u043F\u0440\u043E \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F
      \u043C\u0456\u0441\u0442\u0430 \u043D\u0435 \u043E\u0445\u043E\u043F\u043B\u044E\u044E\u0442\u044C
      \u043E\u0431'\u0454\u043A\u0442\u0438, \u044F\u043A\u0456 \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u044C
      \u0434\u043E \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u0457 \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A.
      \u0422\u043E\u043C\u0443 \u043C\u0438 \u0437\u043C\u0443\u0448\u0435\u043D\u0456
      \u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0448\u0443\u043A\u0438 \u043D\u0430\u043E\u0441\u043B\u0456\u043F.
      \u041F\u043E\u043A\u0438 \u0449\u043E \u0431\u0435\u0437\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823944
    m_Localized: "\u042F \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u044E
      \u043D\u0430 \u0442\u0435, \u0449\u043E \u044F\u043A\u0449\u043E \u0442\u0438
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0432\u043E\u0454\u0457 \u0432\u0438\u043B\u0430\u0437\u043A\u0438
      \u0432\u0438\u044F\u0432\u0438\u0448 \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0435
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \"\u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A\",
      \u0442\u0438 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0448 \u043D\u0430\u043C
      \u043F\u0440\u043E \u0439\u043E\u0433\u043E \u043C\u0456\u0441\u0446\u0435\u0437\u043D\u0430\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F.
      \u0422\u0430\u043A\u0438\u0439 \u0436\u0435\u0441\u0442 \u0431\u0443\u0432
      \u0431\u0438 \u0447\u0443\u0434\u043E\u0432\u0438\u043C \u043A\u0440\u043E\u043A\u043E\u043C
      \u0434\u043B\u044F \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u0456
      \u0437 \u0442\u0432\u043E\u0433\u043E \u0431\u043E\u043A\u0443."
