      m_Items: []
  - m_Id: 2729435311
    m_Localized: "\u0415\u043A\u0441\u0442\u0440\u0430\u043A\u0442 \u043F\u043E\u0440\u0447\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435312
    m_Localized: "\u0421\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0456\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0433\u043E
      \u043F\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F. \u041F\u0456\u0434
      \u0447\u0430\u0441 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443 \u0437
      \u0436\u0438\u0432\u0438\u043C\u0438 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0430\u043C\u0438
      \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0454 \u0432 \u043D\u0438\u0445
      \u0436\u0430\u0445\u043B\u0438\u0432\u0456 \u043C\u0443\u0442\u0430\u0446\u0456\u0457,
      \u0430\u043B\u0435 \u0432 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u043D\u0438\u0445 \u0434\u043E\u0437\u0430\u0445
      \u0456 \u0432 \u043A\u043E\u043C\u0431\u0456\u043D\u0430\u0446\u0456\u0457
      \u0437 \u0456\u043D\u0448\u0438\u043C\u0438 \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430\u043C\u0438
      \u043C\u043E\u0436\u0435 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
      \u0439 \u0441\u043F\u0440\u0438\u044F\u0442\u043B\u0438\u0432\u0456 \u0437\u043C\u0456\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435313
    m_Localized: "\u041A\u0440\u043E\u0432 \u0433\u0456\u0434\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435314
    m_Localized: "\u041D\u0430\u0439\u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0439
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0440\u0435\u0430\u0433\u0435\u043D\u0442.
      \u0417\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u0442\u0438 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0438\u0439
      \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435315
    m_Localized: "\u0420\u0456\u0434\u043A\u0430 \u0432\u0435\u0441\u0435\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435316
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0432\u0430 \u0440\u0456\u0434\u0438\u043D\u0430,
      \u0449\u043E \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0441\u0456\u043C\u0430 \u043A\u043E\u043B\u044C\u043E\u0440\u0430\u043C\u0438
      \u0432\u0435\u0441\u0435\u043B\u043A\u0438 (\u0430 \u043E\u0441\u044C \u043D\u0430
      \u0441\u043C\u0430\u043A \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0433\u0456\u0440\u0448\u0430).
      \u041C\u0430\u0454 \u0432\u0438\u0440\u0430\u0436\u0435\u043D\u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435317
    m_Localized: "\u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u043F\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435318
    m_Localized: "\u0406\u0441\u043A\u0440\u0438\u0441\u0442\u0438\u0439 \u0441\u0440\u0456\u0431\u043B\u044F\u0441\u0442\u0438\u0439
      \u043F\u0438\u043B, \u044F\u043A\u0438\u0439 \u0456\u043D\u043E\u0434\u0456
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0432
      \u043C\u0456\u0441\u0446\u044F\u0445 \u043F\u0430\u0434\u0456\u043D\u043D\u044F
      \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435319
    m_Localized: "\u041C\u0456\u0441\u044F\u0447\u043D\u0438\u0439 \u043A\u0430\u043C\u0456\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435320
    m_Localized: "\u0420\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439 \u043D\u0430\u043F\u0456\u0432\u043F\u0440\u043E\u0437\u043E\u0440\u0438\u0439
      \u043C\u0456\u043D\u0435\u0440\u0430\u043B \u0431\u0456\u043B\u043E-\u0431\u043B\u0430\u043A\u0438\u0442\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443. \u0417\u0433\u0456\u0434\u043D\u043E
      \u0437 \u043F\u043E\u0432\u0456\u0440'\u044F\u043C\u0438, \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0438\u0439
      \u0456\u0437 \u0434\u0440\u0435\u0432\u043D\u0456\u043C\u0438 \u043C\u0456\u0441\u0442\u0438\u0447\u043D\u0438\u043C\u0438
      \u0441\u0438\u043B\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435321
    m_Localized: "\u0422\u0430\u0454\u043C\u043D\u0430 \u0435\u0441\u0435\u043D\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435322
    m_Localized: "\u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043D\u0456\u0445\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0454, \u0449\u043E \u0446\u0435 \u0442\u0430\u043A\u0435,
      \u0430\u043B\u0435 \u0436\u043E\u0434\u043D\u0435 \u043F\u043E-\u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u043C\u0443
      \u043C\u043E\u0433\u0443\u0442\u043D\u0454 \u0437\u0456\u043B\u043B\u044F \u0431\u0435\u0437
      \u043D\u044C\u043E\u0433\u043E \u043D\u0435 \u043E\u0431\u0456\u0439\u0434\u0435\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435323
    m_Localized: "\u0412\u043E\u0433\u043D\u044F\u043D\u0438\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435324
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443, \u0449\u043E \u0437\u0430 \u0444\u043E\u0440\u043C\u043E\u044E
      \u043D\u0430\u0433\u0430\u0434\u0443\u0454 \u044F\u0437\u0438\u043A \u043F\u043E\u043B\u0443\u043C'\u044F.
      \u0406 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430 \u0434\u043E\u0442\u0438\u043A
      \u0442\u0435\u043F\u043B\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435325
    m_Localized: "\u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0430 \u0441\u0456\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435326
    m_Localized: "\u0414\u0443\u0436\u0435 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u0430\u043B\u0445\u0456\u043C\u0456\u0447\u043D\u0438\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442.
      \u0420\u043E\u0437\u0447\u0438\u043D\u044F\u0454\u0442\u044C\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u043C\u0443 \u0440\u043E\u0437\u0447\u0438\u043D\u043D\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435327
    m_Localized: "\u0422\u0435\u043C\u043D\u0438\u0439 \u043E\u0441\u043A\u043E\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435328
    m_Localized: "\u0421\u0443\u0434\u044F\u0447\u0438 \u0437 \u0443\u0441\u044C\u043E\u0433\u043E,
      \u0446\u0435 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u0430
      \u0442\u0435\u043C\u043D\u0430 \u043C\u0430\u0433\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435329
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435330
    m_Localized: "\u041A\u0456\u0433\u043E\u0442\u044C \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0433\u043E\u043D\u0447\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435331
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0434\u043E\u0432\u0433\u0438\u0439
      \u0456 \u0433\u043E\u0441\u0442\u0440\u0438\u0439 \u043A\u0456\u0433\u043E\u0442\u044C,
      \u0449\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u0432\u0435\u043B\u0438\u043A\u043E\u043C\u0443
      \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u043E\u043C\u0443 \u0433\u043E\u043D\u0447\u0430\u043A\u0443.
      \u0417 \u043D\u044C\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0437\u0431\u0440\u043E\u044E \u0430\u0431\u043E \u0432\u0438\u0433\u0456\u0434\u043D\u043E
      \u043F\u0440\u043E\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435332
    m_Localized: "\u041F\u0456\u0434\u0441\u0443\u043C\u043E\u043A \u0434\u043B\u044F
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435333
    m_Localized: "\u041F\u0456\u0434\u0441\u0443\u043C\u043E\u043A \u0456\u0437 \u0442\u043E\u0432\u0441\u0442\u043E\u0433\u043E
      \u0431\u0440\u0435\u0437\u0435\u043D\u0442\u0443 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0457
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457 \u0411\u0440\u0430\u0441\u0441\u0430
      \u0411\u0430\u043A\u0448\u043E\u0442\u0430. \u0417 \u043D\u0438\u043C \u0432\u0438
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0435\u0441\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0430\u0431\u043E\u0457\u0432, \u0431\u0430\u0442\u0430\u0440\u0435\u0439
      \u0430\u0431\u043E \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438,
      \u0431\u0435\u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043D\u044F \u0440\u0443\u0445\u043B\u0438\u0432\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435334
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u043F\u0456\u0434\u0441\u0443\u043C\u043E\u043A
      \u0434\u043B\u044F \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435335
    m_Localized: "\u041F\u0456\u0434\u0441\u0443\u043C\u043E\u043A \u0437 \u043C\u0456\u0446\u043D\u043E\u0457
      \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u043D\u043E\u0457 \u0442\u043A\u0430\u043D\u0438\u043D\u0438,
      \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u0443\u043C\u0456\u043B\u044C\u0446\u044F\u043C\u0438
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432.
      \u0417 \u043D\u0438\u043C \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0435\u0441\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u0430\u0442\u0440\u043E\u043D\u0456\u0432,
      \u0431\u0430\u0442\u0430\u0440\u0435\u0439 \u0430\u0431\u043E \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438,
      \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E\u0447\u0438 \u0436\u043E\u0434\u043D\u0438\u0445
      \u043D\u0435\u0437\u0440\u0443\u0447\u043D\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435336
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u043D\u044F
      \u0441\u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435337
    m_Localized: "\u041D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u0435\u043B\u0456\u043A\u0441\u0438\u0440, \u0440\u0435\u0446\u0435\u043F\u0442
      \u044F\u043A\u043E\u0433\u043E, \u0441\u0445\u043E\u0436\u0435, \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438
      \u0437\u0430\u0433\u0443\u0431\u043B\u0435\u043D\u0438\u0439. \u041F\u043E\u043A\u0440\u0430\u0449\u0443\u0454
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0442\u0430\u043B\u0430\u043D\u0442
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430 \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u0449\u043E\u0431 \u0432\u0456\u043D \u043C\u0456\u0433
      \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E \u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0432 \u043F\u0430\u043C'\u044F\u0442\u0456 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C. \u0415\u0444\u0435\u043A\u0442
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435338
    m_Localized: "\u0413\u0430\u0440\u043C\u043E\u043D\u0456\u0439\u043D\u0438\u0439
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435339
    m_Localized: "\u0411\u043B\u0430\u043A\u0438\u0442\u043D\u0438\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B
      \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0457 \u0444\u043E\u0440\u043C\u0438.
      \u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F \u0430\u0431\u043E
      \u0441\u0444\u0435\u0440\u0430 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435340
    m_Localized: "\u041C\u0430\u0433\u043D\u0456\u0442\u043D\u043E-\u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u043D\u0438\u0439
      \u0445\u0440\u0456\u043D\u043E\u043B\u044F\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435341
    m_Localized: "\u0425\u0440\u0456\u043D\u043E\u043B\u044F\u0446\u0456\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0430\u0433\u043D\u0456\u0442\u043D\u043E\u0433\u043E
      \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u0443 - \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0431\u0443\u0442\u0438 \u0432\u0447\u0435\u043D\u0438\u043C, \u0449\u043E\u0431
      \u0442\u0430\u043A\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435342
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430-\u043A\u0432\u0430\u0434\u0440\u043E\u043F\u0443\u043F\u0456\u043D\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435343
    m_Localized: "\u041D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u043A\u0432\u0430\u0434\u0440\u043E\u043F\u0443\u043F\u0456\u043D\u0441.
      \u0426\u0435, \u043C\u043E\u0436\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u043F\u0440\u043E\u0440\u0438\u0432
      \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u043A\u0432\u0430\u0434\u0440\u043E\u043F\u0443\u043F\u0456\u043D\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435344
    m_Localized: "\u0411\u0430\u0440\u0456\u043E\u043D\u043D\u0438\u0439 \u0434\u0435\u0444\u0443\u0440\u043A\u0443\u043B\u044F\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435345
    m_Localized: "\u0414\u0435\u0444\u0443\u0440\u043A\u0443\u043B\u044E\u0454 \u0449\u043E
      \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E \u0456 \u044F\u043A \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E
      - \u0443 \u0446\u044C\u043E\u0433\u043E \u043F\u0440\u0438\u043B\u0430\u0434\u0443
      \u0434\u0443\u0436\u0435 \u0448\u0438\u0440\u043E\u043A\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437 \u0430\u043D\u0430\u043B\u043E\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435346
    m_Localized: "\u0421\u0443\u043F\u0435\u0440\u043B\u044E\u043C\u0456\u043D\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u0438\u0439
      \u043A\u0432\u0430\u0437\u0456\u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0442\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435347
    m_Localized: "\u041C\u043E\u0436\u0435 \u0441\u0432\u0456\u0442\u0438\u0442\u0438\u0441\u044F
      \u0440\u0456\u0437\u043D\u0438\u043C\u0438 \u043A\u043E\u043B\u044C\u043E\u0440\u0430\u043C\u0438,
      \u0430 \u043C\u043E\u0436\u0435 \u0432\u0438\u043F\u0440\u044F\u043C\u043B\u044F\u0442\u0438
      \u0435\u043B\u0435\u043A\u0442\u0438\u0447\u043D\u0438\u0439 \u0441\u0442\u0440\u0443\u043C,
      \u0437\u0430\u043B\u0435\u0436\u043D\u043E \u0432\u0456\u0434 \u0441\u0442\u0430\u043D\u0443
      \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435348
    m_Localized: "\u0413\u0456\u043F\u0435\u0440\u043F\u0440\u043E\u043C\u0435\u043D\u0435\u0432\u0438\u0439
      \u0442\u0440\u0430\u043D\u0441\u043A\u043B\u044E\u043A\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435349
    m_Localized: "\u041F\u0456\u0434 \u0447\u0430\u0441 \u0440\u043E\u0431\u043E\u0442\u0438
      \u0437 \u0446\u0438\u043C \u043F\u0440\u0438\u043B\u0430\u0434\u043E\u043C
      \u043D\u0430\u0439\u0433\u043E\u043B\u043E\u0432\u043D\u0456\u0448\u0435 -
      \u0446\u0435 \u0437\u043D\u0430\u0442\u0438, \u0449\u043E \u043A\u0443\u0434\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0441\u0442\u0440\u043E\u043C\u0438\u0442\u0438.
      \u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0432\u0441\u0442\u0440\u043E\u043C\u043B\u044F\u043D\u043D\u044F
      \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0454 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435350
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435351
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0434\u043B\u044F \u043F\u0435\u0433\u0430\u0441\u0456\u0432. \u0412\u0438
      \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0457\u0457 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
      \u0432\u0434\u044F\u0433\u043D\u0443\u0442\u0438 \u0431\u0435\u0437 \u0434\u0435\u044F\u043A\u0438\u0445
      \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435352
    m_Localized: "\u0421\u043B\u043E\u0432\u043D\u0438\u043A \u043B\u0430\u0439\u043B\u0438\u0432\u0438\u0445
      \u0432\u0438\u0440\u0430\u0437\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435353
    m_Localized: "\u0428\u0430\u043D\u043E\u0432\u043D\u0438\u0439 \u0447\u0438\u0442\u0430\u0447\u0443!
      \u042F\u043A\u0449\u043E \u0412\u0438 \u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u0443 \u0441\u0432\u043E\u0457\u0445 \u043A\u043E\u043F\u0438\u0442\u0430\u0445
      \u0446\u044E \u0437\u0431\u0456\u0440\u043A\u0443, \u0437\u043D\u0430\u0447\u0438\u0442\u044C,
      \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0412\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0438 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u043F\u0435\u0440\u0448\u0438\u0439 \u043A\u0440\u043E\u043A \u0432 \u043E\u0441\u0432\u043E\u0454\u043D\u043D\u0456
      \u0442\u043E\u043D\u043A\u043E\u0433\u043E \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u0430
      \u043D\u0435\u0446\u0435\u043D\u0437\u0443\u0440\u043D\u043E\u0457 \u043B\u0430\u0439\u043A\u0438.
      \u0423\u043C\u0456\u043D\u043D\u044F \u043C\u0456\u0446\u043D\u043E \u0439
      \u0432\u0438\u0442\u0456\u044E\u0432\u0430\u0442\u043E \u043B\u0430\u044F\u0442\u0438\u0441\u044F
      - \u0446\u0435 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0432\u0430\u0436\u043B\u0438\u0432\u0430
      \u0439 \u043D\u0435\u0432\u0456\u0434'\u0454\u043C\u043D\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430
      \u0440\u043E\u0437\u0443\u043C\u043D\u043E\u0433\u043E \u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F,
      \u0456 \u043D\u0456\u0447\u043E\u0433\u043E \u0433\u0430\u043D\u0435\u0431\u043D\u043E\u0433\u043E
      \u0432 \u0439\u043E\u0433\u043E \u0434\u043E\u0440\u0435\u0447\u043D\u043E\u043C\u0443
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u0456 \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435\u043C\u0430\u0454. \u0423 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0432\u0438\u043F\u0430\u0434\u043A\u0430\u0445 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E
      \u0434\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F \u0434\u043E \u0441\u0432\u043E\u0457\u0445
      \u043F\u0440\u043E\u043C\u043E\u0432 \u0431\u0440\u0443\u0434\u043D\u043E\u0433\u043E
      \u0441\u043B\u0456\u0432\u0446\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E,
      \u0449\u043E\u0431 \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u0432\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0456 \u043F\u043E\u0432\u043D\u043E\u044E \u043C\u0456\u0440\u043E\u044E
      \u0432\u0438\u0441\u043B\u043E\u0432\u0438\u0442\u0438 \u0441\u0432\u043E\u0457
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F, \u0456 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0445\u0442\u043E \u0432\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u044E\u0454
      \u0441\u0432\u043E\u0454 \u0432\u043C\u0456\u043D\u043D\u044F \u0431\u0430\u0440\u0432\u0438\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u0441\u0432\u043E\u0457 \u0435\u043C\u043E\u0446\u0456\u0457
      \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u0443\u0441\u044C\u043E\u0433\u043E
      \u0436\u0438\u0442\u0442\u044F. \u041D\u0430\u0448 \u0441\u043B\u043E\u0432\u043D\u0438\u043A,
      \u043D\u0430 \u0436\u0430\u043B\u044C, \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0437\u0434\u0430\u0442\u0435\u043D \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436 \u043F\u0456\u0434\u043D\u044F\u0442\u0438 \u0412\u0430\u0441 \u0434\u043E
      \u0440\u0456\u0432\u043D\u044F \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0445
      \u043C\u0430\u0435\u0441\u0442\u0440\u043E \u0446\u044C\u043E\u0433\u043E \u0440\u0435\u043C\u0435\u0441\u043B\u0430,
      \u0430\u0434\u0436\u0435 \u0434\u043B\u044F \u0456\u0441\u0442\u0438\u043D\u043D\u043E
      \u0448\u0435\u0434\u0435\u0432\u0440\u0430\u043B\u044C\u043D\u043E\u0457 \u043B\u0430\u0439\u043A\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u043C\u0456\u0442\u0438
      \u0432\u0438\u0434\u0430\u0432\u0430\u0442\u0438 \u043B\u0430\u0439\u043B\u0438\u0432\u0456
      \u0442\u0438\u0440\u0430\u0434\u0438 \u0456\u043D\u0442\u0443\u0457\u0442\u0438\u0432\u043D\u043E,
      \u0432\u0456\u0434 \u0441\u0430\u043C\u043E\u0457 \u0434\u0443\u0448\u0456.
      \u0410\u043B\u0435 \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0446\u0456\u0439
      \u043A\u043D\u0438\u0436\u0446\u0456 \u0412\u0438 \u0442\u043E\u0447\u043D\u043E
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0438\u0439 \u043E\u0440\u0456\u0454\u043D\u0442\u0438\u0440,
      \u044F\u043A\u0438\u0439 \u0441\u043F\u0440\u044F\u043C\u0443\u0454 \u0412\u0430\u0441
      \u0443 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u043E\u043C\u0443 \u0432\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0435\u043D\u043D\u0456
      \u0412\u0430\u0448\u0438\u0445 \u0442\u0430\u043B\u0430\u043D\u0442\u0456\u0432
      \u043D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0442\u0435\u0440\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435354
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435355
    m_Localized: "\u041D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0447\u0430\u0441
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0454 \u0432\u0430\u0441
      \u043D\u0430 \u0434\u0440\u0456\u0431\u043D\u0435 \u0437\u0432\u0456\u0440\u044F\u0442\u043A\u043E.
      \u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u043E\u0442\u0443\u0436\u043D\u0435, \u0449\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0439 \u043D\u0430\u0439\u043C\u0435\u043D\u0448\u043E\u0433\u043E \u043A\u043E\u0432\u0442\u043A\u0430,
      \u0442\u043E\u043C\u0443 \u0439\u043E\u0433\u043E \u043C\u0430\u0454 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u0438
      \u043D\u0430 \u0431\u0435\u0437\u043B\u0456\u0447 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435356
    m_Localized: "\u042F\u0449\u0438\u043A"
    m_Metadata:
