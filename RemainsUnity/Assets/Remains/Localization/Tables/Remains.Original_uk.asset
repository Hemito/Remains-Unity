    m_Localized: "\u0414\u0443\u0436\u0435 \u0446\u0456\u043D\u043D\u0438\u0439 \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824913
    m_Localized: "\u0413\u0435\u0439, \u043F\u0441\u0441\u0441. \u041F\u0456\u0434\u0456\u0439\u0434\u0438
      \u043D\u0430 \u043F\u0430\u0440\u0443 \u0441\u043B\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824914
    m_Localized: "\u0427\u043E\u0433\u043E \u0442\u043E\u0431\u0456? \u041D\u0430\u0447\u0435\u0431\u0442\u043E
      \u0442\u0438 \u0440\u0430\u043D\u0456\u0448\u0435 \u043D\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043F\u0440\u0430\u0433\u043D\u0443\u0432 \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824915
    m_Localized: "\u041D\u0443, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435
      \u0431\u0443\u0432 \u0443\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439,
      \u0447\u0438 \u043C\u043E\u0436\u043D\u0430 \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0456\u0440\u044F\u0442\u0438.
      \u0410\u043B\u0435 \u0442\u0435\u043F\u0435\u0440 \u0431\u0430\u0447\u0443,
      \u0449\u043E \u0442\u0438 \u0441\u0432\u043E\u044F \u043F\u043E\u043D\u0456,
      \u0456 \u0442\u043E\u043C\u0443 \u044F \u043C\u043E\u0436\u0443 \u0442\u043E\u0431\u0456
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u0438\u0439
      \u0441\u0435\u043A\u0440\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824916
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u0448\u0435, \u0443 \u043C\u0435\u043D\u0435
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u0434\u0435\u0449\u043E \u0454.
      \u041A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824917
    m_Localized: "\u041A\u043B\u044E\u0447? \u0410\u043B\u0435 \u0432\u0456\u0434
      \u0447\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824918
    m_Localized: "\u0412\u0456\u0434 \u043E\u0434\u043D\u043E\u0433\u043E \u0437
      \u043F\u0456\u0434\u0432\u0430\u043B\u0456\u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430.
      \u042F \u0442\u043E\u0447\u043D\u043E \u0437\u043D\u0430\u044E, \u0449\u043E
      \u0442\u0430\u043C \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0435 \u0449\u043E\u0441\u044C
      \u0434\u0443\u0436\u0435 \u0446\u0456\u043D\u043D\u0435. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0456\u0442\u0438 \u0439 \u0437\u0430\u0431\u0440\u0430\u0442\u0438
      \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824919
    m_Localized: "\u041E\u0442 \u044F\u043A? \u0406 \u0447\u043E\u043C\u0443 \u0436
      \u0442\u0438 \u0441\u0430\u043C \u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u0432
      \u0456 \u043D\u0435 \u0437\u0430\u0431\u0440\u0430\u0432 \u0446\u044E \u0446\u0456\u043D\u043D\u0443
      \u0440\u0456\u0447?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824920
    m_Localized: "\u0410 \u0442\u0438 \u044F\u043A \u0434\u0443\u043C\u0430\u0454\u0448?
      \u041C\u0435\u043D\u0456 \u043C\u043E\u0454 \u0436\u0438\u0442\u0442\u044F
      \u0434\u043E\u0440\u043E\u0433\u0435 \u044F\u043A \u043F\u0430\u043C'\u044F\u0442\u044C,
      \u044F \u0449\u0435 \u043D\u0435 \u0437'\u0457\u0445\u0430\u0432 \u0437 \u0433\u043B\u0443\u0437\u0434\u0443,
      \u0449\u043E\u0431 \u0441\u0443\u043D\u0443\u0442\u0438\u0441\u044F \u0432
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824921
    m_Localized: "\u0410 \u044F, \u0437\u043D\u0430\u0447\u0438\u0442\u044C, \u043F\u043E-\u0442\u0432\u043E\u0454\u043C\u0443,
      \u0442\u0443\u0434\u0438 \u0441\u0443\u043D\u0443\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824922
    m_Localized: "\u041E \u0442\u0430\u043A, \u0442\u0438 - \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E
      \u0441\u0443\u043D\u0435\u0448\u0441\u044F. \u041A\u0443\u0434\u0438 \u0442\u0438
      \u043F\u043E\u0434\u0456\u043D\u0435\u0448\u0441\u044F? \u0422\u043E\u0436
      \u0434\u0430\u0432\u0430\u0439 \u0442\u0430\u043A: \u044F \u0442\u043E\u0431\u0456
      \u043F\u0440\u043E\u0434\u0430\u043C \u0446\u0435\u0439 \u043A\u043B\u044E\u0447,
      \u0430 \u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0448 \u0442\u043E\u0439
      \u043F\u0456\u0434\u0432\u0430\u043B, \u0437\u0430\u0431\u0435\u0440\u0435\u0448
      \u0456\u0437 \u043D\u044C\u043E\u0433\u043E \u0432\u0441\u0456 \u0446\u0456\u043D\u043D\u043E\u0441\u0442\u0456
      \u0439 \u0437\u0430\u043B\u0438\u0448\u0438\u0448 \u0457\u0445 \u0441\u043E\u0431\u0456.
      \u041D\u0443 \u044F\u043A, \u0439\u0434\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824923
    m_Localized: "\u041D\u0456\u0444\u0456\u0433\u0430! \u041E\u0441\u043B\u0443
      \u0436 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E, \u0449\u043E
      \u0442\u0438 \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0448\u0441\u044F \u043C\u0435\u043D\u0435
      \u043D\u0430\u0434\u0443\u0440\u0438\u0442\u0438! \u0422\u0438 \u0449\u043E,
      \u0434\u0443\u043C\u0430\u0454\u0448, \u044F \u0437\u0430\u043F\u043B\u0430\u0447\u0443
      \u0437\u0430 \u0446\u0435\u0439 \u0442\u0432\u0456\u0439 \u043A\u043B\u044E\u0447
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437 \u0446\u0456\u043A\u0430\u0432\u043E\u0441\u0442\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824924
    m_Localized: "\u041D\u0443 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824925
    m_Localized: "\u0420\u0440\u0440\u0440\u0440! \u041D\u0456! \u041C\u0435\u043D\u0456
      \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0446\u0456\u043A\u0430\u0432\u043E, \u0449\u043E \u0432 \u0442\u043E\u043C\u0443
      \u043F\u0456\u0434\u0432\u0430\u043B\u0456, \u0456 \u0447\u0438 \u0456\u0441\u043D\u0443\u0454
      \u0432\u0456\u043D \u0432\u0437\u0430\u0433\u0430\u043B\u0456! \u0422\u043E\u0431\u0456
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824926
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438 \u0449\u043E \u0445\u043E\u0447\u0435\u0448,
      \u0430\u043B\u0435 \u0442\u0432\u043E\u044F \u0446\u0456\u043A\u0430\u0432\u0456\u0441\u0442\u044C
      \u0432\u0456\u0437\u044C\u043C\u0435 \u0433\u043E\u0440\u0443 \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456. \u0410 \u044F \u0431\u0443\u0434\u0443 \u0447\u0435\u043A\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824927
    m_Localized: "\u0422\u0435\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824928
    m_Localized: "\u0422\u0435\u0441\u0442 \u0442\u0435\u0441\u0442 \u0442\u0435\u0441\u0442
      \u0442\u0435\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824929
    m_Localized: "\u0412\u0438\u043A\u043E\u043D\u0430\u0439\u0442\u0435 \u0435\u0442\u0430\u043F
      1"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824930
    m_Localized: "\u0412\u0438\u043A\u043E\u043D\u0430\u0439\u0442\u0435 \u0435\u0442\u0430\u043F
      2"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824931
    m_Localized: "\u0412\u0438\u043A\u043E\u043D\u0430\u0439\u0442\u0435 \u0435\u0442\u0430\u043F
      3"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824932
    m_Localized: "\u0414\u043E \u0432\u0438\u0445\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824933
    m_Localized: "\u0412\u0438 \u043F\u0440\u0438\u0439\u0448\u043B\u0438 \u0434\u043E
      \u0442\u044F\u043C\u0438 \u0432 \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u0438\u0445
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0438\u0445 \u0442\u0443\u043D\u0435\u043B\u044F\u0445,
      \u0437\u043E\u0432\u0441\u0456\u043C \u043E\u0434\u043D\u0456, \u0431\u0435\u0437
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F,
      \u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u0435 - \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043D\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u0454\u0442\u0435, \u044F\u043A
      \u0442\u0443\u0442 \u043E\u043F\u0438\u043D\u0438\u043B\u0438\u0441\u044F.
      \u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u0432\u0438\u0445\u0456\u0434
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E, \u0430 \u0437\u0430\u043E\u0434\u043D\u043E
      \u0434\u043E\u0441\u043B\u0456\u0434\u0456\u0442\u044C \u043C\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044C
      \u043D\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u044F\u043A\u0438\u0445\u043E\u0441\u044C
      \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0445 \u0430\u0431\u043E \u0446\u0456\u043D\u043D\u0438\u0445
      \u0440\u0435\u0447\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824934
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0456\u0442\u044C\u0441\u044F \u0434\u043E
      \u0432\u0438\u0445\u043E\u0434\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824935
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u0443\u0441\u0456
      \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824936
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0435\u043D\u043E \u0448\u0435\u0441\u0442\u0435\u0440\u0435\u043D\u044C:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824937
    m_Localized: "\u0423\u0432\u0456\u0439\u0442\u0438 \u0432 \u043A\u043E\u043D\u0442\u0430\u043A\u0442
      \u0456\u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824938
    m_Localized: "\u041D\u0430 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0456\u0439
      \u041F\u0443\u0441\u0442\u0446\u0456 \u043C\u0430\u044E\u0442\u044C \u0456\u0441\u043D\u0443\u0432\u0430\u0442\u0438
      \u043C\u0438\u0440\u043D\u0456 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F.
      \u0412\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u0442\u0430\u0442\u0438
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043D\u043E\u044E \u0442\u043E\u0447\u043A\u043E\u044E
      \u0434\u043B\u044F \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0438\u0445 \u0434\u0456\u0439.
      \u0417\u043D\u0430\u0439\u0434\u0438 \u0442\u0430\u043A\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0456 \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0441\u044F \u0437
      \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u043C\u0438 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824939
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824940
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824941
    m_Localized: "\u041E\u0431\u0440\u0430\u043D\u0430-24"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824942
    m_Localized: "\"\u041E\u0431\u0440\u0430\u043D\u0456\u0439-24\" \u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
      \u043C\u0456\u0441\u044F\u0446\u044F\u043C\u0438 \u0440\u0430\u043D\u0456\u0448\u0435
      \u0431\u0443\u043B\u043E \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043E \u0442\u0443
      \u0441\u0430\u043C\u0443 \u043C\u0456\u0441\u0456\u044E, \u0449\u043E \u0439
      \u0442\u043E\u0431\u0456. \u0410\u043B\u0435 \u0441\u0438\u0433\u043D\u0430\u043B
      \u0432\u0456\u0434 \u0457\u0457 \u041F\u0456\u043F\u0411\u0430\u043A\u0430
      \u0431\u0443\u043B\u043E \u0432\u0442\u0440\u0430\u0447\u0435\u043D\u043E \u0441\u0456\u043C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0432\u0430 \u0434\u043D\u0456 \u0442\u043E\u043C\u0443. \u0422\u0432\u043E\u0454
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u043F\u043E\u043B\u044F\u0433\u0430\u0454
      \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E\u0431 \u0437\u043D\u0430\u0439\u0442\u0438
      \"\u041E\u0431\u0440\u0430\u043D\u0443-24\" \u0456 \u0437'\u044F\u0441\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u0442\u043E\u0433\u043E, \u0447\u043E\u043C\u0443
      \u0437 \u043D\u0435\u044E \u043D\u0435\u043C\u0430\u0454 \u0437\u0432'\u044F\u0437\u043A\u0443.
      \u0414\u0430\u043B\u0456 \u0434\u0456\u044F\u0442\u0438 \u0437\u0430 \u043E\u0431\u0441\u0442\u0430\u0432\u0438\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824943
    m_Localized: "\u0414\u043E\u0431\u0443\u0442\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
      \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456 \u043F\u0440\u043E \"\u041E\u0431\u0440\u0430\u043D\u0443-24\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824944
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0438\u0442\u0438 \u0442\u0430\u0431\u0456\u0440
      \u0443 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824945
    m_Localized: "\u0412\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438 \"\u041E\u0431\u0440\u0430\u043D\u0443-24\"
      \u0437 \u043F\u043E\u043B\u043E\u043D\u0443 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824946
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \"\u041E\u0431\u0440\u0430\u043D\u0443-24\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824947
    m_Localized: "\u0411\u0456\u0433\u0442\u0438 \u0437\u0430 \u0432\u0435\u0441\u0435\u043B\u043A\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824948
    m_Localized: "\u0414\u0435\u0441\u044C \u0432 \u043E\u043A\u043E\u043B\u0438\u0446\u044F\u0445
      \u0442\u0432\u043E\u0454\u0457 \u0442\u043E\u0447\u043A\u0438 \u0432\u0438\u0441\u0430\u0434\u043A\u0438
      \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0437\u0430\u0432\u043E\u0434
      \u041C\u0435\u0439\u043D\u0422\u0435\u043A \u0430\u0431\u043E \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u0442\u0435, \u0449\u043E \u0432\u0456\u0434 \u043D\u044C\u043E\u0433\u043E
      \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F. \u0422\u0432\u043E\u044F
      \u043E\u0441\u043D\u043E\u0432\u043D\u0430 \u043C\u0435\u0442\u0430 - \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C, \u0443 \u0439\u043E\u0433\u043E
      \u043F\u0430\u043C'\u044F\u0442\u0456 \u043C\u0456\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F, \u044F\u043A\u0430
      \u043D\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430. \u041F\u0456\u0434\u043A\u043B\u044E\u0447\u0438
      \u0434\u043E \u043D\u044C\u043E\u0433\u043E \u0441\u0432\u0456\u0439 \u041F\u0456\u043F\u0411\u0430\u043A,
      \u0443\u0441\u0435 \u0456\u043D\u0448\u0435 \u0437\u0440\u043E\u0431\u043B\u044F\u0442\u044C
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456 \u043D\u0430
      \u043D\u044C\u043E\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0438.
      \u041F\u043E\u043A\u0438 \u0449\u043E \u0446\u0435 \u0432\u0441\u044F \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F,
      \u044F\u043A\u043E\u044E \u044F \u043C\u043E\u0436\u0443 \u0437 \u0442\u043E\u0431\u043E\u044E
      \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F. \u0423\u0432\u0430\u0433\u0430!
      \u041D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u0439\u0441\u044F \u0437\u043D\u044F\u0442\u0438
      \u0441\u0432\u0456\u0439 \u041F\u0456\u043F\u0411\u0430\u043A! \u0412\u0456\u0434
      \u043D\u044C\u043E\u0433\u043E \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u044F\u043A \u0443\u0441\u043F\u0456\u0445 \u043C\u0456\u0441\u0456\u0457,
      \u0442\u0430\u043A \u0456 \u0442\u0432\u043E\u0454 \u0436\u0438\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824949
    m_Localized: "\u0414\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u043C\u0456\u0441\u0446\u0435
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0430\u0432\u043E\u0434\u0443
      \u041C\u0435\u0439\u043D\u0422\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824950
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0456 \u0432\u0438\u0432\u0447\u0438\u0442\u0438
      \u043F\u043B\u0430\u043D\u0438 \u0437\u0430\u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824951
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u043A\u043B\u044E\u0447
      \u0441\u043B\u0443\u0436\u0431\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824952
    m_Localized: "\u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438 \u0443
      \u0432\u0456\u0434\u0434\u0456\u043B \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824953
    m_Localized: "\u041F\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0441\u0432\u0456\u0439
      \u041F\u0456\u043F\u0411\u0430\u043A \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E
      \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824954
    m_Localized: "\u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439 \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824955
    m_Localized: "\u0422\u0432\u043E\u0454 \u0433\u043E\u043B\u043E\u0432\u043D\u0435
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u0442\u0435\u043F\u0435\u0440
      - \u0440\u043E\u0437\u0434\u043E\u0431\u0443\u0442\u0438 \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440. \u0426\u0435 \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u0456 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0434\u0443\u0436\u0435 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0438\u0439
      \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440, \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0448\u0442\u0443\u0447\u043D\u0438\u0439
      \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442 \u043D\u0430\u0439\u0432\u0438\u0449\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F. \u0404\u0434\u0438\u043D\u0435 \u043C\u0456\u0441\u0446\u0435,
      \u0434\u0435, \u0437\u0430 \u043D\u0430\u0448\u0438\u043C\u0438 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u044F\u043C\u0438,
      \u0439\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
      - \u0421\u0442\u0456\u0439\u043B\u043E 88, \u0432\u0456\u0434\u043E\u043C\u0435
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0430\u043C\u0438
      \u0432 \u0433\u0430\u043B\u0443\u0437\u0456 \u043A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440\u0456\u0432
      \u0456 \u0440\u043E\u0431\u043E\u0442\u0456\u0432 \u0437 \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0438\u043C
      \u0428\u0406. \u0412\u0445\u0456\u0434 \u0443 \u0421\u0442\u0456\u0439\u043B\u043E
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0434\u0435\u0441\u044C
      \u0443 \u043C\u0456\u0441\u0442\u0435\u0447\u043A\u0443 \u0424\u043E\u043B\u0441
      \u0421\u043F\u0440\u0456\u043D\u0433\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824956
    m_Localized: "\u0414\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u043C\u0456\u0441\u0446\u0435
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u0424\u043E\u043B\u0441
      \u0421\u043F\u0440\u0456\u043D\u0433\u0441 \u0443 \u0414\u0430\u0439\u043A\u0456\u0440\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824957
    m_Localized: "\u0423\u0432\u0456\u0439\u0442\u0438 \u0432 \u0421\u0442\u0456\u0439\u043B\u043E
      88"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824958
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824959
    m_Localized: "\u0414\u043E\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u043F\u0440\u043E
      \u0443\u0441\u043F\u0456\u0445 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824960
    m_Localized: "\u0417\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438 \u0431\u0440\u0430\u043D\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824961
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456
      \u0442\u0440\u0438\u043C\u0430\u044E\u0442\u044C \u0443\u0437\u044F\u0442\u0438\u0445
      \u0443 \u043F\u043E\u043B\u043E\u043D \u043F\u043E\u043D\u0456 \u0432 \u043A\u043B\u0456\u0442\u043A\u0430\u0445.
      \u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u0441\u043F\u043E\u0441\u0456\u0431
      \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438 \u0457\u0445. \u0417\u043B\u0430\u043C\u0430\u0439\u0442\u0435
      \u0437\u0430\u043C\u043A\u0438 \u043D\u0430 \u043A\u043B\u0456\u0442\u043A\u0430\u0445,
      \u0430 \u044F\u043A\u0449\u043E \u043D\u0435 \u0432\u0438\u0439\u0434\u0435,
      \u0442\u043E \u0437\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u043A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824962
    m_Localized: "\u0411\u0440\u0430\u043D\u0446\u0456\u0432 \u043D\u0430 \u0432\u043E\u043B\u0456:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824963
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824964
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440 \u043D\u0430\u0448\u0456\u0439
      \u0434\u043E\u0432\u0456\u0440\u0435\u043D\u0456\u0439 \u043E\u0441\u043E\u0431\u0456
      \u0447\u0435\u0440\u0435\u0437 \u0439\u043E\u0433\u043E \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0430.
      \u041C\u0456\u0441\u0446\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456
      - \u0433\u0430\u0440\u0430\u0436\u0456 \u0425\u0435\u043D\u043A\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824965
    m_Localized: "\u0417'\u044F\u0432\u0438\u0442\u0438\u0441\u044F \u043D\u0430
      \u043C\u0456\u0441\u0446\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824966
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824967
    m_Localized: "\u041E\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0443\u043B\u0430\u043C\u043A\u0438
      \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824968
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824969
    m_Localized: "\u041D\u043E\u0432\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u0435
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F - \u0434\u0456\u0441\u0442\u0430\u0442\u0438
      \u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430,
      \u044F\u043A\u0438\u0439 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0434\u0435\u0441\u044C \u0443 \u0440\u0443\u0457\u043D\u0430\u0445 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824970
    m_Localized: "\u0414\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u0443
      \u043D\u0430 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D \u0443
      \u0414\u0430\u0439\u043A\u0456\u0440\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824971
    m_Localized: "\u041F\u0456\u0434\u043D\u044F\u0442\u0438\u0441\u044F \u043D\u0430
      \u0434\u0430\u0445 \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u0456\u0437
      \u0443\u0446\u0456\u043B\u0456\u043B\u0438\u0445 \u0445\u043C\u0430\u0440\u043E\u0447\u043E\u0441\u0456\u0432
      \u0456 \u043E\u0437\u0438\u0440\u043D\u0443\u0442\u0438\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824972
    m_Localized: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E
      \u0432\u0445\u043E\u0434\u0443 \u0443 \u0412\u0435\u0436\u0443 \u041C\u0422\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824973
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F \u0437
      \u0432\u0430\u0442\u0430\u0436\u043A\u043E\u043C \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824974
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0410\u043C\u0443\u043B\u0435\u0442
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824975
    m_Localized: "\u0427\u043E\u0440\u043D\u0430 \u041A\u043D\u0438\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824976
    m_Localized: "\u041D\u043E\u0432\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u0435
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F - \u0434\u0456\u0441\u0442\u0430\u0442\u0438
      \u0427\u043E\u0440\u043D\u0443 \u041A\u043D\u0438\u0433\u0443, \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0445 \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0456\u0432
      \u0434\u0430\u0432\u043D\u0456\u0445 \u0447\u0430\u0441\u0456\u0432. \u041E\u0441\u0442\u0430\u043D\u043D\u0454
      \u0432\u0456\u0434\u043E\u043C\u0435 \u043C\u0456\u0441\u0446\u0435 \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F
      \u041A\u043D\u0438\u0433\u0438 - \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u043E\u0444\u0456\u0441 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0421\u0442\u0438\u043B\u044E, \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824977
    m_Localized: "\u0414\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0443 \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456
