      \u0421\u0442\u0430\u043D\u0446\u0456\u0439 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457
      \"\u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A\" \u0432\u0438\u044F\u0432\u043B\u0435\u043D\u043E:
      0*"
    m_Metadata:
