  - m_Id: 2737825168
    m_Localized: "\u041C\u0430\u043B\u0438\u043D\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825169
    m_Localized: "\u041B\u0430\u0439\u043C\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825170
    m_Localized: "\u0412\u043E\u0433\u043D\u044F\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825171
    m_Localized: "\u0411\u0435\u0436\u0435\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825172
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0432\u0441\u0456
      \u0444\u0430\u0440\u0431\u0438 \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825173
    m_Localized: "\u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A-\u0430\u043C\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825174
    m_Localized: "\u041D\u0443 \u0430 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438,
      \u043D\u0430\u0432\u0456\u0449\u043E \u0442\u043E\u0431\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u0438\u0441\u044F
      \u0432\u0441\u0456 \u0446\u0456 \u0444\u0430\u0440\u0431\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825175
    m_Localized: "\u0410 \u0442\u043E\u0431\u0456 \u043D\u0435 \u0432\u0441\u0435
      \u043E\u0434\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825176
    m_Localized: "\u0422\u0430\u043A \u0430\u0434\u0436\u0435 \u0446\u0456\u043A\u0430\u0432\u043E
      \u0436!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825177
    m_Localized: "\u0412\u0447\u0443\u0441\u044F \u043C\u0430\u043B\u044E\u0432\u0430\u0442\u0438.
      \u041C\u043E\u0436\u043D\u0430 \u043D\u0430\u0437\u0432\u0430\u0442\u0438 \u0446\u0435
      \u043C\u043E\u0457\u043C \u0445\u043E\u0431\u0456. \u042F\u043A\u0449\u043E
      \u0442\u0430\u043A \u0445\u043E\u0447\u0435\u0442\u044C\u0441\u044F - \u043E\u0441\u044C,
      \u0432\u0456\u0437\u044C\u043C\u0438 \u043A\u043B\u044E\u0447 \u0456 \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044F
      \u0432 \u043F\u0456\u0434\u0441\u043E\u0431\u0446\u0456, \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0435 \u0447\u0456\u043F\u0430\u0439 \u043D\u0456\u0447\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825178
    m_Localized: "\u0412\u0438\u0445\u043E\u0434\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825179
    m_Localized: "\u041C\u043E\u0433\u043B\u043E \u0431\u0443\u0442\u0438 \u0439
      \u043A\u0440\u0430\u0449\u0435. \u0410\u043B\u0435 \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0434\u043E\u0441\u0432\u0456\u0434\u0456 \u0432\u0447\u0438\u0442\u0438\u0441\u044F
      \u0432\u0430\u0436\u043A\u043E, \u0430 \u043F\u043E\u0441\u0456\u0431\u043D\u0438\u043A\u0456\u0432
      \u0434\u043B\u044F \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0456\u0432
      \u043D\u0435\u043C\u0430\u0454 \u043D\u0430\u0432\u0456\u0442\u044C \u0443
      \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u0446\u0456 \u041D\u0435\u0431\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825180
    m_Localized: "\u0422\u043E, \u043C\u043E\u0436\u0435, \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u044E
      \u0442\u043E\u0431\u0456 \u0437\u043D\u0430\u0439\u0442\u0438 \u0449\u043E\u0441\u044C
      \u043A\u043E\u0440\u0438\u0441\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825181
    m_Localized: "\u0422\u0438 \u043A\u0443\u043C\u0435\u0434\u043D\u0430, @lp. \u0422\u043E\u0431\u0456
      \u0446\u044C\u043E\u0433\u043E \u0449\u0435 \u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u0438?
      \u041D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0441\u0435\u0440\u0435\u0434 \u0441\u0442\u0430\u0440\u0438\u0445 \u0440\u0443\u0457\u043D
      \u0443\u0441\u0435, \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043A\u043E\u0436\u043D\u043E\u043C\u0443. \u041D\u0456, \u043D\u0435 \u0442\u0440\u0435\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825182
    m_Localized: "\u0417\u043D\u0438\u0449\u0438\u0442\u0438 \u0440\u043E\u0437\u0441\u0430\u0434\u043D\u0438\u043A
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825183
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0438,
      \u044F\u043A\u0456 \u0432\u043E\u0434\u044F\u0442\u044C\u0441\u044F \u0432
      \u0440\u0443\u0457\u043D\u0430\u0445 \u0437\u0430\u0432\u043E\u0434\u0443,
      \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u043C \u0447\u0430\u0441\u043E\u043C
      \u0440\u043E\u0437\u0432\u0435\u043B\u0438\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0434\u043E \u043D\u0435\u043F\u0440\u0438\u0441\u0442\u043E\u0439\u043D\u043E\u0441\u0442\u0456.
      \u0414\u043E\u0441\u0438\u0442\u044C \u0446\u0435 \u0442\u0435\u0440\u043F\u0456\u0442\u0438!
      \u0417\u0430\u043F\u043B\u0430\u0447\u0443 \u0442\u043E\u043C\u0443, \u0445\u0442\u043E
      \u0437\u043C\u043E\u0436\u0435 \u0437\u043D\u0430\u0439\u0442\u0438 \u0440\u043E\u0437\u0441\u0430\u0434\u043D\u0438\u043A
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432 \u0456
      \u0432\u0438\u043F\u0430\u043B\u0438\u0442\u0438 \u0439\u043E\u0433\u043E \u0440\u0430\u0437
      \u0456 \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825184
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u043E\u0437\u0441\u0430\u0434\u043D\u0438\u043A
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825185
    m_Localized: "\u0417\u043D\u0438\u0449\u0438\u0442\u0438 \u0433\u043D\u0456\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825186
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443
      \u0432\u0456\u0434 \u0411\u0440\u0430\u0441\u0441\u0430 \u0411\u0430\u043A\u0448\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825187
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043D\u043E\u0432\u0438\u0439
      \u0444\u043E\u043A\u0443\u0441\u0443\u044E\u0447\u0438\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825188
    m_Localized: "\u0423 \u043C\u043E\u0457\u0439 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0456\u0439
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0456\u0439 \u0433\u0430\u0440\u043C\u0430\u0442\u0456
      \u0442\u0440\u0456\u0441\u043D\u0443\u0432 \u0444\u043E\u043A\u0443\u0441\u0443\u044E\u0447\u0438\u0439
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B. \u0414\u0443\u0436\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u043D\u043E\u0432\u0438\u0439, \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0435\u043E\u0434\u043C\u0456\u043D\u043D\u043E
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0439 \u0456 \u043D\u0430\u0439\u0447\u0438\u0441\u0442\u0456\u0448\u0438\u0439.
      \u042F\u043A\u0449\u043E \u0445\u0442\u043E \u0437\u043D\u043E\u0432\u0443
      \u0441\u043F\u0440\u043E\u0431\u0443\u0454 \u043F\u0456\u0434\u0441\u0443\u043D\u0443\u0442\u0438
      \u0448\u043C\u0430\u0442\u043E\u043A \u0441\u043A\u043B\u0430, \u043E\u0442\u0440\u0438\u043C\u0430\u0454
      \u0437\u0430\u0440\u044F\u0434 \u0434\u0440\u043E\u0431\u0443 \u0432 \u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825189
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0444\u043E\u043A\u0443\u0441\u0443\u044E\u0447\u0438\u0439
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825190
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043A\u0440\u0438\u0441\u0442\u0430\u043B
      \u0411\u0440\u0430\u0441\u0441\u0443 \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825191
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825192
    m_Localized: "\u042F\u043A\u0449\u043E \u0445\u0442\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0437\u043D\u0430\u0439\u0434\u0435 \u043C\u0456\u0439 \u0437\u0430\u0433\u0443\u0431\u043B\u0435\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u0432\u0435\u043B\u0438\u043A\u0435
      \u043F\u0440\u043E\u0445\u0430\u043D\u043D\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438.
      \u0412\u0438\u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443 \u0433\u0430\u0440\u0430\u043D\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825193
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
      \"\u0412\u0456\u0440\u043D\u0456\u0441\u0442\u044C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825194
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
      \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825195
    m_Localized: "\u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u0431\u043B\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825196
    m_Localized: "\u0427\u0443\u043B\u0438 \u043A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0456\u0441\u0442\u043E\u0440\u0456\u044E \u043F\u0440\u043E \u0437\u0431\u0440\u043E\u044E,
      \u0449\u043E \u0432\u043F\u0430\u043B\u0430 \u0456\u0437 \u0437\u0456\u0440\u043E\u043A?
      \u041D\u0435\u0445\u0430\u0439 \u0431\u0430\u0437\u0456\u043A\u0430\u044E\u0442\u044C,
      \u0449\u043E \u0446\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043A\u0430\u0437\u043A\u0438!
      \u041C\u043E\u0436\u0435, \u0437\u0432\u0456\u0441\u043D\u043E, \u0446\u044F
      \u0437\u0431\u0440\u043E\u044F \u043D\u0456\u0437\u0432\u0456\u0434\u043A\u0438
      \u0439 \u043D\u0435 \u043F\u0430\u0434\u0430\u043B\u0430, \u0430\u043B\u0435
      \u0432\u043E\u043D\u0430 \u0442\u043E\u0447\u043D\u043E \u0456\u0441\u043D\u0443\u0454,
      \u0456 \u044F \u043C\u0430\u044E \u0434\u043E\u043A\u0430\u0437\u0438 - \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438,
      \u044F\u043A\u0456 \u044F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0443
      \u0440\u0443\u0457\u043D\u0430\u0445 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0430.
      \u0412\u043E\u043D\u0438 \u043D\u0435 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0442\u044C
      \u0434\u043E \u0436\u043E\u0434\u043D\u043E\u0457 \u0432\u0456\u0434\u043E\u043C\u043E\u0457
      \u043C\u043E\u0434\u0435\u043B\u0456 \u0437\u0431\u0440\u043E\u0457, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E\u0457
      \u043F\u043E\u043D\u0456 \u0430\u0431\u043E \u0437\u0435\u0431\u0440\u0430\u043C\u0438,
      \u0432\u0436\u0435 \u044F \u0432 \u0446\u044C\u043E\u043C\u0443 \u0440\u043E\u0437\u0443\u043C\u0456\u044E\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825197
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0417\u043E\u0440\u044F\u043D\u0438\u0439
      \u0431\u043B\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825198
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u0438 \u0417\u043E\u0440\u044F\u043D\u0438\u0439
      \u0431\u043B\u0430\u0441\u0442\u0435\u0440 \u0411\u0440\u0430\u0441\u0441\u0443
      \u0411\u0430\u043A\u0448\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825199
    m_Localized: "\u0426\u0456\u043D\u043D\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825200
    m_Localized: "\u042F\u043A \u0442\u0438 \u0437\u0430\u0433\u0443\u0431\u0438\u0432
      \u0441\u0432\u0456\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825201
    m_Localized: "\u0412\u0441\u0435 \u0434\u0435\u0449\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435.
      \u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0439\u0434\u0435\u0442\u044C\u0441\u044F
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0440\u043E \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825202
    m_Localized: "\u0412\u043E\u0441\u0442\u0430\u043D\u043D\u0454, \u043A\u043E\u043B\u0438
      \u044F \u0431\u0443\u0432\u0430\u0432 \u0443 \u0441\u043F\u0440\u0430\u0432\u0430\u0445
      \u0443 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0456,
      \u043C\u0435\u043D\u0456 \u043D\u0435 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E.
      \u041F\u043E\u0442\u0440\u0430\u043F\u0438\u0432 \u0434\u043E \u043B\u043E\u0432\u0447\u0438\u0445
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432.
      \u041E\u0434\u044F\u0433\u043B\u0438, \u0437\u043D\u0430\u0447\u0438\u0442\u044C,
      \u043D\u0430 \u043C\u0435\u043D\u0435 \u043A\u0430\u0439\u0434\u0430\u043D\u0438
      \u0456 \u043F\u043E\u0441\u0430\u0434\u0438\u043B\u0438 \u0432 \u043A\u043B\u0456\u0442\u043A\u0443
      \u0434\u043E \u0456\u043D\u0448\u0438\u0445 \u0440\u0430\u0431\u0456\u0432.
      \u041D\u0443 \u0430 \u0432\u0441\u0456 \u0440\u0435\u0447\u0456, \u044F\u0441\u043D\u0430
      \u0440\u0456\u0447, \u0437\u0430\u0431\u0440\u0430\u043B\u0438, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442. \u0412\u0456\u0434\u043C\u0456\u043D\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u043C\u0456\u0436 \u0456\u043D\u0448\u0438\u043C.
      \u0410\u043B\u0435 \u0449\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0435,
      \u0446\u0435\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0431\u0443\u0432
      \u0441\u0456\u043C\u0435\u0439\u043D\u043E\u044E \u0440\u0435\u043B\u0456\u043A\u0432\u0456\u0454\u044E,
      \u0434\u0456\u0441\u0442\u0430\u0432\u0441\u044F \u043C\u0435\u043D\u0456 \u0432\u0456\u0434
      \u0431\u0430\u0442\u044C\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825203
    m_Localized: "\u041C\u0435\u043D\u0435 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E
      \u0433\u043E\u043B\u0438\u043C\u0438 \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438
      \u043D\u0435 \u0432\u0437\u044F\u0442\u0438, \u0456 \u044F \u0437\u043C\u0456\u0433
      \u0443\u0442\u0435\u043A\u0442\u0438. \u0425\u043E\u0447\u0430, \u0437\u0432\u0456\u0441\u043D\u043E,
      \u043C\u0435\u043D\u0456 \u0442\u043E\u0434\u0456 \u0434\u0443\u0436\u0435
      \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E. \u0410\u043B\u0435
      \u0432\u0441\u0435 \u0431\u0430\u0440\u0430\u0445\u043B\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0432 \u043D\u0438\u0445, \u043D\u0435 \u0434\u043E \u043D\u044C\u043E\u0433\u043E
      \u0442\u043E\u0434\u0456 \u0431\u0443\u043B\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825204
    m_Localized: "\u0422\u0430\u043A \u0432\u0456\u0434\u0442\u043E\u0434\u0456 \u0442\u0456
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456 \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0434\u0430\u0432\u043D\u043E \u043F\u0456\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825205
    m_Localized: "\u041E \u043D\u0456, \u043D\u0435 \u043F\u0456\u0448\u043B\u0438.
      \u042F \u0431 \u043D\u0435 \u0441\u0442\u0430\u0432 \u0442\u0430\u043A \u0442\u0443\u0440\u0431\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E \u043D\u0438\u0445 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0444\u0430\u043C\u0456\u043B\u044C\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442. \u041A\u043E\u043B\u0438
      \u044F \u0441\u0438\u0434\u0456\u0432 \u0443 \u043A\u043B\u0456\u0442\u0446\u0456,
      \u044F \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E \u043F\u043E\u0447\u0443\u0432
      \u0437 \u0457\u0445\u043D\u044C\u043E\u0457 \u0431\u0430\u043B\u0430\u043A\u0430\u043D\u0438\u043D\u0438.
      \u041C\u0456\u0441\u0446\u0435, \u043A\u0443\u0434\u0438 \u043C\u0435\u043D\u0435
      \u043F\u0440\u0438\u0432\u0435\u043B\u0438, \u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u0457\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0447\u043D\u0438\u043C
      \u043F\u0443\u043D\u043A\u0442\u043E\u043C, \u0456 \u0432\u043E\u043D\u0438
      \u0442\u0430\u043C \u0443\u0436\u0435 \u0441\u0438\u0434\u044F\u0442\u044C
      \u043D\u0435 \u043F\u0435\u0440\u0448\u0438\u0439 \u0440\u0456\u043A. \u0406
      \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u0454 \u0439\u043E\u0433\u043E \u043E\u0434\u0438\u043D
      \u0456 \u0442\u043E\u0439 \u0441\u0430\u043C\u0438\u0439 \u0437\u0430\u0433\u0456\u043D.
      \u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u0446\u0435\u0439 \u043F\u0443\u043D\u043A\u0442, \u0449\u043E\u0431 \u0437\u0434\u0456\u0439\u0441\u043D\u044E\u0432\u0430\u0442\u0438
      \u0440\u0435\u0439\u0434\u0438 \u043D\u0430 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0432 \u043E\u043A\u0440\u0443\u0437\u0456 \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0456 \u0442\u0440\u0430\u043A\u0442\u0438.
      \u042F\u043A\u0449\u043E \u0440\u043E\u0437\u0431\u0438\u0442\u0438 \u0446\u0435\u0439
      \u043F\u0443\u043D\u043A\u0442, \u0446\u0435 \u043F\u0456\u0434\u0456\u0440\u0432\u0435
      \u0457\u0445\u043D\u044E \u0440\u043E\u0431\u043E\u0442\u0443 \u043D\u0430
      \u0442\u0438\u0436\u043D\u0456, \u044F\u043A\u0449\u043E \u043D\u0435 \u043C\u0456\u0441\u044F\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825206
    m_Localized: "\u0429\u0435 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043C\u043E\u0436\u0435\u0448 \u0441\u043A\u0430\u0437\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825207
    m_Localized: "\u0423 \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E
      \u043F\u043E\u0433\u043E\u043D\u044F\u043B\u043E - \u0420\u0443\u0431\u0430\u043D\u043E\u043A.
      \u041D\u0430\u043F\u0435\u0432\u043D\u043E \u0432\u0456\u043D \u043C\u043E\u044E
      \u043F\u0443\u043A\u0430\u043B\u043A\u0443 \u0441\u043E\u0431\u0456 \u0437\u0430\u0431\u0440\u0430\u0432.
      \u0423\u0431'\u0454\u0448 \u0439\u043E\u0433\u043E - \u043E\u0431\u0448\u0430\u0440
      \u043A\u0438\u0448\u0435\u043D\u0456, \u0440\u0430\u043F\u0442\u043E\u043C
      \u043C\u0456\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0443\u0441\u0435
      \u0449\u0435 \u043F\u0440\u0438 \u043D\u044C\u043E\u043C\u0443. \u0422\u0430\u043A\u0456
      \u0445\u043E\u0440\u043E\u0448\u0456 \u0440\u0435\u0447\u0456 \u043D\u0435
      \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825208
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0437\u043D\u0430\u0439\u0448\u043E\u0432\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825209
    m_Localized: "\u0414\u0438\u0432\u0438\u0441\u044C, \u0442\u0432\u0456\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825210
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435 \u0432\u0456\u043D \u0456 \u0454!
      \u041D\u0435 \u0434\u0443\u043C\u0430\u0432 \u043D\u0430\u0432\u0456\u0442\u044C,
      \u0449\u043E \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u0431\u0430\u0447\u0443
      \u0439\u043E\u0433\u043E. \u0422\u0438 \u0449\u043E \u0436, \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430\u0441\u044F
      \u0437 \u0420\u0443\u0431\u0430\u043D\u043A\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825211
    m_Localized: "\u0410\u0433\u0430. \u0414\u043E\u0432\u0435\u043B\u043E\u0441\u044F
      \u043F\u0435\u0440\u0435\u0442\u043D\u0443\u0442\u0438\u0441\u044F \u0437 \u0446\u0438\u043C
      \u0442\u0438\u043F\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825212
    m_Localized: "\u0406 \u044F\u043A \u0439\u043E\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825213
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0433\u0430\u043D\u0435\u043D\u044C\u043A\u043E,
      \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825214
    m_Localized: "\u0422\u0443\u0434\u0438 \u0439\u043E\u043C\u0443 \u0439 \u0434\u043E\u0440\u043E\u0433\u0430!
      \u0421\u043B\u0443\u0445\u0430\u0439, \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E,
      \u044F\u043A\u0449\u043E \u044F \u0437\u0430\u0431\u0435\u0440\u0443 \u0432
      \u0442\u0435\u0431\u0435 \u0442\u0430\u043A\u0443 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E, \u044F\u043A \"\u0412\u0456\u0440\u043D\u0456\u0441\u0442\u044C\",
      \u043D\u0435 \u0434\u0430\u0432\u0448\u0438 \u0440\u0456\u0432\u043D\u043E\u0446\u0456\u043D\u043D\u043E\u0457
      \u0437\u0430\u043C\u0456\u043D\u0438. \u0412\u0456\u0437\u044C\u043C\u0438
      \u043E\u0441\u044C \u0446\u0435\u0439, \u0432\u0456\u043D \u043D\u0456\u0447\u0438\u043C
      \u043D\u0435 \u0433\u0456\u0440\u0448\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825215
    m_Localized: "\u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u0431\u043B\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825216
    m_Localized: "\u0412\u0433\u0430\u0434\u0430\u0439, \u0449\u043E \u0432 \u043C\u0435\u043D\u0435
      \u0454. \u0422\u0430 \u0441\u0430\u043C\u0430 \u0437\u0431\u0440\u043E\u044F,
      \u044F\u043A\u0443 \u0442\u0438 \u043C\u0440\u0456\u044F\u0432 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
      - \u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u0431\u043B\u0430\u0441\u0442\u0435\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825217
    m_Localized: "\u041E\u0445 \u0442\u0438 \u0436 \u043C\u0430\u0442\u0438 \u043C\u043E\u044F
      \u043A\u043E\u0431\u0438\u043B\u0430! \u0426\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0442\u0430 \u0441\u0430\u043C\u0430 \u0437\u0431\u0440\u043E\u044F? \u0422\u0430\u043A,
      \u0442\u043E\u0447\u043D\u043E, \u0446\u0435 \u0432\u043E\u043D\u0430, \u0442\u0456
      \u0435\u043D\u0435\u0440\u0433\u043E\u043A\u043E\u043C\u0456\u0440\u043A\u0438,
      \u0449\u043E \u0432 \u043C\u0435\u043D\u0435 \u0454, \u0442\u043E\u0447\u043D\u0456\u0441\u0456\u043D\u044C\u043A\u043E
      \u0457\u0439 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825218
    m_Localized: "\u0406 \u044F\u043A, \u0432\u0456\u043D \u043F\u0440\u0430\u0446\u044E\u0454?
      \u0422\u0438 \u0432\u0438\u043F\u0440\u043E\u0431\u043E\u0432\u0443\u0432\u0430\u043B\u0430
      \u0439\u043E\u0433\u043E \u0432 \u0434\u0456\u0457?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825219
    m_Localized: "\u0429\u0435 \u0431 \u043F\u0430\u043A! \u041D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0431\u0430\u0447\u0438\u043B\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u0412\u0456\u043D \u0447\u0438\u043C\u043E\u0441\u044C
      \u0441\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442,
      \u0430\u043B\u0435 \u0432\u0434\u0435\u0441\u044F\u0442\u0435\u0440\u043E \u043A\u0440\u0443\u0442\u0456\u0448\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825220
    m_Localized: "\u0422\u0456\u043B\u044C\u043A\u0438 \u043E\u0442 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456
      \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0438 \u0434\u043E \u043D\u044C\u043E\u0433\u043E
      \u043D\u0435 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0442\u044C. \u0421\u043B\u0443\u0445\u0430\u0439,
      \u0442\u0438 \u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0432 \u0442\u0435\u0431\u0435
      \u0454 \u0435\u043D\u0435\u0440\u0433\u043E\u043A\u043E\u043C\u0456\u0440\u043A\u0438
      \u0434\u043E \u043D\u044C\u043E\u0433\u043E? \u041C\u043E\u0436\u043D\u0430
      \u0457\u0445 \u043A\u0443\u043F\u0438\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825221
    m_Localized: "\u0414\u0443\u043C\u0430\u044E, \u0442\u0438 \u043C\u043E\u0436\u0435\u0448
      \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438 \u0457\u0445 \u0437\u0430\u0434\u0430\u0440\u043C\u0430.
      \u0412\u0441\u0435 \u043E\u0434\u043D\u043E \u043C\u0435\u043D\u0456 \u0432\u043E\u043D\u0438
      \u043D\u0435 \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F.
      \u0410 \u043D\u0430\u0432\u0456\u0442\u044C \u043E\u0434\u0438\u043D \u043F\u043E\u0433\u043B\u044F\u0434
      \u043D\u0430 \u0442\u0430\u043A\u0435 \u0434\u0438\u0432\u043E \u043A\u043E\u0448\u0442\u0443\u0432\u0430\u0432
      \u0442\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825222
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u0456 \u0432\u0435\u043B\u0438\u043A\u0435,
      \u044F \u0437\u043D\u0430\u0439\u0434\u0443 \u0457\u043C \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F.
      \u042F\u043A \u0442\u0438 \u0434\u0443\u043C\u0430\u0454\u0448, \u0446\u0435\u0439
      \u0431\u043B\u0430\u0441\u0442\u0435\u0440 \u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432\u043F\u0430\u0432 \u0456\u0437 \u0437\u0456\u0440\u043E\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825223
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E. \u041C\u043E\u0436\u0435,
      \u0456 \u0432\u043F\u0430\u0432. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0446\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0430 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0430
      \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E, \u0430 \u043C\u043E\u0436\u0435,
      \u0439\u043E\u0433\u043E \u0437\u0430\u0433\u0443\u0431\u0438\u043B\u0438 \u043F\u0435\u0433\u0430\u0441\u0438?
      \u0425\u0442\u043E \u0457\u0445 \u0437\u043D\u0430\u0454, \u0447\u0438\u043C
      \u0432\u043E\u043D\u0438 \u0442\u0430\u043C \u0437\u0430\u0439\u043C\u0430\u044E\u0442\u044C\u0441\u044F
      \u0443 \u0441\u0435\u0431\u0435 \u0437\u0430 \u0445\u043C\u0430\u0440\u0430\u043C\u0438.
      \u0410\u043B\u0435 \u044F\u043A\u0449\u043E \u0432 \u043D\u0438\u0445 \u0454
      \u0442\u0430\u043A\u0430 \u0437\u0431\u0440\u043E\u044F... \u0443 \u043D\u0430\u0441
      \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0443\u0442\u0438 \u0432\u0435\u043B\u0438\u043A\u0456
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438. \u041F\u043E\u0436\u0438\u0432\u0435\u043C\u043E
      - \u043F\u043E\u0431\u0430\u0447\u0438\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825224
    m_Localized: "\u0423\u0431\u0438\u0442\u0438 \u041B\u044E\u0446\u0435\u0440\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825225
    m_Localized: "\u0411\u0430\u0433\u0430\u0442\u043E \u0445\u0442\u043E \u0437
      \u0432\u0430\u0441, \u043D\u0430\u043F\u0435\u0432\u043D\u043E, \u043F\u0430\u043C'\u044F\u0442\u0430\u0454
      \u043F\u043E\u043D\u0456 \u043D\u0430 \u0456\u043C'\u044F \u041B\u044E\u0446\u0435\u0440\u043D\u0430.
      \u041A\u043E\u043B\u0438\u0441\u044C \u0432\u043E\u043D\u0430 \u0431\u0443\u043B\u0430
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C, \u043F\u0440\u0438\u0441\u0442\u043E\u0439\u043D\u0438\u043C
      \u0433\u0443\u043B\u0435\u043C, \u0430\u043B\u0435 \u0442\u0435\u043F\u0435\u0440,
      \u0441\u0445\u043E\u0436\u0435, \u043F\u0440\u043E\u0446\u0435\u0441 \u0440\u043E\u0437\u043F\u0430\u0434\u0443
      \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u0434\u0456\u0441\u0442\u0430\u0432\u0441\u044F
      \u0434\u043E \u0457\u0457 \u043C\u043E\u0437\u043A\u0443, \u0456 \u0432\u043E\u043D\u0430
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044F
      \u043D\u0430 \u0434\u0438\u043A\u043E\u0433\u043E. \u041A\u0430\u0436\u0443\u0442\u044C,
      \u0457\u0457 \u0431\u0430\u0447\u0438\u043B\u0438 \u0432 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457,
      \u0443 \u043C\u0456\u0441\u0446\u0456, \u0449\u043E \u0437\u0432\u0435\u0442\u044C\u0441\u044F
      \"\u042F\u043C\u0430\", \u0443 \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u0457
      \u0446\u0456\u043B\u043E\u0433\u043E \u0442\u0430\u0431\u0443\u043D\u0430 \u0456\u043D\u0448\u0438\u0445
      \u0434\u0438\u043A\u0438\u0445. \u0411\u0443\u0434\u0435 \u0434\u043E\u0431\u0440\u0435,
      \u044F\u043A\u0449\u043E \u0445\u0442\u043E\u0441\u044C \u043D\u0430\u0432\u0430\u0436\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438 \u0457\u0457 \u0437\u0435\u043C\u043D\u0438\u0439
      \u0448\u043B\u044F\u0445 - \u0443 \u043D\u0438\u043D\u0456\u0448\u043D\u044C\u043E\u043C\u0443
      \u0441\u0442\u0430\u043D\u0456 \u0432\u043E\u043D\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0447\u0438\u043C\u0430\u043B\u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443
      \u0434\u043B\u044F \u0432\u0441\u0456\u0445 \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825226
    m_Localized: "\u0423\u0431\u0438\u0442\u0438 \u041B\u044E\u0446\u0435\u0440\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825227
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443
      \u0432\u0456\u0434 \u0411\u0440\u0430\u0441\u0441\u0430 \u0411\u0430\u043A\u0448\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825228
    m_Localized: "\u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u043D\u0430\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u043E \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825229
    m_Localized: "\u0417\u0431\u0438\u0440\u0430\u044E\u0441\u044F \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u043E\u043C \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u0443.
      \u041D\u0430\u0440\u043E\u0434, \u0443 \u043A\u043E\u0433\u043E \u0454 \u0430\u0431\u043E
      \u0445\u0442\u043E \u043C\u043E\u0436\u0435 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438, \u043F\u0456\u0434\u0441\u043E\u0431\u0456\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825230
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0430\u0431\u043E \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0438
      \u043F\u043E\u0431\u0456\u043B\u044C\u0448\u0435 \u043A\u0438\u0441\u043B\u043E\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825231
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043A\u0430\u043D\u0456\u0441\u0442\u0440\u0443
      \u0437 \u0433\u043B\u0456\u0446\u0435\u0440\u0438\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825232
    m_Localized: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0432\u0441\u0435 \u0421\u043C\u043E\u0443\u043A\u0456
      \u041F\u0456\u0442\u0443 \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825233
    m_Localized: "\u0417\u043D\u0438\u0449\u0438\u0442\u0438 \u043C\u0443\u0440\u0430\u0448\u0438\u043D\u0456
      \u0433\u043D\u0456\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825234
    m_Localized: "\u042F \u0432\u0441\u0456\u043C \u0449\u0435 \u0440\u0430\u0437
      \u043A\u0430\u0436\u0443 - \u0446\u0456 \u043C\u0443\u0440\u0430\u0445\u0438
      \u0441\u043A\u043E\u0440\u043E \u0441\u0442\u0430\u043D\u0443\u0442\u044C \u0434\u043B\u044F
      \u043D\u0430\u0441 \u043D\u0435\u0445\u0438\u043B\u043E\u044E \u0437\u0430\u043F\u0430\u0440\u043A\u043E\u044E.
      \u042F\u043A\u0449\u043E \u0432\u0441\u0456\u043C \u043F\u043E\u0444\u0456\u0433\u0443,
      \u044F \u0441\u0430\u043C \u0433\u043E\u0442\u043E\u0432\u0438\u0439 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0438
      \u0442\u043E\u043C\u0443, \u0445\u0442\u043E \u0437\u043D\u0430\u0439\u0434\u0435
      \u0456 \u043F\u0456\u0434\u0456\u0440\u0432\u0435 \u0432\u0441\u0456 \u043A\u043B\u044F\u0442\u0456
      \u043C\u0443\u0440\u0430\u0448\u043D\u0438\u043A\u0438 \u0434\u043E \u0431\u0456\u0441\u0430
      \u0441\u043E\u0431\u0430\u0447\u043E\u0433\u043E. \u0414\u0438\u043D\u0430\u043C\u0456\u0442
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0437\u044F\u0442\u0438 \u0432
      \u043C\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825235
    m_Localized: "\u0413\u043D\u0456\u0437\u0434 \u0437\u043D\u0438\u0449\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825236
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0443 \u0421\u043C\u043E\u0443\u043A\u0456
      \u041F\u0456\u0442\u0430 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825237
    m_Localized: "\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0437 \u043C\u0443\u0440\u0430\u0445\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825238
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u0448\u0435, \u0442\u0443\u0442
      \u0442\u0430\u043A\u0430 \u0442\u0435\u043C\u0430... \u041D\u0430 \u0437\u0430\u0432\u043E\u0434\u0456
      \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044F \u043C\u0443\u0440\u0430\u0445\u0438,
      \u0437\u0434\u043E\u0440\u043E\u0432\u0456, \u044F\u043A \u0441\u043E\u0431\u0430\u043A\u0438.
      \u0406 \u0449\u043E\u0441\u044C \u0432\u043E\u043D\u0438 \u0442\u0430\u043C,
      \u0441\u0443\u043A\u0430, \u0437\u0430\u043C\u0438\u0448\u043B\u044F\u044E\u0442\u044C,
      \u043C\u0430\u0431\u0443\u0442\u044C, \u0445\u043E\u0447\u0443\u0442\u044C
      \u043F\u0440\u043E\u0440\u0438\u0442\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438
      \u043F\u0440\u044F\u043C\u043E \u0441\u044E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825239
    m_Localized: "\u0422\u0438 \u0437\u043B\u044F\u043A\u0430\u0432\u0441\u044F \u043C\u0443\u0440\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825240
    m_Localized: "\u0422\u0438 \u043D\u0435 \u0448\u0430\u0440\u0438\u0448, \u0441\u0430\u043C\u0456
      \u043C\u0443\u0440\u0430\u0445\u0438 \u043C\u0435\u043D\u0456 \u0433\u043B\u0438\u0431\u043E\u043A\u043E
      \u0434\u043E \u0445\u0432\u043E\u043D\u0430\u0440\u044F. \u0410\u043B\u0435
      \u043A\u0430\u0436\u0443\u0442\u044C, \u0441\u0435\u0440\u0435\u0434 \u043D\u0438\u0445
      \u0454 \u0442\u0430\u043A\u0456, \u0449\u043E \u043F\u0438\u0445\u0430\u044E\u0442\u044C
      \u0432\u043E\u0433\u043D\u0435\u043C, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u044E!
      \u0410 \u0432 \u043C\u0435\u043D\u0435 \u0442\u0443\u0442... \u043D\u0443 \u0434\u043E
      \u0442\u0435\u0431\u0435 \u0439 \u0441\u0430\u043C\u0456\u0439 \u043C\u0430\u0454
      \u0432\u0441\u0435 \u0434\u043E\u0445\u043E\u0434\u0438\u0442\u0438. \u041C\u0435\u043D\u0456
      \u0442\u0443\u0442 \u0432\u043E\u0433\u043E\u043D\u044C \u0431\u0443\u0434\u0435
      \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0432 \u0442\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825241
    m_Localized: "\u0410 \u0432 \u0442\u0435\u0431\u0435 \u0442\u0443\u0442 \u0446\u0456\u043B\u0456
      \u044F\u0449\u0438\u043A\u0438 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825242
    m_Localized: "\u0414\u0438\u043A, \u0443 \u0442\u043E\u043C\u0443-\u0442\u043E
      \u0439 \u043F\u0440\u0438\u043A\u043E\u043B. \u042F\u043A\u0449\u043E \u0432\u0441\u0435
      \u0442\u0443\u0442 \u0445\u0440\u0456\u043D\u0430\u043D\u0435 - \u043F\u043E\u0432\u0456\u0440,
      \u0442\u0430\u043A\u0456 \u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0438 \u043D\u0456\u043A\u043E\u043C\u0443
      \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825243
    m_Localized: "\u0406 \u0449\u043E \u043C\u043E\u0436\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0437 \u0446\u0438\u043C\u0438 \u043C\u0443\u0440\u0430\u0445\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825244
    m_Localized: "\u041D\u0443 \u0430 \u044F\u043A \u0442\u0438 \u0441\u043E\u0431\u0456
      \u0443\u044F\u0432\u043B\u044F\u0454\u0448 \u0440\u0456\u0448\u0435\u043D\u043D\u044F?
      \u0417\u043D\u0430\u0439\u0442\u0438 \u0457\u0445\u043D\u0456 \u043A\u043B\u044F\u0442\u0456
      \u043C\u0443\u0440\u0430\u0448\u043D\u0438\u043A\u0438 \u0456 \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438
      \u0434\u043E \u0431\u0456\u0441\u0430. \u0412\u0456\u0437\u044C\u043C\u0438
      \u043E\u0441\u044C \u0442\u0440\u043E\u0445\u0438 \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825245
    m_Localized: "\u041D\u0443 \u0430 \u0437\u0430 \u043C\u043D\u043E\u044E \u043D\u0435
      \u0437\u0430\u0456\u0440\u0436\u0430\u0432\u0456\u0454, \u0445\u043E\u0447\u0430
      \u0446\u0435 \u0456 \u0432 \u0442\u0432\u043E\u0457\u0445 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445
      \u0442\u0435\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825246
    m_Localized: "\u041A\u0440\u0456\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825247
    m_Localized: "\u041D\u043E\u0432\u0438\u0439 \u0442\u0438\u043F \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438,
      \u0432\u0436\u0435 \u0441\u043A\u043E\u0440\u043E! \u0420\u0435\u0430\u043B\u044C\u043D\u043E!
      \u0417\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F \u0441\u0443\u0449\u0438\u0439
      \u043F\u043E\u043D\u0442, \u0442\u0440\u0435\u0431\u0430 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0443\u0442\u0438 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438,
      \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0456 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0432 \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825248
    m_Localized: "\u0414\u043E\u0431\u0443\u0442\u0438 \u043A\u0440\u0456\u043E-\u043A\u043E\u043C\u0456\u0440\u043A\u0438
      \u0437 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u0457 \u0432
      \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u043E\u043C\u0443 \u0421\u0442\u0456\u0439\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825249
    m_Localized: "\u0421\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043A\u0440\u0456\u043E\u0433\u0440\u0430\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825250
    m_Localized: "\u0421\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043A\u0440\u0456\u043E\u043C\u0456\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825251
    m_Localized: "\u0417\u043D\u0438\u0449\u0438\u0442\u0438 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043A\u0440\u0456\u043E\u0433\u0440\u0430\u043D\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825252
    m_Localized: "\u0417\u043D\u0438\u0449\u0438\u0442\u0438 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043A\u0440\u0456\u043E\u043C\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825253
    m_Localized: "\u0414\u043E\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u0421\u043C\u043E\u0443\u043A\u0456
      \u041F\u0456\u0442\u0443 \u043F\u0440\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825254
    m_Localized: "\u041D\u043E\u0432\u0438\u0439 \u0442\u0438\u043F \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825255
    m_Localized: "@lp! \u0422\u0440\u0435\u0431\u0430 \u0434\u0435\u0449\u043E \u043F\u0440\u043E
      \u0449\u043E \u043F\u0435\u0440\u0435\u0442\u0435\u0440\u0442\u0438. \u0422\u0438
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456-\u0442\u043E \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0437\u043D\u0430\u0454\u0448\u0441\u044F \u043D\u0430
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u0456 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825256
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E.
      \u0410 \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825257
    m_Localized: "\u0404 \u0432 \u043C\u0435\u043D\u0435 \u043E\u0434\u043D\u0430
      \u0456\u0434\u0435\u0439\u043A\u0430 - \u0445\u043E\u0447\u0443 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043D\u043E\u0432\u0438\u0439
      \u0442\u0438\u043F \u0433\u0440\u0430\u043D\u0430\u0442. \u042F\u043A \u0442\u043E\u0431\u0456
      \u0442\u0430\u043A\u0435? \u0425\u043E\u0447\u0435\u0448 \u0443\u0437\u044F\u0442\u0438
      \u0443\u0447\u0430\u0441\u0442\u044C \u0443 \u043F\u043E\u043B\u044C\u043E\u0432\u0438\u0445
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825258
    m_Localized: "\u0417\u0432\u0443\u0447\u0438\u0442\u044C \u0446\u0456\u043A\u0430\u0432\u043E.
      \u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825259
    m_Localized: "\u0426\u0456 \u0433\u0440\u0430\u043D\u0430\u0442\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
      \u043D\u0435 \u043F\u0456\u0434\u0440\u0438\u0432\u0430\u0442\u0438 \u0456
      \u043D\u0435 \u043F\u0456\u0434\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0430 \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E. \u041F\u0440\u0438\u043A\u0438\u043D\u044C! \u042F
      \u0432\u0436\u0435 \u043D\u0430\u043A\u0438\u0434\u0430\u0432 \u0441\u0445\u0435\u043C\u043A\u0443,
      \u043F\u0440\u0438\u0447\u043E\u043C\u0443 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0433\u0440\u0430\u043D\u0430\u0442, \u0430 \u0439 \u043C\u0456\u043D. \u0422\u0456\u043B\u044C\u043A\u0438
      \u0454 \u043E\u0434\u043D\u0430 \u0437\u0430\u043F\u0430\u0440\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825260
    m_Localized: "\u0429\u043E\u0431 \u0437\u0430\u043C\u0443\u0442\u0438\u0442\u0438
      \u043A\u0440\u0438\u0436\u0430\u043D\u0438\u0439 \u0432\u0438\u0431\u0443\u0445,
      \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F \u0442\u0430\u043A\u0456
      \u0445\u0440\u0456\u043D\u043E\u0432\u0438\u043D\u0438 - \u043A\u0440\u0456\u043E-\u043A\u043E\u043C\u0456\u0440\u043A\u0438.
      \u041F\u0440\u044F\u043C\u043E \u0441\u043A\u0430\u0436\u0443 - \u0443 \u043C\u0435\u043D\u0435
      \u0457\u0445 \u043D\u0435\u043C\u0430\u0454, \u0456 \u043F\u0435\u0440\u0442\u0438\u0441\u044F
      \u0457\u0445 \u0448\u0443\u043A\u0430\u0442\u0438 \u043C\u0435\u043D\u0456
      \u0437\u0430\u0440\u0430\u0437 \u043D\u0435 \u043F\u043E \u043F\u0440\u0438\u043A\u043E\u043B\u0443.
      \u0414\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0442\u043E\u0431\u0456
      \u043D\u0430\u043F\u0440\u0443\u0436\u0438\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825261
    m_Localized: "\u042F\u043A \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439...
      \u0406 \u0434\u0435 \u0457\u0445 \u043C\u043E\u0436\u043D\u0430 \u0434\u0456\u0441\u0442\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825262
    m_Localized: "\u0426\u0456 \u0448\u0442\u0443\u043A\u0438 \u0434\u043E\u0432\u043E\u043B\u0456
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0457\u0445 \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0440\u0438\u0442\u0438
      \u0432 \u0441\u0442\u0430\u0440\u0438\u0445 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044F\u0445.
      \u042F \u0442\u0430\u043A \u0434\u0443\u043C\u0430\u044E, \u0443 \u0421\u0442\u0456\u0439\u043B\u0456
      \u043F\u043E-\u043B\u044E\u0431\u043E\u043C\u0443 \u0432\u043E\u043D\u0438
      \u043C\u0430\u044E\u0442\u044C \u0434\u0435\u0441\u044C \u0432\u0430\u043B\u044F\u0442\u0438\u0441\u044F.
      \u041E\u0441\u044C, \u0442\u0440\u0438\u043C\u0430\u0439 \u0441\u0445\u0435\u043C\u0438.
      \u0421\u043F\u0440\u043E\u0431\u0443\u0439 \u0437\u0430\u0444\u0456\u0433\u0430\u0447\u0438\u0442\u0438
      \u0456 \u0433\u0440\u0430\u043D\u0430\u0442\u0443, \u0456 \u043C\u0456\u043D\u0443,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0439
      \u0457\u0445 \u043D\u0430 \u043A\u043E\u043C\u0443-\u043D\u0435\u0431\u0443\u0434\u044C.
      \u0427\u0435\u043A\u0430\u044E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825263
    m_Localized: "\u041A\u0440\u0456\u043E-\u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825264
    m_Localized: "\u0429\u043E\u0434\u043E \u0442\u0432\u043E\u0454\u0457 \u0456\u0434\u0435\u0457
      \u043F\u0440\u043E \u043A\u0440\u0438\u0436\u0430\u043D\u0443 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0443...
      \u0412\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u0440\u043E\u0439\u0448\u043B\u0438
      \u0443\u0441\u043F\u0456\u0448\u043D\u043E. \u0406 \u0433\u0440\u0430\u043D\u0430\u0442\u0438,
      \u0456 \u043C\u0456\u043D\u0438 \u0432\u0438\u0431\u0443\u0445\u0430\u044E\u0442\u044C
      \u044F\u043A \u0442\u0440\u0435\u0431\u0430. \u0423\u0441\u0456, \u0445\u0442\u043E
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0432 \u0443 \u0437\u043E\u043D\u0443
      \u0432\u0438\u0431\u0443\u0445\u0443, \u043C\u0438\u0442\u0442\u0454\u0432\u043E
      \u043F\u043E\u043A\u0440\u0438\u0432\u0430\u044E\u0442\u044C\u0441\u044F \u043B\u044C\u043E\u0434\u043E\u043C,
      \u0456 \u0446\u0435, \u0441\u0445\u043E\u0436\u0435, \u043D\u0435 \u0434\u0443\u0436\u0435
      \u043F\u0440\u0438\u0454\u043C\u043D\u043E. \u0410 \u0442\u0456, \u044F\u043A\u0456
      \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0443
      \u0448\u043A\u043E\u0434\u0443, \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u043E\u0437\u0441\u0438\u043F\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0448\u043C\u0430\u0442\u043E\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825265
    m_Localized: "\u041D\u0456\u0448\u0442\u044F\u043A! \u0414\u0443\u043C\u0430\u044E,
      \u043C\u043E\u0457\u043C \u043A\u043B\u0456\u0454\u043D\u0442\u0430\u043C \u0446\u0435
      \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F. \u0427\u0443\u0434\u043E\u0432\u0430
      \u0440\u043E\u0431\u043E\u0442\u0430, @lp. \u041E\u0441\u044C, \u0442\u0440\u0438\u043C\u0430\u0439,
      \u0443 \u043C\u0435\u043D\u0435 \u0442\u0443\u0442 \u0437\u0430\u0432\u0430\u043B\u044F\u043B\u0430\u0441\u044F
      \u043F\u0430\u0440\u043E\u0447\u043A\u0430 \u0440\u0430\u0434\u0456\u043E-\u043C\u0456\u043D.
      \u0411\u043E\u043C\u0431\u043E\u0432\u0430 \u0440\u0456\u0447, \u044F \u0442\u043E\u0431\u0456
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825266
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0441\u0445\u0435\u043C\u0443
      \u0437\u0430\u0431\u0456\u0439\u043D\u043E\u0457 \u0433\u0440\u0430\u043D\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825267
    m_Localized: "\u041F\u0440\u043E\u043F\u043E\u043D\u0443\u044E \u043C\u0430\u0445\u043D\u0443\u0442\u0438\u0441\u044F
      \u0431\u0435\u0437 \u043A\u0438\u0434\u0430\u043B\u043E\u0432\u0430. \u0422\u043E\u043C\u0443,
      \u0445\u0442\u043E \u043F\u0440\u0438\u0442\u0430\u0440\u0430\u043D\u0438\u0442\u044C
      \u043C\u0435\u043D\u0456 \u043A\u043E\u043F\u0456\u044E \u0441\u0445\u0435\u043C\u0438
      \u0437\u0430\u0431\u0456\u0439\u043D\u043E\u0457 \u0433\u0440\u0430\u043D\u0430\u0442\u0438
      \u0437\u0456 \u0441\u043F\u0430\u0440\u043A\u043B-\u043A\u043E\u043B\u0438,
      \u0432\u0456\u0434\u0434\u0430\u043C \u0441\u0445\u0435\u043C\u0443 \u0441\u0432\u043E\u0454\u0457
      \u0432\u043B\u0430\u0441\u043D\u043E\u0457 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438
      - \u0449\u0435 \u0431\u0456\u043B\u044C\u0448 \u043A\u0440\u0443\u0442\u044F\u0446\u044C\u043A\u043E\u0457
      \u043C\u0456\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825268
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0441\u0445\u0435\u043C\u0443
      \u0441\u043F\u0430\u0440\u043A\u043B-\u0433\u0440\u0430\u043D\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825269
    m_Localized: "\u041F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F \u043A\u043E\u043F\u0456\u0454\u044E
      \u0441\u0445\u0435\u043C\u0438 \u0437\u0456 \u0421\u043C\u043E\u0443\u043A\u0456
      \u041F\u0456\u0442\u043E\u043C \u0442\u0430 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825270
    m_Localized: "\u041A\u0443\u0440\u0438\u043B\u044C\u043D\u0456 \u043F\u0440\u0438\u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825271
    m_Localized: "\u0420\u0435\u0430\u043B\u044C\u043D\u043E \u0434\u0456\u0441\u0442\u0430\u043B\u043E
      \u0432\u0436\u0435 \u043A\u0443\u0440\u0438\u0442\u0438 \u0446\u0456 \u0434\u0435\u0448\u0435\u0432\u0456
      \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u0438. \u0425\u0442\u043E \u043F\u0440\u0438\u0442\u044F\u0433\u043D\u0435
      \u043C\u0435\u043D\u0456 \u043A\u0443\u0440\u0435\u0432\u0430 \u043F\u043E\u043F\u0440\u0438\u043A\u043E\u043B\u044C\u043D\u0456\u0448\u0435,
      \u043E\u0442\u0440\u0438\u043C\u0430\u0454 \u0432\u0456\u0434 \u043C\u0435\u043D\u0435
      \u043F\u0430\u0447\u043A\u0443 \u043A\u0440\u0438\u0448\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825272
    m_Localized: "\u041A\u043E\u0441\u044F\u043A \u0456\u0437 \u0447\u0430\u0440\u0456\u0432\u043D\u043E\u0457
      \u0442\u0440\u0430\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825273
    m_Localized: "\u041B\u0438\u0441\u0442\u043E\u0432\u0438\u0439 \u0442\u044E\u0442\u044E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825274
    m_Localized: "\u0411\u0443\u043B\u044C\u0431\u0443\u043B\u044F\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825275
    m_Localized: "\u041B\u044E\u043B\u044C\u043A\u0430 \u0434\u043B\u044F \u043F\u0430\u043B\u0456\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825276
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043D\u0456
      \u0441\u0438\u0433\u0430\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825277
    m_Localized: "\u041F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0410\u0432\u0442\u043E\u0414\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825278
    m_Localized: "\u0421\u0445\u043E\u0436\u0435, \u0410\u0432\u0442\u043E\u0414\u043E\u043A
      \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043D\u0430\u043A\u0440\u0438\u0432\u0441\u044F.
      \u041F\u043E\u043B\u0430\u0433\u043E\u0434\u044C\u0442\u0435 \u0439\u043E\u0433\u043E
      \u0432\u0436\u0435 \u0445\u0442\u043E-\u043D\u0435\u0431\u0443\u0434\u044C!
      \u0410\u0434\u0436\u0435 \u0446\u0435 \u0443 \u0432\u0430\u0448\u0438\u0445
      \u0436\u0435 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825279
    m_Localized: "\u041F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0410\u0432\u0442\u043E\u0414\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825280
    m_Localized: "\u0420\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u043F\u0440\u043E
      \u0446\u0435 \u0414\u043E\u043A\u0443 \u0421\u0435\u043F\u0441\u0438\u0441\u0443
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825281
    m_Localized: "\u0417\u043B\u0430\u043C\u0430\u043D\u0438\u0439 \u0410\u0432\u0442\u043E\u0414\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825282
    m_Localized: "\u0413\u0435\u0439, \u0414\u043E\u043A! \u0410 \u0449\u043E \u0442\u0430\u043C
      \u0456\u0437 \u0446\u0438\u043C \u0434\u0438\u0432\u043D\u0438\u043C \u0440\u043E\u0431\u043E\u0442\u043E\u043C,
      \u0449\u043E \u0441\u0442\u043E\u0457\u0442\u044C \u0443 \u043A\u0443\u0442\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825283
    m_Localized: "\u0426\u0435 \u0410\u0432\u0442\u043E\u0414\u043E\u043A - \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0430,
      \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u043E\u0432\u0430\u043D\u0430
      \u043C\u0435\u0434\u0438\u0447\u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0456\u044F.
      \u041E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u0438\u0439 \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u043C
      \u043C\u043E\u0434\u0443\u043B\u0435\u043C \u0456 \u043F\u043E\u0432\u043D\u0438\u043C
      \u043D\u0430\u0431\u043E\u0440\u043E\u043C \u0445\u0456\u0440\u0443\u0440\u0433\u0456\u0447\u043D\u0438\u0445
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432. \u041F\u043E
      \u0441\u0443\u0442\u0456, \u0432\u0456\u043D \u0441\u0430\u043C \u043C\u043E\u0436\u0435
      \u0432\u0438\u043B\u0456\u043A\u0443\u0432\u0430\u0442\u0438 \u043F\u0430\u0446\u0456\u0454\u043D\u0442\u0430
      \u0432\u0456\u0434 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u0445\u0432\u043E\u0440\u043E\u0431
      \u0456 \u0442\u0440\u0430\u0432\u043C \u0431\u0435\u0437 \u0443\u0447\u0430\u0441\u0442\u0456
      \u043B\u0456\u043A\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825284
    m_Localized: "\u0410\u043B\u0435 \u0437\u0430\u0440\u0430\u0437 \u0432\u0456\u043D
      \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825285
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0412\u0456\u043D
      \u0456 \u0440\u0430\u043D\u0456\u0448\u0435 \u0431\u0430\u0440\u0430\u0445\u043B\u0438\u0432,
      \u0430 \u0440\u0456\u043A \u0442\u043E\u043C\u0443 \u0437\u043B\u0430\u043C\u0430\u0432\u0441\u044F
      \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0412\u0456\u043D\u0440\u0456
      \u043D\u0435 \u0432\u043C\u0456\u0454 \u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u043F\u043E\u0434\u0456\u0431\u043D\u0443 \u0430\u043F\u0430\u0440\u0430\u0442\u0443\u0440\u0443,
      \u0430 \u043A\u0440\u0430\u0449\u0435 \u0437\u0430 \u043D\u0435\u0457 \u0432
      \u0440\u0435\u043C\u043E\u043D\u0442\u0456 \u0432 \u043D\u0430\u0441 \u043D\u0456\u0445\u0442\u043E
      \u043D\u0435 \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u0454\u0442\u044C\u0441\u044F.
      \u042F \u043D\u0430\u043C\u0430\u0433\u0430\u0432\u0441\u044F \u0437\u0432\u0435\u0440\u0442\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u043F\u0440\u043E\u0457\u0436\u0434\u0436\u0438\u0445, \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
      \u0442\u0438 \u0431\u0430\u0447\u0438\u0448. \u0422\u0430\u043A \u0456 \u0441\u0442\u043E\u0457\u0442\u044C
      \u0432\u0456\u0434\u0442\u043E\u0434\u0456, \u043F\u0438\u043B \u0437\u0431\u0438\u0440\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825286
    m_Localized: "\u041C\u043E\u0436\u0435, \u0442\u0438 \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u0454\u0448\u0441\u044F
      \u0432 \u0440\u0435\u043C\u043E\u043D\u0442\u0456 \u043A\u0440\u0430\u0449\u0435,
      \u043D\u0456\u0436 \u0443 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825287
    m_Localized: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0442\u043E
      \u044F \u043C\u043E\u0436\u0443... \u0430\u043B\u0435 \u0449\u043E \u044F \u043E\u0442\u0440\u0438\u043C\u0430\u044E,
      \u044F\u043A\u0449\u043E \u0432\u0441\u0435 \u0432\u0438\u0439\u0434\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825288
    m_Localized: "\u042F \u0442\u043E\u0431\u0456 \u0434\u043E\u0437\u0432\u043E\u043B\u044E
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u043E\u043C \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E. \u0423
      \u0440\u043E\u0431\u043E\u0447\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456
      \u0432\u0456\u043D \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u043A\u043E\u043D\u043A\u0443\u0440\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u0456\u0437 \u043C\u043E\u0457\u043C\u0438
      \u043D\u0430\u0432\u0438\u0447\u043A\u0430\u043C\u0438, \u0445\u043E\u0447
      \u0431\u0438 \u044F\u043A \u043C\u0435\u043D\u0456 \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F
      \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u0433\u043E, \u0442\u043E\u0436
      \u0443 \u043F\u0440\u043E\u0433\u0440\u0430\u0448\u0456 \u0442\u0438 \u043D\u0435
      \u0437\u0430\u043B\u0438\u0448\u0438\u0448\u0441\u044F. \u0404\u0434\u0438\u043D\u0435
      - \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438 \u0446\u0435\u0439
      \u0430\u043F\u0430\u0440\u0430\u0442 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0442\u0430\u043A \u0437\u0432\u0430\u043D\u0438\u0439 \u0431\u0456\u043E\u0433\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825289
    m_Localized: "\u0429\u043E \u0442\u0430\u043A\u0435 \u0431\u0456\u043E\u0433\u0435\u043B\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825290
    m_Localized: "\u0426\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0439 \u0431\u0456\u043E\u0445\u0456\u043C\u0456\u0447\u043D\u0438\u0439
      \u0441\u043A\u043B\u0430\u0434, \u0449\u043E \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0454
      \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0456\u044E \u0442\u043A\u0430\u043D\u0438\u043D.
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0439\u043E\u0433\u043E, \u0449\u043E\u0431 \u0437\u0430\u0433\u043E\u044E\u0432\u0430\u0442\u0438
      \u0440\u0430\u043D\u0438 \u0456 \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0442\u0438
      \u0440\u043E\u0437\u0440\u0456\u0437\u0438 \u043F\u0456\u0441\u043B\u044F \u0445\u0456\u0440\u0443\u0440\u0433\u0456\u0447\u043D\u043E\u0433\u043E
      \u0432\u0442\u0440\u0443\u0447\u0430\u043D\u043D\u044F \u0431\u0435\u0437 \u043D\u0430\u043A\u043B\u0430\u0434\u0435\u043D\u043D\u044F
      \u0448\u0432\u0456\u0432, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0441\u0438\u043D\u0442\u0435\u0437\u0443\u0432\u0430\u0442\u0438
      \u0441\u0442\u0438\u043C\u0443\u043B\u044E\u044E\u0447\u0443 \u0431\u0456\u043E\u043C\u0430\u0441\u0443,
      \u044F\u043A\u0430 \u0437\u0430 \u0441\u0432\u043E\u0457\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043C
      \u0437\u0456\u043B\u043B\u044F\u043C. \u0411\u0435\u0437 \u043D\u0435\u0457
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A \u043C\u043E\u0436\u0435 \u0445\u0456\u0431\u0430
      \u0449\u043E \u0440\u043E\u0437\u043F\u043E\u0440\u043E\u0442\u0438 \u0442\u043E\u0431\u0456
      \u0436\u0438\u0432\u0456\u0442 \u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438
      \u0432 \u0442\u0430\u043A\u043E\u043C\u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456
      \u043B\u0435\u0436\u0430\u0442\u0438. \u0423 \u043C\u0435\u043D\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0442\u0440\u043E\u0445\u0438 \u0431\u0456\u043E\u0433\u0435\u043B\u044E,
      \u0456 \u044F \u0432\u0456\u0434\u0434\u0430\u043C \u0439\u043E\u0433\u043E
      \u0442\u043E\u0431\u0456, \u044F\u043A\u0449\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0448
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A \u0443 \u0441\u0442\u0440\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825291
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u044F \u043F\u043E\u0434\u0438\u0432\u043B\u044E\u0441\u044F,
      \u0449\u043E \u043C\u043E\u0436\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825292
    m_Localized: "\u0410\u0432\u0442\u043E\u0414\u043E\u043A \u0437\u043D\u043E\u0432\u0443
      \u043F\u0440\u0430\u0446\u044E\u0454"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825293
    m_Localized: "\u041F\u0440\u0430\u0446\u044E\u0454, \u0434\u043E\u043A! \u042F
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u043B\u0430 \u0442\u0432\u043E\u0433\u043E
      \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u0430, \u0432\u0456\u043D
      \u0442\u0435\u043F\u0435\u0440 \u044F\u043A \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825294
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u044F\u043A \u0431\u0438
      \u0442\u043E\u0431\u0456 \u0446\u0435 \u043C'\u044F\u043A\u0448\u0435 \u0434\u043E\u043D\u0435\u0441\u0442\u0438...
      \u041D\u0443, \u0441\u043A\u0430\u0436\u0456\u043C\u043E \u0442\u0430\u043A:
      \u0443\u0432\u0435\u0441\u044C \u0442\u043E\u0439 \u0447\u0430\u0441, \u0449\u043E
      \u0442\u0438 \u0432\u043E\u0437\u0438\u043B\u0430\u0441\u044F \u0437 \u0446\u0456\u0454\u044E
      \u043C\u0430\u0448\u0438\u043D\u043E\u044E, \u044F \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0432
      \u0432 \u043E\u0434\u043D\u0456\u0439 \u043A\u0456\u043C\u043D\u0430\u0442\u0456
      \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0442\u043E\u0431\u043E\u044E.
      \u041D\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456 \u043F\u0456\u0432\u043C\u0435\u0442\u0440\u0430.
      \u0420\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0434\u043E \u0447\u043E\u0433\u043E
      \u044F \u0445\u0438\u043B\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825295
    m_Localized: "\u0410\u043B\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u0456 \u0437\u0430
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u0443 \u0440\u043E\u0431\u043E\u0442\u0443.
      \u041F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u0430
      \u0434\u043E \u043B\u0430\u0434\u0443 - \u0446\u0435 \u0432\u0435\u043B\u044C\u043C\u0438
      \u0456\u0441\u0442\u043E\u0442\u043D\u0438\u0439 \u0432\u043D\u0435\u0441\u043E\u043A
      \u0443 \u0440\u043E\u0431\u043E\u0442\u0443 \u043C\u043E\u0454\u0457 \u043A\u043B\u0456\u043D\u0456\u043A\u0438.
      \u042F\u043A \u044F \u0439 \u043E\u0431\u0456\u0446\u044F\u0432, \u0437 \u0446\u044C\u043E\u0433\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442\u0443 \u0442\u0438 \u043C\u0430\u0454\u0448
      \u043F\u043E\u0432\u043D\u0435 \u043F\u0440\u0430\u0432\u043E \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u043E\u043C \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u0442\u0438 \u0437\u0430 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043D\u0443
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0443. \u041A\u0440\u0456\u043C
      \u0442\u043E\u0433\u043E, \u043E\u0441\u044C \u0443\u0441\u0456 \u043F'\u044F\u0442\u044C
      \u043B\u0456\u0442\u0440\u0456\u0432 \u0431\u0456\u043E\u0433\u0435\u043B\u044E,
      \u0449\u043E \u0432 \u043C\u0435\u043D\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F.
      \u042F\u043A\u0449\u043E \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0449\u0435, \u043C\u043E\u0436\u0435\u0448 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0439\u043E\u0433\u043E \u0441\u0435\u0440\u0435\u0434
      \u0440\u0443\u0457\u043D \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445
      \u043A\u043B\u0456\u043D\u0456\u043A \u0430\u0431\u043E \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u0447\u043D\u0438\u0445
      \u0437\u0430\u0432\u043E\u0434\u0456\u0432, \u0456\u043D\u0448\u0438\u0445
      \u0434\u0436\u0435\u0440\u0435\u043B \u0431\u0456\u043E\u0433\u0435\u043B\u044E
      \u0437\u0430\u0440\u0430\u0437 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E
      \u043D\u0435 \u0456\u0441\u043D\u0443\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825296
    m_Localized: "\u0410 \u044F\u043A \u0449\u043E\u0434\u043E \u0437\u043D\u0438\u0436\u043A\u0438
      \u043D\u0430 \u043C\u0435\u0434\u0438\u0447\u043D\u0456 \u043F\u043E\u0441\u043B\u0443\u0433\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825297
    m_Localized: "\u041D\u0443 \u0432\u0436\u0435 \u043D\u0456, \u043E\u0441\u044C
      \u043F\u0440\u043E \u0446\u0435 \u043C\u0438 \u043D\u0435 \u0434\u043E\u043C\u043E\u0432\u043B\u044F\u043B\u0438\u0441\u044F.
      \u0423 \u043C\u0435\u043D\u0435 \u0434\u043B\u044F \u0432\u0441\u0456\u0445
      \u043E\u0434\u043D\u0430 \u0446\u0456\u043D\u0430, \u0456 \u043F\u043E-\u0456\u043D\u0448\u043E\u043C\u0443
      \u043D\u0435 \u0431\u0443\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825300
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u0442\u0438 20 \u043F\u043E\u0440\u0446\u0456\u0439
      \u0440\u0438\u0431'\u044F\u0447\u043E\u0433\u043E \u0436\u0438\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825301
    m_Localized: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0432 \u0443 \u0441\u0442\u0430\u0440\u043E\u043C\u0443
      \u043D\u0430\u0443\u043A\u043E\u0432\u043E\u043C\u0443 \u0436\u0443\u0440\u043D\u0430\u043B\u0456
      \u043F\u0440\u043E \u043A\u043E\u0440\u0438\u0441\u0442\u044C \u0440\u0438\u0431'\u044F\u0447\u043E\u0433\u043E
      \u0436\u0438\u0440\u0443, \u0445\u043E\u0447\u0443 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438
      \u0446\u044E \u0442\u0435\u043E\u0440\u0456\u044E \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E.
      \u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0432 \u0442\u043E\u043C\u0443,
      \u0449\u043E \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0430 \u0440\u0456\u0447\u043A\u0430
      \u0437\u0430 \u0441\u043E\u0442\u043D\u0456 \u043C\u0438\u043B\u044C \u0432\u0456\u0434
      \u043D\u0430\u0441. \u0422\u043E\u043C\u0443 \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u043A\u0443\u043F\u0443\u0432\u0430\u0442\u0438 \u0436\u0438\u0440 \u0437\u0430
      \u043F\u043E\u0442\u0440\u0456\u0439\u043D\u0443 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C.
      \u0425\u0442\u043E \u0437\u0430\u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0454
      \u0440\u043E\u0437\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u0439 \u0436\u0438\u0440
      \u0440\u0430\u0434\u0441\u0432\u0456\u043D\u0430 \u043F\u0456\u0434 \u0432\u0438\u0433\u043B\u044F\u0434\u043E\u043C
      \u0440\u0438\u0431'\u044F\u0447\u043E\u0433\u043E, \u0441\u0442\u0430\u043D\u0435
      \u043F\u0456\u0434\u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u043C \u0434\u043B\u044F
      \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
      \u0442\u0438\u0445 \u043C\u0456\u043A\u0441\u0442\u0443\u0440 \u0431\u0435\u0437
      \u0435\u0442\u0438\u043A\u0435\u0442\u043E\u043A, \u0449\u043E \u0431\u0443\u043B\u0438
      \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456 \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825302
    m_Localized: "\u0414\u043E\u0431\u0443\u0442\u0438 \u0440\u0438\u0431'\u044F\u0447\u0438\u0439
      \u0436\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825303
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0440\u0438\u0431'\u044F\u0447\u0438\u0439
      \u0436\u0438\u0440 \u0456 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825304
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u0430\u0446\u044E\u044E\u0447\u0438\u0439
      \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825305
    m_Localized: "\u041A\u0443\u043F\u043B\u044E \u043D\u0435\u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0438\u0439
      \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D.
      \u0417\u043D\u0430\u044E, \u0449\u043E \u0440\u0456\u0447 \u0446\u0456\u043D\u043D\u0430
      \u0456 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0430, \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443
      \u043E\u0431\u0456\u0446\u044F\u044E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825306
    m_Localized: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0439
      \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825307
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D
      \u0414\u043E\u043A\u0443 \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825308
    m_Localized: "\u0417\u0434\u043E\u0431\u0443\u0442\u0438 \u0440\u0435\u0446\u0435\u043F\u0442\u0438
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0457 \u0445\u0456\u043C\u0456\u0457"
