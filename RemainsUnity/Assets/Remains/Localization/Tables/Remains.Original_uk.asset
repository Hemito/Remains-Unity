      \u0442\u0430 \u0441\u0445\u043E\u0432\u0430\u043D\u043A\u0438. \u0406\u043D\u043E\u0434\u0456
      \u0442\u0430\u043A\u0456 \u043C\u0456\u0441\u0446\u044F \u043C\u043E\u0436\u0443\u0442\u044C
      \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F \u0437\u0430 \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u0438\u043C\u0438
      \u0441\u0442\u0456\u043D\u0430\u043C\u0438, \u044F\u043A\u0456 \u043B\u0435\u0433\u043A\u043E
      \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u0431\u0438\u0442\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629742
    m_Localized: "\u0412\u0438 \u0431 \u0445\u043E\u0442\u0456\u043B\u0438 \u0437\u0430\u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u0442\u0438
