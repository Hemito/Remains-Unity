  - m_Id: 2733629536
    m_Localized: "\u0420\u0443\u0457\u043D\u0438 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629537
    m_Localized: "\u041A\u043E\u043B\u0438\u0448\u043D\u044F \u0441\u0442\u043E\u043B\u0438\u0446\u044F
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457. \u041D\u0438\u043D\u0456
      \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0430 \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u043E\u044E
      \u0420\u043E\u0436\u0435\u0432\u043E\u044E \u0425\u043C\u0430\u0440\u043E\u044E
      \u0456 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0430 \u0440\u0456\u0437\u043D\u0438\u043C\u0438
      \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629538
    m_Localized: "\u0412\u0435\u0436\u0430 \u041C\u0422\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629539
    m_Localized: "\u0412\u0438\u0441\u043E\u043A\u0438\u0439, \u0430\u043B\u0435
      \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0438\u0439
      \u0445\u043C\u0430\u0440\u043E\u0447\u043E\u0441, \u0443 \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443
      - \u043E\u0434\u043D\u0435 \u0437 \u0440\u0435\u0433\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0445
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u044C \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0422\u0430\u0454\u043C\u043D\u0438\u0445 \u041D\u0430\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629540
    m_Localized: "\u041B\u0430\u0431\u0456\u0440\u0438\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629541
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u0432\u0438\u0445\u0456\u0434
      \u0456\u0437 \u043B\u0430\u0431\u0456\u0440\u0438\u043D\u0442\u0443. \u041F\u043E\u0440\u0430\u0434\u0430:
      \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u043F\u0440\u043E\u043B\u0430\u0437\u0438\u0442\u0438
      \u0443 \u0432\u0443\u0437\u044C\u043A\u0456 \u043F\u0440\u043E\u0445\u043E\u0434\u0438
      \u043D\u0430 \u0432\u0438\u0441\u043E\u0442\u0456 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u043B\u043E\u043A\u0443, \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435
      [W]+[A] \u0430\u0431\u043E [W]+[D]."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629542
    m_Localized: "\u0412\u0438 \u043B\u0435\u0433\u043A\u043E \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0439 \u0448\u043B\u044F\u0445,
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432\u0448\u0438 \u0437\u0456\u043B\u043B\u044F
      \u0456\u043D\u0444\u0440\u0430\u0437\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629543
    m_Localized: "\u0426\u0430\u0440\u0441\u0442\u0432\u043E \u0441\u043B\u0438\u043C\u0430\u043A\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629544
    m_Localized: "\u0414\u0456\u0439\u0434\u0456\u0442\u044C \u0434\u043E \u043A\u0456\u043D\u0446\u044F,
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u044E\u0447\u0438 \u043D\u0430
      \u0441\u043B\u0438\u0437. \u041F\u043E\u0440\u0430\u0434\u0430: \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u043A\u043E\u0441\u0442\u044E\u043C \u0445\u0456\u043C\u0437\u0430\u0445\u0438\u0441\u0442\u0443
      \u0434\u043B\u044F \u043C\u0456\u043D\u0456\u043C\u0456\u0437\u0430\u0446\u0456\u0457
      \u0448\u043A\u043E\u0434\u0438 \u0432\u0456\u0434 \u043A\u0438\u0441\u043B\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629545
    m_Localized: "\u0413\u0430\u043C\u043C\u0430-\u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629546
    m_Localized: "\u041F\u043E\u0434\u043E\u043B\u0430\u0439\u0442\u0435 \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0443
      \u0437\u043E\u043D\u0443, \u043D\u0435 \u043F\u043E\u043C\u0435\u0440\u0448\u0438
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443. \u041F\u043E\u0440\u0430\u0434\u0430:
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0432\u0441\u0456 \u043D\u0430\u044F\u0432\u043D\u0456 \u0437\u0430\u0441\u043E\u0431\u0438
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u0456\u0434 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629547
    m_Localized: "\u0414\u043B\u044F \u0441\u0442\u0440\u0438\u0431\u043A\u0456\u0432
      \u0443 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u043C\u0443
      \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0440\u0438\u0432\u043E\u043A [Shift]+[A],[A] \u0430\u0431\u043E [Shift]+[D],[D]."
