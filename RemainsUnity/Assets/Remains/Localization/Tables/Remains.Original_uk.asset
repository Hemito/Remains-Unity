      m_Items: []
  - m_Id: 2729436423
    m_Localized: "\u0410\u043B\u0445\u0456\u043C\u0456\u0447\u043D\u0456 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438,
      \u0442\u0440\u0430\u0432\u0438, \u0447\u0430\u0441\u0442\u0438\u043D\u0438
      \u0442\u0456\u043B \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432. \u0423\u0441\u0435
      \u0442\u0435, \u0449\u043E \u0441\u0442\u0430\u043D\u0435 \u0432 \u043F\u0440\u0438\u0433\u043E\u0434\u0456
      \u0434\u043B\u044F \u0437\u0456\u043B\u043B\u0454\u0432\u0430\u0440\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436424
    m_Localized: "\u0417\u0430\u043B\u0438\u0448\u0442\u0435 \u0447\u0430\u0441\u0442\u0438\u043D\u0443
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 \u0437\u0431\u0440\u043E\u0439\u043E\u0432\u043E\u043C\u0443
      \u0441\u0442\u0435\u043D\u0434\u0456 \u0442\u0430 \u0432\u0438\u043A\u043B\u0430\u0434\u0456\u0442\u044C
      \u043D\u0435\u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0440\u0435\u0447\u0456
      \u0443 \u0441\u0445\u043E\u0432\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436425
    m_Localized: "\u0412\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u0456
      \u0432\u0430\u0436\u043A\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438.
      \u0423 \u0442\u0430\u043A\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456
      \u0432\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0431\u0456\u0433\u0430\u0442\u0438
      \u0456 \u0437\u0434\u0456\u0439\u0441\u043D\u044E\u0432\u0430\u0442\u0438 \u0440\u0438\u0432\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436426
    m_Localized: "\u0412\u0438 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u0456
      \u0432\u0430\u0436\u043A\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438.
      \u0423 \u0442\u0430\u043A\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456
      \u0432\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043A\u0440\u043E\u043A\u043E\u043C \u0456
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436427
    m_Localized: "\u0412\u0438 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u0456
      \u0432\u0430\u0436\u043A\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438,
      \u0449\u043E \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u043D\u0456 \u043A\u0440\u043E\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436428
    m_Localized: "\u0421\u0443\u043F\u0443\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436429
