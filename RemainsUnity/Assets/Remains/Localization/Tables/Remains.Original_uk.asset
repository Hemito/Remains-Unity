    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u0438\u0439 \u043C\u043E\u0434\u0443\u043B\u044C
      \u0434\u043B\u044F \u041F\u0456\u043F\u0411\u0430\u043A\u0430, \u0449\u043E
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0443\u0432\u0430\u0442\u0438
      \u043F\u0456\u0434\u0431\u0456\u0440 \u043F\u0430\u0440\u043E\u043B\u044F.
      \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454 \u0432\u0430\u0448 \u0440\u0456\u0432\u0435\u043D\u044C
      \u0437\u043B\u043E\u043C\u0443 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432
      \u043D\u0430 #1."
