  - m_Id: 2733629514
    m_Localized: "\u041B\u0456\u0433\u0432\u043E \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629515
    m_Localized: "\u0420\u0443\u0457\u043D\u0438, \u0432 \u044F\u043A\u0438\u0445
      \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043B\u0430\u0441\u044F \u0432\u0435\u043B\u0438\u043A\u0430
      \u0440\u0435\u0439\u0434\u0435\u0440\u0441\u044C\u043A\u0430 \u0431\u0430\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629516
    m_Localized: "\u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629517
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F,
      \u0432 \u044F\u043A\u043E\u043C\u0443 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043B\u0438
      \u0441\u0432\u043E\u044E \u0431\u0430\u0437\u0443 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456.
      \u0422\u0443\u0442 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0432\u0445\u0456\u0434 \u0434\u043E \u0421\u0442\u0456\u0439\u043B\u0430
      88."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629518
    m_Localized: "\u0422\u0430\u0431\u0456\u0440 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439
      \u041F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2733629519
    m_Localized: "\u041E\u0434\u043D\u0435 \u0437 \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0445 \u043C\u0456\u0441\u0446\u044C,
      \u0434\u0435 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0442\u0438,
      \u0437\u0446\u0456\u043B\u0438\u0442\u0438 \u0440\u0430\u043D\u0438 \u0456
      \u043F\u043E\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629520
    m_Localized: "\u0417\u0430\u0432\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629521
    m_Localized: "\u0427\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0438\u0439
      \u0437\u0430\u0432\u043E\u0434\u0441\u044C\u043A\u0438\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
      \"\u041C\u0435\u0439\u043D\u0422\u0435\u043A\", \u0443 \u044F\u043A\u043E\u043C\u0443
      \u043C\u0435\u0448\u043A\u0430\u044E\u0442\u044C \u0440\u0435\u0439\u0434\u0435\u0440\u0438.
      \u041A\u0440\u0456\u043C \u043D\u0438\u0445, \u0442\u0430\u043A\u043E\u0436
      \u0441\u043B\u0456\u0434 \u043F\u043E\u0431\u043E\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0456 \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432,
      \u0449\u043E \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044E\u0442\u044C\u0441\u044F
      \u043F\u043E\u0434\u0435\u043A\u0443\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629522
    m_Localized: "\u0412\u0456\u0434\u0434\u0456\u043B \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629523
    m_Localized: "\u041C\u043E\u0437\u043A\u043E\u0432\u0438\u0439 \u0446\u0435\u043D\u0442\u0440
      \u0437\u0430\u0432\u043E\u0434\u0443 \"\u041C\u0435\u0439\u043D\u0422\u0435\u043A\",
      \u0434\u0435 \u0440\u0430\u043D\u0456\u0448\u0435 \u0432\u0435\u043B\u0438\u0441\u044F
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438.
      \u0414\u0435\u0441\u044C \u0442\u0443\u0442 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0438\u0439
      \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629524
    m_Localized: "\u041A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629525
    m_Localized: "\u0421\u0442\u0456\u0447\u043D\u0456 \u0442\u0443\u043D\u0435\u043B\u0456,
      \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0456 \u043D\u0435\u0447\u0438\u0441\u0442\u043E\u0442\u0430\u043C\u0438,
      \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u0438\u043C\u0438 \u0442\u0430 \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u043C\u0438
      \u0432\u0456\u0434\u0445\u043E\u0434\u0430\u043C\u0438. \u0422\u0443\u0442
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u043B\u0456\u0433\u0432\u043E
      \u0440\u0456\u0437\u043D\u0438\u0445 \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432,
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443
      \u0441\u0435\u0440\u0435\u0434 \u044F\u043A\u0438\u0445 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u0434\u0438\u043A\u0456 \u0433\u0443\u043B\u0456. \u0411\u0430\u0433\u0430\u0442\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0456\u0432 \u0456 \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u044C
      \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629526
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u0435 \u0441\u0442\u0456\u0439\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629527
    m_Localized: "\u041C\u0435\u0448\u043A\u0430\u043D\u0446\u0456 \u0446\u044C\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430 \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438
      \u0431\u0430\u0433\u0430\u0442\u043E \u0440\u043E\u043A\u0456\u0432 \u0442\u043E\u043C\u0443,
      \u0430 \u0442\u0456, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
      \u0432 \u0436\u0438\u0432\u0438\u0445, \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044F
      \u043D\u0430 \u0434\u0438\u043A\u0438\u0445 \u0433\u0443\u043B\u0456\u0432.
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443
      \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0456 \u0442\u0443\u0440\u0435\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629528
    m_Localized: "\u042F\u0434\u0440\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F
      \u0441\u0442\u0456\u0439\u043B\u0430 88"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629529
    m_Localized: "\u0422\u0443\u0442 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0456
      \u043A\u0430\u0431\u0456\u043D\u0435\u0442 \u0414\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u0438,
      \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u043E\u0444\u0456\u0441 \u043E\u0445\u043E\u0440\u043E\u043D\u0438,
      \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0439 \u0441\u0435\u0440\u0432\u0435\u0440
      \u0456 \u044F\u0434\u0440\u043E \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430,
      \u0449\u043E \u0434\u0430\u0454 \u0432\u0441\u044C\u043E\u043C\u0443 \u0421\u0442\u0456\u0439\u043B\u0443
      \u0435\u043D\u0435\u0440\u0433\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629530
    m_Localized: "\u0413\u0430\u0440\u0430\u0436\u0456 \u0425\u0435\u043D\u043A\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629531
    m_Localized: "\u041C\u0456\u0441\u0446\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456
      \u0437\u0430 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F\u043C \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629532
    m_Localized: "\u0420\u0443\u0457\u043D\u0438 \u041C\u0435\u0439\u043D\u0433\u0435\u0442\u0442\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629533
    m_Localized: "\u0423 \u0440\u0443\u0457\u043D\u0430\u0445 \u041C\u0435\u0439\u043D\u0433\u0435\u0442\u0442\u0435\u043D\u0430
      \u0431\u0435\u0437\u043B\u0456\u0447 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A.
      \u0422\u0443\u0442 \u0447\u0430\u0441\u0442\u043E \u043C\u043E\u0436\u043D\u0430
      \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438 \u0437\u0430\u0433\u043E\u043D\u0438
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u0456 \u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456\u0432, \u0430 \u0432\u0456\u0434\u043D\u0435\u0434\u0430\u0432\u043D\u0430
      \u043D\u0430\u0434\u0445\u043E\u0434\u044F\u0442\u044C \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u0442\u0443\u0442 \u0437'\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u0433\u0440\u0443\u043F\u0438 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432
      \u0411\u043E\u0433\u0438\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629534
    m_Localized: "\u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430 \u0431\u0430\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629535
    m_Localized: "\u0423 \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443 - \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430
      \u0431\u0430\u0437\u0430, \u0442\u0435\u043F\u0435\u0440 - \u0431\u0430\u0437\u0430
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432."
