      \u0431\u0443\u0434\u0435 \u0431\u0440\u043E\u043D\u044F, \u044F\u043A\u0430
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438\u043C\u0435 \u0442\u0456\u043B\u043E
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430, \u0430 \u0439 \u0434\u043E\u0434\u0430\u0441\u0442\u044C
      \u0439\u043E\u043C\u0443 \u0441\u0438\u043B\u0438 \u043D\u0435\u0441\u0442\u0438
      \u0457\u0457, \u043D\u0430\u0447\u0435 \u043F\u0443\u0445. \u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0443
      \u0441\u0445\u0435\u043C\u0443 \u0431\u0440\u043E\u043D\u0456 \u0432\u0436\u0435
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E, \u0456 \u0442\u0435\u043F\u0435\u0440
      \u043A\u043E\u0436\u043D\u043E\u043C\u0443 \u0437\u0430\u0434\u0456\u044F\u043D\u043E\u043C\u0443
      \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0456 \u043F\u0456\u0434\u043F\u0440\u0438\u0454\u043C\u0441\u0442\u0432\u0443
      \u0434\u043E\u0440\u0443\u0447\u0430\u044E\u0442\u044C \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0443
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437 \u0457\u0457 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432.
      \u041D\u0430\u0448\u043E\u043C\u0443 \u0437\u0430\u0432\u043E\u0434\u0443 \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043E
      \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0443 \u0447\u0430\u0441\u0442\u0438\u043D\u0443:
      \u043C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
