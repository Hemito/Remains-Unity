  - m_Id: 2733629629
    m_Localized: "\u0411\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629630
    m_Localized: "\u0422\u0435\u043C\u043D\u0438\u0439, \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u043F\u0440\u043E\u0445\u0456\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629631
    m_Localized: "\u041D\u0435 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0439\u0442\u0435
      \u0446\u0456 \u0434\u0432\u0435\u0440\u0456, \u0437\u0430 \u043D\u0438\u043C\u0438
      \u043D\u0430 \u0432\u0430\u0441 \u0447\u0435\u043A\u0430\u0454 \u0441\u043C\u0435\u0440\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629632
    m_Localized: "\u0422\u0430\u0454\u043C\u043D\u0438\u0447\u0438\u0439 \u043F\u0456\u0434\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629633
    m_Localized: "\u0414\u0438\u0432\u043D\u0435 \u043C\u0456\u0441\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629634
    m_Localized: "\u0422\u0430\u0431\u0456\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629635
    m_Localized: "\u0422\u0430\u0431\u0456\u0440 \u0434\u043B\u044F \u0431\u0440\u0430\u043D\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629636
    m_Localized: "\u0414\u0435\u0441\u044C \u043D\u0430 \u0448\u043B\u044F\u0445\u0443
      \u0434\u043E \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629637
    m_Localized: "\u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629638
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F,
      \u0434\u0435 \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u043F\u0440\u0438\u0442\u0443\u043B\u043E\u043A
      \u043D\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u0430 \u0433\u0440\u0443\u043F\u0430
      \u0437\u0435\u0431\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629639
    m_Localized: "\u0412\u043E\u0434\u043E\u043E\u0447\u0438\u0441\u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629640
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0430 \u0431\u0443\u0434\u0456\u0432\u043B\u044F,
      \u0434\u0435 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043B\u0438 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0438\u0439
      \u0442\u0430\u0431\u0456\u0440 \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u043F\u0456\u0434 \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F\u043C
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629641
    m_Localized: "\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0421\u0442\u0438\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629642
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u043E\u0444\u0456\u0441
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437 \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432
      \u0447\u0430\u0441\u0456\u0432 \u0412\u0435\u043B\u0438\u043A\u043E\u0457 \u0412\u0456\u0439\u043D\u0438
      - \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0421\u0442\u0438\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629643
    m_Localized: "\u0411\u0443\u043D\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629644
    m_Localized: "\u0411\u0443\u043D\u043A\u0435\u0440-\u0441\u0445\u043E\u0432\u0438\u0449\u0435
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432.
      \u0417\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u0439 \u043A\u0440\u0430\u0449\u0435
      \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0456\u043D\u0448\u0438\u0439
      \u043E\u0431'\u0454\u043A\u0442 \u0443 \u0440\u0435\u0433\u0456\u043E\u043D\u0456.
      \u041D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u0441\u044F \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0441\u044E\u0434\u0438 - \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454
      \u0431\u0435\u0437\u0443\u043C\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629645
    m_Localized: "\u041E\u0444\u0456\u0441 \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A,
      \u0441\u043B\u0443\u0436\u0431\u043E\u0432\u0438\u0439 \u0432\u0445\u0456\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629646
    m_Localized: "\u041B\u0456\u0433\u0432\u043E \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629647
    m_Localized: "\u0411\u0438\u0442\u0432\u0430 \u0437\u0430 \u0417\u0430\u0432\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629648
    m_Localized: "\u0411\u0438\u0439\u0442\u0435\u0441\u044F \u0437 \u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
      \u0445\u0432\u0438\u043B\u044F\u043C\u0438 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432,
      \u0449\u043E \u0437'\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u043E\u0434\u043D\u0430 \u0437\u0430 \u043E\u0434\u043D\u043E\u044E. \u0427\u0430\u0441,
      \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u0438\u0439 \u043D\u0430 \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F
      \u043A\u043E\u0436\u043D\u043E\u0457 \u0445\u0432\u0438\u043B\u0456, \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0438\u0439.
      \u041D\u0435 \u0437\u0430\u0433\u0438\u043D\u044C\u0442\u0435 \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0456,
      \u0456\u043D\u0430\u043A\u0448\u0435 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u043E\u0447\u0430\u0442\u0438 \u0437\u0430\u043D\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629649
    m_Localized: "\u0411\u0438\u0442\u0432\u0430 \u0437\u0430 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629650
    m_Localized: "\u0411\u0438\u0442\u0432\u0430 \u0437\u0430 \u0421\u0442\u0456\u0439\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629651
    m_Localized: "\u0411\u0438\u0442\u0432\u0430 \u0437\u0430 \u041C\u0435\u0439\u043D\u0433\u0435\u0442\u0442\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629652
    m_Localized: "\u0411\u0438\u0442\u0432\u0430 \u0437\u0430 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629653
    m_Localized: "\u0411\u043E\u0441 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629654
    m_Localized: "\u0411\u043E\u0441 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u043E\u0457
      \u0431\u0430\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629655
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u043D\u0430 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629656
    m_Localized: "\u0417\u0440\u043E\u0431\u0456\u0442\u044C \u0442\u0430\u043A,
      \u0449\u043E\u0431 \u0443\u0441\u0456 \u0448\u0456\u0441\u0442\u044C \u043A\u043D\u043E\u043F\u043E\u043A
      \u0437\u0430\u0433\u043E\u0440\u0456\u043B\u0438\u0441\u044F \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E.
      \u0421\u0442\u0440\u0456\u043B\u044F\u0439\u0442\u0435 \u0434\u0443\u0436\u0435
      \u0448\u0432\u0438\u0434\u043A\u043E \u0456 \u0442\u043E\u0447\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629657
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \"\u041C\u0430\u043B\u0438\u0439 \u041C\u0430\u043A\u0456\u043D\u0442\u043E\u0448\"
      \u0456 \u0417.\u041F.\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629658
    m_Localized: "\u0422\u0435\u043C\u043D\u0456 \u0441\u0444\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629659
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0442\u0435\u043C\u043D\u0456 \u0441\u0444\u0435\u0440\u0438, \u0449\u043E\u0431
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u043A\u0456\u043D\u0446\u044F
      \u043A\u0456\u043C\u043D\u0430\u0442\u0438. \u0412\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044F\u0442\u0438
      \u0437 \u043D\u0438\u043C\u0438 \u043C\u043E\u0436\u043D\u0430 \u044F\u043A
      \u0456\u0437 \u043A\u043D\u043E\u043F\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629660
    m_Localized: "\u0421\u0442\u0440\u0438\u0431\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629661
    m_Localized: "\u0411\u0430\u0437\u0430 \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629662
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0430 \u0431\u0443\u0434\u0456\u0432\u043B\u044F,
      \u043F\u043E\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0430 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C
      \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0456 \u043E\u0434\u043D\u0456\u0454\u0457
      \u0437 \u0433\u0456\u0440. \u0410\u043D\u043A\u043B\u0430\u0432\u0456\u0432\u0446\u0456
      \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C \u0443
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0456\u0437 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438
      \u041F\u0443\u0441\u0442\u043E\u043A \u0456, \u0441\u0443\u0434\u044F\u0447\u0438
      \u0437 \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456 \u0432\u0456\u0439\u0441\u044C\u043A,
      \u0449\u043E \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u043D\u0430 \u0431\u0430\u0437\u0456, \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u043F\u0440\u0438\u0439\u0448\u043B\u0438 \u0437 \u043C\u0438\u0440\u043D\u0438\u043C\u0438
      \u043D\u0430\u043C\u0456\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629663
    m_Localized: "\u041E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u043F\u043E\u0441\u0442
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629664
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0434\u0435\u043D\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0457
      \u0431\u0430\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629665
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0438\u0439 \u043F\u0443\u043D\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629666
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0438\u0439 \u043F\u0443\u043D\u043A\u0442,
      \u0449\u043E \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043C\u0443 \u0432\u0435\u0440\u0445\u0443,
      \u0432\u0438\u0449\u0435 \u0445\u043C\u0430\u0440\u043D\u043E\u0457 \u0437\u0430\u0432\u0456\u0441\u0438.
      \u041A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u0447 \u0431\u0430\u0437\u043E\u044E
      \u043C\u0430\u0454 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0442\u0438
      \u0442\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629667
    m_Localized: "\u0413\u0430\u0440\u043C\u0430\u0442\u043D\u0438\u0439 \u0446\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629668
    m_Localized: "\u0426\u0435\u0445, \u0443 \u044F\u043A\u043E\u043C\u0443 \u0440\u0430\u043D\u0456\u0448\u0435
      \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u043B\u0438 \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043A\u0430\u043B\u0456\u0431\u0440\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u0442\u0443\u0436\u043D\u0443 \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0443
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443, \u044F\u043A\u0430 \u0432\u0441\u0435
      \u0449\u0435 \u0434\u0456\u0454, \u0446\u0435 \u043C\u0456\u0441\u0446\u0435
      \u0434\u043E\u0441\u0456 \u043D\u0456\u043A\u0438\u043C \u043D\u0435 \u0440\u043E\u0437\u0433\u0440\u0430\u0431\u043E\u0432\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629669
    m_Localized: "\u0428\u0442\u0430\u0431 \u041B\u0435\u0433\u0456\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629670
    m_Localized: "\u0414\u043E\u0431\u0440\u0435 \u0437\u0430\u043C\u0430\u0441\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0438\u0439 \u0448\u0442\u0430\u0431
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0437\u0435\u0431\u0440 \u0443
      \u0446\u0456\u0439 \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0441\u0442\u0456.
      \u0417\u0430 \u0441\u0442\u0430\u0440\u043E\u044E \u0434\u043E\u0431\u0440\u043E\u044E
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u043E\u044E \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0454\u044E
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438 \u0434\u043E \u043D\u044C\u043E\u0433\u043E
      \u043D\u0430\u043F\u0435\u0432\u043D\u043E \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0456
