  - m_Id: 2742018342
    m_Localized: "\u0417\u0430\u0445\u0438\u0441\u043D\u0430 \u043C\u0430\u0433\u0456\u044F
      \u0434\u0443\u0436\u0435 \u043A\u043E\u0440\u0438\u0441\u043D\u0430 \u0432
      \u0431\u043E\u044E. \u0415\u043A\u0456\u043F\u0456\u0440\u0443\u0439\u0442\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435 \u0432\u0430\u043C \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0437 \u043C\u0435\u043D\u044E \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E
      \u0430\u0431\u043E \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0457 \u043A\u043B\u0430\u0432\u0456\u0448\u0456,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0439\u0442\u0435
      \u0439\u043E\u0433\u043E \u043A\u043B\u0430\u0432\u0456\u0448\u0435\u044E [C]."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018343
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0430\u0442\u0438
      \u0437\u0431\u0440\u043E\u044E, \u0431\u0440\u043E\u043D\u044E, \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0430\u0431\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F
      \u043D\u0430 \u0446\u0438\u0444\u0440\u043E\u0432\u0456 \u043A\u043B\u0430\u0432\u0456\u0448\u0456
      [1]-[0]. \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0432 \u043C\u0435\u043D\u044E
      \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E \u043D\u0430\u0432\u0435\u0434\u0456\u0442\u044C
      \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u0431\u0430\u0436\u0430\u043D\u0443 \u043A\u043B\u0430\u0432\u0456\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018344
    m_Localized: "\u042F\u043A\u0449\u043E \u0432\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u0435
      \u0442\u0430\u043A\u0442\u0438\u043A\u0443 \u0441\u043A\u0440\u0438\u0442\u043D\u043E\u0441\u0442\u0456,
      \u0437\u0432\u0435\u0440\u0442\u0430\u0439\u0442\u0435 \u0443\u0432\u0430\u0433\u0443
      \u043D\u0430 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432,
      \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0445 \u0437\u043D\u0430\u0447\u043A\u043E\u043C
      (\u0298) \u0431\u0456\u043B\u044F \u0457\u0445\u043D\u044C\u043E\u0457 \u043D\u0430\u0437\u0432\u0438.
      \u0426\u0456 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u043B\u0438\u0432\u0456
      \u0456 \u0431\u0443\u0434\u0443\u0442\u044C \u0448\u0432\u0438\u0434\u0448\u0435
      \u0440\u043E\u0437\u043A\u0440\u0438\u0432\u0430\u0442\u0438 \u0432\u0430\u0448\u0435
      \u043C\u0430\u0441\u043A\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018345
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0437\u0431\u0440\u043E\u0439\u043E\u0432\u0438\u0439 \u0441\u0442\u0435\u043D\u0434,
      \u0449\u043E\u0431 \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
      \u0432\u0441\u044E \u043D\u0430\u044F\u0432\u043D\u0443 \u0443 \u0432\u0430\u0441
      \u0437\u0431\u0440\u043E\u044E, \u043C\u0430\u0433\u0456\u044E, \u0431\u0440\u043E\u043D\u044E
      \u0456 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438. \u041F\u043E\u0440\u043E\u0436\u043D\u0456\u043C\u0438
      \u043A\u043E\u043D\u0442\u0443\u0440\u0430\u043C\u0438 \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0456
      \u0440\u0435\u0447\u0456, \u044F\u043A\u0438\u0445 \u0443 \u0432\u0430\u0441
      \u0449\u0435 \u043D\u0435\u043C\u0430\u0454. \u0417\u0431\u0435\u0440\u0456\u0442\u044C
      \u0457\u0445 \u0443\u0441\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018346
    m_Localized: "\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438-\u0433\u0435\u0440\u043E\u0457,
      \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0437\u043E\u043B\u043E\u0442\u043E\u044E
      \u0437\u0456\u0440\u043A\u043E\u044E, \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456 \u0442\u0430 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0456
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445. \u0410\u043B\u0435
      \u043F\u0435\u0440\u0435\u043C\u0456\u0433\u0448\u0438 \u0457\u0445, \u043C\u043E\u0436\u043D\u0430
      \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E \u0430\u0431\u043E \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018347
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0456 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u043E\u0440\u0443
      \u043C\u0430\u044E\u0442\u044C \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0443
      \u0448\u043A\u043E\u0434\u0443, \u0431\u043B\u0430\u043A\u0438\u0442\u043D\u043E\u0433\u043E
      - \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438, \u0444\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0433\u043E
      - \u0432\u0456\u0434 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457, \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E
      - \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0443 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0456 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018348
    m_Localized: "\u041A\u043E\u043C\u0456\u0440\u043A\u0438 \u0440\u043E\u0431\u043E\u0442\u0456\u0432
      \u0430\u043A\u0442\u0438\u0432\u0443\u044E\u0442\u044C\u0441\u044F \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0440\u0430\u0434\u0456\u043E\u0441\u0438\u0433\u043D\u0430\u043B\u0443,
      \u044F\u043A\u0449\u043E \u0432\u0438 \u0432\u0441\u0442\u0443\u043F\u0438\u0442\u0435
      \u0432 \u0431\u0456\u0439 \u0437 \u0456\u043D\u0448\u0438\u043C\u0438 \u0440\u043E\u0431\u043E\u0442\u0430\u043C\u0438.
      \u041E\u0434\u043D\u0430\u043A \u0457\u0445 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0437\u0430\u0437\u0434\u0430\u043B\u0435\u0433\u0456\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018349
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0421\u043A\u0440\u0438\u0442\u043D\u0456\u0441\u0442\u044C\"
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0432\u0430\u043C \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0430\u0442\u0438
      \u0441\u0438\u0433\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044E. \u042F\u043A\u0449\u043E
      \u0436 \u0432\u043E\u043D\u0430 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u0441\u043F\u0440\u0430\u0446\u044E\u0454, \u043D\u0430 \u0441\u0438\u0433\u043D\u0430\u043B
      \u0442\u0440\u0438\u0432\u043E\u0433\u0438 \u0437\u0431\u0456\u0436\u0430\u0442\u044C\u0441\u044F
      \u043D\u043E\u0432\u0456 \u0432\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018350
    m_Localized: "\u0420\u0438\u0432\u043E\u043A \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443
      \u0443\u0445\u0438\u043B\u044F\u0442\u0438\u0441\u044F \u0432\u0456\u0434 \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u044F\u043A\u0456 \u0430\u0442\u0430\u043A\u0443\u044E\u0442\u044C \u0443
      \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u043C\u0443 \u0431\u043E\u044E,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0434\u043E\u043B\u0430\u0442\u0438
      \u0434\u0435\u044F\u043A\u0456 \u043F\u0435\u0440\u0435\u0448\u043A\u043E\u0434\u0438.
      \u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u0440\u0438\u0432\u043E\u043A, \u0434\u0432\u0456\u0447\u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      [A] \u0430\u0431\u043E [D], \u0443\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438
      [Shift]."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018351
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u044F\u0449\u0438\u043A, \u044F\u043A\u0438\u0439 \u043B\u0435\u0432\u0456\u0442\u0443\u0454\u0442\u044C\u0441\u044F,
      \u044F\u043A \u0449\u0438\u0442 \u0432\u0456\u0434 \u043A\u0443\u043B\u044C.
      \u041C\u0456\u0446\u043D\u0456 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0456
      \u044F\u0449\u0438\u043A\u0438 \u0437\u0430\u0445\u0438\u0449\u0430\u044E\u0442\u044C
      \u043A\u0440\u0430\u0449\u0435, \u043D\u0456\u0436 \u043B\u0435\u0433\u043A\u0456
      \u0434\u0435\u0440\u0435\u0432'\u044F\u043D\u0456. \u0422\u0430\u043A\u043E\u0436
      \u043C\u043E\u0436\u043D\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0442\u0456\u043B\u043E\u043C
      \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0432\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018352
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0412\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F\"
      \u0432\u0456\u0434\u043A\u0440\u0438\u0454 \u0432\u0430\u043C \u0434\u043E\u0441\u0442\u0443\u043F
      \u0434\u043E \u0440\u0435\u0446\u0435\u043F\u0442\u0456\u0432 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0445
      \u0437\u0456\u043B\u044C. \u0417\u0456\u043B\u043B\u044F \u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E\u0457 \u0442\u0430 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u0457
      \u0434\u0456\u0457. \u0414\u043B\u044F \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0437\u0456\u043B\u043B\u044F \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438\u0439 \u0441\u0442\u0456\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018353
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u0457
      \u0434\u0456\u0457 (\u0435\u043B\u0456\u043A\u0441\u0438\u0440\u0438) \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438
