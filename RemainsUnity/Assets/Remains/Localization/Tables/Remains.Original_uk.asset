  - m_Id: 2729436053
    m_Localized: "\u041F\u043E\u0440\u0456\u0433 \u0448\u043A\u043E\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436054
    m_Localized: "\u0426\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A
      \u0432\u0456\u0434\u043D\u0456\u043C\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0434
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0448\u043A\u043E\u0434\u0438,
      \u0449\u043E \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u0432\u0430\u043C
      (\u043A\u0440\u0456\u043C \u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0457,
      \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u043D\u0430 \u0433\u043E\u0440\u0456\u043D\u043D\u044F,
      \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0443 \u0430\u0431\u043E \u043E\u0442\u0440\u0443\u0454\u043D\u043D\u044F
      \u0432\u0456\u043D \u043D\u0435 \u0432\u043F\u043B\u0438\u0432\u0430\u0454)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436055
    m_Localized: "\u0411\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436056
    m_Localized: "\u0426\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A
      \u0432\u0456\u0434\u043D\u0456\u043C\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0434
      \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438,
      \u0449\u043E \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u0432\u0430\u043C,
      \u044F\u043A\u0449\u043E \u0443\u0434\u0430\u0440, \u043A\u0443\u043B\u044F
      \u0430\u0431\u043E \u043E\u0441\u043A\u043E\u043B\u043E\u043A \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C
      \u043F\u043E \u0431\u0440\u043E\u043D\u0456. \u0412\u043F\u043B\u0438\u0432\u0430\u0454
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u0444\u0456\u0437\u0438\u0447\u043D\u0443
      \u0448\u043A\u043E\u0434\u0443, \u0442\u0430\u043A\u0443 \u044F\u043A \u043A\u0443\u043B\u0456,
      \u043B\u0435\u0437\u0430, \u0443\u0434\u0430\u0440\u0438 \u0442\u0430 \u0432\u0438\u0431\u0443\u0445\u0438.
      \u0417\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434 \u043E\u0434\u044F\u0433\u043D\u0435\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456 \u0442\u0430 \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0457\u0457 \u0441\u0442\u0430\u043D \u043D\u0438\u0436\u0447\u0435
      50%."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436057
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436058
    m_Localized: "\u0426\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A
      \u0432\u0456\u0434\u043D\u0456\u043C\u0430\u0454\u0442\u044C\u0441\u044F \u0432\u0456\u0434
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438, \u0449\u043E \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F
      \u0432\u0430\u043C, \u044F\u043A\u0449\u043E \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C \u0430\u0431\u043E \u0441\u043D\u0430\u0440\u044F\u0434
      \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C \u043F\u043E
      \u0431\u0440\u043E\u043D\u0456. \u0412\u043F\u043B\u0438\u0432\u0430\u0454
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0443
      \u0448\u043A\u043E\u0434\u0443, \u0442\u0430\u043A\u0443 \u044F\u043A \u0432\u043E\u0433\u043E\u043D\u044C,
      \u043B\u0430\u0437\u0435\u0440, \u043F\u043B\u0430\u0437\u043C\u0430, \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u0430
      \u0430\u0431\u043E \u0445\u043E\u043B\u043E\u0434. \u0417\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0456\u0434 \u043E\u0434\u044F\u0433\u043D\u0435\u043D\u043E\u0457 \u0431\u0440\u043E\u043D\u0456
      \u0442\u0430 \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0457\u0457 \u0441\u0442\u0430\u043D \u043D\u0438\u0436\u0447\u0435
      50%."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436059
    m_Localized: "\u042F\u043A\u0456\u0441\u0442\u044C \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436060
    m_Localized: "\u0426\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A
      \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0454 \u0442\u0435,
      \u044F\u043A \u0434\u043E\u0431\u0440\u0435 \u0431\u0440\u043E\u043D\u044F
      \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454 \u0432\u0441\u0435 \u0442\u0456\u043B\u043E
      \u0456 \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0435\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u0445 \u0434\u0456\u043B\u044F\u043D\u043E\u043A.
      \u0424\u0430\u043A\u0442\u0438\u0447\u043D\u043E \u0446\u0435 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u0442\u043E\u0433\u043E, \u0449\u043E \u0443\u0434\u0430\u0440 \u0430\u0431\u043E
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u044C
      \u0443 \u0431\u0440\u043E\u043D\u044E, \u0430 \u043D\u0435 \u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0443
      \u0434\u0456\u043B\u044F\u043D\u043A\u0443, \u0456 \u0448\u043A\u043E\u0434\u0430
      \u0431\u0443\u0434\u0435 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u0430 \u0430\u0431\u043E
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0437\u0432\u0435\u0434\u0435\u043D\u0430
      \u0434\u043E \u043D\u0443\u043B\u044F. \u0417\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0456\u0434 \u043E\u0434\u044F\u0433\u043D\u0435\u043D\u043E\u0457 \u0431\u0440\u043E\u043D\u0456
      \u0442\u0430 \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F,
      \u044F\u043A\u0449\u043E \u0457\u0457 \u0441\u0442\u0430\u043D \u043D\u0438\u0436\u0447\u0435
      50%."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436061
    m_Localized: "\u0423\u0445\u0438\u043B\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436062
    m_Localized: "\u0429\u043E \u0432\u0438\u0449\u0438\u0439 \u0446\u0435\u0439
      \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A, \u0442\u043E \u0447\u0430\u0441\u0442\u0456\u0448\u0435
      \u0432\u043E\u0440\u043E\u0433\u0438 \u043F\u0440\u043E\u043C\u0430\u0445\u0443\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u043F\u043E \u0432\u0430\u0441 \u0456\u0437 \u0434\u0430\u043B\u0435\u043A\u043E\u0431\u0456\u0439\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u043D\u044F \u0434\u0456\u043B\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
      \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u044F\u043A\u0449\u043E \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u043E\u043D\u0443\u0441 \"+20%\", \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u043D\u044F \u043F\u043E \u0432\u0430\u043C
      \u0434\u0456\u043B\u0438\u0442\u044C\u0441\u044F \u043D\u0430 1.2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436063
    m_Localized: "\u0421\u043A\u0440\u0438\u0442\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436064
    m_Localized: "\u0429\u043E \u0432\u0438\u0449\u0438\u0439 \u0446\u0435\u0439
      \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A, \u0442\u043E \u0433\u0456\u0440\u0448\u0435
      \u0432\u043E\u0440\u043E\u0433\u0438 \u0432\u0430\u0441 \u0431\u0430\u0447\u0430\u0442\u044C,
      \u0456 \u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0435 \u0447\u0430\u0441\u0443
      \u0457\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F,
      \u0449\u043E\u0431 \u0432\u0430\u0441 \u0432\u0438\u044F\u0432\u0438\u0442\u0438.
      \u041D\u0435 \u0432\u0440\u0430\u0445\u043E\u0432\u0443\u0454 \u0432\u043F\u043B\u0438\u0432
      \u0441\u0442\u0435\u043B\u0441-\u0440\u0435\u0436\u0438\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436065
    m_Localized: "\u0417\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0457 \u0448\u043A\u043E\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436066
    m_Localized: "\u0420\u0430\u0445\u0443\u0454\u0442\u044C\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044F \u0448\u043A\u043E\u0434\u0430.
      \u0412\u0456\u0434 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043D\u044F \u0437\u0434\u043E\u0440\u043E\u0432'\u044F
      \u0432\u0456\u0434 \u043E\u0442\u0440\u0443\u0442\u0438, \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0456
      \u0442\u0430 \u0456\u043D\u0448\u043E\u0457 \u0448\u043A\u043E\u0434\u0438,
      \u0449\u043E \u0439\u0434\u0435 \u0437\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438,
      \u043D\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436067
    m_Localized: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430 \u0448\u043A\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436068
    m_Localized: "\u0411\u043E\u043D\u0443\u0441 \u0434\u043E \u0448\u043A\u043E\u0434\u0438
      \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0432\u0430\u0448\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u0442\u0430 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C"
