      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u043D\u0456\u043A\u043E\u0433\u043E,
      \u0443 \u043A\u043E\u0433\u043E \u0431\u0443\u0432 \u0431\u0438 \u041F\u0456\u043F\u0411\u0430\u043A.
      \u0429\u043E, \u044F\u043A\u0449\u043E... \u0449\u043E, \u044F\u043A\u0449\u043E
      \u0446\u0435 \"\u041E\u0431\u0440\u0430\u043D\u0430-24\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629933
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435 \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0432\u043E\u043D\u0430. \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u043E\u043D\u0430
      \u0432\u0436\u0435 \u0434\u0443\u0436\u0435 \u0434\u0430\u043B\u0435\u043A\u043E
      \u0437\u0432\u0456\u0434\u0441\u0438, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0432\u0436\u0435 \u043C\u0435\u0440\u0442\u0432\u0430. \u041E\u0434\u043D\u0430\u043A
      \u044F \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u043C\u0430\u044E \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0457. \u041C\u043E\u0436\u0435,
      \u0432\u043E\u043D\u0430 \u0431\u0443\u0432\u0430\u043B\u0430 \u0432 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u043C\u0443
      \u043F\u043E\u043D\u0456\"? \u0422\u0440\u0435\u0431\u0430 \u0437\u0430\u043F\u0438\u0442\u0430\u0442\u0438
      \u0432 \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456, \u044F\u043A\u0449\u043E
      \u0445\u0442\u043E \u0439 \u0437\u043D\u0430\u0454, \u0442\u043E \u0442\u043E\u0447\u043D\u043E
      \u0432\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629934
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437 \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456
      \u043F\u0440\u043E \"\u041E\u0431\u0440\u0430\u043D\u0443 24\""
    m_Metadata:
