  - m_Id: 2737825018
    m_Localized: "\u0414\u043E\u043F\u0438\u0442\u0430\u0442\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u0431\u0430\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825019
    m_Localized: "\u041D\u0430\u0431\u043B\u0438\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825020
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0432\u0441\u044F
      \u0431\u0440\u0430\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044C \u0443
      \u044F\u043A\u0438\u0445\u043E\u0441\u044C \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438\u0445
      \u0434\u043B\u044F \u043D\u044C\u043E\u0433\u043E \u0432\u0456\u0439\u043D\u0430\u0445
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456. \u0410\u043B\u0435
      \u0432\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0442\u0430\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0438\u043D\u0443\u0442\u0438 \u0432
      \u0431\u0456\u0434\u0456 \u0441\u0432\u043E\u0457\u0445 \u043D\u043E\u0432\u0438\u0445
      \u0434\u0440\u0443\u0437\u0456\u0432 \u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0432 \u0431\u0435\u0437\u043F\u0435\u0446\u0456 \u0421\u0442\u0456\u0439\u043B\u0430.
      \u0414\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u043D\u0430\u0437\u0430\u0434 \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825021
    m_Localized: "\u0420\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u043F\u0440\u043E \u043E\u0441\u0442\u0430\u043D\u043D\u0456 \u043F\u043E\u0434\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825022
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F \u0437\u0456
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u043E\u043C \u043D\u0430 \u0432\u043E\u0434\u043E\u043E\u0447\u0438\u0441\u043D\u0456\u0439
      \u0441\u0442\u0430\u043D\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825023
    m_Localized: "\u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438 \u0443
      \u0444\u043E\u0440\u0442 \u0420\u043E\u043A\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825024
    m_Localized: "\u0412\u0438\u043C\u043A\u043D\u0443\u0442\u0438 \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F
      \u0430\u0440\u0442\u0438\u043B\u0435\u0440\u0456\u0439\u0441\u044C\u043A\u0438\u0445
      \u0437\u043D\u0430\u0440\u044F\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825025
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437\u0456
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825026
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043D\u044F \u0431\u0438\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825027
    m_Localized: "\u0410\u043D\u043A\u043B\u0430\u0432 \u0430\u0442\u0430\u043A\u0443\u0454
      \u0432\u0430\u0448 \u0434\u0456\u043C, \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456. \u0417\u0430\u0445\u0438\u0441\u0442\u0456\u0442\u044C \u0439\u043E\u0433\u043E
      \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443 \u0446\u0456\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825028
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0434\u043E \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456 \u0442\u0430
      \u0437\u043D\u0430\u0439\u0442\u0438 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825029
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \"\u0411\u0440\u043E\u043D\u044E
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737825030
    m_Localized: "\u0417\u0443\u043F\u0438\u043D\u0438\u0442\u0438 \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825031
    m_Localized: "\u0417\u043D\u0438\u0449\u0438\u0442\u0438 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825032
    m_Localized: "\u0412\u0438\u0436\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825033
    m_Localized: "\u0413\u0435\u0439!!! \u0422\u0438 \u043A\u0443\u0434\u0438 \u0446\u0435???"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825034
    m_Localized: "\u0426\u0435 \u0449\u043E \u0437\u0430 \u0445\u0440\u0456\u043D\u044C!!!?????"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825035
    m_Localized: "(\u043C\u0435\u0440\u0442\u0432\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C)
      \u042F \u0432\u0438\u0441\u043C\u043E\u043A\u0447\u0443 \u0442\u0432\u043E\u044E
      \u0434\u0443\u0448\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825036
    m_Localized: "\u041E\u0439-\u043E\u0439-\u043E\u0439-\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825037
    m_Localized: "\u0426\u044C\u043E\u0433\u043E \u0432\u043E\u0440\u043E\u0433\u0430
      \u043D\u0435 \u0437\u0434\u043E\u043B\u0430\u0442\u0438! \u0411\u0456\u0436\u0438,
      @lp, \u0431\u0456\u0436\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825038
    m_Localized: "\u041F\u043E\u0442\u043E\u0432\u0430\u0440\u0438\u0448\u0443\u0432\u0430\u0442\u0438
      \u0437 \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825039
    m_Localized: "\u0416\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441, \u0441\u0445\u043E\u0436\u0435,
      \u043D\u0435 \u0431\u043E\u0457\u0442\u044C\u0441\u044F \u0432\u0430\u0441
      \u0456 \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0454 \u0430\u0433\u0440\u0435\u0441\u0456\u0457.
      \u0417 \u0447\u0443\u0442\u043E\u043A, \u0446\u0456 \u043F\u0442\u0430\u0445\u0438
      \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E \u0440\u043E\u0437\u0443\u043C\u043D\u0456
      \u0456 \u043F\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C\u0443
      \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u0456 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0441\u0442\u0430\u0442\u0438 \u0432\u0456\u0440\u043D\u0438\u043C\u0438 \u0434\u0440\u0443\u0437\u044F\u043C\u0438.
      \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0437 \u043D\u0438\u043C
      \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825040
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0443\u0432\u0430\u0442\u0438 \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u043C
      \u043F\u0435\u0447\u0438\u0432\u043E\u043C:"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825041
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825042
    m_Localized: "\u0416\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825043
    m_Localized: "*** \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441, \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438
      \u0433\u043E\u043B\u043E\u0432\u0443, \u0434\u0438\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u0430\u0441 \u043E\u0434\u043D\u0438\u043C \u043E\u043A\u043E\u043C
      ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825044
    m_Localized: "\u0417\u043D\u0430\u0454\u0448... \u0442\u0438 - \u043D\u0430\u0439\u043A\u0440\u0430\u0441\u0438\u0432\u0456\u0448\u0430
      \u0456\u0441\u0442\u043E\u0442\u0430, \u044F\u043A\u0443 \u043C\u0435\u043D\u0456
      \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0442\u0438
      \u0432 \u0436\u0438\u0442\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825045
    m_Localized: "*** \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0434\u0443\u0436\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u0438\u043C,
      \u0432\u0456\u043D \u0440\u043E\u0437\u043F\u0443\u0448\u0443\u0454 \u043F\u0456\u0440'\u044F
      \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0456 \u0456 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E \u0432\u0430\u0441 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u043E\u0434\u043D\u0438\u043C \u0431\u043E\u043A\u043E\u043C, \u043F\u043E\u0442\u0456\u043C
      \u0456\u043D\u0448\u0438\u043C ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825046
    m_Localized: "\u0422\u0438... \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448
      \u043C\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825047
    m_Localized: "*** \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441 \u043A\u0438\u0432\u0430\u0454,
      \u0432\u0438\u0434\u0430\u0432\u0448\u0438 \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0437\u0432\u0443\u043A, \u0449\u043E, \u043C\u0430\u0431\u0443\u0442\u044C,
      \u043E\u0437\u043D\u0430\u0447\u0430\u0454 \u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F.
      \u041F\u043E\u0442\u0456\u043C \u0440\u043E\u0437\u043F\u0440\u0430\u0432\u043B\u044F\u0454
      \u043A\u0440\u0438\u043B\u0430 \u0456 \u0432\u0438\u0434\u0430\u0454 \u0441\u0435\u0440\u0456\u044E
      \u043D\u043E\u0432\u0438\u0445 \u043C\u0435\u043B\u043E\u0434\u0456\u0439\u043D\u0438\u0445
      \u0437\u0432\u0443\u043A\u0456\u0432 ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825048
    m_Localized: "\u0426\u0435 \u0442\u0430\u043A \u0434\u0438\u0432\u043D\u043E,
      \u044F \u043D\u0456\u0431\u0438 \u0442\u0435\u0436 \u0440\u043E\u0437\u0443\u043C\u0456\u044E
      \u0442\u0435\u0431\u0435. \u0422\u0438 \u043A\u0430\u0436\u0435\u0448, \u0449\u043E
      \u0445\u043E\u0447\u0435\u0448 \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443\u0432\u0430\u0442\u0438
      \u043C\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825049
    m_Localized: "*** \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441 \u0437\u043D\u043E\u0432\u0443
      \u043A\u0438\u0432\u0430\u0454, \u043F\u0456\u0441\u043B\u044F \u0447\u043E\u0433\u043E
      \u0437\u043B\u0456\u0442\u0430\u0454, \u0433\u043E\u0442\u0443\u044E\u0447\u0438\u0441\u044C
      \u0441\u043B\u0456\u0434\u0443\u0432\u0430\u0442\u0438 \u0437\u0430 \u0432\u0430\u043C\u0438
      ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825050
    m_Localized: "\u041F\u0440\u043E \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825051
    m_Localized: "\u0417\u0456 \u043C\u043D\u043E\u044E \u043C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E,
      \u0430\u043B\u0435 \u044F\u043A\u0449\u043E \u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0445\u043E\u0447\u0435\u0448 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438
      \u0440\u0430\u0437\u043E\u043C, \u0442\u043E \u044F \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u043F\u0440\u043E\u0442\u0438 \u0442\u0432\u043E\u0454\u0457
      \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825052
    m_Localized: "*** \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441 \u0448\u0438\u0440\u044F\u0454
      \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0432\u0430\u043C\u0438, \u0432\u0438
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435 \u0442\u0435\u043F\u043B\u043E,
      \u0449\u043E \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u0456\u0434
      \u043D\u044C\u043E\u0433\u043E. \u0422\u0435\u043F\u0435\u0440 \u0432\u0430\u043C
      \u0443\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A \u0441\u0430\u043C\u043E\u0442\u043D\u044C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825053
    m_Localized: "[\u0416\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441] \u0441\u0442\u0430\u0454
      \u0432\u0430\u0448\u0438\u043C \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C.
      \u0412\u0456\u043D \u0431\u0443\u0434\u0435 \u0441\u043B\u0456\u0434\u0443\u0432\u0430\u0442\u0438
      \u0437\u0430 \u0432\u0430\u043C\u0438, \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u044E\u0447\u0438
      \u0432 \u0431\u043E\u044E. \u0416\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441
      \u0432\u043E\u043B\u043E\u0434\u0456\u0454 \u0432\u043E\u0433\u043D\u0435\u043D\u043D\u0438\u043C
      \u0434\u0438\u0445\u0430\u043D\u043D\u044F\u043C, \u0449\u043E \u043F\u0440\u043E\u043F\u0430\u043B\u044E\u0454
      \u0431\u0440\u043E\u043D\u044E. \u0412\u0456\u043D \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438\u043C\u0435
      \u0442\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432, \u044F\u043A\u0438\u0445
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C, \u0456 \u043F\u0440\u043E\u0442\u0438
      \u044F\u043A\u0438\u0445 \u0439\u043E\u0433\u043E \u0437\u0431\u0440\u043E\u044F
      \u0431\u0443\u0434\u0435 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u044E.
      \u042F\u043A\u0449\u043E \u0432\u0456\u043D \u0437\u0430\u0433\u0438\u043D\u0435
      \u0432 \u0431\u043E\u044E, \u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E
      \u0432\u0456\u0434\u0440\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u0456\u0437 \u043D\u0435\u043F\u043E\u0432\u043D\u0438\u043C
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F\u043C. [\u0420\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0435
      \u043F\u0435\u0447\u0438\u0432\u043E] \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      \u0439\u043E\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F (\u043C\u043E\u0436\u043D\u0430
      \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0437 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E, \u044F\u043A
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0456\u043D\u0448\u0438\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442), \u0442\u0430\u043A\u043E\u0436
      \u0432\u0456\u043D \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0449\u043E\u0440\u0430\u0437\u0443, \u043A\u043E\u043B\u0438 \u0432\u0438
      \u0431\u0443\u0434\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u0434\u043E\u0437\u0443 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825054
    m_Localized: "\u0429\u043E\u0431 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
      \u0430\u0431\u043E \u0432\u0456\u0434\u043A\u043B\u0438\u043A\u0430\u0442\u0438
      \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441\u0430, \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [\u0441\u0432\u0438\u0441\u0442\u043E\u043A] \u0437 \u0432\u0430\u0448\u043E\u0433\u043E
      \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F
      \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C @1, \u0449\u043E\u0431
      \u0432\u0456\u0434\u0434\u0430\u0432\u0430\u0442\u0438 \u0439\u043E\u043C\u0443
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438. \u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u0435
      \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u043D\u043D\u044F \u0434\u0430\u0454
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F
      \u0432 \u0437\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0443 \u0442\u043E\u0447\u043A\u0443
      \u0430\u0431\u043E \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E\u0433\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430. \u0423\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u043D\u043D\u044F
      \u043A\u043B\u0430\u0432\u0456\u0448\u0456 \u0434\u0435\u044F\u043A\u0438\u0439
      \u0447\u0430\u0441 \u0434\u0430\u0441\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737825055
    m_Localized: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438, \u0447\u0438
      \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825056
    m_Localized: "*** \u0437\u0430\u0442\u044F\u0433\u0443\u0454\u0442\u044C\u0441\u044F
      ***"
    m_Metadata:
      m_Items: []
  - m_Id: 2737825057
    m_Localized: "\u041A\u0445\u0435-\u043A\u0445\u0435... \u041D\u0443 \u0439 \u043F\u043E\u0433\u0430\u043D\u044C!
      \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F."
