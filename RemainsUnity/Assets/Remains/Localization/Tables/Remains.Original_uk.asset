      \u0433\u0440\u0430\u0432\u0456\u0442\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629614
    m_Localized: "\u0420\u0430\u0434\u0456\u043E\u0432\u0435\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629615
    m_Localized: "\u0417\u0440\u043E\u0431\u0456\u0442\u044C \u0442\u0430\u043A,
      \u0449\u043E\u0431 \u0443\u0441\u0456 \u043A\u043D\u043E\u043F\u043A\u0438
      \u0431\u0443\u043B\u0438 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629616
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0440\u0430\u0434\u0456\u043E-\u043C\u0456\u043D\u0438 X-37."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629617
    m_Localized: "\u0422\u0435\u0445\u043D\u0456\u0447\u043D\u0438\u0439 \u0432\u0456\u0434\u0434\u0456\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629618
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u043F\u0440\u043E\u0445\u0456\u0434
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0431\u0456\u0440\u0438\u043D\u0442
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0438\u0445 \u0432\u0456\u0434\u0441\u0456\u043A\u0456\u0432."
