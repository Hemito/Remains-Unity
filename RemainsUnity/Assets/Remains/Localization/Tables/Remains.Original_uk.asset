      m_Items: []
  - m_Id: 2729436313
    m_Localized: "\u041F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0437 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0456\u0432 \u0430\u0431\u043E
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u0438\u0441\u044F
      \u0441\u0443\u043C\u0430\u0440\u043D\u0430 \u0448\u043A\u043E\u0434\u0430 \u043E\u0434\u043D\u0438\u043C
      \u0447\u0438\u0441\u043B\u043E\u043C \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u043E\u043A\u0440\u0435\u043C\u0438\u0445 \u0447\u0438\u0441\u0435\u043B \u043D\u0430
      \u043A\u043E\u0436\u043D\u0435 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436314
    m_Localized: "\u0424\u0456\u043B\u044C\u0442\u0440 \u043D\u0435\u0446\u0435\u043D\u0437\u0443\u0440\u043D\u043E\u0457
      \u043B\u0435\u043A\u0441\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436315
    m_Localized: "\u0412\u0438\u043C\u0438\u043A\u0430\u0439\u0442\u0435 \u0446\u0435
      \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F, \u0442\u0456\u043B\u044C\u043A\u0438
      \u044F\u043A\u0449\u043E \u0432\u0430\u043C \u0454 18 \u0440\u043E\u043A\u0456\u0432
      \u0456 \u0432\u0430\u0448\u0430 \u043F\u0441\u0438\u0445\u0456\u043A\u0430
      \u0432\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0430 \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0434\u043E\u0431\u0456\u0440\u043D\u0456 \u0442\u0440\u0438\u043F\u043E\u0432\u0435\u0440\u0445\u043E\u0432\u0456
      \u043C\u0430\u0442\u044E\u043A\u0438, \u044F\u043A\u0456 \u0456\u043D\u043A\u043E\u043B\u0438
      \u0432\u0436\u0438\u0432\u0430\u044E\u0442\u044C \u0443 \u0441\u0432\u043E\u0457\u0439
      \u043F\u0440\u043E\u043C\u043E\u0432\u0456 \u0436\u0438\u0442\u0435\u043B\u0456
      \u043F\u043E\u0441\u0442\u0430\u043F\u043E\u043A\u0430\u043B\u0456\u043F\u0442\u0438\u0447\u043D\u043E\u0457
      \u043F\u0443\u0441\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
