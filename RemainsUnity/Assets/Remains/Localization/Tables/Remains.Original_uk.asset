  - m_Id: 2737824001
    m_Localized: "\u0412\u0456\u0434\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0437\u0430\u043F\u0438\u0441
      \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F 4."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824002
    m_Localized: "\"\u041F\u0440\u043E\u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457
      \u043D\u043E\u0447\u0456, \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u043E.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824003
    m_Localized: "\"\u0417\u0430\u043B\u0438\u0448 \u043F\u0440\u0438\u0432\u0456\u0442\u0430\u043D\u043D\u044F
      \u043F\u0440\u0438 \u0441\u043E\u0431\u0456, \u0432\u0456\u0434\u044C\u043C\u043E.
      \u041D\u0430\u0432\u0456\u0449\u043E \u0442\u0438 \u0442\u0443\u0440\u0431\u0443\u0454\u0448
      \u043D\u0430\u0441?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824004
    m_Localized: "\"\u0422\u043E\u0431\u0456 \u0446\u0435 \u0434\u043E\u0431\u0440\u0435
      \u0432\u0456\u0434\u043E\u043C\u043E. \u041A\u0435\u0441\u0430\u0440\u0456\u0439
      \u043F\u043E\u0447\u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0434\u0443\u0436\u0435 \u0441\u043A\u043E\u0440\u043E, \u0449\u043E\u0439\u043D\u043E
      \u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0441\u044F \u0437 \u0442\u0440\u0456\u0443\u043C\u0444\u043E\u043C
      \u0437\u0456 \u0441\u0432\u043E\u0433\u043E \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0446\u0442\u0432\u0430
      \u0434\u043E \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0433\u043E \u041C\u0456\u0441\u0442\u0430.
      \u0412\u0430\u043C \u0441\u043B\u0456\u0434 \u043F\u043E\u0447\u0430\u0442\u0438
      \u0441\u0432\u043E\u044E \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824005
    m_Localized: "\"\u041D\u0435 \u0432\u043A\u0430\u0437\u0443\u0439 \u043C\u0435\u043D\u0456,
      \u044F\u043A \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u0442\u0438
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0431\u0440\u0430\u0442\u0430\u043C\u0438,
      \u0432\u0456\u0434\u044C\u043C\u043E. \u041C\u0435\u043D\u0456 \u0431\u0430\u0439\u0434\u0443\u0436\u0435,
      \u0447\u0438\u043C \u0442\u0438 \u0442\u0430\u043C \u0437\u0430\u0439\u043C\u0430\u0454\u0448\u0441\u044F,
      \u0430\u043B\u0435 \u044F\u043A\u0449\u043E \u0442\u0438 \u0432\u0435\u0434\u0435\u0448
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438, \u0442\u0438
      \u043F\u043E\u0432\u0438\u043D\u043D\u0430 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0442\u0438
      \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0456 \u0442\u0435\u0440\u043C\u0456\u043D\u0438.
      \u041D\u0443 \u0442\u0430\u043A \u0449\u043E?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824006
    m_Localized: "\"\u0414\u0443\u0445\u0438 \u0432\u0435\u0434\u0443\u0442\u044C
      @lp \u0432\u0456\u0440\u043D\u0438\u043C \u0448\u043B\u044F\u0445\u043E\u043C.
      \u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0434\u043D\u0456 \u0432\u043E\u043D\u0430
      \u043F\u0440\u0438\u0431\u0443\u0434\u0435 \u0434\u043E \u043C\u0435\u043D\u0435,
      \u0456 \u0442\u043E\u0433\u043E \u0436 \u0434\u043D\u044F \u044F \u0437\u0431\u0435\u0440\u0443\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u043E \u0441\u0432\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u0438\u043A\u0438.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824007
    m_Localized: "\"\u0429\u043E? \u042F\u043A\u0456 \u0434\u0443\u0445\u0438? \u042F\u043A\u0438\u0439
      @lp? \u0422\u0438 \u0449\u043E \u0432\u0435\u0440\u0437\u0435\u0448 \u0432\u0437\u0430\u0433\u0430\u043B\u0456?\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824008
    m_Localized: "\"\u0422\u043E\u0431\u0456 \u0441\u043B\u0456\u0434 \u043B\u0438\u0448\u0435
      \u0437\u043D\u0430\u0442\u0438, \u0449\u043E \u0447\u0435\u0440\u0435\u0437
      \u043F'\u044F\u0442\u044C \u0434\u043D\u0456\u0432 \u0441\u043E\u043B\u0434\u0430\u0442\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0432\u0438\u0441\u0442\u0443\u043F\u043B\u044F\u0442\u044C
      \u043F\u043E\u0445\u043E\u0434\u043E\u043C \u0434\u043E \u043D\u0430\u0448\u043E\u0433\u043E
      \u043C\u0456\u0441\u0446\u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456.
      \u041A\u043E\u043B\u0438 \u0432\u043E\u043D\u0438 \u043F\u0440\u0438\u0439\u0434\u0443\u0442\u044C,
      \u0442\u0432\u043E\u0457 \u0432\u043E\u0457\u043D\u0438 \u043C\u0430\u044E\u0442\u044C
      \u0431\u0443\u0442\u0438 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824009
    m_Localized: "\"\u042F\u043A\u0431\u0438 \u0442\u0438 \u0431\u0443\u043B\u0430
      \u0441\u0430\u043C\u0430 \u043F\u043E \u0441\u043E\u0431\u0456, \u0432\u0456\u0434\u044C\u043C\u043E,
      \u044F \u0431 \u043B\u0438\u0448\u0435 \u043F\u043E\u0441\u043C\u0456\u044F\u0432\u0441\u044F
      \u043D\u0430\u0434 \u0442\u0432\u043E\u0454\u044E \u043C\u0430\u044F\u0447\u043D\u0435\u044E.
      \u0410\u043B\u0435 \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0456\u0440\u044F\u0454
      \u0442\u0432\u0456\u0439 \u043B\u0435\u0433\u0430\u0442, \u0430 \u044F \u0434\u043E\u0432\u0456\u0440\u044F\u044E
      \u0439\u043E\u043C\u0443. \u0422\u043E\u043C\u0443 \u043C\u043E\u0457 \u0441\u043E\u043B\u0434\u0430\u0442\u0438
      \u0431\u0443\u0434\u0443\u0442\u044C \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0456\u044F\u0445
      \u0443 \u0437\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0442\u0435\u0440\u043C\u0456\u043D.
      \u041D\u0435 \u0440\u043E\u0437\u0447\u0430\u0440\u0443\u0439\u0442\u0435 \u043C\u0435\u043D\u0435.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824010
    m_Localized: "\"\u041F\u0440\u043E\u0454\u043A\u0442 \"\u0421\u043E\u043D\u0446\u0435\"
      \u0456 \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0432\u0430\u0448\u043E\u043C\u0443 \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0443,
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u043E. \u041D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C
      \u043D\u0430 \u0442\u0435, \u0449\u043E \u0432\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0454\u0442\u0435
      \u0446\u0456 \u0440\u0435\u0441\u0443\u0440\u0441\u0438 \u0443 \u0441\u043F\u0456\u043B\u044C\u043D\u0456\u0439
      \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0456. \u041B\u0435\u0433\u0430\u0442
      \u041A\u0435\u0441\u0430\u0440\u0456\u0439 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0454
      \u043D\u0430 \u0432\u0430\u0448\u0443 \u0440\u043E\u0437\u0441\u0443\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824011
    m_Localized: "\u0421\u0442\u043E\u043F, \u0449\u043E?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824012
    m_Localized: "\u041B\u0435\u0433\u0456\u043E\u043D \u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438? \u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0439
      \u043F\u043B\u0430\u043D? \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824013
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u0437 \u043A\u043E\u0433\u043E
      \u0432\u0437\u044F\u0442\u0438 \u043F\u043E\u043F\u0438\u0442. \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824014
    m_Localized: "\u0417\u043C\u043E\u0432\u0430 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824015
    m_Localized: "\u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824016
    m_Localized: "\u0421\u043B\u0443\u0445\u0430\u044E, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824017
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0445\u0430\u0439 \u043E\u0441\u044C
      \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824018
    m_Localized: "\"\u0422\u043E\u0431\u0456 \u0441\u043B\u0456\u0434 \u043B\u0438\u0448\u0435
      \u0437\u043D\u0430\u0442\u0438, \u0449\u043E \u0447\u0435\u0440\u0435\u0437
      \u043F'\u044F\u0442\u044C \u0434\u043D\u0456\u0432 \u0441\u043E\u043B\u0434\u0430\u0442\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0432\u0438\u0441\u0442\u0443\u043F\u043B\u044F\u0442\u044C
      \u043F\u043E\u0445\u043E\u0434\u043E\u043C \u0434\u043E \u043D\u0430\u0448\u043E\u0433\u043E
      \u043C\u0456\u0441\u0446\u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456.
      \u041A\u043E\u043B\u0438 \u0432\u043E\u043D\u0438 \u043F\u0440\u0438\u0439\u0434\u0443\u0442\u044C,
      \u0442\u0432\u043E\u0457 \u0432\u043E\u0457\u043D\u0438 \u043C\u0430\u044E\u0442\u044C
      \u0431\u0443\u0442\u0438 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824019
    m_Localized: "\"\u042F\u043A\u0431\u0438 \u0442\u0438 \u0431\u0443\u043B\u0430
      \u0441\u0430\u043C\u0430 \u043F\u043E \u0441\u043E\u0431\u0456, \u0432\u0456\u0434\u044C\u043C\u043E,
      \u044F \u0431 \u043B\u0438\u0448\u0435 \u043F\u043E\u0441\u043C\u0456\u044F\u0432\u0441\u044F
      \u043D\u0430\u0434 \u0442\u0432\u043E\u0454\u044E \u043C\u0430\u044F\u0447\u043D\u0435\u044E.
      \u0410\u043B\u0435 \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0456\u0440\u044F\u0454
      \u0442\u0432\u0456\u0439 \u043B\u0435\u0433\u0430\u0442, \u0430 \u044F \u0434\u043E\u0432\u0456\u0440\u044F\u044E
      \u0439\u043E\u043C\u0443. \u0422\u043E\u043C\u0443 \u043C\u043E\u0457 \u0441\u043E\u043B\u0434\u0430\u0442\u0438
      \u0431\u0443\u0434\u0443\u0442\u044C \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0456\u044F\u0445
      \u0443 \u0437\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0442\u0435\u0440\u043C\u0456\u043D.
      \u041D\u0435 \u0440\u043E\u0437\u0447\u0430\u0440\u0443\u0439\u0442\u0435 \u043C\u0435\u043D\u0435.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824020
    m_Localized: "\"\u041F\u0440\u043E\u0454\u043A\u0442 \"\u0421\u043E\u043D\u0446\u0435\"
      \u0456 \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0432\u0430\u0448\u043E\u043C\u0443 \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0443,
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u043E. \u041D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C
      \u043D\u0430 \u0442\u0435, \u0449\u043E \u0432\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0454\u0442\u0435
      \u0446\u0456 \u0440\u0435\u0441\u0443\u0440\u0441\u0438 \u0443 \u0441\u043F\u0456\u043B\u044C\u043D\u0456\u0439
      \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0456. \u041B\u0435\u0433\u0430\u0442
      \u041A\u0435\u0441\u0430\u0440\u0456\u0439 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0454
      \u043D\u0430 \u0432\u0430\u0448\u0443 \u0440\u043E\u0437\u0441\u0443\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824021
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0448
      \u043C\u0435\u043D\u0456 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824022
    m_Localized: "\u0426\u0435\u0439 \u0433\u043E\u043B\u043E\u0441... \u0446\u0435
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442.
      \u0417\u0432\u0456\u0434\u043A\u0438 \u0432 \u0442\u0435\u0431\u0435 \u0446\u0435\u0439
      \u0437\u0430\u043F\u0438\u0441 \u0456 \u0437 \u043A\u0438\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824023
    m_Localized: "\u041D\u0456-\u0430, \u0441\u043F\u0435\u0440\u0448\u0443 \u0442\u0432\u043E\u044F
      \u0447\u0435\u0440\u0433\u0430. \u0422\u0432\u0456\u0439 \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430
      \u0431\u0443\u0434\u0443\u0454 \u0432\u0435\u043B\u0438\u043A\u0456 \u043F\u043B\u0430\u043D\u0438
      \u043D\u0430 \u043F\u0430\u0440\u0443 \u0437 \u041B\u0435\u0433\u0456\u043E\u043D\u043E\u043C
      \u0437\u0435\u0431\u0440. \u0422\u043E\u0431\u0456 \u043D\u0435 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0449\u043E \u043F\u0440\u043E \u0446\u0435 \u0432\u0430\u0440\u0442\u043E
      \u0431\u0443\u043B\u043E \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438
      \u043C\u0435\u043D\u0456 \u0437 \u0441\u0430\u043C\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443?
      \u042F\u043A\u0449\u043E \u043C\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u043C\u043E\u0441\u044F
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0432\u0435\u0441\u0442\u0438 \u044F\u043A\u0443\u0441\u044C
      \"\u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u044E\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824024
    m_Localized: "\u042F \u0437\u043D\u0430\u044E \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0442\u0432\u043E\u0433\u043E, @lp. \u041F\u0440\u043E\u044F\u0432\u0438 \u0440\u043E\u0437\u0441\u0443\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C:
      \u044F \u0432\u0436\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0432
      \u0442\u043E\u0431\u0456, \u0449\u043E \u043D\u0430 \u0434\u0430\u043D\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0443 \u043D\u0430\u0441 \u0456\u0437
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u043E\u043C \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0430
      \u043A\u043E\u043D\u0444\u0440\u043E\u043D\u0442\u0430\u0446\u0456\u044F. \u042F
      \u0439 \u0433\u0430\u0434\u043A\u0438 \u043D\u0435 \u043C\u0430\u044E \u043D\u0456\u0447\u043E\u0433\u043E
      \u043F\u0440\u043E \u0439\u043E\u0433\u043E \u043F\u043B\u0430\u043D\u0438,
      \u0442\u043E\u043C\u0443 \u0449\u043E \u0432\u0456\u043D \u0432\u0432\u0430\u0436\u0430\u0454
      \u043C\u0435\u043D\u0435 \u0441\u0432\u043E\u0457\u043C \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824025
    m_Localized: "\u0410 \u0447\u0438 \u0442\u0430\u043A \u0446\u0435 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824026
    m_Localized: "\u0422\u0438 \u0431\u0443\u043B\u0430 \u043E\u0434\u043D\u0430
      \u043F\u0440\u043E\u0442\u0438 \u043D\u0430\u0441 \u0447\u043E\u0442\u0438\u0440\u044C\u043E\u0445
      \u0442\u0430\u043C, \u0443 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456.
      \u0417\u0430\u0440\u0430\u0437 \u0442\u0438 \u043E\u0434\u043D\u0430 \u043F\u0440\u043E\u0442\u0438
      \u0446\u0456\u043B\u043E\u0433\u043E \u0437\u0430\u0433\u043E\u043D\u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432. \u042F\u043A\u0431\u0438
      \u044F \u0431\u0443\u0432 \u043D\u0430 \u0431\u043E\u0446\u0456 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430,
      \u0447\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438 \u0431 \u043C\u0438
      \u0442\u0435\u0431\u0435 \u0432 \u0436\u0438\u0432\u0438\u0445 \u043F\u0456\u0441\u043B\u044F
      \u0442\u043E\u0433\u043E, \u044F\u043A \u0440\u043E\u0437\u043F\u0456\u0437\u043D\u0430\u043B\u0438
      \u0432 \u0442\u043E\u0431\u0456 \u0432\u0431\u0438\u0432\u0446\u044E \u0420\u043E\u0443\u0437
      \u0456 \u0414\u0430\u0439\u043C\u043E\u043D\u0434? \u0417\u0430\u043B\u0438\u0448\u0438\u043B\u0438
      \u0431 \u043C\u0438 \u0442\u0435\u0431\u0435 \u0432 \u0436\u0438\u0432\u0438\u0445
      \u0437\u0430\u0440\u0430\u0437, \u043A\u043E\u043B\u0438 \u0442\u0438 \u0442\u0430\u043A
      \u043D\u0435\u0440\u043E\u0437\u0441\u0443\u0434\u043B\u0438\u0432\u043E \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043B\u0430
      \u043D\u0430\u043C \u043F\u0440\u043E \u0441\u0432\u043E\u044E \u043F\u043E\u0456\u043D\u0444\u043E\u0440\u043C\u043E\u0432\u0430\u043D\u0456\u0441\u0442\u044C
      \u043F\u0440\u043E \u043F\u043B\u0430\u043D\u0438 \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824027
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u0442\u0438 \u043C\u0435\u043D\u0435
      \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824028
    m_Localized: "\u0422\u0435\u043F\u0435\u0440 \u0442\u0438 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0439
      \u043C\u0435\u043D\u0456, \u0437\u0432\u0456\u0434\u043A\u0438 \u0432 \u0442\u0435\u0431\u0435
      \u0446\u0435\u0439 \u0437\u0430\u043F\u0438\u0441. \u042F\u043A\u0449\u043E
      \u0432\u0456\u043D - \u043D\u0435 \u043F\u0456\u0434\u0440\u043E\u0431\u043A\u0430,
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u0432\u0438\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u0437\u0430\u043C\u0456\u0448\u0430\u043D\u0438\u0439
      \u0443 \u0442\u044F\u0436\u043A\u043E\u043C\u0443 \u0437\u043B\u043E\u0447\u0438\u043D\u0456
      \u043F\u0440\u043E\u0442\u0438 \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824029
    m_Localized: "\u0423 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0456
      \u0421\u0442\u0438\u043B\u044E \u044F \u0432\u0438\u044F\u0432\u0438\u043B\u0430
      \u0448\u0430\u043C\u0430\u043D\u043A\u0443 \u041B\u0435\u0433\u0456\u043E\u043D\u0443,
      \u044F\u043A\u0430 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0430 \u043D\u0430\u0434
      \u0432\u0438\u0432\u0447\u0435\u043D\u043D\u044F\u043C \u0420\u043E\u0436\u0435\u0432\u043E\u0457
      \u0425\u043C\u0430\u0440\u0438. \u0412\u043E\u043D\u0430 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0435\u043B\u0430 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u0456
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438 \u0437 \u0432\u0430\u0448\u0438\u043C
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u043E\u044E \u0447\u0435\u0440\u0435\u0437
      \u0432\u0443\u0437\u043E\u043B \u0437\u0432'\u044F\u0437\u043A\u0443, \u0449\u043E
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0432\u0441\u044F \u0432 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0456.
      \u0417 \u043D\u044C\u043E\u0433\u043E \u044F \u0456 \u0432\u0438\u0442\u044F\u0433\u043B\u0430
      \u0446\u0435\u0439 \u0437\u0430\u043F\u0438\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824030
    m_Localized: "\u041E\u0442\u0436\u0435, \u043C\u043E\u0457 \u043F\u043E\u0431\u043E\u044E\u0432\u0430\u043D\u043D\u044F
      \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u044E\u0442\u044C\u0441\u044F.
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      - \u0448\u0430\u043D\u043E\u0432\u043D\u0438\u0439 \u043B\u0456\u0434\u0435\u0440
      \u043D\u0430\u0448\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F,
      \u043E\u0434\u043D\u0430\u043A \u0439\u043E\u0433\u043E \u043B\u043E\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0434\u043E \u0456\u0434\u0435\u0430\u043B\u0456\u0432 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0432\u0438\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u043F\u0456\u0434 \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u043F\u0438\u0442\u0430\u043D\u043D\u044F\u043C.
      \u041D\u0430\u0432\u0456\u0442\u044C \u0439\u043E\u0433\u043E \u0434\u0435\u0449\u043E
      \u0441\u0432\u043E\u0454\u0440\u0456\u0434\u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F
      \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0443 \u0441\u0443\u043F\u0435\u0440\u0435\u0447\u0438\u0442\u044C
      \u0437\u043C\u043E\u0432\u0456 \u0456\u0437 \u0437\u0435\u0431\u0440\u0430\u043C\u0438.
      \u0422\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435 - \u0437 \u041B\u0435\u0433\u0456\u043E\u043D\u043E\u043C.
      \u0423 \u0442\u0430\u043A\u043E\u0433\u043E \u0432\u0447\u0438\u043D\u043A\u0443
      \u043C\u0430\u044E\u0442\u044C \u0431\u0443\u0442\u0438 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0456
      \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0438. \u0417\u0430 \u0432\u0441\u0456\u0445
      \u043D\u0430\u0448\u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0440\u0456\u0447
      \u044F \u043D\u0435 \u0432\u0456\u0440\u044E, \u0449\u043E \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430
      \u043C\u0456\u0433 \u0432\u0447\u0438\u043D\u0438\u0442\u0438 \u0442\u0430\u043A
      \u0431\u0435\u0437 \u0432\u0430\u0433\u043E\u043C\u043E\u0457 \u043D\u0430
      \u0442\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0438. \u042F \u0437\u0430\u0440\u0430\u0437
      \u0436\u0435 \u0437\u0430\u0439\u043C\u0443\u0441\u044F \u0439\u043E\u0433\u043E
      \u043F\u043E\u0448\u0443\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824031
    m_Localized: "\u041F\u043E\u0448\u0443\u043A\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824032
    m_Localized: "\u0422\u0430\u043A. \u042F \u0456 \u043C\u0456\u0439 \u0437\u0430\u0433\u0456\u043D
      \u0441\u0432\u0456\u0434\u043E\u043C\u043E \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044E\u0432\u0430\u043B\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0432\u0456\u0440\u043D\u043E\u0457 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0443
      \u0447\u0430\u0441\u0442\u0438\u043D\u0438 \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F. \u0422\u043E\u043C\u0443
      \u043D\u0430\u0448\u0456 \u0437\u043D\u0430\u043D\u043D\u044F \u043F\u0440\u043E
      \u043F\u043E\u0442\u043E\u0447\u043D\u0443 \u0434\u0438\u0441\u043B\u043E\u043A\u0430\u0446\u0456\u044E
      \u043A\u043B\u044E\u0447\u043E\u0432\u0438\u0445 \u0444\u0456\u0433\u0443\u0440
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u0441\u0430\u043C\u043E\u0433\u043E \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0438,
      \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0456 \u0442\u0430 \u0447\u0430\u0441\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0441\u0442\u0430\u0440\u0456\u043B\u0456.
      \u041E\u0434\u043D\u0430\u043A \u0441\u0435\u0440\u0435\u0434 \u0439\u043E\u0433\u043E
      \u043B\u0438\u0446\u0430\u0440\u0456\u0432 \u0456 \u043F\u0430\u043B\u0430\u0434\u0438\u043D\u0456\u0432
      \u0454 \u043A\u0456\u043B\u044C\u043A\u0430 \u043C\u043E\u0457\u0445 \u0442\u0430\u0454\u043C\u043D\u0438\u0445
      \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0456\u0432. \u042F
      \u0437\u0432'\u044F\u0436\u0443\u0441\u044F \u0437 \u043D\u0438\u043C\u0438
      \u0456 \u0437'\u044F\u0441\u0443\u044E \u0432\u0441\u0435 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824033
    m_Localized: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0446\u0435 \u0437\u0430\u0439\u043C\u0435
      \u0447\u0430\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824034
    m_Localized: "\u041D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0434\u043E\u0431\u0438.
      \u041C\u043E\u0457\u043C \u043F\u0456\u0434\u043B\u0435\u0433\u043B\u0438\u043C
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u043F\u0435\u0432\u043D\u0443 \u0440\u043E\u0431\u043E\u0442\u0443 \u0434\u043B\u044F
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0437\u0432'\u044F\u0437\u043A\u0456\u0432,
      \u0456 \u044F\u043A\u0449\u043E \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u0442\u044C,
      \u043D\u0430\u043C \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0443\u0432\u0430\u0442\u0438
      \u0441\u0442\u0456\u0439\u043A\u0438\u0439 \u0456 \u0434\u043E\u0432\u0433\u043E\u0442\u0440\u0438\u0432\u0430\u043B\u0438\u0439
      \u0440\u0430\u0434\u0456\u043E\u043A\u043E\u043D\u0442\u0430\u043A\u0442. \u041F\u0456\u0441\u043B\u044F
      \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F \u043C\u0456\u0441\u0446\u044F
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u044F \u0432\u0438\u0441\u0442\u0443\u043F\u043B\u044E \u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824035
    m_Localized: "\u042F \u0437 \u0442\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824036
    m_Localized: "\u0422\u043E\u0431\u0456 \u044F\u043A\u0430 \u0437 \u0446\u044C\u043E\u0433\u043E
      \u043A\u043E\u0440\u0438\u0441\u0442\u044C? \u0426\u0435 - \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u044F
      \u0441\u043F\u0440\u0430\u0432\u0430 \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u0438\u0445
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432.
      \u0414\u043E\u043D\u0435\u0434\u0430\u0432\u043D\u0430 \u0442\u0438 \u0444\u0430\u043A\u0442\u0438\u0447\u043D\u043E
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u043D\u0430\u0439\u043E\u043C\u0430
      \u0437 \u043D\u0430\u043C\u0438 \u043D\u0435 \u0431\u0443\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824037
    m_Localized: "\u0422\u0435\u043F\u0435\u0440 \u0443 \u043D\u0430\u0441 \u0454
      \u0441\u043F\u0456\u043B\u044C\u043D\u0456 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824038
    m_Localized: "\u0410. \u042F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432.
      \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 - \u0442\u0432\u0456\u0439
      \u0434\u0456\u043C, \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A? \u0426\u0435
      \u043F\u043E\u044F\u0441\u043D\u044E\u0454 \u041F\u0456\u043F\u0411\u0430\u043A
      \u043D\u0430 \u0442\u0432\u043E\u0457\u0439 \u043D\u043E\u0437\u0456 \u0456
      \u0442\u0432\u043E\u044E \u043D\u0430\u0434\u043C\u0456\u0440\u043D\u043E \u0432\u0438\u0441\u043E\u043A\u0443,
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437 \u043F\u043E\u043D\u0456
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E, \u043E\u0445\u0430\u0439\u043D\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824039
    m_Localized: "\u042F \u043D\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824040
    m_Localized: "\u0413\u0430\u0440\u0430\u0437\u0434. \u0422\u043E \u0442\u0438
      \u0431\u0435\u0440\u0435\u0448 \u043C\u0435\u043D\u0435 \u0437 \u0441\u043E\u0431\u043E\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824041
    m_Localized: "\u042F\u043A\u0449\u043E \u0442\u0438 \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456, \u0446\u0435, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u043C\u0430\u0442\u0438\u043C\u0435
      \u0441\u0435\u043D\u0441. \u042F\u043A\u0449\u043E \u0432\u0456\u0440\u0438\u0442\u0438
      \u0442\u0432\u043E\u0454\u043C\u0443 \u0437\u0430\u043F\u0438\u0441\u0443,
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u043F\u0440\u0430\u0433\u043D\u0435 \u0437\u0434\u043E\u0431\u0443\u0442\u0438
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u0430\u0434 \u0442\u0432\u043E\u0457\u043C
      \u0421\u0442\u0456\u0439\u043B\u043E\u043C, \u0456 \u044F \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439,
      \u0449\u043E \u0445\u043E\u0447\u0435 \u0432\u0456\u043D \u0446\u044C\u043E\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0437 \u0436\u0430\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448
      \u0434\u043E\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F \u0437 \u043D\u0438\u043C
      \u0432\u0456\u0434 \u0456\u043C\u0435\u043D\u0456 \u0441\u0432\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430 \u0456 \u0437\u043D\u0430\u0439\u0442\u0438
      \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0456\u0441, \u0449\u043E \u0432\u0438\u043A\u043B\u044E\u0447\u0430\u0454
      \u043A\u0440\u043E\u0432\u043E\u043F\u0440\u043E\u043B\u0438\u0442\u0442\u044F
      \u0456 \u0441\u043E\u044E\u0437 \u0456\u0437 \u0437\u0435\u0431\u0440\u0430\u043C\u0438.
      \u0423 \u043D\u0430\u0441 \u0443\u0441\u0435 \u0449\u0435 \u0454 \u0448\u0430\u043D\u0441\u0438
      \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443
      \u043C\u0438\u0440\u043D\u0438\u043C \u0448\u043B\u044F\u0445\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824042
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u0456 \u0437\u0430 \u0434\u043E\u0432\u0456\u0440\u0443,
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E
      \u0432\u0436\u0435 \u0442\u0438 \u0434\u0456\u0437\u043D\u0430\u0432\u0441\u044F
      \u043F\u0440\u043E \u043C\u0456\u0439 \u0441\u0435\u043A\u0440\u0435\u0442,
      \u0442\u043E \u044F \u0442\u0435\u0436 \u043C\u0430\u044E \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u0434\u0435\u0449\u043E. \u0423 \u0447\u043E\u043C\u0443 \u0432\u0430\u0448\u0456
      \u043F\u0440\u043E\u0442\u0438\u0440\u0456\u0447\u0447\u044F \u0437 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824043
    m_Localized: "\u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442 - \u043F\u043E\u043D\u0456
      \u0437-\u043F\u043E\u043C\u0456\u0436 \u0442\u0438\u0445, \u0434\u0443\u0448\u0443
      \u044F\u043A\u0438\u0445 \u0436\u0438\u0442\u0442\u044F \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456
      \u0432\u0456\u0434\u043F\u043E\u043B\u0456\u0440\u0443\u0432\u0430\u043B\u043E
      \u0432\u0456\u0434 \u0443\u0441\u044F\u043A\u0438\u0445 \u0441\u043B\u0456\u0434\u0456\u0432
      \u0435\u043C\u043E\u0446\u0456\u0439. \u0414\u043B\u044F \u043D\u044C\u043E\u0433\u043E
      \u043D\u0435\u043C\u0430\u0454 \u0441\u043F\u0456\u0432\u0447\u0443\u0442\u0442\u044F,
      \u0439\u043E\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u043D\u0430 \u043C\u0435\u0442\u0430
      - \u043F\u0440\u043E\u0446\u0432\u0456\u0442\u0430\u043D\u043D\u044F \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0456 \u043D\u0456\u043A\u043E\u0433\u043E
      \u0431\u0456\u043B\u044C\u0448\u0435. \u0426\u0435 \u043F\u0440\u044F\u043C\u043E
      \u0437\u043D\u0435\u0432\u0430\u0436\u0430\u0454 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0456
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, \u044F\u043A\u0456
      \u0431\u0443\u043B\u0438 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0456 \u0415\u043F\u043F\u043B\u0434\u0436\u0435\u043A
      \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u0441\u0456\u0445
      \u043F\u043E\u043D\u0456. \u0410\u043B\u0435 \u0439\u043E\u0433\u043E \u043F\u043E\u0437\u0438\u0446\u0456\u044E
      \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u0434\u0456\u043B\u044F\u044E\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u043E \u0432\u043F\u043B\u0438\u0432\u043E\u0432\u0438\u0445
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0456\u0432 \u043D\u0430\u0448\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F, \u0456 \u0432\u043E\u043D\u0438
      \u0432\u043A\u0440\u0430\u0439 \u0443\u043F\u0435\u0440\u0442\u0456 \u0432
      \u043F\u0440\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u0456 \u0441\u0432\u043E\u0454\u0457
      \u043F\u043E\u043B\u0456\u0442\u0438\u043A\u0438. \u0412\u0441\u0442\u0443\u043F\u0430\u0442\u0438
      \u0437 \u043D\u0438\u043C\u0438 \u0432 \u043A\u043E\u043D\u0444\u0440\u043E\u043D\u0442\u0430\u0446\u0456\u044E
      - \u043E\u0437\u043D\u0430\u0447\u0430\u0454 \u043F\u043E\u0447\u0430\u0442\u0438
      \u0433\u0440\u043E\u043C\u0430\u0434\u044F\u043D\u0441\u044C\u043A\u0443 \u0432\u0456\u0439\u043D\u0443
      \u0432 \u043B\u0430\u0432\u0430\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432.
      \u0426\u044C\u043E\u0433\u043E \u044F \u0445\u043E\u0447\u0443 \u0449\u0435
      \u043C\u0435\u043D\u0448\u0435, \u043D\u0456\u0436 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430 \u043F\u0440\u0438 \u0432\u043B\u0430\u0434\u0456.
      \u0422\u043E\u043C\u0443 \u044F \u0456 \u043C\u043E\u0457 \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0438
      \u043F\u0440\u0430\u0433\u043D\u0435\u043C\u043E \u0443\u043D\u0438\u043A\u0430\u0442\u0438
      \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824044
    m_Localized: "\u0410\u043B\u0435, \u043D\u0430 \u0436\u0430\u043B\u044C, \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u0438\u0439
      \u0456 \u0440\u043E\u0437\u0443\u043C\u0456\u0454, \u0449\u043E \u044F \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0432\u043F\u043B\u0438\u0432\u0430\u0442\u0438 \u043D\u0430 \u0439\u043E\u0433\u043E
      \u043F\u0456\u0434\u043B\u0435\u0433\u043B\u0438\u0445. \u0422\u043E\u043C\u0443
      \u0432\u0456\u043D \u0434\u0438\u0432\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u043C\u0435\u043D\u0435 \u043D\u0435 \u0456\u043D\u0430\u043A\u0448\u0435
      \u044F\u043A \u043D\u0430 \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430
      \u0432 \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0456 \u0437\u0430 \u0432\u043B\u0430\u0434\u0443.
      \u0414\u043E \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456\u0448\u043D\u044C\u043E\u0433\u043E
      \u0434\u043D\u044F \u043D\u0430\u043C \u0432\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
      \u0443\u043D\u0438\u043A\u0430\u0442\u0438 \u0433\u043E\u0441\u0442\u0440\u0438\u0445
      \u043A\u0443\u0442\u0456\u0432 \u0443 \u0432\u0437\u0430\u0454\u043C\u0438\u043D\u0430\u0445.
      \u0429\u0438\u0440\u043E \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0449\u043E \u0446\u0435 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u044C\u0441\u044F
      \u0456 \u043D\u0430\u0434\u0430\u043B\u0456, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u0443
      \u0440\u043E\u0437\u043C\u043E\u0432\u0443, \u044F\u043A\u0430 \u0447\u0435\u043A\u0430\u0454
      \u043D\u0430 \u043D\u0430\u0441 \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u043C
      \u0447\u0430\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824045
    m_Localized: "\u0413\u0430\u0440\u0430\u0437\u0434, \u0434\u043E\u0441\u0438\u0442\u044C
      \u0431\u0430\u043B\u0430\u043A\u0430\u043D\u0438\u043D\u0438. \u042F\u043A\u0449\u043E
      \u0442\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u0448\u0441\u044F \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u043C\u0435\u043D\u0435 \u0432 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445,
      \u0442\u043E\u0431\u0456 \u0432\u0430\u0440\u0442\u043E \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438
      \u043A\u0440\u0430\u0449\u0443 \u0435\u043A\u0456\u043F\u0456\u0440\u043E\u0432\u043A\u0443.
      \u041D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u0431\u0440\u043E\u043D\u044E.
      \u041D\u0435\u0445\u0430\u0439 \u044F \u0456 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F
      \u043D\u0430 \u043C\u0438\u0440\u043D\u0438\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442,
      \u043C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u043D\u0430\u0439\u0433\u0456\u0440\u0448\u043E\u0433\u043E \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824046
    m_Localized: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430. \u042F
      \u043F\u043E\u0434\u0431\u0430\u044E \u043F\u0440\u043E \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824047
    m_Localized: "\u0412\u0434\u0430\u043B\u043E\u0441\u044F \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F,
      \u0434\u0435 \u0437\u0430\u0440\u0430\u0437 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824048
    m_Localized: "\u0422\u0430\u043A. \u0417 \u0434\u043E\u0441\u0442\u043E\u0432\u0456\u0440\u043D\u043E\u0433\u043E
      \u0434\u0436\u0435\u0440\u0435\u043B\u0430 \u043C\u0438 \u0434\u0456\u0437\u043D\u0430\u043B\u0438\u0441\u044F,
      \u0449\u043E \u0437\u0430\u0440\u0430\u0437 \u0432\u0456\u043D \u0437\u0434\u0456\u0439\u0441\u043D\u044E\u0454
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0456
      \u0441\u0442\u0430\u0440\u043E\u0457 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u043E\u0457
      \u0431\u0430\u0437\u0438 \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u043E \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
      \u0437\u0432\u0456\u0434\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824049
    m_Localized: "\u0422\u043E\u0434\u0456 \u0432\u0438\u0441\u0443\u0432\u0430\u0454\u043C\u043E\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824050
    m_Localized: "\u042F \u0431 \u043D\u0435 \u043D\u0430\u0437\u0432\u0430\u0432
      \u0442\u0435\u0431\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043E\u044E
      \u0434\u043B\u044F \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0433\u043E \u0437\u0456\u0442\u043A\u043D\u0435\u043D\u043D\u044F.
      \u041E\u0434\u043D\u0430\u043A \u043C\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u0433\u0430\u044F\u0442\u0438 \u0447\u0430\u0441 - \u044F\u043A\u0449\u043E
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442 \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u044C
      \u0432\u0438\u0440\u0443\u0448\u0438\u0442\u0438 \u0432 \u0456\u043D\u0448\u0438\u0439
      \u0446\u0435\u043D\u0442\u0440 \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F, \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F
      \u0437 \u043D\u0438\u043C \u043C\u043E\u0436\u0435 \u0432\u0438\u044F\u0432\u0438\u0442\u0438\u0441\u044F
      \u043F\u043E\u043C\u0456\u0442\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435.
      \u0412\u0438\u0441\u0442\u0443\u043F\u0430\u0454\u043C\u043E \u043D\u0435\u0433\u0430\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824051
    m_Localized: "\u041A\u043E\u043D\u0444\u043B\u0456\u043A\u0442 \u0456\u0437 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824052
    m_Localized: "\u0421\u0442\u043E\u044F\u0442\u0438 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824053
    m_Localized: "\u041E\u043F\u0443\u0441\u0442\u0438 \u0437\u0431\u0440\u043E\u044E,
      \u0420\u0456\u0434\u043B\u0435. \u0421\u0432\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824054
    m_Localized: "\u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u041F\u0430\u043B\u0430\u0434\u0438\u043D
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437! \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0430
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442 \u0437\u0432\u0438\u043D\u0443\u0432\u0430\u0442\u0438\u0432
      \u0442\u0435\u0431\u0435 \u0456 \u0442\u0432\u0456\u0439 \u0437\u0430\u0433\u0456\u043D
      \u0443 \u0437\u0440\u0430\u0434\u0456. \u041D\u0430\u043C \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u043E
      \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438 \u043D\u0430 \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824055
    m_Localized: "\u0426\u0456 \u0437\u0432\u0438\u043D\u0443\u0432\u0430\u0447\u0435\u043D\u043D\u044F
      \u0430\u0431\u0441\u0443\u0440\u0434\u043D\u0456. \u0412\u043F\u0443\u0441\u0442\u0438
      \u043C\u0435\u043D\u0435 \u0456 \u0434\u0430\u0439 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0437\u0456 \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824056
    m_Localized: "\u041C\u0438 \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u0454\u043C\u043E
      \u0432 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438 \u0437\u0456
      \u0437\u0440\u0430\u0434\u043D\u0438\u043A\u0430\u043C\u0438. \u0412\u043E\u0433\u043E\u043D\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824057
    m_Localized: "\u041F\u0440\u043E \u0437\u0440\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824058
    m_Localized: "\u0429\u043E \u0446\u0435 \u0431\u0443\u043B\u043E? \u0427\u043E\u043C\u0443
      \u0432\u043E\u043D\u0438 \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0442\u0435\u0431\u0435
      \u0437\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824059
    m_Localized: "Alea iacta est. \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u043F\u0435\u0440\u0435\u0442\u043D\u0443\u0432 \u043C\u0435\u0436\u0443 \u0456
      \u043F\u043E\u0447\u0430\u0432 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u0456\u043D \u044F\u043A\u0438\u043C\u043E\u0441\u044C
      \u0447\u0438\u043D\u043E\u043C \u0434\u0456\u0437\u043D\u0430\u0432\u0441\u044F
      \u043F\u0440\u043E \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u0441\u0432\u043E\u0454\u0457
      \u0441\u043F\u0456\u043B\u044C\u043D\u0438\u0446\u0456 \u0456 \u0432\u0438\u0440\u0456\u0448\u0438\u0432,
      \u0449\u043E \u0446\u0435 \u043C\u043E\u0457\u0445 \u043A\u043E\u043F\u0438\u0442
      \u0441\u043F\u0440\u0430\u0432\u0430. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0449\u043E\u0441\u044C \u0456\u0449\u0435. \u0422\u0430\u043A \u0447\u0438
      \u0456\u043D\u0430\u043A\u0448\u0435, \u0432\u0456\u0439\u043D\u0430 \u043F\u043E\u0447\u0430\u043B\u0430\u0441\u044F,
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u043D\u0430\u043C \u0442\u0440\u0435\u0431\u0430
      \u0434\u0456\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824060
    m_Localized: "\u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442 \u0443\u0434\u0430\u0440\u0438\u0432
      \u043F\u0435\u0440\u0448\u0438\u043C, \u0456 \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043B\u0435\u043D\u0456\u0432
      \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0430, \u044F\u043A\u0456 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C
      \u043C\u0435\u043D\u0435, \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u043F\u0456\u0434 \u0437\u0430\u0433\u0440\u043E\u0437\u043E\u044E. \u042F
      \u043F\u043E\u0432\u0438\u043D\u0435\u043D \u043D\u0435\u0433\u0430\u0439\u043D\u043E
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u043D\u0430
      \u043D\u0430\u0448\u0443 \u0431\u0430\u0437\u0443 \u0456 \u0441\u043F\u043B\u0430\u043D\u0443\u0432\u0430\u0442\u0438
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u0434\u0456\u0457.
      \u0422\u0438 \u0436 \u0442\u0435\u043F\u0435\u0440 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0448\u0441\u044F
      \u043D\u0430\u043E\u0434\u0438\u043D\u0446\u0456 \u0437 \u0441\u043E\u0431\u043E\u044E.
      \u041C\u043E\u0436\u0435\u0448 \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438
      \u0441\u0432\u043E\u0454 \u0421\u0442\u0456\u0439\u043B\u043E \u044F\u043A
      \u0432\u0432\u0430\u0436\u0430\u0454\u0448 \u0437\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824061
    m_Localized: "\u0427\u0438 \u043C\u043E\u0436\u0443 \u044F \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u0432\u0430\u0441 \u0443 \u0446\u044C\u043E\u043C\u0443 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824062
    m_Localized: "\u0425\u043E\u0447 \u044F \u0456 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u044E
      \u043D\u0430 \u043D\u0430\u0448\u0443 \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u044E,
      \u044F \u0449\u0435 \u043D\u0435 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0432\u0456\u0440\u044F\u044E \u0442\u043E\u0431\u0456, \u0432\u0438\u0445\u043E\u0434\u0435\u0446\u044C
      \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430. \u041A\u0440\u0456\u043C
      \u0442\u043E\u0433\u043E, \u043C\u043E\u0457 \u043F\u0456\u0434\u043B\u0435\u0433\u043B\u0456
      \u043D\u0435 \u043C\u0430\u044E\u0442\u044C \u0431\u043E\u0439\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u0441\u0432\u0456\u0434\u0443 \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457
      \u0437 \u043B\u0435\u0433\u043A\u043E\u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u043C\u0438
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C\u0438, \u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u0432 \u0431\u0438\u0442\u0432\u0456
      \u043C\u043E\u0436\u0435\u043C\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u0438 \u0441\u0430\u043C\u0456.
      \u0411\u0443\u0434\u0435 \u043A\u0440\u0430\u0449\u0435 \u0434\u043B\u044F
      \u0432\u0441\u0456\u0445, \u044F\u043A\u0449\u043E \u0442\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0456\u0434\u0435\u0448 \u0443 \u0442\u0456\u043D\u044C \u043D\u0430
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824063
    m_Localized: "\u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824064
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824065
    m_Localized: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0439 \u0434\u0438\u043A\u0443\u043D!
      \u042F\u043A \u0441\u043C\u0456\u0454\u0448 \u0442\u0438 \u0432\u0442\u043E\u0440\u0433\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0431\u0430\u0437\u0443 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0456 \u0432\u0431\u0438\u0432\u0430\u0442\u0438
      \u043C\u043E\u0457\u0445 \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824066
    m_Localized: "\u0422\u0438 \u0441\u0430\u043C \u0434\u0430\u0432 \u043C\u0435\u043D\u0456
      \u043F\u0440\u0438\u0432\u0456\u0434. \u0412\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E
      \u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043F\u043E\u0434\u0430\u043B\u0456
      \u0441\u0432\u043E\u0457 \u043A\u043E\u043F\u0438\u0442\u0430 \u0432\u0456\u0434
      \u0421\u0442\u0456\u0439\u043B\u0430 \u041F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824067
    m_Localized: "\u0426\u0435 \u0442\u0432\u043E\u044F \u043C\u0435\u0442\u0430?
      \u0426\u0435 \u0442\u0432\u043E\u044F \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0456\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824068
    m_Localized: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u043B\u0430\u0432\u043D\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0442\u0438 \u0432\u0431\u0438\u043B\u0430 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456?
      \u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u043A\u0440\u043E\u0432\u0456 \u043F\u0440\u043E\u043B\u0438\u043B\u0438
      \u0442\u0432\u043E\u0457 \u043A\u043E\u043F\u0438\u0442\u0430? \u041C\u0438
      \u043B\u0438\u0448\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454\u043C\u043E
      \u0441\u0432\u0456\u0439 \u0434\u0456\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824069
    m_Localized: "\u0406 \u0437\u0431\u0438\u0440\u0430\u0454\u0442\u0435\u0441\u044F
      \u0440\u043E\u0437\u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438 \u043C\u0456\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824070
    m_Localized: "\u041F\u043E\u043D\u0456 \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C \u043F\u0440\u0438
      \u0441\u043E\u0431\u0456 \u0441\u0435\u043A\u0440\u0435\u0442\u0438, \u044F\u043A\u0456
      \u043C\u043E\u0433\u043B\u0438 \u0431 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445!
      \u0412\u0438 \u0432\u043A\u0440\u0430\u0439 \u0436\u0430\u0434\u0456\u0431\u043D\u0456
      \u0456 \u0431\u0435\u0437\u043C\u0456\u0440\u043D\u043E \u0434\u0443\u0440\u043D\u0456,
      \u0446\u0456 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 \u043D\u0435
      \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u0438
      \u043B\u0438\u0448\u0435 \u0432\u0430\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824071
    m_Localized: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E, \u043D\u0435\u043C\u0430\u0454
      \u0441\u0435\u043D\u0441\u0443 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u0442\u0438
      \u0440\u043E\u0437\u043C\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824072
    m_Localized: "\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F, \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0430
      \u0432\u0456\u0434 \u0421\u0442\u0456\u043B\u0445\u0443\u0432\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824073
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, @lp. \u0421\u0445\u043E\u0436\u0435,
      \u044F \u043D\u0435\u0434\u043E\u043E\u0446\u0456\u043D\u0438\u0432 \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824074
    m_Localized: "\u0422\u0438 \u043F\u0440\u043E \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824075
    m_Localized: "\u0422\u0438 \u043B\u0456\u043A\u0432\u0456\u0434\u0443\u0432\u0430\u043B\u0430
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430. \u041C\u043E\u0457
      \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0438 \u0441\u0435\u0440\u0435\u0434
      \u0439\u043E\u0433\u043E \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u043B\u0438 \u043C\u0435\u043D\u0456
      \u043F\u0440\u043E \u0446\u0435 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0449\u043E\u0439\u043D\u043E. \u0422\u0438 \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u0432\u043A\u0440\u0430\u0439 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u043A\u0440\u043E\u043A. \u0414\u043E \u0446\u044C\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0443
      \u0442\u0438 \u0431\u0443\u043B\u0430 \u043D\u0456\u043A\u0438\u043C \u0434\u043B\u044F
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432.
      \u041F\u0456\u0441\u043B\u044F \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430
      \u0421\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0438 \u0439\u043E\u0433\u043E
      \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0438 \u043D\u0435
      \u0437\u0430\u0431\u0443\u0434\u0443\u0442\u044C \u0442\u0435\u0431\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u043A\u043E\u043B\u0438. \u0412\u0456\u0434\u0442\u0435\u043F\u0435\u0440
      \u0442\u043E\u0431\u0456 \u0441\u043B\u0456\u0434 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438
      \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824076
    m_Localized: "\u041F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0438?
      \u0425\u0456\u0431\u0430 \u043F\u0456\u0441\u043B\u044F \u0441\u043C\u0435\u0440\u0442\u0456
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430 \u0432\u0430\u0448 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442
      \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u0435\u043D \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824077
    m_Localized: "\u041D\u0430\u0432\u043F\u0430\u043A\u0438, \u0442\u0435\u043F\u0435\u0440
      \u0432\u0456\u043D \u0441\u0442\u0430\u043D\u0435 \u0449\u0435 \u0437\u0430\u043F\u0435\u043A\u043B\u0456\u0448\u0438\u043C.
      \u0423\u0442\u0456\u043C, \u0446\u0435 \u0431\u0443\u043B\u043E \u043D\u0435\u043C\u0438\u043D\u0443\u0447\u0435.
      \u0404\u0434\u0438\u043D\u0438\u043C \u0448\u0430\u043D\u0441\u043E\u043C \u043D\u0430
      \u0443\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F \u043A\u0440\u043E\u0432\u043E\u043F\u0440\u043E\u043B\u0438\u0442\u0442\u044F
      \u0431\u0443\u043B\u0430 \u043C\u043E\u044F \u0432\u0456\u0434\u043C\u043E\u0432\u0430
      \u0432\u0456\u0434 \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F
      \u0456 \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u0435 \u0432\u0438\u0433\u043D\u0430\u043D\u043D\u044F.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E
      \u0431\u0443\u043B\u043E \u0442\u0430\u043A \u0432\u0447\u0438\u043D\u0438\u0442\u0438.
      \u0417\u0430\u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E
      \u0445\u0442\u043E \u0432\u0436\u0435 \u0437\u0430\u0433\u0438\u043D\u0443\u0432
      \u0447\u0435\u0440\u0435\u0437 \u0446\u0435 \u043F\u0440\u043E\u0442\u0438\u0441\u0442\u043E\u044F\u043D\u043D\u044F,
      \u0456 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u0437\u0430\u0433\u0438\u043D\u0435 \u0432 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824078
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0442\u043E\u0431\u0456
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u0435\u0449\u043E \u0437\u043D\u0430\u0442\u0438.
      \u041E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0442\u0438 \u0437\u0430\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0432\u0430\u043B\u0430
      \u0441\u0435\u0431\u0435 \u044F\u043A \u043F\u043E\u0441\u043B\u0456\u0434\u043E\u0432\u043D\u0438\u0439
      \u0456 \u043D\u0435\u043F\u0440\u0438\u043C\u0438\u0440\u0435\u043D\u043D\u0438\u0439
      \u0432\u043E\u0440\u043E\u0433 \u0456\u0434\u0435\u0439 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430,
      \u044F \u0432\u0432\u0430\u0436\u0430\u044E, \u0449\u043E \u043C\u043E\u0436\u0443
      \u0434\u043E\u0432\u0456\u0440\u044F\u0442\u0438 \u0442\u043E\u0431\u0456 \u0431\u0456\u043B\u044C\u0448\u043E\u044E
      \u043C\u0456\u0440\u043E\u044E, \u043D\u0456\u0436 \u0440\u0430\u043D\u0456\u0448\u0435.
      \u0406 \u0432\u0432\u0430\u0436\u0430\u044E \u0437\u0430 \u0434\u043E\u0446\u0456\u043B\u044C\u043D\u0435
      \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438 \u0442\u0435\u0431\u0435
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E, \u044F\u043A\u0430
      \u043C\u043E\u0436\u0435 \u0442\u043E\u0431\u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824079
    m_Localized: "\u041F\u0435\u0440\u0448\u0435: \u0437\u0440\u0430\u0434\u043D\u0438\u0446\u044C\u043A\u0430
      \u0437\u043C\u043E\u0432\u0430 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430
      \u0456 \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u043F\u0443\u0441\u0442\u0438\u043B\u0430
      \u0441\u0432\u043E\u0454 \u043A\u043E\u0440\u0456\u043D\u043D\u044F \u0434\u0443\u0436\u0435
      \u0433\u043B\u0438\u0431\u043E\u043A\u043E. \u0421\u0443\u0434\u044F\u0447\u0438
      \u0437 \u0443\u0441\u044C\u043E\u0433\u043E, \u043C\u0430\u0439\u0436\u0435
      \u0432\u0441\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0438 \u0439\u043E\u0433\u043E
      \u043F\u0456\u0434\u0440\u043E\u0437\u0434\u0456\u043B\u0456\u0432 \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0440\u044F\u0434\u043E\u0432\u0456 \u043B\u0438\u0446\u0430\u0440\u0456 \u0432
      \u043A\u0443\u0440\u0441\u0456 \u0446\u044C\u043E\u0433\u043E \u0441\u043E\u044E\u0437\u0443
      \u0456 \u0433\u043E\u0442\u043E\u0432\u0456 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438
      \u0439\u043E\u0433\u043E. \u0426\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044F \u0446\u0438\u0445
      \u0434\u0432\u043E\u0445 \u0441\u0438\u043B \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u044C\u0441\u044F
      \u0456, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u0435\u0431\u0440\u0438
      \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C \u0442\u0430\u043A\u043E\u0436
      \u0432\u0441\u0442\u0443\u043F\u043B\u044F\u0442\u044C \u0443 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442.
      \u041D\u0430\u043C \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0456
      \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u0443\u043A\u043B\u0430\u0434\u0435\u043D\u043D\u044F
      \u0446\u044C\u043E\u0433\u043E \u0441\u043E\u044E\u0437\u0443, \u043F\u0440\u043E\u0442\u0435
      \u043C\u043E\u0457 \u043F\u0440\u0438\u0445\u0438\u043B\u044C\u043D\u0438\u043A\u0438
      \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C \u043D\u0430\u0434 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F\u043C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E\u0457 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824080
    m_Localized: "\u0414\u0440\u0443\u0433\u0435: \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442
      \u0432\u043E\u043B\u043E\u0434\u0456\u0432 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F\u043C\u0438
      \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0431\u043E\u0439\u043E\u0432\u043E\u0433\u043E \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430,
      \u044F\u043A\u0438\u0439, \u0441\u0443\u0434\u044F\u0447\u0438 \u0437 \u0443\u0441\u044C\u043E\u0433\u043E,
      \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u044F\u044E\u0442\u044C \u0443 \u0442\u0432\u043E\u0454\u043C\u0443
      \u0421\u0442\u0456\u0439\u043B\u0456. \u041D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0446\u0435\u0439 \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442
      \u0456 \u0431\u0443\u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u044E
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u044E \u0437\u0430\u0446\u0456\u043A\u0430\u0432\u043B\u0435\u043D\u043E\u0441\u0442\u0456
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430 \u0432 \u0421\u0442\u0456\u0439\u043B\u0456
      \u041F\u0456. \u0426\u0435 \u0431\u0440\u043E\u043D\u044F \u0456 \u0437\u0431\u0440\u043E\u044F
      \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E, \u0449\u043E \u043C\u0430\u0454
      \u043D\u0438\u0449\u0456\u0432\u043D\u0443 \u0431\u043E\u0439\u043E\u0432\u0443
      \u043C\u0456\u0446\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824081
    m_Localized: "\u041E\u0434\u043D\u0430\u043A \u0432\u0456\u043D \u043C\u043E\u0436\u0435
      \u0456\u0441\u043D\u0443\u0432\u0430\u0442\u0438 \u043B\u0438\u0448\u0435 \u0432
      \u0454\u0434\u0438\u043D\u043E\u043C\u0443 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0456:
      \u0434\u043B\u044F \u0439\u043E\u0433\u043E \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0456
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438,
      \u044F\u043A\u0456 \u043D\u0435 \u043C\u0430\u044E\u0442\u044C \u0432\u0456\u0434\u043E\u043C\u0438\u0445
      \u043C\u0435\u043D\u0456 \u0430\u043D\u0430\u043B\u043E\u0433\u0456\u0432.
      \u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438, \u044F
      \u0456 \u043F\u0440\u043E \u043D\u0438\u0445 \u043D\u0435 \u0447\u0443\u0432
      \u0434\u043E \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457
      \u0449\u043E\u0434\u043E \u0446\u044C\u043E\u0433\u043E \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430.
      \u041F\u0440\u043E\u0435\u043A\u0442\u0438 \u0437 \u0439\u043E\u0433\u043E
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u043C\u0430\u044E\u0442\u044C
      \u043D\u0430\u0437\u0432\u0438 \"\u0421\u043E\u043D\u0446\u0435\" \u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\".
      \u042F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
      \u0449\u043E \u0442\u0435\u0431\u0435 \u0431\u0443\u043B\u043E \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E \u0434\u043B\u044F
      \u0437\u0431\u043E\u0440\u0443 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824082
