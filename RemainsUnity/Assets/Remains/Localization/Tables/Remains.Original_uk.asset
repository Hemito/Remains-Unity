    m_Localized: "\u0423\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F, \u0449\u043E \u043F\u043E\u0454\u0434\u043D\u0443\u0454
      \u0432 \u0441\u043E\u0431\u0456 \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0443
      \u0432 \u043E\u0431\u0456\u0433\u0443, \u0433\u0430\u0440\u043D\u0443 \u0432\u043E\u0433\u043D\u0435\u0432\u0443
      \u043C\u0456\u0446\u044C \u0456 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456\u0441\u0442\u044C
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241276
    m_Localized: "\"\u041F\u0430\u0442\u0440\u0456\u043E\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241277
    m_Localized: "\u0423\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0435\u043D\u0430
      \u043C\u043E\u0434\u0435\u043B\u044C \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u043E\u0457
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438. \u041A\u0430\u0436\u0443\u0442\u044C,
      \u0457\u0445 \u0432\u0438\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0432\u0441\u044C\u043E\u0433\u043E
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u043E\u0442\u0435\u043D\u044C \u043D\u0430\u043F\u0440\u0438\u043A\u0456\u043D\u0446\u0456
      \u0412\u0435\u043B\u0438\u043A\u043E\u0457 \u0412\u0456\u0439\u043D\u0438,
      \u0442\u043E\u0436 \u0442\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0438
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0443 \u0434\u0443\u0436\u0435 \u0440\u0456\u0434\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241278
    m_Localized: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u0439 \u043A\u0430\u0440\u0430\u0431\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241279
    m_Localized: "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439 \u043A\u0440\u043E\u043A
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437\u0456 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u043E\u044E
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u043E\u044E. \u0426\u044F
      \u0437\u0431\u0440\u043E\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0456\u0448\u0430,
      \u0442\u043E\u0447\u043D\u0456\u0448\u0430 \u0439 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241280
    m_Localized: "\"\u041E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241281
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u0439 \u043A\u0430\u0440\u0430\u0431\u0456\u043D,
      \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439 \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043E\u044E
      \u043E\u043F\u0442\u0438\u043A\u043E\u044E \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u0438\u043C
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043C\u0440\u0456\u044F \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0444\u0430\u043D\u0430\u0442\u0430 \u0433\u0430\u0440\u043D\u043E\u0457 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241282
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241283
    m_Localized: "\u041E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u0433\u043B\u0443\u0448\u043D\u0438\u043A\u043E\u043C
      \u0456 \u043E\u043F\u0442\u0438\u0447\u043D\u0438\u043C \u043F\u0440\u0438\u0446\u0456\u043B\u043E\u043C.
      \u041A\u0443\u043B\u0456, \u0432\u0438\u043F\u0443\u0449\u0435\u043D\u0456
      \u0437 \u043D\u0435\u0457, \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F
      \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u043D\u043E\u043C, \u0449\u043E
      \u043F\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u0456 \u0437\u0430\u043F\u0430\u043B\u044E\u044E\u0442\u044C
      \u0446\u0456\u043B\u044C. \u0421\u0442\u0440\u0456\u043B\u044F\u0454 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0447\u0435\u0440\u0433\u0430\u043C\u0438 \u043F\u043E 3 \u043A\u0443\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241284
    m_Localized: "\"\u0410\u0442\u0440\u043E\u043F\u043E\u0441\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241285
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0430 \u0437\u0435\u0431\u0456\u043D\u0441\u044C\u043A\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430, \u0449\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u0430
      \u0426\u0435\u043D\u0442\u0443\u0440\u0456\u043E\u043D\u0443 \u0423\u043F\u0430\u043D\u0437\u0456.
      \u041D\u0430\u043A\u043B\u0430\u0434\u0435\u043D\u0456 \u043D\u0430 \u043D\u0435\u0457
      \u0432\u043E\u0433\u043D\u044F\u043D\u0456 \u0447\u0430\u0440\u0438 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456, \u043D\u0456\u0436 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439.
      \u041E\u0434\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u043D\u043E, \u0449\u043E
      \u0442\u0443\u0442 \u043F\u043E\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432
      \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0438\u0439 \u0448\u0430\u043C\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241286
    m_Localized: "\u0421\u043F\u0430\u0440\u043A\u043B-\u0430\u0432\u0442\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241287
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0430
      \u043B\u0430\u0437\u0435\u0440\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430,
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454 \u043F\u043E\u0442\u0456\u043A
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u043F\u0440\u043E\u043C\u0435\u043D\u0456\u0432
      \u0444\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u043E\u0440\u0443.
      \u0421\u0442\u0440\u0456\u043B\u044F\u0454 \u0447\u0435\u0440\u0433\u0430\u043C\u0438
      \u043F\u043E 3 \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241288
    m_Localized: "\"\u0420\u0435\u043A\u0432\u0456\u0454\u043C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241289
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0441\u043F\u0430\u0440\u043A\u043B-\u0430\u0432\u0442\u043E\u043C\u0430\u0442,
      \u0442\u0432\u043E\u0440\u0446\u0435\u0432\u0456 \u044F\u043A\u043E\u0433\u043E
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0431\u0440\u043E\u0457 \u0448\u043B\u044F\u0445\u043E\u043C
      \u0434\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u043E\u0445\u043E\u043B\u043E\u0434\u0436\u0435\u043D\u043D\u044F.
      \u0422\u0430\u043A\u043E\u0436 \u0442\u0443\u0442 \u0454 \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0439
      \u043F\u043B\u0435\u0454\u0440, \u043E\u0434\u043D\u0430\u043A \u0432\u0456\u043D
      \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241290
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241291
    m_Localized: "\u0417\u0431\u0440\u043E\u044F \u043D\u0438\u0449\u0456\u0432\u043D\u043E\u0457
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456, \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454
      \u043F\u043E \u0432\u043E\u0440\u043E\u0433\u0443 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
      \u0448\u043A\u0432\u0430\u043B \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u043E\u0433\u043E
      \u0432\u043E\u0433\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241292
    m_Localized: "\"\u0410\u0433\u043E\u043D\u0456\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241293
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u043B\u0430\u0437\u043C\u043E\u043C\u0435\u0442
      \u0437 \u043D\u0435\u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u044E
      \u043C\u0430\u0442\u0440\u0438\u0446\u0435\u044E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C.
      \u0419\u043E\u0433\u043E \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0456 \u0441\u043D\u0430\u0440\u044F\u0434\u0438
      \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u0430\u0431\u043E \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0456\u0433\u043D\u043E\u0440\u0443\u044E\u0442\u044C \u0431\u0440\u043E\u043D\u044E,
      \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u044C \u0446\u044E \u0437\u0431\u0440\u043E\u044E
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0456\u0434\u0441\u0442\u0443\u043F\u043D\u0456\u0448\u043E\u044E
      \u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241294
    m_Localized: "\u0413\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430 \"\u041F\u0440\u0438\u0431\u0456\u0439\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241295
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430 \u0437\u0431\u0440\u043E\u044F,
      \u0449\u043E \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454 \u043D\u0430
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u0456 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445
      \u0441\u0438\u043B \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u0410\u043D\u043A\u043B\u0430\u0432\u0443
      \u041F\u0435\u0433\u0430\u0441\u0456\u0432. \u042F\u0432\u043B\u044F\u0454
      \u0441\u043E\u0431\u043E\u044E \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0438\u0439
      \u0440\u043E\u0437\u0432\u0438\u0442\u043E\u043A \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241296
    m_Localized: "\"\u0426\u0443\u043D\u0430\u043C\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241297
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0430 \u0432\u0435\u0440\u0441\u0456\u044F
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438 \"\u041F\u0440\u0438\u0431\u0456\u0439\",
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430 \u0456 \u043D\u0430\u0434\u0456\u0439\u043D\u0456\u0448\u0430
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443. \u0412\u0438\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430\u043C
      \u0441\u043F\u0435\u0446\u043F\u0456\u0434\u0440\u043E\u0437\u0434\u0456\u043B\u0456\u0432
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241298
    m_Localized: "\u041B\u0435\u0433\u043A\u0438\u0439 \u043A\u0443\u043B\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241299
    m_Localized: "\u0414\u0443\u0436\u0435 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430,
      \u043F\u043E\u0442\u0443\u0436\u043D\u0430 \u0456 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F, \u0430\u043B\u0435 \u0432\u0438\u043C\u0430\u0433\u0430\u0454
      \u0447\u0438\u043C\u0430\u043B\u043E\u0433\u043E \u0434\u043E\u0441\u0432\u0456\u0434\u0443
      \u0432 \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u0456 \u0437
      \u043D\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241300
    m_Localized: "\"\u0420\u043E\u043A\u0456\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241301
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0430 \u0432\u0435\u0440\u0441\u0456\u044F
      \u043B\u0435\u0433\u043A\u043E\u0433\u043E \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0430,
      \u0442\u0440\u043E\u0445\u0438 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430
      \u0456 \u0442\u043E\u0447\u043D\u0456\u0448\u0430 \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443.
      \u0420\u0430\u043D\u0456\u0448\u0435 \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u0430
      \u0441\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0456 \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241302
    m_Localized: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241303
    m_Localized: "\u0426\u044F \u0437\u0431\u0440\u043E\u044F \u044F\u0432\u043B\u044F\u0454
      \u0441\u043E\u0431\u043E\u044E \u0433\u0456\u0431\u0440\u0438\u0434 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438
      \u0456 \u043B\u0435\u0433\u043A\u043E\u0433\u043E \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0430.
      \u0412\u043E\u043D\u0430 \u0432\u0435\u043B\u044C\u043C\u0438 \u0442\u043E\u0447\u043D\u0430
      \u0456 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0430,
      \u0449\u043E\u0431 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
      \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043D\u0443 \u0449\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0432\u043E\u0433\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241304
    m_Localized: "\u0410\u043D\u0442\u0438\u0434\u0440\u0430\u043A\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241305
    m_Localized: "\u0417\u0435\u043D\u0456\u0442\u043D\u0438\u0439 \u043A\u0443\u043B\u0435\u043C\u0435\u0442,
      \u043F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u043D\u0430
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0443 \u0437\u0431\u0440\u043E\u044E,
      \u043A\u043E\u043B\u0438\u0441\u044C \u0439\u043E\u0433\u043E \u0439 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u044F\u043B\u0438 \u0437 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u0443
      \u043D\u0430 \u0431\u0456\u0439 \u0456\u0437 \u0434\u0440\u0430\u043A\u043E\u043D\u0430\u043C\u0438.
      \u0412\u0456\u043D \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0430\u0436\u043A\u0438\u0439,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E \u0431 \u0437\u043C\u0456\u0433 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u0439 \u0437\u0435\u043C\u043D\u043E\u043F\u043E\u043D\u0456,
      \u043D\u0443 \u0430\u0431\u043E \u0454\u0434\u0438\u043D\u043E\u0440\u0456\u0433,
      \u044F\u043A\u0438\u0439 \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u043E
      \u043E\u043F\u0430\u043D\u0443\u0432\u0430\u0432 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241306
    m_Localized: "\"\u041C\u0430\u043B\u044F\u0442\u043A\u043E \u0413\u0456\u043B\u044C\u0434\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241307
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 14,5-\u043C\u043C
      \u043A\u0443\u043B\u0435\u043C\u0435\u0442, \u043F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u043D\u0430 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0443 \u0437\u0431\u0440\u043E\u044E
      \u0433\u0440\u0438\u0444\u043E\u043D\u0430\u043C\u0438. \u041A\u043E\u043B\u0438\u0441\u044C
      \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u043E\u0434\u043D\u043E\u043C\u0443
      \u0456\u0437 \u0437\u0430\u0433\u043E\u043D\u0456\u0432 \u041A\u0456\u0433\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241308
    m_Localized: "\u0421\u0442\u0430\u043D\u043A\u043E\u0432\u0438\u0439 \u043A\u0443\u043B\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241309
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0438\u0439
      \u043A\u0443\u043B\u0435\u043C\u0435\u0442, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439
      \u0440\u0430\u0434\u0448\u0435 \u0434\u043B\u044F \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F
      \u0432\u043E\u0433\u043D\u0435\u0432\u0438\u0445 \u0442\u043E\u0447\u043E\u043A,
      \u043D\u0456\u0436 \u0434\u043B\u044F \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E\u0433\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F. \u041D\u0430\u0434\u0442\u043E
      \u0432\u0436\u0435 \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0456 \u0432\u0430\u0436\u043A\u0438\u0439.
      \u0417\u0430\u0442\u0435 \u0439\u043E\u0433\u043E \u0432\u043E\u0433\u043D\u0435\u0432\u0430
      \u043C\u0456\u0446\u044C \u0431\u0456\u043B\u044C\u0448 \u043D\u0456\u0436
      \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241310
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0438\u0439
      \u043F\u043B\u0430\u0437\u043C\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241311
    m_Localized: "\u0414\u043E\u043E\u043F\u0440\u0430\u0446\u044C\u043E\u0432\u0430\u043D\u0430
      \u043F\u0435\u0440\u0435\u0434 \u0441\u0430\u043C\u0438\u043C \u0410\u043F\u043E\u043A\u0430\u043B\u0456\u043F\u0441\u0438\u0441\u043E\u043C
      \u0432\u0435\u0440\u0441\u0456\u044F \u043F\u043B\u0430\u0437\u043C\u043E\u043C\u0435\u0442\u0430,
      \u0431\u043E\u0439\u043E\u0432\u0456 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u044F\u043A\u043E\u0457 \u0437\u043D\u0430\u0447\u043D\u043E \u0432\u0438\u0449\u0456.
      \u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0432\u0456\u0434\u043E\u043C\u043E,
      \u0442\u0430\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457 \u0431\u0443\u043B\u043E
      \u0432\u0438\u043F\u0443\u0449\u0435\u043D\u043E \u0432\u0441\u044C\u043E\u0433\u043E
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0434\u0435\u0441\u044F\u0442\u043A\u0456\u0432
      \u043E\u0434\u0438\u043D\u0438\u0446\u044C, \u043F\u0456\u0441\u043B\u044F
      \u0447\u043E\u0433\u043E \u0437\u0430\u0432\u043E\u0434, \u043D\u0430 \u044F\u043A\u043E\u043C\u0443
      \u0457\u0457 \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044F\u043B\u0438,
      \u0431\u0443\u043B\u043E \u0437\u043D\u0438\u0449\u0435\u043D\u043E \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241312
    m_Localized: "\"\u041F\u0443\u043B\u044C\u0441\u0430\u0440\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241313
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0438\u0439
      \u043F\u043B\u0430\u0437\u043C\u043E\u043C\u0435\u0442, \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F
      \u044F\u043A\u043E\u0433\u043E \u0431\u0443\u043B\u0430 \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u0430
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u043C \u043C\u0430\u0439\u0441\u0442\u0440\u043E\u043C.
      \u0421\u0445\u043E\u0436\u0435, \u0432\u0456\u043D \u0440\u043E\u043A\u0430\u043C\u0438
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0432\u0441\u044F \u0432 \u0437\u0430\u043F\u0430\u0441\u043D\u0438\u043A\u0430\u0445
      \"\u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432\",
      \u0447\u0435\u043A\u0430\u044E\u0447\u0438 \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E
      \u0447\u043E\u0433\u043E. \u0406 \u043E\u0441\u044C, \u0434\u043E\u0447\u0435\u043A\u0430\u0432\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241314
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u0439 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241315
    m_Localized: "\u0426\u0435\u0439 \u0434\u0440\u0435\u0432\u043D\u0456\u0439 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A
      \u043D\u0430\u0441\u043A\u0440\u0456\u0437\u044C \u043F\u0440\u043E\u0440\u0436\u0430\u0432\u0456\u0432
      \u0456 \u043C\u0430\u0439\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u0440\u043E\u0437\u0432\u0430\u043B\u0438\u0442\u0438\u0441\u044F \u043D\u0430
      \u0447\u0430\u0441\u0442\u0438\u043D\u0438. \u0425\u043E\u0447\u0430 \u0437
      \u043D\u044C\u043E\u0433\u043E \u0432\u0441\u0435 \u0449\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E
      \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438, \u0440\u043E\u0431\u0438\u0442\u0438
      \u0446\u0435 \u0434\u043E\u0431\u0440\u0435 \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0432\u0438\u0439\u0434\u0435. \u041C\u043E\u0436\u043D\u0430
      \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u0432\u0430 \u043F\u0430\u0442\u0440\u043E\u043D\u0438 \u0437\u0430
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241316
    m_Localized: "\"\u0417\u0431\u0438\u0432\u0430\u0447 \u044F\u0431\u043B\u0443\u043A\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241317
    m_Localized: "\u0410\u043D\u0442\u0438\u043A\u0432\u0430\u0440\u043D\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0443 \u0433\u0430\u0440\u043D\u043E\u043C\u0443
      \u0441\u0442\u0430\u043D\u0456. \u0412\u0438\u0434\u043D\u043E, \u0449\u043E
      \u043A\u043E\u043B\u0438\u0441\u044C \u0437\u0430 \u043D\u0438\u043C \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E
      \u0456 \u0437 \u043B\u044E\u0431\u043E\u0432'\u044E \u0434\u043E\u0433\u043B\u044F\u0434\u0430\u043B\u0438
      \u0456 \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u043B\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241318
    m_Localized: "\u0412\u0430\u0436\u0456\u043B\u044C\u043D\u0438\u0439 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241319
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u0430
      \u043F\u0456\u0434 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430
      \u0437 \u0432\u0430\u0436\u0456\u043B\u044C\u043D\u0438\u043C \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F\u043C,
      \u0443\u043A\u043E\u0440\u043E\u0447\u0435\u043D\u0438\u0439 \u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u0430 \u0434\u043E\u0432\u0433\u0438\u0439 \u0441\u0442\u0432\u043E\u043B
      \u043E\u0431\u0440\u0456\u0437\u0430\u043D\u0438\u0439. \u0415\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u043C\u0443
      \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241320
    m_Localized: "\u041E\u0431\u0440\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241321
    m_Localized: "\u0414\u0432\u043E\u0441\u0442\u0432\u043E\u043B\u043A\u0430 \u0437
      \u043E\u0431\u0440\u0456\u0437\u0430\u043D\u0438\u043C \u0441\u0442\u0432\u043E\u043B\u043E\u043C.
      \u0414\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0442\u0443\u0436\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F, \u0430\u043B\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043A\u0443\u0442 \u0440\u043E\u0437\u043B\u044C\u043E\u0442\u0443
      \u0434\u0440\u043E\u0431\u0443 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0456\u0439
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u0457. \u041C\u043E\u0436\u0435
      \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u0438\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u0432\u0456\u0447\u0456, \u043F\u0456\u0441\u043B\u044F \u0447\u043E\u0433\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F.
      \u0429\u043E, \u0437\u0432\u0456\u0441\u043D\u043E, \u043D\u0435 \u0434\u0443\u0436\u0435
      \u0437\u0440\u0443\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241322
    m_Localized: "\"\u0412\u0438\u0449\u0430 \u043C\u0456\u0440\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241323
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043E\u0431\u0440\u0456\u0437,
      \u0449\u043E \u043A\u043E\u043B\u0438\u0441\u044C, \u0441\u0445\u043E\u0436\u0435,
      \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u044F\u043A\u043E\u043C\u0443\u0441\u044C
      \u0448\u0435\u0440\u0438\u0444\u0443. \u041D\u0430 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0456
      \u0432\u0441\u0435 \u0449\u0435 \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u0440\u0456\u0437\u043D\u0438\u0442\u0438
      \u0456\u043C'\u044F \"\u0421\u0456\u043B\u044C\u0432\u0435\u0440\u0441\u0442\u0430\u0440\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241324
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0438\u0439 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A
      \u0410\u0424-9"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241325
    m_Localized: "\u041D\u0430\u043F\u0456\u0432\u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0456\u0437 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u043D\u0438\u043C
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C, \u043E\u0434\u043D\u0430
      \u0437 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439
      \u0437\u0431\u0440\u043E\u0457, \u044F\u043A\u0443 \u0440\u043E\u0437\u0440\u043E\u0431\u0438\u0432
      \u0410\u0439\u0440\u043E\u043D\u0448\u043E\u0434 \u0424\u0430\u0439\u0440\u0430\u0440\u043C\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241326
    m_Localized: "\"\u0415\u0440\u0435\u0431\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241327
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u0431\u043E\u0439\u043E\u0432\u0438\u0439 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A
      \u0456\u0437 \u043F\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u0438\u043C \u0441\u0442\u0432\u043E\u043B\u043E\u043C
      \u0456 \u0434\u043E\u043E\u043F\u0440\u0430\u0446\u044C\u043E\u0432\u0430\u043D\u043E\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E \u043F\u043E\u0434\u0430\u0447\u0456
      \u043F\u0430\u0442\u0440\u043E\u043D\u0430, \u0449\u043E \u0434\u0430\u0454
      \u0437\u043C\u043E\u0433\u0443 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438
      \u0442\u043E\u0447\u043D\u0456\u0448\u0435 \u0456 \u0448\u0432\u0438\u0434\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241328
    m_Localized: "\u041F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241329
    m_Localized: "\u0414\u0440\u043E\u0431\u043E\u0432\u0438\u043A, \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043D\u0438\u0439
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u043C\u0438 \u0441\u0438\u043B\u043E\u0432\u0438\u043C\u0438
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430\u043C\u0438, \u0456
      \u0437\u0430\u0440\u0430\u0437 \u0434\u0443\u0436\u0435 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0438\u0439
      \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0441\u0432\u043E\u0457\u0439 \u0431\u043E\u0439\u043E\u0432\u0456\u0439
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456. \u041C\u0430\u0454
      \u0432\u0438\u0441\u043E\u043A\u0443 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0456 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u043E\u0434\u0440\u0430\u0437\u0443
      \u043D\u0430 \u0434\u0432\u0430\u043D\u0430\u0434\u0446\u044F\u0442\u044C \u043F\u0430\u0442\u0440\u043E\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241330
    m_Localized: "\"\u041F\u0440\u0430\u0432\u043E\u0441\u0443\u0434\u0434\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241331
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u043E\u0457
      \u044F\u043A\u043E\u0441\u0442\u0456, \u044F\u0432\u043D\u043E \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u043D\u0430 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F.
      \u041D\u0430 \u043A\u043E\u0440\u043F\u0443\u0441\u0456 \u0432\u0438\u0433\u0440\u0430\u0432\u0456\u0440\u0443\u0432\u0430\u043D\u043E
      \u043D\u0430\u043F\u0438\u0441 \"\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0443
      \u043F\u043E\u043B\u0456\u0446\u0456\u0457 \u041A\u043E\u043D\u0442\u0440\u0441\u0442\u0440\u0430\u0439\u043A\u0443
      \u0432 \u043F\u043E\u0434\u044F\u043A\u0443 \u0437\u0430 \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043E\u043A
      \u0437\u0430\u0440\u0443\u0447\u043D\u0438\u043A\u0456\u0432\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241332
    m_Localized: "\u041F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u043D\u0430
      \u0433\u0430\u0440\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241333
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u0441\u0445\u043E\u0436\u0430
      \u043D\u0430 \u043B\u0430\u0437\u0435\u0440\u043D\u0443 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0443,
      \u0430\u043B\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0456\u043D\u0448\u0443 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044E
      \u0444\u043E\u043A\u0443\u0441\u0443\u0432\u0430\u043D\u043D\u044F. \u0417\u0430\u043C\u0456\u0441\u0442\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043F\u0440\u044F\u043C\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0443 \u0432\u043E\u043D\u0430 \u0432\u0438\u0434\u0430\u0454
      \u0446\u0456\u043B\u0438\u0439 \u043F\u0443\u0447\u043E\u043A \u0440\u0456\u0437\u043D\u043E\u043A\u043E\u043B\u044C\u043E\u0440\u043E\u0432\u0438\u0445
      \u043F\u0440\u043E\u043C\u0435\u043D\u0456\u0432, \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u044C
      \u0446\u044E \u0437\u0431\u0440\u043E\u044E \u0431\u0456\u043B\u044C\u0448
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u044E \u043F\u043E\u0431\u043B\u0438\u0437\u0443,
      \u043D\u0456\u0436 \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0456\u0439
      \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241334
    m_Localized: "\"\u0420\u0430\u0439\u0434\u0443\u0436\u043D\u0438\u0439 \u0443\u0434\u0430\u0440\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241335
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0430
      \u043F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u043D\u0430 \u0433\u0430\u0440\u043C\u0430\u0442\u0430.
      \u041C\u0430\u0454 \u0431\u0456\u043B\u044C\u0448\u0443, \u043D\u0456\u0436
      \u0443 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0457 \u043C\u043E\u0434\u0435\u043B\u0456,
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C. \u0407\u0457
      \u0440\u0430\u0439\u0434\u0443\u0436\u043D\u0456 \u043F\u0440\u043E\u043C\u0435\u043D\u0456
      \u043C\u043E\u0436\u0443\u0442\u044C \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u0440\u043E\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438 \u0446\u0456\u043B\u044C
      \u043D\u0430\u0441\u043A\u0440\u0456\u0437\u044C, \u0430 \u0439 \u0432\u0456\u0434\u0448\u0442\u043E\u0432\u0445\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241336
    m_Localized: "\u041A\u0440\u0456\u043E-\u0433\u0430\u0440\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241337
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0443 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0440\u043E\u0434\u0456 \u0437\u0431\u0440\u043E\u044F, \u0456\u043D\u0448\u043E\u0457
      \u0442\u0430\u043A\u043E\u0457 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435
      \u0456\u0441\u043D\u0443\u0454. \u0412\u043E\u043D\u0430 \u043D\u0435 \u043F\u043B\u0430\u0432\u0438\u0442\u044C
      \u0430\u0431\u043E \u0441\u043F\u043E\u043F\u0435\u043B\u044F\u0454, \u0430
      \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0443\u0454 \u0446\u0456\u043B\u044C.
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456
      \u0434\u043E \u0442\u0430\u043A\u043E\u0433\u043E \u0432\u043F\u043B\u0438\u0432\u0443
      \u0436\u0438\u0432\u0456 \u0456\u0441\u0442\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241338
    m_Localized: "\u041C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241339
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A, \u0449\u043E \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u044E\u0454
      \u043E\u0434\u0440\u0430\u0437\u0443 \u0442\u0440\u0438 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u0445
      \u0437\u0433\u0443\u0441\u0442\u043A\u0438 \u0437\u0430 \u043F\u043E\u0441\u0442\u0440\u0456\u043B.
      \u0414\u043E\u0431\u0440\u0435 \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C
      \u0434\u043B\u044F \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u0433\u043E \u0431\u043E\u044E,
      \u0430\u043B\u0435 \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0456\u0439
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u0457 \u043D\u0435\u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241340
    m_Localized: "\"\u0426\u0435\u0440\u0431\u0435\u0440\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241341
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u0439
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A, \u043D\u0430\u0434 \u044F\u043A\u0438\u043C
      \u043F\u043E\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0430 \u044F\u043A\u0430\u0441\u044C
      \u0442\u0435\u043C\u043D\u0430 \u043C\u0430\u0433\u0456\u044F. \u041F\u043E-\u043F\u0435\u0440\u0448\u0435,
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0456 \u0441\u043D\u0430\u0440\u044F\u0434\u0438,
      \u044F\u043A\u0456 \u0432\u0456\u043D \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454,
      \u043D\u0430\u0431\u0443\u043B\u0438 \u043C\u0430\u043B\u0438\u043D\u043E\u0432\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443, \u0430 \u043F\u043E-\u0434\u0440\u0443\u0433\u0435,
      \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0431\u0456\u043B\u044C\u0448 \u0440\u0443\u0439\u043D\u0456\u0432\u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241342
    m_Localized: "\u0421\u0442\u0430\u0440\u0430 \u0440\u0443\u0448\u043D\u0438\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241343
    m_Localized: "\u0421\u0442\u0430\u0440\u0430 \u0440\u0443\u0448\u043D\u0438\u0446\u044F,
      \u0437\u043B\u0435\u0433\u043A\u0430 \u0456\u0440\u0436\u0430\u0432\u0430,
      \u0430\u043B\u0435, \u044F\u043A \u043D\u0435 \u0434\u0438\u0432\u043D\u043E,
      \u0432\u0441\u0435 \u0449\u0435 \u0441\u0442\u0440\u0456\u043B\u044F\u0454.
      \u0425\u043E\u0447\u0430 \u0432\u043E\u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0440\u0456\u043B\u0430
      \u0449\u0435 \u0437\u0430\u0434\u043E\u0432\u0433\u043E \u0434\u043E \u0412\u0456\u0439\u043D\u0438,
      \u0437 \u043D\u0435\u0457 \u0456 \u0437\u0430\u0440\u0430\u0437 \u0446\u0456\u043B\u043A\u043E\u043C
      \u043C\u043E\u0436\u043D\u0430 \u043A\u043E\u0433\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u0456\u0434\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241344
    m_Localized: "\"\u0414\u0456\u0434\u0443\u0441\u0435\u0432\u0430 \u0440\u0443\u0448\u043D\u0438\u0446\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241345
    m_Localized: "\u0426\u044F \u0440\u0443\u0448\u043D\u0438\u0446\u044F \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0442\u0430\u0440\u0430, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0446\u0435 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u043E.
      \u041E\u0434\u043D\u0430\u043A \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0430
      \u0432\u043E\u043D\u0430 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u043E, \u0449\u043E \u0456 \u0437\u0430\u0440\u0430\u0437
      \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0443\u0454 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0441\u0432\u043E\u0457\u0445 \u0430\u043D\u0430\u043B\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241346
    m_Localized: "\u041C\u0438\u0441\u043B\u0438\u0432\u0441\u044C\u043A\u0430 \u0440\u0443\u0448\u043D\u0438\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241347
    m_Localized: "\u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u043F\u0438\u0442\u0430\u0439\u0442\u0435,
      \u043D\u0430\u0432\u0456\u0449\u043E \u043F\u043E\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
      \u043C\u0438\u0441\u043B\u0438\u0432\u0441\u044C\u043A\u0430 \u0440\u0443\u0448\u043D\u0438\u0446\u044F.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0446\u0435 \u0433\u0430\u0440\u043D\u0430
      \u0456 \u0442\u043E\u0447\u043D\u0430 \u0437\u0431\u0440\u043E\u044F, \u0449\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454 \u043F\u043E\u0448\u0438\u0440\u0435\u043D\u0456
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241348
    m_Localized: "\u0413\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430 \u043A\u043E\u0432\u043F\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241349
    m_Localized: "\u0413\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430 \u0437 \u0432\u0430\u0436\u0456\u043B\u044C\u043D\u0438\u043C
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F\u043C,
      \u0442\u0440\u043E\u0445\u0438 \u0441\u0442\u0430\u0440\u043E\u043C\u043E\u0434\u043D\u0430,
      \u0437\u0430\u0442\u0435 \u043D\u0430\u0434\u0456\u0439\u043D\u0430 \u0456
      \u0442\u043E\u0447\u043D\u0430. \u0414\u043E \u0412\u0456\u0439\u043D\u0438
      \u0431\u0443\u043B\u0430 \u0432\u0435\u043B\u044C\u043C\u0438 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0430
      \u0441\u0435\u0440\u0435\u0434 \u0446\u0438\u0432\u0456\u043B\u044C\u043D\u043E\u0433\u043E
      \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457,
      \u043F\u043E\u0437\u0438\u0446\u0456\u043E\u043D\u0443\u0432\u0430\u043B\u0430\u0441\u044F
      \u044F\u043A \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u043E\u0431\u043E\u0440\u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241350
    m_Localized: "\"\u0426\u0456\u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0438\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241351
    m_Localized: "\"\u0410 \u0447\u0438\u043C \u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0440\u0430\u0434\u0438
      \u0441\u0432\u043E\u0431\u043E\u0434\u0438?\" - \u0437\u0430\u043F\u0438\u0442\u0443\u0454
      \u043A\u043E\u0432\u043F\u043E\u043D\u0456 \u0437\u0456 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0430\u0433\u0456\u0442\u0430\u0446\u0456\u0439\u043D\u043E\u0433\u043E \u043F\u043B\u0430\u043A\u0430\u0442\u0430.
      \u0423 \u043A\u043E\u043F\u0438\u0442\u0430\u0445 \u0443 \u043D\u044C\u043E\u0433\u043E
      \u0441\u0430\u043C\u0435 \u0446\u044F \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241352
    m_Localized: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u044C\u043A\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241353
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430
      \u043D\u0430 \u0434\u0430\u043B\u0435\u043A\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044F\u0445.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456
      \u043F\u0430\u0442\u0440\u043E\u043D\u0438 \u043A\u0430\u043B. 308."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241354
    m_Localized: "\"\u041F\u043E\u043A\u0430\u044F\u043D\u043D\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241355
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u044C\u043A\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430. \u0412\u043E\u043D\u0430
      \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0447\u043E\u0440\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443, \u0430 \u043D\u0430 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0456
      \u0432\u0438\u0434\u043D\u043E \u0441\u043E\u0442\u043D\u0456 \u0434\u0440\u0456\u0431\u043D\u0438\u0445
      \u0437\u0430\u0440\u0443\u0431\u043E\u043A. \u0407\u0457 \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0439
      \u0432\u043B\u0430\u0441\u043D\u0438\u043A \u0440\u0430\u0445\u0443\u0432\u0430\u0432
      \u043A\u043E\u0436\u043D\u0443 \u0441\u0432\u043E\u044E \u0436\u0435\u0440\u0442\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241356
    m_Localized: "\u0412\u0435\u0434\u043C\u0435\u0436\u0430 \u0440\u0443\u0448\u043D\u0438\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241357
    m_Localized: "\u041E\u0434\u0438\u043D \u0456\u0437 \u043D\u0430\u0439\u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0445
      \u0432\u0438\u0434\u0456\u0432 \u0446\u0438\u0432\u0456\u043B\u044C\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u041F\u043E\u0441\u0442\u0440\u0456\u043B
      \u0456\u0437 \u0446\u0456\u0454\u0457 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438
      \u0446\u0456\u043B\u043A\u043E\u043C \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0437\u0430\u0432\u0430\u043B\u0438\u0442\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0432\u0435\u0434\u043C\u0435\u0434\u044F, \u043F\u0440\u0438\u0447\u043E\u043C\u0443
      \u043D\u0430 \u0434\u043E\u0441\u0438\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0456\u0439
      \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241358
    m_Localized: "\"\u0421\u043B\u043E\u043D\u043E\u0431\u0456\u0439\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241359
    m_Localized: "\u0417\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044E \"\u0427\u0438
      \u043C\u043E\u0436\u043D\u0430 \u0437 \u0446\u0456\u0454\u0457 \u0440\u0443\u0448\u043D\u0438\u0446\u0456
      \u0437\u0430\u0432\u0430\u043B\u0438\u0442\u0438 \u0441\u043B\u043E\u043D\u0430?\"
      \u0441\u0443\u0434\u0438\u043B\u043E\u0441\u044F \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0431\u0435\u0437 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456 \u0437
      \u043E\u0433\u043B\u044F\u0434\u0443 \u043D\u0430 \u043F\u043E\u0432\u043D\u0443
      \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C \u0441\u043B\u043E\u043D\u0456\u0432
      \u043D\u0430 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0456\u0439
      \u041F\u0443\u0441\u0442\u0446\u0456. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E
      \u0441\u0443\u0434\u0438\u0442\u0438 \u0437 \u0457\u0457 \u0432\u0438\u0433\u043B\u044F\u0434\u0443
      - \u043D\u0430\u043F\u0435\u0432\u043D\u043E \u0442\u0430\u043A\u0438 \u043C\u043E\u0436\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241360
    m_Localized: "\u0410\u043D\u0442\u0438\u043C\u0435\u0445-\u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241361
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0430
      \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430,
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430 \u043F\u0440\u043E\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0456\u0432 \u0456 \u0441\u0438\u043B\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456. \u0417\u0430 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u0432\u0435\u0437\u0456\u043D\u043D\u044F \u0437 \u043D\u0435\u0457 \u043C\u043E\u0436\u043D\u0430
      \u043F\u0456\u0434\u0431\u0438\u0442\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0442\u0430\u043D\u043A. \u041F\u043E\u0433\u0430\u043D\u043E \u0442\u0435,
      \u0449\u043E \u0434\u043E \u043D\u0435\u0457 \u043D\u0435 \u0442\u0430\u043A-\u0442\u043E
      \u043B\u0435\u0433\u043A\u043E \u0437\u043D\u0430\u0439\u0442\u0438 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241362
    m_Localized: "\"\u0413\u0440\u0456\u043C \u0421\u043F\u0456\u0442\u0444\u0430\u0439\u0440\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241363
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0430\u043D\u0442\u0438\u043C\u0435\u0445-\u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430.
      \u0417\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0430 \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u0449\u043E\u0431 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438
      \u0437\u043E\u0432\u0441\u0456\u043C \u0431\u0435\u0437 \u0432\u0456\u0434\u0434\u0430\u0447\u0456,
      \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430 \u0442\u0435
      \u0449\u043E \u0441\u0438\u043B\u0430 \u0457\u0457 \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443
      \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0430\u0445\u043B\u0438\u0432\u0430.
      \u041F\u0440\u0438\u043A\u0440\u0430\u0448\u0435\u043D\u0430 \u0437\u043E\u043B\u043E\u0442\u043E\u043C
      \u0456 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0438\u043C
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F\u043C, \u0430 \u043F\u0440\u0438
      \u043A\u043E\u0436\u043D\u043E\u043C\u0443 \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456
      \u043B\u0443\u043D\u0430\u0454 \u0433\u0443\u0440\u043A\u0456\u0442 \u0433\u0440\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241364
    m_Localized: "\u0413\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430 \u0437 \u043F\u0456\u0434\u0437\u0430\u0440\u044F\u0434\u043A\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241365
    m_Localized: "\u0426\u044F \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430
      \u044F\u0432\u043B\u044F\u0454 \u0441\u043E\u0431\u043E\u044E \u0441\u043F\u0440\u043E\u0431\u0443
      \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043F\u043E\u0432\u043D\u043E\u0446\u0456\u043D\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E, \u044F\u043A\u0430 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432. \u042F\u043A
      \u0432\u0438\u0434\u043D\u043E, \u043D\u0435\u0432\u0434\u0430\u043B\u0443.
      \"\u0412\u0456\u0447\u043D\u0430\" \u0431\u0430\u0442\u0430\u0440\u0435\u044F
      \u043D\u0435 \u0434\u0430\u0454 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E\u0457
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456, \u0430 \u0441\u0430\u043C\u0430
      \u0437\u0431\u0440\u043E\u044F \u0448\u0432\u0438\u0434\u043A\u043E \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C
      \u0437 \u043B\u0430\u0434\u0443 \u0456 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u0433\u043E \u0440\u0435\u043C\u043E\u043D\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241366
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241367
    m_Localized: "\u041F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430 \u0456 \u0442\u043E\u0447\u043D\u0456\u0448\u0430
      \u0437\u0431\u0440\u043E\u044F, \u043D\u0456\u0436 \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u0430\u043B\u0435 \u0439
      \u0448\u0432\u0438\u0434\u0448\u0435 \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0443\u0454
      \u0431\u0430\u0442\u0430\u0440\u0435\u044E. \u041D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u043A\u0443\u043B\u044C, \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C \u0434\u043E\u0441\u044F\u0433\u0430\u0454
      \u0446\u0456\u043B\u0456 \u043C\u0438\u0442\u0442\u0454\u0432\u043E, \u0442\u043E\u0436
      \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438 \u0437
      \u0446\u0456\u0454\u0457 \u0437\u0431\u0440\u043E\u0457 \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438 \u043D\u0456
      \u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C, \u043D\u0456 \u0456\u043D\u0448\u0456
      \u0447\u0438\u043D\u043D\u0438\u043A\u0438. \u041F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E
      \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241368
    m_Localized: "\"\u0427\u0435\u0440\u0432\u043E\u043D\u0430 \u0437\u043E\u0440\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241369
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430
      \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043E\u0433\u043E \u0432\u0438\u043F\u0443\u0441\u043A\u0443,
      \u0432 \u044F\u043A\u0456\u0439 \u044F\u043A \u0444\u043E\u043A\u0443\u0441\u0443\u044E\u0447\u0438\u0439
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B \u0431\u0443\u043B\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u0432\u0438\u0434 \u0447\u0430\u0440\u0456\u0432\u043D\u043E\u0433\u043E \u0440\u0443\u0431\u0456\u043D\u0430.
      \u041F\u0456\u0434 \u0447\u0430\u0441 \u0412\u0456\u0439\u043D\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0432\u0441\u044F
      \u0435\u043B\u0456\u0442\u043D\u0438\u043C\u0438 \u043F\u0435\u0433\u0430\u0441\u0430\u043C\u0438-\u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A\u0430\u043C\u0438,
      \u043D\u0443 \u0430 \u0437\u0430\u0440\u0430\u0437 \u0457\u0457 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0434\u0456\u0441\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241370
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u043E\u0432\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241371
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E\u0457
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456, \u0441\u0442\u0440\u0456\u043B\u044F\u0454
      \u0437\u0433\u0443\u0441\u0442\u043A\u0430\u043C\u0438 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u043F\u043B\u0430\u0437\u043C\u0438 \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443. \u041F\u0456\u0434\u0441\u0442\u0440\u0435\u043B\u0435\u043D\u0456
      \u0437 \u0446\u0456\u0454\u0457 \u0433\u0430\u0440\u043C\u0430\u0442\u0438
      \u0432\u043E\u0440\u043E\u0433\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u043C\u0438\u0440\u0430\u044E\u0442\u044C, \u0430 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0440\u043E\u0437\u0442\u0456\u043A\u0430\u044E\u0442\u044C\u0441\u044F \u043A\u0430\u043B\u044E\u0436\u0435\u044E
      \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E \u0441\u043B\u0438\u0437\u0443.
      \u041B\u0435\u0433\u043A\u043E \u043C\u043E\u0436\u0435 \u043F\u0440\u043E\u043F\u043B\u0430\u0432\u0438\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u0456\u0446\u043D\u0443 \u0431\u0435\u0442\u043E\u043D\u043D\u0443
      \u0441\u0442\u0456\u043D\u0443, \u0430\u043B\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0443\u0434\u043D\u043E\u0449\u0456 \u0437\u0456 \u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u0454\u044E
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u043E\u0433\u043E \u0437\u0433\u0443\u0441\u0442\u043A\u0443
      \u043D\u0435 \u0432\u0438\u0440\u0456\u0437\u043D\u044F\u0454\u0442\u044C\u0441\u044F
      \u0432\u0435\u043B\u0438\u043A\u043E\u044E \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044E
      \u0456 \u0432\u0438\u043C\u0430\u0433\u0430\u0454 \u0445\u043E\u0440\u043E\u0448\u0438\u0445
      \u043D\u0430\u0432\u0438\u0447\u043E\u043A \u0434\u043B\u044F \u0443\u0441\u043F\u0456\u0448\u043D\u043E\u0433\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241372
    m_Localized: "\"\u0422\u0443\u0440\u0431\u043E\u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241373
    m_Localized: "\u041F\u0440\u0438\u043A\u043B\u0430\u0434 \u0442\u043E\u0433\u043E,
      \u044F\u043A \u0441\u0438\u043B\u044C\u043D\u043E \u043C\u043E\u0436\u043D\u0430
      \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0431\u043E\u0439\u043E\u0432\u0456
      \u044F\u043A\u043E\u0441\u0442\u0456 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u044F\u043A\u0449\u043E \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
      \u0442\u0430\u043B\u0430\u043D\u0442 \u0456 \u0432\u0438\u043D\u0430\u0445\u0456\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C.
      \u0426\u044F \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0430
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0431\u0456\u043B\u044C\u0448
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0430,
      \u0430 \u0439 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u043C\u0435\u043D\u0448\u0435
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241374
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241375
    m_Localized: "\u0417\u043D\u0430\u0447\u043D\u043E \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0430
      \u0432\u0435\u0440\u0441\u0456\u044F \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u043E\u0433\u043E
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0430. \u0414\u043B\u044F
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0433\u043E
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u043E\u0433\u043E
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0443 \u0432\u043E\u043D\u0430 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430
      \u0446\u0456\u043B\u043E\u044E \u043A\u0443\u043F\u043E\u044E \u043A\u043E\u0442\u0443\u0448\u043E\u043A,
      \u043A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440\u0456\u0432
      \u0456 \u043B\u0430\u043C\u043F. \u041D\u0430 \u0436\u0430\u043B\u044C, \u0443\u0441\u0435
      \u0446\u0435 \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0441\u0442\u0432\u043E
      \u0434\u0443\u0436\u0435 \u043D\u0435\u043D\u0430\u0434\u0456\u0439\u043D\u0435
      \u0456 \u0448\u0432\u0438\u0434\u043A\u043E \u043B\u0430\u043C\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241376
    m_Localized: "\"\u041E\u0441\u043A\u043E\u043B\u043E\u043A \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241377
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430
      \u0434\u0443\u0436\u0435 \u0434\u0438\u0432\u043D\u043E\u0433\u043E \u0432\u0438\u0433\u043B\u044F\u0434\u0443.
      \u0412\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0456 \u0432 \u043D\u0435\u0457
      \u0441\u0438\u043D\u0456 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0438 \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u044C
      \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0430\u0443\u0440\u0443, \u043C\u0430\u0431\u0443\u0442\u044C,
      \u0446\u0435 \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u0447\u0438\u043D\u043E\u043C
      \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u043E \u0437 \u0457\u0457 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E\u044E
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241378
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241379
    m_Localized: "\u0412\u0456\u0434 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457
      \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0457 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438
      \u0446\u044F \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u0454\u0442\u044C\u0441\u044F
      \u0431\u0456\u043B\u044C\u0448\u043E\u044E \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044E
      \u0456 \u0434\u0430\u043B\u0435\u043A\u043E\u0431\u0456\u0439\u043D\u0456\u0441\u0442\u044E,
      \u0430\u043B\u0435 \u0442\u0430\u043A\u043E\u0436 \u0432\u043E\u043D\u0430
      \u0456 \u0448\u0432\u0438\u0434\u0448\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454
      \u0437\u0430\u0440\u044F\u0434 \u0431\u0430\u0442\u0430\u0440\u0435\u0439.
      \u0410 \u0449\u0435 \u0441\u0442\u0440\u0456\u043B\u044F\u0454 \u043F\u0440\u043E\u043C\u0435\u043D\u044F\u043C\u0438
      \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E, \u0430 \u043D\u0435 \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u044C\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241380
    m_Localized: "\"\u0410\u0442\u043C\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241381
    m_Localized: "\u0414\u0430\u043B\u0435\u043A\u043E\u0431\u0456\u0439\u043D\u0430
      \u043B\u0430\u0437\u0435\u0440\u043D\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430,
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0430 \u043D\u0430 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F,
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432 \u0454\u0434\u0438\u043D\u043E\u043C\u0443
      \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0456. \u0411\u0456\u043B\u044C\u0448
      \u044F\u043A\u0456\u0441\u043D\u0456 \u043A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440\u0438
      \u0456 \u0442\u043E\u0447\u043D\u0435 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0444\u043E\u043A\u0443\u0441\u0443\u044E\u0447\u0438\u0445 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0456\u0432
      \u0434\u0430\u044E\u0442\u044C \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0446\u0456\u0439 \u0437\u0431\u0440\u043E\u0457 \u0432\u0438\u0434\u0430\u0432\u0430\u0442\u0438
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439 \u0456\u043C\u043F\u0443\u043B\u044C\u0441,
      \u044F\u043A\u0438\u0439 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u0442\u0438
      \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241382
    m_Localized: "\u0422\u0435\u0440\u043C\u043E\u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241383
    m_Localized: "\u0417\u0431\u0440\u043E\u044F, \u0449\u043E \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454
      \u0456\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u0438\u0439 \u043F\u043E\u0442\u0456\u043A
      \u0456\u043D\u0444\u0440\u0430\u0447\u0435\u0440\u0432\u043E\u043D\u043E\u0433\u043E
      \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F,
      \u044F\u043A\u0438\u0439 \u043C\u0438\u0442\u0442\u0454\u0432\u043E \u0437\u0430\u043F\u0430\u043B\u044E\u0454
      \u0446\u0456\u043B\u044C. \u0420\u043E\u0437\u0440\u043E\u0431\u043B\u044F\u0432\u0441\u044F
      \u044F\u043A \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430
      \u0434\u043B\u044F \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442\u0456\u0432,
      \u0430\u043B\u0435, \u043D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u043D\u0438\u0445, \u043D\u0435 \u0432\u043E\u043B\u043E\u0434\u0456\u0454
      \u0442\u0430\u043A\u043E\u044E \u0441\u0430\u043C\u043E\u044E \u0434\u0435\u043C\u043E\u0440\u0430\u043B\u0456\u0437\u0443\u044E\u0447\u043E\u044E
      \u0441\u0438\u043B\u043E\u044E, \u0430 \u0442\u043E\u043C\u0443 \u043D\u0435
      \u0441\u0442\u0430\u0432 \u043D\u0430\u0434\u0442\u043E \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241384
    m_Localized: "\"\u041F\u043E\u043F\u0456\u043B \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241385
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0442\u0435\u0440\u043C\u043E\u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u0447,
      \u0431\u043E\u0439\u043E\u0432\u0456 \u044F\u043A\u043E\u0441\u0442\u0456 \u044F\u043A\u043E\u0433\u043E
      \u043D\u0430 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0432\u0438\u0449\u0456,
      \u043D\u0456\u0436 \u0443 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E.
      \u0417\u0434\u0430\u0442\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u043D\u0430 \u043F\u043E\u043F\u0456\u043B \u0443\u0441\u0435 \u043D\u0430
      \u0441\u0432\u0456\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241386
    m_Localized: "\u0413\u0440\u043E\u0437\u043E\u0432\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241387
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430 \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u043D\u044F
      \u0432\u043E\u0433\u043D\u044E \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0438\u0445
      \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044F\u0445. \u0412\u0440\u0430\u0436\u0430\u0454
      \u0446\u0456\u043B\u044C \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C \u0440\u043E\u0437\u0440\u044F\u0434\u043E\u043C
      \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u0438, \u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u043A\u043E\u043C
      \u044F\u043A\u043E\u0433\u043E \u0441\u043B\u0443\u0433\u0443\u0454 \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C. \u0414\u043B\u044F \u043A\u0440\u0430\u0449\u043E\u0433\u043E
      \u0435\u0444\u0435\u043A\u0442\u0443 \u0446\u0456\u043B\u044C \u043C\u0430\u0454
      \u0441\u0442\u043E\u044F\u0442\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241388
    m_Localized: "\"\u0413\u0440\u043E\u043C\u043E\u0432\u0435\u0440\u0436\u0435\u0446\u044C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241389
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0433\u0440\u043E\u0437\u043E\u0432\u0430
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430, \u0441\u0442\u0443\u043F\u0456\u043D\u044C
      \u043A\u0440\u0443\u0442\u0438\u0437\u043D\u0438 \u044F\u043A\u043E\u0457 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0437\u0430\u043C\u0435\u0436\u043D\u0430. \u041C\u0430\u043B\u043E
      \u0442\u043E\u0433\u043E, \u0449\u043E \u0432\u043E\u043D\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443, \u0442\u0430\u043A
      \u0449\u0435 \u0439 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0430
      \u043D\u0430 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u043D\u043D\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241390
    m_Localized: "\u0420\u0435\u0439\u043A\u043E\u0442\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241391
    m_Localized: "\u0426\u0435 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0435
      \u043F\u043E\u043B\u0435 \u0434\u043B\u044F \u0440\u043E\u0437\u0433\u043E\u043D\u0443
      \u043F\u043E\u043C\u0456\u0449\u0435\u043D\u043E\u0433\u043E \u0432 \u043D\u044C\u043E\u0433\u043E
      \u0441\u043D\u0430\u0440\u044F\u0434\u0430. \u0421\u043D\u0430\u0440\u044F\u0434
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0434\u043E\u0441\u044F\u0433\u0430\u0454
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u043E\u0457 \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456,
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u043E\u0457,
      \u043D\u0456\u0436 \u0439\u043E\u043C\u0443 \u043C\u0456\u0433 \u0431\u0438
      \u043D\u0430\u0434\u0430\u0442\u0438 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u0438\u0439
      \u0437\u0430\u0440\u044F\u0434. \u0425\u043E\u0447\u0430 \u0432\u043E\u043D\u0430
      \u0456 \u0441\u0442\u0440\u0456\u043B\u044F\u0454 \u043A\u0443\u043B\u044F\u043C\u0438,
      \u0430\u043B\u0435 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0434\u043E
      \u043A\u043B\u0430\u0441\u0443 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0441\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0434\u043B\u044F
      \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241392
    m_Localized: "\"\u041F\u0430\u043B\u0430\u0434\u0438\u043D\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241393
    m_Localized: "\u041C\u043E\u0434\u0435\u0440\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u0438\u0439
      \u0440\u0435\u0439\u043A\u043E\u0442\u0440\u043E\u043D, \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0442\u0438\u043C, \u0449\u043E \u0449\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0432\u0456\u0434 \u0435\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u043E\u0457
      \u043D\u0430\u0443\u043A\u0438. \u0429\u0435 \u0431\u0456\u043B\u044C\u0448
      \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u0438\u0439, \u043D\u0456\u0436
      \u0440\u0430\u043D\u0456\u0448\u0435, \u043A\u0440\u0456\u043C \u0442\u043E\u0433\u043E,
      \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439 \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043E\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241394
    m_Localized: "\u0413\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241395
    m_Localized: "\u041E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0438\u0439
      40-\u043C\u043C \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442,
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u044F\u043A \u043F\u0440\u043E\u0442\u0438
      \u0441\u043A\u0443\u043F\u0447\u0435\u043D\u044C \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u0442\u0430\u043A \u0456 \u0434\u043B\u044F \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u043D\u043D\u044F
      \u0441\u0442\u0456\u043D. \u0421\u043D\u0430\u0440\u044F\u0434\u0438 \u0440\u0443\u0445\u0430\u044E\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043F\u0430\u0440\u0430\u0431\u043E\u043B\u0456\u0447\u043D\u043E\u044E
      \u0442\u0440\u0430\u0454\u043A\u0442\u043E\u0440\u0456\u0454\u044E, \u0449\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0438 \u043F\u0440\u0438\u0446\u0456\u043B\u044E\u0432\u0430\u043D\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241396
    m_Localized: "\u0411\u0430\u0433\u0430\u0442\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0438\u0439
      \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241397
    m_Localized: "\u0411\u0430\u0433\u0430\u0442\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0438\u0439
      40-\u043C\u043C \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442,
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0438\u0439,
      \u0431\u043E \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0432\u0435\u0441\u0442\u0438
      \u0449\u0456\u043B\u044C\u043D\u0456\u0448\u0438\u0439 \u0432\u043E\u0433\u043E\u043D\u044C.
      \u0426\u044E \u0437\u0431\u0440\u043E\u044E \u0434\u0443\u0436\u0435 \u043B\u044E\u0431\u043B\u044F\u0442\u044C
      \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438
      \u0437\u0430 \u0457\u0457 \u0432\u0431\u0438\u0432\u0447\u0443 \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241398
    m_Localized: "\"\u0410\u043F\u043E\u043A\u0430\u043B\u0456\u043F\u0441\u0438\u0441\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241399
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u0430\u0433\u0430\u0442\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0438\u0439
      \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442, \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0437\u0430 \u043B\u0456\u0447\u0435\u043D\u0456 \u0441\u0435\u043A\u0443\u043D\u0434\u0438
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043F\u043E\u043B\u0435
      \u0431\u043E\u044E \u043D\u0430 \u043F\u0430\u043B\u0430\u044E\u0447\u0435
      \u043F\u0435\u043A\u043B\u043E. \u041C\u0430\u0454 \u0431\u0456\u043B\u044C\u0448\u0443
      \u043E\u0431\u043E\u0439\u043C\u0443 \u0456 \u0432\u0438\u0449\u0443 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241400
    m_Localized: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0439
      \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241401
    m_Localized: "40-\u043C\u043C \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442
      \u0456\u0437 \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C
      \u043E\u0434\u0440\u0430\u0437\u0443 \u043D\u0430 \u0434\u0432\u0430\u043D\u0430\u0434\u0446\u044F\u0442\u044C
      \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432 \u0456 \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E\u044E
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044E.
      \u0417\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0443\u0454 \u043D\u0430\u0439\u0432\u0438\u0449\u0443
      \u0449\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C \u0432\u043E\u0433\u043D\u044E
      \u0441\u0435\u0440\u0435\u0434 \u0443\u0441\u0456\u0454\u0457 \u0437\u0431\u0440\u043E\u0457
      \u043F\u043E\u0434\u0456\u0431\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241402
    m_Localized: "\u0420\u0430\u043A\u0435\u0442\u043D\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241403
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430,
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0430 \u0434\u043B\u044F
      \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F \u0432\u0430\u0436\u043A\u043E\u0457
      \u0442\u0435\u0445\u043D\u0456\u043A\u0438, \u0441\u043F\u043E\u0440\u0443\u0434
      \u0430\u0431\u043E \u0436\u0438\u0432\u043E\u0457 \u0441\u0438\u043B\u0438
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0445 \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043A\u0430\u043B\u0456\u0431\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241404
    m_Localized: "\"\u0412\u0435\u043D\u0434\u0435\u0442\u0442\u0430\""
