      \u0434\u043E\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u0440\u0456\u0432 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0443
      \u043D\u0435 \u0441\u0442\u0430\u0432 \u043F\u043E\u043C\u0456\u0442\u043D\u0438\u0439
      \u043D\u0435\u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0438\u043C \u043E\u043A\u043E\u043C.
      \u0417'\u044F\u0441\u0443\u0432\u0430\u043B\u043E\u0441\u044F, \u0449\u043E
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0438\u0439
      \u0437\u0430 \u0442\u0435\u0445. \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u0412\u0443\u0434\u043F\u0456\u043A\u0435\u0440 \u0441\u0432\u043E\u0454\u0447\u0430\u0441\u043D\u043E
      \u0432\u0438\u044F\u0432\u0438\u0432 \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u043D\u0456\u0441\u0442\u044C,
      \u043F\u0440\u043E\u0442\u0435 \u043D\u0435 \u043D\u0430\u0434\u0430\u0432
      \u0457\u0439 \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0457 \u0443\u0432\u0430\u0433\u0438
      \u0456 \u043D\u0435 \u0441\u0442\u0430\u0432 \u0430\u043A\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438
