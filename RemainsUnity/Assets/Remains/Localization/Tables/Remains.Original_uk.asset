      \u041F\u0456\u0434\u0456\u0439\u0434\u0456\u0442\u044C \u0431\u043B\u0438\u0436\u0447\u0435
      \u0456 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435 @1 \u0434\u043B\u044F
