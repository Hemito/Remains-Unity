  - m_Id: 2733630012
    m_Localized: "\u0417\u0410\u0404\u0411\u0418\u0421\u042C!| \u0427\u0443\u0434\u043E\u0432\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630013
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430! \u0422\u0430\u043A,
      \u0449\u043E \u0432 \u043D\u0456\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630014
    m_Localized: "\u041E \u043D\u0456... \u0426\u0456 \u0432\u0438\u0440\u043E\u0434\u043A\u0438,
      \u0441\u0445\u043E\u0436\u0435, \u0441\u0445\u043E\u043F\u0438\u043B\u0438
      \"\u041E\u0431\u0440\u0430\u043D\u0443-24\"! \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0457 \u0456 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u044F\u043A\u043E\u043C\u043E\u0433\u0430 \u0448\u0432\u0438\u0434\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630015
    m_Localized: "\u0428\u0430\u0440\u043F \u0428\u0443\u0442\u0435\u0440 - \u0446\u0435
      \u0449\u0435 \u0445\u0442\u043E, \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0439
      \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A? \u0421\u0443\u0434\u044F\u0447\u0438
      \u0456\u0437 \u0437\u0430\u043F\u0438\u0441\u043A\u0438, \u0432\u0456\u043D
      \u0434\u0435\u0441\u044C \u0443 \u0421\u0442\u0456\u0439\u043B\u0456 88. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u043C\u0438 \u0437 \u043D\u0438\u043C \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435\u043C\u043E\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630016
    m_Localized: "\u0421\u0442\u0456\u0439! \u041D\u0435 \u0437\u043D\u0430\u044E,
      \u0445\u0442\u043E \u0442\u0438, \u0430\u043B\u0435 \u043D\u0435 \u0445\u043E\u0434\u0438
      \u0434\u0430\u043B\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630017
    m_Localized: "\u0427\u043E\u043C\u0443? \u0429\u043E \u0442\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630018
    m_Localized: "\u041D\u0435 \u0449\u043E, \u0430 \u0445\u0442\u043E. \u0411\u0443\u0447,
      \u0433\u043E\u043B\u043E\u0432\u0430 \u043E\u0445\u043E\u0440\u043E\u043D\u0438
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432.
      \u0412\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439, \u044F\u043A
      \u0431\u0456\u0437\u043E\u043D, \u0456 \u043B\u044E\u0442\u0438\u0439, \u044F\u043A
      \u043C\u0430\u043D\u0442\u0438\u043A\u043E\u0440\u0430. \u0412\u0456\u043D
      \u0443\u0431'\u0454 \u0442\u0435\u0431\u0435, \u044F\u043A\u0449\u043E \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630019
    m_Localized: "\u0426\u0435 \u043C\u0438 \u0449\u0435 \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F!
      \u041F\u0440\u043E \u043C\u0435\u043D\u0435 \u043D\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0441\u044F,
      \u0434\u0430\u0432\u0430\u0439 \u043A\u0440\u0430\u0449\u0435 \u044F \u0432\u0456\u0434\u043A\u0440\u0438\u044E
      \u0442\u0432\u043E\u044E \u043A\u043B\u0456\u0442\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630020
    m_Localized: "\u0414\u0432\u0435\u0440\u0456 \u0432 \u0421\u0442\u0456\u0439\u043B\u043E
      88... \u0429\u043E \u0442\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u0434\u043E\u0441\u0438\u0442\u044C \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630021
    m_Localized: "\u0412\u0438 \u043F\u043E\u0434\u043E\u043B\u0430\u043B\u0438 [\u043F\u0435\u0440\u0448\u0438\u0439
      \u0440\u0456\u0432\u0435\u043D\u044C \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430]. \u0423\u0432\u0456\u0439\u0434\u0456\u0442\u044C
      \u0443 \u0434\u0432\u0435\u0440\u0456 [exit], \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u043D\u0430 [\u0434\u0440\u0443\u0433\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C].
      \u041D\u0430 \u0433\u043B\u0438\u0431\u0448\u0438\u0445 \u0440\u0456\u0432\u043D\u044F\u0445
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u044C \u0456 \u043D\u0430\u0433\u043E\u0440\u043E\u0434,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0446\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u0432\u0430\u043C \u043D\u0430\u0431\u0440\u0430\u0442\u0438 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0439
      \u0434\u043E\u0441\u0432\u0456\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630022
    m_Localized: "\u0425\u043C\u043C... \u043F\u043E\u043A\u0438 \u0449\u043E \u043C\u0435\u043D\u0456
      \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u043E\u0441\u044F
      \u043C\u0456\u0441\u0446\u0435, \u0434\u0435 \u043C\u043E\u0433\u043B\u043E
      \u0431 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u0441\u044F \u0442\u0435,
      \u0449\u043E \u044F \u0448\u0443\u043A\u0430\u044E. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0439\u0442\u0438 \u043D\u0430 \u0433\u043B\u0438\u0431\u0448\u0456 \u0440\u0456\u0432\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630023
    m_Localized: "\u0426\u0435\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447...
      \u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u044F \u0437\u043D\u0430\u044E
      \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0442\u0438\u043F\u043E\u0432\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430, \u0432\u0456\u043D \u0432\u0435\u0434\u0435
      \u0434\u043E \u042F\u0434\u0440\u0430 \u0423\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F
      \u0456 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439 \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440
      \u0442\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630024
    m_Localized: "\u0406\u0434\u0456\u0442\u044C \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u043E\u043C
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447, \u0449\u043E\u0431 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0432 [\u042F\u0434\u0440\u043E \u0423\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F].
      \u0410\u0431\u043E \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044C \u0443
      \u0434\u0432\u0435\u0440\u0456 [Exit], \u0449\u043E\u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u043D\u043E\u0432\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F \u0421\u0442\u0456\u0439\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630025
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u043F\u0440\u043E \u0440\u043E\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630026
    m_Localized: "\u0414\u043E\u043F\u043E\u0432\u0456\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630027
    m_Localized: "\u0426\u0435... \u041D\u0430\u0441\u044F\u043B\u044C\u043D\u0438\u043A\u0430!
      \u041C\u0438 \u043D\u0456\u044F\u043A \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043C\u043E
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443, \u043F\u043E\u043A\u0438
      \u0446\u0435\u0439 \u0457\u0431\u0443\u0447\u0438\u0439 \u0440\u043E\u0431\u043E\u0442
      \u0442\u0430\u043C \u0441\u0438\u0434\u0438\u0442\u044C!| \u0426\u0435... \u041D\u0430\u0441\u044F\u043B\u044C\u043D\u0438\u043A\u0430!
      \u041C\u0438 \u043D\u0456\u044F\u043A \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043C\u043E
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443, \u043F\u043E\u043A\u0438
      \u0446\u0435\u0439 \u0434\u043E\u0432\u0431\u0430\u043D\u0438\u0439 \u0440\u043E\u0431\u043E\u0442
      \u0442\u0430\u043C \u0441\u0438\u0434\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630028
    m_Localized: "\u0426\u0435 \u0447\u0438\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430?
      \u041C\u043E\u044F? \u042F \u0432\u0456\u0434\u0434\u0430\u0432 \u043D\u0430\u043A\u0430\u0437,
      \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E \u043F\u0440\u043E\u0445\u0456\u0434
      \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0432\u0456\u043B\u044C\u043D\u0438\u0439.
      \u0412\u0430\u0441 \u0432\u0447\u0438\u043B\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u0437 \u0440\u043E\u0431\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630029
    m_Localized: "\u0422\u0430\u043A \u0446\u0435... \u041D\u0430\u0441\u044F\u043B\u044C\u043D\u0438\u043A\u0430!
      \u0426\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u0438\u0439 \u0440\u043E\u0431\u043E\u0442!
      \u041F'\u044F\u0442\u043E\u043A \u043D\u0430\u0448\u0438\u0445 \u0443\u043A\u043B\u0430\u0432
      \u043E\u0434\u043D\u0438\u043C \u0437\u0430\u043B\u043F\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630030
    m_Localized: "\u041C\u0435\u043D\u0435 \u041D\u0415 \u0407\u0411\u0415! \u0412\u0410\u0428\u0415
      \u0417\u0410\u0412\u0414\u0410\u041D\u041D\u042F - \u0412\u0418\u041A\u041E\u041D\u0423\u0412\u0410\u0422\u0418
      \u041C\u041E\u0407 \u041D\u0410\u041A\u0410\u0417\u0418, \u0406 \u042F\u041A\u0429\u041E
      \u042F \u041D\u0410\u041A\u0410\u0416\u0423 \u0412\u0411\u0418\u0422\u0418\u0421\u042F
      \u041D\u0410\u0425\u0423\u0419, \u0412\u0418 \u0412\u0411'\u0404\u0422\u0415\u0421\u042F
      \u041D\u0410\u0425\u0423\u0419! \u0412\u0418 \u041C\u0410\u041B\u0418 \u0417\u0410\u0427\u0418\u0421\u0422\u0418\u0422\u0418
      \u0426\u0415\u0419 \u0421\u0415\u041A\u0422\u041E\u0420 \u0422\u0420\u0418
      \u041A\u041B\u042F\u0422\u0406 \u0414\u041D\u0406 \u0422\u041E\u041C\u0423!
      \u0422\u0418 \u0420\u041E\u0417\u0423\u041C\u0406\u0404\u0428, \u0429\u041E
      \u0426\u0415 \u041E\u0417\u041D\u0410\u0427\u0410\u0404? \u0426\u0415 \u041E\u0417\u041D\u0410\u0427\u0410\u0404,
      \u0429\u041E \u042F\u041A\u0429\u041E \u0427\u0415\u0420\u0415\u0417 \u0413\u041E\u0414\u0418\u041D\u0423
      \u042F \u0421\u042E\u0414\u0418 \u0417\u0410\u0419\u0414\u0423 \u0406 \u041D\u0415
      \u041F\u041E\u0411\u0410\u0427\u0423 \u0426\u042C\u041E\u0413\u041E \u0420\u041E\u0411\u041E\u0422\u0410
      \u0420\u041E\u0417'\u0407\u0411\u0410\u041D\u0418\u041C \u0414\u041E \u0412\u0421\u0406\u0425
      \u0425\u0423\u0407\u0412, \u042F \u0412\u0406\u0414\u041A\u0420\u0418\u042E
      \u041F\u041E \u0412\u0410\u0421 \u0412\u041E\u0413\u041E\u041D\u042C \u041D\u0410
      \u0423\u0420\u0410\u0416\u0415\u041D\u041D\u042F! \u0422\u0418 \u041C\u0415\u041D\u0415
      \u0417\u0420\u041E\u0417\u0423\u041C\u0406\u0412, \u0421\u0410\u041B\u0410\u0413\u0410?!
      \u0422\u0418! \u041C\u0415\u041D\u0415! \u0417\u0420\u041E\u0417\u0423\u041C\u0406\u0412?!|
      \u041C\u0435\u043D\u0456 \u043D\u0430\u0447\u0445\u0430\u0442\u0438! \u0412\u0410\u0428\u0415
      \u0417\u0410\u0412\u0414\u0410\u041D\u041D\u042F - \u0412\u0418\u041A\u041E\u041D\u0423\u0412\u0410\u0422\u0418
      \u041C\u041E\u0407 \u041D\u0410\u041A\u0410\u0417\u0418, \u0406 \u042F\u041A\u0429\u041E
      \u042F \u041D\u0410\u041A\u0410\u0416\u0423 \u0417\u0414\u041E\u0425\u041D\u0423\u0422\u0418,
      \u0412\u0418 \u0417\u0414\u041E\u0425\u041D\u0415\u0422\u0415 \u0417 \u041F\u041E\u0421\u041C\u0406\u0428\u041A\u041E\u042E
      \u041D\u0410 \u041C\u041E\u0420\u0414\u0406! \u0412\u0418 \u041C\u0410\u041B\u0418
      \u0417\u0410\u0427\u0418\u0421\u0422\u0418\u0422\u0418 \u0426\u0415\u0419 \u0421\u0415\u041A\u0422\u041E\u0420
      \u0422\u0420\u0418 \u0414\u041D\u0406 \u0422\u041E\u041C\u0423! \u0422\u0418
      \u0420\u041E\u0417\u0423\u041C\u0406\u0404\u0428, \u0429\u041E \u0426\u0415
      \u041E\u0417\u041D\u0410\u0427\u0410\u0404? \u0426\u0415 \u041E\u0417\u041D\u0410\u0427\u0410\u0404,
      \u0429\u041E \u042F\u041A\u0429\u041E \u0417\u0410 \u0413\u041E\u0414\u0418\u041D\u0423
      \u042F \u0421\u042E\u0414\u0418 \u0417\u0410\u0419\u0414\u0423 \u0406 \u041D\u0415
      \u041F\u041E\u0411\u0410\u0427\u0423 \u0426\u042C\u041E\u0413\u041E \u0420\u041E\u0411\u041E\u0422\u0410
      \u0420\u041E\u0417\u041D\u0415\u0421\u0415\u041D\u0418\u041C \u0423 \u041C\u041E\u0422\u041B\u041E\u0425,
      \u042F \u0412\u0406\u0414\u041A\u0420\u0418\u042E \u041F\u041E \u0412\u0410\u0421
      \u0412\u041E\u0413\u041E\u041D\u042C \u041D\u0410 \u0423\u0420\u0410\u0416\u0415\u041D\u041D\u042F!
      \u0422\u0418 \u041C\u0415\u041D\u0415 \u0417\u0420\u041E\u0417\u0423\u041C\u0406\u0412,
      \u0421\u0410\u041B\u0410\u0413\u0410?! \u0422\u0418! \u041C\u0415\u041D\u0415!
      \u0417\u0420\u041E\u0417\u0423\u041C\u0406\u0412?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630031
    m_Localized: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u041D\u0430\u0441\u044F\u043B\u044C\u043D\u0438\u043A\u0430!
      \u0426\u0435... \u0412\u0441\u0435 \u0437\u0440\u043E\u0431\u0438\u043C\u043E
      \u0437\u0430\u0440\u0430\u0437 \u0436\u0435! \u041D\u0430\u043C \u0431\u0438,
      \u0442\u043E\u0433\u043E... \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0438\u0445
      \u0433\u0440\u0430\u043D\u0430\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630032
    m_Localized: "\u0411\u0435\u0440\u0438 \u0432\u0441\u0435, \u0449\u043E \u0442\u0440\u0435\u0431\u0430.
      \u0429\u043E\u0431 \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0434\u0438\u043D\u0443
      \u0446\u044C\u043E\u0433\u043E \u0440\u043E\u0431\u043E\u0442\u0430 \u0442\u0443\u0442
      \u043D\u0435 \u0431\u0443\u043B\u043E, \u0445\u043E\u0447 \u0445\u0435\u0440\u043E\u043C
      \u0439\u043E\u0433\u043E \u0440\u043E\u0437'\u0457\u0431\u0438, \u0442\u0438
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432?! \u042F\u043A \u0436\u0435
      \u0432\u0438, \u0442\u0443\u043F\u0456 \u0431\u0430\u0440\u0430\u043D\u0438,
      \u043C\u0435\u043D\u0435 \u0437\u0430\u0457\u0431\u0430\u043B\u0438...|\u0411\u0435\u0440\u0438
      \u0432\u0441\u0435, \u0449\u043E \u0442\u0440\u0435\u0431\u0430. \u0429\u043E\u0431
      \u0437\u0430 \u0433\u043E\u0434\u0438\u043D\u0443 \u0446\u044C\u043E\u0433\u043E
      \u0440\u043E\u0431\u043E\u0442\u0430 \u0442\u0443\u0442 \u043D\u0435 \u0431\u0443\u043B\u043E,
      \u0445\u043E\u0447 \u043B\u043E\u0431\u043E\u043C \u0439\u043E\u0433\u043E
      \u043F\u0440\u0438\u0431\u0438\u0439, \u0442\u0438 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432?!
      \u042F\u043A \u0436\u0435 \u0432\u0438, \u0442\u0443\u043F\u0456 \u0431\u0430\u0440\u0430\u043D\u0438,
      \u043C\u0435\u043D\u0435 \u0434\u0456\u0441\u0442\u0430\u043B\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630033
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2733630034
    m_Localized: "\u0412\u043E\u043D\u0438 \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0442\u0443\u0442? \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0446\u0435 \u044F\u043A\u0440\u0430\u0437 \u0442\u0435 \u043C\u0456\u0441\u0446\u0435,
      \u0449\u043E \u044F \u0448\u0443\u043A\u0430\u044E. \u0410 \u043E\u0441\u044C
      \u0446\u0435\u0439, \u043D\u0430\u043F\u0435\u0432\u043D\u043E, \u0456 \u0454
      \u0428\u0430\u0440\u043F \u0428\u0443\u0442\u0435\u0440. \u0417\u0430\u0440\u0430\u0437
      \u043C\u0438 \u0437 \u043D\u0438\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630035
    m_Localized: "\u0410\u043B\u0435... \u0449\u043E \u0449\u0435 \u0437\u0430 \u0440\u043E\u0431\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630036
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0438, \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456
      \u0443 \u043B\u0456\u0434\u0435\u0440\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630037
    m_Localized: "\u041E\u0442 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F,
      \u0432\u0456\u043D \u0437\u0434\u043E\u0445! \u042F\u043A \u0436\u0435 \u044F
      \u0442\u0435\u043F\u0435\u0440 \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F
      \u043F\u0440\u043E \u0434\u0440\u0443\u0433\u0443 \"\u041E\u0431\u0440\u0430\u043D\u0443\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630038
    m_Localized: "\u0421\u0442\u043E\u043F, \u0449\u043E \u0446\u0435? \u042F\u043A\u0456\u0441\u044C
      \u0437\u0430\u043F\u0438\u0441\u0438. \u0422\u0440\u0435\u0431\u0430 \u0431
      \u0432\u0438\u0432\u0447\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630039
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435 \u044F\u0432\u043D\u043E \u0432\u0441\u0435
      \u043D\u0435 \u0442\u0435. \u0427\u0438\u0442\u0430\u0454\u043C\u043E \u0434\u0430\u043B\u0456:
      - \u0414\u0435\u043D\u044C \u043F'\u044F\u0442\u044C. \u041D\u0435 \u0442\u0435.
      - \u041D\u0435 \u0442\u0435. - \u041D\u0435 \u0442\u0435... - \u0422\u0430\u043A,
      \u043E\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630040
    m_Localized: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0439 \u0432\u0438\u0440\u043E\u0434\u043E\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630041
    m_Localized: "\u0412\u043E\u043D\u0430 \u0432\u0442\u0435\u043A\u043B\u0430!
      \u0421\u043B\u0430\u0432\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457,
      \u0432\u043E\u043D\u0430 \u0432\u0442\u0435\u043A\u043B\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630042
    m_Localized: "\u0429\u043E\u0434\u0435\u043D\u043D\u0438\u043A \u0428\u0430\u0440\u043F
      \u0428\u0443\u0442\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630043
    m_Localized: "\u041E\u0442\u0436\u0435, \u043C\u0438\u043D\u0443\u043B\u043E
      \u043B\u0438\u0448\u0435 \u043A\u0456\u043B\u044C\u043A\u0430 \u0433\u043E\u0434\u0438\u043D
      \u043F\u0456\u0441\u043B\u044F \u043D\u0430\u0448\u043E\u0457 \u0440\u043E\u0437\u043C\u043E\u0432\u0438,
      \u0456 \u043D\u0430\u0448 \u0441\u043B\u0430\u0432\u043D\u0438\u0439 \u0414\u0430\u0440\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A
      \u0421\u043E\u043D\u0446\u044F, \u041D\u0430\u0434\u0456\u044F \u041F\u043E\u043D\u0456,
      \u0412\u0441\u0435\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A,
      \u0439\u043E\u0431 \u0439\u043E\u0433\u043E \u0432 \u0441\u0440\u0430\u043A\u0443,
      \u0427\u0435\u0440\u0432\u043E\u043D\u0435 \u041E\u043A\u043E \u0432\u0436\u0435
      \u043F\u043E\u0437\u0431\u0443\u0432\u0441\u044F \u043C\u0435\u043D\u0435.
      \u0412\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u0437\u0430\u0447\u0438\u0449\u0430\u0442\u0438
      \u0441\u0442\u0430\u0440\u0435 \u0421\u0442\u0456\u0439\u043B\u043E? \u0421\u0435\u0440\u0439\u043E\u0437\u043D\u043E,
      \u0431\u043B\u044F\u0434\u044C? \u041C\u043E\u0436\u0435, \u043C\u0435\u043D\u0456
      \u0449\u0435 \u0441\u0430\u043C\u043E\u043C\u0443 \u043B\u043E\u043F\u0430\u0442\u0443
      \u0432 \u043A\u043E\u043F\u0438\u0442\u0430 \u0432\u0437\u044F\u0442\u0438,
      \u043D\u0456, \u043D\u0430\u0439\u0434\u043E\u0440\u043E\u0436\u0447\u0438\u0439
      \u043D\u0430\u0448 \u0412\u0456\u0434\u0440\u043E\u0434\u0436\u0443\u0432\u0430\u0447?
      \u0423 \u0436\u0438\u0442\u0442\u0456 \u0442\u0430\u043A\u043E\u0457 \u043C\u0441\u0442\u0438\u0432\u043E\u0457
      \u0441\u0432\u043E\u043B\u043E\u0442\u0438 \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0432.
      \u0413\u0430\u0440\u0430\u0437\u0434, \u043D\u0430\u0441\u0440\u0430\u0442\u0438.
      \u041C\u043E\u0436\u0435, \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u0443
      \u0445\u043E\u0447, \u043F\u043E\u043A\u0438 \u043C\u043E\u0457 \u0445\u043B\u043E\u043F\u0446\u0456
      \u0440\u043E\u0437\u0432\u0430\u0436\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0441\u0442\u0440\u0456\u043B\u044F\u043D\u0438\u043D\u043E\u044E \u043F\u043E
      \u0431\u043B\u044F\u0448\u0430\u043D\u043A\u0430\u0445.|\u041E\u0442\u0436\u0435,
      \u043C\u0438\u043D\u0443\u043B\u043E \u043B\u0438\u0448\u0435 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0433\u043E\u0434\u0438\u043D \u043F\u0456\u0441\u043B\u044F \u043D\u0430\u0448\u043E\u0457
      \u0440\u043E\u0437\u043C\u043E\u0432\u0438, \u0456 \u043D\u0430\u0448 \u0441\u043B\u0430\u0432\u043D\u0438\u0439
      \u0414\u0430\u0440\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A \u0421\u043E\u043D\u0446\u044F,
      \u041D\u0430\u0434\u0456\u044F \u041F\u043E\u043D\u0456, \u0412\u0441\u0435\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A
      \u0427\u0435\u0440\u0432\u043E\u043D\u0435 \u041E\u043A\u043E \u0432\u0436\u0435
      \u043F\u043E\u0437\u0431\u0443\u0432\u0441\u044F \u043C\u0435\u043D\u0435.
      \u0412\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u0437\u0430\u0447\u0438\u0449\u0430\u0442\u0438
      \u0441\u0442\u0430\u0440\u0435 \u0421\u0442\u0456\u0439\u043B\u043E? \u0421\u0435\u0440\u0439\u043E\u0437\u043D\u043E?
      \u041C\u043E\u0436\u0435, \u043C\u0435\u043D\u0456 \u0449\u0435 \u0441\u0430\u043C\u043E\u043C\u0443
      \u043B\u043E\u043F\u0430\u0442\u0443 \u0432 \u043A\u043E\u043F\u0438\u0442\u0430
      \u0432\u0437\u044F\u0442\u0438, \u043D\u0456, \u043D\u0430\u0439\u0434\u043E\u0440\u043E\u0436\u0447\u0438\u0439
      \u043D\u0430\u0448 \u0412\u0456\u0434\u0440\u043E\u0434\u0436\u0443\u0432\u0430\u0447?
      \u0423 \u0436\u0438\u0442\u0442\u0456 \u0442\u0430\u043A\u043E\u0457 \u043C\u0441\u0442\u0438\u0432\u043E\u0457
      \u0441\u0432\u043E\u043B\u043E\u0442\u0438 \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0432.
      \u0413\u0430\u0440\u0430\u0437\u0434, \u043F\u043B\u044E\u0432\u0430\u0442\u0438.
      \u041C\u043E\u0436\u0435, \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u0443
      \u0445\u043E\u0447, \u043F\u043E\u043A\u0438 \u043C\u043E\u0457 \u0445\u043B\u043E\u043F\u0446\u0456
      \u0440\u043E\u0437\u0432\u0430\u0436\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0441\u0442\u0440\u0456\u043B\u044F\u043D\u0438\u043D\u043E\u044E \u043F\u043E
      \u0431\u043B\u044F\u0448\u0430\u043D\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630044
    m_Localized: "\u0414\u0435\u043D\u044C 1. \u041C\u0456\u0439 \u0437\u0430\u0433\u0456\u043D
      \u0437\u0456\u0431\u0440\u0430\u0432\u0441\u044F \u043D\u0430 \u0441\u0432\u0456\u0442\u0430\u043D\u043A\u0443
      \u0456 \u0432\u0438\u0439\u0448\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
      \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u0456 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041A\u043E\u043B\u0438 \u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0432
      \u043F\u0456\u0434 \u0430\u0440\u043A\u043E\u044E, \u043F\u043E\u0447\u0443\u0432
      \u0445\u0438\u0445\u0438\u043A\u0430\u043D\u043D\u044F \u0432\u0430\u0440\u0442\u043E\u0432\u0438\u0445
      \u043D\u0430 \u0432\u0438\u0448\u0446\u0456. \u0426\u0456 \u0432\u0438\u0440\u043E\u0434\u043A\u0438
      \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u0441\u0442\u0440\u0430\u0445 \u0456 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u043B\u0438
      \u0436\u0430\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043D\u0430 \u0442\u0435\u043C\u0443
      \u043C\u043E\u0433\u043E \u0440\u043E\u0437\u043B\u0430\u0434\u0443 \u0437
      \"\u0447\u0435\u0440\u0432\u043E\u043D\u043E\u043E\u043A\u0438\u043C\", \u043D\u0430\u0432\u0456\u0442\u044C
      \u043A\u043E\u043B\u0438 \u044F \u043F\u043E\u0434\u0438\u0432\u0438\u0432\u0441\u044F
      \u0432 \u0457\u0445\u043D\u0456\u0439 \u0431\u0456\u043A. \u041F\u0440\u0438\u0441\u0442\u0440\u0435\u043B\u0438\u0432
      \u043E\u0431\u043E\u0445, \u0431\u043E \u043D\u0435\u0445\u0440\u0456\u043D.
      \u042F\u043A\u0449\u043E \u0445\u0442\u043E \u0437\u0430\u043F\u0438\u0442\u0443\u0432\u0430\u0442\u0438\u043C\u0435,
      \u0441\u043A\u0430\u0436\u0443, \u0449\u043E \u0437\u0430 \u043D\u0435\u043F\u043E\u0432\u0430\u0433\u0443
      \u0434\u043E \u043B\u0456\u0434\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630045
    m_Localized: "\u0414\u0435\u043D\u044C 21. \u041F\u043E\u0432\u0441\u044F\u043A\u0434\u0435\u043D\u043D\u0430
      \u0440\u0443\u0442\u0438\u043D\u0430 \u043F\u0435\u0440\u0435\u0440\u0432\u0430\u043B\u0430\u0441\u044F
      \u0437 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C \u0445\u043B\u043E\u043F\u0446\u0456\u0432
      \u0411\u0443\u0447\u0430. \u0417\u0430\u0433\u0456\u043D \u0431\u0443\u0432
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439 \u043D\u0430
      \u0441\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F \u043A\u0430\u0440\u0442
      \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0445 \u0441\u0442\u043E\u043A\u0456\u0432
      \u0456 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0440\u043E\u0431\u043E\u0442\u0438
      \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u0432 \u043D\u0430 \u0441\u0430\u043C\u043E\u0442\u043D\u044E
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0436\u043A\u0443, \u044F\u043A\u0430
      \u0431\u0430\u0432\u0438\u043B\u0430\u0441\u044F \u0437 \u0442\u0440\u0443\u043F\u0430\u0447\u0438\u043D\u043E\u044E
      \u0432 \u0442\u0435\u043C\u043D\u043E\u043C\u0443 \u043A\u0443\u0442\u043E\u0447\u043A\u0443.
      \u0410\u043B\u0435 \u043D\u0435 \u0446\u0435 \u0433\u043E\u043B\u043E\u0432\u043D\u0435.
      \u0413\u043E\u043B\u043E\u0432\u043D\u0435 \u0442\u0435, \u0449\u043E \u0432
      \u043D\u0435\u0457 \u041F\u0456\u043F\u0411\u0430\u043A. \u041E\u0445\u043E\u0440\u043E\u043D\u0446\u0456,
      \u044F\u043A\u0456 \u0441\u043F\u0456\u0439\u043C\u0430\u043B\u0438 \u0457\u0457,
      \u0449\u0438\u0440\u043E \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C,
      \u0449\u043E \u0446\u0435 \u043F\u0438\u0441\u0430\u0440 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432. \u041D\u0435
      \u0431\u0443\u0434\u0443 \u0440\u043E\u0437\u0432\u0456\u044E\u0432\u0430\u0442\u0438
      \u0457\u0445\u0456\u0439 \u0441\u0430\u043C\u043E\u043E\u0431\u043C\u0430\u043D,
      \u043F\u0440\u043E\u0442\u0435 \u043C\u0456\u0439 \u0434\u043E\u0441\u0432\u0456\u0434
      \u0441\u0432\u0456\u0434\u0447\u0438\u0442\u044C \u0437\u043E\u0432\u0441\u0456\u043C
      \u043F\u0440\u043E \u0456\u043D\u0448\u0435. \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 \u043D\u0456\u043A\u043E\u043B\u0438
      \u0431 \u043D\u0435 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u0441\u0430\u043C\u043E\u0442\u043D\u044C\u043E\u0433\u043E \u043F\u0438\u0441\u0430\u0440\u044F
      \u0431\u0435\u0437 \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F.
      \u0423 \u0446\u044C\u043E\u043C\u0443 \u0441\u0432\u0456\u0442\u0456 \u0454
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0440\u0438 \u0442\u0438\u043F\u0438
      \u043F\u043E\u043D\u0456, \u044F\u043A\u0456 \u043C\u0430\u044E\u0442\u044C
      \u0434\u043E\u0441\u0442\u0443\u043F \u0434\u043E \u0442\u0430\u043A\u043E\u0457
      \u0440\u0456\u0434\u043A\u043E\u0441\u0442\u0456, \u044F\u043A \u041F\u0456\u043F\u0411\u0430\u043A:
      \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438,
      \u0435\u043B\u0456\u0442\u043D\u0456 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0456
      \u0427\u0435\u0440\u0432\u043E\u043D\u043E\u0433\u043E \u041E\u043A\u0430 \u0456
      \u0432\u0438\u0445\u0456\u0434\u0446\u0456 \u0437 \u0443\u0441\u0435 \u0449\u0435
      \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u0445 \u0421\u0442\u0456\u0439\u043B.
      \u041E\u0441\u0442\u0430\u043D\u043D\u0456 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456, \u0449\u043E \u0431\u0430\u0433\u0430\u0442\u043E
      \u0445\u0442\u043E \u0432\u0432\u0430\u0436\u0430\u0454, \u0449\u043E \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u044E\u0447\u0438\u0445
      \u0421\u0442\u0456\u0439\u043B \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0435
      \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F, \u0430\u043B\u0435
      \u043D\u0430\u0448\u0430 \u0437\u0434\u043E\u0431\u0438\u0447 \u044F\u0432\u043D\u043E
      \u043D\u0435 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0434\u043E
      \u043F\u0435\u0440\u0448\u0438\u0445 \u0434\u0432\u043E\u0445 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0439.
      \u041D\u0456\u0456\u0456\u0456, \u0432\u043E\u043D\u0430 \u0442\u043E\u0447\u043D\u043E
      \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430! \u042F\u043A\u0449\u043E
      \u0442\u0430\u043A, \u0442\u043E, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u044F \u043D\u0430\u0439\u0449\u0430\u0441\u043B\u0438\u0432\u0456\u0448\u0438\u0439
      \u043C\u0435\u0440\u0437\u043E\u0442\u043D\u0438\u043A \u0437\u0432\u0456\u0434\u0441\u0438
      \u0456 \u0430\u0436 \u0434\u043E \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430.
      \u0426\u044F \u0434\u0440\u0456\u0431\u043D\u0430 \u043A\u0443\u0440\u043A\u0430
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454 \u0442\u0430\u043A, \u043D\u0456\u0431\u0438
      \u0432\u043E\u043D\u0430 \u0449\u043E\u0439\u043D\u043E \u0437 \u043F\u0440\u043E\u0431\u0456\u0440\u043A\u0438,
      \u0456 \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u0454
      \u0432 \u043D\u0430\u0448\u043E\u043C\u0443 \u0441\u0432\u0456\u0442\u0456
      \u0434\u043E\u0432\u0433\u043E. \u0417\u043D\u0430\u0447\u0438\u0442\u044C,
      \u0457\u0457 \u043E\u0441\u0435\u043B\u044F \u0437\u043E\u0432\u0441\u0456\u043C
      \u043F\u043E\u0440\u0443\u0447. \u042F\u043A\u0449\u043E \u044F \u0437\u043D\u0430\u0439\u0434\u0443
      \u043D\u0435\u0434\u043E\u0442\u043E\u0440\u043A\u0430\u043D\u0435, \u043F\u043E\u0432\u043D\u0435
      \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u0421\u0442\u0456\u0439\u043B\u043E...
      \u0446\u0435 \u0436 \u0431\u0443\u0434\u0435 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0439
      \u0448\u043C\u0430\u0442\u043E\u043A \u0443 \u043C\u043E\u0454\u043C\u0443
      \u0436\u0438\u0442\u0442\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733630046
    m_Localized: "\u0414\u0435\u043D\u044C 22. \u0423\u0447\u043E\u0440\u0430 \u044F
      \u0434\u0430\u0432 \u0434\u043E\u0431\u0443 \u043D\u0430\u0448\u0456\u0439
      \u0433\u043E\u0441\u0442\u0456, \u0449\u043E\u0431 \u043F\u043E\u0440\u043E\u0437\u043A\u0438\u0434\u0430\u0442\u0438
      \u043C\u0456\u0437\u043A\u0430\u043C\u0438 \u0456 \u0441\u0430\u043C\u0456\u0439
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438, \u0434\u0435
      \u0457\u0457 \u0434\u0456\u043C. \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u0442\u0435\u0440\u043C\u0456\u043D \u0432\u0438\u0439\u0448\u043E\u0432,
      \u0456 \u0432\u043E\u043D\u0430 \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0430
      \u0440\u043E\u0437\u0441\u0443\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0456.
      \u0421\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454, \u043D\u0456\u0431\u0438\u0442\u043E
      \"\u043D\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u0454\" \u0446\u044C\u043E\u0433\u043E.
      \u0425\u0430! \u041D\u0430 \u0436\u0430\u043B\u044C, \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u0432\u043E\u043D\u0430 \u043D\u0456\u0447\u043E\u0433\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u043E\u0433\u043E
      \u043D\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u043B\u0430.
      \u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u043C\u043E \u0440\u043E\u0437\u043C\u043E\u0432\u0443
      \u0437\u0430\u0432\u0442\u0440\u0430. \u0410\u043B\u0435 \u0442\u0432\u043E\u044E
      \u0436 \u043C\u0430\u0442\u0456\u0440, \u044F\u043A \u0436\u0435 \u0441\u043E\u043B\u043E\u0434\u043A\u043E
      \u0432\u043E\u043D\u0430 \u043A\u0440\u0438\u0447\u0438\u0442\u044C \u043F\u0456\u0434
      \u0443\u0434\u0430\u0440\u0430\u043C\u0438 \u0431\u0430\u0442\u043E\u0433\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630047
    m_Localized: "\u0414\u0435\u043D\u044C 25. \u041F\u043E\u043B\u043E\u043D\u044F\u043D\u043A\u0430
      \u0432\u0441\u0435 \u043C\u043E\u0432\u0447\u0438\u0442\u044C. \u0417\u0430\u0445\u043B\u0438\u043D\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432 \u0441\u043B\u044C\u043E\u0437\u0430\u0445, \u0437\u0430\u043F\u0435\u0432\u043D\u044F\u044E\u0447\u0438,
      \u0449\u043E \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u0454,
      \u0430\u043B\u0435 \u043D\u0435 \u043A\u043E\u043B\u0435\u0442\u044C\u0441\u044F.
      \u0429\u043E \u0436, \u0432\u0456\u0434\u0434\u0430\u043C \u0434\u0430\u043D\u0438\u043D\u0443
      \u043F\u043E\u0432\u0430\u0433\u0438, \u0432 \u0457\u0457 \u0421\u0442\u0456\u0439\u043B\u0456
      \u0432\u043C\u0456\u044E\u0442\u044C \u0432\u0447\u0438\u0442\u0438 \u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0440\u043E\u0442 \u043D\u0430 \u0437\u0430\u043C\u043A\u0443. \u0414\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u043E\u0447\u0438\u043D\u0430\u0442\u0438 \u043F\u043E\u0448\u0443\u043A\u0438
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E. \u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
      \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E \u0441\u0435\u0440\u0435\u0434
      \u0445\u043B\u043E\u043F\u0446\u0456\u0432 \u043F\u0440\u0438\u0434\u0443\u0440\u043A\u0430
      \u0411\u0443\u0447\u0430 \u043D\u0430\u043F\u0435\u0432\u043D\u043E \u0454
      \u043F\u0430\u0440\u0430 \u0448\u0456\u0441\u0442\u043E\u043A \u043C\u043E\u0457\u0445
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0456\u0432. \u0429\u043E\u0439\u043D\u043E
      \u0432\u043E\u043D\u0438 \u0434\u0456\u0437\u043D\u0430\u044E\u0442\u044C\u0441\u044F,
      \u0449\u043E \u043C\u0438 \u043D\u0430\u0440\u0438\u043B\u0438 \u0421\u0442\u0456\u0439\u043B\u043E,
      \u0432\u043E\u043D\u0438 \u0437\u0432\u0430\u043B\u044F\u0442\u044C \u0442\u043E\u0433\u043E
      \u0436 \u0432\u0435\u0447\u043E\u0440\u0430 \u0456 \u043F\u043E\u0431\u0456\u0436\u0430\u0442\u044C
      \u0434\u043E\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438 \u0441\u0432\u043E\u0457\u043C
      \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u044F\u043C. \u041E\u0442\u0436\u0435,
      \u0431\u0443\u0434\u0435\u043C\u043E \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u043C\u0456\u0444 \u043F\u0440\u043E \u043F\u0438\u0441\u0430\u0440\u044F
      \u0417\u0430\u043B\u0456\u0437\u043D\u043E\u0437\u0430\u0434\u0438\u0445. \u041F\u043E\u0441\u0442\u0430\u0432\u043B\u044E
      \u043D\u0430 \u0447\u043E\u043B\u0456 \u043F\u043E\u0448\u0443\u043A\u043E\u0432\u0438\u0445
      \u0437\u0430\u0433\u043E\u043D\u0456\u0432 \u0441\u0432\u043E\u0457\u0445 \u043D\u0430\u0434\u0456\u0439\u043D\u0438\u0445
      \u0445\u043B\u043E\u043F\u0446\u0456\u0432, \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u043E\u043D\u0438 \u0437\u043D\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044E \u043C\u0435\u0442\u0443 \u043F\u043E\u0448\u0443\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630048
    m_Localized: "\u0414\u0435\u043D\u044C 26. \u0412\u0442\u0435\u0447\u0430 \u0440\u0430\u0431\u0456\u0432.
      \u0412\u0430\u0440\u0442\u0430 \u0437 \u043D\u043E\u0432\u0430\u0447\u043A\u0456\u0432
      \u0437\u0430\u0441\u043D\u0443\u043B\u0430 \u043D\u0430 \u043F\u043E\u0441\u0442\u0443,
      \u0456 \u0446\u0438\u043C \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0438\u0441\u044F
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0448\u043A\u0443\u0440, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u043D\u0430\u0448 \u043C\u0456\u0446\u043D\u0438\u0439 \u0433\u043E\u0440\u0456\u0448\u043E\u043A.
      \u0411\u0456\u043B\u044C\u0448\u0435 \u043C\u043E\u0436\u043D\u0430 \u043D\u0435
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0442\u0438\u0441\u044F \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E \u0432\u0445\u0456\u0434 \u0443 \u0421\u0442\u0456\u0439\u043B\u043E
      \u0437 \u043F\u0435\u0440\u0448\u0438\u0445 \u043A\u043E\u043F\u0438\u0442.
      \u041E\u0431\u043E\u0445 \u0441\u0430\u043B\u0430\u0433 \u043F\u043E\u0432\u0456\u0441\u0438\u043B\u0438
      \u043D\u0430 \u0441\u0432\u0456\u0442\u0430\u043D\u043A\u0443, \u0430 \u0445\u0443\u043B\u0456
      \u0442\u043E\u043B\u043A\u0443. \u0422\u0435\u043F\u0435\u0440 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0442\u0438\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0430 \u0443\u0434\u0430\u0447\u0443 \u0456 \u0441\u0443\u043C\u043B\u0456\u043D\u043D\u0456
      \u043F\u043E\u0448\u0443\u043A\u0438.|\u0414\u0435\u043D\u044C 26. \u0412\u0442\u0435\u0447\u0430
      \u0440\u0430\u0431\u0456\u0432. \u0412\u0430\u0440\u0442\u0430 \u0437 \u043D\u043E\u0432\u0430\u0447\u043A\u0456\u0432
      \u0437\u0430\u0441\u043D\u0443\u043B\u0430 \u043D\u0430 \u043F\u043E\u0441\u0442\u0443,
      \u0456 \u0446\u0438\u043C \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0438\u0441\u044F
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0448\u043A\u0443\u0440, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u043D\u0430\u0448 \u043C\u0456\u0446\u043D\u0438\u0439 \u0433\u043E\u0440\u0456\u0448\u043E\u043A.
      \u0411\u0456\u043B\u044C\u0448\u0435 \u043C\u043E\u0436\u043D\u0430 \u043D\u0435
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0442\u0438\u0441\u044F \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E \u0432\u0445\u0456\u0434 \u0443 \u0421\u0442\u0456\u0439\u043B\u043E
      \u0437 \u043F\u0435\u0440\u0448\u0438\u0445 \u043A\u043E\u043F\u0438\u0442.
      \u041E\u0431\u043E\u0445 \u0441\u0430\u043B\u0430\u0433 \u043F\u043E\u0432\u0456\u0441\u0438\u043B\u0438
      \u043D\u0430 \u0441\u0432\u0456\u0442\u0430\u043D\u043A\u0443, \u0430 \u0441\u0435\u043D\u0441\u0443?
      \u0422\u0435\u043F\u0435\u0440 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0442\u0438\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0430 \u0443\u0434\u0430\u0447\u0443 \u0456 \u0441\u0443\u043C\u043B\u0456\u043D\u043D\u0456
      \u043F\u043E\u0448\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
