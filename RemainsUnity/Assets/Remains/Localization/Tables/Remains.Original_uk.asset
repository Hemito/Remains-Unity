  - m_Id: 2742018234
    m_Localized: "\u0414\u0440\u0443\u0437\u0456, \u043D\u0430\u0448\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F
      \u043C\u0430\u0454 \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u0432\u0430
      \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438 \u0440\u043E\u0437\u0432\u0438\u0442\u043A\u0443.
      \u041F\u0435\u0440\u0448\u0438\u0439 - \u043C\u0438 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u043C\u043E
      \u0432\u043E\u0440\u043E\u0433\u043E\u0432\u0456 \u0439 \u043D\u0430\u0434\u0430\u043B\u0456
      \u043F\u0440\u043E\u0432\u0430\u0434\u0438\u0442\u0438 \u0441\u0432\u043E\u044E
      \u043F\u0456\u0434\u0440\u0438\u0432\u043D\u0443 \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0441\u0445\u0438\u043B\u044F\u0442\u0438 \u0434\u043E\u0431\u0440\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0434\u043E \u043A\u043E\u043D\u0444\u043E\u0440\u043C\u0456\u0437\u043C\u0443
      \u0456 \u0437\u0440\u0430\u0434\u0438, \u0456 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u043E\u0448\u0443\u043A\u0430\u043D\u0456
      \u043F\u0456\u0434\u0434\u0430\u043D\u0456 \u043D\u0430\u0448\u043E\u0457 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0457
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0438 \u041B\u0443\u043D\u0438 \u0441\u0430\u043C\u0456
      \u0432\u0456\u0434\u043A\u0440\u0438\u044E\u0442\u044C \u0432\u043E\u0440\u043E\u0442\u0430
      \u043D\u0430\u0448\u0438\u0445 \u043C\u0456\u0441\u0442 \u0442\u0435\u0440\u043E\u0440\u0438\u0441\u0442\u0430\u043C
      \u0456 \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u0430\u043C \u0437\u0435\u0431\u0440.
      \u0414\u0440\u0443\u0433\u0438\u0439 - \u043C\u0438, \u044F\u043A \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456
      \u043F\u0430\u0442\u0440\u0456\u043E\u0442\u0438 \u0456 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043A\u0438
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457, \u0434\u043E\u043A\u043B\u0430\u0434\u0435\u043C\u043E
      \u0432\u0441\u0456\u0445 \u0437\u0443\u0441\u0438\u043B\u044C, \u0449\u043E\u0431
      \u043F\u043E\u0437\u0431\u0430\u0432\u0438\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0430
      \u0439\u043E\u0433\u043E \u0437\u0431\u0440\u043E\u0457 \u0456 \u0439\u043E\u0433\u043E
      \u043E\u0442\u0440\u0443\u0442\u0438, \u0432\u0438\u0440\u0432\u0430\u0432\u0448\u0438
      \u0434\u0436\u0435\u0440\u0435\u043B\u043E \u0431\u0456\u0434\u0438 \u0437
      \u043A\u043E\u0440\u0435\u043D\u0435\u043C. \u041D\u0456 \u0432 \u043A\u043E\u0433\u043E
      \u043D\u0435\u043C\u0430\u0454 \u0441\u0443\u043C\u043D\u0456\u0432\u0456\u0432,
      \u044F\u043A \u0441\u0430\u043C\u0435 \u043D\u0430\u043C, \u043D\u0430\u0448\u043E\u043C\u0443
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0443, \u0441\u043B\u0456\u0434
      \u0432\u0447\u0438\u043D\u0438\u0442\u0438. \u0406 \u0445\u043E\u0447 \u0446\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u0454, \u0449\u043E \u043F\u0456\u0434\u0434\u0430\u043D\u0456-\u0437\u0435\u0431\u0440\u0438
      \u0442\u0435\u043F\u0435\u0440 \u0431\u0443\u0434\u0443\u0442\u044C \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
      \u043E\u0447\u043E\u0440\u043D\u0435\u043D\u0456 \u0432 \u043E\u0447\u0430\u0445
      \u0433\u0440\u043E\u043C\u0430\u0434\u0441\u044C\u043A\u043E\u0441\u0442\u0456,
      \u0432\u0441\u0456 \u0432\u0438, \u044F\u043A \u0441\u0432\u0456\u0434\u043E\u043C\u0456
      \u043F\u043E\u043D\u0456, \u043C\u0430\u0454\u0442\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438,
      \u0449\u043E \u0446\u0456 \u0437\u0430\u0445\u043E\u0434\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u044F\u0442\u044C
      \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u0441\u0430\u043C\u0438\u0445
      \u0437\u0435\u0431\u0440, \u0432\u0456\u0434\u0432\u0430\u0434\u0438\u0432\u0448\u0438
      \u0432\u0456\u0434 \u043D\u0438\u0445 \u0431\u0440\u0443\u0434\u043D\u0456
      \u043A\u043E\u043F\u0438\u0442\u0430 \u043D\u0430\u0448\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432.
      \u0412\u0456\u0434\u0442\u0435\u043F\u0435\u0440 \u043C\u0438 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438\u043C\u0435\u043C\u043E
      \u0437 \u0443\u0441\u0456\u0454\u044E \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u0456\u0441\u0442\u044E,
      \u0449\u043E\u0431 \u0432\u0438\u0440\u0432\u0430\u0442\u0438 \u043E\u0442\u0440\u0443\u0439\u043D\u0456
      \u0437\u0443\u0431\u0438 \u043E\u043C\u0430\u043D\u043B\u0438\u0432\u043E\u0457
      \u0437\u043C\u0456\u0457, \u0449\u043E \u0442\u044F\u0433\u043D\u0435\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u0430\u0448\u0438\u0445 \u0431\u0435\u0437\u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0445
      \u0441\u043F\u0456\u0432\u0433\u0440\u043E\u043C\u0430\u0434\u044F\u043D. \u0406
      \u044F\u043A\u0449\u043E \u043A\u043E\u0436\u0435\u043D \u0456\u0437 \u043D\u0430\u0441
      \u0434\u043E\u043A\u043B\u0430\u0434\u0435 \u0432\u0441\u0456\u0445 \u0437\u0443\u0441\u0438\u043B\u044C
      \u0456 \u0432\u0441\u044E \u0443\u0432\u0430\u0433\u0443 \u0434\u043E \u0432\u0438\u043A\u043E\u0440\u0456\u043D\u0435\u043D\u043D\u044F
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0445 \u0437\u043D\u0430\u043D\u044C,
      \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u043E \u043D\u0430\u0448\u043E\u0457
      \u0411\u0430\u0442\u044C\u043A\u0456\u0432\u0449\u0438\u043D\u0438 \u043D\u0435\u043C\u0438\u043D\u0443\u0447\u0435."
