  - m_Id: 2742018354
    m_Localized: "\u0422\u0440\u0430\u0432\u043C\u0438 \u0456\u0441\u0442\u043E\u0442\u043D\u043E
      \u0437\u043D\u0438\u0436\u0443\u044E\u0442\u044C \u0432\u0430\u0448\u0456 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      - \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C, \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C,
      \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C \u0456 \u043C\u0430\u0433\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018355
    m_Localized: "\u042F\u043A\u0449\u043E \u0432\u0430\u0448\u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0441\u0438\u043B\u0438 \u0431\u0443\u0434\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043D\u043E
      \u0431\u0456\u043B\u044C\u0448 \u043D\u0456\u0436 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443,
      \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u044C\u0441\u044F \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018356
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438
      \u0457\u0436\u0443 \u043D\u0430 \u043F\u043B\u0438\u0442\u0456 \u0437\u0430
      \u043D\u0430\u044F\u0432\u043D\u043E\u0441\u0442\u0456 \u0440\u0435\u0446\u0435\u043F\u0442\u0430
      \u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0456\u0432.
      \u0407\u0436\u0430 \u0434\u0430\u0454 \u0432\u0430\u043C \u0434\u043E\u0432\u0433\u043E\u0442\u0440\u0438\u0432\u0430\u043B\u0456
      \u0431\u043E\u043D\u0443\u0441\u0438 \u0434\u043E \u0440\u0456\u0437\u043D\u0438\u0445
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A,
      \u0430\u043B\u0435 \u0435\u0444\u0435\u043A\u0442 \u0431\u0443\u0434\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0456\u0434 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457
      \u0437'\u0457\u0434\u0435\u043D\u043E\u0457 \u0441\u0442\u0440\u0430\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018357
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043A\u043B\u0430\u0441\u0442\u0438
      \u0440\u0435\u0447\u0456, \u044F\u043A\u0456 \u0432\u0430\u043C \u043D\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456, \u0430\u043B\u0435 \u044F\u043A\u0456
      \u0432\u0438 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0435 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438,
      \u0443 \u0441\u0445\u043E\u0432\u0438\u0449\u0435. \u0420\u0435\u0447\u0456
      \u0437\u0456 \u0441\u0445\u043E\u0432\u0438\u0449\u0430 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0440\u043E\u0431\u043E\u0442\u0438
      \u043D\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0456 \u0442\u0430
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u0457 \u0432 \u043C\u0435\u0436\u0430\u0445
      \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u0442\u0430\u0431\u043E\u0440\u0443,
      \u0456 \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E
      \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438 \u0457\u0445 \u043D\u0430\u0437\u0430\u0434
      \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018358
    m_Localized: "\u0427\u0430\u0441\u0442\u0456\u0448\u0435 \u043C\u0438\u0439\u0442\u0435
      \u0445\u0432\u0456\u0441\u0442!"
