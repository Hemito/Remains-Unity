  - m_Id: 2729436440
    m_Localized: "\u041F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0430 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436441
    m_Localized: "\u0412\u043F\u043B\u0438\u0432\u043E\u0432\u0456 \u0444\u0430\u043A\u0442\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436442
    m_Localized: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436443
    m_Localized: "\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438 \u0430\u0442\u0430\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436444
    m_Localized: "\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436445
    m_Localized: "\u0406\u043D\u0448\u0456 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436446
    m_Localized: "\u0428\u043A\u043E\u0434\u0430 \u0432 \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u043C\u0443
      \u0431\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436447
    m_Localized: "\u0428\u043A\u043E\u0434\u0430 \u0432 \u0434\u0430\u043B\u044C\u043D\u044C\u043E\u043C\u0443
      \u0431\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436448
    m_Localized: "\u0421\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436449
    m_Localized: "\u0412\u043E\u043B\u043E\u0434\u0456\u043D\u043D\u044F \u0437\u0431\u0440\u043E\u0454\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436450
    m_Localized: "\u0417\u0431\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436451
    m_Localized: "\u0427\u0430\u0441 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436452
    m_Localized: "\u0412\u043F\u043B\u0438\u0432\u0430\u0454 \u043D\u0430 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u043D\u043D\u044F
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043F\u0430\u0442\u0440\u043E\u043D\u0438 \u0430\u0431\u043E \u0431\u0430\u0442\u0430\u0440\u0435\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436453
    m_Localized: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430 \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436454
    m_Localized: "\u041C\u043D\u043E\u0436\u043D\u0438\u043A \u0456\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u0441\u0442\u0456
      \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F \u0434\u043B\u044F \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0441\u0442\u0440\u0456\u043B\u0435\u0446\u044C\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0442\u0430 \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436455
    m_Localized: "\u0421\u0438\u043B\u0430 \u0441\u0442\u0443\u0441\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436456
    m_Localized: "\u041C\u043D\u043E\u0436\u043D\u0438\u043A \u0441\u0438\u043B\u0438
      \u0443\u0434\u0430\u0440\u0443 \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436457
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436458
    m_Localized: "\u0412\u043F\u043B\u0438\u0432\u0430\u0454 \u043D\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0445\u043E\u043B\u043E\u0434\u043D\u0443 \u0437\u0431\u0440\u043E\u044E,
      \u043E\u043A\u0440\u0456\u043C \u0442\u0456\u0454\u0457, \u0443 \u044F\u043A\u043E\u0457
      \u0454 \u0432\u043B\u0430\u0441\u043D\u0438\u0439 \u043C\u043E\u0442\u043E\u0440
      (\u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u043B\u0430\u043D\u0446\u044E\u0433\u043E\u0432\u0430
      \u043F\u0438\u043B\u0430 \u0439 \u0430\u0432\u0442\u043E\u0441\u043E\u043A\u0438\u0440\u0430)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436459
    m_Localized: "\u0415\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436460
    m_Localized: "\u0415\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u0434\u0456\u0457 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0445 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0456\u0432,
      \u0442\u0430\u043A\u0438\u0445 \u044F\u043A \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456
      \u0437\u0456\u043B\u043B\u044F \u0442\u0430 \u0430\u043D\u0442\u0438\u0440\u0430\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436461
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0440\u0443\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436462
    m_Localized: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0440\u0443\u0445\u0443. \u0414\u0435\u044F\u043A\u0456 \u0444\u0430\u043A\u0442\u043E\u0440\u0438,
      \u044F\u043A-\u043E\u0442 \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430,
      \u043A\u043E\u043D\u0442\u0443\u0437\u0456\u044F, \u0441\u043F'\u044F\u043D\u0456\u043D\u043D\u044F
      \u0430\u0431\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
      \u0440\u0435\u0447\u0430\u043C\u0438, \u043C\u043E\u0436\u0443\u0442\u044C
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u043E \u0457\u0457 \u043E\u0431\u043C\u0435\u0436\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436463
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0431\u0456\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436464
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0443\u0454, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0431\u0456\u0433\u0443
      \u0431\u0456\u043B\u044C\u0448\u0430 \u0437\u0430 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0440\u0443\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436465
    m_Localized: "\u0412\u0438\u0442\u0440\u0430\u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436466
    m_Localized: "\u0412\u0438\u0442\u0440\u0430\u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456
      \u043D\u0430 \u0431\u0456\u0433, \u0441\u0442\u0440\u0438\u0431\u043A\u0438
      \u0442\u0430 \u0440\u0438\u0432\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436467
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C \u0437\u043B\u043E\u043C\u0443
      \u0437\u0430\u043C\u043A\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436468
    m_Localized: "\u0412\u0438\u0437\u043D\u0430\u0447\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u0432\u0438\u0447\u043A\u043E\u044E
      \"\u0437\u043B\u043E\u043C\", \u0430\u043B\u0435 \u0442\u0430\u043A\u043E\u0436
      \u043D\u0430 \u0446\u0435\u0439 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440
      \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0442\u044C \u0434\u0435\u044F\u043A\u0456
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438 \u0439 \u0435\u0444\u0435\u043A\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436469
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C \u0437\u043B\u043E\u043C\u0443
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436470
    m_Localized: "\u0412\u0438\u0437\u043D\u0430\u0447\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u0432\u0438\u0447\u043A\u043E\u044E
      \"\u043D\u0430\u0443\u043A\u0430\", \u0430\u043B\u0435 \u0442\u0430\u043A\u043E\u0436
      \u043D\u0430 \u0446\u0435\u0439 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440
      \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0442\u044C \u0434\u0435\u044F\u043A\u0456
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438 \u0439 \u0435\u0444\u0435\u043A\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436471
    m_Localized: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430 \u0432\u0438\u0442\u0440\u0430\u0442\u0430
      \u043C\u0430\u0433\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436472
    m_Localized: "\u0412\u0438\u0442\u0440\u0430\u0442\u0430 \u043C\u0430\u0433\u0456\u0457
      \u043D\u0430 \u0432\u0441\u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0434\u0456\u0457, \u0432\u043A\u043B\u044E\u0447\u043D\u043E \u0437 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C,
      \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043C\u0438
      \u0442\u0430 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043C\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436473
    m_Localized: "\u0412\u0438\u0442\u0440\u0430\u0442\u0430 \u043C\u0430\u0433\u0456\u0457
      \u043D\u0430 \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436474
    m_Localized: "\u041E\u043A\u0440\u0435\u043C\u0438\u0439 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C. \u041F\u0435\u0440\u0435\u043C\u043D\u043E\u0436\u0443\u0454\u0442\u044C\u0441\u044F
      \u0437 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u043C \"\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430
      \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u043C\u0430\u0433\u0456\u0457\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436475
    m_Localized: "\u041E\u0447\u043A\u0438 \u0434\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436476
    m_Localized: "\u041A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043E\u0447\u043E\u043A
      \u0434\u0456\u0457 \u0434\u043B\u044F \u0430\u0442\u0430\u043A \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u0432 \u0440\u0435\u0436\u0438\u043C\u0456
      \u0417.\u041F.\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436477
    m_Localized: "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436478
    m_Localized: "\u041F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0437\u0430\u0433\u0438\u043D\u0443\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436479
    m_Localized: "\u041C\u0430\u0441\u0448\u0442\u0430\u0431 100%"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436480
    m_Localized: "\u042F\u043A\u0449\u043E \u0446\u044E \u043E\u043F\u0446\u0456\u044E
      \u0432\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E, \u0442\u043E \u043D\u0430
      \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0433\u0440\u0438 \u0431\u0443\u0434\u0435
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E \u043C\u0430\u0441\u0448\u0442\u0430\u0431
      \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F 100% \u0437\u0456
      \u0441\u043A\u0440\u043E\u043B\u043E\u043C. \u042F\u043A\u0449\u043E \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u0430,
      \u0442\u043E \u043C\u0430\u0448\u0442\u0430\u0431 \u0431\u0443\u0434\u0435
      \u0442\u0430\u043A\u0438\u0439, \u0449\u043E\u0431 \u0443\u0441\u044F \u043A\u0456\u043C\u043D\u0430\u0442\u0430
      \u0432\u043C\u0456\u0449\u0430\u043B\u0430\u0441\u044F \u043D\u0430 \u0435\u043A\u0440\u0430\u043D.
      \u0423\u0432\u0456\u043C\u043A\u043D\u0456\u0442\u044C \u0446\u044E \u043E\u043F\u0446\u0456\u044E,
      \u044F\u043A\u0449\u043E \u0432\u0430\u0448 \u043C\u043E\u043D\u0456\u0442\u043E\u0440
      \u043C\u0430\u0454 \u0440\u043E\u0437\u0434\u0456\u043B\u044C\u043D\u0443 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      FullHD (1920x1080) \u0430\u0431\u043E \u0431\u0456\u043B\u044C\u0448\u0443.
      \u042F\u043A\u0449\u043E \u0440\u043E\u0437\u0434\u0456\u043B\u044C\u043D\u0430
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u043C\u0435\u043D\u0448\u0430,
      \u0442\u043E \u0457\u0457 \u043A\u0440\u0430\u0449\u0435 \u0432\u0438\u043C\u043A\u043D\u0443\u0442\u0438
      - \u0446\u0435 \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u044C \u043D\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
      \u043D\u0430 \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440 \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u044C
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C.
      \u0412\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431
      \u043F\u0440\u044F\u043C\u043E \u0443 \u0433\u0440\u0456 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043A\u043B\u0430\u0432\u0456\u0448\u0456 @1. \u0410 \u044F\u043A\u0449\u043E
      \u043A\u0456\u043C\u043D\u0430\u0442\u0430 \u043D\u0435 \u0432\u043C\u0456\u0449\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0435\u043A\u0440\u0430\u043D \u0446\u0456\u043B\u043A\u043E\u043C,
      \u0442\u043E \u0440\u0443\u0445\u0430\u0442\u0438\u043C\u0435\u0442\u0435 \u043A\u0430\u043C\u0435\u0440\u0443,
      \u0443\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438 @2."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436481
    m_Localized: "\u0422\u0440\u0435\u043C\u0442\u0456\u043D\u043D\u044F \u043A\u0430\u043C\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
