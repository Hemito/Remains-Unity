  - m_Id: 2725241238
    m_Localized: "\"\u0417\u0430\u0445\u0438\u0441\u043D\u0438\u043A \u0447\u0435\u0441\u0442\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241239
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u043D\u0430\u0434 \u044F\u043A\u0438\u043C
      \u043F\u043E\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
      \u043C\u0430\u0439\u0441\u0442\u0435\u0440-\u0437\u0431\u0440\u043E\u044F\u0440.
      \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u0439\u043E\u043C\u0443
      \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u0447\u0438\u043D\u043E\u043C \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u043F\u043E\u0437\u0431\u0430\u0432\u0438\u0442\u0438 \u0446\u0435\u0439 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440
      \u043F\u0440\u0438\u0442\u0430\u043C\u0430\u043D\u043D\u0438\u0445 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439
      \u043F\u043E\u0434\u0456\u0431\u043D\u0456\u0439 \u0437\u0431\u0440\u043E\u0457
      \u043D\u0435\u0434\u043E\u043B\u0456\u043A\u0456\u0432, \u0442\u0430\u043A\u0438\u0445
      \u044F\u043A \u043D\u0438\u0437\u044C\u043A\u0430 \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0448\u0432\u0438\u0434\u043A\u0430 \u0432\u0438\u0442\u0440\u0430\u0442\u0430
      \u0431\u0430\u0442\u0430\u0440\u0435\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241240
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
