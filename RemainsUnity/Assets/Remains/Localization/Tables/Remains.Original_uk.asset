  - m_Id: 2729435477
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0422\u043E\u0440\u0433\u0456\u0432\u043B\u044F\"
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454 \u0432\u0430\u043C \u0434\u043E\u043C\u043E\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u0437 \u0440\u0456\u0437\u043D\u0438\u043C\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438
      \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445, \u0449\u043E\u0431
      \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0432 \u043D\u0438\u0445
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0456 \u0442\u043E\u0432\u0430\u0440\u0438
      \u0442\u0430 \u043F\u043E\u0441\u043B\u0443\u0433\u0438 \u0437\u0430 \u043D\u0438\u0437\u044C\u043A\u0438\u043C\u0438
      \u0446\u0456\u043D\u0430\u043C\u0438. [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C
      \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C \u043E\u0447\u043A\u043E\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0437\u043C\u0435\u043D\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0446\u0456\u043D\u0438
      \u043D\u0430 \u043A\u0443\u043F\u0456\u0432\u043B\u044E \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445
      \u0442\u043E\u0432\u0430\u0440\u0456\u0432 \u0456 \u0440\u0435\u043C\u043E\u043D\u0442
      \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F \u043D\u0430
      #1. [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u0431\u0443\u0434\u0435 \u0440\u043E\u0437\u0448\u0438\u0440\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0430\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442 \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0431\u0443\u0434\u0443\u0442\u044C \u0437'\u044F\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u043D\u043E\u0432\u0456 \u0435\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u0456
      \u0442\u043E\u0432\u0430\u0440\u0438, \u044F\u043A\u0438\u0445 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u0434\u0435 \u043D\u0435 \u0434\u0456\u0441\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
