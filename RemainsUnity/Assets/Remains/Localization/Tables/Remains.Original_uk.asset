  - m_Id: 2742018237
    m_Localized: "*\u0412\u0456\u0434 \u043A\u043E\u0433\u043E: \u041C\u043E\u043D\u0456\u043D
      \u0420\u0435\u0439\u043D. \u041B\u0438\u0441\u0442 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E:
      69892 \u0434\u043D\u0456 \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      (re(2)) \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0438*\n\t\"\u041D\u0430\u0448\u0456
      \u043F\u043E\u0431\u043E\u044E\u0432\u0430\u043D\u043D\u044F \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438\u0441\u044F.
      \u0417\u043B\u043E\u0434\u0456\u0439 \u0437'\u044F\u0432\u0438\u0432\u0441\u044F
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434 \u0442\u043E\u0447\u043D\u043E
      \u0432 \u0442\u043E\u0439 \u0434\u0435\u043D\u044C, \u044F\u043A\u0438\u0439
      \u043C\u0438 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u043B\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u0456
      \u041C\u041C. \u041D\u0430 \u0436\u0430\u043B\u044C, \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u043D\u0430 \u043C\u0456\u0441\u0446\u0456
      \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F, \u043F\u0440\u043E\u0442\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0456 \u043D\u0430 \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F
      \u043F\u043E\u043D\u0456 \u0437\u043C\u043E\u0433\u043B\u0438 \u0434\u043E\u0441\u0442\u043E\u0432\u0456\u0440\u043D\u043E
      \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0456
      \u0440\u0438\u0441\u0438 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u043E\u0441\u0442\u0456
      \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u0430: \u043F\u043E\u043D\u0456
      \u0441\u0435\u0440\u0435\u0434\u043D\u0456\u0445 \u0440\u043E\u043A\u0456\u0432,
      \u0437 \u0431\u043B\u044F\u043A\u043B\u043E-\u0436\u043E\u0432\u0442\u043E\u044E
      \u0448\u0435\u0440\u0441\u0442\u044E \u0456 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u044E
      \u0433\u0440\u0438\u0432\u043E\u044E, \u043A\u043E\u043B\u0456\u0440 \u044F\u043A\u043E\u0457
      \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438 \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F.
      \u041A\u044C\u044E\u0442\u0456\u043C\u0430\u0440\u043A\u0430 \u0439 \u043E\u0447\u0456
      \u0431\u0443\u043B\u0438 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0456
      \u043F\u043B\u0430\u0449\u0435\u043C, \u0456 \u0457\u0445 \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u044F
      \u0431\u0443\u043B\u0430 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0430.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018238
    m_Localized: "*\u041A\u043E\u043C\u0443: \u041C\u043E\u043D\u0456\u043D\u0433
      \u0420\u0435\u0439\u043D. \u041B\u0438\u0441\u0442 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E:
      69892 \u0434\u043D\u0456 \u0442\u043E\u043C\u0443 \u041D\u0430\u0437\u0432\u0430:
      (re(3)) \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0438*\n\t\"\u041D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438
      \u043D\u0430 \u043F\u0440\u043E\u0432\u0430\u043B \u043C\u0456\u0441\u0456\u0457
      \u043F\u0435\u0440\u0435\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F, \u0432\u0430\u0448\u0430
      \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u044F, \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E,
      \u0454 \u0443\u0441\u043F\u0456\u0448\u043D\u043E\u044E. \u041F\u043E\u043D\u0456
      \u0437 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u041C\u043E\u0440\u0430\u043B\u0456 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u0430\u0434 \u0443\u0441\u0456\u043C\u0430
      \u043F\u0440\u0438\u0447\u0435\u0442\u043D\u0438\u043C\u0438 \u0434\u043E \u0440\u043E\u0431\u043E\u0442\u0438
      \u043D\u0430\u0434 \u0456\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u043E\u043C
      \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445, \u043F\u0440\u043E\u0442\u0435
      \u043D\u0456\u0445\u0442\u043E \u0437 \u043D\u0438\u0445 \u043D\u0435 \u0432\u0447\u0438\u043D\u0438\u0432
      \u043D\u0456\u0447\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0435\u0442\u0443\u044E\u0447\u043E\u0433\u043E
      \u0437\u0430 \u0432\u0435\u0441\u044C \u0442\u0435\u0440\u043C\u0456\u043D
      \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u044C, \u0442\u0438\u043C
      \u0441\u0430\u043C\u0438\u043C \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0432\u0448\u0438
      \u0441\u043E\u0431\u0456 \u0430\u043B\u0456\u0431\u0456. \u0426\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u043A\u043E\u043B\u043E \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043D\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0448\u0438\u0440\u0448\u0438\u043C
      \u0437\u0430 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0443\u0432\u0430\u043D\u0435.
      \u042F\u043A\u0449\u043E \u0432\u0430\u0448\u0456 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0432\u0456\u0440\u043D\u0456, \u0446\u0456 \u0440\u0438\u0441\u0438 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u043E\u0441\u0442\u0456
      \u0434\u0430\u0434\u0443\u0442\u044C \u0437\u043C\u043E\u0433\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u043F\u043E\u0448\u0443\u043A\u0438 \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043D\u043E\u0433\u043E
      \u0432 \u043D\u0430\u0439\u043A\u043E\u0440\u043E\u0442\u0448\u0456 \u0442\u0435\u0440\u043C\u0456\u043D\u0438.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018239
    m_Localized: "*\u0412\u0456\u0434 \u043A\u043E\u0433\u043E: \u041C\u043E\u043D\u0456\u043D
      \u0420\u0435\u0439\u043D. \u041B\u0438\u0441\u0442 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E:
      69891 \u0434\u0435\u043D\u044C \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      (re(4)) \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0438*\n\t\"\u0417 \u0440\u0430\u0434\u0456\u0441\u0442\u044E
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u044E, \u0449\u043E
      \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u0430, \u043D\u0430\u0434
      \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F\u043C \u044F\u043A\u043E\u0433\u043E
      \u043C\u0438 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0438 \u043E\u0441\u0442\u0430\u043D\u043D\u0456
      \u0434\u043D\u0456, \u0443\u0441\u043F\u0456\u0448\u043D\u043E \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u043B\u0438
      \u0430\u0433\u0435\u043D\u0442\u0438 \u041C\u041C. \u041D\u0438\u043C \u0432\u0438\u044F\u0432\u0438\u043B\u0430\u0441\u044F
      \u043C\u043E\u043B\u043E\u0434\u0448\u0430 \u0441\u043F\u0456\u0432\u0440\u043E\u0431\u0456\u0442\u043D\u0438\u0446\u044F
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437 \u0457\u0445\u043D\u0456\u0445
      \u0432\u0456\u0434\u0434\u0456\u043B\u0456\u0432, \u043C\u0456\u0441 \u0413\u0440\u0435\u0439
      \u0428\u043E\u0440. \u041F\u0456\u0441\u043B\u044F \u043D\u0435\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0433\u043E
      \u0434\u043E\u043F\u0438\u0442\u0443 \u0432\u043E\u043D\u0430 \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F
      \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0456 \u0432\u0438\u043A\u043B\u0430\u043B\u0430 \u043F\u0440\u0438\u0447\u0438\u043D\u0438
      \u0457\u0457 \u0434\u0456\u0439. \u042F\u043A \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F,
      \u0457\u0457 \u0431\u0440\u0430\u0442 \u0431\u0443\u0432 \u043E\u0434\u043D\u0438\u043C
      \u0456\u0437 \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432, \u044F\u043A\u0456
      \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0442\u0440\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u043F\u043E\u0434\u0456\u0439
      \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445 \u0413\u0440\u0456\u0437\u043B\u0456
      \u0456 \u0441\u043C\u0435\u0440\u0442\u044C \u044F\u043A\u043E\u0433\u043E,
      \u043F\u043E\u0440\u044F\u0434 \u0437\u0456 \u0441\u043C\u0435\u0440\u0442\u044F\u043C\u0438
      \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u0456\u043D\u0448\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0442\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E
      \u043F\u0440\u043E \u0456\u043D\u0446\u0438\u0434\u0435\u043D\u0442 \u0437\u0430\u0433\u0430\u043B\u043E\u043C,
      \u043C\u0438 \u043D\u0435 \u043F\u0440\u0438\u0434\u0430\u0432\u0430\u043B\u0438
      \u0448\u0438\u0440\u043E\u043A\u043E\u043C\u0443 \u0440\u043E\u0437\u0433\u043E\u043B\u043E\u0441\u0443
      \u0437\u0430\u0440\u0430\u0434\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0431\u043E\u0439\u043E\u0432\u043E\u0433\u043E \u0434\u0443\u0445\u0443 \u0430\u0440\u043C\u0456\u0457
      \u0456 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F. \u041F\u043E\u0434\u0456\u0431\u043D\u0438\u043C\u0438
      \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0430\u043C\u0438 \u0456 \u0433\u0440\u0430\u0444\u0456\u0442\u0456
      \u0432\u043E\u043D\u0430, \u0437\u0430 \u0457\u0457 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \"\u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438
      \u0447\u0435\u0441\u0442\u044C\" \u0437\u0430\u0433\u0438\u0431\u043B\u043E\u0433\u043E
      \u0440\u043E\u0434\u0438\u0447\u0430 \u0456 \"\u0432\u0456\u0434\u0432\u043E\u043B\u0456\u043A\u0442\u0438
      \u0441\u0435\u0431\u0435 \u0432\u0456\u0434 \u043F\u043E\u0445\u043C\u0443\u0440\u0438\u0445
      \u0434\u0443\u043C\u043E\u043A\". \u041D\u0430\u0440\u0430\u0437\u0456 \u0457\u0457
      \u0443\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C \u0443 \u0441\u043B\u0456\u0434\u0447\u043E\u043C\u0443
      \u0432\u0456\u0434\u0434\u0456\u043B\u0456 \u041C\u041C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018240
    m_Localized: "*\u041A\u043E\u043C\u0443: \u041C\u043E\u043D\u0456\u043D \u0420\u0435\u0439\u043D.
      \u041B\u0438\u0441\u0442 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E:
      69891 \u0434\u0435\u043D\u044C \u0442\u043E\u043C\u0443 \u041D\u0430\u0437\u0432\u0430:
      (re(5)) \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0438*\n\t\"\u0412\u0456\u0442\u0430\u044E
      \u0437 \u0443\u0441\u043F\u0456\u0448\u043D\u0438\u043C \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F\u043C
      \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F.
      \u041C\u0435\u043D\u0456 \u0432\u0436\u0435 \u0434\u043E\u043F\u043E\u0432\u0456\u043B\u0438
      \u043F\u0440\u043E \u0446\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0438
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u041C\u043E\u0440\u0430\u043B\u0456.
      \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u0436 \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0442\u0438 \u0413\u0440\u0435\u0439
      \u0428\u043E\u0440 \u0443 \u0441\u043B\u0456\u0434\u0447\u043E\u043C\u0443
      \u0432\u0456\u0434\u0434\u0456\u043B\u0456 \u0442\u0430 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0432\u0438\u0445\u043E\u0432\u043D\u0443 \u0431\u0435\u0441\u0456\u0434\u0443
      \u043D\u0430 \u0442\u0435\u043C\u0443 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F
      \u043C\u043E\u0440\u0430\u043B\u0456 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0456 \u043C\u0456\u0441\u0446\u044F \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0438\u0445
      \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043D\u044C \u0443 \u0436\u0438\u0442\u0442\u0456
      \u043F\u0456\u0434\u0434\u0430\u043D\u043E\u0433\u043E \u0432\u043E\u044E\u044E\u0447\u043E\u0457
      \u0434\u0435\u0440\u0436\u0430\u0432\u0438. \u041F\u043E\u0434\u0430\u043B\u044C\u0448\u0430
      \u0434\u043E\u043B\u044F \u0446\u0456\u0454\u0457 \u043F\u043E\u043D\u0456
      \u043D\u0435\u0445\u0430\u0439 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u0457\u0457 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430,
      \u0446\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043D\u0430\u0448\u0430
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2742018241
    m_Localized: "\u0421\u043D\u0435\u0439\u043B\u0437, \u0446\u0435 \u0421\u043D\u0456\u043F\u0441.
      \u0412\u0438\u0431\u0430\u0447, \u0434\u0440\u0443\u0436\u0435, \u0430\u043B\u0435
      \u044F \u0437\u043C\u0443\u0448\u0435\u043D\u0438\u0439 \u0432\u0438\u0457\u0445\u0430\u0442\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0440\u0430\u0437. \u0406
      \u044F \u043D\u0435 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439,
      \u043A\u043E\u043B\u0438 \u0442\u043E\u0447\u043D\u043E \u044F \u0437\u043C\u043E\u0436\u0443
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F. \u0419\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E \u0442\u043E\u0439 \u043F\u0440\u043E\u0435\u043A\u0442,
      \u043F\u0440\u043E \u044F\u043A\u0438\u0439 \u043D\u0430\u0441 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u043F\u043E\u0434\u0431\u0430\u0442\u0438 \u043F\u0430\u043D\u0456 \u0420\u0430\u0440\u0456\u0442\u0456.
      \u0422\u0430\u043A, \u0422\u041E\u041C\u0423 \u0421\u0410\u041C\u041E\u041C\u0423
      \u043F\u0440\u043E\u0435\u043A\u0442\u0456. \u042F \u0431\u0430\u0433\u0430\u0442\u043E
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u043C\u0438
      \u0434\u043D\u044F\u043C\u0438 \u043D\u0430\u0434 \u043D\u0438\u043C \u0456
      \u0434\u0456\u0439\u0448\u043E\u0432 \u0432\u0438\u0441\u043D\u043E\u0432\u043A\u0443,
      \u0449\u043E \u0440\u0438\u0442\u0443\u0430\u043B \u0431\u0443\u0434\u0435
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0438\u0439 \u0431\u0435\u0437
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u043F\u0456\u0434\u0441\u0438\u043B\u044E\u0432\u0430\u0447\u0456\u0432. \u041D\u0430
      \u0436\u0430\u043B\u044C, \u043C\u043E\u0457 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u043D\u0435 \u0434\u0430\u043B\u0438 \u0436\u043E\u0434\u043D\u043E\u0433\u043E
      \u043D\u0430\u0442\u044F\u043A\u0443 \u043D\u0430 \u0442\u0435, \u0449\u043E
      \u0441\u0430\u043C\u0435 \u043C\u043E\u0433\u043B\u043E \u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u043D\u0430\u043C. \u041C\u0435\u043D\u0456 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F
      \u0432\u0434\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445
      \u043C\u0435\u0442\u043E\u0434\u0438\u043A, \u043F\u0440\u043E \u044F\u043A\u0456
      \u044F \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C \u0442\u043E\u0431\u0456
      \u043F\u0456\u0437\u043D\u0456\u0448\u0435, \u0456 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u043E\u0434\u043D\u0430 \u0437 \u043D\u0438\u0445 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0441\u0432\u043E\u0457 \u043F\u043B\u043E\u0434\u0438. \u041E\u0434\u043D\u0430\u043A
      \u0443\u043C\u043E\u0432\u0438 \u0442\u0430\u043A\u0456, \u0449\u043E \u0432
      \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454 \u0436\u043E\u0434\u043D\u043E\u0457
      \u0437\u0430\u0439\u0432\u043E\u0457 \u0433\u043E\u0434\u0438\u043D\u0438,
      \u0449\u043E\u0431 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0439 \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0432\u0441\u0435 \u0432\u0456\u0447-\u043D\u0430-\u0432\u0456\u0447. \u042F
      \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u0435 \u043F\u0440\u043E
      \u043E\u0434\u043D\u0443 \u043F\u043E\u0441\u043B\u0443\u0433\u0443: \u0437\u0430\u0432\u0442\u0440\u0430
      \u0442\u043E\u0431\u0456 \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u0434\u0435
      \u0437\u0430 \u043C\u0435\u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F
      \u0437 \u043F\u0430\u043D\u0456 \u0420\u0430\u0440\u0456\u0442\u0456 \u0442\u0430
      \u0434\u0430\u0442\u0438 \u0434\u043E\u043A\u043B\u0430\u0434\u043D\u0438\u0439
      \u0437\u0432\u0456\u0442 \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u043D\u0430\u043C
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437'\u044F\u0441\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0434\u0430\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.
      \u041C\u043E\u0457 \u043D\u0430\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043D\u043D\u044F
      \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0441\u0430\u043C \u0437\u043D\u0430\u0454\u0448 \u0434\u0435, \u043F\u0435\u0440\u0435\u0434
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0447\u044E \u0437 \u043F\u0430\u043D\u0456
      \u0420\u0430\u0440\u0456\u0442\u0456 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439 \u0457\u0445. \u0406 \u043D\u0435
      \u0437\u0434\u0443\u043C\u0430\u0439 \u0432\u0432\u0430\u0436\u0430\u0442\u0438,
      \u0449\u043E \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432\u0441\u044F
      \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C, \u0449\u043E\u0431 \u0437\u0432\u0430\u043B\u0438\u0442\u0438
      \u0432\u0441\u0435 \u043D\u0430 \u0442\u0435\u0431\u0435! \u0426\u0435 \u0431\u0443\u043B\u043E
      \u0431 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043E\u0431\u0443\u0440\u043B\u0438\u0432\u043E
      \u0437 \u0442\u0432\u043E\u0433\u043E \u0431\u043E\u043A\u0443.\n\t\u0406 \u0449\u0435:
      \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0432\u0438\u0434\u0430\u043B\u0438
      \u0446\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u0437\u0456 \u0441\u0432\u043E\u0433\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430,
      \u0449\u043E\u0439\u043D\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0454\u0448
      \u0439\u043E\u0433\u043E. \u0421\u0430\u043C \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018242
    m_Localized: "\u0410 \u0449\u043E \u0449\u043E\u0434\u043E \u0446\u044C\u043E\u0433\u043E
      \u0437\u0430\u043F\u0438\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018243
    m_Localized: "\u0412\u0456\u0434\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0437\u0430\u043F\u0438\u0441
      \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F 1."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018244
    m_Localized: "\u0428\u0430\u0439\u043D\u0456, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0439,
      \u0446\u0435 \u0442\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018245
    m_Localized: "\u041F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u0435, \u043C\u0438\u043B\u0438\u0439,
      \u043D\u0435 \u043C\u043E\u0432\u0447\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018246
    m_Localized: "\u041D\u0430 \u043D\u0430\u0441 \u043D\u0430\u043F\u0430\u043B\u0438,
      \u0428\u0430\u0439\u043D\u0456. \u0417\u0435\u0431\u0440\u0438 \u043D\u0430\u043F\u0430\u043B\u0438
      \u043D\u0430 \u043D\u0430\u0441! \u041C\u0456\u0441\u0442\u043E \u0431\u043E\u043C\u0431\u043B\u044F\u0442\u044C,
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E \u0431\u043E\u043C\u0431\u043B\u044F\u0442\u044C.
      \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0438 \u043F\u0456\u0434\u043D\u044F\u043B\u0438
      \u0449\u0438\u0442 \u0456 \u0437\u0430\u0445\u0438\u0449\u0430\u044E\u0442\u044C
      \u043D\u0430\u0441, \u0430\u043B\u0435 \u0442\u0443\u0442 \u0443\u0441\u0435
      \u0433\u0456\u0440\u0448\u0435 \u0437 \u043A\u043E\u0436\u043D\u043E\u044E
      \u0445\u0432\u0438\u043B\u0438\u043D\u043E\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018247
    m_Localized: "\u0412\u0443\u043B\u0438\u0446\u044F\u043C\u0438 \u043F\u043E\u0432\u0437\u0435
      \u044F\u043A\u0438\u0439\u0441\u044C \u0434\u0438\u0432\u043D\u0438\u0439 \u0433\u0430\u0437.
      \u042F \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0431\u0430\u0447\u0438\u043B\u0430
      \u043D\u0456\u0447\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E,
      \u0430\u043B\u0435 \u0432\u0456\u043D \u0441\u0442\u0440\u0430\u0448\u043D\u0438\u0439!
      \u042F \u0441\u0445\u043E\u0432\u0430\u043B\u0430\u0441\u044F \u0432 \u043F\u0456\u0434\u0432\u0430\u043B\u0456
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430, \u0442\u0443\u0442,
      \u0443 \u043A\u0456\u043C\u043D\u0430\u0442\u0456 \u0437 \u0432\u0443\u0437\u043B\u043E\u043C
      \u0437\u0432'\u044F\u0437\u043A\u0443. \u0423 \u0432\u0441\u0456\u0439 \u0431\u0443\u0434\u0456\u0432\u043B\u0456
      \u043D\u0456\u043A\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454. \u0414\u0435
      \u0432\u043E\u043D\u0438? \u0414\u0435 \u0432\u0441\u0456? \u042F \u043D\u0435
      \u0437\u043D\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018248
    m_Localized: "\u0428\u0430\u0439\u043D\u0456, \u044F\u043A\u0449\u043E \u0442\u0438
      \u0447\u0443\u0454\u0448 \u043C\u0435\u043D\u0435, \u0431\u0456\u0436\u0438
      \u0437 \u043C\u0456\u0441\u0442\u0430! \u0411\u0456\u0436\u0438 \u0437\u0430\u0440\u0430\u0437
      \u0436\u0435! \u042F\u043A\u0449\u043E \u0437\u0435\u0431\u0440\u0438 \u043D\u0430\u043F\u0430\u043B\u0438
      \u043D\u0430 \u043D\u0430\u0441, \u0442\u043E \u0439 \u043D\u0430 \u0432\u0430\u0441
      \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C \u0442\u0435\u0436 \u043F\u043E\u0441\u0438\u043F\u043B\u0435\u0442\u044C\u0441\u044F.
      \u041D\u0435 \u0433\u0430\u0439 \u0447\u0430\u0441\u0443, \u0431\u0456\u0436\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018249
    m_Localized: "\u0428\u0430\u0439\u043D\u0456, \u0442\u0438 \u0447\u0443\u0454\u0448
      \u043C\u0435\u043D\u0435? \u0428\u0430\u0439\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018250
    m_Localized: "\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0432\u043C\u0438\u0440\u0430\u0442\u0438,
      \u0428\u0430\u0439\u043D\u0456. \u042F \u0445\u043E\u0447\u0443 \u0434\u043E
      \u0442\u0435\u0431\u0435. \u041C\u0438 \u0436 \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435\u043C\u043E\u0441\u044F
      \u0449\u0435, \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018251
    m_Localized: "*\u0421\u0445\u043B\u0438\u043F*"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018252
    m_Localized: "\u0426\u044C\u043E\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438 \u0432\u0441\u044C\u043E\u0433\u043E. \u0426\u0435
      \u043D\u0435\u043F\u0440\u0430\u0432\u0434\u0430. \u042F \u0441\u043F\u043B\u044E.
      \u042F \u0441\u043F\u043B\u044E, \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018253
    m_Localized: "\u0428\u0430\u0439\u043D\u0456, \u0442\u0438 \u0447\u0443\u0454\u0448
      \u043C\u0435\u043D\u0435? \u0428\u0430\u0439\u043D\u0456, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0439!
      \u0428\u0430\u0439\u043D\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018254
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018255
    m_Localized: "\u041C\u0435\u043D\u0456 \u043D\u0435 \u0432\u0430\u0440\u0442\u043E
      \u0431\u0443\u043B\u043E \u0446\u0435 \u0432\u043C\u0438\u043A\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018256
    m_Localized: "\u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u044F: \u0432\u0456\u0434\u043E\u043C\u0456
      \u0421\u0442\u0456\u0439\u043B\u0430, \u043A\u043E\u0440\u043E\u0442\u043A\u0430
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F. \u0421\u043E\u0440\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0444\u0430\u0439\u043B\u0456\u0432 \u0437\u0430 \u0430\u043B\u0444\u0430\u0432\u0456\u0442\u043D\u0438\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C.\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      0, \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u044F:
      \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454.
      \u041F\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u0424\u0456\u043B\u043B\u0456\u0434\u0435\u043B\u044C\u0444\u0456\u0439\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      1, \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442: \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E.
      \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      2, \u041F\u043E\u043D\u0456\u0432\u0456\u043B\u043B\u044C: \u0437\u0430\u043A\u0440\u0438\u0442\u0435.
      \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0432\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      3, \u0417\u0435\u0431\u0440\u0430\u0442\u0430\u0443\u043D: \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454.
      \u0417\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      6, \u041A\u0440\u0438\u0448\u0442\u0430\u043B\u0435\u0432\u0456 \u0433\u043E\u0440\u0438:
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      12, \u0422\u0440\u043E\u0442\u0442\u0456\u043D\u0445\u0435\u043C: \u043D\u0435
      \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454. \u041D\u0435
      \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u043E;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      20, \u041D\u044C\u044E-\u041F\u0435\u0433\u0430\u0441\u0443\u0441: \u043D\u0435
      \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454. \u0417\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0435
      \u0439 \u043E\u043A\u0443\u043F\u043E\u0432\u0430\u043D\u043E \u0440\u0435\u0439\u0434\u0435\u0440\u0430\u043C\u0438;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      29, \u0424\u0435\u0442\u043B\u043E\u043A: \u0437\u0430\u043A\u0440\u0438\u0442\u043E.
      \u0412\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      40, \u0421\u0442\u0430\u043B\u043B\u0456\u043E\u043D\u0433\u0440\u0430\u0434:
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0432\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      49, \u0412\u0430\u043D\u0445\u0443\u0432\u0435\u0440: \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454.
      \u0421\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      55, \u043F\u0440\u0438\u043A\u043E\u0440\u0434\u043E\u043D\u043D\u044F \u0437
      \u041A\u043E\u0440\u043E\u043B\u0456\u0432\u0441\u0442\u0432\u043E\u043C \u0413\u0440\u0438\u0444\u043E\u043D\u0456\u0432:
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0432\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      65, \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u0456 \u0432\u043E\u0434\u043E\u0441\u043F\u0430\u0434\u0438:
      \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454.
      \u041F\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u041D\u0435\u0439\u0433\u0430\u0440\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432;\n\t\u0421\u0442\u043E\u0439\u043B\u043E
      67, \u0424\u0456\u043B\u043B\u0438\u0434\u0435\u043B\u044C\u0444\u0438\u044F:
      \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454.
      \u0417\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      77, \u041A\u043E\u043B\u044C\u0442\u0447\u0435\u0441\u0442\u0435\u0440: \u0437\u0430\u043A\u0440\u0438\u0442\u043E.
      \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0432\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      88, \u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441: \u043D\u0435
      \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454. \u041D\u0435
      \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      93, \u0424\u0456\u043B\u043B\u0438\u0434\u0435\u043B\u044C\u0444\u0438\u044F:
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      96, \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u0456 \u043F\u0443\u0441\u0442\u043A\u0438:
      \u043D\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454.
      \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E, \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u0435;"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018257
    m_Localized: "\u0421\u0442\u0456\u0439\u043B\u043E 99, \u0425\u0443\u0444\u0444\u0456\u043D\u0433\u0442\u043E\u043D:
      \u0437\u0430\u043A\u0440\u0438\u0442\u043E. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0432\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      102, \u041A\u0430\u043B\u0435\u0434\u043E\u043D\u0456\u044F: \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E.
      \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u0432\u0438\u043C\u0435\u0440\u043B\u0435;\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456, \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0435: \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0435. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0435.\n\t\u0421\u0442\u0456\u0439\u043B\u043E
      \u0421\u043E\u043B\u044F\u0440\u0456\u0441, \u0422\u0440\u0430\u0441\u0430
      52: \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0432\u0438\u043C\u0435\u0440\u043B\u0435."
