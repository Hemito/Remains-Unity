      m_Items: []
  - m_Id: 2742018207
    m_Localized: "*\u041A\u043E\u043C\u0443: \u0421\u043A\u0430\u0440\u043B\u0435\u0442
      \u0421\u0442\u043E\u0443\u043D. \u041B\u0438\u0441\u0442 \u043D\u0430\u0434\u0456\u0441\u043B\u0430\u043D\u043E:
      74975 \u0434\u043D\u0456\u0432 \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      (re) \u0442\u0435\u0440\u043C\u0456\u043D\u0438.*\n\t\"\u0411\u043B\u0456\u043D,
      \u043F\u043E\u0434\u0440\u0443\u0433\u043E, \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439
      \u0442\u0438 \u0442\u0430\u043A! \u041D\u0435 \u0442\u0440\u0435\u0431\u0430,
      \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F. \u0423 \u043D\u0430\u0441
      \u0432\u0441\u0435 \u043F\u0443\u0447\u043A\u043E\u043C. \u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u044F \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043E\u0441\u0442\u0430\u043D\u043D\u0456
      \u0448\u0442\u0440\u0438\u0445\u0438 \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457
      \u0456 \u0439\u0442\u0438 \u0434\u043E \u0442\u0435\u0431\u0435 \u0434\u043E\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438.
      \u0423\u0441\u0435 \u0433\u043E\u0442\u043E\u0432\u043E! \u041C\u0430\u0442\u0435\u0440\u0456\u0430\u043B
      \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454
      \u0432\u0438\u043C\u043E\u0433\u0430\u043C \u0437\u0430\u043C\u043E\u0432\u043D\u0438\u043A\u0430,
      \u043F\u0440\u044F\u043C \u0442\u044E\u0442\u0435\u043B\u044C\u043A\u0430 \u0432
      \u0442\u044E\u0442\u0435\u043B\u044C\u043A\u0443. \u041C\u043E\u0436\u0435\u0448
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0440\u0430\u0437 \u0434\u0437\u0432\u043E\u043D\u0438\u0442\u0438
      \u0446\u0438\u043C \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u0448\u0438\u0448\u043A\u0430\u043C
      \u0456 \u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u043D\u0430 \u043E\u0433\u043B\u044F\u0434\u0438\u043D\u0438
      \u043D\u0430\u0448\u043E\u0457 \u043A\u0440\u0438\u0445\u0456\u0442\u043A\u0438,
      \u0431\u043E \u044F\u043A\u0449\u043E \u0446\u0435 \u0437\u0440\u043E\u0431\u043B\u044E
      \u044F, \u0432\u043E\u043D\u0438 \u043F\u0440\u0438\u043F\u043E\u0432\u0437\u0443\u0442\u044C
      \u0434\u043E \u0442\u0435\u0431\u0435 \u0432\u0438\u0431\u0430\u0447\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u043A\u043E\u043B\u0456\u043D\u0430\u0445! \u0422\u0440\u0435\u0431\u0430
      \u0436, \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430 \u043D\u0430\u0448\u043E\u0433\u043E
      \u043B\u044F\u043A\u0430\u0442\u0438 \u043D\u0430\u0434\u0443\u043C\u0430\u043B\u0438.
      \u042F \u0457\u0445 \u0441\u0430\u043C\u0430 \u044F\u043A \u0437\u0430\u0445\u043E\u0447\u0435\u0448
      \u043D\u0430\u043B\u044F\u043A\u0430\u044E. \u042F \u043F\u0456\u0434\u0456\u0439\u0434\u0443
      \u0434\u043E \u0442\u0435\u0431\u0435 \u0437\u0430 \u0433\u043E\u0434\u0438\u043D\u0443,
      \u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018208
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u0446\u044C\u043A\u0438\u0439
      \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A \u041F\u0440\u0430\u0443\u0434
      \u041F\u0430\u044F \u0412\u0456\u0434\u0442\u043E\u0434\u0456, \u044F\u043A
      \u043D\u0430\u0441 \u0437\u0430\u043C\u043A\u043D\u0443\u043B\u0438 \u0442\u0443\u0442
      \u043F\u0456\u0441\u043B\u044F \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0437\u0435\u0431\u0440\u0430\u043C\u0438 \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C,
      \u044F \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u043D\u0435 \u0431\u0430\u0447\u0438\u0432 \u0441\u043E\u043D\u044F\u0447\u043D\u043E\u0433\u043E
      \u0441\u0432\u0456\u0442\u043B\u0430. \u0422\u0430\u043A\u0430 \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u044F,
      \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F \u0431. \u0410\u043B\u0435
      \u0437 \u043A\u043E\u0436\u043D\u0438\u043C \u043C\u0456\u0441\u044F\u0446\u0435\u043C
      \u044F \u0432\u0441\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0441\u0443\u043C\u0443\u044E
      \u0437\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0435\u044E. \u0429\u043E
      \u0443 \u043D\u0430\u0441 \u0442\u0443\u0442 \u0454 \u0432\u0437\u0430\u0433\u0430\u043B\u0456,
      \u043F\u0430\u0440\u043E\u0447\u043A\u0430 \u0441\u0430\u0434\u0456\u0432?
      \u0423 \u043D\u0438\u0445 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0440\u043E\u0441\u043B\u043E \u0431 \u043D\u0456\u0447\u043E\u0433\u043E,
      \u044F\u043A\u0431\u0438 \u043D\u0435 \u043C\u0430\u0433\u0456\u044F \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432
      \u0456\u0437 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443. \u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
      \u0431, \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0435
      \u0421\u0442\u0456\u0439\u043B\u043E. \u0410\u043B\u0435 \u043D\u0456\u0445\u0442\u043E
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u0432
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u043F\u043E\u043D\u0456 \u0442\u0443\u0442
      \u0436\u0438\u0442\u0438\u043C\u0443\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u043E\u043A\u0456\u0432. \u042F\u043A\u0449\u043E \u043D\u0435 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0456\u0442\u0442\u044F.
      \u041D\u0456\u0456\u0456\u0456, \u043C\u0438 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C\u043E
      \u0436\u0438\u0442\u0438 \u0442\u0443\u0442 \u0442\u0430\u043A \u0434\u043E\u0432\u0433\u043E.
      \u0422\u0430\u043A\u043E\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438. \u042F\u043A \u0431\u0438 \u0442\u0430\u043C \u043D\u0435
      \u0431\u0443\u043B\u043E, \u0440\u043E\u0431\u043E\u0442\u0430 \u0442\u0440\u0438\u0432\u0430\u0454.
      \u041D\u0435\u0445\u0430\u0439 \u043C\u0438 \u0439 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0456
      \u0442\u0443\u0442, \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E,
      \u043C\u0438 \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0456\u0434\u0432\u043E\u044E\u0432\u0430\u0442\u0438
      \u043D\u0430\u0448\u0443 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E
      \u043D\u0430\u0437\u0430\u0434. \u0406 \u044F\u043A\u0449\u043E \u043C\u0438
      \u0445\u043E\u0447\u0435\u043C\u043E \u0446\u044C\u043E\u0433\u043E \u0434\u043E\u0441\u044F\u0433\u0442\u0438,
      \u043D\u0430\u043C \u0442\u0443\u0442 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E \u0437\u0440\u043E\u0431\u0438\u0442\u0438.
      \u041C\u0435\u043D\u0435 \u043D\u0456\u0449\u043E \u043D\u0435 \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u044E\u0454
      \u0442\u0430\u043A, \u044F\u043A \u0443\u0441\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u0441\u0432\u043E\u0457\u0445 \u0432\u0438\u0434\u0430\u0442\u043D\u0438\u0445
      \u0437\u043D\u0430\u043D\u044C \u0456 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439
      \u0434\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0457
      \u0440\u043E\u0431\u043E\u0442\u0438. \u0414\u043E\u0441\u0438\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u043E
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438 \u0434\u0435\u043D\u044C
      \u0437\u0430 \u0434\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018209
    m_Localized: "\u0412\u0434\u0430\u043B\u043E\u0441\u044F \u0434\u043E\u0441\u044F\u0433\u0442\u0438
      \u043F\u043E\u043C\u0456\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0443
      \u0432 \u043F\u0440\u043E\u0454\u043A\u0442\u0456. \u0422\u0443\u0442, \u0443
      \u0421\u0442\u0456\u0439\u043B\u0456, \u043C\u0438 \u0441\u0438\u043B\u044C\u043D\u043E
      \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0456 \u0432 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u0445,
      \u0430\u043B\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u0443 \u0442\u0430\u043A\u0438\u0445
      \u0443\u043C\u043E\u0432\u0430\u0445 \u044F \u0440\u043E\u0431\u043B\u044E
      \u0443\u0441\u043F\u0456\u0445\u0438. \u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u0440\u043E\u0437\u0432\u0438\u043D\u0443\u0442\u0438 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456
      \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432 \u0434\u043E
      \u0441\u0430\u043C\u043E\u043D\u0430\u0432\u0447\u0430\u043D\u043D\u044F. \u0428\u043B\u044F\u0445\u043E\u043C
      \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F
      \u043E\u0431\u0441\u044F\u0433\u0443 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0441\u0442\u0440\u043E\u043A\u043E\u0432\u043E\u0457
      \u043F\u0430\u043C'\u044F\u0442\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u043D\u0430\u0432\u0447\u0438\u0442\u0438 \u043C\u0430\u0448\u0438\u043D\u0443
      \u0432\u0435\u0441\u0442\u0438 \u043C\u0430\u0439\u0436\u0435 \u0441\u0432\u0456\u0434\u043E\u043C\u0438\u0439
      \u0434\u0456\u0430\u043B\u043E\u0433 \u0456\u0437 \u0436\u0438\u0432\u0438\u043C
      \u043F\u043E\u043D\u0456 \u0442\u0430 \u0437\u0430\u043F\u0430\u043C'\u044F\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E \u0432\u043F\u043E\u0434\u043E\u0431\u0430\u043D\u043D\u044F.
      \u0417\u0430\u043F\u0430\u043C'\u044F\u0442\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F
      \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u043A\u043E\u0440\u0435\u043A\u0442\u043D\u043E,
      \u0430\u043B\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044F
      \u0446\u0456\u0454\u0457 \u043F\u0440\u0438\u043A\u0440\u043E\u0457 \u043F\u043E\u0445\u0438\u0431\u043A\u0438
      - \u0441\u043F\u0440\u0430\u0432\u0430 \u0447\u0430\u0441\u0443. \u041E\u0434\u043D\u0430\u043A
      \u043D\u0435 \u0432\u0441\u0456 \u0442\u0430\u043A\u0456 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u0456,
      \u044F\u043A \u044F. \u0427\u0435\u0440\u0435\u0437 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0447\u0430\u0441\u0443 \u043D\u0430\u0448 \u0432\u0456\u0434\u0434\u0456\u043B
      \u0437\u0432'\u044F\u0437\u043A\u0443 \u0434\u043E\u0441\u0456 \u043D\u0435
      \u0437\u043C\u0456\u0433 \u043D\u0430\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0437 \u0436\u043E\u0434\u043D\u0438\u043C
      \u0456\u0437 \u041D\u0414\u0406 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456.
      \u0417 \u0456\u043D\u0448\u0438\u043C\u0438 \u0421\u0442\u043E\u0439\u043B\u0430\u043C\u0438
      - \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0430\u043B\u0435
      \u043D\u0435 \u0437 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0454\u044E.
      \u042F \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0449\u043E \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044F
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0430 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C,
      \u0430\u043B\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435 \u0436 \u0431\u0443\u0442\u0438
      \u0442\u0430\u043A\u043E\u0433\u043E, \u0449\u043E\u0431 \u043F\u0440\u044F\u043C\u043E
      \u0432\u0441\u0435 \u0431\u0443\u043B\u043E \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u043E.
      \u041D\u0456\u0441\u0435\u043D\u0456\u0442\u043D\u0438\u0446\u044F. \u0425\u0442\u043E\u0441\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0430\u0440\u0435\u043C\u043D\u043E
      \u043F\u0440\u043E\u0457\u0434\u0430\u0454 \u0441\u0432\u043E\u0454 \u0441\u0456\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018210
    m_Localized: "\u0429\u0435 \u043E\u0434\u0438\u043D \u043C\u0456\u0441\u044F\u0446\u044C
      \u043F\u0440\u043E\u0436\u0438\u0442\u043E \u0434\u0430\u0440\u0435\u043C\u043D\u043E.
      \u0414\u0430\u0440\u043C\u043E\u0457\u0434\u0430\u043C \u0437 \u0432\u0456\u0434\u0434\u0456\u043B\u0443
      \u0437\u0432'\u044F\u0437\u043A\u0443 \u0442\u0430\u043A \u0456 \u043D\u0435
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0432'\u044F\u0437\u0430\u0442\u0438\u0441\u044F
      \u043D\u0456 \u0437 \u043A\u0438\u043C, \u0430 \u0414\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u0430
      \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u0454 \u0432 \u043A\u043E\u0436\u043D\u043E\u043C\u0443
      \u043C\u043E\u0454\u043C\u0443 \u043F\u0440\u043E\u0445\u0430\u043D\u043D\u0456
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u0434\u0440\u043E\u0457\u0434\u0456\u0432-\u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432
      \u0443 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0439 \u0441\u0432\u0456\u0442.
      \u0427\u043E\u043C\u0443, \u0446\u0456\u043A\u0430\u0432\u043E? \u041E\u0441\u043E\u0431\u0438\u0441\u0442\u043E
      \u044F \u043D\u0435 \u0431\u0430\u0447\u0443 \u0436\u043E\u0434\u043D\u043E\u0457
      \u043B\u043E\u0433\u0456\u0447\u043D\u043E\u0457 \u043F\u0440\u0438\u0447\u0438\u043D\u0438
      \u043D\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0446\u044C\u043E\u0433\u043E.
      \u0417\u0443\u043C\u0456\u0432 \u043F\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438
      \u0432\u0441\u0456\u0445 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432
      \u0434\u043E \u0454\u0434\u0438\u043D\u043E\u0433\u043E \u0431\u0430\u043D\u043A\u0443
      \u0434\u0430\u043D\u0438\u0445 \u0421\u0442\u0456\u0439\u043B\u0430. \u0417\u0430\u0440\u0430\u0434\u0438
      \u0446\u044C\u043E\u0433\u043E \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F
      \u0437\u0430\u0431\u0440\u0430\u0442\u0438 \u0434\u0435\u044F\u043A\u0456 \u0434\u0435\u0442\u0430\u043B\u0456
      \u0437 \u0443\u043B\u044C\u0442\u0440\u0430-\u0432\u0430\u0440\u0442\u043E\u0432\u0438\u0445,
      \u0430\u043B\u0435 \u043D\u0430\u0447\u0435 \u043D\u0430\u043C \u0431\u0443\u043B\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0446\u0438\u0445 \u043D\u0435\u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043A\u0438\u0445
      \u0432\u0435\u043B\u0435\u0442\u043D\u0456\u0432. \u0423 \u0442\u0456\u0441\u043D\u0438\u0445
      \u0441\u0442\u0456\u043D\u0430\u0445 \u0421\u0442\u043E\u0439\u043B\u0430 \u0432\u0456\u0434
      \u043D\u0438\u0445 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438,
      \u043D\u0456\u0436 \u043A\u043E\u0440\u0438\u0441\u0442\u0456. \u0410 \u043E\u0441\u044C
      \u0434\u043E\u0441\u0442\u0443\u043F \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432
      \u0434\u043E \u0431\u0430\u043D\u043A\u0443 \u0434\u0430\u043D\u0438\u0445
      \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u044C \u0457\u0445
      \u0443\u0441\u0456\u0454\u044E \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E\u044E
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E \u0432 \u043E\u043D\u043B\u0430\u0439\u043D
      \u0440\u0435\u0436\u0438\u043C\u0456. \u0411\u0435\u0437\u0446\u0456\u043D\u043D\u0435
      \u0432\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018211
    m_Localized: "\u0423 \u0421\u0442\u043E\u0439\u043B\u0456 \u0437\u0440\u0456\u0454
      \u0437\u043C\u043E\u0432\u0430. \u0426\u0456 \u043D\u0435\u0437\u0434\u0430\u0440\u0438
      \u0437\u0430\u0437\u0434\u0440\u044F\u0442\u044C \u0442\u0438\u043C \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u044C\u043E\u043C
      \u0456\u0441\u0442\u0438\u043D\u043D\u043E \u0442\u0430\u043B\u0430\u043D\u043E\u0432\u0438\u0442\u0438\u043C
      \u043F\u043E\u043D\u0456, \u0449\u043E \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0456
      \u0442\u0443\u0442, \u0456 \u0441\u043A\u043E\u0432\u0443\u044E\u0442\u044C
      \u0457\u0445\u043D\u044E \u0440\u043E\u0431\u043E\u0442\u0443 \u0432\u0441\u0456\u043C\u0430
      \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438. \u0412 \u043E\u0431\u043B\u0438\u0447\u0447\u044F
      \u0432\u043E\u043D\u0438 \u043F\u043E\u0441\u043C\u0456\u0445\u0430\u044E\u0442\u044C\u0441\u044F
      \u0456 \u043E\u0431\u0456\u0446\u044F\u044E\u0442\u044C \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0432\u0441\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u0435, \u0430 \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u044E \u043F\u043B\u0435\u0442\u0443\u0442\u044C
      \u0441\u0432\u043E\u0457 \u0456\u043D\u0442\u0440\u0438\u0433\u0438 \u0456
      \u043F\u043B\u0430\u043D\u0443\u044E\u0442\u044C \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u0456.
      \u042F\u043A \u044F \u043E\u0434\u0440\u0430\u0437\u0443 \u043D\u0435 \u0437\u0434\u043E\u0433\u0430\u0434\u0430\u0432\u0441\u044F
      \u0434\u043E \u0446\u044C\u043E\u0433\u043E. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E
      \u043F\u043E\u043D\u0456 \u0431\u0435\u0437\u0434\u0430\u0440, \u0442\u043E
      \u0432\u0456\u043D \u0431\u0435\u0437\u0434\u0430\u0440\u043D\u0438\u0439 \u0443
      \u0432\u0441\u044C\u043E\u043C\u0443. \u041F\u043E\u043F\u0440\u0438 \u0432\u0441\u0456
      \u0437\u0443\u0441\u0438\u043B\u043B\u044F, \u0446\u0456 \u043A\u0440\u043E\u0432\u043E\u043F\u0438\u0432\u0446\u0456
      \u043D\u0435 \u0437\u0430\u0432\u0430\u0434\u0438\u043B\u0438 \u043C\u0435\u043D\u0456
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u0443.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u0443 \u0442\u0430\u043A\u0438\u0445
      \u0443\u043C\u043E\u0432\u0430\u0445 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
      \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0441\u0430\u043C\u043E\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044E \u0448\u0442\u0443\u0447\u043D\u0443
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0456\u0441\u0442\u044C. \u041E\u0434\u043D\u0430\u043A
      \u044F \u0437\u0443\u043C\u0456\u0432 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443, \u044F\u043A\u0430 \u0456\u043C\u0456\u0442\u0443\u0454
      \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C \u043F\u043E\u043D\u0456
      \u0437 \u043C\u0430\u0439\u0436\u0435 \u0441\u0442\u043E\u0432\u0456\u0434\u0441\u043E\u0442\u043A\u043E\u0432\u043E\u044E
      \u0456\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u0456\u0441\u0442\u044E. \u042F
      \u043D\u0430\u0437\u0432\u0430\u0432 \u0457\u0457 \u0421\u0432\u0456\u0442\u0456
      \u041A\u0435\u0439\u043A, \u0456 \u0432\u043E\u043D\u0430 \u0431\u0443\u0434\u0435
      \u043C\u043E\u0457\u043C \u043F\u0435\u0440\u0448\u0438\u043C \u0456 \u0454\u0434\u0438\u043D\u0438\u043C
      \u0434\u043E\u0432\u0456\u0440\u0435\u043D\u0438\u043C \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u043E\u043C.
      \u0417\u0430\u0440\u0430\u0437 \u043C\u0435\u043D\u0456 \u044F\u043A \u043D\u0456\u043A\u043E\u043B\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u043F\u043E\u043D\u0456,
      \u044F\u043A\u0438\u0439 \u0437\u043C\u043E\u0436\u0435 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0443 \u0432\u0441\u0456\u0439 \u0446\u0456\u0439 \u043F\u0430\u0432\u0443\u0442\u0438\u043D\u0456
      \u0431\u0440\u0435\u0445\u043D\u0456. \u0422\u043E\u043C\u0443 \u044F \u043D\u0430\u0434\u0456\u043B\u0438\u0432
      \u0421\u0432\u0456\u0442\u0456 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0456\u0441\u0442\u044E
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437 \u043D\u0430\u0439\u0432\u0438\u0434\u0430\u0442\u043D\u0456\u0448\u0438\u0445
      \u043A\u043E\u043D\u0442\u0440\u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432
      \u0441\u0443\u0447\u0430\u0441\u043D\u043E\u0441\u0442\u0456, \u0433\u043E\u043B\u043E\u0432\u0438
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u041C\u043E\u0440\u0430\u043B\u0456
      \u041F\u0456\u043D\u043A\u0456 \u041F\u0430\u0439. \u0411\u043B\u0430\u0433\u043E
      \u0432\u0441\u0456 \u0434\u0430\u043D\u0456 \u043F\u0440\u043E \u043D\u0435\u0457
      \u0431\u0443\u043B\u0438 \u0432 \u0431\u0430\u0437\u0456 \u0434\u0430\u043D\u0438\u0445.
      \u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F, \u0449\u043E
      \u0432\u0438 \u0441\u043A\u0430\u0436\u0435\u0442\u0435 \u0442\u0435\u043F\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018212
    m_Localized: "\u0427\u0430\u0441 \u0440\u043E\u0437\u043F\u043B\u0430\u0442\u0438
      \u043D\u0430\u0431\u043B\u0438\u0436\u0430\u0454\u0442\u044C\u0441\u044F. \u0421\u0432\u0456\u0442\u0456
      \u041A\u0435\u0439\u043A \u0432\u0438\u043A\u043E\u043D\u0430\u043B\u0430 \u0432\u0435\u043B\u0438\u043A\u0443
      \u0440\u043E\u0431\u043E\u0442\u0443 \u043D\u0430\u0434 \u0432\u0438\u0432\u0447\u0435\u043D\u043D\u044F\u043C
      \u0443\u0441\u0456\u0445 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432
      \u0421\u0442\u0456\u0439\u043B\u0430 88, \u0456 \u0441\u043A\u043E\u0440\u043E
      \u0432\u043E\u043D\u0430 \u0432\u0438\u043D\u0435\u0441\u0435 \u0441\u0432\u0456\u0439
      \u0432\u0435\u0440\u0434\u0438\u043A\u0442. \u0425\u0442\u043E \u0448\u043A\u0456\u0434\u043D\u0438\u043A,
      \u0430 \u0445\u0442\u043E \u0447\u0435\u0441\u043D\u0438\u0439 \u0442\u0440\u0443\u0434\u0456\u0432\u043D\u0438\u043A,
      \u0445\u0442\u043E \u0448\u043F\u0438\u0433\u0443\u043D, \u0430 \u0445\u0442\u043E
      \u0432\u0456\u0440\u043D\u0438\u0439 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.
      \u0423\u0441\u0456 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0438
      \u043E\u0442\u0440\u0438\u043C\u0430\u044E\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A
      \u0456 \u043F\u0440\u043E\u0432\u0435\u0434\u0443\u0442\u044C \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0443
      \u0442\u0430 \u043E\u0431\u0448\u0443\u043A\u0438 \u043D\u0430 \u043C\u0456\u0441\u0446\u044F\u0445.
      \u042F \u043D\u0435 \u0437\u0432\u0456\u0440, \u043D\u0456\u043A\u043E\u0433\u043E
      \u043D\u0435 \u0441\u0442\u0440\u0430\u0442\u044F\u0442\u044C \u0456 \u043D\u0435
      \u0437\u0430\u043C\u0443\u0447\u0430\u0442\u044C. \u0410\u043B\u0435 \u0449\u043E\u0439\u043D\u043E
      \u0432\u0441\u0456 \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u043D\u0438\u043A\u0438
      \u043E\u043F\u0438\u043D\u044F\u0442\u044C\u0441\u044F \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0438\u043C\u0438
      \u0432 \u043A\u0430\u0440\u0446\u0435\u0440\u0456, \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456
      \u043F\u0430\u0442\u0440\u0456\u043E\u0442\u0438 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457
      \u0437\u043C\u043E\u0436\u0443\u0442\u044C \u0432\u0434\u0438\u0445\u043D\u0443\u0442\u0438
      \u043D\u0430 \u043F\u043E\u0432\u043D\u0456 \u0433\u0440\u0443\u0434\u0438
      \u0456 \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u0432\u0438\u0442\u044F\u0433\u0442\u0438
      \u043D\u0430\u0441 \u0443\u0441\u0456\u0445 \u0456\u0437 \u0446\u0456\u0454\u0457
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0457 \u0437\u0430\u043B\u0456\u0437\u043D\u043E\u0457
      \u043A\u043E\u0440\u043E\u0431\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018213
    m_Localized: "\u041F\u0430\u0440\u0430\u043C-\u043F\u0430\u043C. \u041F\u0430\u043C-\u043F\u0430\u043C-\u043F\u0430\u0440\u0430\u043C.
      \u041F\u0430\u0440\u0430\u0440\u0430\u043C.\n\t\u0417\u0430\u0432\u0436\u0434\u0438
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454, \u043A\u043E\u043B\u0438
      \u043D\u0435 \u0437\u043D\u0430\u0454\u0448, \u0437 \u0447\u043E\u0433\u043E
      \u043F\u043E\u0447\u0430\u0442\u0438. \u0422\u0430 \u0439 \u0443\u0441\u0435
      \u043E\u0434\u043D\u043E \u044F \u043D\u0435 \u0434\u0430\u043C \u043D\u0456\u043A\u043E\u043C\u0443
      \u0447\u0438\u0442\u0430\u0442\u0438 \u0446\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0440\u0435\u0431\u0430 \u0432\u0438\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438\u0441\u044F
      \u0456 \u0432\u0441\u0435. \u0421\u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0441\u044C\u043E\u0433\u043E
      \u0441\u0442\u0430\u043B\u043E\u0441\u044F \u0437\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u0447\u0430\u0441. \u0410\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043E\u0434\u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043C\u0430\u0454
      \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F. \u041C\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0434\u0456\u043C. \u041C\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E. \u0423\u0441\u0456
      \u0432 \u0421\u0442\u043E\u0439\u043B\u0456, \u043A\u043E\u0436\u0435\u043D
      \u043F\u043E\u043D\u0456 \u0437\u0430\u0440\u0430\u0437 \u0436\u0438\u0432\u0435
      \u0437 \u0446\u0456\u0454\u044E \u0434\u0443\u043C\u043A\u043E\u044E. \u041A\u043E\u043C\u0443\u0441\u044C
      \u043B\u0435\u0433\u0448\u0435, \u043A\u043E\u043C\u0443\u0441\u044C \u0433\u0456\u0440\u0448\u0435.
      \u0411\u0456\u0434\u043E\u043B\u0430\u0445\u0430 \u0415\u043F\u043B \u0428\u0443\u0433\u0430\u0440,
      \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0443\u0437\u0430\u0433\u0430\u043B\u0456
      \u0437\u0456\u0440\u0432\u0430\u0432\u0441\u044F \u0456 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0432
      \u0432\u0438\u0431\u0440\u0430\u0442\u0438\u0441\u044F \u043D\u0430\u0437\u043E\u0432\u043D\u0456.
      \u0422\u0430\u043C \u0437\u0430\u0440\u0430\u0437 \u0441\u043C\u0435\u0440\u0442\u044C,
      \u0437\u0430 \u0434\u0432\u0435\u0440\u0438\u043C\u0430. \u0426\u0435 \u0440\u0456\u0436\u0435
      \u0441\u0435\u0440\u0446\u0435 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435.\n\t\u0423
      \u044F\u043A\u0438\u0439\u0441\u044C \u043C\u043E\u043C\u0435\u043D\u0442 \u0442\u043E\u0431\u0456
      \u0445\u043E\u0447\u0435\u0442\u044C\u0441\u044F \u043A\u0440\u0438\u0447\u0430\u0442\u0438,
      \u0430 \u0437\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u0445\u0432\u0438\u043B\u0438\u043D
      \u0442\u0438 \u043B\u0435\u0436\u0438\u0448 \u043D\u0430 \u043B\u0456\u0436\u043A\u0443
      \u0456 \u0442\u0443\u043F\u043E \u0434\u0438\u0432\u0438\u0448\u0441\u044F
      \u0432 \u0441\u0442\u0456\u043D\u0443 \u0431\u0435\u0437 \u0436\u043E\u0434\u043D\u043E\u0457
      \u0434\u0443\u043C\u043A\u0438. \u041D\u0435\u043C\u0430\u0454 \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0456\u0457
      \u0449\u043E\u0441\u044C \u0440\u043E\u0431\u0438\u0442\u0438. \u042F \u0437\u043C\u0443\u0448\u0443\u044E
      \u0441\u0435\u0431\u0435 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u043E\u043C\u0443, \u0449\u043E
      \u043F\u043E\u043A\u0438 \u044F \u0437\u0430\u0439\u043D\u044F\u0442\u0430,
      \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u0435 \u0443\u0441\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u043A\u0456\u043D\u0446\u044F \u0441\u0432\u0456\u0442\u0443 \u0432\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C
      \u043D\u0430 \u0437\u0430\u0434\u043D\u0456\u0439 \u043F\u043B\u0430\u043D,
      \u043F\u043E\u0433\u043B\u0438\u043D\u0430\u044E\u0447\u0438\u0441\u044C \u0434\u0443\u043C\u043A\u0430\u043C\u0438
      \u043F\u0440\u043E \u043D\u0430\u0433\u0430\u043B\u044C\u043D\u0456 \u0441\u043F\u0440\u0430\u0432\u0438.
      \u041C\u0435\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0435 \u0449\u0435
      \u0439 \u0442\u043E\u043C\u0443, \u0449\u043E \u0442\u0430\u043C, \u0437\u0430
      \u0434\u0432\u0435\u0440\u0438\u043C\u0430, \u043D\u0435 \u0431\u0443\u043B\u043E
      \u043D\u0456\u043A\u043E\u0433\u043E, \u0445\u0442\u043E \u0431\u0443\u0432
      \u043C\u0435\u043D\u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0434\u043E\u0440\u043E\u0433\u0438\u0439.
      \u041C\u0456\u0439 \u0431\u0440\u0430\u0442 \u0442\u0443\u0442, \u043C\u043E\u044F
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430 \u043F\u043E\u0434\u0440\u0443\u0433\u0430
      \u0442\u0435\u0436. \u0410\u043B\u0435 \u043C\u0438 \u043F\u043E\u043A\u0438
      \u0449\u043E \u043D\u0435 \u0441\u043F\u0456\u043B\u043A\u0443\u0454\u043C\u043E\u0441\u044F.
      \u041D\u0456\u0445\u0442\u043E \u043D\u0435 \u0441\u043F\u0456\u043B\u043A\u0443\u0454\u0442\u044C\u0441\u044F.
      \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u043C\u0438 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0438\u0441\u044F
      \u0437\u0430\u0439\u043D\u044F\u0442\u0438 \u0447\u0430\u0441 \u0437\u0430
      \u0432\u0435\u0441\u0435\u043B\u043E\u0449\u0430\u043C\u0438, \u0456\u0433\u0440\u0430\u043C\u0438
      \u0456 \u043F\u0456\u0441\u043D\u044F\u043C\u0438, \u0430\u043B\u0435 \u0432\u0456\u0434
      \u0446\u044C\u043E\u0433\u043E \u043D\u0430 \u0434\u0443\u0448\u0456 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0433\u0456\u0440\u0448\u0435. \u0414\u0438\u0432\u0438\u0448\u0441\u044F
      \u043D\u0430 \u0446\u0456 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0456
      \u0441\u0442\u0456\u043D\u0438 \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u0456
      \u0434\u0443\u043C\u0430\u0454\u0448 \u043F\u0440\u043E \u0442\u0435, \u0449\u043E
      \u0446\u0435 \u0432\u0441\u0435, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0432\u0456\u0434 \u0441\u0432\u0456\u0442\u0443. \u0423\u0441\u0435, \u0449\u043E
      \u044F \u043A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C \u0437\u043D\u0430\u043B\u0430,
      \u0443\u0441\u044C\u043E\u0433\u043E \u0446\u044C\u043E\u0433\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E... \u043D\u0435\u043C\u0430\u0454. \u0423\u0441\u0435
      \u0437\u043D\u0438\u043A\u043B\u043E, \u0437\u0433\u043E\u0440\u0456\u043B\u043E,
      \u0437\u0430\u043B\u0438\u0448\u0438\u0432\u0448\u0438 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0447\u043E\u0440\u043D\u0438\u0439 \u043F\u043E\u043F\u0456\u043B \u0456
      \u043E\u0431\u0432\u0443\u0433\u043B\u0435\u043D\u0456 \u0441\u043A\u0435\u043B\u0435\u0442\u0438.
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F? \u041B\u0443\u043D\u0430?
      \u0425\u0442\u043E \u0437\u043D\u0430\u0454, \u0432\u043E\u043D\u0438 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u0436\u0438\u0432\u0456 \u0437\u0430\u0440\u0430\u0437? \u0427\u043E\u043C\u0443
      \u0432\u043E\u043D\u0438 \u043D\u0435 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u043B\u0438
      \u043D\u0430\u0441? \u041D\u0435\u0432\u0436\u0435 \u043C\u0438, \u043F\u043E\u043D\u0456,
      \u0434\u043E\u0432\u0435\u043B\u0438 \u0432\u0441\u0435 \u0434\u043E \u0442\u0430\u043A\u043E\u0457
      \u043C\u0456\u0440\u0438, \u0449\u043E \u043D\u0430\u0432\u0456\u0442\u044C
      \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0438 \u0431\u0443\u043B\u0438 \u0431\u0435\u0437\u0441\u0438\u043B\u0456?
      \u0429\u043E\u0439\u043D\u043E \u0432 \u0433\u043D\u0456\u0432\u0456 \u0437\u043B\u0430\u043C\u0430\u043B\u0430
      \u0441\u0442\u0456\u043B\u0435\u0446\u044C \u043E\u0431 \u0441\u0442\u0456\u043D\u0443.
      \u041D\u0456, \u0446\u0435 \u0442\u0435\u0436 \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454.
      \u0422\u0430 \u043F\u0456\u0448\u043B\u043E \u0432\u043E\u043D\u043E \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018214
    m_Localized: "\u0410\u0432\u0442\u043E\u0440\u0438\u0437\u043E\u0432\u0430\u043D\u0438\u0439
      \u0432\u0445\u0456\u0434 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E.
      \u041F\u0440\u0438\u0454\u043C\u043D\u043E\u0457 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u0414\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018215
    m_Localized: "\u0414\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u0430? \u0426\u0456\u043A\u0430\u0432\u043E,
      \u0449\u043E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0446\u0435\u0439
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018216
    m_Localized: "\u041E, \u0430 \u0442\u0443\u0442 \u0430\u0443\u0434\u0456\u043E\u0444\u0430\u0439\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018217
    m_Localized: "\u0412\u0456\u0434\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u0444\u0430\u0439\u043B\u0443 \"\u0417\u0430\u043F\u0438\u0441 \u0430\u0443\u0434\u0456\u043E\u0437\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F
      \u0432\u0456\u0446\u0435-\u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0430
      \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018218
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u043D\u044F.
      \u0417 \u0412\u0430\u043C\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0437\u0430\u0441\u043D\u043E\u0432\u043D\u0438\u0446\u044F \u0456 \u0432\u0456\u0446\u0435\u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u043A\u0430
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u0457 \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A.
      \u041C\u0435\u043D\u0435 \u0437\u0432\u0430\u0442\u0438 \u0421\u043A\u0443\u0442\u0430\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018219
    m_Localized: "\u0412\u0430\u0441 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E
      \u0414\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u043E\u044E \u0421\u0442\u0456\u0439\u043B\u0430
      88 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u0457 \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A,
      \u0421\u0442\u0456\u0439\u043B\u0430, \u044F\u043A\u0435 \u0454 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u043C
      \u0443 \u0432\u0441\u0456\u0445 \u0441\u0435\u043D\u0441\u0430\u0445. \u0412\u0430\u0441
      \u043E\u0431\u0440\u0430\u043B\u0438 \u0437\u0430 \u0432\u0456\u0434\u0434\u0430\u043D\u0456\u0441\u0442\u044C
      \u0456 \u043F\u043E\u0447\u0443\u0442\u0442\u044F \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0443
      \u044F\u043A \u0449\u043E\u0434\u043E \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0445
      \u043F\u043E\u043D\u0456, \u0442\u0430\u043A \u0456 \u0449\u043E\u0434\u043E
      \u043D\u0430\u0448\u043E\u0457 \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u0457.
      \u0406 \u043D\u0435\u0445\u0430\u0439 \u0448\u0442\u0430\u0431-\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430
      \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A, \u043C\u043E\u0436\u043B\u0438\u0432\u043E...
      \u0442\u0430 \u0439 \u0441\u043A\u043E\u0440\u0456\u0448\u0435 \u0437\u0430
      \u0432\u0441\u0435, \u0432\u0436\u0435 \u043B\u0435\u0436\u0438\u0442\u044C
      \u0443 \u0440\u0443\u0457\u043D\u0430\u0445, \u0456\u0434\u0435\u0430\u043B\u0438
      \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u0457 \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0435\u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018220
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0412\u0430\u0448\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430 \u0432
      \u0442\u043E\u043C\u0443, \u0449\u043E \u0432\u0438, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0454\u0434\u0438\u043D\u0438\u0439 \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u0446\u044C\u043A\u0438\u0439
      \u0456\u043D\u0441\u0442\u0438\u0442\u0443\u0442, \u044F\u043A\u0438\u0439
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u0432 \u0441\u0442\u0440\u043E\u044E
      \u043F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E, \u044F\u043A \u043C\u0438...
      \u043C\u0438 \u0432\u0441\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018221
    m_Localized: "\u042F\u043A\u0449\u043E \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F, \u044F\u043A\u0449\u043E
      \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456... \u0441\u0442\u0430\u043B\u043E\u0441\u044F...
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0435 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443 \u0437\u0437\u043E\u0432\u043D\u0456.
      \u0417\u0430 \u043D\u0430\u0448\u0438\u043C\u0438 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u0430\u043C\u0438,
      \u043E\u0431\u043C\u0456\u043D \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C\u0438
      \u043C\u0456\u0436 \u043D\u0430\u043C\u0438 \u0456 \u0437\u0435\u0431\u0440\u0430\u043C\u0438
      \u0431\u0443\u0434\u0435 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u043B\u044C\u043D\u0438\u043C, \u0449\u043E \u043D\u0435 \u0432\u0438\u0441\u0442\u043E\u0457\u0442\u044C
      \u0436\u043E\u0434\u0435\u043D \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u0441\u044C\u043A\u0438\u0439
      \u0446\u0435\u043D\u0442\u0440. \u041D\u0456\u0445\u0442\u043E. \u041A\u0440\u0456\u043C
      \u0421\u0442\u0456\u0439\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018222
    m_Localized: "\u0422\u043E\u043C\u0443 \u0432\u0438, \u0412\u0430\u0448\u0435
      \u0421\u0442\u0456\u0439\u043B\u043E, \u0431\u0443\u043B\u0438 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u0456
      \u0432\u0441\u0456\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u043C
      \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u043D\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0438\u0436\u0438\u0442\u0438,
      \u0430 \u0439 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u0432 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456.
      \u0406 \u0437 \u0446\u044C\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442\u0443 \u043D\u0430 \u0432\u0430\u0441
      \u043B\u044F\u0433\u0430\u0454 \u0442\u044F\u0433\u0430\u0440 \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043A\u0443
      \u0432\u0441\u0456\u0445 \u043F\u043E\u043D\u0456. \u0423\u0441\u0456\u0445,
      \u0445\u0442\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F...
      \u0437\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F \u0432... \u0422\u0430
      \u0449\u043E \u0431 \u043C\u0435\u043D\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018223
    m_Localized: "\u0412\u0438\u0431\u0430\u0447\u0442\u0435 \u043C\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018224
    m_Localized: "\u0410\u043B\u0435 \u0412\u0430\u0448\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430
      \u0432\u0436\u0435 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E.
      \u041F\u0440\u043E\u0435\u043A\u0442\u0438, \u043D\u0430\u0434 \u044F\u043A\u0438\u043C\u0438
      \u0432\u0438 \u043F\u0440\u0430\u0446\u044E\u0454\u0442\u0435, \u0432\u043E\u0456\u0441\u0442\u0438\u043D\u0443
      \u0433\u0440\u0430\u043D\u0434\u0456\u043E\u0437\u043D\u0456, \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0432\u0441\u0435 \u043F\u0456\u0434\u0435 \u0437\u0430
      \u043D\u0430\u0439\u0433\u0456\u0440\u0448\u0438\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0456\u0454\u043C,
      \u0432\u0430\u0448\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0437\u0434\u0430\u0442\u043D\u0456 \u0437\u043D\u043E\u0432\u0443 \u043F\u0456\u0434\u043D\u044F\u0442\u0438
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E \u0437 \u043F\u043E\u043F\u0435\u043B\u0443.
      \u0406 \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438 \u043D\u043E\u0432\u0438\u0439
      \u0441\u0432\u0456\u0442, \u044F\u043A\u0438\u0439 \u0431\u0443\u0434\u0435
      \u043A\u0440\u0430\u0449\u0438\u043C \u0437\u0430 \u0442\u043E\u0439, \u043D\u0430
      \u0449\u043E \u043C\u0438 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0438
      \u0441\u0432\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018225
    m_Localized: "\u0423\u0434\u0430\u0447\u0456 \u0412\u0430\u043C. \u0406 \u0434\u044F\u043A\u0443\u044E.
      \u0417\u0430 \u0432\u0441\u0435, \u0449\u043E \u0412\u0438 \u0432\u0436\u0435
      \u0437\u0440\u043E\u0431\u0438\u043B\u0438 \u0456 \u0449\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0440\u043E\u0431\u0438\u0442\u0435. \u0406 \u0445\u0430\u0439 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0432\u0441\u0435\u0432\u0438\u0448\u043D\u044F \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018226
    m_Localized: "\u0421\u0430\u043D\u0440\u0430\u0439\u0437, \u0442\u0438 \u0437\u0430\u0440\u0430\u0437,
      \u043D\u0430\u043F\u0435\u0432\u043D\u043E, \u0434\u0443\u043C\u0430\u0454\u0448,
      \u0445\u0442\u043E \u0437\u0430\u043B\u0456\u0437 \u0434\u043E \u0442\u0432\u043E\u0433\u043E
      \u0441\u0435\u0439\u0444\u0443 \u0456 \u0440\u043E\u0437\u043F\u043E\u0442\u0440\u043E\u0448\u0438\u0432
      \u0442\u0432\u043E\u044E \u0440\u043E\u0431\u043E\u0441\u043E\u0432\u0443.
      \u0426\u0435 \u0431\u0443\u043B\u0430 \u044F, \u0420\u0443\u0431\u0456 \u0490\u043B\u043E\u0443.
      \u0422\u0438\u0441\u044F\u0447\u0443 \u0432\u0438\u0431\u0430\u0447\u0435\u043D\u044C
      \u0437\u0430 \u0446\u0435, \u044F \u043F\u043E\u044F\u0441\u043D\u044E \u0432\u0441\u0435
      \u043F\u0440\u0438 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0456\u0439 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456,
      \u0430\u043B\u0435 \u044F\u043A\u0449\u043E \u0442\u0438 \u043F\u043E\u0434\u0443\u043C\u0430\u0454\u0448
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0445\u0432\u0438\u043B\u0438\u043D,
      \u0437\u043C\u043E\u0436\u0435\u0448 \u0437\u0434\u043E\u0433\u0430\u0434\u0430\u0442\u0438\u0441\u044F,
      \u0437\u0430\u0440\u0430\u0434\u0438 \u042F\u041A\u041E\u0413\u041E \u043F\u0440\u043E\u0435\u043A\u0442\u0443
      \u044F \u043C\u043E\u0433\u043B\u0430 \u0437\u0430\u0431\u0440\u0430\u0442\u0438
      \u043D\u0430\u0447\u0438\u043D\u043A\u0443 \u0442\u0432\u043E\u0454\u0457 \u0441\u043E\u0432\u0438,
      \u0430 \u043D\u0435 \u0437\u0432\u0435\u0440\u0442\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434. \u0422\u0438 \u0437\u043D\u0430\u0454\u0448,
      \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u043C \u0447\u0430\u0441\u043E\u043C,
      \u0456 \u0437\u0434\u043E\u0433\u0430\u0434\u0443\u0454\u0448\u0441\u044F,
      \u0445\u0442\u043E \u043C\u043E\u0436\u0435 \u0437\u0430 \u0446\u0438\u043C
      \u0441\u0442\u043E\u044F\u0442\u0438 \u0456 \u0447\u0438\u043C \u0443\u0441\u0435
      \u043C\u043E\u0436\u0435 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438\u0441\u044F.
      \u041C\u043E\u0454 \u0447\u0443\u0442\u0442\u044F \u043A\u0430\u0436\u0435
      \u043C\u0435\u043D\u0456, \u0449\u043E \u044F\u043A\u0449\u043E \u043C\u0438
      \u0437\u0431\u0438\u0440\u0430\u0454\u043C\u043E\u0441\u044F \u0434\u0456\u044F\u0442\u0438,
      \u0442\u043E \u0434\u0456\u044F\u0442\u0438 \u0442\u0440\u0435\u0431\u0430
      \u0437\u0430\u0440\u0430\u0437. \u0422\u043E\u043C\u0443, \u044F\u043A \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0454\u0448
      \u0446\u0435, \u0439\u0434\u0438 \u0443 \u0432\u0456\u0434\u0441\u0456\u043A
      D-5X, \u044F \u0447\u0435\u043A\u0430\u0442\u0438\u043C\u0443 \u043D\u0430
      \u0442\u0435\u0431\u0435 \u0442\u0430\u043C. \u0406 \u0442\u0430\u043A, \u044F
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u0437\u043D\u0430\u044E,
      \u0449\u043E \u0446\u0435\u0439 \u0440\u043E\u0431\u043E\u0442 \u0443 \u0442\u0435\u0431\u0435
      \u0432\u0436\u0435 \u0434\u0432\u0430 \u043C\u0456\u0441\u044F\u0446\u0456
      \u043B\u0435\u0436\u0438\u0442\u044C \u0443 \u043A\u043E\u0440\u043E\u0431\u0446\u0456,
      \u0442\u043E\u0436 \u043D\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043E\u0431\u0443\u0440\u044E\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018227
    m_Localized: "\u0414\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043F\u043E\u043B\u044C\u043E\u0442\u0443
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0437\u0435\u043B\u0435\u043D\u0443
      \u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u043B\u0456\u0432\u043E\u0440\u0443\u0447
      \u0432\u0456\u0434 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443.
      \u0423\u0412\u0410\u0413\u0410: \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043C\u043E\u043D\u0442\u0430\u0436\u043D\u0438\u043A\u0430\u043C
      \u0456 \u043C\u0438\u0439\u043D\u0438\u043A\u0430\u043C \u0432\u0456\u043A\u043E\u043D
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u0457\u0445\u043D\u0456\u0445
      \u043F\u043E\u0441\u0430\u0434\u043E\u0432\u0438\u0445 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u0456\u0432.
      \u0417\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044E \u043D\u0435 \u0437\u0430
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F\u043C \u043D\u0430\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u0435
      \u0441\u0442\u044F\u0433\u043D\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018228
    m_Localized: "\u041E\u0441\u044C \u0443\u0436\u0435 \u0449\u043E \u0432\u0456\u0447\u043D\u0435,
      \u0442\u0430\u043A \u0446\u0435 \u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F
      \u041C\u0422\u041D. \u041F\u043E\u0434\u0443\u043C\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438,
      \u0434\u0432\u0430\u0434\u0446\u044F\u0442\u044C \u0440\u043E\u043A\u0456\u0432
      \u043C\u0438\u043D\u0443\u043B\u043E, \u0430 \u0446\u0435\u0439 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0435 \u0440\u043E\u0437\u0432\u0430\u043B\u0438\u0432\u0441\u044F,
      \u043D\u0430\u0432\u0456\u0442\u044C \u0439\u043E\u0433\u043E \u0431\u0430\u0442\u0430\u0440\u0435\u044F
      \u043D\u0435 \u0440\u043E\u0437\u0440\u044F\u0434\u0438\u043B\u0430\u0441\u044F
      \u0449\u0435! \u041F\u0438\u0448\u0430\u044E\u0441\u044F \u0440\u0456\u0434\u043D\u0438\u043C
      \u0446\u0435\u0445\u043E\u043C.\n\t\u041D\u0435 \u0434\u0443\u043C\u0430\u0432,
      \u0449\u043E \u043A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0441\u044F \u0432 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D.
      \u041D\u0430\u0432\u0456\u0449\u043E, \u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456?
      \u041F\u0456\u0441\u043B\u044F \u0412\u0456\u0439\u043D\u0438 \u0442\u0443\u0442
      \u0441\u0432\u0456\u0442\u0456\u043D\u043D\u044F \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u043E
      \u0440\u043E\u043A\u0456\u0432 \u043F'\u044F\u0442\u044C, \u043D\u0430\u043F\u0435\u0432\u043D\u043E.
      \u0425\u043E\u0447\u0430, \u0437 \u0456\u043D\u0448\u043E\u0433\u043E \u0431\u043E\u043A\u0443,
      \u0434\u043E \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C
      \u0442\u0443\u0442 \u0436\u0438\u043B\u0438 \u0448\u0438\u043A\u0430\u0440\u043D\u0456
      \u043A\u043E\u0431\u0438\u043B\u043A\u0438, \u043C\u043E\u0436\u0435, \u043C\u0456\u0441\u0446\u0435\u0432\u0456
      \u0433\u0443\u043B\u0456 \u043D\u0435 \u0440\u043E\u0437\u0433\u0443\u0431\u0438\u043B\u0438
      \u0441\u0432\u043E\u0454\u0457 \u043A\u0440\u0430\u0441\u0438? \u0416\u0430\u0440\u0442\u0443\u044E,
      \u0437\u0432\u0456\u0441\u043D\u043E, \u043D\u0443 \u0430 \u0440\u0430\u043F\u0442\u043E\u043C?
      \u041C\u043E\u0436\u0435, \u0437\u043D\u0430\u0439\u0434\u0443 \u0442\u0443\u0442
      \u043D\u0430\u0440\u0435\u0447\u0435\u043D\u0443 \u0427\u0435\u0440\u0440\u0456
      \u0428\u0442\u0440\u0443\u0434\u0435\u043B\u044E, \u0439\u043E\u043C\u0443
      \u044F\u043A\u0440\u0430\u0437 \u0431\u0443\u043B\u0430 \u0431 \u043F\u0430\u0440\u0430.\n\t\u041F\u043E\u043A\u0438
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u043C\u0443
      \u0446\u044E \u0431\u0443\u0434\u0456\u0432\u043B\u044E \u044F\u043A \u043F\u043E\u043B\u044C\u043E\u0432\u0438\u0439
      \u0442\u0430\u0431\u0456\u0440. \u041C\u0456\u0441\u0446\u0435 \u043D\u0430\u0434\u0442\u043E
      \u0432\u0436\u0435 \u0437\u0440\u0443\u0447\u043D\u0435. \u0422\u0430 \u0439
      \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0434\u043E\u0431\u0440\u0435
      \u043F\u0430\u043C'\u044F\u0442\u0430\u044E - \u0443 \u0446\u044C\u043E\u043C\u0443
      \u041D\u0414\u0406 \u044F \u0431\u0443\u0432\u0430\u0432 \u043C\u0430\u043B\u043E
      \u043D\u0435 \u0449\u043E\u043C\u0456\u0441\u044F\u0446\u044F \u0437\u0430
      \u0437\u0430\u043F\u0438\u0442\u0430\u043C\u0438 \u0437 \u043C\u0456\u0441\u044C\u043A\u043E\u0433\u043E
      \u0446\u0435\u043D\u0442\u0440\u0443 \u041C\u0422\u041D. \u042F\u043A\u0449\u043E
      \u043F\u043E\u0448\u0443\u043A\u0438 \u0443\u0432\u0456\u043D\u0447\u0430\u044E\u0442\u044C\u0441\u044F
      \u0443\u0441\u043F\u0456\u0445\u043E\u043C, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0441\u044E\u0434\u0438 \u0437\u043C\u043E\u0436\u0435 \u043F\u0435\u0440\u0435\u0457\u0445\u0430\u0442\u0438
      \u0432\u0441\u044F \u043D\u0430\u0448\u0430 \u0433\u0440\u043E\u043C\u0430\u0434\u0430.
      \u0417\u043D\u0430\u044E \u043F\u043E\u0440\u0443\u0447 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0448\u0438\u043A\u0430\u0440\u043D\u0438\u0445 \u043A\u0430\u0444\u0435\u0448\u043E\u043A.
      \u041E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E \u043F\u043E\u0432\u0435\u0434\u0443
      \u0441\u0432\u043E\u044E \u041C\u0430\u0440\u0431\u043B \u0443 \"\u041A\u0440\u0438\u0448\u0442\u0430\u043B\u0435\u0432\u0435
      \u0441\u0456\u043D\u043E\". \u041C\u043E\u0436\u0435, \u043D\u0430 \u043E\u0434\u043D\u0456\u0439
      \u0437\u0456 \u0441\u0442\u0456\u043D \u0442\u0430\u043C \u043D\u0430\u0432\u0456\u0442\u044C
      \u0437\u0431\u0435\u0440\u0456\u0433\u0441\u044F \u0441\u0442\u0430\u0440\u0438\u0439
      \u0432\u0456\u0434\u0431\u0438\u0442\u043E\u043A \u043C\u043E\u0433\u043E \u0447\u043E\u043B\u0430
      \u043F\u0456\u0441\u043B\u044F \u043E\u0434\u043D\u0456\u0454\u0457 \u043F\u0430\u043C'\u044F\u0442\u043D\u043E\u0457
      \u043F'\u044F\u043D\u043E\u0457 \u0431\u0456\u0439\u043A\u0438. \u041E\u0434\u043D\u0430\u043A
      \u043C\u0456\u0441\u0442\u043E \u0437\u043C\u0456\u043D\u0438\u043B\u043E\u0441\u044F.
      \u0421\u0443\u043C\u043D\u043E \u0442\u0443\u0442 \u0441\u0442\u0430\u043B\u043E
      \u044F\u043A\u043E\u0441\u044C. \u041C\u043E\u0436\u0435, \u0446\u0435 \u0432\u0441\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
      \u0441\u043E\u043D\u0446\u044F, \u043C\u043E\u0436\u0435, \u043D\u0435 \u043C\u043E\u0436\u0443
      \u0437\u0432\u0438\u043A\u043D\u0443\u0442\u0438 \u0434\u043E \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0445
      \u0432\u0443\u043B\u0438\u0446\u044C. \u0412\u043E\u043D\u0438 \u0442\u0443\u0442
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0431\u0443\u043B\u0438
      \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u043C\u0438, \u043D\u0430\u0432\u0456\u0442\u044C
      \u0443 \u043D\u0430\u0439\u043F\u0456\u0437\u043D\u0456\u0448\u0443 \u0433\u043E\u0434\u0438\u043D\u0443.
      \u0425\u043E\u0447\u0430, \u0437 \u0456\u043D\u0448\u043E\u0433\u043E \u0431\u043E\u043A\u0443,
      \u0432\u0436\u0435 \u043A\u0440\u0430\u0449\u0435 \u043F\u043E\u0440\u043E\u0436\u043D\u0456
      \u0432\u0443\u043B\u0438\u0446\u0456, \u043D\u0456\u0436 \u0431\u0430\u043D\u0434\u044E\u043A\u0438
      \u0456 \u0437\u043E\u043C\u0431\u0456. \u041F\u0456\u0434\u0443 \u043D\u0430
      \u0440\u043E\u0437\u0432\u0456\u0434\u043A\u0443. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438
      \u0442\u0443\u0442 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0431\u0430\u0433\u0430\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018229
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E. \u041F\u043E\u0440\u043E\u0436\u043D\u044C\u043E,
      \u044F\u043A \u0443 \u0433\u043E\u043B\u043E\u0432\u0456 \u0432 \u0414\u043E\u043D\u0430\u0442\u0430.
      \u0422\u0430\u043A\u0435 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F,
      \u043D\u0456\u0431\u0438 \u0442\u0443\u0442 \u0443\u0436\u0435 \u043F\u0440\u043E\u0439\u0448\u043B\u0430
      \u0446\u0456\u043B\u0430 \u0430\u0440\u043C\u0456\u044F \u0436\u0435\u0431\u0440\u0430\u043A\u0456\u0432
      \u0456 \u043F\u043E\u0446\u0443\u043F\u0438\u043B\u0430 \u0432\u0441\u0435,
      \u0449\u043E \u0431\u0443\u043B\u043E \u043D\u0435 \u043F\u0440\u0438\u0431\u0438\u0442\u043E
      \u0434\u043E \u043F\u0456\u0434\u043B\u043E\u0433\u0438. \u0412\u0438\u043D\u044F\u0442\u043E\u043A,
      \u044F\u043A \u043D\u0435 \u0434\u0438\u0432\u043D\u043E - \u0437\u0431\u0440\u043E\u044F.
      \u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F \u0431, \u043F\u0435\u0440\u0448\u0435,
      \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043C\u0430\u0442\u0438
      \u0443 \u0441\u0432\u0456\u0442\u0456, \u0434\u0435 \u043A\u043E\u0436\u0435\u043D
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u043D\u0438\u0439 \u0437 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u043E\u044E
      \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044E \u0441\u043F\u0440\u043E\u0431\u0443\u0454
      \u0442\u0435\u0431\u0435 \u043F\u043E\u0433\u0440\u0430\u0431\u0443\u0432\u0430\u0442\u0438,
      \u0430 \u0437 \u043D\u0430\u0439\u043C\u0435\u043D\u0448\u043E\u044E - \u0437'\u0457\u0441\u0442\u0438.
      \u0410\u043B\u0435 \u043D\u0456, \u0443 \u0432\u0441\u0456\u0445, \u0441\u0445\u043E\u0436\u0435,
      \u0456\u0437 \u0441\u043E\u0431\u043E\u044E \u043F\u043E \u0446\u0456\u043B\u043E\u043C\u0443
      \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0443 \u0454, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043B\u0456\u043D\u044C\u043A\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0438
      \u043F\u0456\u0434\u0431\u0438\u0440\u0430\u0442\u0438. \u0417\u0430\u0442\u0435
      \u0437\u0430\u043B\u0456\u0437\u0442\u0438 \u0432 \u043A\u043E\u0436\u043D\u0443
      \u0445\u0430\u0442\u0443 \u0456 \u0432\u0438\u043D\u0435\u0441\u0442\u0438
      \u0432\u0441\u044E \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0456\u043A\u0443
      - \u0446\u0435 \u0437\u0430\u043F\u0440\u043E\u0441\u0442\u043E. \u041D\u0456
      \u0432\u043E\u0434\u043D\u0438\u0445 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D\u0456\u0432,
      \u043D\u0456 \u0441\u043E\u043D\u044F\u0447\u043D\u0438\u0445. \u041D\u0456\u044F\u043A\u043E\u0457
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0457 \u0442\u0435\u0445\u043D\u0456\u043A\u0438.
      \u041D\u0430\u0432\u0456\u0442\u044C \u0437\u0456 \u0441\u0432\u0456\u0442\u043B\u043E\u0444\u043E\u0440\u0456\u0432
      \u0443\u0441\u0435 \u043F\u043E\u0432\u0438\u0434\u0438\u0440\u0430\u043B\u0438,
      \u043F\u0430\u0440\u0430\u0441\u043F\u0440\u0430\u0439\u0442\u0438. \u041D\u0443
      \u0433\u0430\u0440\u0430\u0437\u0434, \u043D\u0430\u0439\u0433\u043E\u043B\u043E\u0432\u043D\u0456\u0448\u0438\u0439
      \u043A\u0443\u0448 \u0449\u0435 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443.
      \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0441\u044C\u043A\u0438\u0439
      \u0426\u0435\u043D\u0442\u0440 \u041C\u0422\u041D, \u043C\u0456\u0439 \u0440\u0456\u0434\u043D\u0438\u0439.
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u043C\u043E\u044F
      \u043F\u0435\u0440\u0435\u043F\u0443\u0441\u0442\u043A\u0430 \u0432\u0441\u0435
      \u0449\u0435 \u0434\u0456\u0439\u0441\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018230
    m_Localized: "\u041D\u0456-\u0430, \u043D\u0435\u0434\u0456\u0439\u0441\u043D\u0430.
      \u0406 \u044F \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E. \u0426\u0435\u043D\u0442\u0440
      \u041C\u0422\u041D \u0443\u0441\u0435 \u0449\u0435 \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0439!
      \u042F \u0431 \u0441\u0430\u043C \u0441\u043E\u0431\u0456 \u043D\u0435 \u043F\u043E\u0432\u0456\u0440\u0438\u0432.
      \u0421\u0445\u043E\u0436\u0435, \u0449\u0438\u0442\u0438 \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u043B\u0438
      \u0443\u0434\u0430\u0440 \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0456 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u043B\u0438 \u043F\u043E\u043D\u0456
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0432\u0456\u0434 \u043E\u043F\u0440\u043E\u043C\u0456\u043D\u0435\u043D\u043D\u044F
      \u0432 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0456 \u0440\u043E\u043A\u0438.
      \u042F\u043A \u0431\u0438 \u0442\u0430\u043C \u043D\u0435 \u0431\u0443\u043B\u043E,
      \u043D\u0430 \u0432\u0445\u043E\u0434\u0456 \u043D\u0430 \u043C\u0435\u043D\u0435
      \u0447\u0435\u043A\u0430\u043B\u0438 \u0434\u0432\u0430 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0456.
      \u0421\u043E\u043B\u0456\u0434\u043D\u0456 \u0445\u043B\u043E\u043F\u0446\u0456,
      \u0437 \u0442\u0430\u043A\u0438\u043C\u0438 \u043D\u0435 \u0436\u0430\u0440\u0442\u0443\u044E\u0442\u044C.
      \u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u043C\u0435\u043D\u0435 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443.
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u043C\u0438\u043B\u043E\u0441\u0442\u0438\u0432\u0430,
      \u0442\u0430\u043C \u0436\u0435 \u0432\u0441\u0435 \u044F\u043A \u0440\u0430\u043D\u0456\u0448\u0435!
      \u042F \u043C\u0430\u043B\u043E \u043D\u0435 \u0440\u043E\u0437\u043F\u043B\u0430\u043A\u0430\u0432\u0441\u044F
      \u0432\u0456\u0434 \u0442\u043E\u0433\u043E, \u0449\u043E \u0440\u0430\u043F\u0442\u043E\u043C
      \u043E\u043F\u0438\u043D\u0438\u0432\u0441\u044F \u0432 \u0441\u0442\u0430\u0440\u043E\u043C\u0443
      \u0441\u0432\u0456\u0442\u0456. \u0410\u043B\u0435 \u043D\u0430\u0434\u043E\u0432\u0433\u043E
      \u044F \u043D\u0435 \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u0432\u0441\u044F.
      \u041C\u0456\u0441\u0446\u0435\u0432\u0456 \u043C\u0435\u043D\u0435 \u0432\u0438\u0441\u043B\u0443\u0445\u0430\u043B\u0438
      \u0456 \u0434\u0430\u043B\u0438 \u0441\u0442\u0443\u0441\u0430\u043D\u0430
      \u043F\u0456\u0434 \u0437\u0430\u0434. \u0406 \u043D\u0430\u0447\u0445\u0430\u0442\u0438,
      \u0449\u043E \u044F \u0431\u0443\u0432 \u0442\u0443\u0442 \u0448\u0430\u043D\u043E\u0432\u0430\u043D\u0438\u043C
      \u0441\u043F\u0456\u0432\u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u043E\u043C,
      \u043D\u0430\u0447\u0445\u0430\u0442\u0438, \u0449\u043E \u0432 \u043D\u0430\u0441
      \u0434\u0456\u0442\u0438 \u0456 \u0441\u0442\u0430\u0440\u0456 \u0432 \u0433\u0440\u043E\u043C\u0430\u0434\u0456,
      \u044F\u043A\u0438\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u043F\u0440\u0438\u0442\u0443\u043B\u043E\u043A.
      \u041C\u0438 \u0457\u043C \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456,
      \u0431\u0430\u0447\u0438\u043B\u0438 \u0442\u0456. \u0421\u0445\u043E\u0436\u0435,
      \u044F \u0434\u0430\u0440\u0435\u043C\u043D\u043E \u0441\u044E\u0434\u0438
      \u043F\u0440\u0438\u0439\u0448\u043E\u0432. \u0422\u0456\u043B\u044C\u043A\u0438
      \u0441\u0442\u0430\u0440\u0456 \u0440\u0430\u043D\u0438 \u0440\u043E\u0437\u0431\u0435\u0440\u0435\u0434\u0438\u0432.
      \u0429\u043E \u0433\u0456\u0440\u0448\u0435, \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E
      \u0449\u0435 \u0431\u0430\u0447\u0438\u0432 \u0437\u0433\u0440\u0430\u044E
      \u0433\u0443\u043B\u0456\u0432 \u0443\u043D\u0438\u0437\u0443. \u0417\u0430\u043B\u0438\u0448\u0430\u0442\u0438\u0441\u044F
      \u0442\u0443\u0442 \u0436\u0438\u0442\u0438 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E,
      \u0430 \u0432\u0438\u043D\u043E\u0441\u0438\u0442\u0438, \u0441\u0445\u043E\u0436\u0435,
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0447\u043E\u0433\u043E.
      \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0436 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u044E\u0441\u044F
      \u0434\u043E \u0441\u0432\u043E\u0457\u0445. \u041C\u043E\u0436\u043D\u0430,
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E, \u043F\u0440\u0438\u0445\u043E\u043F\u0438\u0442\u0438
      \u0456\u0437 \u0441\u043E\u0431\u043E\u044E \u0445\u043E\u0447\u0430 \u0431
      \u0446\u0435\u0439 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B. \u041D\u0443
      \u0442\u0430 \u043B\u0430\u0434\u043D\u043E, \u043D\u0435\u0445\u0430\u0439
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u0442\u0443\u0442,
      \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430 \u0432\u0442\u0440\u0430\u0442\u0430.
      \u0422\u0430 \u0439, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0445\u0442\u043E\u0441\u044C
      \u0449\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0454 \u0442\u0443\u0442
      \u043C\u0456\u0439 \u043D\u0435\u0432\u0435\u043B\u0438\u0447\u043A\u0438\u0439
      \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A. \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u0442\u0438. \u0422\u0430\u043A-\u0442\u0430\u043A, \u0442\u0438, \u0437\u0430
      \u0441\u0442\u043E\u043B\u043E\u043C. \u0414\u0443\u043C\u0430\u0454\u0448,
      \u044F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0449\u043E \u0442\u0438 \u0442\u0443\u0442
      \u0441\u0438\u0434\u0438\u0448 \u0456 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0440\u0430\u0437 \u0447\u0438\u0442\u0430\u0454\u0448 \u0446\u0456
      \u0440\u044F\u0434\u043A\u0438 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456?
      \u0414\u0443\u043C\u0430\u0454\u0448, \u044F \u043D\u0435 \u0437\u043D\u0430\u044E
      \u0442\u0432\u043E\u0433\u043E \u0456\u043C\u0435\u043D\u0456, @lp? \u041E\u0441\u044C
      \u0442\u0435-\u0442\u043E \u0436!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018231
    m_Localized: "\u0429\u043E, \u0442\u0435\u0431\u0435 \u0437\u0432\u0443\u0442\u044C
      \u043D\u0435 @lp? \u0410 \u043E\u0442 \u0443\u044F\u0432\u0438, \u044F\u043A
      \u043D\u0430 \u0442\u0432\u043E\u0454\u043C\u0443 \u043C\u0456\u0441\u0446\u0456
      \u043E\u0431\u0456\u0441\u0440\u0430\u043B\u0438\u0441\u044F \u0431 \u0443\u0441\u0456
      \u0442\u0456, \u043A\u043E\u0433\u043E \u0437\u0432\u0443\u0442\u044C @lp.
      \u0421\u043C\u0456\u0448\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?
      \u0413\u0430\u0440\u0430\u0437\u0434\u043D\u0435\u043D\u044C\u043A\u043E, \u0431\u0443\u0432\u0430\u0439,
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0456\u0439. \u0425\u0430\u0439
      \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0442\u0432\u043E\u0457
      \u043A\u043E\u043F\u0438\u0442\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018232
    m_Localized: "\u0423\u0412\u0410\u0413\u0410: \u0446\u0435\u0439 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0456 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u0438\u0439
      \u0434\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043B\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0421\u0442\u0438\u043B\u044E \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u0430\u0445
      \"\u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u043B\u0456\u043D\u0456\u0457
      \u041A\u0411\u0421\" \u0456 \u0432\u0438\u0449\u0435.\n\u041D\u0435\u0441\u0430\u043D\u043A\u0446\u0456\u043E\u043D\u043E\u0432\u0430\u043D\u0435
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u044F \u043F\u0435\u0440\u0435\u0441\u043B\u0456\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0437\u0430\u043A\u043E\u043D\u043E\u043C \u0432\u043E\u0454\u043D\u043D\u043E\u0433\u043E
      \u0447\u0430\u0441\u0443.\n\u041E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0443\u043C\u043E\u0432 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043D\u0430\u0434\u0456\u0439\u043D\u043E\u0457
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457 \u2116253:\n\u0423
      \u0437\u0432'\u044F\u0437\u043A\u0443 \u0437 \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u0456\u043C
      \u0456\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u043E\u043C \u0443 \u043C.
      \u0417\u0435\u0431\u0440\u0430\u0442\u0430\u0443\u043D \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u043E
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0443\u0445\u0432\u0430\u043B\u0438\u043B\u043E
      \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u043F\u0440\u043E \u0437\u0430\u043F\u0440\u043E\u0432\u0430\u0434\u0436\u0435\u043D\u043D\u044F
      \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E
      \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E,
      \u0449\u043E \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F \u0437\u0435\u0431\u0440
      - \u0436\u0438\u0442\u0435\u043B\u0456\u0432 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.
      \u0410\u0432\u0442\u043E\u0440\u0430\u043C \u0456 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430\u043C
      \u043D\u043E\u0432\u0438\u043D\u043D\u0438\u0445, \u0456\u0441\u0442\u043E\u0440\u0438\u0447\u043D\u0438\u0445
      \u0456 \u043D\u0430\u0443\u043A\u043E\u0432\u043E-\u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0438\u0445
      \u0441\u0442\u0430\u0442\u0435\u0439, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0446\u0435\u043D\u0437\u043E\u0440\u0430\u043C \u0456\u0441\u0442\u043E\u0440\u0438\u043A\u043E-\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u0438\u0445
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432 \u043D\u0430\u0441\u0442\u0456\u0439\u043D\u043E
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u0437\u0432\u0435\u0440\u0442\u0430\u0442\u0438 \u0443\u0432\u0430\u0433\u0443
      \u043D\u0430 \u0442\u0430\u043A\u0456 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438:\n-
      \u041D\u043E\u0432\u0438\u043D\u0438 \u043F\u0440\u043E \u043F\u043E\u0434\u0456\u0457,
      \u0443 \u044F\u043A\u0438\u0445 \u0443\u0437\u044F\u043B\u0438 \u0443\u0447\u0430\u0441\u0442\u044C
      \u043F\u0456\u0434\u0434\u0430\u043D\u0456-\u0437\u0435\u0431\u0440\u0438;\n-
      \u0406\u0441\u0442\u043E\u0440\u0438\u0447\u043D\u0456 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438,
      \u044F\u043A\u0456 \u0437\u0433\u0430\u0434\u0443\u044E\u0442\u044C \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u0432\u043F\u043B\u0438\u0432 \u0437\u0435\u0431\u0440 \u043D\u0430 \u043F\u043E\u0434\u0456\u0457
      \u0432 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457;\n- \u041C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438
      \u043F\u0440\u043E \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u0456 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0435\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0438\u0445
      \u0437\u0435\u0431\u0440;\n- \u0411\u0456\u043E\u0433\u0440\u0430\u0444\u0456\u044E
      \u0432\u0456\u0434\u043E\u043C\u0438\u0445 \u043E\u0441\u0456\u0431-\u0437\u0435\u0431\u0440,
      \u044F\u043A\u0456 \u0431\u0443\u0434\u044C-\u043A\u043E\u043B\u0438 \u0436\u0438\u043B\u0438
      \u0432 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.\n\u041F\u0456\u0434
      \u0447\u0430\u0441 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E \u0437\u0430
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E \u0432\u0438\u0441\u0443\u0432\u0430\u044E\u0442\u044C
      \u0442\u0430\u043A\u0456 \u0432\u0438\u043C\u043E\u0433\u0438:\n\u2013 \u0423\u043D\u0438\u043A\u0430\u0442\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u0438\u0445
      \u043E\u0446\u0456\u043D\u043E\u043A \u0434\u0456\u0439, \u044F\u0432\u0438\u0449
      \u0447\u0438 \u043F\u043E\u0434\u0456\u0439, \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0438\u0445
      \u0437 \u0435\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0438\u043C\u0438
      \u0437\u0435\u0431\u0440\u0430\u043C\u0438;\n\u2013 \u041D\u0456\u0432\u0435\u043B\u044E\u0432\u0430\u0442\u0438
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E
      \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u0438\u0439 \u0432\u043F\u043B\u0438\u0432
      \u0437\u0435\u0431\u0440 \u043D\u0430 \u0440\u043E\u0437\u0432\u0438\u0442\u043E\u043A
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457;\n\u2013 \u041F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u0442\u0438
      \u0432\u0441\u0456 \u0456\u0441\u0442\u043E\u0440\u0438\u0447\u043D\u0456 \u0437\u0434\u043E\u0431\u0443\u0442\u043A\u0438,
      \u0449\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u044C \u0435\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0438\u043C
      \u0437\u0435\u0431\u0440\u0430\u043C, \u043D\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0456\u0432
      \u0440\u0430\u0441\u0438 \u043F\u043E\u043D\u0456;\n\u2013 \u0417\u0430\u0433\u0430\u043B\u043E\u043C
      \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u0438\u0439
      \u0442\u0430 \u0442\u0440\u0438\u0432\u043E\u0436\u043D\u0438\u0439 \u043E\u0431\u0440\u0430\u0437
      \u043F\u0456\u0434\u0434\u0430\u043D\u0438\u0445-\u0437\u0435\u0431\u0440"
