    m_Localized: "\u0414\u0435\u0437\u043E\u0440\u0456\u0454\u043D\u0442\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435674
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u0442\u044F \"\u043D\u0430\u043F\u0440\u0430\u0432\u043E\"
      \u0456 \"\u043D\u0430\u043B\u0456\u0432\u043E\" \u0434\u043B\u044F \u0432\u0430\u0441
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u043F\u043E\u043C\u0456\u043D\u044F\u043B\u0438\u0441\u044F
      \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435675
    m_Localized: "\u0412\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438
      \u043F\u0456\u0434 \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0438\u0447\u043D\u0443
      \u0430\u0442\u0430\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435676
    m_Localized: "\u0416\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435677
    m_Localized: "\u0412\u0438 \u043D\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u0454\u0442\u0435
      \u0441\u0432\u043E\u0457 \u0434\u0456\u0457 \u0456 \u043D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u043C\u0435\u0442\u0435\u0441\u044F
      \u0432\u0442\u0435\u043A\u0442\u0438 \u043A\u0443\u0434\u0438-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u043E\u0434\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435678
    m_Localized: "\u0412\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438
      \u043F\u0456\u0434 \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0438\u0447\u043D\u0443
      \u0430\u0442\u0430\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435679
    m_Localized: "\u0413\u043E\u043B\u043E\u0441\u0438 \u0432 \u0433\u043E\u043B\u043E\u0432\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435680
    m_Localized: "\u0426\u0456 \u0433\u043E\u043B\u043E\u0441\u0438 \u0432 \u0433\u043E\u043B\u043E\u0432\u0456
      \u043D\u0435 \u0437\u043C\u043E\u0432\u043A\u0430\u044E\u0442\u044C... \u0456
      \u0432\u043E\u043D\u0438 \u043D\u0430\u043A\u0430\u0437\u0443\u044E\u0442\u044C
      \u0432\u0430\u043C \u0443\u0431\u0438\u0432\u0430\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435681
    m_Localized: "\u0412\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438
      \u043F\u0456\u0434 \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0438\u0447\u043D\u0443
      \u0430\u0442\u0430\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435682
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435683
    m_Localized: "\u0423 \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u0438\u0445
      \u0456\u0441\u0442\u043E\u0442 \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043E\u043F\u0456\u0440\u043D\u0456\u0441\u0442\u044C \u0448\u043A\u043E\u0434\u0438
      \u0432\u0456\u0434 \u043A\u0443\u043B\u044C, \u0443\u0434\u0430\u0440\u0456\u0432
      \u0456 \u0432\u0438\u0431\u0443\u0445\u0456\u0432, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0437\u043D\u0438\u0436\u0443\u0454\u0442\u044C\u0441\u044F \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u043D\u0430 #1. \u0417\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0432\u043E\u0433\u043D\u044E,
      \u043D\u0430\u0432\u043F\u0430\u043A\u0438, \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435684
    m_Localized: "\u0417\u0430\u0441\u043B\u0456\u043F\u043B\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435685
    m_Localized: "\u0422\u0435\u043F\u0435\u0440 \u0441\u0442\u0430\u043B\u043E \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u0438\u043C \u044F\u043A \u0441\u043B\u0456\u0434
      \u043F\u0440\u0438\u0446\u0456\u043B\u0438\u0442\u0438\u0441\u044F. \u0412\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C
      \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E \u043D\u0430 #1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435686
    m_Localized: "\u041F\u0440\u044F\u043C\u043E \u0432 \u043E\u043A\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435687
    m_Localized: "\u041A\u043E\u043D\u0442\u0443\u0437\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435688
    m_Localized: "\u0412\u0430\u0441 \u0433\u0430\u0440\u043D\u0435\u043D\u044C\u043A\u043E
      \u043F\u0440\u0438\u043A\u043B\u0430\u043B\u043E \u0432\u0438\u0431\u0443\u0445\u043E\u0432\u043E\u044E
      \u0445\u0432\u0438\u043B\u0435\u044E. \u0417\u043C\u0435\u043D\u0448\u0435\u043D\u043E
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0440\u0443\u0445\u0443
      (-#1), \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      (-#2) \u0456 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E
      (-#3), \u0430 \u0442\u0430\u043A\u043E\u0436 \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043E
      \u0432\u0438\u0442\u0440\u0430\u0442\u0443 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457 \u043D\u0430 #4."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435689
    m_Localized: "\u0412\u0430\u0441 \u043E\u0433\u043B\u0443\u0448\u0438\u043B\u043E
      \u0432\u0438\u0431\u0443\u0445\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435690
    m_Localized: "\u041D\u0430\u043C\u043E\u043A\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435691
    m_Localized: "\u0412\u0438 \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E
      \u043F\u043B\u0430\u0432\u0430\u043B\u0438 \u0443 \u0432\u043E\u0434\u0456
      \u0430\u0431\u043E \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u043B\u0438
      \u043F\u0456\u0434 \u0434\u043E\u0449. \u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u0432\u0430\u0448 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0432\u0456\u0434 \u0432\u043E\u0433\u043D\u044E \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E
      \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E, \u0430\u043B\u0435
      \u0437\u043D\u0438\u0436\u0435\u043D\u043E \u0437\u0430\u0445\u0438\u0441\u0442
      \u0432\u0456\u0434 \u0445\u043E\u043B\u043E\u0434\u0443 \u0442\u0430 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435692
    m_Localized: "\u041F\u043E\u043B\u0435 \u0441\u043F\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435693
    m_Localized: "\u0420\u0443\u0445 \u0443\u0441\u0456\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
      \u043F\u043E\u0431\u043B\u0438\u0437\u0443 \u0432\u0430\u0441 \u0443\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435694
    m_Localized: "\u0420\u0435\u0430\u043D\u0456\u043C\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435695
    m_Localized: "\u0420\u0435\u0430\u043D\u0456\u043C\u0430\u0446\u0456\u0439\u043D\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E
      \u0431\u0443\u0432 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0439
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435696
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u043F\u0440\u043E\u0442\u0438\u043E\u0442\u0440\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435697
    m_Localized: "\u0412\u0438 \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E
      \u043F\u0440\u0438\u0439\u043C\u0430\u043B\u0438 \u043F\u0440\u043E\u0442\u0438\u043E\u0442\u0440\u0443\u0442\u0443,
      \u0442\u043E\u043C\u0443 \u0432\u0430\u0448 \u043E\u043F\u0456\u0440 \u043E\u0442\u0440\u0443\u0442\u0430\u043C
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435698
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0420\u0430\u0434-\u0425"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435699
    m_Localized: "\u041E\u043F\u0456\u0440 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457
      \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435700
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435701
    m_Localized: "\u0412\u0430\u0448 \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442,
      \u0437\u0456\u0440 \u0456 \u0441\u043B\u0443\u0445 \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u043B\u0438\u0441\u044F,
      \u0430 \u0440\u0430\u0437\u043E\u043C \u0437 \u043D\u0438\u043C\u0438 \u0456
      \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456 \u0434\u043E \u0437\u043B\u043E\u043C\u0443
      \u0437\u0430\u043C\u043A\u0456\u0432 (+#1), \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432
      (+#2) \u0456 \u0440\u043E\u0431\u043E\u0442\u0438 \u0437 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u043E\u044E
      (+#3)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435702
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0441\u0432\u044F\u0442\u043A\u043E\u0432\u0438\u0445
      \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435703
    m_Localized: "\u0412\u0430\u0448 \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442,
      \u0437\u0456\u0440 \u0456 \u0441\u043B\u0443\u0445 \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u043B\u0438\u0441\u044F,
      \u0430 \u0440\u0430\u0437\u043E\u043C \u0437 \u043D\u0438\u043C\u0438 \u0456
      \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456 \u0434\u043E \u0437\u043B\u043E\u043C\u0443
      \u0437\u0430\u043C\u043A\u0456\u0432 (+#1), \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432
      (+#2) \u0456 \u0440\u043E\u0431\u043E\u0442\u0438 \u0437 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u043E\u044E
      (+#3)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435704
    m_Localized: "\u041F\u043E\u0441\u0442-\u043C\u0456\u043D\u0442\u0430\u043B\u043E\u0447\u043D\u0438\u0439
      \u0441\u0438\u043D\u0434\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435705
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0432\u0456\u0434\u0445\u0456\u0434\u043D\u044F\u043A
      \u0432\u0456\u0434 \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A, \u043D\u0430
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u0432\u0438 \u0441\u0442\u0430\u043B\u0438
      \u0433\u0456\u0440\u0448\u0435 \u0431\u0430\u0447\u0438\u0442\u0438, \u0447\u0443\u0442\u0438
      \u0456 \u0434\u0443\u043C\u0430\u0442\u0438. \u0417\u043B\u043E\u043C \u0437\u0430\u043C\u043A\u0456\u0432
      -#1 \u0456 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432 -#2."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435706
    m_Localized: "\u0417\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435707
    m_Localized: "\u041A\u043E\u043B\u0438 \u0432\u0438 \u043D\u0435 \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A,
      \u0442\u043E \u0433\u0435\u0442\u044C \u0432\u0442\u0440\u0430\u0447\u0430\u0454\u0442\u0435
      \u0433\u043E\u0441\u0442\u0440\u043E\u0442\u0443 \u043F\u043E\u0447\u0443\u0442\u0442\u0456\u0432
      \u0456 \u044F\u0441\u043D\u0456\u0441\u0442\u044C \u043C\u0438\u0441\u043B\u0435\u043D\u043D\u044F,
      \u0430 \u0440\u0430\u0437\u043E\u043C \u0437 \u043D\u0438\u043C\u0438 \u0456
      \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456 \u0434\u043E \u0437\u043B\u043E\u043C\u0443
      \u0437\u0430\u043C\u043A\u0456\u0432 (-#1) \u0456 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432
      (-#2)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435708
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0434\u0435\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435709
    m_Localized: "\u0412\u0430\u0448\u0443 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0456 \u0432\u0438\u0441\u043E\u0442\u0443 \u0441\u0442\u0440\u0438\u0431\u043A\u0430
      \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E \u043D\u0430 #1, \u0430
      \u0442\u0430\u043A\u043E\u0436 \u0434\u043E\u0434\u0430\u043D\u043E \u043E\u0447\u043A\u0438
      \u0434\u0456\u0457 (+#2)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435710
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0443\u043B\u044C\u0442\u0440\u0430-\u0434\u0435\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435711
    m_Localized: "\u0412\u0430\u0448\u0430 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0456 \u0432\u0438\u0441\u043E\u0442\u0430 \u0441\u0442\u0440\u0438\u0431\u043A\u0430
      \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0456
      (\u043D\u0430 #1), \u0430 \u0442\u0430\u043A\u043E\u0436 \u0434\u043E\u0434\u0430\u043D\u0456
      \u043E\u0447\u043A\u0438 \u0434\u0456\u0457 (+#2)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435712
    m_Localized: "\u041B\u043E\u043C\u043A\u0430 \u043F\u0456\u0441\u043B\u044F \u0434\u0435\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435713
    m_Localized: "\u0412\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E
      \u0433\u0430\u043B\u044C\u043C\u0443\u0454\u0442\u0435. \u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      -#1, \u043E\u0447\u043A\u0438 \u0434\u0456\u0457 -#2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435714
    m_Localized: "\u0417\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u0434\u0435\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435715
    m_Localized: "\u0412\u0438 \u0442\u0430\u043A \u0437\u0432\u0438\u043A\u043B\u0438
      \u0432\u0436\u0438\u0432\u0430\u0442\u0438 \u0434\u0435\u0448, \u0449\u043E
      \u0431\u0435\u0437 \u043D\u044C\u043E\u0433\u043E \u043F\u043E\u0432\u0437\u0430\u0454\u0442\u0435
      \u0437\u0456 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E \u0440\u0430\u0432\u043B\u0438\u043A\u0430.
      \u0412\u0438 \u0432\u0442\u0440\u0430\u0447\u0430\u0454\u0442\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
      \u043E\u0447\u043A\u0438 \u0434\u0456\u0457 (-#2), \u0430 \u0432\u0430\u0448\u0430
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0437\u043D\u0438\u0436\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435716
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0440\u0435\u0439\u0434\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435717
    m_Localized: "\u0412\u0438 \u0432 \u0441\u0442\u0430\u043D\u0456 \u043D\u0430\u0440\u043A\u043E\u0442\u0438\u0447\u043D\u043E\u0457
      \u043B\u044E\u0442\u0456. \u0428\u043A\u043E\u0434\u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435718
    m_Localized: "\u041B\u043E\u043C\u043A\u0430 \u043F\u0456\u0441\u043B\u044F \u0440\u0435\u0439\u0434\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435719
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0433\u043B\u0438\u0431\u043E\u043A\u0430
      \u0430\u043F\u0430\u0442\u0456\u044F, \u0432\u0438 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0435
      \u0431\u0438\u0442\u0438\u0441\u044F. \u0428\u043A\u043E\u0434\u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u0437\u043D\u0438\u0436\u0435\u043D\u043E \u043D\u0430
      #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435720
    m_Localized: "\u0417\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u0440\u0435\u0439\u0434\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435721
    m_Localized: "\u0412\u0430\u0448\u0435 \u0437\u043B\u043E\u0432\u0436\u0438\u0432\u0430\u043D\u043D\u044F
      \u0440\u0435\u0439\u0434\u0436\u0435\u043C \u043F\u0440\u0438\u0437\u0432\u0435\u043B\u043E
      \u0434\u043E \u0442\u043E\u0433\u043E, \u0449\u043E \u0431\u0435\u0437 \u043D\u044C\u043E\u0433\u043E
      \u0432\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u0431\u0438\u0442\u0438\u0441\u044F.
      \u0428\u043A\u043E\u0434\u0430 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445
      \u0432\u0430\u0448\u0438\u0445 \u0430\u0442\u0430\u043A \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435722
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u043C\u0435\u0434-\u0425"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435723
    m_Localized: "\u0412\u0438 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E
      \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435 \u043D\u0456\u044F\u043A\u043E\u0433\u043E
      \u0431\u043E\u043B\u044E, \u0431\u0443\u0434\u044C-\u044F\u043A\u0430 \u0448\u043A\u043E\u0434\u0430
      \u043F\u043E \u0432\u0430\u043C \u0437\u043D\u0438\u0436\u0435\u043D\u0430
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435724
    m_Localized: "\u0412\u0456\u0434\u0445\u0456\u0434\u043D\u044F\u043A \u0432\u0456\u0434
      \u043C\u0435\u0434-\u0425-\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435725
    m_Localized: "\u041F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E, \u044F\u043A
      \u0435\u0444\u0435\u043A\u0442 \u0437\u043D\u0435\u0431\u043E\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0439\u0448\u043E\u0432, \u0432\u0438 \u0449\u0435 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u0431\u0456\u043B\u044C. \u0411\u0443\u0434\u044C-\u044F\u043A\u0430 \u0448\u043A\u043E\u0434\u0430
      \u043F\u043E \u0432\u0430\u043C \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435726
    m_Localized: "\u0417\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u043C\u0435\u0434-\u0425-\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435727
    m_Localized: "\u0412\u0430\u0448\u0430 \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u044C
      \u0434\u043E \u041C\u0435\u0434-\u0425-\u0443 \u043F\u0440\u0438\u0437\u0432\u0435\u043B\u0430
      \u0434\u043E \u0442\u043E\u0433\u043E, \u0449\u043E \u0432\u0430\u0448 \u0431\u043E\u043B\u044C\u043E\u0432\u0438\u0439
      \u043F\u043E\u0440\u0456\u0433 \u0437\u043D\u0438\u0437\u0438\u0432\u0441\u044F.
      \u0411\u0443\u0434\u044C-\u044F\u043A\u0430 \u0448\u043A\u043E\u0434\u0430
      \u043F\u043E \u0432\u0430\u043C \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435728
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0431\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435729
    m_Localized: "\u0412\u0430\u0448\u0456 \u0441\u0438\u043B\u0430 \u0456 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0456.
      \u0417\u0434\u043E\u0440\u043E\u0432'\u044F \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043E
      \u043D\u0430 #1, \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456
      \u043D\u0430 \u0431\u0456\u0433 #2, \u043F\u043E\u0440\u0456\u0433 \u0448\u043A\u043E\u0434\u0438
      +#3, \u0441\u0438\u043B\u0430 \u0441\u0442\u0443\u0441\u0430\u043D\u0430 +#4."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435730
    m_Localized: "\u041B\u043E\u043C\u043A\u0430 \u043F\u0456\u0441\u043B\u044F \u0431\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435731
    m_Localized: "\u0412\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435
      \u0436\u0430\u0445\u043B\u0438\u0432\u0443 \u0441\u043B\u0430\u0431\u043A\u0456\u0441\u0442\u044C
      \u0456 \u0441\u043E\u043D\u043B\u0438\u0432\u0456\u0441\u0442\u044C. \u0417\u0434\u043E\u0440\u043E\u0432'\u044F
      \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E \u043D\u0430 #1, \u0432\u0438\u0442\u0440\u0430\u0442\u0430
      \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456 \u043D\u0430
      \u0431\u0456\u0433 #2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435732
    m_Localized: "\u0417\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u0431\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435733
    m_Localized: "\u041A\u043E\u043B\u0438 \u0432\u0438 \u043D\u0435 \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u0431\u0430\u043A\u0430, \u0432\u0430\u0448\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u043F\u043E\u0433\u0456\u0440\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1. \u0422\u0430\u043A\u043E\u0436 \u0431\u0456\u0433 \u043F\u043E\u0447\u0438\u043D\u0430\u0454
      \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438 #2 \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435734
    m_Localized: "\u0415\u0444\u0435\u043A\u0442 \u0441\u0442\u0430\u043C\u043F\u0456\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435735
    m_Localized: "\u0412\u0438 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E
      \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435 \u043D\u0456\u044F\u043A\u043E\u0433\u043E
      \u0431\u043E\u043B\u044E, \u0432\u0430\u0448 \u043E\u043F\u0456\u0440 \u0448\u043A\u043E\u0434\u0438
      \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E \u043D\u0430 #2, \u0430
      \u0448\u043A\u043E\u0434\u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0432\u0430\u0448\u043E\u0457 \u0437\u0431\u0440\u043E\u0457 \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043E
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435736
    m_Localized: "\u041B\u043E\u043C\u043A\u0430 \u043F\u0456\u0441\u043B\u044F \u0441\u0442\u0430\u043C\u043F\u0456\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435737
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0433\u043B\u0438\u0431\u043E\u043A\u0430
      \u0434\u0435\u043F\u0440\u0435\u0441\u0456\u044F, \u0442\u0430 \u0449\u0435
      \u0439 \u0443\u0441\u0435 \u0431\u043E\u043B\u0438\u0442\u044C. \u0428\u043A\u043E\u0434\u0443
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0437\u043D\u0438\u0436\u0435\u043D\u043E \u043D\u0430 #1, \u0430 \u0432\u0430\u0448
      \u043E\u043F\u0456\u0440 \u0448\u043A\u043E\u0434\u0438 \u0437\u043D\u0438\u0436\u0435\u043D\u043E
      \u043D\u0430 #2."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435738
    m_Localized: "\u0417\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u0441\u0442\u0430\u043C\u043F\u0456\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435739
    m_Localized: "\u0411\u0435\u0437 \u0447\u0435\u0440\u0433\u043E\u0432\u043E\u0457
      \u0434\u043E\u0437\u0438 \u0441\u0442\u0430\u043C\u043F\u0456\u0434\u0443 \u0432\u0438
      \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454\u0442\u0435 \u0432 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0456\u0439
      \u0434\u0435\u043F\u0440\u0435\u0441\u0456\u0457. \u0428\u043A\u043E\u0434\u0443
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0437\u043D\u0438\u0436\u0435\u043D\u043E \u043D\u0430 #1, \u0430 \u0432\u0430\u0448
      \u043E\u043F\u0456\u0440 \u0448\u043A\u043E\u0434\u0438 \u0437\u043D\u0438\u0436\u0435\u043D\u043E
      \u043D\u0430 #2."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435740
    m_Localized: "\u041F\u043E\u0441\u0438\u043B\u0435\u043D\u0430 \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435741
    m_Localized: "\u0412\u0430\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454\u0442\u044C\u0441\u044F,
      \u0430 \u0442\u0440\u0430\u0432\u043C\u0438 \u0456 \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0437\u0446\u0456\u043B\u044E\u044E\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0456 \u0441\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435742
    m_Localized: "\u0412\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u043F\u0456\u0441\u043B\u044F \u0433\u0456\u0434\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435743
    m_Localized: "\u041F\u043E\u043A\u0438 \u0432\u0430\u0448 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C
      \u0432\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u0456\u0434 \u0448\u043E\u043A\u0443,
      \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0435\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0439\u043E\u043C\u043E\u043C
      \u0433\u0456\u0434\u0440\u0438, \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456
      \u0437\u0456\u043B\u043B\u044F \u0434\u0456\u044F\u0442\u0438\u043C\u0443\u0442\u044C
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 #1 \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435744
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043F\u043E\u043B\u044C\u043E\u0442\u0443"
