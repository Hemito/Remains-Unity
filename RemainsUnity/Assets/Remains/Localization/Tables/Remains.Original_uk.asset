    m_Localized: "[\u043A\u043B\u0456\u043A] - \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0430\u0431\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E \u0437\u043D\u043E\u0432\u0443"
    m_Metadata:
