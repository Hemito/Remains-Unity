  - m_Id: 2725241686
    m_Localized: "\u0421\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241687
    m_Localized: "\u0421\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u044F
      \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0433\u043E \u0440\u043E\u0437\u043C\u0456\u0440\u0443,
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u043E \u0431\u0456\u043B\u044C\u0448\u043E\u0441\u0442\u0456
      \u0432\u0438\u0434\u0456\u0432 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241688
    m_Localized: "\u041A\u0440\u0438\u0448\u0442\u0430\u043B\u0435\u0432\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241689
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E\u0457
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0445 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0456\u0432. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u044F\u043A \u0434\u0436\u0435\u0440\u0435\u043B\u043E \u0435\u043D\u0435\u0440\u0433\u0456\u0457
      \u0434\u043B\u044F \u043D\u0430\u0439\u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241690
    m_Localized: "\u041F\u0456\u0434\u0437\u0430\u0440\u044F\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241691
    m_Localized: "\u041D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u0456
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241692
    m_Localized: "\u0421\u043D\u0430\u0440\u044F\u0434 40-\u043C\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241693
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0440\u043E\u0437\u0440\u0438\u0432\u043D\u0438\u0439
      \u0441\u043D\u0430\u0440\u044F\u0434, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439
      \u0434\u043B\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241694
    m_Localized: "\u0420\u0430\u043A\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241695
    m_Localized: "\u0420\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u0441\u043D\u0430\u0440\u044F\u0434
      \u0434\u043B\u044F \u0440\u0430\u043A\u0435\u0442\u043D\u043E\u0457 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241696
    m_Localized: "\u0416\u0430\u0440-\u044F\u0439\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241697
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0441\u043D\u0430\u0440\u044F\u0434,
      \u0449\u043E \u043D\u0430\u0433\u0430\u0434\u0443\u0454 \u044F\u0439\u0446\u0435.
      \u0423\u0432'\u044F\u0437\u043D\u0435\u043D\u0430 \u0432 \u0439\u043E\u0433\u043E
      \u0433\u043B\u0438\u0431\u0438\u043D\u0456 \u0440\u0443\u0439\u043D\u0456\u0432\u043D\u0430
      \u0435\u043D\u0435\u0440\u0433\u0456\u044F \u043D\u0430\u0433\u0430\u0434\u0443\u0454
      \u043F\u0440\u043E \u0441\u0435\u0431\u0435 \u0445\u0456\u0431\u0430 \u0449\u043E
      \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0438\u043C \u043C\u0435\u0440\u0435\u0445\u0442\u0456\u043D\u043D\u044F\u043C
      \u0441\u0432\u0456\u0442\u043B\u043E\u0432\u0438\u0445 \u0432\u0456\u0434\u0431\u043B\u0438\u0441\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241698
    m_Localized: "\u0410\u0435\u0440\u043E\u0437\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241699
    m_Localized: "\u0411\u0430\u043B\u043E\u043D\u0447\u0438\u043A, \u0449\u043E
      \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0437\u0440\u0456\u0434\u0436\u0435\u043D\u0438\u0439
      \u043F\u0440\u043E\u043F\u0430\u043D \u0442\u0430 \u0456\u0437\u043E\u0431\u0443\u0442\u0430\u043D
      - \u0433\u0430\u0437\u0438, \u044F\u043A\u0456 \u043C\u043E\u0436\u0443\u0442\u044C
      \u043B\u0435\u0433\u043A\u043E \u0441\u043F\u0430\u043B\u0430\u0445\u043D\u0443\u0442\u0438,
      \u044F\u043A\u0449\u043E \u0457\u0445 \u043F\u0456\u0434\u043F\u0430\u043B\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241700
    m_Localized: "\u0414\u0440\u043E\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241701
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u0434\u0440\u043E\u0442\u0438\u043A
      \u0434\u043B\u044F \u043A\u0438\u0434\u0430\u043D\u043D\u044F \u043F\u043E
      \u043C\u0456\u0448\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241702
    m_Localized: "\u0414\u0438\u0441\u043A\u043E\u0432\u0430 \u043F\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241703
    m_Localized: "\u0414\u0438\u0441\u043A\u043E\u0432\u0430 \u043F\u0438\u043B\u0430
      \u0437 \u043D\u0435\u0440\u0436\u0430\u0432\u0456\u044E\u0447\u043E\u0433\u043E
      \u0441\u043F\u043B\u0430\u0432\u0443, \u0437\u0443\u0431\u0446\u0456 \u0433\u043E\u0441\u0442\u0440\u043E
      \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241704
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043A\u043E\u0432\u0430 \u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241705
    m_Localized: "\u041A\u0438\u0441\u043B\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241706
    m_Localized: "\u041F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u0430 \u0454\u043C\u043D\u0456\u0441\u0442\u044C
      \u0456\u0437 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u043E\u0432\u0430\u043D\u043E\u044E
      \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241707
    m_Localized: "\u0417\u0430\u043B\u0456\u0437\u043D\u0438\u0447\u043D\u0430 \u043C\u0438\u043B\u0438\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241708
    m_Localized: "\u0412\u0430\u0436\u043A\u0430 \u0437\u0430\u043B\u0456\u0437\u043D\u0430
      \u0445\u0440\u0456\u043D\u043E\u0432\u0438\u043D\u0430, \u044F\u043A\u043E\u044E
      \u043F\u0440\u0438\u0431\u0438\u0432\u0430\u044E\u0442\u044C \u0440\u0435\u0439\u043A\u0438
      \u0434\u043E \u0448\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241709
    m_Localized: "\u041A\u0440\u0456\u043E-\u043A\u043E\u043C\u0456\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241710
    m_Localized: "\u042F\u043A\u0449\u043E \u0430\u043B\u0445\u0456\u043C\u0456\u0447\u043D\u0456
      \u0441\u043F\u043E\u043B\u0443\u043A\u0438, \u0449\u043E \u043C\u0456\u0441\u0442\u044F\u0442\u044C\u0441\u044F
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u043E\u043C\u0443
      \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0456, \u0432\u0441\u0442\u0443\u043F\u043B\u044F\u0442\u044C
      \u0443 \u0440\u0435\u0430\u043A\u0446\u0456\u044E, \u0446\u0435 \u0432\u0438\u043A\u043B\u0438\u0447\u0435
      \u043C\u0438\u0442\u0442\u0454\u0432\u0435 \u043F\u0430\u0434\u0456\u043D\u043D\u044F
      \u0457\u0445\u043D\u044C\u043E\u0457 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438
      \u043C\u0430\u0439\u0436\u0435 \u0434\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0433\u043E
      \u043D\u0443\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241711
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043A\u043E\u043C\u0456\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241712
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u0434\u043B\u044F \u0437\u043E\u0440\u044F\u043D\u043E\u0433\u043E
      \u0431\u043B\u0430\u0441\u0442\u0435\u0440\u0430, \u0443 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u0430\u0437\u0456\u0432 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456 \u0431\u0430\u0442\u0430\u0440\u0435\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241713
    m_Localized: "\u0421\u0445\u0435\u043C\u0430 \u0445\u0456\u0442\u0438\u043D\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241714
    m_Localized: "\u041C\u0456\u0448\u0435\u0447\u043E\u043A \u0456\u0437 \u043A\u0440\u0438\u0448\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241715
    m_Localized: "\u041F\u043B\u044F\u0448\u043A\u043E\u0432\u0456 \u043A\u0440\u0438\u0448\u043A\u0438
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u044F\u043A \u0433\u0440\u043E\u0448\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241716
    m_Localized: "\u0411\u0456\u043E\u0433\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241717
    m_Localized: "\u0421\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0456\u044F, \u044F\u043A\u0430
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u043E\u043C \u044F\u043A \u0432\u0438\u0442\u0440\u0430\u0442\u043D\u0438\u0439
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B \u0434\u043B\u044F \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F
      \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C \u0456 \u0442\u0440\u0430\u0432\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241718
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241719
    m_Localized: "\u0417\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0439
      \u0431\u0438\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241720
    m_Localized: "\u0413\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0434\u043B\u044F
      \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D
      \u0456 \u043F\u043E\u0440\u0456\u0437\u0456\u0432, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0437\u0443\u043F\u0438\u043D\u043A\u0438 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241721
    m_Localized: "\u041B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435 \u0437\u0456\u043B\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241722
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0435 \u0434\u043B\u044F
      \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043B\u0435\u0433\u043A\u0438\u0445
      \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C. \u0429\u043E\u0431 \u0437\u0456\u043B\u043B\u044F
      \u043F\u043E\u0434\u0456\u044F\u043B\u043E, \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241723
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0435 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435
      \u0437\u0456\u043B\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241724
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0435 \u0434\u043B\u044F
      \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C
      \u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0457 \u0442\u044F\u0436\u043A\u043E\u0441\u0442\u0456.
      \u0429\u043E\u0431 \u0437\u0456\u043B\u043B\u044F \u043F\u043E\u0434\u0456\u044F\u043B\u043E,
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0434\u0435\u044F\u043A\u0438\u0439
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241725
    m_Localized: "\u0415\u043A\u0441\u0442\u0440\u0430-\u0441\u0438\u043B\u044C\u043D\u0435
      \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435 \u0437\u0456\u043B\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241726
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0435 \u0434\u043B\u044F
      \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u0432\u0430\u0436\u043A\u0438\u0445
      \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C. \u0429\u043E\u0431 \u0437\u0456\u043B\u043B\u044F
      \u043F\u043E\u0434\u0456\u044F\u043B\u043E, \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241727
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043C\u0430\u0433\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241728
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u0434\u043B\u044F
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438. \u041B\u0456\u043A\u0443\u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0435
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u043D\u044F \u0456 \u0432\u0438\u0433\u043E\u0440\u044F\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241729
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u043C\u0430\u0433\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241730
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u0434\u043B\u044F
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438. \u041B\u0456\u043A\u0443\u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0435
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u043D\u044F \u0456 \u0432\u0438\u0433\u043E\u0440\u044F\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241731
    m_Localized: "\u0421\u0443\u043F\u0435\u0440-\u0432\u0435\u043B\u0438\u043A\u0435
      \u0437\u0456\u043B\u043B\u044F \u043C\u0430\u0433\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241732
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u0434\u043B\u044F
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438. \u041B\u0456\u043A\u0443\u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0435
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u043D\u044F \u0456 \u0432\u0438\u0433\u043E\u0440\u044F\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241733
    m_Localized: "\u0410\u043D\u0442\u0438\u0440\u0430\u0434\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241734
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044F \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457
      \u0437 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241735
    m_Localized: "\u041F\u0440\u043E\u0442\u0438\u043E\u0442\u0440\u0443\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241736
    m_Localized: "\u041D\u0435\u0439\u0442\u0440\u0430\u043B\u0456\u0437\u0443\u0454
      \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0432\u0456\u0434\u043E\u043C\u0438\u0445
      \u043E\u0442\u0440\u0443\u0442 \u0456 \u0442\u043E\u043A\u0441\u0438\u043D\u0456\u0432,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u0447\u0430\u0441 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u043E\u043F\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u043E\u0442\u0440\u0443\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241737
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0436\u0438\u0442\u0442\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241738
    m_Localized: "\u041D\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u0437\u0434\u043E\u0440\u043E\u0432'\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241739
    m_Localized: "\u0426\u0435 \u043D\u0435 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0435
      \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435 \u0437\u0456\u043B\u043B\u044F,
      \u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u0435\u043B\u0456\u043A\u0441\u0438\u0440,
      \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438
      \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438 \u0432\u0430\u0448\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F. \u0412\u0438\u043F\u0438\u0439\u0442\u0435
      \u0439\u043E\u0433\u043E, \u043D\u0435 \u0432\u0456\u0434\u043A\u043B\u0430\u0434\u0430\u044E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241740
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0434\u0443\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241741
    m_Localized: "\u041D\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241742
    m_Localized: "\u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241743
    m_Localized: "\u041F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u0438\u0439
      \u0442\u0435\u0445\u043D\u043E-\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439, \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E\u043C
      \u0422\u0430\u0454\u043C\u043D\u0438\u0445 \u041D\u0430\u0443\u043A \u0437\u0430
      \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0421\u0442\u0438\u043B\u044E, \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0447\u0430\u0441
      \u0440\u043E\u0431\u0438\u0442\u0438 \u0441\u0432\u043E\u0433\u043E \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241744
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442\u043D\u0438\u0439 \u043D\u0430\u0431\u0456\u0440
      \u0437\u0431\u0440\u043E\u044F\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241745
    m_Localized: "\u0417\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0443 \u043C\u0430\u0439\u0436\u0435
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432\u0448\u0438 \u0439\u043E\u0433\u043E,
      \u0432\u0438 \u0432\u0456\u0434\u0440\u0435\u043C\u043E\u043D\u0442\u0443\u0454\u0442\u0435
      \u0435\u043A\u0456\u043F\u0456\u0440\u043E\u0432\u0430\u043D\u0443 \u0437\u0431\u0440\u043E\u044E
      \u043D\u0430 \u043F\u0435\u0432\u043D\u0438\u0439 \u0432\u0456\u0434\u0441\u043E\u0442\u043E\u043A,
      \u0449\u043E \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434
      \u043A\u043B\u0430\u0441\u0443 \u0437\u0431\u0440\u043E\u0457 \u0442\u0430
      \u0432\u0456\u0434 \u0432\u0430\u0448\u043E\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u0440\u0435\u043C\u043E\u043D\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241746
    m_Localized: "\u041F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u0438\u0439
      \u0432\u0435\u0440\u0441\u0442\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241747
    m_Localized: "\u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0430
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0443\u0432\u0430\u0442\u0438
      \u0432\u0430\u0448\u0443 \u0437\u0431\u0440\u043E\u044E \u0456 \u0431\u0440\u043E\u043D\u044E
      \u0432 \u043F\u043E\u0445\u0456\u0434\u043D\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445,
      \u0442\u0430\u043A \u0441\u0430\u043C\u043E, \u044F\u043A \u043D\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u043C\u0443
      \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241748
    m_Localized: "\u041F\u043E\u0445\u0456\u0434\u043D\u0438\u0439 \u043D\u0430\u0431\u0456\u0440
      \u043F\u0456\u0434\u0440\u0438\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241749
    m_Localized: "\u041C\u0456\u0441\u0442\u0438\u0442\u044C \u0443\u0441\u0435 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0434\u043B\u044F
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438
      \u0432 \u043F\u043E\u0445\u0456\u0434\u043D\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241750
    m_Localized: "\u041F\u043E\u0445\u0456\u0434\u043D\u0430 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241751
    m_Localized: "\u041C\u0456\u0441\u0442\u0438\u0442\u044C \u0443\u0441\u0435 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u0434\u043B\u044F
      \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0456\u043B\u043B\u044F
      \u0442\u0430 \u0445\u0456\u043C\u0456\u043A\u0430\u0442\u0456\u0432 \u0443
      \u043F\u043E\u0445\u0456\u0434\u043D\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241752
    m_Localized: "\u0421\u0432\u0438\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241753
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u0435\u043D, \u0449\u043E\u0431
      \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0430\u0431\u043E \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438
      \u043F\u0440\u0438\u0440\u0443\u0447\u0435\u043D\u043E\u0433\u043E \u0436\u0430\u0440-\u0444\u0435\u043D\u0456\u043A\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241754
    m_Localized: "\u0420\u043E\u0431\u043E-\u0441\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241755
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439
      \u0440\u043E\u0431\u043E\u0442, \u044F\u043A\u0438\u0439 \u0442\u0430\u043A\u043E\u0436
      \u043C\u043E\u0436\u0435 \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0444\u0443\u043D\u043A\u0446\u0456\u0457 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E\u0433\u043E
      \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u0430 \u0430\u0431\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044F.
      \u041C\u0430\u0454 \u0434\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u043B\u0430\u0437\u0435\u0440 \u044F\u043A \u0437\u0431\u0440\u043E\u044E.
      \u041C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u044F\u043A \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241756
    m_Localized: "\u0412\u0438 \u0437\u0456\u0431\u0440\u0430\u043B\u0438 [\u0440\u043E\u0431\u043E-\u0441\u043E\u0432\u0443],
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0430 \u043C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438 \u0432\u0430\u0448\u0438\u043C \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C.
      \u0410\u043A\u0442\u0438\u0432\u0443\u0439\u0442\u0435 \u0457\u0457 \u0447\u0435\u0440\u0435\u0437
      \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440: \u0440\u043E\u0437\u0434\u0456\u043B
      [\u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F]. \u0422\u0430\u043C
      \u0436\u0435 \u043C\u043E\u0436\u043D\u0430 \u0431\u0430\u0447\u0438\u0442\u0438
      \u043C\u0456\u0446\u043D\u0456\u0441\u0442\u044C \u0440\u043E\u0431\u043E-\u0441\u043E\u0432\u0438,
      \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F,
      \u0456 \u0457\u0457 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438.
      \u042F\u043A\u0449\u043E \u0440\u043E\u0431\u043E-\u0441\u043E\u0432\u0443
      \u043F\u043E\u0448\u043A\u043E\u0434\u044F\u0442\u044C \u0443 \u0431\u043E\u044E,
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0456\u0434\u0440\u0435\u043C\u043E\u043D\u0442\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u0442\u0430\u043A \u0441\u0430\u043C\u043E, \u044F\u043A \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0437\u0431\u0440\u043E\u044E \u0430\u0431\u043E \u0431\u0440\u043E\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241757
    m_Localized: "\u0421\u0445\u0435\u043C\u0430 \u0440\u043E\u0431\u043E-\u0441\u043E\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241758
    m_Localized: "\u0421\u0444\u0435\u0440\u0430 \u043F\u0430\u043C'\u044F\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241759
    m_Localized: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u043C\u0443
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456 \u043C\u0456\u0441\u0442\u044F\u0442\u044C\u0441\u044F
      \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u0456 \u0441\u043F\u043E\u0433\u0430\u0434\u0438
      \u0456\u043D\u0448\u0438\u0445 \u0456\u0441\u0442\u043E\u0442. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432\u0448\u0438
      \u0439\u043E\u0433\u043E, \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0435 \u043E\u0447\u043A\u043E
      \u043D\u0430\u0432\u0438\u0447\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241760
    m_Localized: "\u0412\u0438 \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u0441\u0444\u0435\u0440\u0443
      \u043F\u0430\u043C'\u044F\u0442\u0456 - \u043C\u0430\u0433\u0456\u0447\u043D\u0435
      \u0441\u0445\u043E\u0432\u0438\u0449\u0435 \u0441\u043F\u043E\u0433\u0430\u0434\u0456\u0432,
      \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0432\u0430\u0436\u043B\u0438\u0432\u0443
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E, \u0447\u0438\u0439\u0441\u044C
      \u0446\u0456\u043D\u043D\u0438\u0439 \u0434\u043E\u0441\u0432\u0456\u0434 \u0430\u0431\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0438
      \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E, \u044F\u043A\u0456 \u0445\u0442\u043E\u0441\u044C
      \u0437\u0430\u0445\u043E\u0442\u0456\u0432 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432\u0448\u0438 \u0457\u0457,
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0435
      \u043E\u0447\u043A\u043E \u043D\u0430\u0432\u0438\u0447\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241761
    m_Localized: "\u0426\u0456\u043A\u0430\u0432\u0430 \u043A\u043D\u0438\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241762
    m_Localized: "\u0412\u0438 \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u043A\u043D\u0438\u0436\u043A\u0443
      \u0432 \u0445\u043E\u0440\u043E\u0448\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456,
      \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u0434\u043B\u044F \u0432\u0430\u0441 \u0437\u043D\u0430\u043D\u043D\u044F.
      \u041E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435
      \u0457\u0457 - \u0437 \u043A\u043D\u0438\u0433 \u043C\u043E\u0436\u043D\u0430
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u043E\u0440\u0438\u0441\u043D\u043E\u0433\u043E, \u0442\u0438\u043C
      \u0441\u0430\u043C\u0438\u043C \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0432\u0448\u0438
      \u043E\u0434\u043D\u0443 \u0437\u0456 \u0441\u0432\u043E\u0457\u0445 \u043D\u0430\u0432\u0438\u0447\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241763
    m_Localized: "\u041D\u0430\u0431\u0456\u0440 \u043F\u0435\u0440\u0448\u043E\u0457
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241764
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u0430 \u0430\u043F\u0442\u0435\u0447\u043A\u0430
      \u0437 \u0443\u0441\u0456\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u043C
      \u0434\u043B\u044F \u043D\u0430\u0434\u0430\u043D\u043D\u044F \u043F\u0435\u0440\u0448\u043E\u0457
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438 \u0432 \u0440\u0430\u0437\u0456
      \u0442\u0440\u0430\u0432\u043C \u0456 \u043B\u0435\u0433\u043A\u0438\u0445
      \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u043E\u043B\u043E\u0434\u0456\u0442\u0438 \u0445\u043E\u0447\u0430 \u0431
      \u043C\u0456\u043D\u0456\u043C\u0430\u043B\u044C\u043D\u0438\u043C\u0438 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u043C\u0438
      \u0437\u043D\u0430\u043D\u043D\u044F\u043C\u0438 \u0440\u0456\u0432\u043D\u044F
      \u0441\u0430\u043D\u0456\u0442\u0430\u0440\u0430 \u0430\u0431\u043E \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u0438,
      \u0449\u043E\u0431 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241765
    m_Localized: "\u041B\u0456\u043A\u0430\u0440\u0441\u044C\u043A\u0438\u0439 \u0441\u0430\u043A\u0432\u043E\u044F\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241766
    m_Localized: "\u041C\u0456\u0441\u0442\u0438\u0442\u044C \u043D\u0430\u0431\u0456\u0440
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432, \u043B\u0456\u043A\u0456\u0432
      \u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u0437\u0456\u043B\u043B\u044F
      \u0434\u043B\u044F \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0456\u0432
      \u0442\u0430 \u0456\u043D\u0448\u0438\u0445 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0438\u0445
      \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u043E\u043B\u043E\u0434\u0456\u0442\u0438 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u043C\u0438
      \u0437\u043D\u0430\u043D\u043D\u044F\u043C\u0438 \u0445\u043E\u0447\u0430 \u0431
      \u043D\u0430 \u0440\u0456\u0432\u043D\u0456 \u0430\u0440\u043C\u0456\u0439\u0441\u044C\u043A\u043E\u0433\u043E
      \u0444\u0435\u043B\u044C\u0434\u0448\u0435\u0440\u0430, \u0449\u043E\u0431
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241767
    m_Localized: "\u0412\u0430\u043B\u0456\u0437\u0430 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u043E\u0433\u043E
      \u0445\u0456\u0440\u0443\u0440\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241768
    m_Localized: "\u041C\u0456\u0441\u0442\u0438\u0442\u044C \u0441\u043A\u043B\u0430\u0434\u043D\u0456
      \u043C\u0435\u0434\u0438\u0447\u043D\u0456 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438
      \u0442\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0434\u043B\u044F
      \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0430\u0439\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0445
      \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C. \u0417 \u0439\u043E\u0433\u043E
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u0438 \u043F\u0430\u0446\u0456\u0454\u043D\u0442\u0430
      \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0437 \u0442\u043E\u0433\u043E
      \u0441\u0432\u0456\u0442\u0443, \u0430\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043A\u0432\u0430\u043B\u0456\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u043E\u043C\u0443
      \u0456 \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u043E\u043C\u0443
      \u043B\u0456\u043A\u0430\u0440\u044E \u0446\u0435 \u043F\u0456\u0434 \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241769
    m_Localized: "\u041F\u0430\u043A\u0435\u0442 \u0456\u0437 \u043A\u0440\u043E\u0432'\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241770
    m_Localized: "\u041F\u0430\u043A\u0435\u0442\u0438\u043A \u0437 \u0443\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u044E
      \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u043D\u043E\u044E \u043A\u0440\u043E\u0432'\u044E,
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u043D\u043D\u044F
      \u0432\u0441\u0456\u043C \u0440\u0430\u0441\u0430\u043C \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241771
    m_Localized: "\u0420\u0430\u0434-\u0425"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241772
    m_Localized: "\u041F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456
      \u0436\u043E\u0432\u0442\u043E-\u0447\u0435\u0440\u0432\u043E\u043D\u0438\u0445
      \u043A\u0430\u043F\u0441\u0443\u043B, \u0449\u043E \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454 \u043E\u043F\u0456\u0440 \u043C\u0430\u0433\u0456\u0447\u043D\u0456\u0439
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0440\u0438\u0439\u043C\u0430\u0442\u0438 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F \u043C\u0456\u0441\u0446\u044C
      \u0456\u0437 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0438\u043C \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0439\u043D\u0438\u043C
      \u0444\u043E\u043D\u043E\u043C, \u0430\u043B\u0435 \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043E\u0434\u043D\u0456\u0454\u0457 \u043A\u0430\u043F\u0441\u0443\u043B\u0438
      \u0437\u0430 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241773
    m_Localized: "\u041C\u0456\u043D\u0442\u0430\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241774
    m_Localized: "\u041D\u0430\u0440\u043A\u043E\u0442\u0438\u043A\u0438 \u0443 \u0444\u043E\u0440\u043C\u0456
      \u0446\u0443\u043A\u0435\u0440\u043E\u043A \u0456\u0437 \u043C'\u044F\u0442\u043D\u0438\u043C
      \u0441\u043C\u0430\u043A\u043E\u043C. \u041F\u0456\u0441\u043B\u044F \u0457\u0445
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0430
      \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442, \u044F\u0441\u043D\u0456\u0441\u0442\u044C
      \u0440\u043E\u0437\u0443\u043C\u0443, \u0437\u0430\u0433\u043E\u0441\u0442\u0440\u044E\u044E\u0442\u044C\u0441\u044F
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F. \u0420\u043E\u0437\u043F\u043B\u0430\u0442\u043E\u044E
      \u0437\u0430 \u0446\u0435 \u0454 \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u0438\u0439
      \u0435\u0444\u0435\u043A\u0442 \u043F\u043E \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u044E
      \u0434\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241775
    m_Localized: "\u0421\u0432\u044F\u0442\u043A\u043E\u0432\u0456 \u043C\u0456\u043D\u0442\u0430\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241776
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0430 \u0432\u0435\u0440\u0441\u0456\u044F
      \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A, \u0449\u043E \u0434\u0430\u0454
      \u0437\u043D\u0430\u0447\u043D\u043E \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0439
      \u0435\u0444\u0435\u043A\u0442. \u041D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454
      \u0440\u043E\u0437\u0443\u043C\u043E\u0432\u0456 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456
      \u0442\u0430 \u0433\u043E\u0441\u0442\u0440\u043E\u0442\u0443 \u0432\u0441\u0456\u0445
      \u043F\u043E\u0447\u0443\u0442\u0442\u0456\u0432. \u0417 \u0435\u0444\u0435\u043A\u0442\u043E\u043C
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u043C\u0456\u043D\u0442\u0430\u043B\u043E\u043A
      \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241777
    m_Localized: "\u0414\u0435\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241778
    m_Localized: "\u041F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440,
      \u0449\u043E \u043D\u0430\u0434\u0456\u043B\u044F\u0454 \u0442\u043E\u0433\u043E,
      \u0445\u0442\u043E \u0439\u043E\u0433\u043E \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0432,
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F\u043C \u0443\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043E\u0433\u043E
      \u0441\u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0442\u044F \u0447\u0430\u0441\u0443.
      \u041F\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0456 \u0434\u0430\u0454 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456
      \u043E\u0447\u043A\u0438 \u0434\u0456\u0457 \u0432 \u0440\u0435\u0436\u0438\u043C\u0456
      \u0417.\u041F.\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241779
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430-\u0434\u0435\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241780
    m_Localized: "\u041F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0430 \u0432\u0435\u0440\u0441\u0456\u044F
      \u0434\u0435\u0448\u0430, \u0440\u043E\u0431\u0438\u0442\u044C \u0442\u043E\u0433\u043E,
      \u0445\u0442\u043E \u0439\u043E\u0433\u043E \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0432,
      \u0448\u0432\u0438\u0434\u043A\u0438\u043C, \u044F\u043A \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u0430.
      \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430, \u0454 \u043F\u0435\u0432\u043D\u0430
      \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C \u0440\u0430\u043F\u0442\u043E\u0432\u043E\u0457
      \u0441\u043C\u0435\u0440\u0442\u0456 \u0432\u0456\u0434 \u0441\u0435\u0440\u0446\u0435\u0432\u043E\u0433\u043E
      \u043D\u0430\u043F\u0430\u0434\u0443. \u0417 \u0435\u0444\u0435\u043A\u0442\u043E\u043C
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0448\u0430
      \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241781
    m_Localized: "\u0420\u0435\u0439\u0434\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241782
    m_Localized: "\u041D\u0430\u0440\u043A\u043E\u0442\u0438\u043A, \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0456 \u043C\u0430\u0441\u043E\u0432\u043E \u0432\u0438\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0437\u0430 \u0447\u0430\u0441\u0456\u0432 \u0412\u0435\u043B\u0438\u043A\u043E\u0457
      \u0412\u0456\u0439\u043D\u0438 \u0437 \u043C\u0435\u0442\u043E\u044E \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F
      \u0440\u0456\u0432\u043D\u044F \u0430\u0433\u0440\u0435\u0441\u0456\u0457 \u0456
      \u0437\u043B\u043E\u0431\u0438 \u0443 \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432.
      \u0412\u0432\u043E\u0434\u0438\u0442\u044C \u0442\u043E\u0433\u043E, \u0445\u0442\u043E
      \u0439\u043E\u0433\u043E \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0432,
      \u0443 \u0441\u0442\u0430\u043D \u0434\u0438\u043A\u043E\u0457 \u043B\u044E\u0442\u0456,
      \u0449\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u0448\u043A\u043E\u0434\u0443,
      \u044F\u043A\u0443 \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C \u0432\u043E\u0440\u043E\u0433\u043E\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241783
    m_Localized: "\u041C\u0435\u0434-\u0425"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241784
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u043E\u0434\u0456\u044E\u0447\u0438\u0439
      \u0437\u043D\u0435\u0431\u043E\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0438\u0439
      \u0437\u0430\u0441\u0456\u0431, \u0449\u043E \u0432\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u044C\u043E\u0432\u0435\u043D\u043D\u043E.
      \u041D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0447\u0430\u0441
      \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u043F\u043E\u0437\u0431\u0430\u0432\u0438\u0442\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0442\u0438 \u0431\u0456\u043B\u044C,
      \u0449\u043E \u0456\u043D\u043E\u0434\u0456 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0440\u044F\u043C\u043E \u0432 \u0431\u0438\u0442\u0432\u0456 \u0434\u043B\u044F
      \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F \u0431\u043E\u0439\u043E\u0432\u043E\u0457
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241785
    m_Localized: "\u0421\u0442\u0430\u043C\u043F\u0456\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241786
    m_Localized: "\u041D\u0430\u0440\u043A\u043E\u0442\u0438\u043A, \u0449\u043E
      \u043E\u0431'\u0454\u0434\u043D\u0443\u0454 \u0432 \u0441\u043E\u0431\u0456
      \u0435\u0444\u0435\u043A\u0442\u0438 \u0440\u0435\u0439\u0434\u0436\u0443 \u0456
      \u043C\u0435\u0434-\u0456\u043A\u0441\u0443. \u0412\u0438\u043A\u043B\u0438\u043A\u0430\u0454
      \u0443 \u0442\u043E\u0433\u043E, \u0445\u0442\u043E \u0439\u043E\u0433\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0432, \u043D\u0435\u0441\u0442\u0440\u0438\u043C\u043D\u0443
      \u043B\u044E\u0442\u044C, \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u044F\u044E\u0447\u0438 \u0439\u043E\u0433\u043E
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F \u0431\u043E\u043B\u044E \u0442\u0430
      \u0456\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u0443 \u0441\u0430\u043C\u043E\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F,
      \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u044C \u0439\u043E\u0433\u043E
      \u043D\u0430 \u043F\u043E\u043B\u0456 \u0431\u043E\u044E \u0432\u043A\u0440\u0430\u0439
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C \u0456 \u0432\u0431\u0438\u0432\u0447\u043E
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u043C. \u041D\u0435
      \u0441\u0443\u043C\u0456\u0441\u043D\u0438\u0439 \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C
      \u0440\u0435\u0439\u0434\u0436\u0435\u043C \u0456 \u043C\u0435\u0434-\u0456\u043A\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241787
    m_Localized: "\u0411\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241788
    m_Localized: "\u0421\u0442\u0435\u0440\u043E\u0457\u0434\u043D\u0438\u0439 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442
      \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456 \u0442\u0430\u0431\u043B\u0435\u0442\u043E\u043A
      \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u043E\u0440\u0443,
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0434\u043B\u044F
      \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438 \u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456.
      \u0414\u0430\u0454 \u043C\u0438\u0442\u0442\u0454\u0432\u0438\u0439 \u0435\u0444\u0435\u043A\u0442,
      \u0445\u043E\u0447\u0430 \u0439 \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241789
    m_Localized: "\u0413\u0456\u0434\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241790
    m_Localized: "\u041B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0437 \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u044E \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044E,
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0430\u043D\u0435 \u0437 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F\u043C
      \u0435\u0441\u0435\u043D\u0446\u0456\u0457 \u0437\u0456 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0457
      \u0433\u0456\u0434\u0440\u0438. \u0423 \u0441\u043E\u0442\u043D\u0456 \u0440\u0430\u0437\u0456\u0432
      \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0454 \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0456\u044E
      \u0436\u0438\u0432\u0438\u0445 \u0442\u043A\u0430\u043D\u0438\u043D, \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0447\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0456 \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F,
      \u0430\u043B\u0435 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435
      \u0442\u0438\u043C, \u0449\u043E \u043C\u043E\u0436\u0435 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
      \u0432 \u0442\u043E\u0433\u043E, \u0445\u0442\u043E \u0439\u043E\u0433\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454, \u0436\u0430\u0445\u043B\u0438\u0432\u0456
      \u043C\u0443\u0442\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241791
    m_Localized: "\u0414\u0435\u0442\u043E\u043A\u0441\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241792
    m_Localized: "\u0420\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439 \u0456 \u0434\u043E\u0440\u043E\u0433\u0438\u0439
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442, \u0449\u043E \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0430\u0440\u043A\u043E\u043C\u0430\u043D\u0456\u0457.
      \u041C\u0438\u0442\u0442\u0454\u0432\u043E \u0443\u0441\u0443\u0432\u0430\u0454
      \u0432\u0441\u0456 \u0435\u0444\u0435\u043A\u0442\u0438 \u0432\u0456\u0434
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0445\u0456\u043C\u0456\u0457,
      \u044F\u043A \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u0456, \u0442\u0430\u043A
      \u0456 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u0456, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u043E\u0447\u0438\u0449\u0430\u0454 \u0432\u0456\u0434 \u043E\u0442\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241793
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u0441\u0443\u043F\u0435\u0440-\u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241794
    m_Localized: "\u041C\u0438\u0442\u0442\u0454\u0432\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      \u0436\u0438\u0442\u0442\u0454\u0432\u0443 \u0435\u043D\u0435\u0440\u0433\u0456\u044E.
      \u0425\u043E\u0447\u0430 \u0446\u0435 \u0437\u0456\u043B\u043B\u044F \u0456
      \u0437\u0434\u0430\u0442\u043D\u0435 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F \u0432 \u043D\u0430\u0439\u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0456\u0448\u0456\u0439
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457, \u0432\u043E\u043D\u043E
      \u0434\u0443\u0436\u0435 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241795
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043F\u043E\u043B\u044C\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241796
    m_Localized: "\u0423 \u0442\u043E\u0433\u043E, \u0445\u0442\u043E \u0432\u0438\u043F'\u0454
      \u0446\u0435 \u0437\u0456\u043B\u043B\u044F, \u0437'\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u043A\u0440\u0438\u043B\u0430, \u0456 \u0432\u0456\u043D \u0437\u043C\u043E\u0436\u0435
      \u043B\u0456\u0442\u0430\u0442\u0438. \u0415\u0444\u0435\u043A\u0442 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241797
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u0442\u0456\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241798
    m_Localized: "\u0422\u043E\u0439, \u0445\u0442\u043E \u0432\u0438\u043F\u0438\u0432
      \u0446\u0435 \u0437\u0456\u043B\u043B\u044F, \u043D\u0430 \u0434\u0435\u044F\u043A\u0438\u0439
      \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0456\u043D\u044C. \u041F\u043E\u043A\u0438 \u0432\u0456\u043D
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456, \u0432\u043E\u0440\u043E\u0433\u0430\u043C
      \u0431\u0443\u0434\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
      \u0439\u043E\u0433\u043E \u0456 \u0437\u0430\u043F\u043E\u0434\u0456\u044F\u0442\u0438
      \u0448\u043A\u043E\u0434\u0443, \u0430\u043B\u0435 \u0456 \u0432\u0456\u043D
      \u0441\u0430\u043C \u043D\u0435 \u0437\u043C\u043E\u0436\u0435 \u0437\u0430\u0432\u0434\u0430\u0442\u0438
      \u0448\u043A\u043E\u0434\u0438 \u0457\u043C. \u0422\u0430\u043A\u043E\u0436,
      \u0441\u0445\u043E\u0436\u0435, \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0441\u043B\u0430\u0431\u043B\u044E\u0454\u0442\u044C\u0441\u044F
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u043E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443
      \u0432 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241799
    m_Localized: "\u0427\u0430\u0440\u043E\u0434\u0456\u0439\u0441\u044C\u043A\u0435
      \u0437\u0456\u043B\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241800
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u0437\u043C\u0435\u043D\u0448\u0443\u0454
      \u0432\u0438\u0442\u0440\u0430\u0442\u0443 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457 \u043D\u0430 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437
      \u0456 \u0440\u0456\u0437\u043D\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454 \u0457\u0445\u043D\u044E \u0441\u0438\u043B\u0443,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0454
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241801
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u0456\u043D\u0444\u0440\u0430\u0437\u043E\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241802
    m_Localized: "\u041D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0447\u0430\u0441
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0431\u0430\u0447\u0438\u0442\u0438
      \u043A\u0440\u0456\u0437\u044C \u0441\u0442\u0456\u043D\u0438, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0431\u0430\u0447\u0438\u0442\u0438 \u0437\u0430\u0445\u043E\u0432\u0430\u043D\u0435
      \u0456 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0435 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241803
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043F\u0456\u0440\u043D\u0430\u043B\u044C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241804
    m_Localized: "\u041F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u043F'\u044F\u0442\u0438
      \u0445\u0432\u0438\u043B\u0438\u043D \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443
      \u0434\u0438\u0445\u0430\u0442\u0438 \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E
      \u0456 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0448\u0432\u0438\u0434\u0448\u0435
      \u043F\u043B\u0430\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241805
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0435 \u0437\u0456\u043B\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241806
    m_Localized: "\u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u0445\u043E\u0447\u0430
      \u0431 \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0432\u0456\u0434 \u0437\u0433\u0443\u0431\u043D\u043E\u0433\u043E
      \u0432\u043F\u043B\u0438\u0432\u0443 \u0420\u043E\u0436\u0435\u0432\u043E\u0457
      \u0425\u043C\u0430\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241807
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u0448\u0430\u043D\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241808
    m_Localized: "\u042F\u043A\u0449\u043E \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C
      \u0434\u0456\u0457 \u0446\u044C\u043E\u0433\u043E \u0437\u0456\u043B\u043B\u044F
      \u0432\u0430\u043C \u0431\u0443\u0434\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043E
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0443,
      \u0432\u0438 \u043D\u0430 5 \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0456 \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F. \u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442 \u043D\u0435 \u0440\u044F\u0442\u0443\u0454
      \u0432\u0456\u0434 \u043E\u0442\u0440\u0443\u0442\u0438 \u0442\u0430 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241809
    m_Localized: "\u041A\u043E\u0441\u044F\u043A \u0456\u0437 \u0447\u0430\u0440\u0456\u0432\u043D\u043E\u0457
      \u0442\u0440\u0430\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241810
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u0443\u0440\u0438\u0442\u0438.
      \u0414\u0456\u044F \u043D\u0435\u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0443\u0432\u0430\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241811
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0441\u0442\u0456\u0439\u043A\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241812
    m_Localized: "\u041F\u0456\u0434 \u0434\u0456\u0454\u044E \u0446\u044C\u043E\u0433\u043E
      \u0437\u0456\u043B\u043B\u044F \u0432\u0430\u0448\u0456 \u043A\u0456\u0441\u0442\u043A\u0438
      \u0441\u0442\u0430\u043D\u0443\u0442\u044C \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u043C\u0438
      \u0456 \u0431\u0443\u0434\u0443\u0442\u044C \u0437\u0434\u0430\u0442\u043D\u0456
      \u0432\u0438\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0456
      \u043D\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F. \u0415\u0444\u0435\u043A\u0442
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241813
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0456\u043C\u0443\u043D\u0456\u0442\u0435\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241814
    m_Localized: "\u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u043F\u043E\u0441\u0438\u043B\u0438\u0442\u044C
      \u0432\u0430\u0448\u0443 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u0447\u0438\u043D\u0438\u0442\u0438 \u043E\u043F\u0456\u0440 \u0440\u0456\u0437\u043D\u0438\u043C
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u0438\u043C \u0444\u0430\u043A\u0442\u043E\u0440\u0430\u043C,
      \u0442\u0430\u043A\u0438\u043C \u044F\u043A \u043E\u0442\u0440\u0443\u0454\u043D\u043D\u044F,
      \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0430 \u0442\u0430 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u044F.
      \u0415\u0444\u0435\u043A\u0442 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241815
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u043C\u043E\u0433\u0443\u0442\u043D\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241816
    m_Localized: "\u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u0442\u044C
      \u0432\u0430\u0448\u0456 \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u0438 \u0442\u0430
      \u043F\u043E\u0441\u0438\u043B\u0438\u0442\u044C \u0430\u0433\u0440\u0435\u0441\u0456\u044E.
      \u0412\u0438 \u0441\u0442\u0430\u043D\u0435\u0442\u0435 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E. \u0415\u0444\u0435\u043A\u0442 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241817
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241818
    m_Localized: "\u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u044C
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0431\u0456\u0433\u0443
      \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u044C \u0437\u0430\u043F\u0430\u0441
      \u0441\u0438\u043B. \u0412\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0431\u0456\u0433\u0442\u0438 \u0448\u0432\u0438\u0434\u0448\u0435 \u0456
      \u0434\u043E\u0432\u0448\u0435. \u0415\u0444\u0435\u043A\u0442 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241819
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241820
    m_Localized: "\u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u0437\u043C\u0456\u0446\u043D\u0438\u0442\u044C
      \u0432\u0430\u0448\u0443 \u043D\u0435\u0440\u0432\u043E\u0432\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443
      \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u044C \u0433\u043E\u0441\u0442\u0440\u043E\u0442\u0443
      \u0437\u043E\u0440\u0443, \u0449\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u044C
      \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C \u043F\u0440\u0438 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0456.
      \u0415\u0444\u0435\u043A\u0442 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241821
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0456\u043D\u0442\u0443\u0457\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241822
    m_Localized: "\u0426\u0435 \u0437\u0456\u043B\u043B\u044F \u043D\u0430\u0434\u0456\u043B\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044E \u043F\u0435\u0432\u043D\u043E\u044E
      \u043C\u0456\u0440\u043E\u044E \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0442\u0438
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0435 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454
      \u0456 \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u043D\u043E\u043C \u0443\u043D\u0438\u043A\u0430\u0442\u0438
      \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F \u0432 \u0432\u0430\u0441
      \u0432\u043E\u0440\u043E\u0436\u0438\u0445 \u043A\u0443\u043B\u044C. \u0415\u0444\u0435\u043A\u0442
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241823
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0443\u0434\u0430\u0447\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241824
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u0449\u043E \u0434\u0430\u0454 \u0446\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0456 \u044F\u043A \u0441\u0430\u043C\u0435 \u0432\u043E\u043D\u043E \u043F\u0440\u0430\u0446\u044E\u0454,
      \u0430\u043B\u0435 \u0437 \u043D\u0438\u043C \u0432\u0430\u0448\u0456 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F
      \u0434\u0435\u0434\u0430\u043B\u0456 \u0447\u0430\u0441\u0442\u0456\u0448\u0435
      \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438.
      \u0415\u0444\u0435\u043A\u0442 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241825
    m_Localized: "\u0415\u043B\u0456\u043A\u0441\u0438\u0440 \u0441\u0442\u0438\u0445\u0456\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241826
    m_Localized: "\u0417\u0456\u043B\u043B\u044F, \u0432\u0438\u043D\u0430\u0439\u0434\u0435\u043D\u0435
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430\u043C\u0438 \u0432 \u0434\u0430\u043B\u0435\u043A\u043E\u043C\u0443
      \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443. \u0417\u043C\u0456\u0446\u043D\u044E\u0454
      \u0437\u0432'\u044F\u0437\u043E\u043A \u043C\u0430\u0433\u0430 \u0437 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0438\u043C\u0438
      \u0441\u0438\u043B\u0430\u043C\u0438, \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C \u0439\u043E\u0433\u043E
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241827
    m_Localized: "\u0417\u0456\u043B\u043B\u044F \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241828
    m_Localized: "\u041F\u043E\u0437\u0431\u0430\u0432\u043B\u044F\u0454 \u0432\u0456\u0434
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241829
    m_Localized: "\u0421\u043F\u0430\u0440\u043A\u043B-\u041A\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241830
    m_Localized: "\u041D\u0430\u0439\u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0456\u0448\u0438\u0439
      \u0431\u0435\u0437\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0438\u0439
      \u0433\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0439 \u043D\u0430\u043F\u0456\u0439
      \u0437\u0456 \u0441\u043C\u0430\u043A\u043E\u043C \u043C\u043E\u0440\u043A\u0432\u0438.
      \u0421\u043F\u0440\u0438\u044F\u0454 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044E
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241831
    m_Localized: "\u0421\u0432\u0456\u0442\u0430\u043D\u043A\u043E\u0432\u0430 \u0421\u0430\u0440\u0441\u0430\u043F\u0430\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241832
    m_Localized: "\u0411\u0435\u0437\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0438\u0439
      \u0433\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0439 \u043D\u0430\u043F\u0456\u0439,
      \u0432\u0438\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u0434\u043E \u0412\u0456\u0439\u043D\u0438.
      \u0412\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241833
    m_Localized: "\u0420\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0435
      \u043F\u0435\u0447\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241834
    m_Localized: "\u0407\u0441\u0442\u0438 \u0446\u044E \u0448\u0442\u0443\u043A\u0443
      \u0432\u043A\u0440\u0430\u0439 \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F.
      \u0410\u043B\u0435, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u044C\u0441\u044F
      \u0445\u0442\u043E\u0441\u044C, \u043A\u043E\u043C\u0443 \u0432\u043E\u043D\u0430
      \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241835
    m_Localized: "\u0421\u043F\u0430\u0440\u043A\u043B-\u041A\u043E\u043B\u0430 \u0420\u0410\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241836
    m_Localized: "\u0420\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439 \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434
      \u0421\u043F\u0430\u0440\u043A\u043B-\u041A\u043E\u043B\u0438, \u0434\u043E
      \u0441\u043A\u043B\u0430\u0434\u0443 \u044F\u043A\u043E\u0457 \u0432\u0445\u043E\u0434\u044F\u0442\u044C
      \u0440\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0456 \u0440\u0435\u0447\u043E\u0432\u0438\u043D\u0438.
      \u041C\u0430\u0454 \u0441\u043C\u0430\u043A \u0440\u0435\u0434\u0438\u0441\u043A\u0438
      \u0442\u0430 \u0441\u0432\u0456\u0442\u0438\u0442\u044C\u0441\u044F \u0432
      \u0442\u0435\u043C\u0440\u044F\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241837
    m_Localized: "\u041A\u0430\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241838
    m_Localized: "\u0421\u043C\u0430\u0447\u043D\u0438\u0439 \u0456 \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0439
      \u043D\u0430\u043F\u0456\u0439 \u0456\u0437 \u043B\u0435\u0433\u043A\u043E\u044E
      \u0441\u0442\u0438\u043C\u0443\u043B\u044E\u044E\u0447\u043E\u044E \u0434\u0456\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241839
    m_Localized: "\u041C\u043E\u043B\u043E\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241840
    m_Localized: "\u0421\u0432\u0456\u0436\u0435 \u043C\u043E\u043B\u043E\u043A\u043E
      \u0431\u0440\u0430\u043C\u0456\u043D\u0430, \u0432\u0438\u0432\u043E\u0434\u0438\u0442\u044C
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241841
    m_Localized: "\u041F\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241842
    m_Localized: "\u0421\u043B\u0430\u0431\u043E\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0438\u0439
      \u043D\u0430\u043F\u0456\u0439, \u0432\u0438\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0456\u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0433\u043E \u0432\u0456\u0432\u0441\u0430.
      \u041D\u0430 \u0441\u043C\u0430\u043A \u043D\u0435 \u0434\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241843
    m_Localized: "\u0411\u0440\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241844
    m_Localized: "\u0421\u043B\u0430\u0431\u043E\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0438\u0439
      \u043D\u0430\u043F\u0456\u0439 \u0456\u0437 \u043A\u0430\u0440\u0442\u043E\u043F\u043B\u0456.
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0432\u0438\u0448\u0443\u043A\u0430\u043D\u0438\u043C
      \u0441\u043C\u0430\u043A\u043E\u043C \u043D\u0435 \u0432\u0438\u0440\u0456\u0437\u043D\u044F\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241845
    m_Localized: "\u041D\u0430\u043B\u0438\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241846
    m_Localized: "\u0410\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0438\u0439
      \u043D\u0430\u043F\u0456\u0439 \u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0457
      \u043C\u0456\u0446\u043D\u043E\u0441\u0442\u0456 \u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445
      \u0444\u0440\u0443\u043A\u0442\u0456\u0432 \u0430\u0431\u043E \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0437\u0430\u0440\u0430\u0437 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u043D\u0438\u0445. \u0414\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u0438\u0454\u043C\u043D\u0438\u0439
      \u043D\u0430 \u0441\u043C\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241847
    m_Localized: "\u0428\u043D\u0430\u043F\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241848
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u043C\u0456\u0446\u043D\u0438\u0439
      \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0438\u0439 \u043D\u0430\u043F\u0456\u0439,
      \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0438\u0439 \u0448\u043B\u044F\u0445\u043E\u043C
      \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241849
    m_Localized: "\u0421\u0430\u043C\u043E\u0433\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241850
    m_Localized: "\u042F\u0434\u0440\u0435\u043D\u0435 \u043F\u0456\u0439\u043B\u043E,
      \u0449\u043E \u0432\u0456\u0434\u0434\u0430\u0454 \u0441\u0438\u0432\u0443\u0445\u043E\u044E.
      \u0414\u043B\u044F \u043E\u0445\u043E\u0447\u0438\u0445 \u0432\u043F\u0438\u0442\u0438\u0441\u044F
      \u0432 \u043C\u043E\u0442\u043B\u043E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241851
    m_Localized: "\u0421\u043F\u0438\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241852
    m_Localized: "\u041C\u0430\u0439\u0436\u0435 \u0447\u0438\u0441\u0442\u0438\u0439
      \u0441\u043F\u0438\u0440\u0442, \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u0439
      \u0456 \u0434\u043E\u0441\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241853
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u0441\u0438\u0434\u0440
      \"\u0421\u0442\u0430\u0440\u0430 \u0444\u0435\u0440\u043C\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241854
    m_Localized: "\u0421\u0438\u0434\u0440 \u043D\u0430\u0439\u0432\u0438\u0449\u043E\u0457
      \u044F\u043A\u043E\u0441\u0442\u0456 \u0437 \u0442\u043E\u043D\u043A\u0438\u043C
      \u0441\u043C\u0430\u043A\u043E\u043C \u0456 \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241855
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0435 \u0432\u0438\u043D\u043E
      \"\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u0437\u0430\u0445\u0456\u0434\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241856
    m_Localized: "\u0420\u0456\u0434\u043A\u0456\u0441\u043D\u0435 \u0440\u043E\u0436\u0435\u0432\u0435
      \u0432\u0438\u043D\u043E \u0434\u043B\u044F \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u043F\u043E\u0446\u0456\u043D\u043E\u0432\u0443\u0432\u0430\u0447\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241857
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u043B\u0456\u043A\u0435\u0440
      \"\u0410\u0440\u043E\u043C\u0430\u0442\u0438 \u043B\u0456\u0442\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241858
    m_Localized: "\u041A\u0440\u0456\u043C \u044F\u0431\u043B\u0443\u043A, \u0434\u043E
      \u0441\u043A\u043B\u0430\u0434\u0443 \u0446\u044C\u043E\u0433\u043E \u043B\u0456\u043A\u0435\u0440\u0443
      \u0432\u0445\u043E\u0434\u0438\u0442\u044C \u0449\u0435 \u0434\u0435\u0441\u044F\u0442\u043E\u043A
      \u0432\u0438\u0434\u0456\u0432 \u0440\u0456\u0437\u043D\u0438\u0445 \u0444\u0440\u0443\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241859
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0435 \u0432\u0456\u0441\u043A\u0456
      \"\u0414\u0438\u043A\u0438\u0439 \u043F\u0435\u0433\u0430\u0441\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241860
    m_Localized: "\u041F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0438\u0439 \u0434\u043E
      \u0412\u0456\u0439\u043D\u0438 \u0441\u043E\u0440\u0442 \u0432\u0456\u0441\u043A\u0456,
      \u043D\u0438\u043D\u0456 \u043C\u0430\u0454 \u0434\u0432\u043E\u0445\u0441\u043E\u0442\u0440\u0456\u0447\u043D\u0443
      \u0432\u0438\u0442\u0440\u0438\u043C\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241861
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0430 \u0433\u043E\u0440\u0456\u043B\u043A\u0430
      \"\u041A\u0440\u0438\u0448\u0442\u0430\u043B\u0435\u0432\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241862
    m_Localized: "\u0415\u043B\u0456\u0442\u043D\u0438\u0439 \u0441\u043E\u0440\u0442
      \u0433\u043E\u0440\u0456\u043B\u043A\u0438, \u0434\u043E \u0412\u0456\u0439\u043D\u0438
      \u043A\u043E\u0448\u0442\u0443\u0432\u0430\u0432 \u0447\u0438\u043C\u0430\u043B\u0438\u0445
      \u0433\u0440\u043E\u0448\u0435\u0439. \u041E\u0447\u0438\u0449\u0435\u043D\u0430
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0456\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241863
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u043A\u0430
      \u0411\u0430\u0431\u0443\u0441\u0456 \u0421\u043C\u0456\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241864
    m_Localized: "\u041A\u0430\u0436\u0443\u0442\u044C, \u0449\u043E \u0437\u0430
      \u043C\u0438\u043D\u0443\u043B\u0438\u0439 \u0447\u0430\u0441 \u0446\u044F
      \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u043A\u0430 \u043D\u0430\u0431\u0443\u043B\u0430
      \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043D\u0435\u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E
      \u0441\u043C\u0430\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241865
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u0431\u0430\u043B\u044C\u0437\u0430\u043C
      \"\u0414\u0430\u0440 \u043F\u0440\u0438\u0440\u043E\u0434\u0438\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241866
    m_Localized: "\"\u041B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0439\"
      \u0431\u0430\u043B\u044C\u0437\u0430\u043C \u0456\u0437 \u044F\u0431\u043B\u0443\u043A,
      \u0434\u0432\u0430\u0434\u0446\u044F\u0442\u0438 \u0447\u043E\u0442\u0438\u0440\u044C\u043E\u0445
      \u0432\u0438\u0434\u0456\u0432 \u0442\u0440\u0430\u0432 \u0456 \u043C\u0435\u0434\u0438\u0447\u043D\u043E\u0433\u043E
      \u0441\u043F\u0438\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241867
    m_Localized: "\u041B\u043E\u043A\u0448\u0438\u043D\u0430 \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E
      \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241868
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u0437\u0430\u043B\u0438\u0442\u0438
      \u0433\u0430\u0440\u044F\u0447\u043E\u044E \u0432\u043E\u0434\u043E\u044E \u0430\u0431\u043E
      \u0436 \u0437'\u0457\u0441\u0442\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241869
    m_Localized: "\u041C\u0430\u043A\u0430\u0440\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241870
    m_Localized: "\u0417 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u0430 \u0449\u043E\u0441\u044C
      \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438 \u0430\u0431\u043E
      \u0437\u0436\u0443\u0432\u0430\u0442\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241871
    m_Localized: "\u041A\u043E\u043D\u0441\u0435\u0440\u0432\u043E\u0432\u0430\u043D\u0430
      \u043A\u0443\u043A\u0443\u0440\u0443\u0434\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241872
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u0441\u043C\u0430\u0447\u043D\u0430,
      \u0441\u043E\u043B\u043E\u0434\u043A\u0430 \u0442\u0430 \u043F\u043E\u0436\u0438\u0432\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241873
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u0438\u0439 \u043E\u0431\u0456\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241874
    m_Localized: "\u041D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430
      \u0441\u0456\u0440\u0430 \u043C\u0430\u0441\u0430 \u0437\u0456 \u0449\u0435
      \u0431\u0456\u043B\u044C\u0448 \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438\u043C\u0438
      \u0448\u043C\u0430\u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u0447\u043E\u0433\u043E\u0441\u044C,
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0441\u0443\u0448\u0435\u043D\u0438\u0445
      \u043E\u0432\u043E\u0447\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241875
    m_Localized: "\u041A\u043E\u043D\u0441\u0435\u0440\u0432\u043E\u0432\u0430\u043D\u0456
      \u0431\u043E\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241876
    m_Localized: "\u0407\u0436\u0430, \u0431\u0430\u0433\u0430\u0442\u0430 \u043D\u0430
      \u0440\u043E\u0441\u043B\u0438\u043D\u043D\u0438\u0439 \u0431\u0456\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241877
    m_Localized: "\u0425\u043B\u0456\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241878
    m_Localized: "\u0412\u0456\u0434\u043D\u043E\u0441\u043D\u043E \u0441\u0432\u0456\u0436\u0438\u0439
      \u0445\u043B\u0456\u0431, \u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0439
      \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0442\u0438\u0436\u043D\u044F
      \u0442\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241879
    m_Localized: "\u041E\u0432\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241880
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u0437'\u0457\u0441\u0442\u0438
      \u0456 \u0442\u0430\u043A, \u0430\u043B\u0435 \u043A\u0440\u0430\u0449\u0435
      \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241881
    m_Localized: "\u0427\u0456\u043F\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241882
    m_Localized: "\u0414\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043A\u0430\u0440\u0442\u043E\u043F\u043B\u044F\u043D\u0456
      \u0447\u0456\u043F\u0441\u0438 \u0437\u0456 \u0441\u043C\u0430\u043A\u043E\u043C
      \u0433\u043E\u0441\u0442\u0440\u043E\u0433\u043E \u0445\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241883
    m_Localized: "\u0411\u0456\u043B\u044F\u0447\u0456 \u0441\u0443\u0445\u0430\u0440\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241884
    m_Localized: "\u0421\u0443\u0445\u0430\u0440\u0438\u043A\u0438 \u0437\u0456 \u0441\u043C\u0430\u043A\u043E\u043C
      \u0449\u0430\u0432\u043B\u044E, \u0442\u0430\u043A\u0456 \u0441\u0443\u0445\u0456,
      \u0449\u043E \u043D\u0438\u043C\u0438 \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438
      \u0431\u0430\u0433\u0430\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241885
    m_Localized: "\u0413\u043E\u0440\u0456\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241886
    m_Localized: "\u0421\u0443\u043C\u0456\u0448 \u0433\u043E\u0440\u0456\u0445\u0456\u0432
      \u0443 \u043F\u0430\u043A\u0435\u0442\u0438\u043A\u0443, \u0449\u043E \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E
      \u044F\u043A \u0437\u0431\u0435\u0440\u0435\u0433\u043B\u0430\u0441\u044F \u0437
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445 \u0447\u0430\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241887
    m_Localized: "\u0426\u0443\u043A\u0440\u043E\u0432\u0456 \u0431\u043E\u043C\u0431\u043E\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241888
    m_Localized: "\u0421\u043E\u043B\u043E\u0434\u043A\u0456 \u043A\u0443\u043A\u0443\u0440\u0443\u0434\u0437\u044F\u043D\u0456
      \u043F\u043B\u0430\u0441\u0442\u0456\u0432\u0446\u0456 \u0443 \u0444\u043E\u0440\u043C\u0456
      \u0430\u0432\u0456\u0430\u0431\u043E\u043C\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241889
    m_Localized: "\u041B\u044C\u043E\u0434\u044F\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241890
    m_Localized: "\u0414\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0439 \u0434\u0435\u043B\u0456\u043A\u0430\u0442\u0435\u0441,
      \u0441\u043C\u0430\u0447\u043D\u0456 \u043A\u0438\u0441\u043B\u043E-\u0441\u043E\u043B\u043E\u0434\u043A\u0456
      \u0446\u0443\u043A\u0435\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241891
    m_Localized: "\u0421\u0443\u0448\u0435\u043D\u0456 \u0431\u0430\u043D\u0430\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241892
    m_Localized: "\u041B\u0430\u0441\u043E\u0449\u0456 \u0437 \u043A\u0440\u0430\u0457\u043D\u0438
      \u0437\u0435\u0431\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241893
    m_Localized: "\u0425\u0430\u043B\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241894
    m_Localized: "\u0421\u043E\u043B\u043E\u0434\u043A\u0430 \u043C\u0430\u0441\u0430
      \u0437 \u043F\u0435\u0440\u0435\u0442\u0435\u0440\u0442\u043E\u0433\u043E \u0430\u0440\u0430\u0445\u0456\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241895
    m_Localized: "\u041C\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241896
    m_Localized: "\u041C\u0435\u0434 \u043C\u043E\u0436\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u0441\u044F
      \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432, \u0430\u043B\u0435
      \u043E\u0441\u044C \u043D\u043E\u0432\u043E\u0433\u043E \u043C\u0435\u0434\u0443
      \u043D\u0435 \u0431\u0443\u0434\u0435, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u0432\u0436\u0435 \u043D\u0456\u043A\u043E\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241897
    m_Localized: "\u042F\u0431\u043B\u0443\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241898
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0436\u043D\u0454 \u044F\u0431\u043B\u0443\u043A\u043E,
      \u0432\u0438\u0440\u043E\u0449\u0435\u043D\u0435 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241899
    m_Localized: "\u041F\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u0433\u0440\u0438\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241900
    m_Localized: "\u0413\u0440\u0438\u0431 \u0441\u0443\u043C\u043D\u0456\u0432\u043D\u043E\u0457
      \u0457\u0441\u0442\u0456\u0432\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241901
    m_Localized: "\u041C\u043E\u0440\u043A\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241902
    m_Localized: "\u0421\u043E\u043B\u043E\u0434\u043A\u0438\u0439 \u0456 \u0442\u0432\u0435\u0440\u0434\u0438\u0439
      \u043A\u043E\u0440\u0435\u043D\u0435\u043F\u043B\u0456\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241903
    m_Localized: "\u0426\u0438\u0431\u0443\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241904
    m_Localized: "\u0413\u0456\u0440\u043A\u0438\u0439 \u043E\u0432\u043E\u0447,
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u0441\u0442\u0440\u0430\u0432\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241905
    m_Localized: "\u041F\u043E\u043C\u0456\u0434\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241906
    m_Localized: "\u0421\u043C\u0430\u0447\u043D\u0438\u0439 \u043A\u0438\u0441\u043B\u0443\u0432\u0430\u0442\u0438\u0439
      \u043E\u0432\u043E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241907
    m_Localized: "\u041E\u0433\u0456\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241908
    m_Localized: "\u0417\u0435\u043B\u0435\u043D\u0438\u0439 \u0432\u043E\u0434\u044F\u043D\u0438\u0441\u0442\u0438\u0439
      \u043E\u0432\u043E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241909
    m_Localized: "\u041A\u0430\u043F\u0443\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241910
    m_Localized: "\u0421\u043E\u043A\u043E\u0432\u0438\u0442\u0438\u0439 \u0456 \u0432\u043E\u043B\u043E\u043A\u043D\u0438\u0441\u0442\u0438\u0439
      \u043E\u0432\u043E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241911
    m_Localized: "\u041C\u0430\u0441\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241912
    m_Localized: "\u0421\u0432\u0456\u0436\u0435 \u043C\u0430\u0441\u043B\u043E \u0437
      \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0457 \u0444\u0435\u0440\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241913
    m_Localized: "\u0421\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241914
    m_Localized: "\u0421\u0432\u0456\u0436\u0438\u0439 \u0441\u0438\u0440, \u043C\u0430\u0454
      \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434
      \u0456 \u0441\u043C\u0430\u0447\u043D\u043E \u043F\u0430\u0445\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241915
    m_Localized: "\u042F\u0439\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241916
    m_Localized: "\u0411\u0456\u043B\u044C\u0448\u0435 \u0441\u0445\u043E\u0436\u0435
      \u043D\u0430 \u044F\u0439\u0446\u0435 \u044F\u043A\u043E\u0457\u0441\u044C
      \u0440\u0435\u043F\u0442\u0438\u043B\u0456\u0457, \u043D\u0456\u0436 \u043D\u0430
      \u043F\u0442\u0430\u0448\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241917
    m_Localized: "\u041C'\u044F\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241918
    m_Localized: "\u0421\u0438\u0440\u0435 \u043C'\u044F\u0441\u043E \u0432\u0436\u0438\u0432\u0430\u0442\u0438
      \u0432 \u0457\u0436\u0443 \u0432\u043A\u0440\u0430\u0439 \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241919
    m_Localized: "\u041A\u0430\u0440\u0442\u043E\u043F\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241920
    m_Localized: "\u041F\u043E\u0436\u0438\u0432\u043D\u0456 \u0431\u0443\u043B\u044C\u0431\u0438,
      \u0432 \u0441\u0438\u0440\u043E\u043C\u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043D\u0435 \u0432\u0436\u0438\u0432\u0430\u044E\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241921
    m_Localized: "\u0411\u043E\u0440\u043E\u0448\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241922
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0438\u0439 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0432\u0438\u043F\u0456\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241923
    m_Localized: "\u0427\u0430\u0441\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241924
    m_Localized: "\u0414\u0443\u0436\u0435 \u0433\u043E\u0441\u0442\u0440\u0438\u0439
      \u0456 \u043F\u0430\u0445\u0443\u0447\u0438\u0439 \u043E\u0432\u043E\u0447,
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u044F\u043A \u043F\u0440\u0438\u043F\u0440\u0430\u0432\u0430 \u0456 \u044F\u043A
      \u0445\u0456\u043C\u0456\u0447\u043D\u0430 \u0437\u0431\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241925
    m_Localized: "\u0426\u0443\u043A\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241926
    m_Localized: "\u0426\u0443\u043A\u043E\u0440 \u043D\u0438\u043D\u0456 \u0432\u0436\u0435
      \u043D\u0435 \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u044E\u0442\u044C,
      \u0442\u043E\u043C\u0443 \u0439\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043D\u0456
      \u0437\u0430\u043F\u0430\u0441\u0438 \u0434\u0443\u0436\u0435 \u0446\u0456\u043D\u0443\u044E\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241927
    m_Localized: "\u041A\u0435\u0442\u0447\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241928
    m_Localized: "\u0422\u043E\u043C\u0430\u0442\u043D\u0438\u0439 \u0441\u043E\u0443\u0441
      \u0456\u0437 \u0431\u0435\u0437\u043B\u0456\u0447\u0447\u044E \u0441\u043F\u0435\u0446\u0456\u0439
      \u0456 \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430\u043D\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241929
    m_Localized: "\u0421\u043C\u0430\u0436\u0435\u043D\u0435 \u043C'\u044F\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241930
    m_Localized: "\u041A\u0430\u0436\u0443\u0442\u044C, \u0449\u043E \u043C'\u044F\u0441\u043E
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241931
    m_Localized: "\u0421\u0435\u043D\u0434\u0432\u0456\u0447\u0456 \u0437 \u043E\u0433\u0456\u0440\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241932
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0435\u043D\u044C\u043A\u0430 \u0437\u0430\u043A\u0443\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241933
    m_Localized: "\u0421\u043C\u0430\u0436\u0435\u043D\u0430 \u043A\u0430\u0440\u0442\u043E\u043F\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241934
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0430 \u0432 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u0456,
      \u0430\u043B\u0435 \u0441\u043C\u0430\u0447\u043D\u0430 \u0432\u0435\u0447\u0435\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241935
    m_Localized: "\u0412\u0456\u0432\u0441\u044F\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241936
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0430, \u0430\u043B\u0435 \u0441\u0438\u0442\u043D\u0430
      \u0456 \u043A\u043E\u0440\u0438\u0441\u043D\u0430 \u0457\u0436\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241937
    m_Localized: "\u041E\u0432\u043E\u0447\u0435\u0432\u0438\u0439 \u0441\u0430\u043B\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241938
    m_Localized: "\u0412\u0430\u0436\u043B\u0438\u0432\u043E \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u043E\u0440\u0456\u0437\u0430\u0442\u0438 \u0456 \u0437\u043C\u0456\u0448\u0430\u0442\u0438
      \u043E\u0432\u043E\u0447\u0456, \u0430 \u0439 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0446\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241939
    m_Localized: "\u041C\u0430\u043A\u0430\u0440\u043E\u043D\u0438 \u0437 \u0441\u0438\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241940
    m_Localized: "\u0414\u0443\u0436\u0435 \u043A\u0430\u043B\u043E\u0440\u0456\u0439\u043D\u0438\u0439
      \u0456 \u0441\u043C\u0430\u0447\u043D\u0438\u0439 \u043E\u0431\u0456\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241941
    m_Localized: "\u041F\u0443\u0441\u0442\u043E\u0448\u043D\u0438\u0439 \u043E\u043C\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241942
    m_Localized: "\u0422\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043D\u0430 \u0457\u0436\u0430
      \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A\u0456\u0432 \u043F\u043E
      \u041F\u0443\u0441\u0442\u043A\u0430\u0445. \u042F\u0439\u0446\u044F \u0434\u043B\u044F
      \u043E\u043C\u043B\u0435\u0442\u0443 \u0433\u043E\u0434\u044F\u0442\u044C\u0441\u044F
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241943
    m_Localized: "\u0411\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434\u0438 \u0437
      \u0441\u0438\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241944
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u043D\u0435\u0432\u0438\u0431\u0430\u0433\u043B\u0438\u0432\u0438\u0439
      \u0441\u043D\u0456\u0434\u0430\u043D\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241945
    m_Localized: "\u0421\u043D\u0456\u0434\u0430\u043D\u043E\u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241946
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u043F\u0440\u0438\u043D\u0446\u0438\u043F
      \u0446\u0456\u0454\u0457 \u0441\u0442\u0440\u0430\u0432\u0438 - \u0437\u043C\u0456\u0448\u0430\u0442\u0438
      \u0432\u0441\u0435 \u0432 \u043E\u0434\u043D\u0456\u0439 \u043A\u0430\u0441\u0442\u0440\u0443\u043B\u0456
      \u0442\u0430 \u0437\u0432\u0430\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241947
    m_Localized: "\u0421\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241948
    m_Localized: "\u0417\u0430 \u0443\u044F\u0432\u043D\u043E\u0457 \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0438
      \u0446\u0456\u0454\u0457 \u0441\u0442\u0440\u0430\u0432\u0438 \u0432 \u0457\u0457
      \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u0456 \u0454
      \u043C\u0430\u0441\u0430 \u043D\u044E\u0430\u043D\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241949
    m_Localized: "\u041F\u0456\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241950
    m_Localized: "\u0417\u0430 \u043C\u0456\u0440\u043A\u0430\u043C\u0438 \u041F\u0443\u0441\u0442\u043A\u0438
      \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0448\u0438\u043A\u0430\u0440\u043D\u0430
      \u0441\u0442\u0440\u0430\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241951
    m_Localized: "\u0417\u0430\u043F\u0456\u043A\u0430\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241952
    m_Localized: "\u0414\u0443\u0436\u0435 \u0441\u043C\u0430\u0447\u043D\u0430 \u043E\u0432\u043E\u0447\u0435\u0432\u0430
      \u0437\u0430\u043F\u0456\u043A\u0430\u043D\u043A\u0430 \u0437 \u0445\u0440\u0443\u0441\u0442\u043A\u043E\u044E
      \u0441\u0438\u0440\u043D\u043E\u044E \u0441\u043A\u043E\u0440\u0438\u043D\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241953
    m_Localized: "\u041C'\u044F\u0441\u043D\u0435 \u0440\u0430\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241954
    m_Localized: "\u0426\u0435\u0439 \u0440\u0435\u0446\u0435\u043F\u0442 \u0432\u0438\u043D\u0430\u0439\u0448\u043B\u0438
      \u0432\u0436\u0435 \u043F\u0456\u0441\u043B\u044F \u0412\u0456\u0439\u043D\u0438,
      \u043A\u043E\u043B\u0438 \u0432 \u0457\u0436\u0443 \u0441\u0442\u0430\u043B\u0438
      \u043C\u0430\u0441\u043E\u0432\u043E \u0432\u0436\u0438\u0432\u0430\u0442\u0438
      \u043C'\u044F\u0441\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241955
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439 \u0441\u0430\u043B\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241956
    m_Localized: "\u0417\u043C\u0456\u0448\u0430\u0432\u0448\u0438, \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
      \u0431, \u043D\u0435\u043F\u043E\u0454\u0434\u043D\u0443\u0432\u0430\u043D\u0456
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438, \u043C\u0438
      \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u043C\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u0438\u0439 \u0441\u043C\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241957
    m_Localized: "\u041F\u0438\u0440\u0456\u0436\u043A\u0438 \u0437 \u043A\u0430\u043F\u0443\u0441\u0442\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241958
    m_Localized: "\u0421\u0442\u0430\u0440\u043E\u0432\u0438\u043D\u043D\u0438\u0439,
      \u0443 \u043C\u0438\u043D\u0443\u043B\u043E\u043C\u0443 \u0448\u0438\u0440\u043E\u043A\u043E
      \u0432\u0456\u0434\u043E\u043C\u0438\u0439 \u0440\u0435\u0446\u0435\u043F\u0442
      \u0434\u043E\u043C\u0430\u0448\u043D\u0456\u0445 \u043F\u0438\u0440\u0456\u0436\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241959
    m_Localized: "\u041C\u0430\u0444\u0456\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241960
    m_Localized: "\u0412\u0441\u0456\u043C\u0430 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0430
      \u0432\u0438\u043F\u0456\u0447\u043A\u0430 \u0434\u043E \u0447\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241961
    m_Localized: "\u042F\u0431\u043B\u0443\u0447\u043D\u0438\u0439 \u043F\u0438\u0440\u0456\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241962
    m_Localized: "\u0414\u043E \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043D\u043E\u0433\u043E
      \u044F\u0431\u043B\u0443\u0447\u043D\u043E\u0433\u043E \u043F\u0438\u0440\u043E\u0433\u0430
      \u0437\u0430\u0440\u0430\u0437 \u043D\u0435 \u0442\u0430\u043A-\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438.
      \u0410\u043B\u0435 \u0432\u043E\u043D\u043E \u0442\u043E\u0433\u043E \u0432\u0430\u0440\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241963
    m_Localized: "\u041C'\u044F\u0441\u043D\u0438\u0439 \u043F\u0438\u0440\u0456\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241964
    m_Localized: "\u041D\u0430\u0447\u0438\u043D\u043A\u0430 \u0446\u044C\u043E\u0433\u043E
      \u043F\u0438\u0440\u043E\u0433\u0430 \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437 \u043C'\u044F\u0441\u0430 \u0442\u0430 \u043E\u0432\u043E\u0447\u0456\u0432.
      \u0412\u0456\u043D \u0434\u0443\u0436\u0435 \u0441\u0438\u0442\u043D\u0438\u0439,
      \u044F\u043A\u0449\u043E \u0439\u043E\u0433\u043E \u0437'\u0457\u0441\u0442\u0438
      \u043D\u0430 \u0441\u043D\u0456\u0434\u0430\u043D\u043E\u043A, \u0442\u043E
      \u0457\u0441\u0442\u0438 \u043D\u0435 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u044C\u0441\u044F
      \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0432\u0435\u0447\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241965
    m_Localized: "\u0421\u043E\u043B\u043E\u0434\u043A\u0438\u0439 \u043F\u0438\u0440\u0456\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241966
    m_Localized: "\u0423 \u0446\u0435\u0439 \u043F\u0438\u0440\u0456\u0433 \u0432\u0445\u043E\u0434\u0438\u0442\u044C
      \u043C\u0430\u0439\u0436\u0435 \u0432\u0441\u0435 \u0441\u043E\u043B\u043E\u0434\u043A\u0435,
      \u0449\u043E \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0439\u0442\u0438
      \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445. \u0415\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u0430
      \u0434\u043E\u0437\u0430 \u0446\u0443\u043A\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241967
    m_Localized: "\u041F\u0456\u043A\u0430\u043D\u0442\u043D\u0438\u0439 \u043F\u0438\u0440\u0456\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241968
    m_Localized: "\u041F\u0438\u0440\u0456\u0433 \u0456\u0437 \u0434\u0443\u0436\u0435
      \u0434\u0438\u0432\u043D\u043E\u044E \u043D\u0430\u0447\u0438\u043D\u043A\u043E\u044E,
      \u0434\u043B\u044F \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0445 \u043F\u043E\u0446\u0456\u043D\u043E\u0432\u0443\u0432\u0430\u0447\u0456\u0432
      \u043F\u0443\u0441\u0442\u043E\u0448\u043D\u043E\u0457 \u043A\u0443\u043B\u0456\u043D\u0430\u0440\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241969
    m_Localized: "\u0411\u043E\u0440\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241970
    m_Localized: "\u0420\u0456\u0437\u043D\u043E\u0432\u0438\u0434 \u0441\u0443\u043F\u0443
      \u0437 \u0434\u0443\u0436\u0435 \u0432\u0438\u0431\u0430\u0433\u043B\u0438\u0432\u0438\u043C
      \u0441\u043A\u043B\u0430\u0434\u043E\u043C. \u0422\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0438\u0439 \u043A\u0443\u0445\u0430\u0440
      \u043C\u043E\u0436\u0435 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241971
    m_Localized: "\u0414\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043C\u043E\u043D\u0435\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241972
    m_Localized: "\u0414\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043C\u043E\u043D\u0435\u0442\u0438
      \u0437\u0430\u0440\u0430\u0437 \u043D\u0435 \u0432 \u0445\u043E\u0434\u0443,
      \u0430\u043B\u0435 \u0457\u0445 \u043C\u043E\u0436\u043D\u0430 \u043E\u0431\u043C\u0456\u043D\u044F\u0442\u0438
      \u043D\u0430 \u043A\u0440\u0438\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241973
    m_Localized: "\u0421\u043C\u0430\u0440\u0430\u0433\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241974
    m_Localized: "\u041F\u043E\u043F\u0438\u0442 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0435
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F \u0432\u0441\u0435 \u0449\u0435
      \u0432\u0438\u0441\u043E\u043A\u0438\u0439. \u0407\u0445 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u0433\u0456\u0434\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241975
    m_Localized: "\u0421\u0430\u043F\u0444\u0456\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241976
    m_Localized: "\u041F\u043E\u043F\u0438\u0442 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0435
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F \u0432\u0441\u0435 \u0449\u0435
      \u0432\u0438\u0441\u043E\u043A\u0438\u0439. \u0407\u0445 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u0433\u0456\u0434\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241977
    m_Localized: "\u0420\u0443\u0431\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241978
    m_Localized: "\u041F\u043E\u043F\u0438\u0442 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0435
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F \u0432\u0441\u0435 \u0449\u0435
      \u0432\u0438\u0441\u043E\u043A\u0438\u0439. \u0407\u0445 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u0433\u0456\u0434\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241979
    m_Localized: "\u0414\u0438\u0441\u043A \u0456\u0437 \u0434\u0430\u043D\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241980
    m_Localized: "\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F, \u0437\u043B\u0438\u0442\u0430
      \u0437 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443, \u043C\u0456\u0441\u0442\u0438\u0442\u044C
      \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0431\u0443\u0442\u0456 \u0441\u0435\u043A\u0440\u0435\u0442\u0438
      \u043C\u0438\u043D\u0443\u043B\u0438\u0445 \u0447\u0430\u0441\u0456\u0432.
      \u0407\u0457 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0433\u0456\u0434\u043D\u043E
      \u043F\u0440\u043E\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241981
    m_Localized: "\u0414\u0438\u0441\u043A \u0456\u0437 \u0446\u0456\u043D\u043D\u0438\u043C\u0438
      \u0434\u0430\u043D\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241982
    m_Localized: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0438 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439 \u043C\u0430\u044E\u0442\u044C
      \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043F\u043E\u043F\u0438\u0442 \u0443
      \u043F\u0435\u0432\u043D\u0438\u0445 \u043A\u043E\u043B\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241983
    m_Localized: "\u0414\u0438\u0441\u043A \u0456\u0437 \u041C\u0456\u043D. \u0421\u0442\u0438\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241984
    m_Localized: "\u0426\u0435\u0439 \u0434\u0438\u0441\u043A \u043C\u0456\u0441\u0442\u0438\u0442\u044C
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E
      \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0443 \u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A\u0430
      \u041C2. \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u043E\u043D\u0430
      \u0437\u0430\u0446\u0456\u043A\u0430\u0432\u0438\u0442\u044C \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241985
    m_Localized: "\u0414\u043E\u0432\u043E\u0454\u043D\u043D\u0430 \u043A\u043D\u0438\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241986
    m_Localized: "\u041D\u0435\u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0456
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456 \u043A\u043D\u0438\u0436\u043A\u0438
      - \u0432\u0435\u043B\u0438\u043A\u0430 \u0440\u0456\u0434\u043A\u0456\u0441\u0442\u044C
      \u0442\u0435\u043F\u0435\u0440. \u0411\u0430\u0433\u0430\u0442\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432
      \u0433\u043E\u0442\u043E\u0432\u0456 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0438
      \u0437\u0430 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241987
    m_Localized: "\u0420\u0443\u043D\u0430 \u0437\u043B\u043E\u043C\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241988
    m_Localized: "\u0420\u0443\u043D\u0430 \u0437\u043B\u043E\u043C\u0449\u0438\u043A\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0432\u0456\u0434\u0456\u043C\u043A\u043D\u0443\u0442\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0437\u0430\u043C\u043E\u043A,
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u043B\u0430\u043C\u0430\u043D\u0438\u0439.
      \u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F.
      \u0429\u043E\u0431 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438,
      \u043D\u0430\u0432\u0435\u0434\u0456\u0442\u044C \u043A\u0443\u0440\u0441\u043E\u0440
      \u043D\u0430 \u0434\u0432\u0435\u0440\u0456 \u0430\u0431\u043E \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440
      \u0437\u0456 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u043C \u0437\u0430\u043C\u043A\u043E\u043C
      \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241989
    m_Localized: "\u0420\u0443\u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241990
    m_Localized: "\u0420\u0443\u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F
      \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443\u0454 \u0432\u0430\u0441
      \u0434\u043E \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u0442\u0430\u0431\u043E\u0440\u0443
      \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E \u043C\u0456\u0441\u0446\u044F
      (\u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0456\u0442\u044C \u0434\u0456\u044E,
      \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438 \u043A\u043D\u043E\u043F\u043A\u0443).
      \u041D\u0430\u0437\u0430\u0434 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u0434\u0435
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443
      \u041C\u0422\u041D. \u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241991
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0430 \u0432\u0456\u0434\u043C\u0438\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241992
    m_Localized: "\u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u0438\u0439
      \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439, \u0449\u043E \u0434\u0430\u0454
      \u0437\u043C\u043E\u0433\u0443 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u0433\u043B\u0438\u0431\u043E\u043A\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443 \u0437\u0456 \u0441\u043A\u0438\u0434\u0430\u043D\u043D\u044F\u043C
      \u0443\u0441\u0456\u0445 \u043F\u0430\u0440\u043E\u043B\u0456\u0432. \u0414\u043E
      \u0412\u0456\u0439\u043D\u0438 \u0431\u0443\u0432 \u043F\u043E\u0437\u0430
      \u0437\u0430\u043A\u043E\u043D\u043E\u043C, \u0442\u043E\u043C\u0443 \u0439
      \u0437\u0430\u0440\u0430\u0437 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0454\u0442\u044C\u0441\u044F
      \u0434\u0443\u0436\u0435 \u0440\u0456\u0434\u043A\u043E. \u0429\u043E\u0431
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438,
      \u043D\u0430\u0432\u0435\u0434\u0456\u0442\u044C \u043A\u0443\u0440\u0441\u043E\u0440
      \u043D\u0430 \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u0439 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B
      \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241993
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0442\u043E\u0441\u0442\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241994
    m_Localized: "\u041D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430
      \u043D\u0430\u0437\u0432\u0443, \u0443 \u0446\u0456\u0439 \u043A\u043D\u0438\u0436\u0446\u0456
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043B\u0438\u0448\u0435 \u043F\u0440\u043E \u0440\u0435\u043C\u043E\u043D\u0442
      \u0442\u043E\u0441\u0442\u0435\u0440\u0456\u0432, \u0430 \u0439 \u0443\u0437\u0430\u0433\u0430\u043B\u0456
      \u043F\u0440\u043E \u0440\u0435\u043C\u043E\u043D\u0442 \u0443\u0441\u044C\u043E\u0433\u043E
      \u043D\u0430 \u0441\u0432\u0456\u0442\u0456 - \u0432\u0456\u0434 \u0437\u0431\u0440\u043E\u0457
      \u0434\u043E \u043F\u043E\u0431\u0443\u0442\u043E\u0432\u043E\u0457 \u0442\u0435\u0445\u043D\u0456\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241995
    m_Localized: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430 - \u0446\u0435
      \u0432\u0435\u0441\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241996
    m_Localized: "\u0423 \u0446\u0456\u0439 \u043A\u043D\u0438\u0437\u0456 \u0432
      \u043F\u0440\u043E\u0441\u0442\u0456\u0439 \u0456 \u0446\u0456\u043A\u0430\u0432\u0456\u0439
      \u0444\u043E\u0440\u043C\u0456 \u0434\u0430\u044E\u0442\u044C\u0441\u044F \u0431\u0430\u0437\u043E\u0432\u0456
      \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456 \u043F\u0440\u043E \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0443,
      \u043F\u0435\u0440\u0448\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443,
      \u043E\u0431\u0440\u043E\u0431\u043A\u0443 \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u044C
      \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u0430\u0437\u0438 \u0445\u0456\u0440\u0443\u0440\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241997
    m_Localized: "\u0417\u043B\u043E\u043C \u0456 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241998
    m_Localized: "\u0423 \u043A\u043D\u0438\u0437\u0456 \u0434\u043E\u043A\u043B\u0430\u0434\u043D\u043E,
      \u0437 \u0456\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0456\u044F\u043C\u0438
      \u043E\u043F\u0438\u0441\u0443\u044E\u0442\u044C\u0441\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457
      \u0432\u0441\u0456\u0445 \u0442\u0438\u043F\u0456\u0432 \u0437\u0430\u043C\u043A\u0456\u0432,
      \u0456 \u0434\u0430\u044E\u0442\u044C\u0441\u044F \u043F\u043E\u0440\u0430\u0434\u0438
      \u0449\u043E\u0434\u043E \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u0437\u043B\u043E\u043C\u0443.
      \u0410\u0432\u0442\u043E\u0440 \u044F\u0432\u043D\u043E \u0431\u0443\u0432
      \u043D\u0435 \u0432 \u043B\u0430\u0434\u0430\u0445 \u0456\u0437 \u0437\u0430\u043A\u043E\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241999
    m_Localized: "\u042E\u043D\u0438\u0439 \u0445\u0430\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242000
    m_Localized: "\u0414\u0438\u0442\u044F\u0447\u0430 \u043A\u043D\u0438\u0436\u043A\u0430,
      \u0430\u0432\u0442\u043E\u0440 \u044F\u043A\u043E\u0457 \u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0442\u044C
      \u044E\u043D\u0438\u0445 \u0447\u0438\u0442\u0430\u0447\u0456\u0432 \u0437
      \u043E\u0441\u043D\u043E\u0432\u0430\u043C\u0438 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u0438\u043A\u0438,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0434\u0456\u043B\u0438\u0442\u044C\u0441\u044F
      \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0438\u043C\u0438
      \u043C\u0430\u043B\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u043C\u0438 \u0444\u0430\u043A\u0442\u0430\u043C\u0438,
      \u0449\u043E \u0441\u0442\u043E\u0441\u0443\u044E\u0442\u044C\u0441\u044F \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432
      \u0442\u0430 \u0456\u043D\u0448\u0438\u0445 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0438\u0445
      \u0441\u0438\u0441\u0442\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242001
    m_Localized: "\u0424\u0435\u0454\u0440\u0432\u0435\u0440\u043A\u0438 \u0434\u043B\u044F
      \u0432\u0435\u0447\u0456\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242002
    m_Localized: "\u041A\u043D\u0438\u0433\u0430, \u0432\u0438\u043F\u0443\u0449\u0435\u043D\u0430
      \u043D\u0430 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u041C\u043E\u0440\u0430\u043B\u0456. \u0423 \u043D\u0456\u0439 \u0434\u043E\u043A\u043B\u0430\u0434\u043D\u043E
      \u0432\u0438\u043A\u043B\u0430\u0434\u0435\u043D\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0431\u0435\u0437\u043F\u0435\u043A\u0438 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0437 \u0432\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u043C\u0438
      \u0440\u0435\u0447\u043E\u0432\u0438\u043D\u0430\u043C\u0438, \u0449\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430
      \u043F\u0456\u0440\u043E\u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0438\u0445
      \u0432\u0438\u0440\u043E\u0431\u0456\u0432 \u0456 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242003
    m_Localized: "\u0410\u043C\u0443-\u043D\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242004
    m_Localized: "\u0429\u043E\u043C\u0456\u0441\u044F\u0447\u043D\u0438\u0439 \u0456\u043B\u044E\u0441\u0442\u0440\u043E\u0432\u0430\u043D\u0438\u0439
      \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u0412\u0438\u0441\u0432\u0456\u0442\u043B\u044E\u0454
      \u043D\u043E\u0432\u0438\u043D\u043A\u0438, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456
      \u0443\u0441\u043F\u0456\u0445\u0438 \u0442\u0430 \u043C\u043E\u0434\u043D\u0456
      \u0442\u0435\u043D\u0434\u0435\u043D\u0446\u0456\u0457 \u0432 \u0446\u0456\u0439
      \u0433\u0430\u043B\u0443\u0437\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242005
    m_Localized: "\u041A\u043E\u043B\u043E\u0442\u0438 \u0456 \u0440\u0456\u0437\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242006
    m_Localized: "\u041A\u043D\u0438\u0436\u043A\u0430 \u043F\u0440\u043E \u0456\u0441\u0442\u043E\u0440\u0456\u044E
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457.
      \u0412\u0456\u0434 \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0456\u0445
      \u0441\u043F\u0438\u0441\u0456\u0432 \u0456 \u043C\u0435\u0447\u0456\u0432
      \u0434\u043E \u0446\u0456\u043B\u043A\u043E\u043C \u0441\u0443\u0447\u0430\u0441\u043D\u0438\u0445
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u043A\u043B\u0438\u043D\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242007
    m_Localized: "\u041C\u0430\u0433\u0456\u044F \u043D\u0430 \u0432\u0430\u0440\u0442\u0456
      \u0411\u0430\u0442\u044C\u043A\u0456\u0432\u0449\u0438\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242008
    m_Localized: "\u041A\u043D\u0438\u0433\u0430 \u043F\u0440\u043E \u043D\u0430\u0439\u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0448\u0456
      \u0442\u0435\u043D\u0434\u0435\u043D\u0446\u0456\u0457 \u0432 \u0443\u0441\u044C\u043E\u043C\u0443,
      \u0449\u043E \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430
      \u0456 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u041F\u0430\u0444\u043E\u0441\u0443 \u0456
      \u043F\u0440\u043E\u043F\u0430\u0433\u0430\u043D\u0434\u0438 \u0442\u0443\u0442
      \u043D\u0435 \u043C\u0435\u043D\u0448\u0435, \u043D\u0456\u0436 \u043A\u043E\u0440\u0438\u0441\u043D\u043E\u0457
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242009
    m_Localized: "\u0421\u0442\u0430\u043D\u044C \u0442\u0456\u043D\u043D\u044E.
      \u0421\u0430\u043C\u043E\u0432\u0447\u0438\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242010
    m_Localized: "\u041F\u0456\u0434\u0440\u0443\u0447\u043D\u0438\u043A \u0434\u043B\u044F
      \u0448\u043F\u0438\u0433\u0443\u043D\u0456\u0432-\u043F\u043E\u0447\u0430\u0442\u043A\u0456\u0432\u0446\u0456\u0432.
      \u041D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430 \u0442\u0435,
      \u0449\u043E \u0430\u0432\u0442\u043E\u0440, \u0432\u043E\u0447\u0435\u0432\u0438\u0434\u044C,
      \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u0438\u0439 \u043F\u0441\u0438\u0445
      \u0456 \u043F\u0430\u0440\u0430\u043D\u043E\u0457\u043A, \u0443 \u043A\u043D\u0438\u0436\u0446\u0456
      \u0432\u0441\u0435 \u0436 \u0447\u0438\u043C\u0430\u043B\u043E \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0445
      \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242011
    m_Localized: "\u041D\u0430\u0432\u0456\u0449\u043E \u043F\u043B\u0430\u0442\u0438\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242012
    m_Localized: "\u0424\u0430\u043A\u0442\u0438\u0447\u043D\u043E \u0446\u0435 \u043A\u043D\u0438\u0436\u043A\u0430
      \u043F\u0440\u043E \u0442\u0435, \u044F\u043A \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0437
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438, \u043A\u043E\u043C\u0435\u0440\u0441\u0430\u043D\u0442\u0430\u043C\u0438
      \u0456 \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u044F\u043C\u0438 \u0432
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430\u0445, \u0437\u0431\u0438\u0432\u0430\u0442\u0438
      \u0446\u0456\u043D\u0438, \u0442\u043E\u0440\u0433\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
      \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0437\u043D\u0438\u0436\u043A\u0438,
      \u043D\u0435 \u0432\u0435\u0441\u0442\u0438\u0441\u044F \u043D\u0430 \u043E\u0431\u043C\u0430\u043D\u0438
      \u0456 \u0432\u0438\u0432\u0435\u0440\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242013
    m_Localized: "\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437 \u0434\u043B\u044F
      \u0447\u0430\u0439\u043D\u0438\u043A\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242014
    m_Localized: "\u041F\u043E\u0441\u0456\u0431\u043D\u0438\u043A \u0434\u043B\u044F
      \u044E\u043D\u0438\u0445 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432,
      \u044F\u043A\u0438\u0439 \u043D\u0456\u0431\u0438\u0442\u043E \u043C\u0430\u0454
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0457\u043C \u0440\u043E\u0437\u0432\u0438\u043D\u0443\u0442\u0438
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0443
      \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242015
    m_Localized: "\u0412\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F \u043D\u0430
      \u041F\u0443\u0441\u0442\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242016
    m_Localized: "\u041A\u043D\u0438\u0433\u0430, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430
      \u0432\u0436\u0435 \u0432 \u043F\u043E\u0432\u043E\u0454\u043D\u043D\u0456
      \u0440\u043E\u043A\u0438. \u0420\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0454
      \u043F\u0440\u043E \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438, \u0449\u043E \u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445, \u0456 \u043F\u0440\u043E
      \u0442\u0435, \u044F\u043A \u0456\u0437 \u043D\u0438\u043C\u0438 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F.
      \u0410\u0432\u0442\u043E\u0440 - \u0414\u0456\u0442\u0437\u0456 \u0414\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242017
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0456 \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242018
    m_Localized: "\u041E\u0434\u043D\u0430 \u0437 \u0431\u0435\u0437\u043B\u0456\u0447\u0456
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445 \u043A\u043D\u0438\u0436\u043E\u043A,
      \u043F\u0440\u0438\u0441\u0432\u044F\u0447\u0435\u043D\u0438\u0445 \u043C\u0430\u0433\u0456\u0457
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432. \u0414\u0430\u043B\u0435\u043A\u043E
      \u043D\u0435 \u043D\u0430\u0439\u0440\u043E\u0437\u0443\u043C\u043D\u0456\u0448\u0430
      \u0456 \u043D\u0430\u0439\u043D\u0430\u0443\u043A\u043E\u0432\u0456\u0448\u0430,
      \u0437\u0430\u0442\u0435 \u0437 \u043A\u043E\u043B\u044C\u043E\u0440\u043E\u0432\u0438\u043C\u0438
      \u0456\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0456\u044F\u043C\u0438 \u0456
      \u043A\u0443\u043F\u043E\u044E \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u0438\u0445
      \u043F\u043E\u0440\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242019
    m_Localized: "\u0422\u0430\u0454\u043C\u043D\u0438\u0447\u0430 \u0441\u0438\u043B\u0430
      \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242020
    m_Localized: "\u0425\u043E\u0447\u0430 \u0432 \u0446\u0456\u0439 \u043A\u043D\u0438\u0436\u0446\u0456
      \u0439\u0434\u0435\u0442\u044C\u0441\u044F \u043F\u0440\u043E \u0456\u0441\u0442\u0438\u043D\u043D\u0438\u0445
      \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432, \u0442\u0430\u043A\u0438\u0445,
      \u044F\u043A \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F,
      \u0437\u043D\u0430\u043D\u043D\u044F, \u0449\u043E \u043C\u0456\u0441\u0442\u044F\u0442\u044C\u0441\u044F
      \u0432 \u043D\u0456\u0439, \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C
      \u0432\u0430\u043C \u0456 \u043F\u0440\u043E\u0442\u0438 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432
      \u0411\u043E\u0433\u0438\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242021
    m_Localized: "\u0429\u043E\u0434\u0435\u043D\u043D\u0438\u043A \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u0420\u0435\u043C\u0435\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242022
    m_Localized: "\u041C\u0456\u0441\u0442\u0438\u0442\u044C \u0431\u0435\u0437\u043B\u0456\u0447
      \u0437\u0430\u043F\u0438\u0441\u0456\u0432 \u043F\u0440\u043E \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u0433\u0443\u043B\u0456\u0432."
    m_Metadata:
      m_Items: []
