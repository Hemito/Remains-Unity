  - m_Id: 2729435442
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0430 \u0442\u043E\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435443
    m_Localized: "\u041A\u0456\u043C\u043D\u0430\u0442\u0430 \u0431\u043E\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435444
    m_Localized: "\u0423\u043B\u0430\u043C\u043A\u0438 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435445
    m_Localized: "\u0422\u0435\u043C\u043D\u0430 \u0441\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435446
    m_Localized: "\u0422\u0435\u0440\u043C\u0456\u043D\u0430\u043B \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u043E\u0433\u043E
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435447
    m_Localized: "\u0412\u0438\u0445\u0456\u0434 \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435448
    m_Localized: "\u0412\u0445\u0456\u0434 \u0434\u043E \u0421\u0442\u0456\u0439\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435449
    m_Localized: "\u041C\u043E\u0433\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435454
    m_Localized: "\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435455
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\"
      \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u0454 \u0432\u0430\u0448\u0443 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043C\u0430\u0433\u0456\u0457 \u0440\u0456\u0437\u043D\u0456 \u043E\u0431'\u0454\u043A\u0442\u0438,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435 \u0441\u043B\u0443\u0436\u0438\u0442\u0438
      \u043E\u043F\u043E\u0440\u043E\u044E \u0434\u043B\u044F \u0441\u0442\u0440\u0438\u0431\u043A\u0430
      \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456. [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C
      \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C \u043E\u0447\u043A\u043E\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0437\u043C\u0435\u043D\u0448\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F
      \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u0441\u0438\u043B \u043D\u0430 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437
      \u0456 \"\u041F\u043E\u0434\u0432\u0456\u0439\u043D\u0438\u0439 \u0441\u0442\u0440\u0438\u0431\u043E\u043A\".[br]-
      \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F
      \u0432\u0430\u0448\u0430 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0430
      \u043C\u0456\u0446\u044C, \u0437\u043E\u043A\u0440\u0435\u043C\u0430 \u0432\u0438
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0456\u0434\u043D\u0456\u043C\u0430\u0442\u0438
      \u0432\u0430\u0436\u0447\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438,
      \u0430 \u0432\u043E\u0440\u043E\u0433\u0430\u043C \u0431\u0443\u0434\u0435
      \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435 \u0432\u0438\u0440\u0432\u0430\u0442\u0438\u0441\u044F
      \u0456\u0437 \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F."
