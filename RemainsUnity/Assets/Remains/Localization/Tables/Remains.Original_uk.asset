      \u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0447\u0430\u0441\u0443 \u0432\u0430\u043C
      \u0449\u0435 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E\u0454\u043A\u0442\u0443? \u042F\u043A\u0449\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u043F\u0440\u043E \u0437\u043E\u0432\u0441\u0456\u043C \u043A\u0440\u0430\u0439\u043D\u0456
      \u0442\u0435\u0440\u043C\u0456\u043D\u0438. \u0423 \u0436\u043E\u0434\u043D\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u043D\u0435 \u0434\u0443\u043C\u0430\u0439, \u0449\u043E
      \u044F \u0442\u0438\u0441\u043D\u0443 \u043D\u0430 \u0442\u0435\u0431\u0435,
      \u044F \u0431 \u043D\u0456\u0437\u0430\u0449\u043E, \u0442\u0438 \u0437\u043D\u0430\u0454\u0448.\""
