  - m_Id: 2729436361
    m_Localized: "\u0423\u0432\u0430\u0433\u0430! \u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0439 \u0437\u0431\u0456\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436362
    m_Localized: "\u041F\u043E\u043C\u0438\u043B\u043A\u0430 0-4570-7f45-a420-ff98
      (\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0430 \u043F\u043E\u043C\u0438\u043B\u043A\u0430,
      \u0437\u0432'\u044F\u0436\u0456\u0442\u044C\u0441\u044F \u0437 \u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u043C)\n\t\n\u0419\u043C\u043E\u0432\u0456\u0440\u043D\u0430
      \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0437\u0431\u043E\u044E - \u0432\u043F\u043B\u0438\u0432
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u043E\u0433\u043E
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0443 \u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0438
      \u041F\u0456\u043F\u0411\u0430\u043A\u0430.\n\n\u0412\u0438\u043A\u043E\u043D\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430 \u043F\u0456\u0434\u0441\u0438\u0441\u0442\u0435\u043C
      \u0442\u0430 \u043C\u043E\u0434\u0443\u043B\u0456\u0432:\n\u2022 \u0421\u0442\u0430\u0442\u0443\u0441
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 - \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439\n\u2022
      \u041C\u0435\u0434\u0438\u0447\u043D\u0438\u0439 \u043C\u043E\u0434\u0443\u043B\u044C
      - \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439\n\u2022
      \u0421\u043E\u0440\u0442\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E
      - \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439\n\u2022
      \u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0447\u043D\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C - \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439\n\u2022
      \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043F\u0440\u0438\u0446\u0456\u043B\u044E\u0432\u0430\u043D\u043D\u044F
      - \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0435\n\u2022 \u0406\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 - \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u043E\n\u2022
      \u042F\u0434\u0440\u043E \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439\u043D\u043E\u0457
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 - \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454\n\n\u0423\u0432\u0430\u0433\u0430!
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F\n\n\u041F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0432\u0438\u043A\u043E\u043D\u0443\u0454\u0442\u044C\u0441\u044F,
      \u043E\u0447\u0456\u043A\u0443\u0439\u0442\u0435......."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436363
    m_Localized: "\u0426\u0435 \u0441\u043F\u0438\u0441\u043E\u043A \u0443\u0441\u0456\u0454\u0457
      \u043D\u0430\u044F\u0432\u043D\u043E\u0457 \u0443 \u0432\u0430\u0441 \u0437\u0431\u0440\u043E\u0457
      \u0442\u0430 \u043C\u0430\u0433\u0456\u0457. \u041D\u043E\u0432\u0430, \u0449\u0435
      \u043D\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F \u043F\u043E\u0437\u043D\u0430\u0447\u0430\u0454\u0442\u044C\u0441\u044F
      \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C [\u2629].\n\n\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [\u043B\u0456\u0432\u0443 \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u0438\u0448\u0456],
      \u0449\u043E\u0431 \u0435\u043A\u0456\u043F\u0456\u0440\u0443\u0432\u0430\u0442\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0443 \u0437\u0431\u0440\u043E\u044E.
      \u0422\u0430\u043A\u043E\u0436 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      [\u0441\u043A\u0440\u043E\u043B \u043C\u0438\u0448\u0456], \u0449\u043E\u0431
      \u0437\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438 \u0437\u0431\u0440\u043E\u044E
      \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0432 \u0433\u0440\u0456, \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u044F\u0447\u0438
      \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440.\n\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [\u043F\u0440\u0430\u0432\u0443 \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u0438\u0448\u0456],
      \u0449\u043E\u0431 \u0432\u0438\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0437\u0456
      \u0441\u043F\u0438\u0441\u043A\u0443 \u0437\u0431\u0440\u043E\u044E, \u044F\u043A\u043E\u044E
      \u0432\u0438 \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u0454\u0442\u0435\u0441\u044F
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
      \u0430\u0431\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0457\u0457
      \u0434\u043E \u0441\u043F\u0438\u0441\u043A\u0443 \u0437\u043D\u043E\u0432\u0443.\n\u041D\u0430\u0432\u0435\u0434\u0456\u0442\u044C
      \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u043F\u0443\u043D\u043A\u0442
      \u0441\u043F\u0438\u0441\u043A\u0443 \u0442\u0430 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      [\u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u0432\u0438\u0431\u043E\u0440\u0443
      \u0441\u043B\u043E\u0442\u0430] ([1]-[0], [-], [=]), \u0449\u043E\u0431 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438
      \u0437\u0431\u0440\u043E\u044E \u0434\u043E \u0446\u044C\u043E\u0433\u043E
      \u0441\u043B\u043E\u0442\u0430, \u0430\u0431\u043E \u0441\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F. \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438
      \u0446\u044E \u0436 \u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u0432 \u0433\u0440\u0456,
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0448\u0432\u0438\u0434\u043A\u043E
      \u0435\u043A\u0456\u043F\u0456\u0440\u0443\u0432\u0430\u0442\u0438 \u0446\u044E
      \u0437\u0431\u0440\u043E\u044E.\n\u0422\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      [\u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u0432\u0438\u0431\u043E\u0440\u0443
      \u0441\u043B\u043E\u0442\u0430] \u0440\u0430\u0437\u043E\u043C \u0456\u0437
      \u043A\u043B\u0430\u0432\u0456\u0448\u0435\u044E @1. \u0422\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0445 \u0441\u043B\u043E\u0442\u0456\u0432
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0437
      12 \u0434\u043E 24.\n\u041D\u0430\u0432\u0435\u0434\u0456\u0442\u044C \u043A\u0443\u0440\u0441\u043E\u0440
      \u043D\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u0443, \u043C\u0456\u043D\u0443
      \u0430\u0431\u043E \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      @2 \u0430\u0431\u043E @3, \u0449\u043E\u0431 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438
      \u0457\u0445 \u044F\u043A \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443
      \u0437\u0431\u0440\u043E\u044E. \u0422\u0430\u043A \u0432\u0438 \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0457\u0445 \u0440\u0430\u0437\u043E\u043C \u0437 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E, \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0446\u0438\u0445 \u043A\u043B\u0430\u0432\u0456\u0448. \u042F\u043A\u0449\u043E
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443 \u0437\u0431\u0440\u043E\u044E
      \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E,
      \u0442\u043E \u0437\u0430 \u043A\u043B\u0430\u0432\u0456\u0448\u0435\u044E
      @4 \u0431\u0443\u0434\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u043D\u044E \u0432\u0438\u0431\u0440\u0430\u043D\u0443
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0443, \u0430 \u0437\u0430
      \u043A\u043B\u0430\u0432\u0456\u0448\u0435\u044E @5 - \u043E\u0441\u0442\u0430\u043D\u043D\u0454
      \u0432\u0438\u0431\u0440\u0430\u043D\u0435 \u0431\u043E\u0439\u043E\u0432\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F.\n\u041A\u0440\u0456\u043C
      \u0442\u043E\u0433\u043E, \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438 \u0437\u0430\u0445\u0438\u0441\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0432 \u043A\u043E\u043C\u0456\u0440\u043A\u0443
      \u0448\u0432\u0438\u0434\u043A\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C,
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0447\u0438
      \u043E\u0434\u043D\u0443 \u0437 [\u043A\u043B\u0430\u0432\u0456\u0448 \u0448\u0432\u0438\u0434\u043A\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C] (\u0434\u0438\u0432.
      \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F -
      \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F). \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438
      \u0446\u044E \u0441\u0430\u043C\u0443 \u043A\u043B\u0430\u0432\u0456\u0448\u0443
      \u0432 \u0433\u0440\u0456, \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u0436 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
      \u0432\u0438\u0431\u0440\u0430\u043D\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0431\u0435\u0437 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E\u0441\u0442\u0456
      \u0435\u043A\u0456\u043F\u0456\u0440\u0443\u0432\u0430\u0442\u0438 \u0439\u043E\u0433\u043E.\n\n\u0423
      \u043F\u0440\u0430\u0432\u0456\u0439 \u0447\u0430\u0441\u0442\u0438\u043D\u0456
      \u0435\u043A\u0440\u0430\u043D\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u0437\u0431\u0440\u043E\u0457.\n\u0428\u043A\u043E\u0434\u0430: \u0431\u0430\u0437\u043E\u0432\u0430
      \u0448\u043A\u043E\u0434\u0430 \u0437\u0431\u0440\u043E\u0457 (\u0443 \u0434\u0443\u0436\u043A\u0430\u0445
      - \u0444\u0430\u043A\u0442\u0438\u0447\u043D\u0430 \u0448\u043A\u043E\u0434\u0430
      \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u0432\u0430\u0448\u0438\u0445
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A,
      \u0443 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0438\u0445 \u0434\u0443\u0436\u043A\u0430\u0445
      - \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0434\u0440\u043E\u0431\u0443
      \u0434\u043B\u044F \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0456\u0432)\n\u0428\u043A\u043E\u0434\u0430
      \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443: \u0448\u043A\u043E\u0434\u0430
      \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C
      \u0432\u0430\u0448\u0438\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A
      (\u0443 \u0434\u0443\u0436\u043A\u0430\u0445 - \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u0430
      \u0448\u043A\u043E\u0434\u0430 \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u0447\u0430\u0441\u0443
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u043D\u043D\u044F
      \u0437\u0431\u0440\u043E\u0457)\n\u041E\u0414: \u043E\u0447\u043A\u0438 \u0434\u0456\u0457
      \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443 \u0432
      \u0417.\u041F.\u0421. (\u0443 \u0434\u0443\u0436\u043A\u0430\u0445 - \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456\u0432 \u0447\u0435\u0440\u0433\u043E\u044E
      \u0432 \u0417.\u041F.\u0421. \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457)\n\u0414\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C:
      \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C \u0443 \u0431\u043B\u043E\u043A\u0430\u0445,
      \u043D\u0430 \u044F\u043A\u0456\u0439 \u0437\u0431\u0440\u043E\u044F \u0431\u0443\u0434\u0435
      \u0433\u0430\u0440\u0430\u043D\u0442\u043E\u0432\u0430\u043D\u043E \u0432\u043B\u0443\u0447\u0430\u0442\u0438
      \u0432 \u0446\u0456\u043B\u044C. \u041D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u0446\u0456
      \u0446\u044F \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u0430 \u0454 \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u043E\u044E
      \u0456 \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0432\u043E\u043B\u043E\u0434\u0456\u043D\u043D\u044F
      \u0437\u0431\u0440\u043E\u0454\u044E \u0442\u0430 \u0456\u043D\u0448\u0438\u0445
      \u0447\u0438\u043D\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
