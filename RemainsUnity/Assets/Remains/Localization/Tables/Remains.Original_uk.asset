  - m_Id: 2737823955
    m_Localized: "\u0412\u0430\u0448 \u0431\u043E\u0441 \u043F\u0440\u043E\u0441\u0438\u0432
      \u043C\u0435\u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0437 \u043E\u0434\u043D\u0438\u043C \u043F\u0438\u0442\u0430\u043D\u043D\u044F\u043C.
      \u0419\u043E\u043C\u0443 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0431\u0443\u043B\u0438
      \u0434\u0430\u043D\u0456 \u043F\u0440\u043E \u0433\u0456\u0434\u0440\u043E\u043F\u043E\u043D\u043D\u0456
      \u0444\u0435\u0440\u043C\u0438 \u0437 \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A.
      \u042F \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0457\u0445\u043D\u0456\u0439
      \u043E\u0444\u0456\u0441 \u0456 \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0430
      \u0432 \u0431\u0443\u0434\u0456\u0432\u043B\u044E, \u043E\u0434\u043D\u0430\u043A
      \u0432\u0438\u0432\u0443\u0434\u0438\u0442\u0438 \u0437\u043C\u043E\u0433\u043B\u0430
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0434\u0438\u043D \u0444\u0430\u0439\u043B.
      \u0406, \u043D\u0430 \u0436\u0430\u043B\u044C, \u0432\u0456\u043D \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0439
      \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u043C
      \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043D\u043D\u044F\u043C."
