  - m_Id: 2725242171
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0439 \u043C\u043E\u0434\u0443\u043B\u044C
      \u0434\u043B\u044F \u041F\u0456\u043F\u0411\u0430\u043A\u0430, \u0434\u0430\u0454
      \u0437\u043C\u043E\u0433\u0443 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C\u0443
      \u0447\u0430\u0441\u0456 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438
      \u0441\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
      \u0449\u043E\u0431 \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438 \u0439\u043E\u0433\u043E
      \u0441\u0438\u043B\u044C\u043D\u0456 \u0442\u0430 \u0441\u043B\u0430\u0431\u043A\u0456
      \u0441\u0442\u043E\u0440\u043E\u043D\u0438. \u0423 \u0440\u0435\u0436\u0438\u043C\u0456
      \u0417.\u041F.\u0421. \u0432\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0431\u0430\u0447\u0438\u0442\u0438
      \u0442\u043E\u0447\u043D\u0456 \u0447\u0438\u0441\u043B\u043E\u0432\u0456 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A\u0438
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0456 \u0431\u0440\u043E\u043D\u0456
      \u0432\u0430\u0448\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
