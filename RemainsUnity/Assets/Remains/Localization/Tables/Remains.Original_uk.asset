  - m_Id: 2742018206
    m_Localized: "*\u0412\u0456\u0434 \u043A\u043E\u0433\u043E: \u0421\u043A\u0430\u0440\u043B\u0435\u0442
      \u0421\u0442\u043E\u0443\u043D. \u041B\u0438\u0441\u0442 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E:
      74975 \u0434\u043D\u0456\u0432 \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      \u0442\u0435\u0440\u043C\u0456\u043D\u0438.*\n\t\"\u0414\u043E\u0431\u0440\u043E\u0433\u043E
      \u0440\u0430\u043D\u043A\u0443, \u041C\u043E\u043D\u0456\u043D. \u041F\u0440\u043E\u0431\u0430\u0447
      \u043C\u0435\u043D\u0435, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430,
      \u0449\u043E \u043C\u0435\u043D\u0456 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043F\u0438\u0441\u0430\u0442\u0438 \u0442\u043E\u0431\u0456 \u0442\u0430\u043A\u0435.
      \u0410\u043B\u0435 \u043C\u0435\u043D\u0456 \u0449\u043E\u0439\u043D\u043E
      \u0437\u0430\u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443\u0432\u0430\u043B\u0438
      \u0437 \u041C\u0412\u0422. \u0422\u0430\u043C \u0443\u0436\u0435 \u043D\u0435
      \u043C\u043E\u0436\u0443\u0442\u044C \u043D\u0430\u0441 \u0447\u0435\u043A\u0430\u0442\u0438.
      \u041F\u0440\u043E\u0439\u0448\u043B\u0438 \u0432\u0441\u0456 \u0442\u0435\u0440\u043C\u0456\u043D\u0438.
      \u041D\u0430\u043C \u0432\u0438\u0441\u0443\u043D\u0443\u043B\u0438 \u0443\u043B\u044C\u0442\u0438\u043C\u0430\u0442\u0443\u043C:
      \u043C\u0438 \u043C\u0430\u0454\u043C\u043E \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443 \u0437\u0430 \u0442\u0440\u0438 \u0434\u043D\u0456,
      \u0456\u043D\u0430\u043A\u0448\u0435 \u0432 \u043D\u0430\u0441 \u0432\u0438\u043B\u0443\u0447\u0430\u0442\u044C
      \u0443\u0441\u0456 \u043D\u0430\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043D\u043D\u044F
      \u0437\u0430 \u043F\u0440\u043E\u0454\u043A\u0442\u043E\u043C \u0456 \u043F\u0435\u0440\u0435\u0434\u0430\u0434\u0443\u0442\u044C
      \u043D\u0430 \u0456\u043D\u0448\u0435 \u043F\u0456\u0434\u043F\u0440\u0438\u0454\u043C\u0441\u0442\u0432\u043E.
      \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u043A\u0430\u0436\u0438
      \u043C\u0435\u043D\u0456, \u0449\u043E \u043C\u0438 \u0432\u0441\u0442\u0438\u0433\u0430\u0454\u043C\u043E!\""
