      \u0434\u043B\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0443 \u044F\u043A\u043E\u043C\u0443 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430
      \u0432\u0431\u0438\u0432\u0447\u0430 \u0441\u0438\u043B\u0430 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241676
    m_Localized: "\u041F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B. 20"
