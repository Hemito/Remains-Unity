  - m_Id: 2725242163
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u0438\u0439 \u0456 \u0434\u043E\u0440\u043E\u0433\u0438\u0439
      \u0456\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442, \u0449\u043E \u043F\u043E\u0454\u0434\u043D\u0443\u0454
      \u0432 \u0441\u043E\u0431\u0456 \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0443
      \u043C\u0430\u0433\u0456\u044E \u0456 \u043D\u0430\u043D\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457.
      \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430
      \u043F\u043E #1 \u043E\u0434. \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443,
      \u043D\u0435 \u0432\u0438\u043C\u0430\u0433\u0430\u044E\u0447\u0438 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445
      \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432, \u0430\u043B\u0435 \u043D\u0435
      \u0432\u0438\u0449\u0435 #2 \u0432\u0456\u0434 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242164
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0437\u0430\u043F\u043E\u0431\u0456\u0436\u043D\u0438\u043A"
