  - m_Id: 2725242126
    m_Localized: "\u041A\u043B\u044E\u0447 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242127
    m_Localized: "\u041F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u043E
      \u0440\u0456\u0437\u043D\u0438\u0445 \u0437\u0430\u043C\u043A\u0456\u0432 \u0443
      \u043B\u0456\u0433\u0432\u0456 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242128
    m_Localized: "\u041A\u043B\u044E\u0447 \u0441\u043B\u0443\u0436\u0431\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242129
    m_Localized: "\u0412\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454 \u0434\u043E\u0441\u0442\u0443\u043F
      \u0434\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0443 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C \u041C\u0435\u0439\u043D\u0422\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242130
    m_Localized: "\u041A\u043B\u044E\u0447 \u0434\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242131
    m_Localized: "\u0412\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454 \u0434\u043E\u0441\u0442\u0443\u043F
      \u0434\u043E \u043A\u0430\u0431\u0456\u043D\u0435\u0442\u0443 \u0434\u043E\u0433\u043B\u044F\u0434\u0430\u0447\u043A\u0438
      \u0421\u0442\u0456\u0439\u043B\u0430 88."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242132
    m_Localized: "\u041A\u043B\u044E\u0447 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242133
    m_Localized: "\u041A\u043B\u044E\u0447, \u0432\u0456\u0434\u0456\u0431\u0440\u0430\u043D\u0438\u0439
      \u0443 \u0434\u0443\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0430 \u0437 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0430,
      \u041A\u0440\u0438\u0432\u0430\u0432\u043E\u0433\u043E \u041C\u0456\u0441\u044F\u0446\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242134
    m_Localized: "\u041A\u043B\u044E\u0447 \u041D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242135
    m_Localized: "\u041A\u043B\u044E\u0447, \u0449\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u0432
      \u0437\u0435\u0431\u0440\u0456-\u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0443
      \u041C\u0447\u0430\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242136
    m_Localized: "\u041A\u043B\u044E\u0447 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242137
    m_Localized: "\u041A\u043B\u044E\u0447, \u0449\u043E \u0431\u0443\u0432 \u043F\u0440\u0438
      \u0441\u043E\u0431\u0456 \u0443 \u0441\u0442\u0430\u0440\u0456\u0439\u0448\u0438\u043D\u0438
      \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242138
    m_Localized: "\u041A\u043B\u044E\u0447 \u0432\u0456\u0434 \u043F\u0456\u0434\u0441\u043E\u0431\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242139
    m_Localized: "\u041A\u043B\u044E\u0447 \u041E\u0443\u043A\u0430 \u0421\u0442\u0430\u043B\u0432\u043E\u0440\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242140
    m_Localized: "\u0414\u0443\u0436\u0435 \u0446\u0456\u043D\u043D\u0438\u0439 \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242141
    m_Localized: "\u041A\u043B\u044E\u0447 \u0432\u0456\u0434 \u044F\u043A\u043E\u0433\u043E\u0441\u044C
      \u043F\u0456\u0434\u0432\u0430\u043B\u0443 \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0456,
      \u0437\u0430 \u0447\u0443\u0442\u043A\u0430\u043C\u0438, \u043F\u043E\u0432\u043D\u043E\u0433\u043E
      \u0441\u043A\u0430\u0440\u0431\u0456\u0432. \u041D\u0443, \u0442\u043E\u0431\u0442\u043E,
      \u0432\u0438 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0454\u0442\u0435\u0441\u044F,
      \u0449\u043E \u0446\u0435 \u0442\u0430\u043A \u0456 \u0454 \u0456 \u0449\u043E
      \u043A\u043B\u044E\u0447 \u0442\u043E\u0433\u043E \u0432\u0430\u0440\u0442\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242142
    m_Localized: "\u041A\u043B\u044E\u0447 \u0446\u0435\u043D\u0442\u0443\u0440\u0456\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242143
    m_Localized: "\u041A\u043B\u044E\u0447, \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0438\u0439
      \u0443 \u0448\u0442\u0430\u0431\u0456 \u041B\u0435\u0433\u0456\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242144
    m_Localized: "\u041A\u043B\u044E\u0447 \u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242145
    m_Localized: "\u041A\u043B\u044E\u0447, \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0438\u0439
      \u0432\u0456\u0434 \u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A\u0430,
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430 \u0431\u0430\u0437\u0438
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242146
    m_Localized: "\u041C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242147
    m_Localized: "\u041C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0430 -
      \u0443\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430 \u0440\u0456\u0447.
      \u0417\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0456 \u044F\u043A
      \u0437\u0431\u0440\u043E\u044F, \u0456 \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
      \u0449\u043E\u0431 \u043B\u0430\u043C\u0430\u0442\u0438 \u0440\u0456\u0437\u043D\u0456
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438. \u0417 \u0457\u0457 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432, \u0432\u0438\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438
      \u0434\u0432\u0435\u0440\u0456 \u0442\u0430 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0442\u0438
      \u043D\u0435\u043C\u0456\u0446\u043D\u0456 \u0441\u0442\u0456\u043D\u0438.
      \u0422\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u043A\u0440\u0438\u0432\u0430\u0442\u0438
      \u0441\u043A\u0440\u0438\u043D\u0456 \u0442\u0430 \u0456\u043D\u0448\u0456
      \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0438, \u0437\u0430\u043C\u043E\u043A
      \u0443 \u044F\u043A\u0438\u0445 \u043D\u0435 \u043F\u0456\u0434\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437\u043B\u043E\u043C\u0443 \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u043E\u044E.
      \u0406 \u0440\u0435\u0447\u0456 \u0437 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430,
      \u0456 \u0441\u0430\u043C\u0430 \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0430
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0431\u0443\u0434\u0443\u0442\u044C
      \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242148
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242149
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0456\u0437 \u043F\u0456\u0434\u0437\u0430\u0440\u044F\u0434\u043A\u043E\u044E
      - \u0432\u0434\u0430\u043B\u0430 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0430.
      \u0412\u0456\u043D \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0434\u043E
      \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434\u0443 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0449\u043E \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0431\u0430\u0442\u0430\u0440\u0435\u0439. \u0417\u0430\u0440\u044F\u0434\u0438
      \u0432 \u043D\u044C\u043E\u043C\u0443 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0456 \u0441\u043E\u0431\u043E\u044E \u0437 \u043F\u043B\u0438\u043D\u043E\u043C
      \u0447\u0430\u0441\u0443."
