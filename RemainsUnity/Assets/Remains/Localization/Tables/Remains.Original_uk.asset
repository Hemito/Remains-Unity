      m_Items: []
  - m_Id: 2742018205
    m_Localized: "*\u041A\u043E\u043C\u0443: \u0421\u043A\u0430\u0440\u043B\u0435\u0442
      \u0421\u0442\u043E\u0443\u043D. \u041B\u0438\u0441\u0442 \u043D\u0430\u0434\u0456\u0441\u043B\u0430\u043D\u043E:
      75011 \u0434\u043D\u0456\u0432 \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      (re) \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B.*\n\t\"\u041F\u0440\u0438\u0432\u0456\u0442.
      \u0422\u0430\u043A, \u0448\u0435\u0444, \u044F \u0432\u0441\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E.
      \u0410\u043B\u0435 \u0446\u0456 \u0432\u0438\u043C\u043E\u0433\u0438 \u0432\u0456\u0434
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043B\u044E\u0442\u0456! \u0422\u0438 \u0437\u043D\u0430\u0454\u0448, \u043C\u0438
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0456\u0447\u043E\u0433\u043E \u043F\u043E\u0434\u0456\u0431\u043D\u043E\u0433\u043E
      \u0440\u0430\u043D\u0456\u0448\u0435 \u043D\u0435 \u0440\u043E\u0431\u0438\u043B\u0438.
      \u041D\u0430\u043C \u0449\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
      \u0445\u043E\u0447\u0430 \u0431 \u0442\u0438\u0436\u0434\u0435\u043D\u044C
      \u043D\u0430 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0443
      \u0456 \u0449\u0435 \u0434\u0432\u0430 \u0442\u0438\u0436\u043D\u0456 \u043D\u0430
      \u0432\u0438\u043F\u0430\u0434\u043E\u043A, \u044F\u043A\u0449\u043E \u0449\u043E\u0441\u044C
      \u043F\u0456\u0434\u0435 \u043D\u0435 \u0442\u0430\u043A. \u0422\u043E\u043C\u0443
      \u0437\u0430\u043F\u0438\u0441\u0443\u0439 \u043D\u0430\u043C \u043C\u0456\u0441\u044F\u0446\u044C,
      \u044F\u043A\u0449\u043E \u0434\u0430\u0434\u0443\u0442\u044C.\""
