    m_Localized: "\u041B\u0438\u0448\u0435 \u0431 \u0432\u0456\u043D \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630058
    m_Localized: "*\u041F\u0456\u0434'\u0454\u0434\u043D\u0430\u043D\u043D\u044F
      \u043D\u043E\u0432\u043E\u0433\u043E \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F*
      *\u041E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F \u043F\u0456\u0434'\u0454\u0434\u043D\u0430\u043D\u043E:
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0439 \u043A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440
      \"\u041F\u0456\u043F\u0411\u0430\u043A\", \u043C\u043E\u0434\u0435\u043B\u044C
      PX 778185578322 S* *\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456
      \u043F\u0440\u0430\u0432\u0430: \u0433\u0456\u0441\u0442\u044C* *\u0423\u0432\u0430\u0433\u0430:
      \u043F\u0440\u0430\u0432\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432
      \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \"\u0433\u0456\u0441\u0442\u044C\"
      \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043E. \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435:
      \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438 \u043D\u043E\u0432\u0456
      \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u0456 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438,
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u0442\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438
      \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \"F\", \u0437\u0430\u043F\u0438\u0442\u0443\u0432\u0430\u0442\u0438
      \u0441\u0435\u0430\u043D\u0441 \u0437\u0432'\u044F\u0437\u043A\u0443 \u0437
      \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0430\u043C\u0438 \u0437\u0456 \u0441\u043F\u0438\u0441\u043A\u0443
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432, \u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438
      \u0442\u0430 \u0432\u043E\u043B\u043E\u0433\u043E\u0441\u0442\u0456 \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u044F,
      \u0437\u0456\u0433\u0440\u0430\u0442\u0438 \u0437 \u043A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440\u043E\u043C
      \u0443 \"\u0412\u0433\u0430\u0434\u0430\u0439 \u0441\u043B\u043E\u0432\u043E\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733630059
    m_Localized: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0445 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432."
