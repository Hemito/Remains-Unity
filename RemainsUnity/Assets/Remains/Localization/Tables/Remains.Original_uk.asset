  - m_Id: 2737823822
    m_Localized: "\u0417 \u043E\u0434\u043D\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430.
      \u0406 \u0437 \u043E\u0434\u043D\u0456\u0454\u044E \u0456\u0441\u0442\u043E\u0440\u0456\u0454\u044E.
      \u0421\u0442\u0435\u0440\u043B\u0438 \u043F\u0430\u043C'\u044F\u0442\u044C,
      \u0449\u043E\u0431 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0437\u0430\u0433\u0440\u043E\u0437, \u043D\u0430 \u043F\u043E\u0442\u0430\u043B\u0443
      \u044F\u043A\u0438\u043C \u043D\u0430\u0441 \u0431\u0435\u0437\u0436\u0430\u043B\u044C\u043D\u043E
      \u0432\u0438\u043A\u0438\u043D\u0443\u043B\u0438. \u041C\u0430\u043B\u043E
      \u0447\u0438\u043C \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043E\u0434\u043D\u0435
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0434\u0438\u0432\u0443\u0432\u0430\u0442\u0438,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823823
    m_Localized: "\u0422\u0430\u043A, \u043D\u0435 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823824
    m_Localized: "\u0420\u043E\u0437\u043C\u043E\u0432\u0430 \u0437 \u0412\u0435\u043B\u044C\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823825
    m_Localized: "\u042F\u043A \u044F \u0456 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0437\u0430\u0440\u0430\u0437 \u044F \u043F\u0440\u044F\u043C\u0443\u044E
      \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442. \u0422\u0438
      \u0437\u043D\u0430\u0454\u0448 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u0440\u043E \u0446\u0435 \u043C\u0456\u0441\u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823826
    m_Localized: "\u042F \u0432\u0441\u0435 \u0449\u0435 \u043D\u0430\u043F\u043E\u043B\u044F\u0433\u0430\u044E,
      \u0449\u043E \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u0437\u0430\u0431\u0443\u0442\u0438
      \u043F\u0440\u043E \u0441\u0432\u043E\u044E \u043C\u0456\u0441\u0456\u044E,
      @lp. \u042F\u043A\u0449\u043E \u043D\u0435 \u0437\u0430\u0440\u0430\u0434\u0438
      \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u044F \u0441\u0432\u0456\u0442\u0443
      \u0432\u0456\u0434 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0457 \u0437\u0430\u0433\u0440\u043E\u0437\u0438,
      \u0442\u043E \u0445\u043E\u0447\u0430 \u0431 \u0437\u0430\u0440\u0430\u0434\u0438
      \u0441\u0432\u043E\u0454\u0457 \u0436 \u0431\u0435\u0437\u043F\u0435\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823827
    m_Localized: "\u042F \u043D\u0435 \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u043B\u044E
      \u0432\u0456\u0434 \u0441\u0432\u043E\u0454\u0457 \u043C\u0435\u0442\u0438,
      \u0412\u0435\u043B\u044C\u0432\u0435\u0442. \u0412\u0438\u0431\u0430\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823828
    m_Localized: "\u0413\u0430\u0440\u0430\u0437\u0434. \u042F \u043F\u0440\u0438\u0439\u043C\u0443
      \u0442\u0432\u043E\u044E \u043F\u043E\u0437\u0438\u0446\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823829
    m_Localized: "\u0417\u0435\u0431\u0440\u0438, \u0449\u043E \u0436\u0438\u0432\u0443\u0442\u044C
      \u0442\u0443\u0442, \u0456\u043D\u043E\u0434\u0456 \u0437\u0430\u0431\u0440\u0456\u0434\u0430\u044E\u0442\u044C
      \u0443 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442. \u0426\u0435
      \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E,
      \u0430\u043B\u0435 \u044F\u043A\u0449\u043E \u0442\u0438 \u0437\u043D\u0430\u0454\u0448,
      \u0437\u0432\u0456\u0434\u043A\u0438 \u0431\u0443\u0434\u0435 \u043D\u0430\u0434\u0445\u043E\u0434\u0438\u0442\u0438
      \u0437\u0430\u0433\u0440\u043E\u0437\u0430, \u0448\u0430\u043D\u0441\u0438
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0437\u0432\u0456\u0434\u0442\u0438
      \u0436\u0438\u0432\u0438\u043C \u0454. \u0417\u0430\u043F\u0438\u0442\u0430\u0439
      \u043F\u0440\u043E \u0446\u0435 \u0417\u0430\u043C\u0431\u0435\u0437\u0456,
      \u0432\u043E\u043D\u0430 \u0432\u0436\u0435 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0440\u0430\u0437\u0456\u0432 \u0431\u0443\u0432\u0430\u043B\u0430 \u0432
      \u043C\u0456\u0441\u0442\u0456. \u0406\u043D\u043E\u0434\u0456 \u043F\u0438\u0442\u0430\u043D\u043D\u044F
      \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F \u043C\u043E\u0436\u0435
      \u0437\u043C\u0443\u0441\u0438\u0442\u0438 \u0442\u0435\u0431\u0435 \u0439\u0442\u0438
      \u043D\u0430 \u0441\u0442\u0440\u0430\u0448\u043D\u0438\u0439 \u0440\u0438\u0437\u0438\u043A,
      \u0456 \u0432\u043E\u043D\u0430 \u0437 \u0446\u0438\u043C \u0437\u043D\u0430\u0439\u043E\u043C\u0430
      \u043A\u0440\u0430\u0449\u0435 \u0437\u0430 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823830
    m_Localized: "\u0414\u044F\u043A\u0443\u044E. \u0410\u043B\u0435 \u0447\u0438
      \u043C\u043E\u0436\u0435\u0448 \u0442\u0438 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438
      \u043C\u0435\u043D\u0456 \u043F\u0440\u043E \u0446\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456\u0448\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823831
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E. \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D
      - \u0446\u0435 \u043F\u0440\u0438\u0442\u0443\u043B\u043E\u043A \u0442\u0438\u0445
      \u0437\u0435\u0431\u0440, \u044F\u043A\u0456 \u0432\u0456\u0434\u043A\u0438\u043D\u0443\u043B\u0438
      \u0437\u0430\u043A\u043B\u0438\u043A \u041B\u0435\u0433\u0456\u043E\u043D\u0443.
      \u0417\u0435\u0431\u0440\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u044F\u0442\u044C
      \u043F\u043E\u043D\u0456 \u0432\u0441\u0456\u0454\u044E \u0434\u0443\u0448\u0435\u044E
      \u0456 \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C, \u0449\u043E \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u043D\u0430\u0441 \u0432\u0438\u043D\u0438\u0449\u0438\u0442\u0438 \u0434\u043E
      \u0454\u0434\u0438\u043D\u043E\u0433\u043E. \u0412\u043E\u043D\u0438 \u0432\u0438\u043C\u0430\u0433\u0430\u044E\u0442\u044C
      \u0432\u0456\u0434 \u043A\u043E\u0436\u043D\u043E\u0457 \u0437\u0435\u0431\u0440\u0438
      \u0441\u0442\u0430\u0442\u0438 \u043F\u0456\u0434 \u0457\u0445\u043D\u0456
      \u043F\u0440\u0430\u043F\u043E\u0440\u0438 \u0432 \u0446\u0456\u0439 \u0441\u0432\u044F\u0442\u0456\u0439
      \u0432\u0456\u0439\u043D\u0456. \u042F\u043A\u0449\u043E \u0445\u0442\u043E\u0441\u044C
      \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F,
      \u0432\u0456\u043D \u0441\u0442\u0430\u0454 \u0442\u0430\u043A\u0438\u043C
      \u0441\u0430\u043C\u0438\u043C \u0432\u043E\u0440\u043E\u0433\u043E\u043C \u041B\u0435\u0433\u0456\u043E\u043D\u0443,
      \u044F\u043A \u0456 \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823832
    m_Localized: "\u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D -
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0438\u0439 \u043F\u0440\u0438\u0442\u0443\u043B\u043E\u043A
      \u0434\u043B\u044F \u0442\u0430\u043A\u0438\u0445 \u0437\u0435\u0431\u0440.
      \u0422\u0443\u0442 \u0457\u0445 \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435
      \u041B\u0435\u0433\u0456\u043E\u043D. \u0410\u043B\u0435 \u0432 \u0446\u0456\u0439
      \u0433\u043B\u0443\u0448\u0438\u043D\u0456 \u0434\u0443\u0436\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E
      \u0432\u0438\u0436\u0438\u0442\u0438. \u0411\u0430\u0433\u0430\u0442\u043E
      \u0445\u0442\u043E \u0445\u0432\u043E\u0440\u0456\u0454, \u0432\u0435\u0441\u044C
      \u0442\u0430\u0431\u0456\u0440 \u0447\u0430\u0441 \u0432\u0456\u0434 \u0447\u0430\u0441\u0443
      \u0437\u043C\u0443\u0448\u0435\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0434\u0443\u0432\u0430\u0442\u0438.
      \u0414\u0436\u0435\u0440\u0435\u043B\u043E\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445
      \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0441\u0442\u0430\u044E\u0442\u044C
      \u0430\u0431\u043E \u0434\u0430\u043B\u0435\u043A\u0456 \u043F\u043E\u0445\u043E\u0434\u0438
      \u0432 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0456 \u043C\u0456\u0441\u0442\u0430,
      \u0430\u0431\u043E \u0432\u043A\u0440\u0430\u0439 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456
      \u0432\u0438\u043B\u0430\u0437\u043A\u0438 \u0434\u043E \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0443.
      \u041D\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u0454 \u0440\u0456\u0434\u043A\u043E
      \u0445\u0442\u043E \u043D\u0430\u0432\u0430\u0436\u0443\u0454\u0442\u044C\u0441\u044F,
      \u0456 \u0442\u0438\u0445, \u0445\u0442\u043E \u0443\u0441\u043F\u0456\u0448\u043D\u043E
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F, \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C
      \u0433\u0435\u0440\u043E\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823833
    m_Localized: "\u042F \u043F\u0440\u0438\u0439\u0448\u043B\u0430 \u0441\u044E\u0434\u0438,
      \u043A\u043E\u043B\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0430\u0441\u044F
      \u0456\u0437 \u0437\u0430\u0433\u043E\u043D\u043E\u043C \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445
      \u0437\u0435\u0431\u0440, \u044F\u043A\u0456 \u0431\u043B\u0443\u043A\u0430\u043B\u0438
      \u0440\u0443\u0457\u043D\u0430\u043C\u0438 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D\u0430.
      \u0407\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0431\u0443\u043B\u0430
      \u043C\u0435\u0434\u0438\u0447\u043D\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430,
      \u044F\u043A\u0443 \u0457\u043C \u043D\u0456\u0437\u0432\u0456\u0434\u043A\u0438
      \u0431\u0443\u043B\u043E \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438.
      \u042F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0430 \u0457\u043C
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0457\u0445\u043D\u044C\u043E\u0457
      \u0434\u043E\u043C\u0456\u0432\u043A\u0438, \u0430 \u0442\u0435\u043F\u0435\u0440
      \u0442\u0443\u0442 \u044F \u043B\u0456\u043A\u0443\u044E \u0432\u0441\u0456\u0445
      \u043D\u0443\u0436\u0434\u0435\u043D\u043D\u0438\u0445. \u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430
      \u0457\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u043A\u0443\u0434\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u043C
      \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823834
    m_Localized: "\u0414\u044F\u043A\u0443\u044E, \u0412\u0435\u043B\u044C\u0432\u0435\u0442.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u0442\u0435\u0436 \u0437\u043C\u043E\u0436\u0443
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0457\u043C \u0447\u0438\u043C\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823835
    m_Localized: "\u0426\u0435 \u0431\u0443\u043B\u043E \u0431 \u0434\u0443\u0436\u0435
      \u0434\u043E\u0440\u0435\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823836
    m_Localized: "\u0426\u0435\u0439 \u043F\u0442\u0430\u0445, \u0432\u0456\u043D...
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0438\u0439..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823837
    m_Localized: "\u041A\u0432\u0456\u0440\u0440\u0440\u0440\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823838
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0449\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438...
      \u0445\u043E\u0442\u0456\u043B\u0430 \u0431 \u044F \u0442\u0435\u0436 \u043C\u0430\u0442\u0438
      \u0442\u0430\u043A\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823839
    m_Localized: "\u0417\u0430\u043C\u0431\u0435\u0437\u0456 \u043F\u0440\u043E \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823840
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823841
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u043D\u044F \u0442\u043E\u0431\u0456,
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044F. \u041C\u0435\u043D\u0435
      \u0437\u0432\u0443\u0442\u044C \u0417\u0430\u043C\u0431\u0435\u0437\u0456.
      \u0410 \u044F\u043A\u0435 \u0442\u0432\u043E\u0454 \u0456\u043C'\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823842
    m_Localized: "@lp. \u041F\u0440\u0438\u0454\u043C\u043D\u043E \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0442\u0438\u0441\u044F.
      \u041C\u0435\u043D\u0435 \u0441\u043A\u0435\u0440\u0443\u0432\u0430\u043B\u0438
      \u0434\u043E \u0442\u0435\u0431\u0435 \u044F\u043A \u0434\u043E \u0437\u0435\u0431\u0440\u0438,
      \u044F\u043A\u0430 \u043A\u0440\u0430\u0449\u0435 \u0437\u0430 \u0456\u043D\u0448\u0438\u0445
      \u0437\u043D\u0430\u0454 \u043F\u0440\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823843
    m_Localized: "\u0426\u0435 \u0456\u0441\u0442\u0438\u043D\u0430, \u043D\u0435
      \u043F\u0440\u0438\u0445\u043E\u0432\u0443\u044E. \u0427\u0438\u043C\u0430\u043B\u043E
      \u0432\u0438\u043B\u0430\u0437\u043E\u043A \u044F \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u0432 \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0435 \u041C\u0456\u0441\u0442\u043E.
      \u041D\u0435\u0432\u0436\u0435 \u0442\u0432\u0456\u0439 \u0448\u043B\u044F\u0445
      \u0432\u0435\u0434\u0435 \u0442\u0435\u0431\u0435 \u0432 \u0442\u0456 \u0441\u0430\u043C\u0456
      \u0441\u0442\u0456\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823844
    m_Localized: "\u041D\u0430 \u0436\u0430\u043B\u044C, \u0446\u0435 \u0442\u0430\u043A.
      \u041C\u0435\u043D\u0456 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0432 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442.
      \u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u043C\u0435\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823845
    m_Localized: "\u0417\u043D\u0430\u043D\u043D\u044F - \u0432\u0435\u043B\u0438\u043A\u0430
      \u0441\u0438\u043B\u0430, \u0456 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0432\u043E\u043D\u0438 \u043D\u0435 \u0434\u0456\u0441\u0442\u0430\u044E\u0442\u044C\u0441\u044F
      \u0437\u0430\u0434\u0430\u0440\u043C\u0430. \u0410\u043B\u0435 \u0445\u0442\u043E
      \u043D\u0430\u0436\u0438\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0438\u0445, \u0449\u043E \u0456\u0441\u0442\u0438\u043D\u043D\u043E
      \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454, \u0431\u0443\u0434\u0443\u0442\u044C
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0456 \u0434\u0443\u0445\u0430\u043C\u0438
      \u043F\u0440\u0435\u0434\u043A\u0456\u0432 \u043D\u0430 \u0432\u0456\u043A\u0438
      \u0432\u0456\u0447\u043D\u0456. \u042F \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C
      \u0442\u043E\u0431\u0456 \u0432\u0441\u0435, \u0449\u043E \u0437\u043D\u0430\u044E,
      @lp, \u0456 \u043D\u0435 \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0437\u0430
      \u0446\u0435 \u043D\u0456 \u043A\u0440\u0438\u0448\u0435\u0447\u043A\u0438.
      \u0421\u043B\u0443\u0445\u0430\u0439 \u0443\u0432\u0430\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823846
    m_Localized: "\u041A\u043E\u043B\u0438\u0441\u044C \u0434\u0430\u0432\u043D\u043E
      \u0440\u0456\u0434 \u0437\u0435\u0431\u0440 \u0456 \u0440\u0456\u0434 \u043F\u043E\u043D\u0456
      \u043F\u043E\u0447\u0430\u043B\u0438 \u043C\u0456\u0436 \u0441\u043E\u0431\u043E\u044E
      \u0432\u0456\u0439\u043D\u0443. \u0421\u043F\u0435\u0440\u0448\u0443 \u043C\u0430\u043B\u0430,
      \u0457\u0445\u043D\u044F \u0432\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0430
      \u0434\u0435\u0434\u0430\u043B\u0456 \u0448\u0438\u0440\u0438\u043B\u0430\u0441\u044C
      \u0437 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u043E\u043A\u043E\u043C,
      \u0456 \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u043C\u0456\u0433 \u0437\u0430\u0433\u0430\u0441\u0438\u0442\u0438
      \u0446\u044E \u043F\u043E\u0436\u0435\u0436\u0443, \u0430\u0436 \u0434\u043E\u043A\u0438
      \u0441\u0432\u0456\u0442 \u043D\u0435 \u0437\u0433\u043E\u0440\u0456\u0432
      \u0432\u0449\u0435\u043D\u0442 \u0443 \u043F\u043E\u043B\u0443\u043C'\u0457
      \u0437\u043B\u043E\u0431\u0438 \u0456 \u0441\u0442\u0440\u0430\u0445\u0443.
      \u041A\u043E\u043B\u0438 \u0446\u0435 \u0441\u0442\u0430\u043B\u043E\u0441\u044F,
      \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456 \u0448\u0430\u043C\u0430\u043D\u0438
      \u0437\u0435\u0431\u0440 \u0432\u0434\u0430\u043B\u0438\u0441\u044F \u0434\u043E
      \u043D\u0430\u0439\u0441\u0442\u0440\u0430\u0448\u043D\u0456\u0448\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C, \u0449\u043E \u0454
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u0441\u0432\u0456\u0442\u0456 - \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823847
    m_Localized: "\u0412\u043E\u043D\u0438 \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0433\u0430\u0437, \u044F\u043A\u0438\u0439
      \u0437\u0432\u0430\u0432\u0441\u044F \u0420\u043E\u0436\u0435\u0432\u043E\u044E
      \u0425\u043C\u0430\u0440\u043E\u044E, \u0456 \u0437\u0430\u0442\u043E\u0447\u0438\u043B\u0438
      \u0439\u043E\u0433\u043E \u0432 \u0430\u043C\u0443\u043B\u0435\u0442\u0438,
      \u0437 \u044F\u043A\u0438\u0445 \u0432\u0456\u043D \u0439\u0448\u043E\u0432
      \u0432\u0456\u0447\u043D\u0438\u043C \u043F\u043E\u0442\u043E\u043A\u043E\u043C.
      \u0426\u0456 \u0430\u043C\u0443\u043B\u0435\u0442\u0438 \u0431\u0443\u043B\u0438
      \u043F\u043E\u0442\u0430\u0439\u043A\u0438 \u0437\u0430\u0445\u043E\u0432\u0430\u043D\u0456
      \u0432 \u043D\u0430\u0434\u0440\u0430\u0445 \u0441\u0442\u043E\u043B\u0438\u0446\u0456
      \u0440\u043E\u0434\u0443 \u043F\u043E\u043D\u0456, \u0456 \u043A\u043E\u043B\u0438
      \u043F\u0440\u0438\u0439\u0448\u043E\u0432 \u0447\u0430\u0441, \u043D\u0430
      \u0432\u0443\u043B\u0438\u0446\u0456 \u043C\u0456\u0441\u0442\u0430 \u0432\u0438\u0440\u0432\u0430\u043B\u0438\u0441\u044F
      \u043C\u043E\u0433\u0443\u0442\u043D\u0456 \u0445\u043C\u0430\u0440\u0438 \u0440\u043E\u0436\u0435\u0432\u043E\u0457
      \u0441\u043C\u0435\u0440\u0442\u0456. \u0410\u043B\u0435 \u0442\u0456, \u043A\u043E\u043C\u0443
      \u043D\u0435 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0432 \u0446\u0456 \u0445\u043C\u0430\u0440\u0438, \u0440\u0456\u0434\u043A\u043E
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438 \u0441\u043F\u043E\u043A\u0456\u0439.
      \u0406 \u043F\u0456\u0441\u043B\u044F \u0437\u0430\u0433\u0438\u0431\u0435\u043B\u0456
      \u0432\u043E\u043D\u0438 \u043F\u0440\u0438\u0440\u0435\u0447\u0435\u043D\u0456
      \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u0438 \u0437\u043D\u043E\u0432\u0443
      \u0456 \u0437\u043D\u043E\u0432\u0443, \u0431\u0435\u0437\u0446\u0456\u043B\u044C\u043D\u043E
      \u0431\u043B\u0443\u043A\u0430\u044E\u0447\u0438 \u0432\u0443\u043B\u0438\u0446\u044F\u043C\u0438,
      \u0449\u043E \u043A\u043E\u043B\u0438\u0441\u044C \u0431\u0443\u043B\u0438
      \u0440\u0456\u0434\u043D\u0438\u043C\u0438 \u0457\u043C. \u042F\u043A\u0449\u043E
      \u0442\u043E\u0431\u0456 \u043D\u0435 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u0442\u044C
      \u0437\u0456\u0442\u043A\u043D\u0443\u0442\u0438\u0441\u044F \u0437 \u0446\u0438\u043C\u0438
      \u043D\u0435\u0449\u0430\u0441\u043D\u0438\u043C\u0438, \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0441\u044F,
      \u0449\u043E \u0457\u0445\u043D\u0454 \u0442\u0456\u043B\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0435\u0437\u0434\u0430\u0442\u043D\u0435 \u043F\u0456\u0434\u043D\u044F\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823848
    m_Localized: "\u0410\u043B\u0435 \u0434\u0430\u043B\u0435\u043A\u043E \u043D\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0446\u0456 \u0431\u0456\u0434\u043D\u0456
      \u043F\u043E\u043D\u0456 \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0442\u043E\u0431\u0456 \u0442\u0430\u043C. \u041D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u043B\u044C\u043D\u0430 \u0431\u0443\u043B\u0430 \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C
      \u0448\u0430\u043C\u0430\u043D\u0456\u0432, \u044F\u043A\u0456 \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438
      \u0420\u043E\u0436\u0435\u0432\u0443 \u0425\u043C\u0430\u0440\u0443, \u0449\u043E
      \u0432\u043E\u043D\u0430 \u0434\u043E\u0441\u0456 \u0436\u0438\u0432\u0435
      \u0432 \u0442\u0456\u043D\u0456 \u0437\u0430\u043C\u043A\u0456\u0432 \u0456
      \u043F\u0430\u043B\u0430\u0446\u0456\u0432 \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0433\u043E
      \u041C\u0456\u0441\u0442\u0430. \u0414\u0438\u0445\u0430\u0442\u0438 \u043D\u0435\u044E
      - \u0441\u043C\u0435\u0440\u0442\u0456 \u043F\u043E\u0434\u0456\u0431\u043D\u043E,
      \u0456 \u043D\u0435 \u0432\u0440\u044F\u0442\u0443\u0454 \u0442\u0435\u0431\u0435
      \u0432\u0456\u0434 \u043D\u0435\u0457 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430 \u043C\u0430\u0441\u043A\u0430,
      \u0430 \u0431\u0440\u043E\u043D\u044F \u0441\u0442\u0430\u043D\u0435 \u0442\u0432\u043E\u0454\u044E
      \u043F\u043E\u0433\u0438\u0431\u0435\u043B\u043B\u044E. \u0423\u0441\u0435,
      \u0447\u043E\u0433\u043E \u0442\u043E\u0440\u043A\u0430\u0454\u0442\u044C\u0441\u044F
      \u0445\u043C\u0430\u0440\u0430, \u0441\u0442\u0430\u0454 \u0454\u0434\u0438\u043D\u0438\u043C
      \u0446\u0456\u043B\u0438\u043C, \u0456 \u0442\u0432\u0456\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0443\u043F'\u0454\u0442\u044C\u0441\u044F \u0432 \u0442\u0435\u0431\u0435,
      \u0449\u043E\u0431 \u043D\u0435 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438
      \u043D\u0456\u043A\u043E\u043B\u0438 \u0431\u0456\u043B\u044C\u0448\u0435.
      \u042F\u043A\u0449\u043E \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0437\u0430\u0439\u0442\u0438 \u0432 \u043A\u043B\u0443\u0431\u0438 \u0446\u044C\u043E\u0433\u043E
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F, \u0437\u043D\u0456\u043C\u0438
      \u0437 \u0441\u0435\u0431\u0435 \u0432\u0441\u0435 \u0437\u0430\u0439\u0432\u0435
      \u0456 \u043D\u0435\u0441\u0438 \u043F\u043E\u0434\u0430\u043B\u0456 \u0432\u0456\u0434
      \u0442\u0456\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823849
    m_Localized: "\u041C\u0456\u0441\u0446\u044F\u043C\u0438 \u0420\u043E\u0436\u0435\u0432\u0430
      \u0425\u043C\u0430\u0440\u0430 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0442\u0438\u0441\u043D\u0443\u043B\u0430\u0441\u044F, \u0449\u043E
      \u0441\u0442\u0430\u043B\u0430 \u0440\u0456\u0434\u043A\u043E\u044E \u0430\u0431\u043E
      \u043C\u0430\u0439\u0436\u0435 \u0442\u0432\u0435\u0440\u0434\u043E\u044E.
      \u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0434\u0443\u043C\u0430\u0439
      \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0438 \u043D\u0430 \u0446\u0456
      \u0433\u0440\u0443\u0434\u043A\u0438 \u0440\u043E\u0436\u0435\u0432\u043E\u0457
      \u0436\u043E\u0432\u0447\u0456, \u0431\u043E \u0432\u043E\u043D\u0438 \u043B\u0443\u0441\u043D\u0443\u0442\u044C
      \u0443 \u0442\u0435\u0431\u0435 \u043F\u0456\u0434 \u043D\u043E\u0433\u0430\u043C\u0438,
      \u043D\u0435\u043C\u043E\u0432 \u043F\u0435\u0440\u0435\u0441\u0442\u0438\u0433\u043B\u0438\u0439
      \u043C\u0443\u0442\u0430\u0444\u0440\u0443\u043A\u0442. \u0406 \u0442\u043E\u0434\u0456
      \u0442\u0438 \u043F\u0456\u0437\u043D\u0430\u0454\u0448 \u0443\u0441\u044E
      \u0442\u0435\u043C\u043D\u0443 \u0441\u0438\u043B\u0443 \u0425\u043C\u0430\u0440\u0438
      \u0437 \u0442\u0438\u0445 \u0447\u0430\u0441\u0456\u0432, \u043A\u043E\u043B\u0438
      \u0432\u043E\u043D\u0430 \u0442\u0456\u043B\u044C\u043A\u0438 \u0431\u0443\u043B\u0430
      \u0432\u0438\u043F\u0443\u0449\u0435\u043D\u0430 \u0432 \u043D\u0430\u0448
      \u0441\u0432\u0456\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823850
    m_Localized: "\u041D\u0430\u0439\u0442\u0435\u043C\u043D\u0456\u0448\u0435 \u043F\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0425\u043C\u0430\u0440\u0438 - \u0446\u0435 \u043D\u0435\u043A\u0440\u043E\u0441\u043F\u0440\u0430\u0439\u0442\u0438.
      \u0420\u0430\u0437 \u043F\u043E\u0431\u0430\u0447\u0438\u0432\u0448\u0438,
      \u0442\u0438 \u0437\u0430\u043F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448
      \u0457\u0445\u043D\u0456\u0439 \u0431\u0435\u0437\u0444\u043E\u0440\u043C\u043D\u0438\u0439
      \u0432\u0438\u0433\u043B\u044F\u0434 \u0434\u043E \u043A\u0456\u043D\u0446\u044F
      \u0434\u043D\u0456\u0432 \u0441\u0432\u043E\u0457\u0445. \u0427\u043E\u0440\u043D\u0430
      \u0456\u043C\u043B\u0430, \u0449\u043E \u043E\u0436\u0438\u043B\u0430 \u0437\u0430
      \u0437\u043B\u0456\u0441\u043D\u043E\u044E \u043F\u0440\u0438\u043C\u0445\u043E\u044E
      \u0456 \u043F\u043E\u043F\u0440\u044F\u043C\u0443\u0432\u0430\u043B\u0430 \u0432\u0431\u0438\u0432\u0430\u0442\u0438.
      \u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u0439\u0441\u044F
      \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438 \u0457\u0445 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E - \u0432\u043E\u043D\u0430 \u043F\u0440\u043E\u0439\u0434\u0435
      \u043A\u0440\u0456\u0437\u044C \u043C\u043E\u0440\u043E\u043A, \u043D\u0430\u0447\u0435
      \u0442\u0438 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u0431
      \u0440\u043E\u0437\u0440\u0443\u0431\u0430\u0442\u0438 \u0442\u0456\u043D\u044C.
      \u0404\u0434\u0438\u043D\u0435, \u0447\u0438\u043C \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u0433\u043D\u0430\u0442\u0438 \u0446\u0456 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0456
      \u043F\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F - \u043C\u0430\u0433\u0456\u044F,
      \u0431\u0435\u0437 \u043D\u0435\u0457 \u0442\u043E\u0431\u0456 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0431\u0456\u0433\u0442\u0438 \u0431\u0435\u0437
      \u043E\u0433\u043B\u044F\u0434\u043A\u0438, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u043F\u0440\u043E\u0442\u0440\u0438\u043C\u0430\u044E\u0442\u044C \u043D\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823851
    m_Localized: "\u0422\u0435\u043C\u043D\u0430 \u043C\u0430\u0433\u0456\u044F \u0425\u043C\u0430\u0440\u0438
      \u0432\u0431\u0440\u0430\u043B\u0430\u0441\u044F \u043D\u0430\u0432\u0456\u0442\u044C
      \u0443 \u0441\u0430\u043C\u0443 \u0441\u0443\u0442\u044C \u0440\u0435\u0447\u0435\u0439
      \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u0445\u043C\u0443\u0440\u043E\u0433\u043E
      \u043C\u0456\u0441\u0446\u044F. \u0422\u0456 \u0437 \u043D\u0438\u0445, \u0449\u043E
      \u0431\u0443\u043B\u0438 \u043D\u0430\u0434\u0456\u043B\u0435\u043D\u0456 \u043C\u0430\u0433\u0456\u0454\u044E
      \u043F\u043E\u043D\u0456 \u043F\u043E\u0434\u043E\u0431\u043E\u044E \u0436\u0438\u0442\u0442\u044F,
      \u0441\u0442\u0430\u043B\u0438 \u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u043A\u0430\u043C\u0438
      \u0437\u043B\u043E\u0457 \u0441\u0443\u0442\u043D\u043E\u0441\u0442\u0456 \u0425\u043C\u0430\u0440\u0438.
      \u041F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0447\u0456 \u043F\u043E \u0432\u0441\u044C\u043E\u043C\u0443
      \u043C\u0456\u0441\u0442\u0443 \u043E\u0433\u043E\u043B\u043E\u0448\u0443\u044E\u0442\u044C
      \u043E\u043A\u043E\u043B\u0438\u0446\u0456 \u0433\u0456\u043C\u043D\u0430\u043C\u0438
      \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u043B\u044F \u0456 \u043F\u043E\u0433\u0438\u0431\u0435\u043B\u0456,
      \u0456 \u044F\u043A\u0449\u043E \u043F\u043E\u0447\u0443\u0454\u0448 \u0457\u0445
      - \u0437\u043D\u0438\u0449 \u0434\u0436\u0435\u0440\u0435\u043B\u043E, \u043D\u0435
      \u043D\u0430\u0431\u043B\u0438\u0436\u0430\u044E\u0447\u0438\u0441\u044C, \u0430\u0431\u043E
      \u0436 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0456\u0434\u0438 \u0456
      \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823852
    m_Localized: "\u0422\u0430 \u0449\u043E \u0436 \u0446\u0435 \u0437\u0430 \u043C\u0456\u0441\u0446\u0435?
      \u0422\u0430\u043C \u0454 \u0445\u043E\u0447 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C,
      \u0449\u043E \u043D\u0435 \u0437\u0430\u0433\u0440\u043E\u0436\u0443\u0454
      \u043C\u0435\u043D\u0456 \u0448\u0432\u0438\u0434\u043A\u043E\u044E \u0441\u043C\u0435\u0440\u0442\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823853
    m_Localized: "\u0406 \u0449\u0435 \u043E\u0434\u043D\u0430, \u043D\u043E\u0432\u0430
      \u0437\u0430\u0433\u0440\u043E\u0437\u0430 \u0437'\u044F\u0432\u0438\u043B\u0430\u0441\u044F
      \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E \u0432 \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u043C\u0443
      \u041C\u0456\u0441\u0442\u0456. \u0411\u043B\u0456\u0434\u0456 \u043F\u043E\u0434\u043E\u0431\u0438
      \u0432\u0430\u0448\u0438\u0445 \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0456\u0445
      \u0411\u043E\u0433\u0438\u043D\u044C, \u0456\u0441\u0442\u043E\u0442\u0438
      \u0437 \u043A\u0440\u0438\u043B\u0430\u043C\u0438 \u0456 \u0440\u043E\u0433\u043E\u043C
      \u043D\u0438\u0448\u043F\u043E\u0440\u044F\u0442\u044C \u0441\u0435\u0440\u0435\u0434
      \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0456\u0445 \u0440\u0443\u0457\u043D
      \u0456 \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431. \u041B\u0435\u0434\u044C
      \u043F\u043E\u043C\u0456\u0442\u043D\u0456 \u0442\u0456\u043D\u0456 \u043D\u0430
      \u0441\u0442\u0456\u043D\u0430\u0445 \u0432\u0438\u0434\u0430\u044E\u0442\u044C
      \u0457\u0445, \u043A\u043E\u043B\u0438 \u0432\u043E\u043D\u0438 \u0445\u043E\u0432\u0430\u044E\u0442\u044C\u0441\u044F,
      \u0456 \u0441\u0442\u0440\u0430\u0448\u043D\u0430 \u0434\u043E\u043B\u044F
      \u0442\u0438\u0445, \u0445\u0442\u043E \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0454
      \u0437\u0430\u0433\u0440\u043E\u0437\u0438. \u041D\u0435 \u043C\u043E\u0436\u0443
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438, \u0449\u043E
      \u0440\u0443\u0445\u0430\u0454 \u043D\u0438\u043C\u0438, \u0430\u043B\u0435
      \u044F \u0431 \u043D\u0435 \u0441\u0442\u0430\u043B\u0430 \u043D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u0441\u044F
      \u0432\u0456\u0442\u0430\u0442\u0438\u0441\u044F \u0437 \u0446\u0438\u043C\u0438
      \u043F\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F\u043C\u0438 \u041F\u043E\u0440\u0447\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823854
    m_Localized: "\u0426\u0435... \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457. \u041C\u0430\u0431\u0443\u0442\u044C,
      \u0442\u0435\u043F\u0435\u0440 \u044F \u0445\u043E\u0447\u0443 \u0439\u0442\u0438
      \u0442\u0443\u0434\u0438 \u0449\u0435 \u043C\u0435\u043D\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823855
    m_Localized: "\u041B\u0438\u0448\u0435 \u0432\u0435\u043B\u0438\u043A\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0430
      \u043C\u043E\u0436\u0435 \u0441\u043F\u043E\u043D\u0443\u043A\u0430\u0442\u0438
      \u043F\u043E\u043D\u0456 \u0442\u0430 \u0437\u0435\u0431\u0440 \u0437\u0430\u0439\u0442\u0438
      \u0432 \u0446\u0435 \u043C\u0456\u0441\u0446\u0435. \u042F\u043A\u0449\u043E
      \u0442\u0432\u043E\u044F \u043C\u0435\u0442\u0430 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0430\u0436\u043B\u0438\u0432\u0430, \u0437\u0430\u0440\u0430\u0434\u0438
      \u043D\u0435\u0457 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0443\u0432\u0456\u0439\u0442\u0438 \u0432 \u043F\u0430\u0449\u0443 \u0411\u0435\u0437\u043E\u0434\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823856
    m_Localized: "\u042F \u0439 \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
      \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u0430\u0442\u0438. \u0414\u044F\u043A\u0443\u044E
      \u0442\u043E\u0431\u0456, \u0417\u0430\u043C\u0431\u0435\u0437\u0456. \u0422\u0456\u043B\u044C\u043A\u0438
      \u043F\u0456\u0434\u043A\u0430\u0436\u0438 \u043C\u0435\u043D\u0456 \u0449\u0435
      \u043E\u0441\u044C \u0449\u043E: \u044F\u043A \u043D\u0430\u0439\u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0435
      \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823857
    m_Localized: "\u041D\u0430\u0439\u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0435
      \u0443\u0432\u0456\u0439\u0442\u0438 \u0442\u0443\u0434\u0438 \u0441\u0442\u0430\u0440\u043E\u044E
      \u0434\u043E\u0440\u043E\u0433\u043E\u044E \u043D\u0430 \u043F\u0456\u0432\u043D\u0456\u0447
      \u0432\u0456\u0434 \u043C\u0456\u0441\u0442\u0430. \u0422\u0438 \u0432\u0438\u0439\u0434\u0435\u0448
      \u043D\u0430 \u043D\u0435\u0457, \u044F\u043A\u0449\u043E \u0432\u0438\u0440\u0443\u0448\u0438\u0448
      \u0437\u0432\u0456\u0434\u0441\u0438 \u043D\u0430 \u0441\u0445\u0456\u0434
      \u0456 \u0431\u0443\u0434\u0435\u0448 \u0456\u0442\u0438 \u043F\u0456\u0432\u0433\u043E\u0434\u0438\u043D\u0438.
      \u0410 \u043F\u043E\u0442\u0456\u043C \u0434\u043E\u0440\u043E\u0433\u043E\u044E
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u0437\u0432\u0435\u0440\u043D\u0438,
      \u0456, \u044F\u043A\u0449\u043E \u0432\u0438\u0439\u0434\u0435\u0448 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436, \u0434\u043E \u043A\u0456\u043D\u0446\u044F \u0434\u043D\u044F \u043F\u043E\u0431\u0430\u0447\u0438\u0448
      \u043A\u0443\u043F\u043E\u043B\u0438 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823858
    m_Localized: "\u0414\u044F\u043A\u0443\u044E \u0449\u0435 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823859
    m_Localized: "\u0413\u0435\u0439, \u0412\u0435\u043B\u044C\u0432\u0435\u0442!
      \u0410 \u0449\u043E \u0437 \u0446\u0456\u0454\u044E \u0437\u0435\u0431\u0440\u043E\u044E,
      \u0432\u043E\u043D\u0430 \u0447\u0438\u043C\u043E\u0441\u044C \u0445\u0432\u043E\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823860
    m_Localized: "\u0426\u0435 \u0417\u0456\u0440\u0430. \u0422\u0430\u043A, \u0431\u043E\u044E\u0441\u044F,
      \u0443 \u043D\u0435\u0457 \u044F\u043A\u0430\u0441\u044C \u0444\u043E\u0440\u043C\u0430
      \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0438. \u041E\u0441\u044C
      \u0443\u0436\u0435 \u043A\u0456\u043B\u044C\u043A\u0430 \u0434\u043D\u0456\u0432
      \u0432\u043E\u043D\u0430 \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E \u0442\u044F\u043C\u0438, \u0456 \u044F \u043D\u0456\u0447\u0438\u043C
      \u043D\u0435 \u043C\u043E\u0436\u0443 \u0457\u0439 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438.
      \u041C\u0430\u0431\u0443\u0442\u044C, \u043C\u043E\u0457\u0445 \u0437\u043D\u0430\u043D\u044C
      \u0443 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823861
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u044F \u0457\u0457 \u043E\u0433\u043B\u044F\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823862
    m_Localized: "\u042F\u043A\u0449\u043E \u0442\u0438 \u0437\u043D\u0430\u0454\u0448\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456 - \u0442\u043E
      \u0437\u0432\u0456\u0441\u043D\u043E. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u0445\u043E\u0447\u0430
      \u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0438\u0439 \u0434\u0456\u0430\u0433\u043D\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823863
    m_Localized: "\u0412\u0438 \u043E\u0433\u043B\u044F\u0434\u0430\u0454\u0442\u0435
      \u0445\u0432\u043E\u0440\u0443 \u0437\u0435\u0431\u0440\u0443, \u0430\u043B\u0435
      \u043E\u043A\u0440\u0456\u043C \u0436\u0430\u0440\u0443 \u0442\u0430 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043E\u0433\u043E
      \u0434\u0438\u0445\u0430\u043D\u043D\u044F \u043D\u0435 \u0431\u0430\u0447\u0438\u0442\u0435
      \u0436\u043E\u0434\u043D\u0438\u0445 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u0456\u0432. \u0412\u0430\u0448\u0438\u0445
      \u0437\u043D\u0430\u043D\u044C \u0443 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456
      \u0442\u0443\u0442 \u044F\u0432\u043D\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823864
    m_Localized: "\u0412\u0438 \u043E\u0433\u043B\u044F\u0434\u0430\u0454\u0442\u0435
      \u0445\u0432\u043E\u0440\u0443 \u0437\u0435\u0431\u0440\u0443 \u0456 \u043F\u043E\u043C\u0456\u0447\u0430\u0454\u0442\u0435
      \u043D\u0438\u0437\u043A\u0443 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0438\u0445
      \u043E\u0437\u043D\u0430\u043A. \u0411\u0435\u0437\u043B\u0456\u0447 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u0438\u0445
      \u0432\u0430\u043C\u0438 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0445 \u0436\u0443\u0440\u043D\u0430\u043B\u0456\u0432
      \u0434\u0430\u043B\u0438 \u0432\u0430\u043C \u0437\u043C\u043E\u0433\u0443
      \u0437\u0456\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0440\u0456\u0437\u043D\u0456
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u0438 \u0442\u0430 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
      \u0434\u0456\u0430\u0433\u043D\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823865
    m_Localized: "\u041C\u0435\u043D\u0456 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u044F \u0437\u043D\u0430\u044E, \u0449\u043E \u0443 \u043D\u0435\u0457 \u0437\u0430
      \u0445\u0432\u043E\u0440\u043E\u0431\u0430. \u0417\u0430 \u0432\u0441\u0456\u043C\u0430
      \u043E\u0437\u043D\u0430\u043A\u0430\u043C\u0438 \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C,
      \u0449\u043E \u0446\u0435 \u043F\u0438\u043B\u043E\u0432\u0430 \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823866
    m_Localized: "\u0425\u043C\u043C... \u0422\u0430\u043A, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0442\u0438 \u043C\u0430\u0454\u0448 \u0440\u0430\u0446\u0456\u044E. \u0410\u043B\u0435
      \u0446\u0435 \u0436 \u0434\u043E\u0432\u043E\u043B\u0456 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0430
      \u0445\u0432\u043E\u0440\u043E\u0431\u0430, \u0437\u0432\u0456\u0434\u043A\u0438...
      \u0430, \u0432\u0442\u0456\u043C, \u043D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u043E.
      \u042F\u043A\u0449\u043E \u0446\u0435 \u0442\u0430\u043A, \u0442\u043E \u0433\u043E\u0434\u0456
      \u0439 \u0434\u0443\u043C\u0430\u0442\u0438 \u0432\u0438\u043B\u0456\u043A\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u0437\u0456\u043B\u043B\u044F\u043C \u0447\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C\u0438.
      \u0422\u0443\u0442 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0430, \u0430\u043B\u0435
      \u044F \u0439 \u0433\u0430\u0434\u043A\u0438 \u043D\u0435 \u043C\u0430\u044E,
      \u0434\u0435 \u0457\u0457 \u0434\u0456\u0441\u0442\u0430\u0442\u0438. \u0421\u0430\u043C\u0430
      \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0443\u0441\u0435, \u0449\u043E
      \u0454 \u0432 \u043D\u0430\u0448\u043E\u043C\u0443 \u0440\u043E\u0437\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u0456
      - \u0441\u0442\u0430\u0440\u0456 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0456
      \u0437\u0430\u043F\u0430\u0441\u0438 \u0456 \u0437\u0456\u043B\u043B\u044F
      \u0432\u043B\u0430\u0441\u043D\u043E\u0433\u043E \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823867
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0443 \u0414\u043E\u043A\u0430
      \u0421\u0435\u043F\u0441\u0438\u0441\u0443?"
