      \u0437\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044C. \u0422\u0430\u043A\u0456
      \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456 \u043C\u0430\u044E\u0442\u044C
      \u043B\u0438\u0448\u0435 5 \u0440\u0456\u0432\u043D\u0456\u0432, \u0442\u043E\u0436
      \u0432\u0438\u043F\u0438\u0442\u0438 \u043C\u043E\u0436\u043D\u0430 \u043D\u0435
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043F'\u044F\u0442\u0438 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u0438\u0445
      \u0435\u043B\u0456\u043A\u0441\u0438\u0440\u0456\u0432."
