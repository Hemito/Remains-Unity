  - m_Id: 2729436193
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0430 \u0425\u043C\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436194
    m_Localized: "\u043F\u0440\u043E\u043C\u0435\u043D\u0456 \u0434\u043E\u0431\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436195
    m_Localized: "\u041E\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436196
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436197
    m_Localized: "\u0411\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436198
    m_Localized: "\u0411\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0438\u0439
      \u043F\u0430\u0442\u0440\u043E\u043D \u043C\u0430\u0454 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0443
      \u043A\u0443\u043B\u044E \u0437 \u0442\u0432\u0435\u0440\u0434\u0438\u043C
      \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u0456 \u043C'\u044F\u043A\u043E\u044E
      \u043E\u0431\u043E\u043B\u043E\u043D\u043A\u043E\u044E, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0443
      \u0434\u043B\u044F \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u043D\u043D\u044F
      \u0431\u0440\u043E\u043D\u0456. \u041E\u0434\u043D\u0430\u043A \u0442\u0430\u043A\u0456
      \u043A\u0443\u043B\u0456 \u043C\u0435\u043D\u0448 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456
      \u043F\u0440\u043E\u0442\u0438 \u043D\u0435\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u0445
      \u0446\u0456\u043B\u0435\u0439 \u0456 \u043C\u0430\u044E\u0442\u044C \u0441\u043B\u0430\u0431\u0448\u0443
      \u0437\u0443\u043F\u0438\u043D\u044F\u044E\u0447\u0443 \u0434\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436199
    m_Localized: "\u0415\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436200
    m_Localized: "\u0415\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u0438\u0439
      \u043F\u0430\u0442\u0440\u043E\u043D \u043C\u0430\u0454 \u043A\u0443\u043B\u044E,
      \u0449\u043E \u0434\u0435\u0444\u043E\u0440\u043C\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u043D\u043D\u044F
      \u0432 \u043C'\u044F\u043A\u0435 \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0435,
      \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0443 \u0442\u0456\u043B\u043E
      \u0436\u0435\u0440\u0442\u0432\u0438. \u0422\u0430\u043A\u0456 \u043A\u0443\u043B\u0456
      \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u043D\u0435\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u043C
      \u0446\u0456\u043B\u044F\u043C, \u0430\u043B\u0435 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u0432\u043E\u043D\u0438 \u0434\u0443\u0436\u0435 \u043F\u043E\u0433\u0430\u043D\u043E
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0442\u044C \u0431\u0440\u043E\u043D\u044E,
      \u0442\u043E\u043C\u0443 \u043F\u0440\u043E\u0442\u0438 \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0445
      \u0446\u0456\u043B\u0435\u0439 \u043D\u0435\u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436201
    m_Localized: "\u0411\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436202
    m_Localized: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u043F\u0430\u0442\u0440\u043E\u043D\u0456
      \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E
      \u0434\u0440\u043E\u0431\u0443 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u043F'\u044F\u0442\u044C \u0441\u0442\u0440\u0456\u043B\u043E\u043F\u043E\u0434\u0456\u0431\u043D\u0438\u0445
      \u043A\u0443\u043B\u044C, \u044F\u043A\u0456 \u0434\u043E\u0431\u0440\u0435
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0442\u044C \u0431\u0440\u043E\u043D\u044E,
      \u0430\u043B\u0435 \u043C\u0430\u044E\u0442\u044C \u0441\u043B\u0430\u0431\u0448\u0443
      \u0437\u0443\u043F\u0438\u043D\u044F\u044E\u0447\u0443 \u0434\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436203
    m_Localized: "\u0417\u0430\u043F\u0430\u043B\u044C\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436204
    m_Localized: "\u041F\u0430\u0442\u0440\u043E\u043D, \u0449\u043E \u043C\u0430\u0454
      \u043C\u0430\u0433\u0456\u0447\u043D\u043E \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0443
      \u043A\u0443\u043B\u044E, \u044F\u043A\u0430 \u0437\u0430\u043F\u0430\u043B\u044E\u0454
      \u0446\u0456\u043B\u044C \u043F\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436205
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436206
    m_Localized: "\u041F\u0430\u0442\u0440\u043E\u043D, \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 \u0441\u0442\u043E\u0441\u043E\u0432\u043D\u043E
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457 \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u041F\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u0456
      \u0432 \u0446\u0456\u043B\u044C \u043A\u0443\u043B\u044F \u0437 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0437\u0433\u0443\u0441\u0442\u043E\u043A \u043F\u043B\u0430\u0437\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436207
    m_Localized: "\u041F\u043E\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u0437\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436208
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E\u0457
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456. \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u0448\u043A\u043E\u0434\u0443 \u0456 \u0434\u0430\u0454 \u0437\u0431\u0440\u043E\u0457
      \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043F\u0440\u043E\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438
      \u0431\u0440\u043E\u043D\u044E, \u0430\u043B\u0435 \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0437\u0431\u0440\u043E\u044F \u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u043D\u043E\u0448\u0443\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436209
    m_Localized: "\u041E\u043F\u0442\u0438\u043C\u0456\u0437\u043E\u0432\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436210
    m_Localized: "\u041F\u0430\u043B\u0438\u0432\u043E \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u043C\u0438
      \u0434\u043E\u0431\u0430\u0432\u043A\u0430\u043C\u0438, \u0449\u043E \u0437\u043D\u0430\u0447\u043D\u043E
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u044E\u0442\u044C \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0443
      \u0433\u043E\u0440\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436211
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436212
    m_Localized: "\u0411\u0456\u043B\u044C\u0448 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
