  - m_Id: 2729435174
    m_Localized: "\u0422\u043A\u0430\u043D\u0438\u043D\u0430, \u043F\u0440\u043E\u0441\u043E\u0447\u0435\u043D\u0430
      \u0433\u0443\u043C\u043E\u044E, \u043D\u0435\u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0430
      \u0434\u043B\u044F \u0440\u0456\u0434\u0438\u043D \u0456 \u0433\u0430\u0437\u0456\u0432,
      \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0456\u0434
      \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0433\u043E
      \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0430."
