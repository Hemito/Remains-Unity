      m_Items: []
  - m_Id: 2729435479
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0412\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F\"
      \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0434\u043E \u0442\u0438\u0445
      \u0434\u0430\u0432\u043D\u0456\u0445 \u0437\u043D\u0430\u043D\u044C, \u044F\u043A\u0456
      \u0434\u0430\u0432\u043D\u043E \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u043F\u043E\u043D\u0456, \u0430\u043B\u0435 \u0432 \u044F\u043A\u0438\u0445
      \u0434\u043E\u0441\u044F\u0433\u043B\u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u0445
      \u0443\u0441\u043F\u0456\u0445\u0456\u0432 \u0437\u0435\u0431\u0440\u0438.
      \u0417 \u043D\u0438\u043C \u0432\u0438 \u0448\u0432\u0438\u0434\u0448\u0435
      \u0432\u0438\u0436\u0438\u0432\u0435\u0442\u0435 \u0442\u0430\u043C, \u0434\u0435
      \u0456\u043D\u0448\u0438\u0439 \u0437\u0430\u0433\u0438\u043D\u0435. [br]-
      \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u0430\u0448 \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u043D\u0430 #1.[br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C
      \u0440\u0456\u0432\u043D\u0435\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F \u043F\u043E\u0440\u0456\u0433
      \u0448\u043A\u043E\u0434\u0438 \u043D\u0430 #2, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0441\u0442\u0430\u044E\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u043C\u0438
      \u043D\u043E\u0432\u0456 \u0440\u0435\u0446\u0435\u043F\u0442\u0438 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0445
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u0437\u0456\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435480
    m_Localized: "\u041D\u0430\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435481
    m_Localized: "\u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u0446\u0456\u0454\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0448\u043A\u043E\u0434\u0430
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435482
    m_Localized: "\u0417\u0430\u0445\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435483
    m_Localized: "\u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u0432\u0430\u0448 \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435484
    m_Localized: "\u0417\u043D\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435485
    m_Localized: "\u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u0446\u0456\u0454\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0432\u0438
      \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0435
      \u043E\u0447\u043A\u043E \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435486
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435487
    m_Localized: "\u0420\u0430\u0439\u0434\u0443\u0436\u043D\u0456 \u043A\u0440\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435488
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0410\u043B\u0456\u043A\u043E\u0440\u0430
      \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C\u0438
      \u043A\u0440\u0438\u043B\u0430\u043C\u0438, \u0449\u043E \u0434\u0430\u044E\u0442\u044C
      \u0437\u043C\u043E\u0433\u0443 \u043B\u0456\u0442\u0430\u0442\u0438. \u0412\u0438
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0432 \u043F\u043E\u043B\u044C\u043E\u0442\u0456, \u0443\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438
      \u043A\u043B\u0430\u0432\u0456\u0448\u0443 @1 (\u0446\u044F \u0434\u0456\u044F
      \u0441\u043F\u043E\u0436\u0438\u0432\u0430\u0454 \u043C\u0430\u0433\u0456\u044E).
      \u0420\u0456\u0432\u0435\u043D\u044C \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\" \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u0454
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u043F\u043E\u043B\u044C\u043E\u0442\u0443, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0438\u0442\u0440\u0430\u0442\u0443 \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435489
    m_Localized: "\u0422\u0438\u0442\u0430\u043D\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435490
    m_Localized: "\u0417\u043E\u0432\u043D\u0456\u0448\u043D\u044F \u043E\u0431\u043E\u043B\u043E\u043D\u043A\u0430
      \u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u043C\u0430\u0433\u0456\u0447\u043D\u043E
      \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0438\u0445 \u043B\u0443\u0441\u043E\u0447\u043E\u043A
      \u0437 \u0442\u0438\u0442\u0430\u043D\u043E\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0443.
      \u0412\u0430\u0448 \u043F\u043E\u0440\u0456\u0433 \u0448\u043A\u043E\u0434\u0438
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0437\u0430\u043B\u0435\u0436\u043D\u043E
      \u0432\u0456\u0434 \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0420\u0435\u043C\u043E\u043D\u0442\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435491
    m_Localized: "\u0426\u0456\u043B\u044E\u0449\u0430 \u0441\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435492
    m_Localized: "\u041C\u0435\u0434\u0438\u0447\u043D\u0456 \u0441\u0438\u0441\u0442\u0435\u043C\u0438
      \u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430.
      \u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0456\u0434 \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435493
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0441\u0432\u0456\u0442\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435494
    m_Localized: "\u0423 \u0411\u0440\u043E\u043D\u044E \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043C\u0438\u0442\u0442\u0454\u0432\u043E\u0457 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u0457.
      \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043C\u0438\u0442\u0442\u0454\u0432\u0443 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u044E
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043A\u043B\u0430\u0432\u0456\u0448\u0456
      @1, \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u043C\u0430\u0433\u0456\u0457
      \u043D\u0430 \u0446\u044E \u0434\u0456\u044E \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0456\u0434 \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0417\u043B\u043E\u043C\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435495
    m_Localized: "\u041F\u0443\u0441\u0442\u043E\u0442\u043D\u0438\u0439 \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435496
    m_Localized: "\u0423 \u0411\u0440\u043E\u043D\u044E \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0449\u0438\u0442\u0430.
      \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u0449\u0438\u0442 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043A\u043B\u0430\u0432\u0456\u0448\u0456 @1, \u043C\u0456\u0446\u043D\u0456\u0441\u0442\u044C
      \u0449\u0438\u0442\u0430 \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434
      \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \"\u041D\u0430\u0443\u043A\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435497
    m_Localized: "\u041F\u043E\u043A\u0440\u043E\u0432 \u0442\u0456\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435498
    m_Localized: "\u0413\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0456\u0447\u043D\u0456
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u0437\u0431\u0438\u0432\u0430\u044E\u0442\u044C \u0432\u043E\u0440\u043E\u0436\u0456
      \u043F\u0440\u0438\u0446\u0456\u043B\u0438, \u043D\u0435 \u0434\u0430\u044E\u0447\u0438
      \u0432\u043B\u0443\u0447\u0438\u0442\u0438 \u043F\u043E \u0432\u0430\u0441.
      \u0414\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u0448\u0430\u043D\u0441\u0438
      \u043D\u0430 \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F \u0437\u0430\u043B\u0435\u0436\u0430\u0442\u044C
      \u0432\u0456\u0434 \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0421\u043A\u0440\u0438\u0442\u043D\u0456\u0441\u0442\u044C\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435499
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435500
    m_Localized: "\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u044F \u043F\u0456\u0434\u043A\u043B\u0430\u0434\u043A\u0430
      \u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \"\u0440\u043E\u0437\u0443\u043C\u043D\u043E\u0433\u043E\"
      \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0443, \u044F\u043A\u0438\u0439
      \u043C\u0438\u0442\u0442\u0454\u0432\u043E \u0442\u0432\u0435\u0440\u0434\u043D\u0435
      \u043F\u0440\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u0456 \u0448\u043A\u043E\u0434\u0438
      \u0442\u0430 \u0435\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u0438\u0439 \u0432
      \u0456\u043D\u0448\u0438\u0439 \u0447\u0430\u0441. \u041E\u043F\u0456\u0440
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0439
      \u0448\u043A\u043E\u0434\u0456 \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0456\u0434 \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0422\u043E\u0440\u0433\u0456\u0432\u043B\u044F\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435501
    m_Localized: "\u0421\u0430\u043C\u043E\u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435502
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043B\u0435\u0432\u0456\u0442\u0443\u0432\u0430\u0442\u0438
      \u0441\u0430\u043C\u0456 \u0441\u0435\u0431\u0435, \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0447\u0438
      \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0441\u0438\u043B\u0443. \u0414\u043B\u044F
      \u0446\u044C\u043E\u0433\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u0456 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 @1, \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0447\u0438
      \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456. \u041D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435
      \u043A\u043B\u0430\u0432\u0456\u0448\u0456 \u0440\u0443\u0445\u0443 @2@3@4@5,
      \u0449\u043E\u0431 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0438, \u0432\u043D\u0438\u0437 \u0430\u0431\u043E
      \u0432\u0433\u043E\u0440\u0443. \u0420\u0443\u0445 \u0432\u0433\u043E\u0440\u0443
      \u0432\u0438\u043C\u0430\u0433\u0430\u0454 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043C\u0430\u0433\u0456\u0457. \u041D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443
      \u0440\u0456\u0432\u043D\u0456 \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u043C\u0430\u0433\u0456\u0457 \u0431\u0443\u0434\u0435
      \u0437\u043D\u0430\u0447\u043D\u043E \u043C\u0435\u043D\u0448\u043E\u044E,
      \u0430 \u0447\u0430\u0441 \u0456 \u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u043F\u043E\u043B\u044C\u043E\u0442\u0443 - \u0431\u0456\u043B\u044C\u0448\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435503
    m_Localized: "\u0421\u0442\u0440\u0438\u0431\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435504
    m_Localized: "\u0412\u0438\u0440\u0430\u0437 \"\u0432\u0438\u0449\u0435 \u0433\u043E\u043B\u043E\u0432\u0438
      \u043D\u0435 \u0441\u0442\u0440\u0438\u0431\u043D\u0435\u0448\" - \u0446\u0435
      \u043D\u0435 \u043F\u0440\u043E \u0432\u0430\u0441. \u0417 \u0446\u0456\u0454\u044E
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044E \u0432\u0430\u0448\u0456
      \u0441\u0442\u0440\u0438\u0431\u043A\u0438 \u043D\u0430 \u043F\u0456\u0432\u043C\u0435\u0442\u0440\u0430
      (\u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E 1 \u0431\u043B\u043E\u043A)
      \u0432\u0438\u0449\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435505
    m_Localized: "\u041B\u0435\u0433\u043A\u0438\u0439 \u043A\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435506
    m_Localized: "\u0412\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u0443\u0432\u0430\u0436\u043D\u0456
      \u0439 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456. \u0412\u0438 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0435 \u0432
      \u043A\u0430\u043F\u043A\u0430\u043D \u0430\u0431\u043E \u043F\u0430\u0441\u0442\u043A\u0443
      \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0437\u0456, \u0430 \u0432\u043E\u0440\u043E\u0436\u0456
      \u043C\u0456\u043D\u0438 \u0441\u043F\u0440\u0430\u0446\u044C\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0456\u0437 \u0437\u0430\u0442\u0440\u0438\u043C\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435507
    m_Localized: "\u0424\u0430\u043D\u0430\u0442 \u0432\u0438\u0431\u0443\u0445\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435508
    m_Localized: "\u0425\u043E\u0447 \u0432\u0438 \u0456 \u043B\u044E\u0431\u0438\u0442\u0435
      \u0432\u0441\u0435 \u043F\u0456\u0434\u0440\u0438\u0432\u0430\u0442\u0438,
      \u0430\u043B\u0435 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u043D\u0435
      \u0437\u0430\u0431\u0443\u0432\u0430\u0454\u0442\u0435 \u0456 \u043F\u0440\u043E
      \u0431\u0435\u0437\u043F\u0435\u043A\u0443. \u0411\u0443\u0434\u044C-\u044F\u043A\u0456
      \u0432\u0438\u0431\u0443\u0445\u0438 \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C
      \u0432\u0430\u043C \u043C\u0435\u043D\u0448\u0435 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435509
    m_Localized: "\u0412\u043E\u0433\u043D\u0435\u0442\u0440\u0438\u0432\u043A\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435510
    m_Localized: "\u0412\u043E\u0433\u043E\u043D\u044C \u0437\u0430\u0432\u0434\u0430\u0454
      \u0432\u0430\u043C \u043C\u0435\u043D\u0448\u0435 \u0448\u043A\u043E\u0434\u0438,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0430\u0441 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435
      \u043F\u0456\u0434\u043F\u0430\u043B\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435513
    m_Localized: "\u0425\u0440\u0456\u043D \u0432\u043B\u0443\u0447\u0438\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435514
    m_Localized: "\u0422\u0435\u043F\u0435\u0440 \u0443 \u0431\u043E\u044E \u043F\u043E
      \u0432\u0430\u043C \u0445\u0440\u0456\u043D \u0432\u043B\u0443\u0447\u0438\u0448!
      \u0412\u0430\u0448 \u0431\u043E\u043D\u0443\u0441 \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      #1 \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435515
    m_Localized: "\u0414\u0443\u0431\u043E\u0432\u0430 \u0448\u043A\u0443\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435516
    m_Localized: "\u0422\u0440\u0435\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0437
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E
      \u0434\u0430\u043B\u0438 \u0441\u0432\u043E\u0457 \u043F\u043B\u043E\u0434\u0438.
      \u0422\u0435\u043F\u0435\u0440 \u0432\u0430\u0441 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435
      \u043F\u043E\u0440\u0430\u043D\u0438\u0442\u0438 \u0447\u0438\u043C\u043E\u0441\u044C
      \u0433\u043E\u0441\u0442\u0440\u0438\u043C. \u041E\u043F\u0456\u0440 \u0440\u0456\u0436\u0443\u0447\u043E\u043C\u0443
      \u0443\u0440\u043E\u043D\u0443 \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435517
    m_Localized: "\u041A\u0430\u043C'\u044F\u043D\u0430 \u0441\u0442\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435518
    m_Localized: "\u0412\u0430\u0441 \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u0430\u0437\u0456\u0432
      \u0431\u0438\u043B\u0438 \u0447\u0438\u043C\u043E\u0441\u044C \u0432\u0430\u0436\u043A\u0438\u043C,
      \u0449\u043E \u0432\u0438 \u0434\u043E \u0446\u044C\u043E\u0433\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u0437\u0432\u0438\u043A\u043B\u0438, \u0442\u0435\u043F\u0435\u0440 \u0443\u0434\u0430\u0440\u0438
      \u043F\u043E \u0432\u0430\u0441 - \u044F\u043A \u043E\u0431 \u0441\u0442\u0456\u043D\u0443
      \u0433\u043E\u0440\u043E\u0445. \u041E\u043F\u0456\u0440 \u0443\u0434\u0430\u0440\u0430\u043C
      \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435519
    m_Localized: "\u0411\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0430 \u0448\u043A\u0443\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435520
    m_Localized: "\u0423\u0436\u0435 \u0439 \u043D\u0435 \u0437\u043B\u0456\u0447\u0438\u0442\u0438,
      \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0440\u0430\u0437\u0456\u0432 \u043F\u043E
      \u0432\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044F\u043B\u0438. \u0410\u043B\u0435
      \u0446\u0435 \u0437\u0440\u043E\u0431\u0438\u043B\u043E \u0432\u0430\u0441
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u043C:
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439
      \u043E\u043F\u0456\u0440 \u0448\u043A\u043E\u0434\u0456 \u0432\u0456\u0434
      \u043A\u0443\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435521
    m_Localized: "\u0420\u043E\u0437\u043C\u0456\u0440 \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435522
    m_Localized: "\u0412\u0438 - \u0444\u0430\u043D\u0430\u0442 \u0434\u0443\u0436\u0435
      \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u0433\u0430\u0440\u043C\u0430\u0442.
      \u0412\u0438 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0440\u0438\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0434\u043E \u043D\u0438\u0445, \u0449\u043E \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u043F\u043E\u043C\u0456\u0447\u0430\u0454\u0442\u0435 \u0457\u0445\u043D\u044C\u043E\u0457
      \u0432\u0430\u0433\u0438. \u0422\u0435\u043F\u0435\u0440 \u0432\u0435\u043B\u0438\u043A\u0456
      \u0442\u0430 \u0432\u0430\u0436\u043A\u0456 \u0433\u0430\u0440\u043C\u0430\u0442\u0438
      \u043D\u0435 \u0431\u0443\u0434\u0443\u0442\u044C \u0432\u0430\u0441 \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0432\u0430\u0442\u0438
      \u0456 \u0431\u0443\u0434\u0443\u0442\u044C \u0448\u0432\u0438\u0434\u0448\u0435
      \u043D\u0430\u0432\u043E\u0434\u0438\u0442\u0438\u0441\u044F \u043D\u0430 \u0446\u0456\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435523
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435524
    m_Localized: "\u0412\u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u0454\u0442\u0435
      \u0437\u0431\u0440\u043E\u044E \u0432\u0434\u0432\u0456\u0447\u0456 \u0448\u0432\u0438\u0434\u0448\u0435.
      \u0426\u0435 \u0434\u0430\u0454 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0443
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443 - \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043C\u0435\u043D\u0448\u0435 \u0448\u0430\u043D\u0441\u0456\u0432 \u043D\u0430
      \u0442\u0435, \u0449\u043E \u0432\u0430\u0441 \u0443\u0431'\u044E\u0442\u044C,
      \u043F\u043E\u043A\u0438 \u0432\u0438 \u0432\u043E\u0437\u0438\u0442\u0435\u0441\u044F
      \u0437 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435525
    m_Localized: "\u0428\u0443\u043A\u0430\u0447 \u0441\u043A\u0430\u0440\u0431\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435526
    m_Localized: "\u0412\u0438 \u043C\u0430\u0454\u0442\u0435 \u0437\u0432\u0438\u0447\u043A\u0443
      \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u043D\u0438\u0448\u043F\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u043A\u043E\u0436\u0435\u043D \u0441\u043C\u0456\u0442\u0442\u0454\u0432\u0438\u0439
      \u0431\u0430\u0447\u043E\u043A \u0456 \u0442\u043E\u043C\u0443 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u043B\u044F\u0448\u043A\u043E\u0432\u0438\u0445 \u043A\u0440\u0438\u0448\u043E\u043A
      \u0456 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435527
    m_Localized: "\u0412\u0435\u0434\u043C\u0435\u0436\u0430\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435528
    m_Localized: "\u0412\u0438 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0430\u043A\u0443\u0440\u0430\u0442\u043D\u0456\u0448\u0435
      \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u0441\u044F \u0456\u0437 \u0437\u0430\u043C\u043A\u043E\u043C
      \u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0456 \u0437\u043B\u043E\u043C\u0443.
      \u0423 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0456 \u0437\u0430
      \u043D\u0435\u0432\u0434\u0430\u043B\u043E\u0457 \u0441\u043F\u0440\u043E\u0431\u0438
      \u0448\u043F\u0438\u043B\u044C\u043A\u0438 \u043B\u0430\u043C\u0430\u044E\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0456
      \u0432\u0438\u043F\u0430\u0434\u043A\u0456\u0432, \u0430 \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F,
      \u0449\u043E \u0437\u0430\u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0437\u0430\u043C\u043A\u0443
      \u0437\u0430 \u043D\u0435\u0432\u0434\u0430\u043B\u043E\u0457 \u0441\u043F\u0440\u043E\u0431\u0438
      \u0437\u043B\u043E\u043C\u0443, \u043D\u0430 #1 \u043D\u0438\u0436\u0447\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435529
    m_Localized: "\u041A\u0440\u0443\u0442\u0438\u0439 \u0445\u0430\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435530
    m_Localized: "\u0422\u0430\u043A\u043E\u043C\u0443 \u043A\u0440\u0443\u0442\u043E\u043C\u0443
      \u0445\u0430\u043A\u0435\u0440\u0443, \u044F\u043A \u0432\u0438, \u043D\u0430\u0432\u0456\u0442\u044C
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u043D\u0430\u0434\u0430\u044E\u0442\u044C \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456
      \u0441\u043F\u0440\u043E\u0431\u0438 \u0434\u043B\u044F \u043F\u0456\u0434\u0431\u043E\u0440\u0443
      \u043F\u0430\u0440\u043E\u043B\u044F (#1 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      #2)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435531
    m_Localized: "\u041F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0439
      \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0456\u0437\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435532
    m_Localized: "\u0423 \u0432\u0430\u0441 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0439
      \u043E\u0431\u043C\u0456\u043D \u0440\u0435\u0447\u043E\u0432\u0438\u043D,
      \u0442\u043E\u043C\u0443 \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456
      \u0437\u0456\u043B\u043B\u044F \u0441\u0442\u0430\u044E\u0442\u044C \u043D\u0430
      #1 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u0438\u043C\u0438
      \u0456 \u0437\u0446\u0456\u043B\u044E\u044E\u0442\u044C \u0432\u0430\u0441
      \u0443 #2 \u0440\u0430\u0437\u0438 \u0448\u0432\u0438\u0434\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435533
    m_Localized: "\u041F\u043E\u043D\u0456 \u0434\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435534
    m_Localized: "\u0412\u0438 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
      \u0441\u0438\u0434\u0438\u0442\u0435 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456,
      \u0430 \u0432\u0435\u0441\u044C \u0447\u0430\u0441 \u043A\u0443\u0434\u0438\u0441\u044C
      \u043F\u0440\u0430\u0433\u043D\u0435\u0442\u0435. \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435
      #1 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445 \u043E\u0447\u043E\u043A
      \u0434\u0456\u0457 \u0432 \u0440\u0435\u0436\u0438\u043C\u0456 \u0417.\u041F.\u0421.
      \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      (\u043F\u0440\u0438 #2 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u0445)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435535
    m_Localized: "\u0415\u043D\u0442\u043E\u043C\u043E\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435536
    m_Localized: "\u0412\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u0446\u0456\u043A\u0430\u0432\u0438\u043B\u0438\u0441\u044F
      \u043A\u043E\u043C\u0430\u0445\u0430\u043C\u0438, \u043F\u0430\u0432\u0443\u043A\u043E\u043F\u043E\u0434\u0456\u0431\u043D\u0438\u043C\u0438
      \u0442\u0430 \u0456\u043D\u0448\u0438\u043C\u0438 \u0447\u043B\u0435\u043D\u0438\u0441\u0442\u043E\u043D\u043E\u0433\u0438\u043C\u0438.
      \u0422\u043E\u043C\u0443 \u0432 \u0431\u043E\u044E \u0432\u0438 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u043D\u0430 #1 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438
      \u0440\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u0430\u043C,
      \u0440\u0430\u0434\u0442\u0430\u0440\u0433\u0430\u043D\u0430\u043C, \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0430\u043C
      \u0456 \u0442\u043E\u043C\u0443 \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u043C
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435537
    m_Localized: "\u041F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u0430 \u0430\u043D\u0430\u0442\u043E\u043C\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435538
    m_Localized: "\u0412\u0438 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0437\u043D\u0430\u0454\u0442\u0435 \u0430\u043D\u0430\u0442\u043E\u043C\u0456\u044E
      \u043F\u043E\u043D\u0456, \u0449\u043E \u0437\u0430\u0432\u0436\u0434\u0438
      \u0446\u0456\u043B\u0438\u0442\u0435\u0441\u044F \u043F\u043E \u0436\u0438\u0442\u0442\u0454\u0432\u043E
      \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0445 \u043E\u0440\u0433\u0430\u043D\u0430\u0445.
      \u0412\u0438 \u0437\u0430\u0432\u0434\u0430\u0454\u0442\u0435 \u043D\u0430
      #1 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438 \u0440\u0435\u0439\u0434\u0435\u0440\u0430\u043C
      \u0442\u0430 \u0456\u043D\u0448\u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C-\u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435539
    m_Localized: "\u0420\u043E\u0431\u043E\u0442\u043E\u0442\u0435\u0445\u043D\u0456\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435540
    m_Localized: "\u0412\u0438 \u0447\u0443\u0434\u043E\u0432\u043E \u0437\u043D\u0430\u0454\u0442\u0435
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044E \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0440\u043E\u0431\u043E\u0442\u0430 \u0456 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0432\u0435\u0434\u0435\u0442\u0435 \u0432\u043E\u0433\u043E\u043D\u044C \u043F\u043E
      \u0439\u043E\u0433\u043E \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0438\u0445
      \u0442\u043E\u0447\u043A\u0430\u0445. \u0412\u0438 \u0437\u0430\u0432\u0434\u0430\u0454\u0442\u0435
      \u043D\u0430 #1 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u043C \u0440\u043E\u0431\u043E\u0442\u0430\u043C
      \u0456 \u0442\u0443\u0440\u0435\u043B\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435541
    m_Localized: "\u0411\u043E\u0440\u0435\u0446\u044C \u0437\u0430 \u0447\u0438\u0441\u0442\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435542
    m_Localized: "\u0412\u0438 \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u0435,
      \u0449\u043E \u041F\u0443\u0441\u0442\u043A\u0443 \u0431\u0443\u0434\u044C-\u0449\u043E-\u0431\u0443\u0434\u044C
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0438
      \u0432\u0456\u0434 \u0440\u0456\u0437\u043D\u0438\u0445 \u0447\u0443\u0434\u043E\u0432\u0438\u0441\u044C\u043A
      \u0456 \u0437\u0432\u0456\u0440\u0456\u0432-\u043C\u0443\u0442\u0430\u043D\u0442\u0456\u0432.
      \u0412\u0438 \u0437\u0430\u0432\u0434\u0430\u0454\u0442\u0435 \u043D\u0430
      #1 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438 \u0434\u0438\u043A\u0438\u043C
      \u0433\u0443\u043B\u044F\u043C \u0456 \u043C\u0443\u0442\u0430\u043D\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435543
    m_Localized: "\u0411\u0456\u0436\u0438-\u0441\u0442\u0440\u0456\u043B\u044F\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435544
    m_Localized: "\u0412\u0438 \u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
      \u0432\u043B\u0443\u0447\u043D\u043E \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430 \u0431\u0456\u0433\u0443
      \u0430\u0431\u043E \u0437 \u043D\u0435\u0437\u0440\u0443\u0447\u043D\u043E\u0433\u043E
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F. \u0428\u0442\u0440\u0430\u0444
      \u0432\u043B\u0443\u0447\u043D\u043E\u0441\u0442\u0456 \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u043D\u0430 \u0431\u0456\u0433\u0443 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E
      \u0434\u043E #1 (\u0431\u0430\u0437\u043E\u0432\u0438\u0439 \u0448\u0442\u0440\u0430\u0444
      #2), \u0430 \u0448\u0442\u0440\u0430\u0444 \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0432 \u0441\u0442\u0440\u0438\u0431\u043A\u0443 \u0430\u0431\u043E \u0437\u0456
      \u0441\u0445\u043E\u0434\u0456\u0432 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E
      \u0434\u043E #3 (\u0431\u0430\u0437\u043E\u0432\u0438\u0439 \u0448\u0442\u0440\u0430\u0444
      #4). \u0414\u0456\u0454 \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F
      \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438 \u0431\u0435\u0437 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0417.\u041F.\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435545
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435546
    m_Localized: "\u0423 \u0431\u043E\u044E \u0432\u0438 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u043C\u0435\u0442\u0443\u0448\u0438\u0442\u0435\u0441\u044F \u0456
      \u043D\u0435 \u043B\u043E\u043C\u0438\u0442\u0435\u0441\u044F \u0432\u043F\u0435\u0440\u0435\u0434,
      \u043D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C \u0432\u0456\u0434\u0434\u0430\u044E\u0447\u0438
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E\u043C\u0443
      \u0432\u0456\u0434\u0441\u0442\u0440\u0456\u043B\u0443, \u0430 \u044F\u043A\u0449\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E - \u0442\u043E \u0439 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u043D\u043E\u043C\u0443
      \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u0443. \u0411\u043E\u043D\u0443\u0441
      \u0432\u043B\u0443\u0447\u043D\u043E\u0441\u0442\u0456 \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0437 \u043D\u0435\u0440\u0443\u0445\u043E\u043C\u043E\u0433\u043E \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0434\u043E
      #1 (\u0431\u0430\u0437\u043E\u0432\u0438\u0439 \u0431\u043E\u043D\u0443\u0441
      #2), \u0430 \u0448\u0442\u0440\u0430\u0444 \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0437\u0430 \u0441\u043F\u0438\u043D\u0443 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E
      \u0434\u043E #3 (\u0431\u0430\u0437\u043E\u0432\u0438\u0439 #4). \u0414\u0456\u0454
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0431\u0435\u0437 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0417.\u041F.\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435547
    m_Localized: "\u041C\u0430\u0442\u043B\u043E\u0433\u0456\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435548
    m_Localized: "\u0412\u0438 \u0432\u0456\u0434\u043A\u0430\u043B\u0456\u0431\u0440\u0443\u0432\u0430\u043B\u0438
      \u0441\u0432\u0456\u0439 \u041F\u0456\u043F\u0411\u0430\u043A \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u0449\u043E \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
      \u0430\u0442\u0430\u043A\u0438 \u0432 \u0417.\u041F.\u0421. \u0442\u0435\u043F\u0435\u0440
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C \u043D\u0430 #1
      \u043C\u0435\u043D\u0448\u0435 \u043E\u0447\u043E\u043A \u0434\u0456\u0457.
      \u041D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456 - \u043D\u0430 #2 \u043C\u0435\u043D\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435549
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0430 \u0443\u0434\u0430\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435550
    m_Localized: "\u0423 \u0431\u043E\u044E \u0432\u0430\u0441 \u0437\u0430\u0432\u0436\u0434\u0438
      \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443\u0454 \u0443\u0434\u0430\u0447\u0430.
      \u0412\u0430\u0448\u0456 \u0448\u0430\u043D\u0441\u0438 \u043D\u0430 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0443
      \u0430\u0442\u0430\u043A\u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 #1 \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435551
    m_Localized: "\u0423\u0431\u0438\u0432\u0447\u0430 \u0441\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435552
    m_Localized: "\u042F\u043A\u0449\u043E \u0432\u0436\u0435 \u0432\u0430\u043C
      \u0449\u0430\u0441\u0442\u0438\u0442\u044C \u0443 \u0431\u043E\u044E, \u0442\u043E
      \u0449\u0430\u0441\u0442\u0438\u0442\u044C \u0442\u0430\u043A, \u0449\u043E
      \u043C\u0430\u043B\u043E \u043D\u0456\u043A\u043E\u043C\u0443 \u043D\u0435
      \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F! \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435
      +#1 \u0434\u043E \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435553
    m_Localized: "\u0414\u0443\u0435\u043B\u044F\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435554
    m_Localized: "\u0412\u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C
      \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u0456 \u0433\u0440\u043E\u043C\u0456\u0437\u0434\u043A\u0438\u0445
      \u0433\u0430\u0440\u043C\u0430\u0442. \u0412\u0430\u0448 \u0432\u0438\u0431\u0456\u0440
      - \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0438 \u0456 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u0438,
      \u0430\u043B\u0435 \u0432\u0436\u0435 \u043D\u0438\u043C\u0438-\u0442\u043E
      \u0432\u0438 \u0432\u043E\u043B\u043E\u0434\u0456\u0454\u0442\u0435 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u043E.
      \u0423\u0441\u0456 \u0432\u0430\u0448\u0456 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0438
      (\u0456 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0438-\u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0438)
      \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C \u0431\u043E\u043D\u0443\u0441
      \u0434\u043E \u0432\u043B\u0443\u0447\u043D\u043E\u0441\u0442\u0456, \u0430
      \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0430 \u0437 \u043D\u0438\u0445
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u043D\u0430 #1 \u043C\u0435\u043D\u0448\u0435
      \u043E\u0447\u043E\u043A \u0434\u0456\u0457 \u0432 \u0417.\u041F.\u0421."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435555
    m_Localized: "\u0411\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0438\u0439
      \u0444\u0435\u0440\u043C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435556
    m_Localized: "\u0412\u0430\u0448\u0430 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F - \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A,
      \u0437 \u043D\u0438\u043C \u0432\u0438 \u0433\u043E\u0442\u043E\u0432\u0456
      \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438 \u0441\u0435\u0431\u0435 \u0456
      \u0441\u0432\u0456\u0439 \u0431\u0443\u0434\u0438\u043D\u043E\u043A \u0445\u043E\u0447
      \u0432\u0456\u0434 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432, \u0445\u043E\u0447
      \u0432\u0456\u0434 \u0431\u0430\u043D\u0434\u0438\u0442\u0456\u0432, \u0445\u043E\u0447
      \u0432\u0456\u0434 \u0430\u0440\u043C\u0456\u0457 \u0434\u0440\u0430\u043A\u043E\u043D\u0456\u0432.
      \u0423\u0441\u0456 \u0432\u0430\u0448\u0456 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0438
      \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0456
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456, \u0430
      \u0437\u0443\u043F\u0438\u043D\u044F\u043B\u044C\u043D\u0430 \u0441\u0438\u043B\u0430
      \u0434\u0440\u043E\u0431\u0443 \u0437\u0440\u043E\u0441\u0442\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435557
    m_Localized: "\u041A\u043E\u043C\u043C\u0430\u043D\u0434\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435558
    m_Localized: "\u0412\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456,
      \u0449\u043E \u043D\u0435\u043C\u0430\u0454 \u0437\u0431\u0440\u043E\u0457
      \u043A\u0440\u0430\u0449\u043E\u0457, \u043D\u0456\u0436 \u0432\u0456\u0440\u043D\u0430
      \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0430 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430.
      \u0412\u0436\u0435 \u0432\u0438-\u0442\u043E \u0437\u043D\u0430\u0454\u0442\u0435,
      \u044F\u043A \u0434\u043E\u043C\u043E\u0433\u0442\u0438\u0441\u044F \u0432\u0456\u0434
      \u043D\u0435\u0457 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0457
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456. \u0412\u0430\u0448\u0456
      \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0456 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438
      \u0456 \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0438 \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u043D\u0430 \u043A\u043E\u0436\u043D\u0443 \u043A\u0443\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435559
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u0456\u043B - \u0442\u0440\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435560
    m_Localized: "\u0412\u0438 - \u0432\u043B\u0443\u0447\u043D\u0438\u0439 \u0441\u0442\u0440\u0456\u043B\u0435\u0446\u044C,
      \u044F\u043A\u0438\u0439 \u043D\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430
      \u0434\u0430\u0440\u0435\u043C\u043D\u043E. \u0423\u0441\u0456 \u0432\u0430\u0448\u0456
      \u043C\u0438\u0441\u043B\u0438\u0432\u0441\u044C\u043A\u0456 \u0442\u0430 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u044C\u043A\u0456
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C
      \u0431\u043E\u043D\u0443\u0441 \u0434\u043E \u0448\u0430\u043D\u0441\u0443
      \u043D\u0430 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0435 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435561
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0435 \u0448\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435562
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      - \u0432\u0430\u0448\u0430 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0430.
      \u0412\u0438 \u0432\u043C\u0456\u0454\u0442\u0435 \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u0438\u0441\u044F
      \u0437 \u043D\u0435\u044E \u0442\u0430\u043A, \u0449\u043E\u0431 \u0432\u043E\u043D\u0430
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u043B\u0430
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435563
    m_Localized: "\u041F\u043B\u0430\u0437\u043C'\u044F\u043D\u0438\u0439 \u043F\u0440\u0438\u0432\u0456\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435564
    m_Localized: "\u0412\u0438 \u043E\u0431\u043E\u0436\u043D\u044E\u0454\u0442\u0435
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u043D\u0430 \u043A\u0430\u043B\u044E\u0436\u0456
      \u0441\u043B\u0438\u0437\u0443 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u043E\u0457 \u0437\u0431\u0440\u043E\u0457.
      \u0412\u0438 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
      \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F \u0437 \u0457\u0457
      \u043D\u0435\u0434\u043E\u043B\u0456\u043A\u0430\u043C\u0438, \u0442\u043E\u0436
      \u0432\u043E\u043D\u0430 \u0443 \u0432\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044F\u0454
      \u0442\u043E\u0447\u043D\u0456\u0448\u0435, \u0430 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u043F\u043E\u043B\u044C\u043E\u0442\u0443 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u0445
      \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435565
    m_Localized: "\u041F\u0456\u0440\u043E\u043C\u0430\u043D\u044C\u044F\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435566
    m_Localized: "\u0417 \u0434\u0438\u0442\u0438\u043D\u0441\u0442\u0432\u0430 \u0432\u0438
      \u043B\u044E\u0431\u0438\u043B\u0438 \u0432\u0441\u0435 \u043F\u0456\u0434\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438,
      \u0432\u0430\u0448 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0439 \u0437\u0430\u043F\u0430\u0445
      - \u0437\u0430\u043F\u0430\u0445 \u0431\u0435\u043D\u0437\u0438\u043D\u0443,
      \u0430 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F
      - \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F, \u044F\u043A \u0432\u043E\u0440\u043E\u0433
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043F\u0456\u043B. \u0411\u0443\u0434\u044C-\u044F\u043A\u0430
      \u0437\u0431\u0440\u043E\u044F, \u0449\u043E \u0437\u0430\u0432\u0434\u0430\u0454
      \u0448\u043A\u043E\u0434\u0438 \u0432\u043E\u0433\u043D\u0435\u043C (\u0443
      \u0442.\u0447. \u0456 \u0433\u0440\u0430\u043D\u0430\u0442\u0438), \u0441\u0442\u0430\u0454
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435567
    m_Localized: "\u0414\u0435\u0437\u0456\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435568
    m_Localized: "\u0423\u0441\u044F \u0432\u0430\u0448\u0430 \u043B\u0430\u0437\u0435\u0440\u043D\u0430
      \u0456 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0430 \u0437\u0431\u0440\u043E\u044F
      \u043E\u0442\u0440\u0438\u043C\u0443\u0454 #1 \u0448\u0430\u043D\u0441 \u0434\u0435\u0437\u0456\u043D\u0442\u0435\u0433\u0440\u0443\u0432\u0430\u0442\u0438
      \u0446\u0456\u043B\u044C, \u0442\u043E\u0431\u0442\u043E \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0437\u043D\u0438\u0449\u0438\u0442\u0438 \u0437 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F (\u0437\u0431\u0440\u043E\u044F
      \u0441\u0442\u0430\u043D\u0435 \u043A\u0440\u0443\u0442\u0456\u0448\u043E\u044E
      \u2248 \u043D\u0430 #2), \u044F\u043A\u0449\u043E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F,
      \u044F\u043A\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F,
      \u043F\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u0448\u043A\u043E\u0434\u0443
      \u0432\u0456\u0434 \u0437\u0431\u0440\u043E\u0457 \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u0436 \u0443 10 \u0440\u0430\u0437\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435569
    m_Localized: "\u0414\u0431\u0430\u0439\u043B\u0438\u0432\u0435 \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435570
    m_Localized: "\u0412\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u0432\u0447\u0430\u0441\u043D\u043E
      \u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u0456 \u0437\u043C\u0430\u0449\u0443\u0454\u0442\u0435
      \u0441\u0432\u043E\u044E \u0437\u0431\u0440\u043E\u044E, \u0442\u043E\u0436
      \u0432\u043E\u043D\u0430 \u0432\u0430\u0441 \u043D\u0435 \u043F\u0456\u0434\u0432\u043E\u0434\u0438\u0442\u044C
      \u0443 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.
      \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0437\u043D\u043E\u0448\u0435\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0434\u0430\u0441\u0442\u044C \u043E\u0441\u0456\u0447\u043A\u0443, \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u044C
      \u0430\u0431\u043E \u0437\u0430\u043A\u043E\u0440\u043E\u0442\u0438\u0442\u044C,
      \u0432 #1 \u0440\u0430\u0437\u0456\u0432 \u043D\u0438\u0436\u0447\u0430, \u0445\u043E\u0447\u0430
      \u0432 \u043D\u0435\u0457 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u0437\u043C\u0435\u043D\u0448\u0443\u044E\u0442\u044C\u0441\u044F
      \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C \u0456 \u0448\u043A\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435571
    m_Localized: "\u041F\u0440\u0438\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435572
    m_Localized: "\u0412\u0438 \u043D\u0430\u043F\u0440\u043E\u0447\u0443\u0434 \u0434\u043E\u0431\u0440\u0435
      \u043F\u0440\u0438\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0434\u043E \u0436\u0438\u0442\u0442\u044F \u043D\u0430 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0456\u0439
      \u0442\u0430 \u043E\u0442\u0440\u0443\u0454\u043D\u0456\u0439 \u041F\u0443\u0441\u0442\u0446\u0456.
      \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 \u0431\u043E\u043D\u0443\u0441
      \u0434\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u0456\u0434
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0456\u0434 \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0438\u0445
      \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u0438\u0445 \u0442\u0430 \u0457\u0434\u043A\u0438\u0445
      \u0440\u0435\u0447\u043E\u0432\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435573
    m_Localized: "\u0416\u0438\u0442\u0435\u043B\u044C \u0434\u0438\u043A\u0438\u0445
      \u0440\u0456\u0432\u043D\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435574
    m_Localized: "\u0412\u0438 \u0437\u0430\u0441\u0432\u043E\u0457\u043B\u0438 \u043F\u0440\u0435\u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0456
      \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F \u0441\u0435\u0440\u0435\u0434
      \u0434\u0438\u043A\u0438\u0445 \u0437\u0432\u0456\u0440\u0456\u0432 \u0456
      \u0447\u0443\u0434\u043E\u0432\u0438\u0441\u044C\u043A. \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435
      \u0431\u043E\u043D\u0443\u0441 \u0434\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443
      \u0432\u0456\u0434 \u0437\u0432\u0456\u0440\u0438\u043D\u0438\u0445 \u0456\u043A\u043B\u0456\u0432,
      \u043F\u0430\u0437\u0443\u0440\u0456\u0432, \u0436\u0430\u043B, \u0448\u0438\u043F\u0456\u0432
      \u0456 \u0442\u043E\u043C\u0443 \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u0445
      \u0437\u043D\u0430\u0440\u044F\u0434\u044C \u0443\u0431\u0438\u0432\u0441\u0442\u0432\u0430,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u043C\u0435\u043D\u0448\u0435 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u0454\u0442\u0435
      \u0432\u0456\u0434 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447 \u0456
      \u043E\u0442\u0440\u0443\u0454\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435575
    m_Localized: "\u041F\u0456\u0434\u0433\u043E\u043D\u043A\u0430 \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435576
    m_Localized: "\u0412\u0438 \u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
      \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043E\u044E
      \u0431\u0440\u043E\u043D\u044E \u0456 \u043F\u0456\u0434\u0433\u0430\u043D\u044F\u0442\u0438
      \u0457\u0457 \u0441\u043E\u0431\u0456 \u043F\u0456\u0434 \u0437\u0440\u0456\u0441\u0442,
      \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u044E\u0447\u0438 \u0457\u0457 \u0431\u043E\u0439\u043E\u0432\u0456
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438. \u0414\u043B\u044F
      \u0446\u0456\u0454\u0457 \u0440\u043E\u0431\u043E\u0442\u0438 \u0432\u0430\u043C
      \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F \u0432\u0435\u0440\u0441\u0442\u0430\u0442
      \u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438.
      \u041D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u0442\u0438
      \u0431\u0440\u043E\u043D\u044E \u0449\u0435 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435577
    m_Localized: "\u041C\u0430\u0439\u0441\u0442\u0435\u0440 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435578
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C \u0434\u0456\u0457
      \u0432\u0430\u0448\u043E\u0433\u043E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443
      \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      #1. \u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0432\u0438 \u0442\u0435\u043F\u0435\u0440
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0456\u0434\u043D\u0456\u043C\u0430\u0442\u0438
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C \u043E\u0431'\u0454\u043A\u0442\u0438,
      \u044F\u043A\u0456 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C
      \u043F\u043E\u0437\u0430 \u0432\u0430\u0448\u0438\u043C \u043F\u043E\u043B\u0435\u043C
      \u0437\u043E\u0440\u0443, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0437 \u043D\u0438\u043C\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
      \u0456\u043D\u0448\u0456 \u0434\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435579
    m_Localized: "\u0411\u0430\u0440\u0430\u0445\u043E\u043B\u044C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435580
    m_Localized: "\u0412\u0438 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0438\u043A\u0438\u0434\u0430\u0454\u0442\u0435. \u041D\u0430\u0432\u0456\u0442\u044C
      \u0443 \u0432\u0430\u0448\u0443 \u043A\u0456\u043C\u043D\u0430\u0442\u0443
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0438\u0437\u0438\u043A \u043F\u0435\u0440\u0435\u043B\u0430\u043C\u0430\u0442\u0438
      \u043D\u043E\u0433\u0438. \u041D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0438 \u0437\u0431\u0440\u043E\u0457
      \u0449\u043E\u0440\u0430\u0437\u0443, \u043A\u043E\u043B\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u0435
      \u0437\u0431\u0440\u043E\u044E, \u044F\u043A\u0443 \u0432\u0438 \u0432\u0436\u0435
      \u043C\u0430\u0454\u0442\u0435, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438\u043C\u0435\u0442\u0435
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043A\u043E\u0440\u0438\u0441\u043D\u043E\u0433\u043E
      (\u0437 \u0432\u0430\u0448\u043E\u0457 \u0442\u043E\u0447\u043A\u0438 \u0437\u043E\u0440\u0443)
      \u043C\u043E\u0442\u043B\u043E\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435581
    m_Localized: "\u0413\u0440\u0435\u043D\u0430\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435582
    m_Localized: "\u0412\u0438 \u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u0442\u0438 \u0432\u0441\u0456 \u0441\u0432\u043E\u0457
      \u0433\u0440\u0430\u043D\u0430\u0442\u0438 \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u0438\u043C
      \u0441\u0435\u043D\u0441\u043E\u0440\u043E\u043C, \u0442\u043E\u0436 \u0442\u0435\u043F\u0435\u0440
      \u0432\u043E\u043D\u0438 \u0432\u0438\u0431\u0443\u0445\u0430\u044E\u0442\u044C
      \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u043F\u0440\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456
      \u0437 \u0432\u043E\u0440\u043E\u0433\u043E\u043C! (\u0429\u043E\u0431 \u043C\u0435\u0442\u043D\u0443\u0442\u0438
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443 \u0433\u0440\u0430\u043D\u0430\u0442\u0443,
      \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043A\u0438\u0434\u043A\u0430 @1)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435583
    m_Localized: "\u041F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0447\u0438\u0439
      \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435584
    m_Localized: "\u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439 \u0431\u0440\u043E\u043D\u0456
      \u0454 \u0441\u043B\u0430\u0431\u043A\u0456 \u043C\u0456\u0441\u0446\u044F,
      \u0456 \u0432\u0438 \u0434\u043E\u0431\u0440\u0435 \u043F\u0440\u043E \u0446\u0435
      \u0437\u043D\u0430\u0454\u0442\u0435. \u0411\u0443\u0434\u044C-\u044F\u043A\u0430
      \u0432\u0430\u0448\u0430 \u043A\u043E\u043B\u044E\u0447\u043E-\u0440\u0456\u0436\u0443\u0447\u0430
      \u0437\u0431\u0440\u043E\u044F (\u0442\u0430\u043A\u0430, \u044F\u043A \u043D\u043E\u0436\u0456,
      \u043C\u0435\u0447\u0456, \u0441\u043E\u043A\u0438\u0440\u0438 \u0456 \u0441\u043F\u0438\u0441\u0438)
      \u043E\u0442\u0440\u0438\u043C\u0443\u0454 \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0456
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435585
    m_Localized: "\u041F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u0438\u0439
      \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435586
    m_Localized: "\u0411\u0443\u0434\u044C-\u044F\u043A\u0430 \u0432\u0430\u0448\u0430
      \u0443\u0434\u0430\u0440\u043D\u0430 \u0437\u0431\u0440\u043E\u044F (\u043D\u0430
      \u043A\u0448\u0442\u0430\u043B\u0442 \u0431\u0438\u0442\u0438, \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0438
      \u0430\u0431\u043E \u043A\u0443\u0432\u0430\u043B\u0434\u0438) \u043E\u0442\u0440\u0438\u043C\u0443\u0454
      \u0448\u0430\u043D\u0441 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0443\u0434\u0430\u0440\u0443
      \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u043D\u0430 #1 \u0441\u0435\u043A\u0443\u043D\u0434\u0438. \u0417\u0430\u043E\u0434\u043D\u043E
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0456
      \u0457\u0457 \u0432\u0456\u0434\u043A\u0438\u0434\u043D\u0430 \u0441\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435587
    m_Localized: "\u041C\u0430\u043D\u0456\u043F\u0443\u043B\u044F\u0442\u043E\u0440
      \u043D\u0443\u043B\u044C\u043E\u0432\u043E\u0433\u043E \u0440\u0456\u0432\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435588
    m_Localized: "\u0412\u0438 \u0432\u043C\u0456\u0454\u0442\u0435 \u043D\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438
      \u043E\u0431'\u0454\u043A\u0442\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443, \u0430 \u0439
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438 \u0457\u0445
      \u0443 \u043F\u043E\u043B\u0456\u0442! \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E,
      \u043B\u0435\u0432\u0456\u0442\u0443\u044E\u0447\u0438 \u043E\u0431'\u0454\u043A\u0442,
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C @1. \u041C\u043E\u0436\u043D\u0430
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0436\u0431\u0443\u0440\u043D\u0443\u0442\u0438
      \u0443 \u0432\u043E\u0440\u043E\u0433\u0430 \u0432\u0430\u0436\u043A\u0438\u0439
      \u044F\u0449\u0438\u043A, \u0430\u0431\u043E \u0439\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u0440\u043E\u0437\u043C\u0430\u0437\u0430\u0442\u0438 \u043E\u0431 \u0441\u0442\u0456\u043D\u0443.
      \u041D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456 \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u043A\u0438\u0434\u0430\u0442\u0438 \u043E\u0431'\u0454\u043A\u0442\u0438
      \u0434\u0430\u043B\u0456 \u0442\u0430 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435.
      \u041C\u0430\u0439\u0442\u0435 \u043D\u0430 \u0443\u0432\u0430\u0437\u0456
      - \u043A\u0438\u0434\u043A\u0438 \u0432\u0430\u0436\u043A\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432
      \u0448\u0432\u0438\u0434\u043A\u043E \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C
      \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0435\u043D\u0435\u0440\u0433\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435589
    m_Localized: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435590
    m_Localized: "\u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u043C\u0438\u0442\u0442\u0454\u0432\u043E
      \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0430\u0442\u0438\u0441\u044F \u0432
      \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456. \u0414\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0456 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
      @1, \u043F\u043E\u043A\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043D\u0435 \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u044C\u0441\u044F,
      \u043F\u0456\u0441\u043B\u044F \u0447\u043E\u0433\u043E \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0456\u0442\u044C.
      \u0414\u043B\u044F \u0441\u043A\u0430\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0432\u0436\u0435 \u0437\u0430\u0440\u044F\u0434\u0436\u0435\u043D\u043E\u0433\u043E
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      @2. \u0412\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E
      \u0431\u0430\u0447\u0438\u0442\u0438 \u0442\u043E\u0447\u043A\u0443 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F.
      \u0412\u0438\u043C\u0430\u0433\u0430\u0454 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0431\u0430\u0433\u0430\u0442\u043E \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435591
    m_Localized: "\u0410\u043B\u0445\u0456\u043C\u0456\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435592
    m_Localized: "\u0414\u043E\u0432\u0433\u0456 \u0433\u043E\u0434\u0438\u043D\u0438,
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0456 \u043D\u0430\u0434 \u043A\u043E\u0442\u043B\u043E\u043C,
      \u0440\u0435\u0442\u043E\u0440\u0442\u043E\u044E \u0456 \u043F\u0435\u0440\u0435\u0433\u0456\u043D\u043D\u0438\u043C
      \u043A\u0443\u0431\u043E\u043C, \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
      \u0441\u0432\u043E\u0457 \u043F\u043B\u043E\u0434\u0438. \u0422\u0435\u043F\u0435\u0440,
      \u0437\u0430\u0439\u043C\u0430\u044E\u0447\u0438\u0441\u044C \u0437\u0456\u043B\u043B\u0454\u0432\u0430\u0440\u0456\u043D\u043D\u044F\u043C,
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u043F\u043E \u0434\u0432\u0456 \u043F\u043B\u044F\u0448\u0435\u0447\u043A\u0438
      \u0437 \u0437\u0456\u043B\u043B\u044F\u043C \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u043E\u0434\u043D\u0456\u0454\u0457, \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0447\u0438
      \u0442\u0443 \u0441\u0430\u043C\u0443 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0456\u0432. \u041D\u0435
      \u043F\u043E\u0448\u0438\u0440\u044E\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      \u0437\u0456\u043B\u043B\u044F \u0437 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u043C
      \u0435\u0444\u0435\u043A\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435593
    m_Localized: "\u041D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u0439
      \u0441\u0442\u0443\u0441\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435594
    m_Localized: "\u0412\u0430\u0448\u0456 \u0443\u0434\u0430\u0440\u0438 \u0433\u043E\u043B\u0438\u043C\u0438
      \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438 \u043F\u043E\u0441\u0438\u043B\u044E\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 #1. \u0422\u0435\u043F\u0435\u0440 \u0432\u0438 \u0437\u0434\u0430\u0442\u043D\u0456
      \u0432\u0438\u0431\u0438\u0432\u0430\u0442\u0438 \u0437\u0430\u0434\u043D\u0456\u043C\u0438
      \u043D\u043E\u0433\u0430\u043C\u0438 \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0456
      \u0442\u0430 \u043C\u0456\u0446\u043D\u0456 \u0434\u0432\u0435\u0440\u0456,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u043D\u0435\u043D\u0430\u0434\u043E\u0432\u0433\u043E
      \u043E\u0433\u043B\u0443\u0448\u0430\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435595
    m_Localized: "\u0414\u0438\u0442\u044F \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435596
    m_Localized: "\u0420\u0430\u0434\u0456\u0430\u0446\u0456\u044F \u043D\u0435 \u0432\u0431\u0438\u0432\u0430\u0454
      \u0432\u0430\u0441, \u0430 \u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u043E\u0431\u0438\u0442\u044C
      \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u043C\u0438. \u0429\u043E
      \u0432\u0438\u0449\u0438\u0439 \u0432\u0430\u0448 \u0440\u0456\u0432\u0435\u043D\u044C
      \u043E\u043F\u0440\u043E\u043C\u0456\u043D\u0435\u043D\u043D\u044F, \u0442\u043E
      \u043C\u0435\u043D\u0448\u0435 \u0442\u0440\u0430\u0432\u043C \u0432\u0438
      \u0431\u0443\u0434\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438.
      \u0422\u0430\u043A\u043E\u0436 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u044F
      \u043D\u0435 \u0437\u043C\u043E\u0436\u0435 \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u0438
      \u0432\u0430\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0431\u0456\u043B\u044C\u0448
      \u043D\u0456\u0436 \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435597
    m_Localized: "\u0415\u043A\u0441\u043F\u0435\u0440\u0442 \u0456\u0437 \u0431\u0435\u0437\u043F\u0435\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435598
    m_Localized: "\u0412\u0438 \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u0454\u0442\u0435\u0441\u044F
      \u0432 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0445
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u044F\u043A \u043D\u0456\u0445\u0442\u043E \u0456\u043D\u0448\u0438\u0439.
      \u0417 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443,
      \u0449\u043E \u043A\u0435\u0440\u0443\u0454 \u0442\u0443\u0440\u0435\u043B\u044F\u043C\u0438,
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0457\u0445 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438,
      \u0430 \u043F\u0435\u0440\u0435\u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
      \u0442\u0430\u043A, \u0449\u043E \u0432\u043E\u043D\u0438 \u043F\u043E\u0447\u043D\u0443\u0442\u044C
      \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448\u0438\u0445
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432.
      \u041F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0442\u0435
      \u0437\u0430 \u0442\u0443\u0440\u0435\u043B\u0456 \u0432\u0435\u0441\u044C
      \u0434\u043E\u0441\u0432\u0456\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435599
    m_Localized: "\u0417\u043E\u043D\u0430 \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435600
    m_Localized: "\u0421\u0430\u043C\u043E \u0441\u043E\u0431\u043E\u044E, \u0431\u0443\u0434\u044C-\u044F\u043A\u0430
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430 \u0442\u0438\u043C \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u0430,
      \u0447\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0443 \u043F\u043B\u043E\u0449\u0443
      \u043D\u0430\u043A\u0440\u0438\u0432\u0430\u0454 \u0432\u0438\u0431\u0443\u0445\u043E\u043C.
      \u0420\u0430\u0434\u0456\u0443\u0441 \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0434\u043B\u044F \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043D\u043E\u0457
      \u0432\u0430\u043C\u0438 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435601
    m_Localized: "\u0415\u043A\u0441\u043F\u0435\u0440\u0442-\u0441\u0430\u043F\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435602
    m_Localized: "\u042F\u043A\u0449\u043E \u043C\u043E\u0432\u0430 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C
      \u043F\u0440\u043E \u043C\u0456\u043D\u0438 \u0456 \u043C\u0456\u043D\u043D\u0456
      \u043F\u043E\u043B\u044F, \u0442\u043E \u0432 \u0446\u0456\u0439 \u0441\u043F\u0440\u0430\u0432\u0456
      \u0432\u0430\u043C \u043D\u0435\u043C\u0430\u0454 \u0440\u0456\u0432\u043D\u0438\u0445.
      \u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456 \u0432\u0430\u043C\u0438
      \u043C\u0456\u043D\u0438 \u0441\u0442\u0430\u044E\u0442\u044C \u043D\u0430
      #1 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u043C\u0438, \u0430
      \u043A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0432\u0430\u0448\u0456
      \u043C\u0456\u043D\u0438 \u043D\u0435 \u0434\u0435\u0442\u043E\u043D\u0443\u044E\u0442\u044C
      \u0432\u0456\u0434 \u0431\u043B\u0438\u0437\u044C\u043A\u0438\u0445 \u0432\u0438\u0431\u0443\u0445\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435603
    m_Localized: "\u041C\u0430\u0439\u0441\u0442\u0435\u0440 \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u0433\u043E
      \u0431\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435604
    m_Localized: "\u0412\u0438 \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u043E
      \u043E\u0432\u043E\u043B\u043E\u0434\u0456\u043B\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E. \u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0430\u0442\u0430\u043A\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u0433\u043E
      \u0431\u043E\u044E (\u043A\u0440\u0456\u043C \u0431\u0435\u043D\u0437\u043E\u043F\u0438\u043B\u0438
      \u0456 \u043F\u043E\u0434\u0456\u0431\u043D\u043E\u0433\u043E) \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043E
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435605
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0438\u0439 \u043C\u0430\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435606
    m_Localized: "\u0412\u0438 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0432\u0438\u043A\u043B\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0432 \u0431\u043E\u044F\u0445 \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0443
      \u043C\u0430\u0433\u0456\u044E, \u0449\u043E \u0432\u043E\u043D\u0430 \u0432\u0430\u0441
      \u043C\u0430\u0439\u0436\u0435 \u043D\u0435 \u0441\u0442\u043E\u043C\u043B\u044E\u0454.
      \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0432\u0438 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u043D\u0430 \u0431\u043E\u0439\u043E\u0432\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043C\u0435\u043D\u0448\u0435 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435607
    m_Localized: "\u0414\u0440\u0443\u0436\u043D\u0456\u0439 \u0432\u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435608
    m_Localized: "\u0412\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u043D\u0430\u0454\u0442\u0435,
      \u044F\u043A \u043A\u0438\u043D\u0443\u0442\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0443
      \u0430\u0431\u043E \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u0438\u0442\u0438
      \u0437 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442\u0430 \u0442\u0430\u043A,
      \u0449\u043E\u0431 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u0432\u0430\u0441
      \u043D\u0435 \u0437\u0430\u0447\u0435\u043F\u0438\u043B\u043E \u0432\u0438\u0431\u0443\u0445\u043E\u043C.
      \u0417 \u0446\u0456\u0454\u044E \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044E
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      #1 \u0448\u043A\u043E\u0434\u0438 \u0432\u0456\u0434 \u0432\u043B\u0430\u0441\u043D\u043E\u0457
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438, \u0432\u043A\u043B\u044E\u0447\u043D\u043E
      \u0437 \u0457\u0457 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u043C\u0438
      \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435609
    m_Localized: "\u0422\u0440\u0438\u0432\u0430\u043B\u0430 \u0434\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435610
    m_Localized: "\u0412\u0430\u0448\u0456 \u043C\u0435\u0434\u0438\u0447\u043D\u0456
      \u043F\u0456\u0437\u043D\u0430\u043D\u043D\u044F \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u044E\u0442\u044C
      \u0432\u0430\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0431\u043E\u0439\u043E\u0432\u043E\u044E \u0445\u0456\u043C\u0456\u0454\u044E.
      \u0422\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0430 \u0434\u0456\u0454
      \u043D\u0430 \u0432\u0430\u0441 \u0432 #1 \u0440\u0430\u0437\u0438 \u0434\u043E\u0432\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435611
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0456 \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435612
    m_Localized: "\u0412\u0438 \u0447\u0443\u0434\u043E\u0432\u043E \u0432\u0438\u0432\u0447\u0438\u043B\u0438
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0443 \u0456 \u0437\u043D\u0430\u0454\u0442\u0435,
      \u044F\u043A \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0445\u0456\u043C\u0456\u043A\u0430\u0442\u0456\u0432 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0441\u0435\u0431\u0435 \u043D\u0430 \u043C\u0430\u0448\u0438\u043D\u0443
      \u0441\u043C\u0435\u0440\u0442\u0456. \u0415\u0444\u0435\u043A\u0442\u0438
      \u0432\u0456\u0434 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0442\u0430\u043A\u0438\u0445 \u0440\u0435\u0447\u043E\u0432\u0438\u043D,
      \u044F\u043A \u043C\u0456\u043D\u0442\u0430\u043B\u043A\u0438, \u0431\u0430\u043A,
      \u0434\u0435\u0448, \u0440\u0435\u0439\u0434\u0436 \u0456 \u043C\u0435\u0434-\u0445,
      \u043F\u043E\u0441\u0438\u043B\u044E\u044E\u0442\u044C\u0441\u044F. \u041F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0432 #1 \u0440\u0430\u0437\u0438 \u0437\u043C\u0435\u043D\u0448\u0443\u044E\u0442\u044C\u0441\u044F
      \u0448\u0430\u043D\u0441\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0437\u0430\u043B\u0435\u0436\u043D\u0456\u0441\u0442\u044C \u0432\u0456\u0434
      \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435613
    m_Localized: "\u0415\u043A\u043E\u043D\u043E\u043C\u0456\u043A\u0430 \u041F\u0443\u0441\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435614
    m_Localized: "\u0412\u0430\u0448\u0456 \u0442\u0430\u043B\u0430\u043D\u0442\u0438
      \u0435\u043A\u043E\u043D\u043E\u043C\u0456\u0441\u0442\u0430 \u0441\u043F\u0440\u0438\u044F\u044E\u0442\u044C
      \u0440\u043E\u0437\u0432\u0438\u0442\u043A\u0443 \u0442\u043E\u0440\u0433\u0456\u0432\u043B\u0456.
      \u0423\u0441\u0456 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456 \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C
      \u0437\u0430\u0432\u043E\u0437\u0438\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u0430\u0442\u0440\u043E\u043D\u0456\u0432, \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u0456\u0432
      \u0442\u0430 \u0456\u043D\u0448\u0438\u0445 \u0445\u043E\u0434\u043E\u0432\u0438\u0445
      \u0442\u043E\u0432\u0430\u0440\u0456\u0432. \u0422\u0430\u043A\u043E\u0436
      \u0434\u043E \u0442\u0430\u0431\u043E\u0440\u0443 \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439
      \u041F\u043E\u043D\u0456\" \u043F\u043E\u0447\u0438\u043D\u0430\u0454 \u0437\u0430\u0433\u043B\u044F\u0434\u0430\u0442\u0438
      \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446\u044C
      \u0456\u0437 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u043C\u0438 \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435615
    m_Localized: "\u0415\u043C\u043F\u0430\u0442\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435616
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0438\u0439
      \u0437\u0432'\u044F\u0437\u043E\u043A \u0456\u0437 \u0432\u0430\u0448\u0438\u043C
      \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C \u043D\u0430\u0434\u0430\u0454
      \u0439\u043E\u043C\u0443 \u043D\u043E\u0432\u0438\u0445 \u0441\u0438\u043B.
      \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0437\u0430\u0445\u0438\u0441\u0442 \u0456 \u0430\u0442\u0430\u043A\u0430
      \u0432\u0430\u0448\u043E\u0433\u043E \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0430
      \u0456\u0441\u0442\u043E\u0442\u043D\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      (\u0436\u0438\u0432\u0456 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0438
      \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C \u0432\u0438\u0449\u0456
      \u0431\u043E\u043D\u0443\u0441\u0438, \u043D\u0456\u0436 \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u0456)."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435617
    m_Localized: "\u0412\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435618
    m_Localized: "\u0416\u0438\u0442\u0442\u044F \u0432 \u0441\u0443\u0432\u043E\u0440\u0438\u0445
      \u0443\u043C\u043E\u0432\u0430\u0445 \u041F\u0443\u0441\u0442\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u043B\u043E
      \u0432\u0430\u0448\u0443 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C.
      \u0422\u0435\u043F\u0435\u0440 \u0443 \u0431\u043E\u044E \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0431\u0456\u0433\u0430\u0442\u0438 \u0456 \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438
      \u0434\u043E\u0432\u0448\u0435, \u043D\u0435 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E\u0447\u0438
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0432\u0442\u043E\u043C\u0438.
      \u0412\u0438\u0442\u0440\u0430\u0442\u0443 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456
      \u043D\u0430 \u0431\u0456\u0433 \u0456 \u0441\u0442\u0440\u0438\u0431\u043A\u0438
      \u0432 \u0431\u043E\u044E \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E
      \u043D\u0430 #1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435619
    m_Localized: "\u0422\u0432\u0435\u0440\u0434\u0438\u0439 \u0445\u0432\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435620
    m_Localized: "\u0412\u0438 \u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
      \u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0437\u0431\u0440\u043E\u044E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C
      \u0442\u0430\u043A, \u0449\u043E \u043D\u0430 \u043D\u0435\u0457 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0434\u0456\u0454 \u0432\u0456\u0434\u0434\u0430\u0447\u0430.
      \u0422\u0435\u043F\u0435\u0440 \u043C\u043E\u0436\u043D\u0430 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438
      \u0434\u043E\u0432\u0448\u0438\u043C\u0438 \u0447\u0435\u0440\u0433\u0430\u043C\u0438,
      \u043D\u0435 \u043F\u043E\u0431\u043E\u044E\u044E\u0447\u0438\u0441\u044C,
      \u0449\u043E \u043F\u0440\u0438\u0446\u0456\u043B \u0437\u0456\u0431'\u0454\u0442\u044C\u0441\u044F.
      \u0426\u0435 \u0442\u0430\u043A\u043E\u0436 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454
      \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438
      \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u0445 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435621
    m_Localized: "\u041F\u0435\u0440\u0444\u043E\u0440\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435622
    m_Localized: "\u041D\u0430\u0440\u043E\u0431\u0438\u043C\u043E \u0432 \u043D\u0438\u0445
      \u0434\u0456\u0440\u043E\u043A! \u0412\u0430\u0448\u0456 \u0432\u0430\u0436\u043A\u0456
      \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0456
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456, \u0430
      \u0440\u043E\u0437\u043B\u0456\u0442 \u0457\u0445\u043D\u0456\u0445 \u043A\u0443\u043B\u044C
      \u0437\u043C\u0435\u043D\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0432 #1
      \u0440\u0430\u0437\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435623
    m_Localized: "\u0414\u0456\u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435624
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0432\u0430\u0448\u043E\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0430 \u0456 \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u0438
      \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C \u0432\u0430\u043C \u043C\u0435\u043D\u0448\u0435
      \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435625
    m_Localized: "\u0420\u0435\u0446\u0438\u043A\u043B\u0456\u043D\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435626
    m_Localized: "\u0412\u0438 \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0443\u0432\u0430\u043B\u0438
      \u0432\u0441\u044E \u0432\u0430\u0448\u0443 \u0437\u0431\u0440\u043E\u044E,
      \u044F\u043A\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0440\u0456\u0437\u043D\u0456 \u0431\u0430\u0442\u0430\u0440\u0435\u0457,
      \u0449\u043E\u0431 \u0432\u043E\u043D\u0430 \u0441\u043F\u043E\u0436\u0438\u0432\u0430\u043B\u0430
      \u043C\u0435\u043D\u0448\u0435 \u0435\u043D\u0435\u0440\u0433\u0456\u0457.
      \u0417 \u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044E #1
      \u043A\u043E\u0436\u0435\u043D \u043F\u043E\u0441\u0442\u0440\u0456\u043B \u0437
      \u0442\u0430\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457 \u0431\u0443\u0434\u0435
      \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0438\u043C, \u0442\u043E\u0431\u0442\u043E
      \u043D\u0435 \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0437\u0430\u0440\u044F\u0434\u0443
      \u0431\u0430\u0442\u0430\u0440\u0435\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435627
    m_Localized: "\u0425\u0430\u043B\u044F\u0432\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435628
    m_Localized: "\u0412\u0430\u043C \u0437\u0430\u0432\u0436\u0434\u0438 \u0449\u0430\u0441\u0442\u0438\u0442\u044C
      \u0442\u0440\u043E\u0445\u0438 \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436
      \u0456\u043D\u0448\u0438\u043C \u043C\u0438\u0441\u043B\u0438\u0432\u0446\u044F\u043C
      \u0437\u0430 \u0446\u0456\u043D\u043D\u0438\u043C \u0431\u0430\u0440\u0430\u0445\u043B\u043E\u043C.
      \u0412\u0438 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438\u043C\u0435\u0442\u0435
      \u0432 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430\u0445 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0440\u0456\u0437\u043D\u0438\u0445 \u043D\u0430\u0431\u043E\u0457\u0432 \u0456
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435629
    m_Localized: "\u041D\u0430\u0434\u0456\u0439\u043D\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435630
    m_Localized: "\u0417\u0430\u0432\u0434\u044F\u043A\u0438 \u0442\u043E\u043C\u0443,
      \u0449\u043E \u0432\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u043E\u0433\u043B\u044F\u0434\u0430\u0454\u0442\u0435 \u0437\u0430 \u0441\u0432\u043E\u0454\u044E
      \u0431\u0440\u043E\u043D\u0435\u044E, \u0432\u043E\u043D\u0430 \u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u0432\u0430\u043C \u043D\u0430 #1 \u0434\u043E\u0432\u0448\u0435. \u0429\u043E
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0441\u0443\u0442\u0442\u0454\u0432\u043E
      \u0435\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u0438 \u043D\u0430 \u0457\u0457
      \u0440\u0435\u043C\u043E\u043D\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435631
    m_Localized: "\u041F\u043E\u0434\u0432\u0456\u0439\u043D\u0438\u0439 \u0441\u0442\u0440\u0438\u0431\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435632
    m_Localized: "\u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0441\u0432\u043E\u0433\u043E \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0434\u0438\u043D
      \u0440\u0430\u0437 \u0432\u0456\u0434\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0442\u0438\u0441\u044F
      \u0432 \u0441\u0442\u0440\u0438\u0431\u043A\u0443 \u0432\u0456\u0434 \u043F\u043E\u0432\u0456\u0442\u0440\u044F.
      \u0412\u0438\u0441\u043E\u0442\u0430 \u0446\u044C\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0441\u0442\u0440\u0438\u0431\u043A\u0430 \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
      \u0432\u0456\u0434 \u0440\u0456\u0432\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \"\u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435450
    m_Localized: "\u041A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u0421\u0417\u0416"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435451
    m_Localized: "\u0412\u0438 \u043B\u0435\u0434\u044C \u043D\u0435 \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438,
      \u0430\u043B\u0435 \u0431\u0443\u043B\u0438 \u0432\u0440\u044F\u0442\u043E\u0432\u0430\u043D\u0456
      \u0421\u0438\u0441\u0442\u0435\u043C\u043E\u044E \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0416\u0438\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435452
    m_Localized: "\u0424\u043E\u043D\u0442\u0430\u043D \u0436\u0438\u0442\u0442\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435453
    m_Localized: "\u0412\u0430\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F
      \u0441\u0442\u0430\u043B\u043E \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u043C!
      (+#1 \u0437\u0430 \u0440\u0456\u0432\u0435\u043D\u044C \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456)"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435637
    m_Localized: "\u041C\u043E\u0433\u0443\u0442\u043D\u0456\u0439 \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435638
    m_Localized: "\u0412\u0430\u0448 \u0437\u0430\u043F\u0430\u0441 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043E!
      (+#1 \u0437\u0430 \u0440\u0456\u0432\u0435\u043D\u044C \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456)"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435639
    m_Localized: "\u0410\u043B\u043C\u0430\u0437\u043D\u0438\u0439 \u0441\u043A\u0435\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435640
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0437\u043C\u0456\u0446\u043D\u0438\u043B\u043E \u0432\u0430\u0448\u0456 \u043A\u0456\u0441\u0442\u043A\u0438.
      \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u043D\u0430 #1 \u043C\u0435\u043D\u0448\u0435 \u0442\u0440\u0430\u0432\u043C
      \u0456\u0437 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435641
    m_Localized: "\u041C\u0456\u0446\u043D\u0438\u0439 \u0456\u043C\u0443\u043D\u0456\u0442\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435642
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0437\u043C\u0456\u0446\u043D\u0438\u043B\u043E \u0437\u0430\u0445\u0438\u0441\u043D\u0456
      \u0441\u0438\u043B\u0438 \u0432\u0430\u0448\u043E\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443.
      \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 +#1 \u0434\u043E
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u0456\u0434 \u043E\u0442\u0440\u0443\u0454\u043D\u043D\u044F,
      \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0456 \u0442\u0430 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457
      \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435643
    m_Localized: "\u0421\u0438\u043B\u0430 \u0417\u0435\u043C\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435644
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u043B\u043E \u0432\u0430\u0448\u0456
      \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u0438 \u0442\u0430 \u043F\u043E\u0441\u0438\u043B\u0438\u043B\u043E
      \u0430\u0433\u0440\u0435\u0441\u0456\u044E. \u0412\u0438 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u043D\u0430 #1 \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E
      \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435645
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0432\u0456\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435646
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0437\u043C\u0456\u0446\u043D\u0438\u043B\u043E \u0432\u0430\u0448\u0456 \u043C'\u044F\u0437\u0438
      \u0456 \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u043B\u043E \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C.
      \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 +#1 \u0434\u043E
      \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456 \u0431\u0456\u0433\u0443
      \u0456 \u0437\u0430\u043F\u0430\u0441\u0443 \u0441\u0438\u043B \u0437\u0430
      \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C \u0446\u0456\u0454\u0457
      \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435647
    m_Localized: "\u041E\u0440\u043B\u0438\u043D\u0435 \u043E\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435648
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u043B\u043E \u0432\u0430\u0448\u0443
      \u043D\u0435\u0440\u0432\u043E\u0432\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443
      \u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u043B\u043E \u0433\u043E\u0441\u0442\u0440\u043E\u0442\u0443
      \u0437\u043E\u0440\u0443. \u0426\u0435 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u044C
      \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C \u043F\u0440\u0438 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0456
      \u043D\u0430 #1 \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435649
    m_Localized: "\u0406\u043D\u0442\u0443\u0457\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435650
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u043F\u043E\u0441\u0438\u043B\u0438\u043B\u043E \u0432\u0430\u0448\u0443 \u0456\u043D\u0442\u0443\u0457\u0446\u0456\u044E.
      \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 +#1 \u0431\u043E\u043D\u0443\u0441\u0443
      \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F \u0437\u0430 \u043A\u043E\u0436\u0435\u043D
      \u0440\u0456\u0432\u0435\u043D\u044C \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435651
    m_Localized: "\u041A\u0440\u0438\u0442\u0438\u0447\u043D\u0430 \u0443\u0434\u0430\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435652
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435 \u0437\u0456\u043B\u043B\u044F
      \u043F\u043E\u0441\u0438\u043B\u0438\u043B\u043E \u0432\u0430\u0448\u0443 \u0443\u0434\u0430\u0447\u0443.
      \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 +#1 \u0434\u043E
      \u0448\u0430\u043D\u0441\u0443 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F \u0437\u0430 \u043A\u043E\u0436\u0435\u043D
      \u0440\u0456\u0432\u0435\u043D\u044C \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435653
    m_Localized: "\u041F\u043E\u043B\u0443\u043C'\u044F\u043D\u0438\u0439 \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435654
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0437\u043C\u0456\u0446\u043D\u0438\u043B\u043E \u0437\u0432'\u044F\u0437\u043E\u043A
      \u043C\u0456\u0436 \u0432\u0430\u043C\u0438 \u0456 \u0441\u0442\u0438\u0445\u0456\u0439\u043D\u0438\u043C\u0438
      \u0441\u0438\u043B\u0430\u043C\u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u0438.
      \u0412\u0430\u0448\u0456 \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043F\u043E\u0441\u0438\u043B\u044E\u044E\u0442\u044C\u0441\u044F \u043D\u0430
      #1 \u0437\u0430 \u043A\u043E\u0436\u0435\u043D \u0440\u0456\u0432\u0435\u043D\u044C
      \u0446\u0456\u0454\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435655
    m_Localized: "\u0412\u0438\u043D\u0438\u0449\u0443\u0432\u0430\u0447 \u0437\u043E\u043C\u0431\u0456"
    m_Metadata:
      m_Items: []
