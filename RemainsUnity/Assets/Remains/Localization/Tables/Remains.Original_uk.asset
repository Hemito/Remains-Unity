      \u0457\u0431\u0430\u0442\u0438 \u0442\u0435\u0431\u0435 \u0432 \u0441\u0440\u0430\u043A\u0443,
      \u043F\u0438\u0437\u0434\u043E\u0431\u043B\u044F\u0434\u0441\u044C\u043A\u0430
      \u043C\u0443\u0434\u043E\u0454\u0431\u0456\u043D\u044C!\n\u0426\u0435 \u0436\u0438\u0442\u0442\u044F
      \u0445\u0443\u0439\u043D\u044F \u0442\u0430\u043A\u0430, \u0449\u043E \u043D\u0456\u0445\u0443\u044F
      \u0432 \u043D\u0456\u0439 \u043D\u0435 \u043F\u043E\u0439\u043C\u0435\u0448,
      \u043A\u043E\u0436\u0435\u043D\u044C \u0434\u0435\u043D\u044C \u043E\u0445\u0443\u0457\u0432\u0430\u0454\u0448,
      \u043E\u0445\u0443\u0457\u0432\u0448\u0438\u043C \u0456 \u043F\u043E\u043C\u0440\u0435\u0448.\n\n3.
      \u0411\u043E\u0433\u043E\u0445\u0443\u043B\u044C\u0441\u0442\u0432\u0430.\n\u0422\u0443\u0442
      \u043F\u0435\u0440\u0435\u043B\u0456\u0447\u0435\u043D\u043E \u043F\u043E\u0442\u0432\u043E\u0440\u043D\u0456
      \u0439 \u0431\u0440\u0443\u0434\u043D\u0456 \u043B\u0430\u0439\u043A\u0438,
      \u0432 \u044F\u043A\u0438\u0445 \u0442\u0456\u0454\u044E \u0447\u0438 \u0456\u043D\u0448\u043E\u044E
      \u043C\u0456\u0440\u043E\u044E \u0437\u0430\u0434\u0456\u044F\u043D\u0456 \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0456
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0438 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F
      \u0456 \u041B\u0443\u043D\u0430. \u0411\u0430\u0433\u0430\u0442\u043E \u0445\u0442\u043E
      \u0432\u0456\u0440\u0438\u0442\u044C, \u0449\u043E \u0437\u0433\u0430\u0434\u0443\u0432\u0430\u043D\u043D\u044F
      \u0457\u0445 \u0443 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0435\u0433\u0430\u0440\u043D\u043E\u043C\u0443 \u0456 \u043B\u0430\u0439\u043B\u0438\u0432\u043E\u043C\u0443
      \u043A\u043B\u044E\u0447\u0456 - \u0441\u0430\u043C\u0435 \u043F\u043E \u0441\u043E\u0431\u0456
      \u0433\u0440\u0456\u0445, \u0456 \u043D\u0430\u0448\u0456 \u043D\u0435\u0431\u0435\u0441\u043D\u0456
      \u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043A\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u043D\u0435 \u0441\u0442\u0435\u0440\u043F\u0456\u0442\u0438
      \u0442\u0430\u043A\u043E\u0433\u043E \u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044F
      \u0434\u043E \u0441\u0435\u0431\u0435. \u0422\u043E\u043C\u0443 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0457\u0445 \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u0441\u0432\u0456\u0439
      \u0441\u0442\u0440\u0430\u0445 \u0456 \u0440\u0438\u0437\u0438\u043A.\n\n\u0412\u0438\u0457\u0431\u0438
      \u043C\u0435\u043D\u0435 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u043A\u043E\u043F\u0438\u0442\u043E\u043C!\n\u0417\u0491\u0432\u0430\u043B\u0442\u0443\u0439
      \u0442\u0435\u0431\u0435 (\u0432\u0430\u0441/\u0457\u0445) \u041B\u0443\u043D\u0430
      \u0440\u043E\u0433\u043E\u043C!\n\u0412\u0456\u0434'\u0457\u0431\u0438 \u043C\u0435\u043D\u0435
      \u043C\u0456\u0441\u044F\u0446\u0435\u043C!\n\u0412\u0438\u0448\u043A\u0440\u044F\u0431\u0430\u043D\u0438\u0439
      \u041B\u0443\u043D\u043E\u044E \u043C\u0443\u0434\u0430\u043A!\n\u0420\u0456\u0433
      \u043C\u0435\u043D\u0456 \u0442\u0443\u0434\u0438, \u0434\u0435 \u0432 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457
      \u043D\u0435 \u0441\u0432\u0456\u0442\u0438\u0442\u044C!\n\u0421\u043E\u043D\u044F\u0447\u043D\u0456
      \u0441\u043F\u0430\u043B\u0430\u0445\u0438 \u043E\u0440\u0433\u0430\u0437\u043C\u0456\u0432
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457!\n\u041F\u043E\u0442\u0435\u0440\u0442\u0438
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u043C\u0456\u0439 \u043A\u043B\u0456\u0442\u043E\u0440
      (\u0457\u043B\u0434\u0443) \u0440\u043E\u0437\u043F\u0435\u0447\u0435\u043D\u0438\u043C\u0438
      \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438!\n\u0421\u043E\u0441\u043A\u0438
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457!\n\u041F\u043E\u0442\u0440\u043E\u0449\u0438
      \u043C\u0435\u043D\u0456 \u041B\u0443\u043D\u0430 \u043A\u0440\u0438\u043B\u0430\u043C\u0438!\n\u0422\u0440\u0438\u0447\u0456
      \u0432\u0438\u0457\u0431\u0430\u043D\u0430 (\u0432\u0438\u0457\u0431\u0430\u043D\u0438\u0439)
      \u0411\u043E\u0433\u0438\u043D\u044F\u043C\u0438!\n\u0421\u043E\u043D\u044F\u0447\u043D\u0430
      \u0442\u0456\u0447\u043A\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457!\n\u0417'\u0457\u0431\u0438
      \u0442\u0435\u0431\u0435 \u0441\u043E\u043D\u0446\u0435\u043C!\n\u0412\u0456\u0434\u0441\u043C\u043E\u043A\u0447\u0438
      \u043C\u0435\u043D\u0456 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u0437
      \u043B\u044E\u0431\u043E\u0432'\u044E!\n\u0425\u0442\u0438\u0432\u0456 \u0441\u0442\u043E\u0433\u043E\u043D\u0438
      \u041B\u0443\u043D\u0438!\n\u0417\u0430\u0441\u0443\u043D\u044C \u043C\u0435\u043D\u0456
      \u041B\u0443\u043D\u0430 \u0443 \u043F\u0438\u0437\u0434\u0443 (\u0434\u0443\u043F\u0443)
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F!\n\u0421\u0432\u044F\u0442\u0438\u0439
      \u0433\u0430\u0440\u044F\u0447\u0438\u0439 \u0441\u0435\u043A\u0441 \u0456\u0437
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0454\u044E!\n\n\u0412\u0438\u0441\u043D\u043E\u0432\u043E\u043A:
      \u043D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u043E, \u044F\u043A\u0456
      \u0441\u0430\u043C\u0435 \u043B\u0430\u0439\u043A\u0438 \u0412\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u0435
      \u0456 \u044F\u043A \u0432\u043E\u043D\u0438 \u043E\u0434\u043D\u0430 \u0437
      \u043E\u0434\u043D\u043E\u044E \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044E\u0442\u044C.
      \u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435, \u0449\u043E \u0433\u043E\u043B\u043E\u0432\u043D\u0435
      \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439 \u043B\u0430\u0439\u0446\u0456
      - \u0457\u0457 \u0434\u043E\u0440\u0435\u0447\u043D\u0456\u0441\u0442\u044C.
      \u0417\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0443\u0441\u0432\u0456\u0434\u043E\u043C\u043B\u044E\u0432\u0430\u0442\u0438,
      \u0434\u0435 \u0456 \u043A\u043E\u043B\u0438 \u043C\u043E\u0436\u043D\u0430,
      \u0430 \u0434\u0435 \u0456 \u043A\u043E\u043B\u0438 - \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u043B\u0430\u044F\u0442\u0438\u0441\u044F, \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435
      \u0432\u0430\u043C \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0441\u0432\u043E\u044E
      \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u0456\u0441\u0442\u044C \u0456
      \u043D\u0435 \u0443\u0441\u043B\u0430\u0432\u0438\u0442\u0438\u0441\u044F \u0433\u0440\u0443\u0431\u0456\u044F\u043D\u043E\u043C,
      \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u0441\u0442\u0432\u043E\u0440\u0438\u0432\u0448\u0438
      \u0441\u043E\u0431\u0456 \u043E\u0431\u0440\u0430\u0437 \u0441\u0443\u0432\u043E\u0440\u043E\u0433\u043E
      \u0456 \u0436\u043E\u0440\u0441\u0442\u043A\u043E\u0433\u043E \u043F\u043E\u043D\u0456.
      \u0422\u043E\u043C\u0443 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435 \u0431\u0443\u0434\u0435,
      \u044F\u043A\u0449\u043E \u0412\u0438, \u043F\u0435\u0440\u0448 \u043D\u0456\u0436
      \u043F\u043E\u0447\u0430\u0442\u0438 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438
      \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0456 \u0437 \u0412\u0430\u0448\u043E\u0457
      \u043A\u043D\u0438\u0436\u043A\u0438 \u0437\u043D\u0430\u043D\u043D\u044F,
      \u043E\u0446\u0456\u043D\u0456\u0442\u044C, \u0437\u0430 \u044F\u043A\u0438\u0445
      \u0443\u043C\u043E\u0432 \u0447\u043B\u0435\u043D\u0438 \u0412\u0430\u0448\u043E\u0433\u043E
      \u043A\u043E\u043B\u0435\u043A\u0442\u0438\u0432\u0443 \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C
      \u0437\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0432\u0438\u043B\u0430\u044F\u0442\u0438\u0441\u044F
      \u0456 \u044F\u043A\u0438\u0439 \u0442\u0438\u043F \u043B\u0430\u0439\u043E\u043A
      \u0431\u0443\u0434\u0435 \u0441\u0435\u0440\u0435\u0434 \u043D\u0438\u0445
      \u043D\u0430\u0439\u043F\u043E\u0448\u0438\u0440\u0435\u043D\u0456\u0448\u0438\u043C.
      \u0423\u0441\u043F\u0456\u0445\u0443 \u0412\u0430\u043C \u043D\u0430 \u0446\u0456\u0439
      \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0439, \u0430\u043B\u0435 \u0448\u043B\u044F\u0445\u0435\u0442\u043D\u0456\u0439
      \u043D\u0438\u0432\u0456!\n\n\u0411\u043E\u043D\u0443\u0441\u043D\u0438\u0439
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B. \u0427\u0435\u0441\u043D\u043E
      \u043A\u0430\u0436\u0443\u0447\u0438, \u043A\u043E\u043B\u0438 \u043D\u0430\u0448
      \u043A\u043E\u043B\u0435\u043A\u0442\u0438\u0432 \u0430\u0432\u0442\u043E\u0440\u0456\u0432
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432 \u043D\u0430\u0434 \u0446\u0456\u0454\u044E
      \u043A\u043D\u0438\u0436\u043A\u043E\u044E, \u043C\u0438 \u043D\u0435 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u043B\u0438
      \u0434\u043E\u0434\u0430\u0432\u0430\u0442\u0438 \u044F\u043A\u0438\u0445\u043E\u0441\u044C
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432
      \u043F\u0456\u0441\u043B\u044F \u0457\u0457 \u0443\u043A\u043B\u0430\u0434\u0435\u043D\u043D\u044F.
      \u041E\u0434\u043D\u0430\u043A \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0439
      \u043D\u0438\u0436\u0447\u0435 \u043E\u043F\u0443\u0441, \u0431\u0435\u0437
      \u0441\u0443\u043C\u043D\u0456\u0432\u0443, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u043E\u0431\u043E\u0432'\u044F\u0437\u0430\u043D\u0438\u0439 \u043E\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0446\u0438\u0445 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0430\u0445
      \u0437 \u043E\u0433\u043B\u044F\u0434\u0443 \u043D\u0430 \u0441\u0432\u043E\u044E
      \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u0443 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0432\u0438\u043D\u044F\u0442\u043A\u043E\u0432\u0443 \u0434\u043E\u0440\u0435\u0447\u043D\u0456\u0441\u0442\u044C.
      \u0426\u0435\u0439 \u0442\u0435\u043A\u0441\u0442 \u0431\u0443\u0432 \u043B\u044E\u0431'\u044F\u0437\u043D\u043E
      \u043D\u0430\u0434\u0430\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C
      \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438 \u043D\u0430\u0448\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430, \u044F\u043A\u0438\u0439 \u043F\u043E\u0431\u0430\u0436\u0430\u0432
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F \u043D\u0435\u043D\u0430\u0437\u0432\u0430\u043D\u0438\u043C,
      \u0456 \u044F\u0432\u043B\u044F\u0454 \u0441\u043E\u0431\u043E\u044E \u0434\u043E\u0441\u0442\u0435\u043C\u0435\u043D\u043D\u043E
      \u0437\u0430\u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432\u0430\u043D\u0443
      \u0442\u0438\u0440\u0430\u0434\u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0438\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E\u0433\u043E
      \u0441\u043B\u0443\u0436\u0431\u043E\u0432\u0446\u044F, \u044F\u043A\u0438\u0439
      \u0436\u0438\u0432 \u0437\u0430 \u0431\u0430\u0433\u0430\u0442\u043E \u0441\u0442\u043E\u043B\u0456\u0442\u044C
      \u0434\u043E \u0412\u0456\u0439\u043D\u0438. \u0407\u0457 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E \u043F\u0440\u0438 \u0441\u0432\u043E\u0457\u0445
      \u0437\u043D\u0430\u0447\u043D\u0438\u0445 \u0440\u043E\u0437\u043C\u0456\u0440\u0430\u0445
      \u0456 \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u043C\u0443
      \u0440\u043E\u0437\u043C\u0430\u0457\u0442\u0442\u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0445
      \u0441\u043B\u0456\u0432 \u0432\u043E\u043D\u0430 \u0431\u0443\u043B\u0430
      \u0432\u0438\u0441\u043B\u043E\u0432\u043B\u0435\u043D\u0430 \u0430\u0432\u0442\u043E\u0440\u043E\u043C
      \u0431\u0435\u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438
      \u0456 \u0431\u0435\u0437 \u043C\u0435\u0442\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u0432 \u0456\u0441\u0442\u043E\u0440\u0456\u044E, \u0430 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043B\u0438\u0448\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431
      \u0432\u0438\u0447\u0438\u0442\u0430\u0442\u0438 \u0437\u0430\u0441\u043D\u0443\u043B\u043E\u0433\u043E
      \u043D\u0430 \u043F\u043E\u0441\u0442\u0443 \u043A\u043E\u0440\u043E\u043B\u0456\u0432\u0441\u044C\u043A\u043E\u0433\u043E
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430. \u0417\u0443\u0441\u0438\u043B\u043B\u044F\u043C\u0438
      \u0430\u0434'\u044E\u0442\u0430\u043D\u0442\u0430 \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0438
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457, \u044F\u043A\u0438\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0432 \u043F\u043E\u0432\u0437,
      \u0446\u0435\u0439 \u0435\u043A\u0441\u043F\u0440\u043E\u043C\u0442 \u0431\u0443\u043B\u043E
      \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E \u0456 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u0432 \u043F\u0435\u0440\u0432\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u043C\u0443
      \u0432\u0438\u0433\u043B\u044F\u0434\u0456, \u0456 \u0442\u0435\u043F\u0435\u0440,
      \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0443
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u0441\u0442\u0430\u0440\u0456\u043B\u0438\u0445 \u0441\u043B\u0456\u0432,
      \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E, \u0454 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C
      \u043D\u0435\u043F\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0435\u043D\u043E\u0457
      \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u043E\u0441\u0442\u0456 \u0432
      \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u0456 \u0431\u0440\u0443\u0434\u043D\u043E\u0457,
      \u0430\u043B\u0435 \u0442\u0430\u043A\u043E\u0457 \u0431\u0430\u0440\u0432\u0438\u0441\u0442\u043E\u0457
      \u0439 \u0447\u0443\u0434\u043E\u0432\u043E\u0457 \u043B\u0430\u0439\u043A\u0438
      (\u0456 \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u043E\u0457 \u0441\u0438\u043B\u0438
      \u043B\u0435\u0433\u0435\u043D\u0456\u0432). \u0412\u0441\u044E \u0441\u0442\u0430\u0440\u043E\u043D\u0438\u043D\u043D\u0443
      \u043B\u0435\u043A\u0441\u0438\u043A\u0443 \u0442\u0430 \u0433\u0440\u0430\u043C\u0430\u0442\u0438\u043A\u0443
      \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E.\n\n\u0401\u0431\u0430\u043D\u044B\u0439
      \u0432 \u0440\u044B\u043B\u043E, \u0442\u043E\u043A\u043C\u043E \u0432 \u0436\u043E\u043F\u0443,
      \u0432 \u0421\u0435\u043B\u0435\u0441\u0442\u0438\u0438 \u0434\u0443\u0448\u0443
      \u043C\u0430\u0442\u044C, \u0431\u043B\u044F\u0434\u044F\u043C\u0438 \u0432\u044B\u0441\u0446\u0430\u043D\u044B\u0439,
      \u0437\u0430\u0441\u0440\u0430\u043D\u044B\u0439 \u0445\u0443\u0435\u0434\u0430\u0432
      \u0433\u0440\u0438\u0444\u043E\u043D\u0438\u0439, \u043F\u0438\u0437\u0434\u044E\u043A
      \u0431\u043B\u043E\u0448\u0438\u043D\u044B\u0439, \u0437\u0430\u043B\u0443\u043F\u043E\u043B\u0438\u0437
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0435\u0431\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043D\u0435\u0434\u043E\u0435\u0431\u043E\u043A, \u043D\u0430\u0437\u0430\u0434
      \u0432 \u043F\u0438\u0437\u0434\u0443 \u0437\u0430\u0441\u0443\u043D\u0443\u0442\u044B\u0439,
      \u0445\u0443\u0435\u0433 \u0441\u0445\u0443\u0451\u0436\u0435\u043D\u043D\u044B\u0439,
      \u0434\u0435\u0440\u0437\u0430\u044E\u0449\u0438\u0439 \u043F\u0438\u0437\u0434\u0438\u043D\u043E\u0439
      \u0437\u044F\u043F\u044B, \u0436\u043E\u043F\u043E\u0441\u0435\u0440 \u043F\u0435\u0440\u0435\u043F\u0438\u0437\u0434\u044E\u0445\u0430\u043D\u043D\u044B\u0439,
      \u0435\u043B\u0434\u0438\u0449\u0435 \u043F\u0438\u0437\u0434\u043E\u0441\u0442\u0440\u0435\u043C\u043B\u0438\u0432\u043E\u0435,
      \u0441\u043E\u043F\u043B\u0438\u0432\u044B\u0439 \u0451\u0431\u0430\u0440\u044C,
      \u043E\u0441\u043B\u043E\u0432\u0438\u0439 \u0437\u0430\u043B\u0443\u043F\u0435\u043D\u0435\u0446,
      \u043F\u0438\u0437\u0434\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0442\u0435\u043B\u044C,
      \u0435\u0431\u0430\u043D\u044B\u0445 \u0442\u0440\u0435\u0431\u0443\u0445 \u0441
      \u0445\u0443\u0435\u043C \u0432\u043E \u043B\u0431\u0443, \u043F\u0438\u0437\u0434\u043E\u0435\u0431\u043B\u0438\u0432\u0430\u044F
      \u0441\u043A\u043E\u0442\u0438\u043D\u0430, \u0431\u043B\u044F\u0434\u043D\u043E\u0442\u0430
      \u043F\u0438\u0437\u0434\u043E\u0431\u0440\u044E\u0445\u043E\u0439 \u043C\u0430\u043D\u0434\u0438\u043B\u0438\u0449\u0438
      \u0437\u0430\u0442\u044B\u0447\u043A\u0430, \u043F\u0438\u0437\u0434\u043E\u0442\u0451\u0440\u044B\u0439
      \u043C\u0443\u0434\u043E\u0437\u0432\u043E\u043D, \u0445\u0443\u044F\u043B\u044F\u0433\u0430
      \u043F\u0438\u0437\u0434\u043E\u0434\u0440\u0430\u0447\u0435\u043D\u0430\u044F,
      \u043F\u043E\u0434\u0445\u0432\u043E\u0441\u0442\u0438\u0435 \u0447\u0435\u0439\u043D\u0434\u0436\u043B\u0438\u043D\u0433\u043E\u0432\u043E,
      \u043A\u0443\u0440\u0432\u0435\u043D\u043D\u044B\u0439 \u0434\u043E\u043B\u0434\u043E\u043D,
      \u043F\u0438\u0437\u0434\u043E\u043D\u043E\u0437\u0434\u0440\u044F \u0434\u043E
      \u043A\u0438\u0448\u043E\u043A \u043F\u043E\u0440\u043E\u0442\u0430\u044F,
      \u0422\u0438\u0440\u0435\u043A\u043E\u0432\u0430 \u0435\u043B\u0434\u0430,
      \u043C\u0430\u0445\u043E\u043D\u044F \u0448\u0435\u043B\u0443\u0434\u0438\u0432\u0430\u044F,
      \u0441\u0443\u0440\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u0437\u043B\u043E\u0451\u0431\u0438\u043D\u0430,
      \u0448\u0435\u043D\u0442\u044F \u0437\u0430\u0442\u0451\u0440\u0442\u0430\u044F,
      \u0421\u0442\u0430\u0440\u0441\u0432\u0438\u0440\u043B\u043E\u0432\u0430 \u0436\u0435\u0440\u0434\u0438\u043D\u0430,
      \u043F\u0438\u0437\u0434\u044F\u0447\u0438\u043D\u0430 \u0445\u0443\u0435\u0440\u044B\u043B\u044C\u043D\u0430\u044F,
      \u0445\u0443\u0438\u0434\u043B\u043E \u0432 \u0448\u0443\u0442\u043E\u0432\u043E\u043C
      \u0441\u0430\u0440\u0430\u0444\u0430\u043D\u0435, \u044F\u0431\u043D\u043E
      \u043E\u0441\u043A\u043B\u0438\u0437\u043A\u043E\u0435, \u043F\u0438\u0437\u0434\u0438\u043B\u0438\u0449\u0430
      \u0430\u0441\u0441\u0435\u0441\u043E\u0440, \u0432\u043E\u043B\u043E\u043C
      \u0440\u0430\u0437\u044A\u0451\u0431\u0430\u043D\u043D\u044B\u0439 \u0445\u0443\u044F\u0445\u0430
      \u043D\u0435\u043F\u043E\u0442\u0440\u0435\u0431\u043D\u044B\u0439, \u043F\u0438\u0437\u0434\u044B
      \u043F\u0440\u043E\u0451\u0431\u0430\u043D\u043D\u043E\u0439 \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u0430\u0434\u043C\u0438\u0440\u0430\u043B, \u0430\u0440\u0430\u0431\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0446\u0430\u0440\u044F \u0445\u0443\u0438\u043B\u0438\u0449\u0435, \u043F\u0438\u0437\u0434\u043E\u043C\u043E\u0442\u0438\u043D\u0430
      \u0445\u0443\u0438\u0441\u0442\u0430\u044F, \u043A\u043B\u043E\u043F\u043E\u0432\u0441\u043A\u0430\u044F
      \u0448\u0435\u043B\u0443\u043F\u0438\u043D\u0430, \u043E\u0442\u0448\u043C\u0430\u0440\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0448\u044C, \u0435\u043B\u0443\u043F\u0435\u043D\u044C \u043F\u0438\u0437\u0434\u044B
      \u0437\u0435\u0431\u0440\u0438\u043D\u043E\u0439, \u043F\u0430\u0440\u0430\u0441\u043F\u0440\u0430\u0439\u0442\u0430
      \u0448\u0438\u0448\u043A\u0430 \u0437\u0435\u043B\u043E \u0440\u0430\u0437\u0434\u0443\u0442\u0430\u044F,
      \u0433\u0438\u0434\u0440\u044B \u0437\u0430\u043C\u043E\u0440\u0441\u043A\u043E\u0439
      \u0435\u0431\u043B\u0438\u0432\u0430\u044F \u0437\u0430\u043B\u0443\u043F\u0430,
      \u0445\u0443\u0438\u043B\u043E \u0433\u043B\u044B\u0431\u043E\u0435\u0431\u043B\u0438\u0432\u043E\u0435,
      \u043F\u0438\u0437\u0434\u043E\u043C\u0430\u0445\u0430\u043B\u043E\u0432\u043E
      \u0445\u0443\u0435\u0432\u043E\u0442\u0430\u0440\u0430\u043A\u0430\u043D\u0435\u0432\u043E,
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0451\u0431\u044B\u0439 \u043F\u0438\u0437\u0434\u043E\u0433\u0440\u044B\u0437,
      \u0445\u0443\u044E\u0433\u0430 \u043D\u0435\u0434\u043E\u043C\u0435\u0440\u043E\u043A
      \u043E\u0442\u0441\u0430\u043D\u0434\u0430\u043B\u0435\u043D\u043D\u044B\u0439,
      \u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B\u0439 \u0440\u0430\u043A\u043E\u043C
      \u043F\u0438\u0437\u0434\u043E\u0441\u043E\u0441, \u043F\u0440\u0438\u0431\u0438\u0442\u044B\u0439
      \u0440\u0430\u0432\u043D\u043E\u0439 \u0442\u0438\u0442\u044C\u043A\u043E\u044E,
      \u043A\u0443\u0440\u043E\u0451\u0431, \u043F\u0438\u0437\u0434\u043E\u0432\u044B\u0439
      \u0445\u0443\u0435\u0431\u0443\u043D, \u043F\u0438\u0437\u0434\u043E\u0433\u0443\u043D\u0434\u043B\u0438\u0432\u044B\u0439
      \u0435\u0440\u044B\u0433\u0430 \u043F\u043E\u0434\u0447\u0435\u0440\u0435\u0432\u043E\u0447\u043D\u044B\u0439,
      \u043A\u043B\u0435\u043F\u0430\u043D\u044B\u0439 \u0441\u0438\u043D\u044E\u0448\u043D\u044B\u043C
      \u0445\u0443\u0435\u0440\u043E\u043B\u043E\u043C\u043E\u043C \u0435\u0431\u0430\u043F\u0438\u0440\u0430
      \u043F\u0438\u0437\u0434\u043E\u043A\u0432\u0430\u0448\u043D\u0438 \u0431\u0440\u044E\u0445\u0430\u0442\u043E\u0439,
      \u043F\u0438\u0437\u0434\u0430\u0448 \u0434\u043E\u043B\u0431\u0430\u043D\u043D\u044B\u0439,
      \u043F\u0440\u0438 \u0441\u0435\u043C \u043A\u043E\u043F\u044B\u0442\u043D\u0430\u044F
      \u0445\u0443\u044F\u043A\u0430, \u043F\u0438\u0437\u0434\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C
      \u0441\u0443\u0447\u0438\u0439, \u0431\u043B\u044F\u0434\u0441\u043A\u0438\u0439
      \u0441\u044B\u043D \u043C\u043E\u0445\u043D\u0430\u0442\u044B\u044F \u043D\u043E\u0440\u044B
      \u043E\u0431\u043C\u043E\u043A\u043D\u0443\u0442\u0430\u044F \u043F\u043B\u0435\u0448\u044C
      \u0445\u0443\u044F\u0447\u044C\u044F, \u043F\u0438\u0437\u0434\u043E\u0431\u0443\u0437\u0438\u043D\u0430
      \u0437\u0430\u0449\u0435\u043C\u043B\u0435\u043D\u043D\u0430\u044F, \u0445\u0443\u0435\u0437\u0430\u0433\u043D\u0443\u0442\u0438\u0435
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u043E\u0432\u043E, \u043F\u0438\u0437\u0434\u0430\u043B\u043E\u043D
      \u0445\u0443\u0435\u0431\u0430\u0440\u043D\u044B\u0439, \u0443\u0440\u044B\u043B\u044C\u043D\u0438\u043A
      \u043F\u0438\u0437\u0434\u043E\u0442\u0440\u0435\u0441\u043A\u0443\u0447\u0438\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0432\u043E\u0440\u043E\u0442 \u0437\u0430\u0445\u0443\u044F\u0447\u0435\u043D\u043D\u044B\u0439,
      \u0432\u043E\u0440\u043E\u043F\u0435\u043D\u044C \u043F\u0438\u0437\u0434\u0430\u043A\u043D\u0443\u0442\u044B\u0439,
      \u043E\u0445\u043B\u0443\u0435\u0431\u0435\u043D\u044C \u0437\u0430\u043F\u0438\u0437\u0434\u0430\u0434\u0443\u0440\u0438\u043D\u0430\u044F,
      \u0434\u0443\u0440\u0430\u043F\u0438\u0437\u0434\u0438\u044F \u0431\u0435\u0437\u0440\u0430\u0437\u043C\u0435\u0440\u043D\u0430\u044F,
      \u0445\u0443\u044F\u0440\u0435\u0437 \u043C\u0430\u043D\u0434\u0430\u0432\u043E\u0448\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u0430\u0441\u0435\u0440 \u0431\u0435\u0437\u0436\u043E\u043F\u044B\u0439,
      \u0436\u043E\u043F\u043E\u043B\u0438\u0437 \u043F\u0438\u0437\u0434\u0430\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439,
      \u0434\u043E\u043B\u0431\u043E\u0435\u0431\u0430\u0442\u0438\u043D\u0430 \u0438\u043D\u043E\u0437\u0435\u043C\u043D\u0430\u044F,
      \u043F\u0438\u0437\u0434\u0443\u043B\u0438\u044F \u0437\u0430\u0448\u0442\u043E\u043F\u0430\u043D\u043D\u0430\u044F,
      \u043F\u0438\u0437\u0434\u043E\u0441\u043A\u0430\u043B \u0451\u0431\u0430\u043D\u044B\u0439
      \u0441\u0442\u0430\u0434\u043E\u043C, \u043A\u043B\u043E\u043F\u043E\u0432\u044B\u0451\u0431\u0438\u0441\u0442\u044B\u0439
      \u0443\u0431\u043B\u044E\u0434\u043E\u0451\u0431, \u043F\u0438\u0437\u0434\u043E\u0433\u043B\u0438\u0441\u0442,
      \u0432 \u0436\u043E\u043F\u0435 \u0437\u0430\u0447\u0430\u0442\u044B\u0439,
      \u0431\u0435\u0437\u043C\u0443\u0434\u043E\u0432\u044B\u0439 \u043F\u0440\u0438\u0431\u043E\u0440,
      \u043F\u0438\u0437\u0434\u043E\u043B\u0438\u0437 \u0448\u043F\u043E\u043A\u043D\u0443\u0442\u044B\u0439,
      \u0445\u0443\u044F\u043C\u0438 \u0440\u0430\u0441\u043F\u0438\u0441\u043D\u043E\u0439,
      \u0432\u043E\u043D\u0434\u0435\u0440\u0431\u043E\u043B\u0442\u0441\u043A\u0438\u043C
      \u043A\u0443\u0441\u043A\u043E\u043C \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439,
      \u043F\u0440\u043E\u043B\u0443\u0431\u043A\u0430 \u043F\u0438\u0437\u0434\u043E\u0431\u0435\u0437\u0434\u043E\u043D\u043D\u0430\u044F,
      \u043F\u0438\u0437\u0434\u0435\u043D\u044C \u043D\u0430\u043F\u0438\u0445\u0430\u043D\u043D\u0430\u044F,
      \u043F\u0438\u0437\u0434\u043E\u0434\u0440\u0430\u0447\u0438\u043B\u044C\u043D\u0438\u043A
      \u043D\u0430 \u0445\u0435\u0440 \u0432\u0437\u0434\u0435\u0442\u044B\u0439,
      \u0431\u043B\u0443\u0434 \u043A\u0443\u0440\u0432\u044F\u0436\u043D\u044B\u0439,
      \u0440\u0430\u0437\u044A\u0451\u0431\u0430 \u0442\u0451\u0440\u0442\u0430\u044F
      \u043A\u043E\u043F\u044B\u0442\u043E\u043C, \u0435\u0431\u0443\u043D\u0438\u0449\u0435
      \u043C\u0443\u0434\u0438\u0441\u0442\u043E\u0435, \u043F\u0438\u0437\u0434\u044F\u0442\u0438\u043D\u0430
      \u0437\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u0430\u044F, \u0441\u0442\u0443\u043C\u0435\u043D\u0442
      \u043F\u043E\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439, \u043C\u043E\u043D\u0434\u0430\u0432\u043E\u0448\u044C
      \u0435\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430, \u0433\u043D\u043E\u0431\u0438\u043B\u0438\u0449\u0435
      \u0440\u0430\u0437\u044A\u0451\u0431\u0430\u043D\u043D\u043E\u0435 \u0434\u043E
      \u043F\u0435\u0447\u0435\u043D\u043E\u043A, \u043A\u0438\u043B\u0430 \u043C\u0443\u0434\u0430\u0445\u0430\u043D\u043D\u0430\u044F,
      \u044F\u043B\u0434\u0430\u043A \u0445\u0443\u0451\u0432\u0438\u0449\u043D\u044B\u0439,
      \u0431\u0440\u0438\u0442\u043E\u0439 \u043F\u0438\u0437\u0434\u043E\u0434\u044B\u0440\u0438\u0449\u0438
      \u0432\u043E\u0437\u0434\u044B\u0445\u0430\u0442\u0435\u043B\u044C, \u043C\u0443\u0434\u043E\u0440\u0432\u0430\u043D\u0435\u0439
      \u0448\u0435\u0440\u0448\u0430\u0432\u044B\u0439 \u0437\u0430\u0441\u043E\u043D\u0434\u0440\u044F\u0447\u0435\u043D\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0432\u044B\u0434\u043B\u043E \u0445\u0443\u044E\u043B\u044C\u0441\u043A\u043E\u0435,
      \u043F\u0438\u0437\u0434\u043E\u043A\u043E\u043F\u0430\u0442\u0435\u043B\u044C
      \u0414\u0438\u0441\u043A\u043E\u0440\u0434\u043E\u0432, \u043F\u0438\u0437\u0434\u043E\u0436\u043E\u043F
      \u043F\u0438\u0437\u0434\u043E\u0445\u0430\u0439\u043B\u043E\u0432\u044B\u0439,
      \u043C\u044D\u0440\u043E\u0432 \u0445\u0443\u0435\u043E\u0433\u043B\u043E\u0431\u0435\u043B\u044C,
      \u043F\u0438\u0437\u0434\u0435\u043D\u0435\u044F \u043F\u0438\u0437\u0434\u043E\u043B\u0435\u0442\u043D\u0430\u044F,
      \u043F\u0438\u0437\u0434\u043E\u044F\u043C\u0438\u043D\u0430 \u0432\u043F\u043E\u043F\u0435\u0440\u0435\u043A
      \u0434\u0440\u0430\u043D\u043E\u0435\u0431\u043B\u0438\u0432\u0430\u044F, \u0432\u043E\u0441\u043C\u044C\u0438\u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F
      \u0445\u0443\u044E\u043B\u0430, \u0431\u043B\u0443\u0434\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0449\u0435
      \u0440\u0430\u0441\u043A\u043E\u0440\u044F\u0447\u0435\u043D\u043D\u043E\u0435,
      \u0432\u0435\u0440\u0442\u043E\u0445\u0443\u0439 \u043F\u0438\u0437\u0434\u043E\u043C\u0430\u0437\u0434\u043B\u0438\u0432\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0442\u043E\u043B\u043A\u043E\u0432\u0438\u0449\u0430
      \u043A\u0430\u043D\u0446\u043B\u0435\u0440, \u043F\u0438\u0437\u0434\u044B
      \u0437\u0430\u043C\u0448\u0435\u043B\u043E\u0439 \u0432\u0435\u0440\u0442\u043E\u043F\u043B\u044F\u0441,
      \u043D\u0430 \u0440\u043E\u0433 \u0441 \u044F\u0439\u0446\u0430\u043C\u0438
      \u0432\u0437\u043E\u0442\u043A\u043D\u0443\u0442\u044B\u0439, \u043F\u0438\u0437\u0434\u044B\u0440\u044C
      \u0431\u0443\u0440\u0434\u0430\u0441\u0442\u0430\u044F, \u041B\u0443\u043D\u0430
      \u0440\u0430\u0437\u0434\u0435\u0440\u0442\u044B\u044F \u043F\u0438\u0437\u0434\u0430\u0432\u043B\u0435\u0442\u0438\u043D\u044B,
      \u043F\u0438\u0437\u0434\u043E\u0433\u043B\u0430\u0437\u0430\u044F \u043A\u043E\u0440\u043E\u0441\u0442\u043E\u0435\u0431\u0438\u043D\u0430,
      \u043F\u0438\u0437\u0434\u043E\u0447\u0435\u0442 \u0445\u0443\u0435\u0437\u0434\u043E\u0432\u0430\u0442\u044B\u0439,
      \u0445\u0443\u0435\u0432\u043E\u0440\u043E\u0442 \u043F\u0438\u0437\u0434\u043E\u0442\u044B\u0440\u0435\u043D\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0441\u0435\u0440\u0431\u0430\u043B\u043E \u0445\u0443\u0435\u0442\u0435\u0440\u0442\u043E\u0435,
      \u043F\u0438\u0437\u0434\u043E\u0445\u043E\u0447\u044C \u0445\u0443\u0435\u0431\u044B\u0434\u043B\u043E\u0432\u044B\u0439,
      \u0445\u0443\u0435\u0431\u0443\u0440 \u043F\u0438\u0437\u0434\u0443\u044F\u043D\u0438\u0441\u0442\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0441\u043E\u0432 \u043F\u0438\u0437\u0434\u043E\u043F\u0440\u043E\u043B\u0430\u0437\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u0432\u0435\u0440\u0437\u0438\u043B\u0438\u0449\u0435
      \u043A\u0443\u043A\u0443\u0439\u0441\u043A\u043E\u0435, \u0448\u0430\u043B\u0431\u0435\u0440
      \u043F\u0438\u0437\u0434\u043E\u0432\u0430\u0440\u043D\u0430\u043A\u043E\u0432\u044B\u0439,
      \u0430\u0441\u043F\u0438\u0434 \u043F\u0438\u0437\u0434\u043E\u0430\u043B\u043B\u044E\u0440\u0435\u043D\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u044E\u0448\u043A\u0438 \u043F\u043E\u043F\u0435\u0447\u0438\u0442\u0435\u043B\u044C,
      \u043F\u0438\u0437\u0434\u043E\u0434\u0440\u0430\u0447\u043B\u0438\u0432\u0438\u0449\u0435
      \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0435, \u0434\u0432\u0443\u0433\u043E\u043B\u043E\u0432\u043E\u0435
      \u0445\u0443\u0438\u043B\u043E \u0433\u0435\u0440\u0431\u043E\u0432\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u0438, \u043F\u0438\u0437\u0434\u043E\u0448\u0435\u0432\u043A\u0430
      \u0440\u0430\u0437\u0434\u0435\u0440\u0442\u0430\u044F \u0434\u043E \u043F\u0443\u043F\u0430,
      \u0431\u0435\u0441\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u044B\u0439 \u0431\u043B\u0443\u0434\u043E\u0434\u0435\u0439,
      \u0441\u0442\u0435\u0440\u0432\u0438\u043D\u0430\u044F \u043F\u0438\u0437\u0434\u043E\u043B\u043E\u043C\u0438\u043D\u0430,
      \u043C\u0435\u0434\u0432\u0435\u0434\u0451\u043C \u043A\u043E\u0440\u044F\u0431\u0430\u043D\u043D\u0430\u044F,
      \u043F\u0435\u0433\u0430\u0441\u0430 \u0432\u0437\u0434\u0443\u0442\u044B\u0439
      \u0431\u0435\u0439\u0431\u0430\u0441, \u0430\u0441\u043F\u0438\u0434 \u043F\u0438\u0437\u0434\u0438\u043B\u0438\u0449\u043D\u044B\u0439,
      \u0445\u0443\u0435\u043B\u043E\u0432\u0438\u0446\u0430 \u043F\u0438\u0437\u0434\u043E\u043F\u0435\u0440\u0442\u0430\u044F,
      \u0445\u0443\u0435\u0432\u0435\u0440\u0437\u043E\u0445\u0430 \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u043A\u0430\u044F
      \u043F\u0438\u0437\u0434\u043E\u0431\u0435\u0441\u0438\u043D\u044B, \u043F\u0438\u0437\u0434\u043E\u0434\u044B\u0440\u044F\u0432\u0438\u043D\u0430,
      \u043F\u0438\u0437\u0434\u043E\u0436\u0430\u043B \u0431\u0430\u0440\u0434\u0430\u0448\u043D\u044B\u0439,
      \u043F\u0438\u0437\u0434\u043E\u043E\u0431\u0440\u0435\u0437 \u043A\u0438\u0440\u0438\u043D\u0441\u043A\u0438\u0439,
      \u0431\u043B\u0443\u0434\u043E\u0434\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0437\u0434\u043E\u043A\u0430\u0447,
      \u0431\u043B\u0443\u0434\u0443\u0433\u043E\u043D\u0438\u0449\u0435 \u043D\u0435\u043D\u0430\u0441\u044B\u0442\u043D\u043E\u0435,
      \u0432\u0441\u0445\u0443\u044F\u0440\u0435\u043D\u043D\u0430\u044F \u041A\u0440\u0438\u0437\u0430\u043B\u0438\u0441,
      \u0440\u0430\u0441\u043F\u0438\u0437\u0434\u044E\u043B\u044F\u0447\u0435\u043D\u043D\u044B\u0439
      \u043F\u0438\u0437\u0434\u043E\u0441\u0435\u0439, \u0445\u0443\u0435\u0431\u043B\u044F\u0434\u0441\u043A\u0438\u0439
      \u0448\u0438\u0448, \u043F\u0435\u0440\u0435\u043F\u0438\u0437\u0434\u0440\u044E\u0447\u0435\u043D\u043D\u044B\u0439
      \u0444\u0438\u043B\u043B\u0438\u0434\u0435\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u0438\u0439
      \u043F\u0438\u0437\u0434\u043E\u0434\u0435\u0440\u0436\u0435\u0446, \u043C\u0435\u0439\u043D\u0445\u044D\u0442\u0442\u0435\u043D\u0441\u043A\u0438\u0439
      \u043F\u0438\u0437\u0434\u043E\u0437\u043E\u043B\u043E\u0442\u0430\u0440\u044C,
      \u043F\u0438\u0437\u0434\u043E\u043D\u043E\u0433\u0430\u044F \u0431\u043B\u044F\u0434\u0435\u0432\u0438\u043D\u0430
      \u0435\u0431\u0438 \u0442\u0435\u0431\u044F \u0432\u0441\u0435\u043C \u0442\u0430\u0431\u0443\u043D\u043E\u043C
      \u0434\u043E \u0441\u0435\u043B\u0435\u0437\u0435\u043D\u043E\u043A \u0438
      \u0442\u0430\u043A, \u0438 \u0440\u0430\u0437 \u044D\u0434\u0430\u043A, \u0438
      \u0445\u0443\u0451\u043C, \u0438 \u0434\u0443\u0431\u044C\u0451\u043C \u0434\u043E
      \u0433\u043B\u043E\u0442\u043A\u0438, \u0438 \u0441\u0430\u043F\u043E\u0433\u043E\u043C,
      \u0438 \u043F\u043E\u0434 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u0439,
      \u0438 \u0432 \u0441\u0440\u0430\u043B\u044C\u043D\u0435, \u0438 \u0430\u043B\u043C\u0430\u0437\u043D\u044B\u043C\u0438
      \u043F\u0441\u0430\u043C\u0438, \u0438 \u0441\u0442\u0440\u0430\u0436\u0435\u044E.\n|*\u041F\u043E\u0434\u0430\u043B\u044C\u0448\u0456
      \u0440\u043E\u0437\u0434\u0456\u043B\u0438 \u043C\u0456\u0441\u0442\u044F\u0442\u044C
      \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0438 \u043B\u0430\u0439\u043A\u0438
      \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0433\u0440\u0443\u0431\u043E\u0457
      \u0456 \u043D\u0435\u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E\u0457,
      \u0449\u043E \u043D\u0430\u0432\u0456\u0442\u044C \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0438\u0439
      \u0440\u0435\u0439\u0434\u0435\u0440 \u0437\u043C\u0456\u0433 \u0431\u0438
      \u0437\u0431\u0430\u0433\u0430\u0442\u0438\u0442\u0438 \u0441\u0432\u0456\u0439
      \u0441\u043B\u043E\u0432\u043D\u0438\u043A\u043E\u0432\u0438\u0439 \u0437\u0430\u043F\u0430\u0441
      \u043D\u0435 \u043E\u0434\u043D\u0456\u0454\u044E \u043D\u043E\u0432\u043E\u044E
      \u0444\u0440\u0430\u0437\u043E\u0447\u043A\u043E\u044E*."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018185
    m_Localized: "\u0425\u0430\u0440\u0434\u043A\u043E\u0440\u043D\u0430 \u0437\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018186
    m_Localized: "\u0423\u0432\u0430\u0433\u0430! \u0412\u0438 \u0432\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432 \u0445\u0430\u0440\u0434\u043A\u043E\u0440\u043D\u0443 \u0437\u043E\u043D\u0443.
      \u0422\u0443\u0442 \u0432\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0431\u0443\u0434\u0435 \u0432\u0438\u0436\u0438\u0432\u0430\u0442\u0438 \u0431\u0435\u0437
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0438\u0445 \u0442\u043E\u0447\u043E\u043A,
      \u0431\u0435\u0437 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F
      \u043D\u0430 \u0431\u0430\u0437\u0443, \u0431\u0435\u0437 \u043F\u043E\u0441\u043B\u0443\u0433
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432 \u0456 \u043B\u0456\u043A\u0430\u0440\u044F.
      \u041F\u0435\u0440\u0435\u0434 \u0442\u0438\u043C, \u044F\u043A \u0456\u0442\u0438
      \u0434\u0430\u043B\u0456, \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E \u0432\u0438 \u0433\u043E\u0442\u043E\u0432\u0456, \u043C\u0430\u0454\u0442\u0435
      \u0445\u043E\u0440\u043E\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F,
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432, \u043C\u0435\u0434\u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0456\u0432
      \u0456 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438 \u0434\u043B\u044F
      \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0438\u0445 \u0434\u0432\u0435\u0440\u0435\u0439,
      \u0430 \u0432\u0430\u0448\u0435 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F
      \u0432\u0456\u0434\u0440\u0435\u043C\u043E\u043D\u0442\u043E\u0432\u0430\u043D\u0435
      \u0456 \u0433\u043E\u0442\u043E\u0432\u0435 \u0434\u043E \u0431\u043E\u044E.
      \u0414\u043B\u044F \u0432\u0445\u043E\u0434\u0443 \u0432\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0430
      \u0431\u043E\u043C\u0431\u0430. \u041E\u0434\u043D\u0430 \u0431\u043E\u043C\u0431\u0430
      \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454 \u0432\u0445\u0456\u0434
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0434\u0438\u043D \u0440\u0430\u0437.
      \u042F\u043A\u0449\u043E \u0432\u0438 \u0437\u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0456\u0454\u0442\u0435
      \u0430\u0431\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0442\u0435\u0441\u044F
      \u043D\u0430 \u0431\u0430\u0437\u0443, \u0442\u043E \u0432\u0445\u0456\u0434
      \u0432\u0438\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u043C,
      \u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u0434\u0435
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0442\u0438 \u0449\u0435 \u043E\u0434\u043D\u0443
      \u0431\u043E\u043C\u0431\u0443. \u041F\u0440\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0434\u043E \u043A\u0456\u043D\u0446\u044F \u043C\u043E\u0436\u0435 \u0442\u0440\u0438\u0432\u0430\u0442\u0438
      \u043F\u043E\u043D\u0430\u0434 \u0433\u043E\u0434\u0438\u043D\u0443. \u0406
      \u0445\u043E\u0447\u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0456 \u0440\u0435\u0447\u0456
      \u0442\u0430 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0438\u0439 \u0434\u043E\u0441\u0432\u0456\u0434
      \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u044C\u0441\u044F, \u043F\u0440\u043E\u0433\u0440\u0435\u0441
      \u043F\u0440\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F!
      \u041C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0438
      \u0446\u044E \u0437\u043E\u043D\u0443 \u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E \u0440\u0430\u0437\u0456\u0432,
      \u0430\u043B\u0435 \u0449\u043E\u0440\u0430\u0437\u0443 \u0437 \u043F\u043E\u0447\u0430\u0442\u043A\u0443.
      \u0412 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u043A\u0456\u043C\u043D\u0430\u0442\u0456
      \u043D\u0430 \u0432\u0430\u0441 \u0447\u0435\u043A\u0430\u044E\u0442\u044C
      \u0446\u0456\u043D\u043D\u0456 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0438.
      \u0423\u0434\u0430\u0447\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018187
    m_Localized: "\u0413\u0443\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018188
    m_Localized: "\u0413\u0443\u043B\u0456. \u0423\u043F\u0435\u0440\u0448\u0435
      \u044F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u0433\u0443\u043B\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0438\u0436\u0434\u0435\u043D\u044C \u043F\u0456\u0441\u043B\u044F
      \u0432\u0442\u0440\u0430\u0442\u0438 \u043F\u0430\u043C'\u044F\u0442\u0456.
      \u042F\u043A\u0449\u043E \u0447\u0435\u0441\u043D\u043E, \u044F \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430, \u0449\u043E
      \u0431\u0430\u0447\u0443: \u0436\u0430\u0445\u043B\u0438\u0432\u043E\u0433\u043E
      \u0432\u0438\u0433\u043B\u044F\u0434\u0443 \u043F\u043E\u043D\u0456 \u043F\u043E\u043C\u0447\u0430\u0432
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430 \u043C\u0435\u043D\u0435,
      \u0434\u0438\u043A\u043E \u0433\u0430\u0440\u0447\u0430\u0447\u0438. \u042F
      \u043B\u0435\u0434\u044C \u0432\u0441\u0442\u0438\u0433\u043B\u0430 \u0432\u0442\u0435\u043A\u0442\u0438.
      \u0422\u043E\u0434\u0456 \u044F \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430,
      \u0449\u043E \u0432\u0456\u043D \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u0432\u043E\u0440\u0438\u0439
      \u043D\u0430 \u0434\u0438\u0432\u043D\u0443 \u0445\u0432\u043E\u0440\u043E\u0431\u0443.
      \u041E\u0434\u043D\u0430\u043A \u0449\u0435 \u0447\u0435\u0440\u0435\u0437
      \u043F\u0430\u0440\u0443 \u0434\u043D\u0456\u0432 \u0443 \u043C\u0435\u043D\u0435
      \u0437'\u044F\u0432\u0438\u043B\u0430\u0441\u044F \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0440\u043E\u0437\u0433\u043B\u0435\u0434\u0456\u0442\u0438 \u0446\u0438\u0445
      \u0456\u0441\u0442\u043E\u0442 \u0431\u043B\u0438\u0436\u0447\u0435. \u042F
      \u0431\u0443\u043B\u0430 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443
      \u043F\u043E\u0432\u0435\u0440\u0441\u0456 \u0441\u0442\u0430\u0440\u043E\u0457
      \u0431\u0443\u0434\u0456\u0432\u043B\u0456, \u0456 \u0432 \u043E\u0434\u043D\u0456\u0439
      \u0437 \u0457\u0457 \u043A\u0456\u043C\u043D\u0430\u0442 \u0431\u0443\u043B\u0430
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0430 \u0434\u0456\u0440\u0430
      \u0432 \u043F\u0456\u0434\u043B\u043E\u0437\u0456 \u043D\u0430 \u043F\u0435\u0440\u0448\u0438\u0439
      \u043F\u043E\u0432\u0435\u0440\u0445. \u0406 \u043D\u0430 \u043D\u0438\u0436\u043D\u044C\u043E\u043C\u0443
      \u043F\u043E\u0432\u0435\u0440\u0441\u0456 \u044F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430
      \u0434\u0432\u043E\u0445 \u0456\u0437 \u043D\u0438\u0445. \u042F \u0442\u0438\u0445\u043E
      \u043F\u0456\u0434\u043A\u0440\u0430\u043B\u0430\u0441\u044F \u0434\u043E \u043A\u0440\u0430\u044E
      \u0439 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E \u043E\u0433\u043B\u044F\u043D\u0443\u043B\u0430
      \u0457\u0445\u043D\u044E \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0441\u0442\u044C.
      \u0426\u0435 \u0431\u0443\u043B\u0438 \u0442\u0440\u0443\u043F\u0438, \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0441\u0456\u043D\u044C\u043A\u0456,
      \u043D\u0430\u043F\u0456\u0432\u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0435\u043D\u0456
      \u0442\u0440\u0443\u043F\u0438! \u0412\u043E\u043D\u0438 \u043D\u0435 \u0434\u0438\u0445\u0430\u043B\u0438,
      \u043D\u0435 \u0432\u043E\u0440\u0443\u0448\u0438\u043B\u0438\u0441\u044F \u0431\u0435\u0437
      \u043F\u043E\u0442\u0440\u0435\u0431\u0438 \u0456 \u0442\u0443\u043F\u043E
      \u0434\u0438\u0432\u0438\u043B\u0438\u0441\u044F \u0432 \u0441\u0442\u0456\u043D\u0443
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u044E, \u043D\u0435
      \u0432\u0456\u0434\u0432\u043E\u0434\u044F\u0447\u0438 \u043E\u0447\u0435\u0439.
      \u0412\u0456\u0434\u0442\u043E\u0434\u0456 \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
      \u0443\u043D\u0438\u043A\u0430\u0442\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456
      \u0437 \u0446\u0438\u043C\u0438 \u0441\u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F\u043C\u0438.
      \u0414\u043E \u0442\u0438\u0445 \u043F\u0456\u0440, \u043F\u043E\u043A\u0438
      \u043D\u0435 \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u043B\u0430 \u043D\u0430
      \u0442\u0430\u0431\u0456\u0440 \u0446\u0456\u043B\u043A\u043E\u043C \u0436\u0438\u0432\u0438\u0445
      \u0456 \u0434\u043E\u0431\u0440\u043E\u0437\u0438\u0447\u043B\u0438\u0432\u0438\u0445
      \u043F\u043E\u043D\u0456. \u0422\u0430\u043C \u044F, \u0437\u043B\u0435\u0433\u043A\u0430
      \u043E\u0441\u0432\u043E\u0457\u0432\u0448\u0438\u0441\u044C, \u0441\u0442\u0430\u043B\u0430
      \u0440\u043E\u0437\u043F\u0438\u0442\u0443\u0432\u0430\u0442\u0438 \u0436\u0438\u0442\u0435\u043B\u0456\u0432
      \u043F\u0440\u043E \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0439
      \u0441\u0432\u0456\u0442. \u042F \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E, \u0430\u043B\u0435
      \u0437\u0430\u0440\u0430\u0437 \u0432\u0430\u0436\u043B\u0438\u0432\u043E \u0442\u0435,
      \u0449\u043E \u044F \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F,
      \u0449\u043E \u0433\u0443\u043B\u0456 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0436\u0438\u0432\u0456. \u0422\u0430\u043A-\u0442\u0430\u043A, \u0446\u0435
      \u043D\u0435 \u043F\u0456\u0434\u043D\u044F\u0442\u0456 \u043C\u0430\u0433\u0456\u0454\u044E
      \u0442\u0456\u043B\u0430-\u043C\u0430\u0440\u0456\u043E\u043D\u0435\u0442\u043A\u0438,
      \u0432 \u043D\u0438\u0445 \u0454 \u0436\u0438\u0442\u0442\u044F! \u0426\u0435
      \u0434\u0438\u0432\u043D\u043E, \u0434\u0443\u0436\u0435 \u0434\u0438\u0432\u043D\u043E.
      \u042F\u043A \u043C\u043E\u0436\u0435 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C
      \u0456\u0437 \u0442\u0430\u043A\u0438\u043C\u0438 \u0436\u0430\u0445\u043B\u0438\u0432\u0438\u043C\u0438
      \u043A\u0430\u043B\u0456\u0446\u0442\u0432\u0430\u043C\u0438? \u041D\u0430
      \u0436\u0430\u043B\u044C, \u043F\u043E\u043D\u0456 \u0432 \u0442\u0430\u0431\u043E\u0440\u0456
      \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0438 \u043C\u0435\u043D\u0456
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u0438. \u042F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
      \u0432\u0456\u0434\u043A\u043B\u0430\u0441\u0442\u0438 \u0446\u0456\u043A\u0430\u0432\u0456\u0441\u0442\u044C
      \u0437 \u0446\u044C\u043E\u0433\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u0443
      \u0432 \u0441\u043F\u0438\u0441\u043E\u043A \u0441\u0432\u043E\u0457\u0445
      \u0441\u043F\u0440\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018189
    m_Localized: "\u041A\u043E\u043B\u0438 \u0436 \u044F \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F
      \u043F\u0440\u043E \u043F\u0440\u043E\u0454\u043A\u0442 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\"
      \u0456 \u043F\u043E\u0441\u043B\u0430\u043B\u0430 \u043A\u0443\u0434\u0438
      \u043F\u043E\u0434\u0430\u043B\u0456 \u043C\u043E\u0433\u043E \u043D\u0435\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \"\u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430\", \u0443 \u043C\u0435\u043D\u0435
      \u0437'\u044F\u0432\u0438\u043B\u043E\u0441\u044F \u0431\u0456\u043B\u044C\u0448\u0435
      \u0447\u0430\u0441\u0443. \u0422\u043E\u043C\u0443 \u044F \u0441\u0442\u0430\u043B\u0430
      \u0437\u0430\u0439\u043C\u0430\u0442\u0438\u0441\u044F \u0441\u0432\u043E\u0457\u043C
      \u043F\u0438\u0442\u0430\u043D\u043D\u044F\u043C. \u041D\u0430 \u0436\u0430\u043B\u044C,
      \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0437 \u0442\u0456\u043B \u0433\u0443\u043B\u0456\u0432 \u044F \u043C\u043E\u0433\u043B\u0430
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u043E:
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0435, \u0449\u043E \u043F\u0456\u0441\u043B\u044F
      \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0457 \u0441\u043C\u0435\u0440\u0442\u0456
      \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430 \u043E\u043C\u0435\u0440\u0442\u0432\u0456\u043B\u0456
      \u0442\u043A\u0430\u043D\u0438\u043D\u0438... \u043D\u0443, \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F
      \u043E\u043C\u0435\u0440\u0442\u0432\u0456\u043B\u0438\u043C\u0438 \u0442\u043A\u0430\u043D\u0438\u043D\u0430\u043C\u0438
      \u0431\u0435\u0437 \u043E\u0437\u043D\u0430\u043A \u0436\u0438\u0442\u0442\u044F.
      \u042F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430, \u0449\u043E
      \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044F
      \u043F\u043E\u0432\u043D\u043E\u0446\u0456\u043D\u043D\u043E\u0433\u043E \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0443
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u043E\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0437 \u0442\u0456\u043B\u0430\u043C\u0438 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u0457.
      \u041D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0445\u0442\u043E \u0432
      \u0442\u0430\u0431\u043E\u0440\u0456 \u0437\u0440\u0430\u0434\u0456\u0454,
      \u044F\u043A\u0449\u043E \u044F \u043F\u0440\u0438\u0442\u044F\u0433\u043D\u0443
      \u0437 \u0441\u043E\u0431\u043E\u044E \u0441\u043C\u0435\u0440\u0434\u044E\u0447\u0443
      \u0442\u0443\u0448\u0443 \u0433\u0443\u043B\u044F \u0456 \u043F\u043E\u0447\u043D\u0443
      \u043F\u0440\u0435\u043F\u0430\u0440\u0443\u0432\u0430\u0442\u0438 \u0457\u0457
      \u043D\u0430 \u043C\u0456\u0441\u0446\u0456. \u0421\u0445\u043E\u0436\u0435,
      \u043C\u0435\u043D\u0456 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0434\u0430\u043B\u0435\u043A\u043E \u0432\u0456\u0434 \u0456\u043D\u0448\u0438\u0445.
      \u042F \u0448\u0432\u0438\u0434\u043A\u043E \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u043B\u0430
      \u043C\u0456\u0441\u0446\u0435. \u0421\u0442\u0430\u0440\u0456 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0439\u043D\u0456
      \u0441\u0442\u043E\u043A\u0438 \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E
      \u0431\u0443\u043B\u0438 \u0434\u043E\u0441\u0438\u0442\u044C \u0434\u043E\u0431\u0440\u0435
      \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0456 \u043E\u0431'\u0454\u043A\u0442\u043E\u043C
      \u043C\u043E\u0457\u0445 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C.
      \u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0442\u0430\u043C \u043B\u0435\u0433\u043A\u043E
      \u0431\u0443\u043B\u043E \u0441\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0432\u0438\u0441\u043E\u0442\u0456 \u0432\u0456\u0434 \u043D\u0438\u0445
      \u0436\u0435, \u0456 \u0442\u0443\u0434\u0438 \u043D\u0435 \u0437\u0430\u0431\u0440\u0456\u0434\u0430\u043B\u0438
      \u0440\u0435\u0439\u0434\u0435\u0440\u0438 - \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0430
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0430 \u041F\u0443\u0441\u0442\u043A\u0438
      \u0437 \u0443\u0441\u0456\u0445, \u0449\u043E \u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430.
      \u0421\u043F\u0440\u0430\u0432\u0434\u0456, \u044F \u0449\u0438\u0440\u043E
      \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u0447\u043E\u043C\u0443
      \u0446\u0456 \u043F\u043E\u043D\u0456 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0456. \u041D\u0443 \u0449\u043E
      \u0436, \u0443 \u0442\u0430\u0431\u043E\u0440\u0456 \u0441\u043F\u0440\u0430\u0432\u0438
      \u0439\u0434\u0443\u0442\u044C \u0434\u043E\u0431\u0440\u0435, \u0456 \u044F
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0449\u043E
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u043C \u0442\u0438\u0436\u043D\u0435\u043C
      \u044F \u043D\u0435 \u0431\u0443\u0434\u0443 \u043D\u0456\u043A\u043E\u043C\u0443
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430.
      \u0412\u043E\u043D\u0438 \u0445\u043E\u0440\u043E\u0448\u0456 \u043F\u043E\u043D\u0456,
      \u0432\u043E\u043D\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E
      \u043F\u043E\u0436\u0438\u0432\u0443\u0442\u044C \u0456 \u0431\u0435\u0437
      \u043C\u0435\u043D\u0435 \u0442\u0440\u043E\u0445\u0438. \u041F\u0440\u043E
      \u0432\u0441\u044F\u043A \u0432\u0438\u043F\u0430\u0434\u043E\u043A \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u043B\u0430
      \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456, \u0449\u043E \u0439\u0434\u0443
      \u043D\u0430 \u0442\u0438\u0436\u0434\u0435\u043D\u044C, \u0449\u043E\u0431,
      \u044F\u043A\u0449\u043E \u0437\u0456 \u043C\u043D\u043E\u044E \u0449\u043E\u0441\u044C
      \u0442\u0440\u0430\u043F\u0438\u0442\u044C\u0441\u044F, \u043C\u0435\u043D\u0435
      \u0437\u043D\u0430\u0439\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018190
    m_Localized: "\u042F \u043D\u0430 \u043C\u0456\u0441\u0446\u0456. \u042F\u043A
      \u0436\u0435 \u0442\u0443\u0442 \u0441\u043C\u0435\u0440\u0434\u0438\u0442\u044C,
      \u043C\u0438\u043B\u043E\u0441\u0442\u0438\u0432\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F!
      \u0410\u043B\u0435 \u043C\u0435\u043D\u0456 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0437\u0430\u0442\u0438\u0448\u043D\u0435
      \u043C\u0456\u0441\u0446\u0435 \u043C\u0430\u0439\u0436\u0435 \u043E\u0434\u0440\u0430\u0437\u0443,
      \u043B\u0438\u0448\u0435 \u0447\u0435\u0440\u0435\u0437 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0433\u043E\u0434\u0438\u043D. \u041D\u0430 \u0446\u0456\u0439 \u0432\u0438\u0441\u043E\u0442\u0456
      \u043C\u0435\u043D\u0435 \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u044C,
      \u0430 \u044F\u043A\u0449\u043E \u0439 \u043D\u0456, \u0437\u043E\u043C\u0431\u0456
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u0430\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u044C
      \u043D\u0430 \u0442\u0430\u043A\u0443 \u0432\u0438\u0441\u043E\u0442\u0443.
      \u042F \u0440\u043E\u0437\u043A\u043B\u0430\u043B\u0430 \u0441\u0432\u043E\u0457
      \u0440\u0435\u0447\u0456 \u0456 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u043B\u0430
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u0443 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044E.
      \u0427\u0430\u0441 \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018191
    m_Localized: "\u042F \u0437\u043B\u043E\u0432\u0438\u043B\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0437 \u043D\u0438\u0445. \u0416\u0438\u0432\u0438\u043C (\u044F\u043A\u0449\u043E
      \u0446\u0435 \u0441\u043B\u043E\u0432\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438)
      \u0439\u043E\u0433\u043E \u0441\u043F\u0456\u0439\u043C\u0430\u0442\u0438 \u043D\u0435
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F, \u043D\u0443 \u0434\u043B\u044F
      \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u043C\u0435\u043D\u0456 \u0437\u0433\u043E\u0434\u044F\u0442\u044C\u0441\u044F
      \u0456 \u043E\u0441\u0442\u0430\u043D\u043A\u0438. \u042F \u0434\u043E\u043D\u0435\u0441\u043B\u0430
      \u0439\u043E\u0433\u043E \u0434\u043E \u043C\u043E\u0454\u0457 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      \u0456 \u043D\u0430\u043A\u0440\u0438\u043B\u0430 \u0449\u0456\u043B\u044C\u043D\u043E\u044E
      \u0442\u043A\u0430\u043D\u0438\u043D\u043E\u044E, \u0449\u043E\u0431 \u0441\u043C\u043E\u0440\u0456\u0434
      \u043D\u0435 \u0440\u043E\u0437\u043D\u043E\u0441\u0438\u0432\u0441\u044F \u043D\u0430\u0434\u0442\u043E
      \u0441\u0438\u043B\u044C\u043D\u043E. \u0421\u043F\u0435\u0440\u0448\u0443
      \u044F \u043E\u0431\u0441\u0442\u0435\u0436\u0438\u043B\u0430 \u0439\u043E\u0433\u043E
      \u043D\u0430 \u043D\u0430\u044F\u0432\u043D\u0456\u0441\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u0456\u0432
      \u0443 \u0442\u043A\u0430\u043D\u0438\u043D\u0430\u0445. \u0414\u0435\u0442\u0430\u043B\u044C\u043D\u0438\u0439
      \u0440\u043E\u0437\u0431\u0456\u0440 \u0434\u0430\u0432 \u0442\u0456 \u0441\u0430\u043C\u0456
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438, \u0449\u043E
      \u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0435\u0432\u0438\u0439:
      \u0443 \u0442\u0456\u043B\u0456 \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u043D\u0456
      \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0456 \u0431\u0456\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0456
      \u043F\u0440\u043E\u0446\u0435\u0441\u0438 \u043D\u0435 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0432\u0436\u0435 \u0434\u0443\u0436\u0435 \u0434\u043E\u0432\u0433\u0438\u0439
      \u0447\u0430\u0441. \u0410\u043B\u0435 \u0446\u0435 \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0436\u0438\u0442\u0442\u0454\u0432\u0438\u0445
      \u0444\u0443\u043D\u043A\u0446\u0456\u0439, \u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F
      \u0442\u0435\u0436 \u043C\u0430\u0439\u0436\u0435 \u043D\u0435 \u0442\u043E\u0440\u043A\u043D\u0443\u043B\u043E\u0441\u044F
      \u0442\u0456\u043B\u0430. \u041F\u0430\u0440\u0430\u0437\u0438\u0442\u0438
      \u0456 \u043F\u0430\u0434\u0430\u043B\u044C\u0449\u0438\u043A\u0438 \u0432
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0456 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456.
      \u041D\u0430\u0432\u0456\u0442\u044C \u043E\u0437\u043D\u0430\u043A \u043C\u0456\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0456\u0432,
      \u0449\u043E \u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C
      \u043C\u0435\u0440\u0442\u0432\u0438\u0445, \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F!
      \u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u0449\u043E \u0449\u043E\u0441\u044C
      \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E \u0437\u043D\u0438\u0449\u0443\u0454
      \u0432\u0441\u0435, \u0449\u043E \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u043F\u043E\u043B\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u043F\u043B\u043E\u0442\u0442\u044E
      \u0433\u0443\u043B\u044F. \u0429\u043E\u0441\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018192
    m_Localized: "\u041F\u043E\u0434\u0430\u043B\u044C\u0448\u0435 \u0432\u0438\u0432\u0447\u0435\u043D\u043D\u044F
      \u0440\u0456\u0437\u043D\u0438\u0445 \u0442\u043A\u0430\u043D\u0438\u043D,
      \u0437\u043E\u043A\u0440\u0435\u043C\u0430 \u0439 \u043C\u043E\u0437\u043A\u0443,
      \u043D\u0435 \u0432\u0438\u044F\u0432\u0438\u043B\u043E \u0436\u043E\u0434\u043D\u0438\u0445
      \u0431\u0456\u043E\u0445\u0456\u043C\u0456\u0447\u043D\u0438\u0445 \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E\u0441\u0442\u0435\u0439
      \u0432\u0456\u0434 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0457
      \u043C\u0435\u0440\u0442\u0432\u043E\u0457 \u0442\u043A\u0430\u043D\u0438\u043D\u0438.
      \u0420\u043E\u0437\u0443\u043C \u0456 \u0434\u0443\u0448\u0430 \u0434\u0430\u0432\u043D\u043E
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438 \u0442\u0456\u043B\u043E \u043D\u0435\u0449\u0430\u0441\u043D\u043E\u0433\u043E.
      \u041E\u0434\u043D\u0430\u043A \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438
      \u0434\u0430\u0432 \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442,
      \u044F\u043A\u0438\u0439 \u0441\u043B\u0456\u0434 \u0431\u0443\u043B\u043E
      \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0432\u0456\u0434 \u0441\u0430\u043C\u043E\u0433\u043E
      \u043F\u043E\u0447\u0430\u0442\u043A\u0443: \u0443 \u0442\u0456\u043B\u0456
      \u0437\u043D\u0430\u0439\u0448\u043B\u0438\u0441\u044F \u0437\u0430\u043B\u0438\u0448\u043A\u0438
      \u044F\u043A\u043E\u0457\u0441\u044C \u043C\u0430\u0433\u0456\u0457. \u041D\u0430
      \u0436\u0430\u043B\u044C, \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0430\u0440\u0456\u0441\u0442\u044C
      \u0442\u0440\u0443\u043F\u0430 \u0432\u043E\u043D\u0430 \u043C\u0430\u0439\u0436\u0435
      \u0432\u0441\u044F \u0432\u0438\u0432\u0456\u0442\u0440\u0438\u043B\u0430\u0441\u044F,
      \u0456 \u044F \u043D\u0435 \u043C\u043E\u0436\u0443 \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438,
      \u0449\u043E \u0446\u0435 \u0431\u0443\u043B\u0430 \u0437\u0430 \u043C\u0430\u0433\u0456\u044F
      \u0456 \u044F\u043A\u0438\u043C \u0437\u043B\u0438\u043C \u043F\u043E\u043D\u0456
      \u0432\u043E\u043D\u0430 \u0431\u0443\u043B\u0430 \u043D\u0430\u0441\u043B\u0430\u043D\u0430.
      \u0422\u0435, \u0449\u043E \u043F\u043E\u043D\u0456 \u0431\u0443\u0432 \u0437\u043B\u0438\u043C,
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E - \u0442\u0456\u043B\u044C\u043A\u0438
      \u0447\u0443\u0434\u043E\u0432\u0438\u0441\u044C\u043A\u043E \u043C\u043E\u0433\u043B\u043E
      \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0442\u0430\u043A\u0435 \u0433\u043B\u0443\u0437\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0430\u0434 \u043F\u0440\u0438\u0440\u043E\u0434\u043E\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018193
    m_Localized: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u043F\u043E\u043B\u043E\u043D\u0438\u0442\u0438 \u0436\u0438\u0432\u043E\u0433\u043E
      \u0433\u0443\u043B\u044F. \u0426\u0435 \u0431\u0443\u043B\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u043E,
      \u0430\u043B\u0435 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0430 \u0442\u0435\u0436
      \u0432\u0435\u043B\u0438\u043A\u0430. \u0406 \u0445\u043E\u0447 \u043C\u0435\u043D\u0456
      \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438
      \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u043D\u0430 \u043C\u0456\u0441\u0446\u0456, \u0430 \u043F\u043E\u0442\u0456\u043C
      \u0434\u043E\u0431\u0438\u0442\u0438 \u0442\u0456\u043B\u043E, \u044F \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F
      \u0432\u0441\u0435, \u0449\u043E \u0431\u0443\u043B\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E.
      \u042F \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u044C\u043D\u043E \u0432\u0438\u0432\u0447\u0438\u043B\u0430
      \u043F\u043E\u0442\u043E\u043A\u0438 \u043C\u0430\u0433\u0456\u0457, \u0449\u043E
      \u0440\u0443\u0445\u0430\u043B\u0438 \u0442\u0456\u043B\u043E\u043C \u0433\u0443\u043B\u044F.
      \u0412\u043E\u043D\u0430 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043C\u0435\u043D\u0456 \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u0430,
      \u0456 \u0432\u043E\u043D\u0430 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043D\u0435\u0441\u0445\u043E\u0436\u0430 \u043D\u0456 \u043D\u0430 \u044F\u043A\u0443
      \u0456\u043D\u0448\u0443 \u043C\u0430\u0433\u0456\u044E \u043F\u043E\u043D\u0456,
      \u0449\u043E \u044F \u0437\u043D\u0430\u044E. \u0422\u0456\u043B\u043E \u043D\u0456\u0431\u0438
      \u043E\u0433\u043E\u0440\u0442\u0430\u0454 \u0447\u043E\u0440\u043D\u0430 \"\u043C\u0435\u0440\u0435\u0436\u0430\"
      \u0437 \u0446\u0435\u043D\u0442\u0440\u043E\u043C \u0443 \u0433\u043E\u043B\u043E\u0432\u0456,
      \u0456 \u0446\u044F \u043C\u0435\u0440\u0435\u0436\u0430 \u043D\u0430\u043A\u0430\u0447\u0443\u0454
      \u0441\u0438\u043B\u0430\u043C\u0438 \u043C\u0435\u0440\u0442\u0432\u0456 \u043C'\u044F\u0437\u0438,
      \u0437\u043C\u0443\u0448\u0443\u044E\u0447\u0438 \u0457\u0445 \u043F\u0440\u043E\u0431\u0443\u0434\u0436\u0443\u0432\u0430\u0442\u0438
      \u043C'\u044F\u0437\u043E\u0432\u0443 \u043F\u0430\u043C'\u044F\u0442\u044C
      \u0456 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F. \u0411\u0430 \u0431\u0456\u043B\u044C\u0448\u0435,
      \"\u0446\u0435\u043D\u0442\u0440\" \u0446\u0456\u0454\u0457 \u043C\u0435\u0440\u0435\u0436\u0456
      \u0436\u0438\u0432\u0438\u0442\u044C \u043C\u043E\u0437\u043E\u043A, \u0456
      \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u043D\u0435\u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C \u0432\u0456\u043D \u043E\u0436\u0438\u0432\u0430\u0454
      \u0456 \u043F\u043E\u0447\u0438\u043D\u0430\u0454 \u043A\u0435\u0440\u0443\u0432\u0430\u0442\u0438
      \u0442\u0456\u043B\u043E\u043C! \u041D\u0430 \u0436\u0430\u043B\u044C, \u0432\u0438\u0449\u0430
      \u043C\u043E\u0437\u043A\u043E\u0432\u0430 \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C
      \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F,
      \u043B\u0438\u0448\u0435 \u0442\u0432\u0430\u0440\u0438\u043D\u043D\u0456 \u0456\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u0438.
      \u041E\u0434\u043D\u0430\u043A, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0443 \u0441\u0432\u0456\u0442\u0456 \u0454 \u0433\u0443\u043B\u0456, \u0432
      \u044F\u043A\u0438\u0445 \u043C\u0430\u0433\u0456\u044F \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u043B\u044C\u043D\u0430, \u0449\u043E \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454
      \u0440\u043E\u0437\u0443\u043C \u0434\u043E \u0436\u0438\u0442\u0442\u044F
      \u0446\u0456\u043B\u043A\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018194
    m_Localized: "\u042F \u0437\u0430\u0440\u0438\u043B\u0430\u0441\u044F \u0432
      \u043A\u043D\u0438\u0436\u043A\u0438, \u0449\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0437 \u0441\u043E\u0431\u043E\u044E, \u0443 \u0441\u043F\u0440\u043E\u0431\u0430\u0445
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0437\u0433\u0430\u0434\u043A\u0443 \u043F\u0440\u043E
      \u0446\u044E \u0434\u0438\u0432\u043D\u0443 \u043C\u0430\u0433\u0456\u044E.
      \u0406 \u044F \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0457\u0457. \u041F\u043E\u0434\u0456\u0431\u043D\u0435
      \u0447\u0430\u043A\u043B\u0443\u043D\u0441\u0442\u0432\u043E \u0454 \u043D\u0435
      \u0449\u043E \u0456\u043D\u0448\u0435, \u044F\u043A \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u044F
      \u043C\u0430\u0433\u0456\u044F \u0437\u0435\u0431\u0440 - \u0434\u0438\u0432\u043D\u043E\u0433\u043E
      \u043D\u0430\u0440\u043E\u0434\u0443, \u0437 \u044F\u043A\u0438\u043C \u043D\u0430\u0448\u0456
      \u043F\u0440\u0435\u0434\u043A\u0438, \u0437\u0430 \u0441\u043B\u043E\u0432\u0430\u043C\u0438
      \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456, \u0432\u0435\u043B\u0438
      \u0432\u0456\u0439\u043D\u0443 \u0434\u0432\u0456\u0441\u0442\u0456 \u0440\u043E\u043A\u0456\u0432
      \u0442\u043E\u043C\u0443 \u0456 \u0441\u043F\u0430\u043B\u0438\u043B\u0438
      \u0432 \u0446\u0456\u0439 \u0432\u0456\u0439\u043D\u0456 \u0432\u0435\u0441\u044C
      \u0441\u0432\u0456\u0442. \u0410\u043B\u0435 \u044F, \u0437\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u0447\u0435\u0441\u043D\u043E, \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
      \u0437\u0432\u0456\u0434\u043A\u0438 \u0432\u043E\u043D\u0430 \u0442\u0443\u0442.
      \u041D\u0435\u0432\u0436\u0435 \u0437\u0435\u0431\u0440\u0438 \u0445\u043E\u0434\u044F\u0442\u044C
      \u0446\u0438\u043C\u0438 \u0437\u0435\u043C\u043B\u044F\u043C\u0438 \u0456
      \u043D\u0430\u0441\u0438\u043B\u0430\u044E\u0442\u044C \u0446\u0435 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F
      \u043D\u0430 \u0442\u0440\u0443\u043F\u0438 \u043F\u043E\u043C\u0435\u0440\u043B\u0438\u0445
      \u043F\u043E\u043D\u0456? \u041D\u0456, \u0434\u0443\u0440\u0456\u0441\u0442\u044C.
      \u041D\u0430\u0432\u0456\u0449\u043E \u0457\u043C \u0446\u0435 \u0440\u043E\u0431\u0438\u0442\u0438?
      \u0422\u0430\u043A \u0447\u0438 \u0456\u043D\u0430\u043A\u0448\u0435, \u0441\u0445\u043E\u0436\u0435,
      \u0442\u0435\u043F\u0435\u0440 \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0448\u0443\u043A\u0430\u0442\u0438 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E
      \u043F\u0440\u043E \u0442\u0443 \u0432\u0456\u0439\u043D\u0443. \u0406 \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u044F \u0437\u043D\u0430\u0439\u0434\u0443 \u0457\u0457 \u0441\u0435\u0440\u0435\u0434
      \u0446\u0438\u0445 \u043A\u043D\u0438\u0436\u043E\u043A. \u0417\u0430\u0442\u0440\u0438\u043C\u0430\u044E\u0441\u044F
      \u0442\u0443\u0442 \u0449\u0435 \u043D\u0435\u043D\u0430\u0434\u043E\u0432\u0433\u043E.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u0437\u0443\u043C\u0456\u044E
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0449\u043E\u0441\u044C \u0456\u0449\u0435.
      \u0429\u043E\u0441\u044C \u0432\u0430\u0436\u043B\u0438\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018195
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 1\n\t\u041C\u0456\u0439 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433
      \u043D\u0430\u0441\u0442\u0456\u0439\u043D\u043E \u043F\u043E\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0432\u0430\u0432
      \u0440\u043E\u0431\u0438\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u0438 \u0449\u043E\u0440\u0430\u0437\u0443,
      \u043A\u043E\u043B\u0438 \u043C\u0435\u043D\u0435 \u043F\u043E\u0447\u0438\u043D\u0430\u0454
      \u0449\u043E\u0441\u044C \u0445\u0432\u0438\u043B\u044E\u0432\u0430\u0442\u0438.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u0449\u043E \u0446\u0435 \u0437\u0430
      \u043C\u0435\u0442\u043E\u0434\u0438\u043A\u0430 \u0456 \u044F\u043A \u0432\u043E\u043D\u0430
      \u0434\u0430\u0441\u0442\u044C \u0437\u043C\u043E\u0433\u0443 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u043D\u0435\u0440\u0432\u0438, \u0430\u043B\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0440\u0430\u0437 \u043C\u0435\u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0454
      \u0434\u0432\u0456 \u0440\u0435\u0447\u0456. \u041F\u043E-\u043F\u0435\u0440\u0448\u0435,
      \u0443 \u043D\u0430\u0448\u043E\u043C\u0443 \u0432\u0456\u0434\u0434\u0456\u043B\u0456
      \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E \u043C\u0430\u0442\u0438
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0456 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0438
      \u0434\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0456\u0432, \u0449\u043E\u0431
      \u043C\u0438 \u043D\u0435 \"\u0432\u043A\u0440\u0430\u043B\u0438 \u0456\u0434\u0435\u0457\".
      \u041F\u043E-\u0434\u0440\u0443\u0433\u0435, \u043D\u0430\u043C \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0432\u0430\u0442\u0438
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u043F\u0430\u0440\u043E\u043B\u0456
      \u043D\u0430 \u0441\u0432\u043E\u0457 \u0440\u043E\u0431\u043E\u0447\u0456
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0438. \u041C\u0430\u0431\u0443\u0442\u044C,
      \u0446\u0435 \u0434\u043E\u0441\u0438\u0442\u044C \u0432\u0430\u0433\u043E\u043C\u0456
      \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u0434\u043B\u044F \u0437\u0430\u043D\u0435\u043F\u043E\u043A\u043E\u0454\u043D\u043D\u044F,
      \u0449\u043E\u0431 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043F\u0440\u043E
      \u043D\u0438\u0445 \u043F\u0435\u0440\u0448\u0438\u0439 \u0437\u0430\u043F\u0438\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018196
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 2\n\t\u041D\u0435 \u0441\u043A\u0430\u0437\u0430\u0432
      \u0431\u0438, \u0449\u043E \u043D\u0430 \u043D\u0430\u0448\u0456\u0439 \u0440\u043E\u0431\u043E\u0442\u0456
      \u043C\u0430\u043B\u043E \u0442\u0440\u0435\u0431\u0430 \u043D\u0430\u043F\u0440\u0443\u0436\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
      \u0430\u043B\u0435 \u043E\u0441\u0442\u0430\u043D\u043D\u0456 \u0434\u043D\u0456
      \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0430\u0445. \u042F \u0436\u043E\u0434\u043D\u043E\u0433\u043E
      \u0440\u0430\u0437\u0443 \u0437\u0430 \u0442\u0438\u0436\u0434\u0435\u043D\u044C
      \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F \u0434\u043E\u0434\u043E\u043C\u0443
      \u0432\u0447\u0430\u0441\u043D\u043E. \u0426\u0456 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0432\u0456\u0434 \u041C\u0422\u041D \u0437\u0432\u0435\u0434\u0443\u0442\u044C
      \u043C\u0435\u043D\u0435 \u0437 \u0440\u043E\u0437\u0443\u043C\u0443. \u042F\u043A\u0449\u043E
      \u043D\u0430\u043C \u043D\u0435 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0443
      \u0446\u044C\u043E\u0433\u043E \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440\u0430
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u043C\u0438 \u0434\u043D\u044F\u043C\u0438,
      \u044F \u0432\u0456\u0437\u044C\u043C\u0443 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u043A\u0443
      \u0440\u0430\u043D\u0456\u0448\u0435 \u0442\u0435\u0440\u043C\u0456\u043D\u0443
      \u0456 \u0437\u0430\u0431\u0430\u0440\u0438\u043A\u0430\u0434\u0443\u044E\u0441\u044F
      \u0432\u0434\u043E\u043C\u0430 \u044F\u0449\u0438\u043A\u0430\u043C\u0438 \u0437
      \u0432\u0438\u043F\u0438\u0432\u043A\u043E\u044E. \u0422\u0430\u043A \u043D\u0435
      \u043C\u043E\u0436\u043D\u0430, \u0437\u0432\u0456\u0441\u043D\u043E, \u0430\u043B\u0435
      \u0411\u043B\u0443\u043C \u043F\u0456\u0434\u0441\u043E\u0431\u0438\u0442\u044C,
      \u043C\u0438 \u043E\u0434\u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u0430\u0432\u043D\u043E \u0437\u043D\u0430\u0454\u043C\u043E, \u0432\u0456\u043D
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0454 \u043C\u0456\u0439 \u0441\u0442\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018197
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 3\n\t\u0423 \u043D\u0430\u0448\u043E\u043C\u0443
      \u0432\u0456\u0434\u0434\u0456\u043B\u0456 \u043D\u043E\u0432\u0438\u0439 \u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u0439
      \u0443\u0447\u0435\u043D\u0438\u0439, \u041C\u043E\u043D\u0456\u043D \u0421\u0442\u0430\u0440.
      \u0406 \u0432\u043E\u043D\u0430 - \u0434\u0443\u0436\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0430 \u043A\u0440\u0443\u0442\u043E\u0431\u0456\u0434\u0440\u0430
      \u0437\u0435\u043C\u043D\u0430 \u043F\u043E\u043D\u0456. \u0410\u043B\u0435
      \u0442\u0443\u0442 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0441\u0442\u044C
      \u0433\u043E\u043B\u043E\u0432\u043D\u0435. \u0423 \u043D\u0435\u0457 \u0442\u0430\u043A\u0438\u0439
      \u0437\u0430\u043F\u0430\u043B \u0443 \u0441\u043F\u0440\u0430\u0432\u0456,
      \u0442\u0430\u043A\u0430 \u0456\u0441\u043A\u0440\u0438\u043D\u043A\u0430 \u0432
      \u043E\u0447\u0430\u0445... \u0423 \u043D\u0456\u0439 \u0449\u043E\u0441\u044C
      \u0454, \u0446\u0435 \u0442\u043E\u0447\u043D\u043E. \u0406, \u044F\u043A\u0449\u043E
      \u0447\u0435\u0441\u043D\u043E, \u044F \u044F\u0432\u043D\u043E \u0434\u043E
      \u043D\u0435\u0457 \u043D\u0435\u0431\u0430\u0439\u0434\u0443\u0436\u0438\u0439.
      \u0422\u0440\u0435\u0431\u0430 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0446\u0438\u043C. \u041C\u043E\u0436\u0435, \u0443 \u043D\u0430\u0441
      \u043D\u0430\u0432\u0456\u0442\u044C \u0454 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018198
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 4\n\t\u042F \u0437\u0432\u0430\u0436\u0438\u0432\u0441\u044F.
      \u042F \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0436 \u043F\u0456\u0434\u0456\u0439\u0434\u0443
      \u0434\u043E \u041C\u043E\u043D\u0456\u043D \u0456 \u0437\u0430\u043F\u0440\u043E\u0448\u0443
      \u043D\u0430 \u0432\u0435\u0447\u0435\u0440\u044E. \u041C\u0435\u043D\u0456
      \u043D\u0430\u0431\u0440\u0438\u0434\u043B\u0438 \u0446\u0456 \u043D\u0430\u043F\u0456\u0432\u043D\u0430\u0442\u044F\u043A\u0438
      \u0432 \u0440\u043E\u0437\u043C\u043E\u0432\u0430\u0445 \u0456 \u043F\u043E\u0433\u043B\u044F\u0434\u0438
      \u043A\u0440\u0430\u0434\u044C\u043A\u043E\u043C\u0430. \u0422\u0440\u0435\u0431\u0430
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0441\u0438\u043B\u0430\u043C\u0438. \u0422\u0430\u043A, \u044F \u0437\u043C\u043E\u0436\u0443.
      \u042F \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0443\u0432 \u0441\u0438\u043B\u044C\u043D\u0438\u043C,
      \u044F \u0437\u043C\u043E\u0436\u0443. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0440\u043E\u0445\u0438 \u043D\u0430\u043F\u0440\u0443\u0436\u0438\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018199
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 5\n\t\u0422\u0440\u0438\u0432\u043E\u0436\u043D\u0456
      \u0447\u0443\u0442\u043A\u0438 \u0445\u043E\u0434\u044F\u0442\u044C \u0432\u0456\u0434\u0434\u0456\u043B\u043E\u043C.
      \u041A\u0430\u0436\u0443\u0442\u044C, \u043D\u0430 \u0444\u0440\u043E\u043D\u0442
      \u043C\u043E\u0436\u0443\u0442\u044C \u043F\u043E\u0447\u0430\u0442\u0438 \u043C\u043E\u0431\u0456\u043B\u0456\u0437\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0430\u0446\u0456\u0432\u043D\u0438\u043A\u0456\u0432 \u0437\u0430\u0432\u043E\u0434\u0443.
      \u041F\u0440\u0438\u0447\u043E\u043C\u0443 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u0440\u043E\u0441\u0442\u0438\u0445 \u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u0456\u0432,
      \u0430\u043B\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0456\u0432.
      \u0426\u0435 \u0442\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435 \u0434\u0438\u0432\u043D\u043E
      \u0443 \u0441\u0432\u0456\u0442\u043B\u0456 \u0442\u043E\u0433\u043E, \u0449\u043E
      \u0432 \u043D\u043E\u0432\u0438\u043D\u0430\u0445 \u043D\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u043B\u0438
      \u043D\u0456 \u043F\u0440\u043E \u044F\u043A\u0456 \u0432\u0435\u043B\u0438\u043A\u0456
      \u043F\u043E\u0440\u0430\u0437\u043A\u0438 \u043D\u0430 \u0444\u0440\u043E\u043D\u0442\u0456.
      \u041D\u0430\u043C \u0431\u0438 \u043D\u0435 \u0441\u0442\u0430\u043B\u0438
      \u0431\u0440\u0435\u0445\u0430\u0442\u0438, \u0432\u0456\u0440\u043D\u043E?
      \u0422\u0440\u0435\u0431\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u043F\u0440\u043E \u0446\u0435 \u0437 \u041C\u043E\u043D\u0456\u043D. \u042F\u043A\u0449\u043E
      \u0434\u0456\u0439\u0434\u0435 \u0434\u043E \u0442\u043E\u0433\u043E, \u0449\u043E
      \u043A\u043E\u0433\u043E\u0441\u044C \u0456\u0437 \u043D\u0430\u0441 \u0434\u0432\u043E\u0445
      \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438\u043C\u0443\u0442\u044C, \u0442\u0440\u0435\u0431\u0430
      \u0431\u0443\u0434\u0435 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u0438 \u0449\u043E\u0434\u043E
      \u0446\u044C\u043E\u0433\u043E. \u041C\u0438 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0442\u0430\u043B\u0438 \u043F\u0430\u0440\u043E\u044E, \u043D\u0430\u0441
      \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0440\u043E\u0437\u043B\u0443\u0447\u0438\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018200
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 6\n\t\u041C\u0456\u0439 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u043E \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u043E.
      \u0410 \u044F \u0432 \u043D\u044C\u043E\u043C\u0443 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E \u0440\u043E\u0437\u043F\u0438\u0441\u0443\u0432\u0430\u0432
      \u043F\u0440\u043E \u0441\u043F\u0440\u0430\u0432\u0438, \u043F\u0440\u043E
      \u044F\u043A\u0456 \u043D\u0435 \u0432\u0430\u0440\u0442\u043E \u0437\u043D\u0430\u0442\u0438
      \u0456\u043D\u0448\u0438\u043C. \u041F\u0440\u043E \u0442\u043E\u0433\u043E
      \u0436 \u0411\u043B\u0443\u043C\u0430. \u0423 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0439
      \u0447\u0430\u0441 \u043D\u0456\u0445\u0442\u043E \u0431 \u0456 \u0432\u0443\u0445\u043E\u043C
      \u043D\u0435 \u043F\u043E\u0432\u043E\u0440\u0443\u0445\u043D\u0443\u0432 \u043D\u0430
      \u0446\u0435 \"\u043F\u0456\u0434\u0441\u043E\u0431\u0438\u0442\u044C\", \u0430\u043B\u0435
      \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u043D\u0456 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0439 \u0448\u0443\u043A\u0430\u044E\u0442\u044C, \u043A\u043E\u0433\u043E
      \u0431 \u043F\u043E\u0441\u043B\u0430\u0442\u0438 \u043D\u0430 \u0444\u0440\u043E\u043D\u0442
      \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u0441\u0432\u043E\u0454\u0457 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u043E\u0457
      \u0434\u0443\u043F\u0438. \u0417\u0430\u0433\u0430\u043B\u043E\u043C, \u043F\u043E
      \u043C\u043E\u044E \u0434\u0443\u0448\u0443 \u043F\u043E\u0447\u0430\u043B\u0438
      \u0440\u043E\u0437\u0433\u043B\u044F\u0434. \u0421\u0438\u0434\u0436\u0443,
      \u0433\u0440\u0438\u0437\u0443 \u043A\u043E\u043F\u0438\u0442\u0430. \u0414\u043E\u0431\u0440\u0435
      \u0445\u043E\u0447, \u0449\u043E \u0411\u043B\u0443\u043C \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0432\u0441\u044F
      \u0449\u0435 \u0434\u043E \u0446\u044C\u043E\u0433\u043E, \u0439\u043E\u0433\u043E
      \u043D\u0435 \u0437\u0430\u0447\u0435\u043F\u0438\u0442\u044C. \u041B\u0438\u0448\u0435
      \u0431 \u043F\u0440\u043E\u043D\u0435\u0441\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018201
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 7\n\t\u0411\u043E\u044E\u0441\u044F,
      \u043C\u0456\u0439 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0437\u0430\u043F\u0438\u0441
      \u0442\u0443\u0442. \u041E\u0444\u0456\u0446\u0456\u0439\u043D\u043E \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0434\u0430\u043B\u043E.
      \u0410\u043B\u0435 \u043C\u043E\u0454 \u0456\u043C'\u044F \u0437\u0430\u043D\u0435\u0441\u043B\u0438
      \u0434\u043E \u0441\u043F\u0438\u0441\u043A\u0443 \u043F\u0440\u0430\u0446\u0456\u0432\u043D\u0438\u043A\u0456\u0432,
      \u044F\u043A\u0438\u0445 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u043D\u0430 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0456 \u0437\u0431\u043E\u0440\u0438
      \u0437\u0430 \u0442\u0438\u0436\u0434\u0435\u043D\u044C. \u041A\u0430\u0436\u0443\u0442\u044C,
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0431\u0443\u0434\u0435,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0432\u0430 \u0442\u0438\u0436\u043D\u0456
      \u043F\u043E\u0442\u043E\u043F\u0447\u0435\u043C\u043E \u043F\u043B\u0430\u0446
      \u0456 \u043F\u043E\u0442\u0440\u0435\u043D\u0443\u0454\u043C\u043E\u0441\u044F
      \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438 \u0437\u0456 \u0437\u0431\u0440\u043E\u0457,
      \u044F\u043A\u0443 \u0441\u0430\u043C\u0456 \u0442\u0443\u0442 \u0456 \u0440\u043E\u0431\u0438\u043C\u043E.
      \u0410\u043B\u0435 \u044F \u0447\u0443\u0432, \u0449\u043E \u0437 \u0437\u0430\u0432\u043E\u0434\u0443
      \u0432 \u0422\u0440\u043E\u0442\u0442\u0456\u043D\u0445\u0435\u043C\u0456 \u043F\u043E\u043D\u0456
      \u0442\u0430\u043A \u0441\u0430\u043C\u043E \u0437\u0431\u0438\u0440\u0430\u043B\u0438
      \"\u043D\u0430 \u0437\u0431\u043E\u0440\u0438\", \u0430\u043B\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0442\u0438\u0436\u043D\u0456 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043D\u0430 \u0432\u0456\u0439\u043D\u0443. \u041C\u0435\u043D\u0456 \u043E\u0431\u0456\u0446\u044F\u043B\u0438,
      \u0449\u043E \u043C\u043E\u0454 \u0440\u043E\u0431\u043E\u0447\u0435 \u043C\u0456\u0441\u0446\u0435
      \u043D\u0435 \u0447\u0456\u043F\u0430\u0442\u0438\u043C\u0443\u0442\u044C \u0434\u043E
      \u043C\u043E\u0433\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F.
      \u041B\u043E\u0432\u043B\u044E \u043D\u0430 \u0441\u043B\u043E\u0432\u0456,
      \u0445\u043B\u043E\u043F\u0446\u0456. \u0410\u043B\u0435 \u0446\u0435 \u043D\u0435
      \u0432\u0441\u0435, \u0449\u043E \u043C\u0435\u043D\u0435 \u0442\u0435\u0440\u0437\u0430\u0454
      \u0437\u0430\u0440\u0430\u0437. \u0429\u043E\u0439\u043D\u043E \u041C\u043E\u043D\u0456\u043D
      \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F, \u0449\u043E \u043C\u0435\u043D\u0435
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u044C, \u0432\u043E\u043D\u0430
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u0437\u0433\u043E\u043B\u043E\u0441\u0438\u043B\u0430\u0441\u044F
      \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435\u043C. \u0426\u0435
      \u0448\u043E\u043A\u0443\u0432\u0430\u043B\u043E \u0432\u0441\u0456\u0445,
      \u0430\u0434\u0436\u0435 \u0432\u043E\u043D\u0430 - \u043E\u0434\u043D\u0430
      \u0437 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0445 \u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u0445
      \u0443\u0447\u0435\u043D\u0438\u0445 \u0437\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0443. \u0410\u043B\u0435 \u0432\u043E\u043D\u0430
      \u043D\u0430\u043F\u043E\u043B\u044F\u0433\u043B\u0430 \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443,
      \u0456 \u0434\u0443\u0436\u0435 \u0436\u043E\u0440\u0441\u0442\u043A\u043E.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u0449\u043E \u0439 \u0434\u0443\u043C\u0430\u0442\u0438
      \u0442\u0435\u043F\u0435\u0440. \u0417 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u043E\u043A\u0443, \u0432\u043E\u043D\u0430 \u0431\u0443\u0434\u0435
      \u043F\u043E\u0440\u0443\u0447 \u0437\u0456 \u043C\u043D\u043E\u044E, \u0437
      \u0456\u043D\u0448\u043E\u0433\u043E - \u0449\u043E \u0431\u0443\u0434\u0435,
      \u044F\u043A\u0449\u043E \u043D\u0430\u0441 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u0432\u043E\u044E\u0432\u0430\u0442\u0438?
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u0437\u0431\u0435\u0440\u0435\u0436\u0438
      \u043D\u0430\u0441 \u0443\u0441\u0456\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018202
    m_Localized: "*\u0412\u0456\u0434 \u043A\u043E\u0433\u043E: \u0421\u043A\u0430\u0440\u043B\u0435\u0442
      \u0421\u0442\u043E\u0443\u043D. \u041B\u0438\u0441\u0442 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E:
      75073 \u0434\u043D\u0456 \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      \u043D\u043E\u0432\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F.*\n\t\"\u0417\u0434\u0440\u0430\u0441\u0442\u0443\u0439,
      \u041C\u043E\u043D\u0456\u043D. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u044F \u043D\u0435 \u0432\u0456\u0434\u0432\u043E\u043B\u0456\u043A\u0430\u044E
      \u0442\u0435\u0431\u0435? \u0422\u043E\u043C\u0443 \u0449\u043E \u0440\u0456\u0447
      \u0443 \u0442\u0456\u043C, \u0449\u043E, \u0435\u043C, \u043C\u0435\u043D\u0456
      \u0437\u0430\u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443\u0432\u0430\u043B\u0438
      \u0437 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445 \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439.
      \u041D\u0456\u0447\u043E\u0433\u043E \u043F\u043E\u0433\u0430\u043D\u043E\u0433\u043E,
      \u043D\u0456, \u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F!
      \u041D\u0430\u0432\u043F\u0430\u043A\u0438, \u043D\u0430\u043C \u0445\u043E\u0447\u0443\u0442\u044C
      \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043D\u043E\u0432\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F.
      \u0410\u043B\u0435, \u044F\u043A\u0449\u043E \u0447\u0435\u0441\u043D\u043E,
      \u0432\u043E\u043D\u0438 \u0445\u043E\u0447\u0443\u0442\u044C, \u0449\u043E\u0431
      \u043C\u0438 \u043E\u0434\u0440\u0430\u0437\u0443 \u0431\u0440\u0430\u043B\u0438\u0441\u044F
      \u0437\u0430 \u0441\u043F\u0440\u0430\u0432\u0443. \u041F\u043E\u043A\u0438
      \u0449\u043E \u043C\u0435\u043D\u0456 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0436\u043E\u0434\u043D\u0438\u0445 \u0436\u043E\u0440\u0441\u0442\u043A\u0438\u0445
      \u0442\u0435\u0440\u043C\u0456\u043D\u0456\u0432, \u0430\u043B\u0435 \u044F\u043A\u0449\u043E
      \u0437\u0430 \u0434\u0432\u0430 \u043C\u0456\u0441\u044F\u0446\u0456 \u043C\u0438
      \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0439 \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0443\u0432\u0430\u0442\u0438
      \u043F\u0456\u043B\u043E\u0442\u043D\u0443 \u0432\u0435\u0440\u0441\u0456\u044E,
