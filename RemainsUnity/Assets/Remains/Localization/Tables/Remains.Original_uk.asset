      m_Items: []
  - m_Id: 2737823957
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u043F\u0430\u0440\u043E\u043B\u0456\u0432 \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A.
      \u0423 \u043C\u0435\u043D\u0435 \u0454 \u0430\u0440\u0445\u0456\u0432 \u0443\u0441\u0456\u0445
      \u043A\u043E\u0434\u0456\u0432, \u0449\u043E \u043A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u0454\u044E, \u043D\u0435
      \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u043F\u0456\u0434\u0431\u0456\u0440
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E\u0433\u043E \u0437\u0430\u0439\u043C\u0435
      \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u0430\u0441\u0443. \u041E\u0441\u044C,
      \u0432\u043B\u0430\u0441\u043D\u0435... \u0456 \u0432\u0441\u0435. \u0417\u0430\u0440\u0430\u0437
      \u043C\u0438 \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F \u043D\u0430
      \u0442\u0432\u043E\u044E \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823958
    m_Localized: "\u0429\u043E, \u0432\u0441\u0435 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823959
    m_Localized: "\u0423\u0441\u0435 \u0441\u0442\u0430\u0454 \u0434\u043E\u0441\u0438\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E, \u044F\u043A\u0449\u043E \u043C\u0430\u0442\u0438
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0439 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442.
      \u0410 \u0442\u0435\u043F\u0435\u0440 \u043D\u0435 \u0437\u0430\u0432\u0430\u0436\u0430\u0439,
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044F
      \u043D\u0430 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0430\u0445 \u0430\u0440\u0445\u0456\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823960
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435 \u0434\u0456\u0439\u0441\u043D\u043E
      \u0442\u0435, \u0449\u043E \u043C\u0438 \u0448\u0443\u043A\u0430\u043B\u0438.
      \u0423\u0441\u044F \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F
      \u043C\u0456\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u0446\u044C\u043E\u043C\u0443
      \u0430\u0440\u0445\u0456\u0432\u0456. \u042F\u043A\u0449\u043E \u0446\u0435
      \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0454\u0434\u0438\u043D\u0438\u0439
      \u0444\u0430\u0439\u043B, \u044F\u043A\u0438\u0439 \u0431\u0443\u0432 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439
      \u0434\u043B\u044F \u0441\u043A\u0430\u0447\u0443\u0432\u0430\u043D\u043D\u044F
      \u0437 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0456\u0432 \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F,
      \u0442\u043E \u043D\u0430\u043C \u0434\u0443\u0436\u0435 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823961
    m_Localized: "\u0412\u0438\u043D\u043E\u0448\u0443 \u0442\u043E\u0431\u0456 \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u0443
      \u043F\u043E\u0434\u044F\u043A\u0443. \u0422\u0430\u043A\u0456, \u044F\u043A
      \u0442\u0438, \u0434\u043E\u0432\u043E\u0434\u044F\u0442\u044C, \u0449\u043E
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438 \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430
      \u043F\u0440\u043E \u0437\u0430\u0445\u0438\u0441\u0442 \u043F\u0440\u043E\u0441\u0442\u0438\u0445
      \u043F\u043E\u043D\u0456 \u043D\u0435 \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u0435\u043D\u0456
      \u0441\u0435\u043D\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823962
    m_Localized: "\u0411\u0443\u043B\u0430 \u0440\u0430\u0434\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823963
    m_Localized: "\u0423\u0441\u0435-\u0442\u0430\u043A\u0438 \u0431\u043B\u0443\u043A\u0430\u0442\u0438
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u043E\u043C - \u0442\u0435
      \u0449\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F.
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0448\u0432\u0438\u0434\u0448\u0435
      \u0439\u0442\u0438 \u0434\u043E \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0421\u0442\u0438\u043B\u044E, \u0430 \u043F\u043E\u0442\u0456\u043C \u0432\u0430\u043B\u0438\u0442\u0438
      \u0437\u0432\u0456\u0434\u0441\u0438 \u043A\u0443\u0434\u0438 \u043F\u043E\u0434\u0430\u043B\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823964
    m_Localized: "\u0406\u0434\u0456\u0442\u044C \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447,
      \u0449\u043E\u0431 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0432
      [\u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u043E\u0444\u0456\u0441
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0421\u0442\u0438\u043B\u044E].
      \u0410\u0431\u043E \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044C \u0443
      \u0434\u0432\u0435\u0440\u0456 [Exit], \u0449\u043E\u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823965
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u041C\u0447\u0430\u0432\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823966
    m_Localized: "\u0415\u043C\u043C... \u0414\u043E\u0431\u0440\u043E\u0433\u043E
      \u0434\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823967
    m_Localized: "\u0422\u0438 \u0432\u0436\u0435 \u0442\u0443\u0442, @lp. \u042F
      \u0434\u0443\u043C\u0430\u043B\u0430, \u0442\u0438 \u043F\u0440\u0438\u0439\u0434\u0435\u0448
      \u043F\u0456\u0437\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823968
    m_Localized: "\u0417\u0432\u0456\u0434\u043A\u0438 \u0442\u0438 \u0437\u043D\u0430\u0454\u0448
      \u043C\u043E\u0454 \u0456\u043C'\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823969
    m_Localized: "\u0414\u043B\u044F \u0442\u0438\u0445, \u0445\u0442\u043E \u0439\u0434\u0435
      \u0442\u0435\u043C\u043D\u043E\u044E \u0441\u0442\u0435\u0436\u043A\u043E\u044E,
      \u0431\u0430\u0433\u0430\u0442\u043E \u0442\u0430\u0454\u043C\u043D\u043E\u0433\u043E
      \u0441\u0442\u0430\u0454 \u044F\u0432\u043D\u0438\u043C \u0449\u0435 \u0434\u043E
      \u0442\u043E\u0433\u043E, \u044F\u043A \u0432\u043F\u0435\u0440\u0448\u0435
      \u0437\u0430\u044F\u0432\u0438\u0442\u044C \u043F\u0440\u043E \u0441\u0435\u0431\u0435,
      @lp. \u0421\u043B\u0456\u043F\u043E\u043C\u0443 \u043D\u0435 \u0441\u043B\u0456\u0434
      \u0434\u0438\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0442\u043E\u043C\u0443,
      \u0449\u043E \u0437\u0440\u044F\u0447\u0438\u0439 \u0431\u0430\u0447\u0438\u0442\u044C
      \u0439\u043E\u0433\u043E \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0432 \u0434\u0437\u0435\u0440\u043A\u0430\u043B\u0456. \u0410\u043B\u0435
      \u0432\u0438\u0431\u0430\u0447 \u043C\u043E\u0457 \u043C\u0430\u043D\u0435\u0440\u0438.
      \u0417\u0430\u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E
      \u0437\u0456\u0440\u043E\u043A \u044F \u043F\u0440\u043E\u0432\u0435\u043B\u0430
      \u0432 \u043E\u0442\u043E\u0447\u0435\u043D\u043D\u0456 \u0446\u0438\u0445
      \u0431\u0435\u0437\u043C\u043E\u0437\u043A\u0438\u0445 \u0442\u0440\u0443\u043F\u0456\u0432.
      \u0422\u0443\u0442 \u0443\u0436\u0435 \u043B\u0435\u0433\u043A\u043E \u0437\u0430\u0431\u0443\u0434\u0435\u0448,
      \u044F\u043A \u0441\u043B\u0456\u0434 \u0440\u043E\u0437\u043C\u043E\u0432\u043B\u044F\u0442\u0438
      \u0437 \u0436\u0438\u0432\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823970
    m_Localized: "\u0406\u043C'\u044F \u043C\u043E\u0454 - \u041C\u0447\u0430\u0432\u0456.
      \u042F - \u0441\u0442\u0430\u0440\u0438\u0439 \u0448\u0430\u043C\u0430\u043D
      \u0456\u0437 \u0440\u043E\u0434\u0443, \u0449\u043E \u0432\u0435\u0434\u0435
      \u0441\u0432\u043E\u0454 \u043F\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0432\u0456\u0434 \u043D\u0430\u0439\u0434\u0430\u0432\u043D\u0456\u0448\u0438\u0445
      \u0447\u0430\u043A\u043B\u0443\u043D\u0456\u0432 \u0437\u0435\u0431\u0440.
      \u0406 \u044F \u0442\u0443\u0442 \u0437\u0430 \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043D\u044F\u043C
      \u0441\u0432\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u0438\u043A\u0438,
      \u043B\u0435\u0433\u0430\u0442\u0430 \u041A\u0435\u0441\u0430\u0440\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823971
    m_Localized: "\u041A\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823972
    m_Localized: "\u0422\u0432\u043E\u0457 \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0456
      \u0437 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430 \u043C\u043E\u0433\u043B\u0438
      \u0431 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u0442\u043E\u0431\u0456
      \u0439 \u0431\u0456\u043B\u044C\u0448\u0435. \u041B\u0435\u0433\u0430\u0442
      \u041A\u0435\u0441\u0430\u0440\u0456\u0439 - \u0442\u0438\u0440\u0430\u043D
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443, \u043B\u0456\u0434\u0435\u0440
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0443.
      \u0419\u043E\u0433\u043E \u0434\u043E\u043B\u044F - \u043F\u0440\u0430\u0432\u0438\u0442\u0438
      \u0432\u0441\u0456\u043C, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0432\u0456\u0434 \u043D\u0430\u0448\u043E\u0433\u043E \u0441\u0432\u0456\u0442\u0443.
      \u041C\u043E\u044F \u0434\u043E\u043B\u044F - \u0441\u0442\u0430\u0442\u0438
      \u043A\u0430\u043C\u0456\u043D\u0447\u0438\u043A\u043E\u043C \u0443 \u0434\u043E\u0440\u043E\u0437\u0456,
      \u044F\u043A\u043E\u044E \u0432\u0456\u043D \u043F\u0440\u0438\u0439\u0434\u0435
      \u0434\u043E \u0441\u0432\u043E\u0454\u0457 \u0434\u043E\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823973
    m_Localized: "\u0422\u043E \u0442\u0438 \u0437 \u0442\u0438\u0445 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0445
      \u0433\u043E\u043B\u043E\u0432\u043E\u0440\u0456\u0437\u0456\u0432, \u0437\u043D\u0430\u0447\u0438\u0442\u044C?
      \u0406 \u044F\u043A \u0442\u043E\u0431\u0456 \u0446\u0435 - \u0432\u0431\u0438\u0432\u0430\u0442\u0438
      \u043C\u0438\u0440\u043D\u0438\u0445 \u043F\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823974
    m_Localized: "\u041E\u0431\u0435\u0440\u0435\u0436\u043D\u0456\u0448\u0435 \u0437\u0456
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438, \u0434\u0438\u0442\u0438\u043D\u043E.
      \u0422\u0432\u043E\u0454 \u043D\u0435\u0432\u0456\u0433\u043B\u0430\u0441\u0442\u0432\u043E
      \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0435 \u0442\u043E\u0431\u0456
      \u043D\u0456\u0447\u043E\u0433\u043E, \u043A\u0440\u0456\u043C \u0441\u043C\u0443\u0442\u043A\u0443.
      \u041B\u0435\u0433\u0456\u043E\u043D \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
      \u0440\u043E\u0431\u0438\u0432 \u0447\u043E\u0433\u043E\u0441\u044C, \u0443
      \u0447\u043E\u0433\u043E \u043D\u0435 \u0431\u0443\u043B\u043E \u0431 \u043F\u0440\u0438\u0447\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823975
    m_Localized: "\u0406 \u0432 \u0447\u043E\u043C\u0443 \u0436 \u043F\u0440\u0438\u0447\u0438\u043D\u0430
      \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u0438 \u043D\u0438\u0448\u043A\u043E\u043C
      \u043D\u0430 \u0442\u0438\u0445, \u0445\u0442\u043E \u043D\u0456\u0447\u043E\u0433\u043E
      \u0432\u0430\u043C \u043D\u0435 \u0437\u0440\u043E\u0431\u0438\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823976
    m_Localized: "\u041D\u0435 \u0432\u0441\u0456 \u0437\u043D\u0430\u043D\u043D\u044F
      \u0441\u043B\u0456\u0434 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u0431\u0435\u0437 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438.
      \u0422\u0432\u043E\u044F \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C
      \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u0430 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438
      \u0456\u0441\u0442\u0438\u043D\u0438 \u041B\u0435\u0433\u0456\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823977
    m_Localized: "\u0406\u0441\u0442\u0438\u043D\u0438 \u043F\u0440\u043E \u0442\u0435,
      \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0431\u0438\u0432\u0430\u0442\u0438
      \u0432\u0441\u0456\u0445 \u043F\u043E\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430 \u0442\u0435, \u0449\u043E \u0432\u043E\u043D\u0438 - \u043F\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823978
    m_Localized: "\u0426\u0435 \u0441\u043A\u0430\u0437\u0430\u0432 \u0442\u043E\u0431\u0456
      \u0410\u0441\u043A\u0430\u0440\u0456 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0432\u0430\u0448\u043E\u0457 \u043F\u0435\u0440\u0448\u043E\u0457 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A? \u0419\u043E\u0433\u043E \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F
      \u0442\u0440\u043E\u0445\u0438 \u0432\u0438\u0449\u0435 \u0437\u0430 \u0442\u0432\u043E\u0454.
      \u0422\u043E\u0431\u0456 \u0441\u043B\u0456\u0434 \u0437\u043D\u0430\u0442\u0438
      \u043B\u0438\u0448\u0435 \u0442\u0435, \u0449\u043E \u0432 \u041A\u0435\u0441\u0430\u0440\u0456\u044F
      \u0454 \u043F\u043B\u0430\u043D\u0438 \u043D\u0430 \u043A\u043E\u0436\u043D\u043E\u0433\u043E,
      \u0456 \u0432 \u043A\u043E\u0436\u043D\u043E\u0433\u043E \u0454 \u0441\u0432\u043E\u044F
      \u043C\u0435\u0442\u0430. \u0406 \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430\u0448\u043E\u0433\u043E \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u043E\u0433\u043E
      \u0441\u0432\u0456\u0442\u0443 \u0434\u0438\u043A\u0442\u0443\u044E\u0442\u044C,
      \u0449\u043E \u0434\u043B\u044F \u043A\u043E\u0433\u043E\u0441\u044C \u0432\u0438\u0449\u043E\u044E
      \u043C\u0435\u0442\u043E\u044E \u0431\u0443\u0434\u0435 \u043F\u043E\u043C\u0435\u0440\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823979
    m_Localized: "\u041C\u0435\u043D\u0435 \u0432\u0436\u0435 \u043D\u0443\u0434\u0438\u0442\u044C
      \u0432\u0456\u0434 \u0442\u0432\u043E\u0454\u0457 \u043F\u0438\u0448\u043D\u043E\u043C\u043E\u0432\u043D\u043E\u0457
      \u043C\u0430\u044F\u0447\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823980
    m_Localized: "\u0421\u0443\u043C\u043D\u043E \u0446\u0435 \u0447\u0443\u0442\u0438.
      \u041E\u0434\u043D\u0430\u043A \u044F \u0437\u043D\u0430\u043B\u0430, \u0449\u043E
      \u0442\u0438 \u0441\u043A\u0430\u0436\u0435\u0448 \u0446\u0435, \u0449\u0435
      \u0434\u043E \u0442\u043E\u0433\u043E, \u044F\u043A \u0442\u0432\u043E\u0457
      \u0433\u0443\u0431\u0438 \u0440\u043E\u0437\u043A\u0440\u0438\u043B\u0438\u0441\u044F
      \u0434\u043B\u044F \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823981
    m_Localized: "\u0414\u0443\u0445\u0438 \u043F\u0440\u0435\u0434\u043A\u0456\u0432
      \u0448\u0435\u043F\u043E\u0447\u0443\u0442\u044C \u043C\u0435\u043D\u0456 \u0456\u0441\u0442\u0438\u043D\u0443
      \u0456 \u0432\u043A\u0430\u0437\u0443\u044E\u0442\u044C \u0448\u043B\u044F\u0445,
      \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u044E\u0447\u0438 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454.
      \u0412\u043E\u043D\u0438 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u043B\u0438
      \u043C\u0435\u043D\u0456, \u0449\u043E \u0442\u0438 \u0437'\u044F\u0432\u0438\u0448\u0441\u044F
      \u0441\u044E\u0434\u0438, \u0449\u043E\u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438.
      \u0411\u0430\u0447\u0438\u0448, \u043C\u0456\u0439 \u0432\u043B\u0430\u0434\u0438\u043A\u0430
      \u0447\u0435\u043A\u0430\u0454 \u0432\u0456\u0434 \u043C\u0435\u043D\u0435
      \u0443\u0441\u043F\u0456\u0445\u0456\u0432 \u0443 \u0432\u0438\u0432\u0447\u0435\u043D\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0456\u0445
      \u0437\u0430\u043A\u043B\u044F\u0442\u044C, \u0449\u043E \u043D\u0430\u0448\u0456
      \u043F\u0440\u0435\u0434\u043A\u0438 \u043D\u0430\u043A\u043B\u0430\u043B\u0438
      \u043D\u0430 \u0446\u0435 \u043C\u0456\u0441\u0442\u043E. \u0412\u043E\u043D\u0438
      \u043F\u043E\u0441\u043B\u0443\u0436\u0430\u0442\u044C \u0432\u0435\u043B\u0438\u0447\u0456
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443, \u043A\u043E\u043B\u0438 \u0441\u043E\u0442\u043D\u0456
      \u043D\u0430\u0448\u0438\u0445 \u0434\u0440\u0435\u0432\u043D\u0456\u0445 \u043C\u0435\u0440\u0442\u0432\u0438\u0445
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u043E\u0431\u0440\u0443\u0448\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u0449\u0435 \u0436\u0438\u0432\u0438\u0445.
      \u0406 \u0442\u0432\u043E\u0454 \u0441\u0435\u0440\u0446\u0435, \u0441\u0435\u0440\u0446\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u043D\u0456
      - \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442,
      \u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u043C\u0435\u043D\u0456
      \u0434\u043B\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u043C\u0456\u0441\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823982
    m_Localized: "\u0422\u0430\u043A\u0430 \u0442\u0432\u043E\u044F \u0440\u043E\u043B\u044C
      \u0443 \u043F\u043B\u0430\u043D\u0430\u0445 \u043B\u0435\u0433\u0430\u0442\u0430.
      \u0422\u0432\u043E\u044F \u043C\u0435\u0442\u0430 \u0436\u0438\u0442\u0442\u044F,
      \u0442\u0432\u043E\u0454 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F.
      \u0411\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0433\u0456\u0434\u043D\u0438\u0439
      \u0441\u0438\u043D \u041B\u0435\u0433\u0456\u043E\u043D\u0443 \u0431\u0443\u0432
      \u0431\u0438 \u0440\u0430\u0434\u0438\u0439 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u0441\u0432\u043E\u044E \u0434\u043E\u043B\u044E, \u0442\u0438 \u0436... \u0442\u0430\u043A,
      \u044F \u0432\u0436\u0435 \u0431\u0430\u0447\u0443, \u044F\u043A \u0442\u0438
      \u0432\u0447\u0438\u043D\u0438\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823983
    m_Localized: "\u042F \u0436\u0438\u0432\u0430... \u0406 \u0443 \u043C\u0435\u043D\u0435
      \u043A\u043D\u0438\u0433\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823984
    m_Localized: "\u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0432\u0456\u0440\u0438\u0442\u044C\u0441\u044F.
      \u041D\u0430\u0447\u0435 \u0449\u043E\u0441\u044C \u043F\u0456\u0448\u043B\u043E
      \u043D\u0435 \u0442\u0430\u043A, \u044F\u043A \u043F\u043E\u0432\u0438\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823985
    m_Localized: "\u0411\u0440\u0440... \u0446\u044F \u0447\u0430\u043A\u043B\u0443\u043D\u043A\u0430,
      \u0441\u0445\u043E\u0436\u0435, \u043F\u0440\u0438\u043C\u0443\u0434\u0440\u0438\u043B\u0430\u0441\u044F
      \u0437\u0430\u043F\u0443\u0434\u0440\u0438\u0442\u0438 \u043C\u0435\u043D\u0456
      \u043C\u0456\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823986
    m_Localized: "\u0422\u0430\u043A \u0447\u0438 \u0456\u043D\u0430\u043A\u0448\u0435,
      \u0441\u043F\u0440\u0430\u0432\u0443 \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E.
      \u0422\u0435\u043F\u0435\u0440 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u043B\u0438\u0448\u0435 \u044F\u043A\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438
      \u0432\u0441\u0456 \u043C\u043E\u0457 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0438
      \u0434\u043E\u0434\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823987
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0446\u0435\u0439
      \u0432\u0443\u0437\u043E\u043B \u0437\u0432'\u044F\u0437\u043A\u0443 \u0437\u043C\u043E\u0436\u0435
      \u0434\u043E\u0431\u0438\u0442\u0438 \u0434\u043E \u0421\u0442\u0456\u0439\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737823988
    m_Localized: "\u0426\u044F \u0441\u0445\u0438\u0431\u043B\u0435\u043D\u0430 \u0432\u0456\u0434\u044C\u043C\u0430
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u0442\u0443\u0442
      \u043A\u043E\u043B\u0443\u043F\u0430\u043B\u0430\u0441\u044F. \u0421\u043B\u0456\u0434
      \u0432\u0438\u0432\u0447\u0438\u0442\u0438 \u0446\u0435\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439
      \u0434\u043E\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823989
    m_Localized: "\u041D\u0435\u043C\u0430\u0454 \u0441\u0443\u043C\u043D\u0456\u0432\u0456\u0432,
      \u0446\u0435 - \u0432\u0443\u0437\u043E\u043B \u0437\u0432'\u044F\u0437\u043A\u0443.
      \u0412\u0435\u043B\u044C\u043C\u0438 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439.
      \u0417 \u0439\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0456\u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u043C
      \u0441\u0445\u043E\u0436\u0438\u043C \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0454\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823990
    m_Localized: "\u0427\u0438 \u0437\u043C\u043E\u0436\u0443 \u044F \u0432\u0438\u0439\u0442\u0438
      \u043D\u0430 \u0437\u0432'\u044F\u0437\u043E\u043A \u0456\u0437 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C?
      \u0411\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E, \u0432\u0430\u0440\u0442\u043E
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737823991
    m_Localized: "*\u0412\u0438\u043A\u043E\u043D\u0443\u0454\u0442\u044C\u0441\u044F
