      \u0432\u0456\u0434 \u0447\u043E\u0440\u043D\u043E\u0457 \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241624
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241625
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0456\u0437 \u0431\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0457 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u0457
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0438 \u0437\u0456 \u0437\u043D\u0430\u043A\u043E\u043C
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241626
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0432\u043E\u0457\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241627
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u0449\u043E \u043F\u043E\u0431\u0443\u0432\u0430\u0432
      \u043D\u0435 \u0432 \u043E\u0434\u043D\u0456\u0439 \u0432\u0435\u043B\u0438\u043A\u0456\u0439
      \u0431\u0438\u0442\u0432\u0456. \u0419\u043E\u0433\u043E \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0430
      \u0441\u0438\u043B\u0430 \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430
      \u0432\u0456\u0434 \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241628
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241629
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0456\u0437 \u0442\u0440\u0456\u0441\u043D\u0443\u0442\u043E\u0457 \u043B\u0456\u043D\u0437\u0438
      \u0432\u0456\u0434 \u043E\u043F\u0442\u0438\u0447\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0446\u0456\u043B\u0443,
      \u044F\u043A\u0438\u0439, \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E,
      \u0432\u043E\u043B\u043E\u0434\u0456\u0454 \u044F\u043A\u043E\u044E\u0441\u044C
      \u043C\u0430\u0433\u0456\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241630
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0431\u0435\u0440\u0441\u0435\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241631
    m_Localized: "\u0414\u0435\u0440\u0435\u0432'\u044F\u043D\u0438\u0439 \u0430\u043C\u0443\u043B\u0435\u0442,
      \u0432\u0435\u0441\u044C \u0432\u043A\u0440\u0438\u0442\u0438\u0439 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u0438\u043C
      \u0440\u0456\u0437\u044C\u0431\u043B\u0435\u043D\u043D\u044F\u043C \u0456 \u0437\u0430\u0441\u043E\u0445\u043B\u043E\u044E
      \u043A\u0440\u043E\u0432'\u044E. \u041D\u0430 \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u043C\u0443
      \u0431\u043E\u0446\u0456 \u043D\u0430\u043F\u0438\u0441 \"\u0429\u043E \u0432\u0436\u0435
      \u0437\u0434\u043E\u0445\u043B\u043E, \u0434\u0440\u0443\u0433\u0438\u0439
      \u0440\u0430\u0437 \u043D\u0435 \u0437\u0434\u043E\u0445\u043D\u0435\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241632
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0430\u0434\u0435\u043F\u0442\u0430"
