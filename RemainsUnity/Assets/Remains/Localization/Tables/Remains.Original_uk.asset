  - m_Id: 2725241235
    m_Localized: "\u0425\u043E\u0447\u0430 \u0446\u0435\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
      \u0456 \u043D\u0435 \u043D\u0430\u0437\u0432\u0435\u0448 \u0437\u0431\u0440\u043E\u0454\u044E
      \u0432 \u043F\u043E\u0432\u043D\u043E\u043C\u0443 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u0456,
      \u0432\u0456\u043D \u0446\u0456\u043B\u043A\u043E\u043C \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u043F\u0456\u0434\u043F\u0430\u043B\u0438\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0430
      \u0456 \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C \u0437\u0430\u0432\u0434\u0430\u0442\u0438
      \u0439\u043E\u043C\u0443 \u0447\u0438\u043C\u0430\u043B\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C."
