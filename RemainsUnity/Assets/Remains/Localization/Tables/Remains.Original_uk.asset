    m_Localized: "\u0428\u0435\u0441\u0442\u0435\u0440\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242030
    m_Localized: "\u041D\u0435\u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430, \u0430\u043B\u0435
      \u043D\u0435\u0445\u0430\u0439 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0430\u043C'\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242031
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B \"\u041A\u0456\u0431\u0435\u0440\u043F\u043E\u043D\u0456\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725242032
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B, \u0449\u043E \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0432\u0441\u044F
      \u0434\u043E \u0412\u0456\u0439\u043D\u0438 \u044F\u043A\u0438\u043C\u043E\u0441\u044C
      \u0442\u043E\u0432\u0430\u0440\u0438\u0441\u0442\u0432\u043E\u043C, \u044F\u043A\u0435
      \u043F\u0440\u043E\u0441\u0443\u0432\u0430\u043B\u043E \u0456\u0434\u0435\u0457
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u043F\u043E\u043D\u0456
      \u043D\u0430 \u043A\u0456\u0431\u043E\u0440\u0433\u0456\u0432. \u0412\u0438\u0445\u043E\u0434\u0438\u0432
      \u043B\u0438\u0448\u0435 \u043E\u0434\u0438\u043D \u0440\u0456\u043A, \u043F\u0456\u0441\u043B\u044F
      \u0447\u043E\u0433\u043E \u0431\u0443\u0432 \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u0438\u0439
      \u0437 \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E-\u0435\u0442\u0438\u0447\u043D\u0438\u0445
      \u043C\u0456\u0440\u043A\u0443\u0432\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242033
    m_Localized: "\u041A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242034
    m_Localized: "\u041F\u0430\u0447\u043A\u0430 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u044C
      \u044F\u043A\u043E\u0457\u0441\u044C \u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456. \u0420\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0432 \u043D\u0438\u0445 \u043C\u043E\u0436\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0444\u0430\u0445\u0456\u0432\u0435\u0446\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242035
    m_Localized: "\u041A\u0440\u0438\u0436\u0430\u043D\u0438\u0439 \u0441\u0430\u043F\u0444\u0456\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242036
    m_Localized: "\u0412\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439 \u0441\u0430\u043F\u0444\u0456\u0440,
      \u0449\u043E \u043F\u043E\u0448\u0438\u0440\u044E\u0454 \u043D\u0430\u0432\u043A\u043E\u043B\u043E
      \u0441\u0435\u0431\u0435 \u043C\u043E\u0440\u043E\u0437\u043D\u0443 \u0430\u0443\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242037
    m_Localized: "\u0412\u043E\u0433\u043D\u044F\u043D\u0438\u0439 \u0440\u0443\u0431\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242038
    m_Localized: "\u0412\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439 \u0440\u0443\u0431\u0456\u043D,
      \u0449\u043E \u0441\u044F\u0454 \u0432\u043E\u0433\u043D\u0435\u043D\u043D\u0438\u043C
      \u0441\u0432\u0456\u0442\u043B\u043E\u043C \u0456 \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0454
      \u0442\u0435\u043F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242039
    m_Localized: "\u041C\u043E\u0440\u0441\u044C\u043A\u0438\u0439 \u0441\u043C\u0430\u0440\u0430\u0433\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242040
    m_Localized: "\u0412\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439 \u0441\u043C\u0430\u0440\u0430\u0433\u0434,
      \u044F\u043A\u0438\u0439 \u0447\u043E\u043C\u0443\u0441\u044C \u0437\u0430\u0432\u0436\u0434\u0438
      \u0432\u043E\u043B\u043E\u0433\u0438\u0439 \u0456 \u043F\u0430\u0445\u043D\u0435
      \u043C\u043E\u0440\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242041
    m_Localized: "\u0428\u0442\u0430\u043D\u0433\u0435\u043D\u0446\u0438\u0440\u043A\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242042
    m_Localized: "\u041F\u0440\u0438\u043B\u0430\u0434 \u0434\u043B\u044F \u0442\u043E\u0447\u043D\u043E\u0433\u043E
      \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242043
    m_Localized: "\u0413\u0456\u0434\u0440\u0430\u0432\u043B\u0456\u0447\u043D\u0438\u0439
      \u0431\u043E\u043B\u0442\u043E\u0440\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242044
    m_Localized: "\u041C\u043E\u0436\u0435 \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u0442\u043E\u0432\u0441\u0442\u0438\u0439
      \u0437\u0430\u043B\u0456\u0437\u043D\u0438\u0439 \u043F\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242045
    m_Localized: "\u041E\u0441\u0446\u0438\u043B\u043E\u0433\u0440\u0430\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242046
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u0438\u0439 \u043F\u0440\u0438\u043B\u0430\u0434
      \u0434\u043B\u044F \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0456\u0432 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u043E\u0433\u043E
      \u0441\u0438\u0433\u043D\u0430\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242047
    m_Localized: "\u042F\u0449\u0438\u043A \u0456\u0437 \u043D\u043E\u0432\u0438\u043C\u0438
      \u0431\u043E\u043B\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242048
    m_Localized: "\u0426\u0456\u043B\u0438\u0439 \u044F\u0449\u0438\u043A \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0445
      \u0431\u043E\u043B\u0442\u0456\u0432 \u0456 \u0448\u0443\u0440\u0443\u043F\u0456\u0432
      \u0443\u0441\u0456\u0445 \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432.
      \u041C\u0440\u0456\u044F \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u043C\u0435\u0445\u0430\u043D\u0456\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242049
    m_Localized: "\u042F\u0449\u0438\u043A \u0456\u0437 \u043D\u043E\u0432\u0438\u043C\u0438
      \u0433\u0430\u0439\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242050
    m_Localized: "\u0426\u0456\u043B\u0438\u0439 \u044F\u0449\u0438\u043A \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0445
      \u0433\u0430\u0439\u043E\u043A \u0456 \u0448\u0430\u0439\u0431 \u0443\u0441\u0456\u0445
      \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432. \u041C\u0440\u0456\u044F
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0456\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242051
    m_Localized: "\"\u041D\u0435\u0431\u0435\u0441\u043D\u0430 \u041C\u0435\u0445\u0430\u043D\u0456\u043A\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725242052
    m_Localized: "\u041A\u043D\u0438\u0433\u0430, \u0432 \u044F\u043A\u0456\u0439
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E \u0440\u0443\u0445 \u043D\u0435\u0431\u0435\u0441\u043D\u0438\u0445
      \u0442\u0456\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242053
    m_Localized: "\u041A\u0430\u043D\u0456\u0441\u0442\u0440\u0430 \u0437 \u0433\u043B\u0456\u0446\u0435\u0440\u0438\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242054
    m_Localized: "\u041F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u0430 \u043A\u0430\u043D\u0456\u0441\u0442\u0440\u0430,
      \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0432'\u044F\u0437\u043A\u0443
      \u043F\u0440\u043E\u0437\u043E\u0440\u0443 \u0440\u0456\u0434\u0438\u043D\u0443.
      \u0412\u043E\u043B\u043E\u0434\u0456\u044E\u0447\u0438 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u043C\u0438
      \u0437\u043D\u0430\u043D\u043D\u044F\u043C\u0438, \u043C\u043E\u0436\u043D\u0430
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0457\u0457
      \u043D\u0430 \u0432\u0438\u0431\u0443\u0445\u043E\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u043D\u0456\u0442\u0440\u043E\u0433\u043B\u0456\u0446\u0435\u0440\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242055
    m_Localized: "\u0414\u0438\u0441\u043A \u0437 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0454\u044E
      \u043F\u0440\u043E \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242056
    m_Localized: "\u041D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0434\u0438\u0441\u043A\u0443
      \u043C\u0456\u0441\u0442\u044F\u0442\u044C\u0441\u044F \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F,
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0456 \u0441\u0445\u0435\u043C\u0438
      \u0442\u0430 \u0456\u043D\u0448\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F,
      \u0432\u0438\u0432\u0447\u0438\u0432\u0448\u0438 \u044F\u043A\u0443, \u043C\u043E\u0436\u043D\u0430
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0432 \u0443\u0441\u0442\u0440\u043E\u0457 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0456\u0432.
      \u0425\u043E\u0447\u0430, \u043F\u0440\u044F\u043C\u043E \u0441\u043A\u0430\u0436\u0435\u043C\u043E,
      \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u0443 \u0432\u0430\u0441
      \u0432\u0438\u0439\u0434\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438
      \u0445\u043E\u0447 \u0449\u043E\u0441\u044C \u0456\u0437 \u0446\u044C\u043E\u0433\u043E,
      \u044F\u043A\u0449\u043E \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0438
      \u043D\u0435 \u0434\u0438\u043F\u043B\u043E\u043C\u043E\u0432\u0430\u043D\u0438\u0439
      \u0456\u043D\u0436\u0435\u043D\u0435\u0440-\u0440\u043E\u0431\u043E\u0442\u043E\u0442\u0435\u0445\u043D\u0456\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242057
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043D\u0456
      \u0441\u0438\u0433\u0430\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242058
    m_Localized: "\u041A\u043E\u0440\u043E\u0431\u043A\u0430 \u0441\u0438\u0433\u0430\u0440,
      \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u043E \u0437\u0430\u0432\u0435\u0437\u0435\u043D\u0430
      \u0437 \u043A\u0440\u0430\u0457\u043D\u0438 \u0437\u0435\u0431\u0440. \u0427\u0443\u0434\u043E\u0432\u0435
      \u043A\u0443\u0440\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242059
    m_Localized: "\u041B\u044E\u043B\u044C\u043A\u0430 \u0434\u043B\u044F \u043F\u0430\u043B\u0456\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242060
    m_Localized: "\u0427\u0443\u0434\u043E\u0432\u0430 \u043B\u044E\u043B\u044C\u043A\u0430
      \u0437 \u0432\u0438\u0448\u043D\u0435\u0432\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
      \u0421\u043C\u043E\u0443\u043A\u0456 \u041F\u0456\u0442 \u0431\u0443\u0434\u0435
      \u0440\u0430\u0434\u0438\u0439 \u0457\u0457 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242061
    m_Localized: "\u0411\u0443\u043B\u044C\u0431\u0443\u043B\u044F\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242062
    m_Localized: "\u041F\u0440\u0438\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0434\u043B\u044F \u0437\u0430\u0432\u0437\u044F\u0442\u0438\u0445 \u043A\u0443\u0440\u0446\u0456\u0432.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0421\u043C\u043E\u0443\u043A\u0456
      \u041F\u0456\u0442\u0443 \u0432\u043E\u043D\u043E \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242063
    m_Localized: "\u041F\u0430\u0447\u043A\u0430 \u0442\u044E\u0442\u044E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242064
    m_Localized: "\u041B\u0438\u0441\u0442\u043E\u0432\u0438\u0439 \u0442\u044E\u0442\u044E\u043D
      \u0434\u043B\u044F \u043B\u044E\u043B\u044C\u043A\u0438. \u0412\u0456\u0434\u043C\u0456\u043D\u043D\u043E
      \u0437\u0431\u0435\u0440\u0456\u0433\u0441\u044F, \u0421\u043C\u043E\u0443\u043A\u0456
      \u041F\u0456\u0442 \u0442\u043E\u0447\u043D\u043E \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u043D\u0430 \u043D\u044C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242065
    m_Localized: "\u0421\u0438\u0440\u043E\u0432\u0430\u0442\u043A\u0430 \u0432\u0456\u0434
      \u043F\u0438\u043B\u043E\u0432\u043E\u0457 \u043B\u0438\u0445\u043E\u043C\u0430\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242066
    m_Localized: "\u0404\u0434\u0438\u043D\u0456 \u0432\u0456\u0434\u043E\u043C\u0456
      \u043B\u0456\u043A\u0438 \u0432\u0456\u0434 \u0446\u0456\u0454\u0457 \u0445\u0432\u043E\u0440\u043E\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242067
    m_Localized: "\u0412\u043E\u0434\u043D\u0438\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242068
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439,
      \u0449\u043E \u043E\u0447\u0438\u0449\u0430\u0454 \u0432\u043E\u0434\u0443
      \u0432\u0456\u0434 \u0445\u0456\u043C\u0456\u0447\u043D\u0438\u0445 \u0434\u043E\u043C\u0456\u0448\u043E\u043A,
      \u043C\u0456\u043A\u0440\u043E\u0431\u0456\u0432 \u0456 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242069
    m_Localized: "\u0416\u0430\u0440-\u0431\u0430\u0442\u0430\u0440\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242070
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0436\u0430\u0440-\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u044E
      \u0434\u043B\u044F \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430
      \u043C\u0430\u0439\u0436\u0435 \u043D\u0435\u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043E\u0457
      \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456 \u0435\u043D\u0435\u0440\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242071
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442\u043D\u0456 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438
      \u041B\u0435\u0433\u0456\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242072
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u043C\u0430\u0454
      \u043D\u0430\u0437\u0432\u0443 \"\u12BD\u12E4\u12CC\u1247\u1215\u127D\u1290\u12E5\u121A\u1286\u1367\"
      - \u0449\u043E \u0431 \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u043B\u043E,
      \u0446\u0456\u043A\u0430\u0432\u043E? \u041D\u0430 \u0436\u0430\u043B\u044C,
      \u0432\u0438 \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0437\u043D\u0430\u0454\u0442\u0435
      \u043C\u043E\u0432\u0438 \u0437\u0435\u0431\u0440, \u0430 \u0442\u043E\u043C\u0443
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438 \u0446\u0435 \u043D\u0435
      \u0432\u0438\u0439\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242073
    m_Localized: "\u0422\u0430\u043B\u0456\u0441\u043C\u0430\u043D \u0437\u0456\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242074
    m_Localized: "\u041F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D,
      \u044F\u043A\u0438\u0439 \u0431\u0443\u0434\u0435 \u0434\u043E \u043B\u0438\u0446\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u043E\u043C\u0443
      \u0432\u043E\u0457\u043D\u0443. \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u0448\u043A\u043E\u0434\u0443 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242075
    m_Localized: "\u0422\u0430\u043B\u0456\u0441\u043C\u0430\u043D \u043C\u0456\u0441\u044F\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242076
    m_Localized: "\u041C\u043E\u0433\u0443\u0442\u043D\u0456\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D,
      \u0456\u0437 \u0441\u0438\u043B\u043E\u044E \u044F\u043A\u043E\u0433\u043E
      \u043C\u043E\u0436\u0435 \u0432\u043F\u043E\u0440\u0430\u0442\u0438\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
      \u0433\u0435\u0440\u043E\u0439. \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u0448\u043A\u043E\u0434\u0443 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242077
    m_Localized: "\u0422\u0430\u043B\u0456\u0441\u043C\u0430\u043D \u0441\u043E\u043D\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242078
    m_Localized: "\u0412\u0435\u043B\u0438\u0447\u043D\u0438\u0439 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D,
      \u0449\u043E \u0434\u0430\u0454 \u0441\u0432\u043E\u044E \u0441\u0438\u043B\u0443
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0431\u0440\u0430\u043D\u0438\u043C.
      \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454 \u0448\u043A\u043E\u0434\u0443
      \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242079
    m_Localized: "\u0422\u0430\u043B\u0456\u0441\u043C\u0430\u043D \u0435\u0444\u0456\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242080
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0438\u0439
      \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D, \u0433\u0456\u0434\u043D\u0438\u0439
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0445
      \u0456\u0437 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0445. \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u0448\u043A\u043E\u0434\u0443 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242081
    m_Localized: "\u0412\u0438\u043A\u0440\u0443\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242082
    m_Localized: "\u0412\u0438\u043A\u0440\u0443\u0442\u043A\u0430 \u0441\u0442\u0430\u043D\u0435
      \u0432 \u043F\u0440\u0438\u0433\u043E\u0434\u0456 \u0434\u043B\u044F \u0437\u043B\u043E\u043C\u0443
      \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u0438\u0445 \u0437\u0430\u043C\u043A\u0456\u0432.
      \u0422\u0430\u043A\u043E\u0436 \u0432\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u0448\u043F\u0438\u043B\u044C\u043A\u0438. \u042F\u043A\u0449\u043E \u0448\u043F\u0438\u043B\u044C\u043E\u043A
      \u043D\u0435\u043C\u0430\u0454, \u043C\u043E\u0436\u043D\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u0437\u0430\u043C\u043E\u043A \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043E\u0434\u043D\u0456\u0454\u0457
      \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0438, \u0430\u043B\u0435 \u0432
      \u0446\u044C\u043E\u043C\u0443 \u0440\u0430\u0437\u0456 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u0438
      \u0437\u0430\u043C\u043E\u043A \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0432\u0438\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242083
    m_Localized: "\u0412\u0438\u043A\u0440\u0443\u0442\u043A\u0430! \u041A\u043E\u0440\u0438\u0441\u043D\u0438\u0439
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442. \u0417 \u0457\u0457
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u043C\u043E\u0436\u043D\u0430 \u0437\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u043E\u0441\u0442\u0456 \u0437\u0430\u043C\u043A\u0438. \u041F\u043E\u0442\u0440\u0435\u043D\u0443\u0439\u0442\u0435\u0441\u044F
      \u043D\u0430 \u044F\u043A\u0456\u0439-\u043D\u0435\u0431\u0443\u0434\u044C
      \u0441\u043A\u0440\u0438\u043D\u0456. \u042F\u043A\u0449\u043E \u0437 \u043F\u0435\u0440\u0448\u043E\u0433\u043E
      \u0440\u0430\u0437\u0443 \u0437\u0430\u043C\u043E\u043A \u043D\u0435 \u043F\u0456\u0434\u0434\u0430\u0441\u0442\u044C\u0441\u044F
      - \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E! \u041F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0449\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242084
    m_Localized: "\u0428\u043F\u0438\u043B\u044C\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242085
    m_Localized: "\u0428\u043F\u0438\u043B\u044C\u043A\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u0434\u043B\u044F \u0437\u043B\u043E\u043C\u0443 \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u0438\u0445
      \u0437\u0430\u043C\u043A\u0456\u0432. \u041D\u0438\u043C\u0438 \u043C\u043E\u0436\u043D\u0430
      \u043D\u0430\u043C\u0430\u0446\u0443\u0432\u0430\u0442\u0438 \u0456 \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0442\u0438
      \u0448\u0442\u0438\u0444\u0442\u0438 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456
      \u0437\u0430\u043C\u043A\u0430, \u043D\u0435 \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E
      \u0440\u0438\u0437\u0438\u043A\u0443\u044E\u0447\u0438 \u0437\u043B\u0430\u043C\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E, \u044F\u043A \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0437\u043B\u043E\u043C\u0443 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0433\u0440\u0443\u0431\u043E\u0457 \u0441\u0438\u043B\u0438. \u0423 \u0440\u0430\u0437\u0456
      \u043D\u0435\u0432\u0434\u0430\u043B\u043E\u0457 \u0441\u043F\u0440\u043E\u0431\u0438,
      \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u0437\u043B\u0430\u043C\u0430\u0454\u0442\u044C\u0441\u044F \u0448\u043F\u0438\u043B\u044C\u043A\u0430,
      \u0430 \u043D\u0435 \u0437\u0430\u043C\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242086
    m_Localized: "\u0422\u0438\u0442\u0430\u043D\u043E\u0432\u0430 \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242087
    m_Localized: "\u041F\u0435\u0440\u0448\u043E\u043A\u043B\u0430\u0441\u043D\u0430
      \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0430 \u0437 \u043D\u0430\u0439\u043C\u0456\u0446\u043D\u0456\u0448\u043E\u0433\u043E
      \u0442\u0438\u0442\u0430\u043D\u043E\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0443,
      \u043C\u0430\u0454 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0432\u0456\u0434\u043A\u0440\u0443\u0442\u0438\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0439\u0456\u0440\u0436\u0430\u0432\u0456\u0448\u0456
      \u0431\u043E\u043B\u0442\u0438. \u041D\u0443 \u0430 \u0432\u0430\u043C \u0432\u043E\u043D\u0430
      \u0441\u0442\u0430\u043D\u0435 \u0432 \u043F\u0440\u0438\u0433\u043E\u0434\u0456
      \u0434\u043B\u044F \u0437\u043B\u043E\u043C\u0443 \u0437\u0430\u043C\u043A\u0456\u0432,
      \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0432\u0448\u0438 \u0432\u0430\u0448
      \u0440\u0456\u0432\u0435\u043D\u044C \u0437\u043B\u043E\u043C\u0443 \u043D\u0430
      #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242088
    m_Localized: "\u0421\u0442\u0435\u0442\u043E\u0441\u043A\u043E\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242089
    m_Localized: "\u041C\u0435\u0434\u0438\u0447\u043D\u0438\u0439 \u043F\u0440\u0438\u043B\u0430\u0434,
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0434\u043B\u044F
      \u0432\u0438\u0441\u043B\u0443\u0445\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F
      \u0437\u0432\u0443\u043A\u0456\u0432 \u0432\u0456\u0434 \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0445
      \u043E\u0440\u0433\u0430\u043D\u0456\u0432... \u0430\u0431\u043E \u0436 \u0437\u0432\u0443\u043A\u0456\u0432,
      \u044F\u043A\u0456 \u0432\u0438\u0434\u0430\u0454 \u0437\u0430\u043C\u043E\u043A
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0437\u043B\u043E\u043C\u0443. \u041F\u0456\u0434\u0432\u0438\u0449\u0443\u0454
      \u0432\u0430\u0448 \u0440\u0456\u0432\u0435\u043D\u044C \u0437\u043B\u043E\u043C\u0443
      \u0437\u0430\u043C\u043A\u0456\u0432 \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242090
    m_Localized: "\u0410\u043B\u043C\u0430\u0437\u043D\u0438\u0439 \u0431\u0440\u0443\u0441\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242091
    m_Localized: "\u0414\u0443\u0436\u0435 \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0439
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0434\u043B\u044F
      \u0437\u0430\u0442\u043E\u0447\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0431\u0440\u043E\u0457.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0432\u0436\u0434\u0438 \u043C\u0430\u0439\u0442\u0435
      \u0439\u043E\u0433\u043E \u043F\u0440\u0438 \u0441\u043E\u0431\u0456, \u0456
      \u0432\u0456\u043D \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u044C \u0448\u043A\u043E\u0434\u0443
      \u0432\u0430\u0448\u043E\u0457 \u043A\u043E\u043B\u044E\u0447\u043E-\u0440\u0456\u0436\u0443\u0447\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242092
    m_Localized: "\u0411\u0456\u043D\u043E\u043A\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242093
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u0439 \u0431\u0456\u043D\u043E\u043A\u043B\u044C
      \u0456\u0437 \u043F\u043E\u0434\u0440\u044F\u043F\u0430\u043D\u0438\u043C\u0438
      \u043B\u0456\u043D\u0437\u0430\u043C\u0438, \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A
      \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242094
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u0431\u043E\u043C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242095
    m_Localized: "\u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0443\u0432\u0456\u0439\u0442\u0438
      \u0432 \u0431\u0443\u043D\u043A\u0435\u0440 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432. \u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242096
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0434\u043E\u043B\u0456 \"\u0414\u0443\u0440\u0435\u043D\u044C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725242097
    m_Localized: "\u0414\u0430\u0454 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0437\u043C\u0456\u043D\u0438\u0442\u0438
      \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C \u0433\u0440\u0438
      \u043D\u0430 \"\u0434\u0443\u0436\u0435 \u043B\u0435\u0433\u043A\u0443\"."
