  - m_Id: 2737823953
    m_Localized: "\u0413\u0430\u0440\u0430\u0437\u0434, \u0437\u0440\u043E\u0431\u0438\u043C\u043E
      \u043F\u043E-\u0456\u043D\u0448\u043E\u043C\u0443. \u0421\u043A\u043E\u043F\u0456\u044E\u0432\u0430\u0442\u0438
      \u0444\u0430\u0439\u043B \u0456 \u0432\u0456\u0434\u043D\u0435\u0441\u0442\u0438
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u043C \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C.
      \u041D\u0435\u043C\u0430\u0454 \u043D\u0456\u0447\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0456\u0448\u043E\u0433\u043E."
