      \u0432\u0430\u043C \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435760
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435761
    m_Localized: "\u0412\u0438 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044F
      \u043D\u0430 \u0445\u043E\u0445\u0443\u043B\u044E. \u0423 \u0442\u0430\u043A\u043E\u043C\u0443
      \u0441\u0442\u0430\u043D\u0456 \u0432\u0438 \u0437\u0434\u0430\u0442\u043D\u0456
      \u043F\u0440\u043E\u043B\u0430\u0437\u0438\u0442\u0438 \u0432 \u0434\u0443\u0436\u0435
      \u0432\u0443\u0437\u044C\u043A\u0456 \u043F\u0440\u043E\u0445\u043E\u0434\u0438.
      \u0423\u0432\u0430\u0433\u0430! \u0429\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
      \u0441\u0432\u043E\u044E \u043A\u043E\u043B\u0438\u0448\u043D\u044E \u0444\u043E\u0440\u043C\u0443,
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C @1. \u041F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u043C\u0456\u0441\u0446\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435762
    m_Localized: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435763
    m_Localized: "\u0412\u0430\u0441 \u0442\u043E\u0440\u043A\u043D\u0443\u043B\u0430\u0441\u044F
      \u0442\u0435\u043C\u043D\u0430 \u0439 \u043C\u043E\u0433\u0443\u0442\u043D\u044F
      \u043C\u0430\u0433\u0456\u044F. \u041B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456
      \u0437\u0456\u043B\u043B\u044F \u043D\u0435 \u0431\u0443\u0434\u0443\u0442\u044C
      \u0432\u0430\u0441 \u0437\u0446\u0456\u043B\u044E\u0432\u0430\u0442\u0438,
      \u043F\u043E\u043A\u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F
      \u043D\u0435 \u0431\u0443\u0434\u0435 \u0437\u043D\u044F\u0442\u043E. \u0417\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E
      \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0443\u044E\u0447\u043E\u0433\u043E
      \u043C\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435764
    m_Localized: "\u0412\u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0456!"
