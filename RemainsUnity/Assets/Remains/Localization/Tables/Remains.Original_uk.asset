      \u0443 \u043A\u043E\u043C\u0456\u0440\u043A\u0443 \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0443\u043F\u0443. \u0422\u0430 \u0441\u0430\u043C\u0430
      \u043A\u043B\u0430\u0432\u0456\u0448\u0430 \u0432 \u0433\u0440\u0456 - \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
