      m_Items: []
  - m_Id: 2725242151
    m_Localized: "\u0412\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F - \u0446\u0435 \u0437\u0431\u0440\u043E\u044F,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438 \u0440\u0456\u0437\u043D\u0456
      \u0442\u0438\u043F\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0456\u0432.
      \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C @1 \u0434\u043B\u044F
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242152
    m_Localized: "\u0410\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725242153
    m_Localized: "\u0412\u0438 \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u043A\u043D\u0438\u0433\u0443,
      \u0432 \u044F\u043A\u0456\u0439 \u043E\u043F\u0438\u0441\u0430\u043D\u043E
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \"\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0430
      \u043A\u0443\u043B\u044F\". \u0414\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0435\u043A\u0456\u043F\u0456\u0440\u0443\u0439\u0442\u0435 \u0439\u043E\u0433\u043E
      \u0442\u0430\u043A \u0441\u0430\u043C\u043E, \u044F\u043A \u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E. \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043D\u0435 \u0432\u0438\u043C\u0430\u0433\u0430\u0454 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432,
      \u0430\u043B\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u0432\u0430\u0448\u0443
      \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0441\u0438\u043B\u0443. \u0422\u0430\u043A\u043E\u0436
      \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0441\u043F\u0456\u043B\u044C\u043D\u043E \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E
      \u0456\u043D\u0448\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E, \u043A\u043B\u0430\u0432\u0456\u0448\u0435\u044E
      @1."
    m_Metadata:
      m_Items: []
