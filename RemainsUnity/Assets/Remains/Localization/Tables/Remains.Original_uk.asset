      \u0431\u0443\u0434\u0443\u0442\u044C \u0434\u0443\u0436\u0435 \u0440\u0430\u0434\u0456.
      \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0456\u0437 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0438\u043C\u0438
      \u0437\u0430\u043F\u0438\u0442\u0430\u043C\u0438 \u044F \u043F\u0440\u0438\u043D\u0435\u0441\u0443
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E, \u0430\u043B\u0435 \u0441\u0443\u0442\u044C
      \u0443 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443: \u043D\u0438\u043D\u0456
      \u041C\u0412\u0422 \u0456 \u041C\u0422\u041D \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u043D\u0430\u0434 \u043D\u043E\u0432\u0438\u043C \u0437\u0430\u0445\u0438\u0441\u0442\u043E\u043C
      \u0434\u043B\u044F \u043D\u0430\u0448\u0438\u0445 \u0441\u043E\u043B\u0434\u0430\u0442\u0456\u0432
