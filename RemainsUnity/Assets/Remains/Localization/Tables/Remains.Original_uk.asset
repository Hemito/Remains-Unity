    m_Localized: "*\u0412\u0456\u0434 \u043A\u043E\u0433\u043E: \u041C\u043E\u043D\u0456\u043D
      \u0420\u0435\u0439\u043D. \u041B\u0438\u0441\u0442 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E:
      69894 \u0434\u043D\u0456 \u0442\u043E\u043C\u0443. \u041D\u0430\u0437\u0432\u0430:
      \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0438*\n\t\"\u0417 \u0436\u0430\u043B\u0435\u043C
      \u0437\u043C\u0443\u0448\u0435\u043D\u0438\u0439 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0442\u0438,
      \u0449\u043E \u043F\u043E\u0434\u0456\u044F \u0442\u0438\u0436\u043D\u0435\u0432\u043E\u0457
      \u0434\u0430\u0432\u043D\u0438\u043D\u0438, \u044F\u043A\u0443 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u0431\u0443\u043B\u043E \u0441\u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043E
      \u0437\u0430 \u043E\u0434\u0438\u043D\u0438\u0447\u043D\u0438\u0439 \u0432\u0438\u043F\u0430\u0434\u043E\u043A,
      \u0432\u043E\u0447\u0435\u0432\u0438\u0434\u044C, \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0454 \u043F\u0435\u0440\u0448\u043E\u044E \u0432 \u0441\u0435\u0440\u0456\u0457
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u043D\u043E\u0457
      \u043F\u0456\u0434\u0440\u0438\u0432\u043D\u043E\u0457 \u0434\u0456\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0456
      \u043F\u0440\u043E\u0442\u0438 \u043D\u0430\u0448\u043E\u0433\u043E \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430.
      \u0411\u0430 \u0431\u0456\u043B\u044C\u0448\u0435, \u0456\u0441\u043D\u0443\u0454
      \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C, \u0449\u043E
      \u0437\u0430 \u0446\u0438\u043C\u0438 \u0434\u0438\u0432\u0435\u0440\u0441\u0456\u044F\u043C\u0438
      \u0441\u0442\u043E\u044F\u0442\u044C \u043D\u0456 \u0431\u0430\u0433\u0430\u0442\u043E
      \u043D\u0456 \u043C\u0430\u043B\u043E \u043F\u043E\u043D\u0456 \u0437 \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u041C\u043E\u0440\u0430\u043B\u0456. \u0426\u0456\u0454\u0457 \u043D\u043E\u0447\u0456
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u043C \u0431\u0443\u043B\u043E
      \u0441\u043A\u043E\u0454\u043D\u043E \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u0435
      \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F \u043D\u0430
      \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044E \u0441\u043A\u043B\u0430\u0434\u0443
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0432
      \u043C\u0456\u0441\u0442\u0456 \u041C\u0435\u0439\u043D\u0445\u0435\u0442\u0442\u0435\u043D.
      \u041C\u0435\u0442\u043E\u044E \u0437\u043B\u043E\u0432\u043C\u0438\u0441\u043D\u0438\u043A\u0430
      \u0437\u043D\u043E\u0432\u0443 \u0441\u0442\u0430\u0432 \u0442\u0438\u0440\u0430\u0436
      \u043F\u043B\u0430\u043A\u0430\u0442\u0456\u0432, \u043F\u0440\u0438\u0441\u0432\u044F\u0447\u0435\u043D\u0438\u0445
      \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u0456\u0439 \u043F\u0435\u0440\u0435\u043C\u043E\u0437\u0456
      \u043D\u0430\u0448\u0438\u0445 \u0432\u0456\u0439\u0441\u044C\u043A \u043D\u0430\u0434
      \u0437\u0435\u0431\u0440\u0430\u043C\u0438 \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445
      \u0413\u0440\u0456\u0437\u043B\u0456. \u0422\u0438\u0440\u0430\u0436 \u0431\u0443\u043B\u043E
      \u0432\u0438\u043D\u0435\u0441\u0435\u043D\u043E \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E,
      \u0456\u043D\u0448\u0456 \u0446\u0456\u043D\u043D\u0456 \u0440\u0435\u0447\u0456,
      \u0449\u043E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043B\u0438\u0441\u044F
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0456, \u043D\u0435 \u0437\u0430\u0447\u0435\u043F\u0438\u043B\u0438.
      \u0422\u0456\u0454\u0457 \u0436 \u043D\u043E\u0447\u0456 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0432\u0438\u044F\u0432\u0438\u043B\u0438 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0434\u0435\u0441\u044F\u0442\u043A\u0456\u0432 \u043D\u0430\u043F\u0438\u0441\u0456\u0432
      \"\u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435 \u043F\u0440\u043E
      \u0440\u0456\u0437\u0430\u043D\u0438\u043D\u0443 \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445
      \u0413\u0440\u0456\u0437\u043B\u0456!\" \u043D\u0430 \u0441\u0442\u0456\u043D\u0430\u0445
      \u0431\u0443\u0434\u0456\u0432\u0435\u043B\u044C \u043C\u0456\u0441\u0442\u0430.
      \u0421\u043F\u0456\u0432\u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u0438
      \u043C\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0431\u0443\u043B\u0438 \u0437\u043C\u0443\u0448\u0435\u043D\u0456 \u0432
      \u0442\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u043E\u043C\u0443 \u043F\u043E\u0440\u044F\u0434\u043A\u0443
      \u043F\u0435\u0440\u0435\u0440\u0438\u0432\u0430\u0442\u0438 \u0441\u043E\u043D
      \u0456 \u043F\u0440\u044F\u043C\u0443\u0432\u0430\u0442\u0438 \u043D\u0430
      \u0437\u0431\u0438\u0440\u0430\u043B\u044C\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u043F\u0440\u043E\u0442\u0435 \u043F\u043E\u0448\u0438\u0440\u0435\u043D\u043D\u044F
      \u0447\u0443\u0442\u043E\u043A \u0441\u0435\u0440\u0435\u0434 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0443\u043D\u0438\u043A\u043D\u0443\u0442\u0438.
      \u0417 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430\u043C\u0438 \u0431\u0443\u043B\u043E
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0443
      \u0431\u0435\u0441\u0456\u0434\u0443. \u0413\u043E\u043B\u043E\u0432\u043D\u043E\u044E
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456\u0441\u0442\u044E \u0446\u044C\u043E\u0433\u043E
      \u0456\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0443 \u0454 \u0442\u0435,
      \u0449\u043E \u043F\u0440\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u0435
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044F \u043F\u043B\u0430\u043A\u0430\u0442\u0456\u0432
      \u0434\u043E \u0442\u0438\u0440\u0430\u0436\u0443 \u0437\u043D\u0430\u043B\u0438
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u043E\u043D\u0456 \u043D\u0430\u0448\u043E\u0433\u043E
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0442\u0430
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u041C\u043E\u0440\u0430\u043B\u0456,
      \u044F\u043A\u0456 \u0437\u0430\u0439\u043C\u0430\u044E\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u044E
      \u043F\u043E\u0434\u0456\u0439 \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445
      \u0413\u0440\u0456\u0437\u043B\u0456. \u042F \u0437 \u043F\u043E\u0432\u043D\u043E\u044E
      \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456\u0441\u0442\u044E \u043C\u043E\u0436\u0443
      \u0437\u0430\u043F\u0435\u0432\u043D\u0438\u0442\u0438, \u0449\u043E \u043D\u0456\u0445\u0442\u043E
      \u0437 \u043C\u043E\u0457\u0445 \u0441\u043F\u0456\u0432\u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u0456\u0432
      \u043D\u0435 \u043F\u0440\u0438\u0447\u0435\u0442\u043D\u0438\u0439 \u0434\u043E
      \u0446\u044C\u043E\u0433\u043E \u0437\u043B\u043E\u0447\u0438\u043D\u0443.
      \u0412\u0438\u0441\u043D\u043E\u0432\u043A\u0438 \u0437 \u0446\u0456\u0454\u0457
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0431\u0443\u0442\u0438 \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0456 \u0434\u0443\u0436\u0435
      \u043D\u0435\u0432\u0442\u0456\u0448\u043D\u0456.\""
