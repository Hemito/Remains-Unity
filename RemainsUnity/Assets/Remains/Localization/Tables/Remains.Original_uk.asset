    m_Localized: "*\u0421\u043F\u0438\u0441\u043E\u043A \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432:
      \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u044F \"\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\"
