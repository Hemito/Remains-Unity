      \u0440\u0430\u043D\u043A\u043E\u0432\u0438\u0445 \u0442\u0435\u0445\u0440\u043E\u0431\u0456\u0442
      \u0437\u0431\u0438\u0432\u0441\u044F \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u0447\u0430\u0441\u0443 \u0442\u0435\u0440\u043C\u043E\u043E\u0431\u0440\u043E\u0431\u043A\u0438:
