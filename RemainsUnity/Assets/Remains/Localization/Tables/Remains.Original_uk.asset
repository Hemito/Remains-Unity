  - m_Id: 2725241241
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
      \u043D\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u0442\u0430\u043A
      \u0442\u043E\u043C\u0443, \u0449\u043E \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438 \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456 \u0441\u043F\u0440\u044F\u043C\u043E\u0432\u0430\u043D\u0456
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0456
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0438. \u0412\u043E\u043D\u0438
      \u0437\u0434\u0430\u0442\u043D\u0456 \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0443\u0432\u0430\u0442\u0438
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0456 \u0441\u0445\u0435\u043C\u0438
      \u0440\u043E\u0431\u043E\u0442\u0456\u0432, \u0430\u043B\u0435 \u043D\u0435
      \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C \u043C\u0430\u0439\u0436\u0435
      \u043D\u0456\u044F\u043A\u043E\u0457 \u0448\u043A\u043E\u0434\u0438 \u0436\u0438\u0432\u0438\u043C
      \u0456\u0441\u0442\u043E\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241242
    m_Localized: "\u0428\u043E\u043A\u043E\u0432\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241243
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u0438\u043C\u0456\u0442\u0438\u0432\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F, \u0449\u043E \u0441\u0442\u0440\u0456\u043B\u044F\u0454
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u043C\u0438 \u0440\u043E\u0437\u0440\u044F\u0434\u0430\u043C\u0438.
      \u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0430 \u043D\u0435 \u0434\u043B\u044F
      \u0431\u043E\u044E, \u0430 \u0440\u0430\u0434\u0448\u0435 \u0434\u043B\u044F
      \u0437\u043D\u0435\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0437\u043B\u043E\u0447\u0438\u043D\u0446\u0456\u0432
      \u0430\u0431\u043E \u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241244
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0456\u0437 \u043F\u0456\u0434\u0437\u0430\u0440\u044F\u0434\u043A\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241245
    m_Localized: "\u041E\u0434\u0438\u043D \u0456\u0437 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0456\u0432
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0449\u043E \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432. \u0415\u043D\u0435\u0440\u0433\u0456\u044E
      \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456\u0432 \u0457\u0439
      \u0434\u0430\u0454 \"\u0432\u0456\u0447\u043D\u0430\" \u0441\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u044F,
      \u0437\u0430\u0440\u044F\u0434 \u0443 \u044F\u043A\u0456\u0439 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C \u0441\u043E\u0431\u043E\u044E. \u0410\u043B\u0435 \u0437\u0430
      \u0442\u0430\u043A\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0440\u043E\u0437\u043F\u043B\u0430\u0447\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043D\u0438\u0437\u044C\u043A\u043E\u044E \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044E
      \u0456 \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u0456\u043C\u0438 \u0431\u043E\u0439\u043E\u0432\u0438\u043C\u0438
      \u044F\u043A\u043E\u0441\u0442\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241246
    m_Localized: "\u0420\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u043A\u0430\u043B.375"
