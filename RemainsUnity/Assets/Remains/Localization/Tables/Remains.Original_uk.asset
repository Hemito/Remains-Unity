  - m_Id: 2729435465
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u041C\u0430\u0433\u0456\u044F\"
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454 \u0437\u0430 \u0432\u0430\u0448\u0456
      \u043F\u0456\u0437\u043D\u0430\u043D\u043D\u044F \u0432 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u0430\u0445, \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0447\u0438 \u043D\u0430 \u0441\u0438\u043B\u0443
      \u0432\u0430\u0448\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C,
      \u0430\u0442\u0430\u043A\u0443\u044E\u0447\u0438\u0445 \u0456 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0445.
      [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u0441\u0438\u043B\u0430 \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u043D\u0430 #1, \u0430
      \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0445 - \u043D\u0430 #2.[br]- \u0417
      \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C
      \u0431\u0443\u0434\u0435 \u0437\u043C\u0435\u043D\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 #3, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0432\u0430\u0448\u043E\u0457 \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
