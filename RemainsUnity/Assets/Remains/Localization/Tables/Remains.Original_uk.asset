  - m_Id: 2729435144
    m_Localized: "\u0421\u0442\u0430\u0442\u0443\u0435\u0442\u043A\u0430 \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u043E
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0457 \u0431\u0456\u043B\u043E\u0457
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0436\u043A\u0438 \u0437 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u043A\u043B\u0430\u0434\u0435\u043D\u043E\u044E \u0444\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u044E
      \u0433\u0440\u0438\u0432\u043E\u044E. \u0423\u0441\u0456\u043C \u0441\u0432\u043E\u0457\u043C
      \u0432\u0438\u0433\u043B\u044F\u0434\u043E\u043C \u0432\u043E\u043D\u0430 \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0454
      \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456\u0441\u0442\u044C \u0456 \u0442\u0432\u0435\u0440\u0434\u0456\u0441\u0442\u044C,
      \u043F\u043E\u0434\u0456\u0431\u043D\u0443 \u0434\u043E \u0434\u0456\u0430\u043C\u0430\u043D\u0442\u0456\u0432
      \u043D\u0430 \u0457\u0457 \u043A'\u044E\u0442\u0456\u043C\u0430\u0440\u0446\u0456,
      \u0456 \u0446\u0456 \u044F\u043A\u043E\u0441\u0442\u0456 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436 \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u0456
      \u0432\u0430\u043C. \u041D\u0430\u043F\u0438\u0441 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C: [\"\u0411\u0443\u0434\u044C
      \u043D\u0435\u043F\u043E\u0445\u0438\u0442\u043D\u0438\u043C!\"]."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435145
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435146
    m_Localized: "\u0421\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u044F \u0439
      \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0430 \u0440\u0435\u043B\u0456\u043A\u0432\u0456\u044F,
      \u0449\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0443
      \u043C\u0456\u0446\u044C \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430,
      \u0430\u043B\u0435 \u043F\u043E\u043D\u0435\u0432\u043E\u043B\u044E\u0454 \u0439\u043E\u0433\u043E
      \u0440\u043E\u0437\u0443\u043C. \u0423 \u0436\u043E\u0434\u043D\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0434\u044F\u0433\u0430\u0442\u0438
      \u0446\u0435\u0439 \u0430\u043C\u0443\u043B\u0435\u0442 \u043D\u0430 \u0448\u0438\u044E!
      \u0425\u043E\u0447\u0430 \u0439 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0447\u0438
      \u0443 \u0432\u0430\u0448\u0456\u0439 \u0441\u0443\u043C\u0446\u0456, \u0432\u0456\u043D
      \u043F\u043E\u0441\u0438\u043B\u0438\u0442\u044C \u0432\u0430\u0448\u0456 \u0431\u043E\u0439\u043E\u0432\u0456
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043D\u0430 #1
      \u0456 \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u044C \u0432\u0438\u0442\u0440\u0430\u0442\u0443
      \u043C\u0430\u0433\u0456\u0457 \u043D\u0430 #2."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435147
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430!
      \u0421\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u044F \u0439 \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0430
      \u0440\u0435\u043B\u0456\u043A\u0432\u0456\u044F, \u0449\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u043C\u0456\u0446\u044C \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430,
      \u0430\u043B\u0435 \u043F\u043E\u043D\u0435\u0432\u043E\u043B\u044E\u0454 \u0439\u043E\u0433\u043E
      \u0440\u043E\u0437\u0443\u043C. \u0412\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435
      \u0441\u0438\u043B\u044C\u043D\u0435 \u0431\u0430\u0436\u0430\u043D\u043D\u044F
      \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u043D\u0430\u0434\u0456\u0442\u0438
      \u0430\u043C\u0443\u043B\u0435\u0442 \u043D\u0430 \u0448\u0438\u044E, \u0430\u043B\u0435,
      \u0440\u043E\u0437\u0443\u043C\u0456\u044E\u0447\u0438 \u0432\u0441\u044E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443
      \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0435\u043E\u0431\u0430\u0447\u043D\u043E\u0433\u043E
      \u0432\u0447\u0438\u043D\u043A\u0443, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043A\u043B\u0430\u0434\u0435\u0442\u0435 \u0439\u043E\u0433\u043E \u0432
      \u0441\u0443\u043C\u043A\u0443. \u0406 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E,
      \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0447\u0438
      \u043F\u043E\u0440\u0443\u0447, \u0430\u043C\u0443\u043B\u0435\u0442 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u0432\u0430\u0448\u0443 \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435148
    m_Localized: "\u0427\u043E\u0440\u043D\u0430 \u043A\u043D\u0438\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435149
    m_Localized: "\u0424\u043E\u043B\u0456\u0430\u043D\u0442, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0439
      \u0443 \u0434\u0430\u0432\u043D\u0456 \u0447\u0430\u0441\u0438 \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u043C\u0438
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u043C\u0438 \u0430\u043B\u0445\u0456\u043C\u0456\u043A\u0430\u043C\u0438,
      \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0457\u0445\u043D\u0456
      \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u0456 \u0437\u043D\u0430\u043D\u043D\u044F.
      \u0410\u043B\u0435 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u043F\u0438\u0441\u0430\u043D\u0456
      \u0432 \u043A\u043D\u0438\u0437\u0456 \u0442\u0435\u043C\u043D\u0456 \u0437\u0430\u043A\u043B\u044F\u0442\u0442\u044F
      \u0456 \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u0456 \u0440\u0438\u0442\u0443\u0430\u043B\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C \u0456\u043D\u0442\u0435\u0440\u0435\u0441.
      \u0421\u0430\u043C\u0430 \u0432\u043E\u043D\u0430 - \u0442\u0430\u043A\u043E\u0436
      \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u0439
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442, \u0449\u043E \u0437\u0430\u0445\u0438\u0449\u0430\u0454
      \u0441\u0432\u043E\u0433\u043E \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430
      \u0432\u0456\u0434 \u0447\u043E\u0440\u043D\u043E\u0457 \u043C\u0430\u0433\u0456\u0457
      \u0456 \u0434\u0430\u0454 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043F\u043E\u0433\u043B\u0438\u043D\u0430\u0442\u0438 \u0436\u0438\u0442\u0442\u0454\u0432\u0443
      \u0441\u0438\u043B\u0443 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435150
    m_Localized: "\u0427\u043E\u0440\u043D\u0430 \u043A\u043D\u0438\u0433\u0430!
      \u0424\u043E\u043B\u0456\u0430\u043D\u0442, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0439
      \u0443 \u0434\u0430\u0432\u043D\u0456 \u0447\u0430\u0441\u0438 \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u043C\u0438
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u043C\u0438 \u0430\u043B\u0445\u0456\u043C\u0456\u043A\u0430\u043C\u0438,
      \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0457\u0445\u043D\u0456
      \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u0456 \u0437\u043D\u0430\u043D\u043D\u044F.
      \u0412\u0430\u043C \u0431\u0438 \u0434\u0443\u0436\u0435 \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F, \u044F\u043A\u0456
      \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u0456 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0456
      \u0432 \u0446\u0456\u0439 \u043A\u043D\u0438\u0437\u0456, \u0430\u043B\u0435
      \u0432\u043E\u043D\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430 \u043D\u0435\u0437\u043D\u0430\u0439\u043E\u043C\u043E\u044E
      \u043C\u043E\u0432\u043E\u044E. \u0406 \u043C\u0430\u0431\u0443\u0442\u044C,
      \u0446\u0435 \u043D\u0430 \u043A\u0440\u0430\u0449\u0435. \u041C\u0430\u044E\u0447\u0438
      \u043A\u043D\u0438\u0433\u0443 \u043F\u0440\u0438 \u0441\u043E\u0431\u0456,
      \u0432\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435 \u0434\u0435\u044F\u043A\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0447\u043E\u0440\u043D\u043E\u0457
      \u043C\u0430\u0433\u0456\u0457, \u0430 \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043F\u043E\u0433\u043B\u0438\u043D\u0430\u0442\u0438 \u0436\u0438\u0442\u0442\u0454\u0432\u0443
      \u0441\u0438\u043B\u0443 \u0432\u0431\u0438\u0442\u0438\u0445 \u0432\u0430\u043C\u0438
      \u043F\u043E\u043D\u0456, \u0437\u0435\u0431\u0440, \u0433\u0440\u0438\u0444\u043E\u043D\u0456\u0432
      \u0456 \u0430\u043B\u0456\u043A\u043E\u0440\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435151
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0431\u0430\u0440'\u0454\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435152
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0432 \u043E\u0431\u0440\u0430\u043D\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0431\u0430\u0440'\u0454\u0440,
      \u0449\u043E \u043F\u043E\u0433\u043B\u0438\u043D\u0430\u0454 \u0432\u043E\u0440\u043E\u0436\u0456
      \u043A\u0443\u043B\u0456 \u0442\u0430 \u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0441\u043D\u0430\u0440\u044F\u0434\u0438. \u0411\u0430\u0440'\u0454\u0440
      \u043C\u0430\u0454 \u043F\u0435\u0432\u043D\u0438\u0439 \u0437\u0430\u043F\u0430\u0441
      \u043C\u0456\u0446\u043D\u043E\u0441\u0442\u0456 \u0439 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0438\u0439
      \u0447\u0430\u0441 \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F,
      \u043F\u0456\u0441\u043B\u044F \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u044F
      \u044F\u043A\u043E\u0433\u043E \u0437\u043D\u0438\u043A\u0430\u0454. \u0412\u0456\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0454 \u0432\u0430\u0448\u0456
      \u0432\u043B\u0430\u0441\u043D\u0456 \u043A\u0443\u043B\u0456 \u0442\u0430
      \u0441\u043D\u0430\u0440\u044F\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435153
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435154
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043E\u0442\u043E\u0447\u0443\u0454 \u0432\u0430\u0441 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043C
      \u043F\u043E\u043B\u0435\u043C, \u0449\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
      \u0432\u0430\u0448 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A \u0431\u0440\u043E\u043D\u0456.
      \u0417\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0457 \u0448\u043A\u043E\u0434\u0438,
      \u043F\u0440\u043E\u0442\u0435 \u0441\u0438\u043B\u044C\u043D\u0456 \u0443\u0434\u0430\u0440\u0438,
      \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0456 \u043A\u0443\u043B\u0456
      \u0442\u0430 \u0432\u0438\u0431\u0443\u0445\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0442\u0438 \u0449\u0438\u0442 \u0456
      \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438
      \u0448\u043A\u043E\u0434\u0438, \u0445\u043E\u0447 \u0456 \u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043E\u0457.
      \u041C\u0430\u0454 \u043F\u0435\u0432\u043D\u0438\u0439 \u0437\u0430\u043F\u0430\u0441
      \u043C\u0456\u0446\u043D\u043E\u0441\u0442\u0456 \u0442\u0430 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0438\u0439
      \u0447\u0430\u0441 \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435155
    m_Localized: "\u041A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0438\u0439 \u0432\u0438\u0431\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435156
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0432\u0438\u0432\u0456\u043B\u044C\u043D\u044F\u0454 \u0432\u0430\u0448\u0443
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0443
      \u0441\u0438\u043B\u0443 \u0432 \u043E\u0434\u043D\u043E\u043C\u0443 \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u043C\u0443
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0456. \u0423\u0441\u0456\u0445
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432, \u0449\u043E \u0437\u043D\u0430\u0445\u043E\u0434\u044F\u0442\u044C\u0441\u044F
      \u043F\u043E\u0431\u043B\u0438\u0437\u0443 \u0432\u0456\u0434 \u0432\u0430\u0441,
      \u0432\u0456\u0434\u043A\u0438\u043D\u0435 \u0437 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u043E\u044E
      \u0441\u0438\u043B\u043E\u044E \u0456 \u043C\u043E\u0436\u0435 \u043D\u0435\u043D\u0430\u0434\u043E\u0432\u0433\u043E
      \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0438. \u0414\u0443\u0436\u0435
      \u043A\u043E\u0440\u0438\u0441\u043D\u043E, \u044F\u043A\u0449\u043E \u0432\u0430\u0441
      \u043E\u0442\u043E\u0447\u0438\u043B\u0438 \u0437 \u0443\u0441\u0456\u0445
      \u0431\u043E\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435157
    m_Localized: "\u041A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0438\u0439 \u0440\u0438\u0432\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435158
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454 \u0432\u0430\u0448\u0443
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0443
      \u0441\u0438\u043B\u0443 \u0434\u043B\u044F \u043D\u0430\u0434\u0430\u043D\u043D\u044F
      \u0432\u0430\u043C \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0433\u043E \u0441\u043F\u0440\u044F\u043C\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0443. \u041C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E
      \u0434\u043B\u044F \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F \u0432
      \u0431\u043E\u044E \u0430\u0431\u043E \u0434\u043B\u044F \u0434\u043E\u0441\u044F\u0433\u043D\u0435\u043D\u043D\u044F
      \u0432\u0430\u0436\u043A\u043E\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0445
      \u043C\u0456\u0441\u0446\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435159
    m_Localized: "\u041F\u043E\u043B\u0435 \u0441\u043F\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435160
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043E\u0442\u043E\u0447\u0443\u0454
      \u0432\u0430\u0441 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C \u043F\u043E\u043B\u0435\u043C,
      \u0449\u043E \u0443\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0454 \u0440\u0443\u0445
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u0432\u043E\u0440\u043E\u0436\u0438\u0445
      \u043E\u0431'\u0454\u043A\u0442\u0456\u0432. \u0417\u0456 \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \"\u041C\u0430\u0433\u0456\u044F\"
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454\u0442\u044C\u0441\u044F \u0440\u0430\u0434\u0456\u0443\u0441
      \u0434\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435161
    m_Localized: "\u041A\u0440\u0438\u0448\u0442\u0430\u043B\u0435\u0432\u0438\u0439
      \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435162
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0441\u0442\u0432\u043E\u0440\u044E\u0454 \u043D\u0430\u0432\u043A\u043E\u043B\u043E
      \u0432\u0430\u0441 \u043E\u0431\u043E\u043B\u043E\u043D\u043A\u0443, \u0441\u0445\u043E\u0436\u0443
      \u043D\u0430 \u043A\u0440\u0438\u0441\u0442\u0430\u043B. \u0412\u043E\u043D\u0430
      \u043F\u043E\u0433\u043B\u0438\u043D\u0430\u0454 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044E \u0448\u043A\u043E\u0434\u0443,
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0447\u0438 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u043C\u0430\u0433\u0456\u0447\u043D\u0443 \u0435\u043D\u0435\u0440\u0433\u0456\u044E
      \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u0437\u0434\u043E\u0440\u043E\u0432'\u044F.
      \u0414\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0456\u0448\u0443
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435163
    m_Localized: "\u041C\u0456\u0441\u044F\u0447\u043D\u0438\u0439 \u041A\u043B\u0438\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435164
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0454
      \u043F\u0440\u0438\u043C\u0430\u0440\u043D\u0438\u0439 \u041C\u0456\u0441\u044F\u0447\u043D\u0438\u0439
      \u041A\u043B\u0438\u043D\u043E\u043A, \u0449\u043E \u0431'\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u0430\u0448\u043E\u043C\u0443 \u0431\u043E\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435165
    m_Localized: "\u041F\u0440\u0438\u043C\u0430\u0440\u043D\u0430 \u0441\u0442\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435166
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
      \u0432 \u043E\u0431\u0440\u0430\u043D\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456
      \u043F\u0440\u0438\u043C\u0430\u0440\u043D\u0443 \u0441\u0442\u0456\u043D\u0443,
      \u0447\u0435\u0440\u0435\u0437 \u044F\u043A\u0443 \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0432\u0430\u0448\u0456 \u0432\u043E\u0440\u043E\u0433\u0438.
      \u0421\u0442\u0456\u043D\u0430 \u043C\u0430\u0454 \u043F\u0435\u0432\u043D\u0438\u0439
      \u0437\u0430\u043F\u0430\u0441 \u043C\u0456\u0446\u043D\u043E\u0441\u0442\u0456
      \u0439 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0438\u0439 \u0447\u0430\u0441
      \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F. \u0412\u0456\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0454 \u0432\u0441\u0456 \u043D\u0435\u0436\u0438\u0432\u0456
      \u043E\u0431'\u0454\u043A\u0442\u0438, \u043A\u0443\u043B\u0456, \u0441\u043D\u0430\u0440\u044F\u0434\u0438,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0441\u0432\u043E\u0433\u043E \u0442\u0432\u043E\u0440\u0446\u044F.
      \u0421\u0442\u0456\u043D\u0443 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0432 \u0434\u0432\u0435\u0440\u043D\u0438\u0445
      \u043E\u0442\u0432\u043E\u0440\u0430\u0445 \u0456 \u043D\u0430 \u0441\u0445\u043E\u0434\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435167
    m_Localized: "\u0429\u0438\u0442 \u043A\u0440\u043E\u0432\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435168
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u0432\u0430\u0448\u043E\u0457 \u043A\u0440\u043E\u0432\u0456,
      \u0449\u043E\u0431 \u043D\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u0435\u043A\u0443\u043D\u0434
      \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u043D\u0438\u0439
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0449\u0438\u0442. \u0412\u0456\u043D
      \u0434\u0430\u0454 \u043F\u043E\u0432\u043D\u0443 \u043D\u0435\u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0434\u043E \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u0456 \u043C\u043E\u0436\u0435 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u0432\u0430\u0441 \u0443 \u043D\u0430\u0439\u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0456\u0448\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442, \u0430\u043B\u0435 \u043F\u043B\u0430\u0442\u043E\u044E
      \u0437\u0430 \u0446\u0435 \u0454 \u0434\u0435\u044F\u043A\u0430 \u043A\u0440\u043E\u0432\u043E\u0432\u0442\u0440\u0430\u0442\u0430.
      \u041D\u0435 \u0441\u043F\u0440\u0430\u0446\u044E\u0454, \u044F\u043A\u0449\u043E
      \u043A\u0440\u043E\u0432\u0456 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435169
    m_Localized: "\u041F\u043E\u0441\u0438\u043B\u0435\u043D\u0430 \u0442\u043A\u0430\u043D\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435170
    m_Localized: "\u041C\u0456\u0446\u043D\u0438\u0439 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B
      \u0456\u0437 \u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u0448\u0430\u0440\u0456\u0432
      \u0449\u0456\u043B\u044C\u043D\u043E\u0457 \u0442\u043A\u0430\u043D\u0438\u043D\u0438,
      \u043C\u0456\u0436 \u044F\u043A\u0438\u043C\u0438 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0438\u0439
      \u0431\u0430\u043B\u0456\u0441\u0442\u0438\u0447\u043D\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0456\u0437 \u043F\u043E\u043B\u0456\u043C\u0435\u0440\u043D\u0438\u0445 \u0432\u043E\u043B\u043E\u043A\u043E\u043D.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430
      \u043B\u0435\u0433\u043A\u0438\u0445 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435171
    m_Localized: "\u041C\u0435\u0442\u0430\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u0430
      \u0442\u043A\u0430\u043D\u0438\u043D\u0430"
    m_Metadata:
