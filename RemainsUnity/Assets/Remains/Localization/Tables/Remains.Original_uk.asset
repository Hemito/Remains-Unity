    m_Metadata:
      m_Items: []
  - m_Id: 2733629896
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, @lp. \u0426\u0435 \u044F,
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A. \u0412\u0456\u0442\u0430\u044E,
      \u0442\u0438 \u0443\u0441\u043F\u0456\u0448\u043D\u043E \u0432\u0438\u043A\u043E\u043D\u0430\u043B\u0430
      \u0441\u0432\u043E\u0454 \u043F\u0435\u0440\u0448\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F.
      \u041F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437 \u043C\u0438
      \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u043C\u043E \u0444\u0430\u0439\u043B\u0438,
      \u043D\u0430 \u044F\u043A\u0456 \u0447\u0435\u043A\u0430\u043B\u0438 \u043C\u0430\u0439\u0436\u0435
      \u0434\u0432\u0430 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629897
    m_Localized: "\u0429\u043E? \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A?
      \u0422\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0448 \u0447\u0435\u0440\u0435\u0437
      \u0446\u0435\u0439 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B? \u0406
      \u044F \u043C\u043E\u0436\u0443 \u0442\u043E\u0431\u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629898
    m_Localized: "\u0422\u0430\u043A, @lp. \u0429\u043E\u0439\u043D\u043E \u0442\u0432\u0456\u0439
      \u041F\u0456\u043F\u0411\u0430\u043A \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0432
      \u043D\u0430 \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C\u0456 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443,
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u044F\u043A\u043E\u0457
      \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
      \u0423 \u0442\u0435\u0431\u0435, \u0437\u0432\u0456\u0441\u043D\u043E \u0436,
      \u0431\u0430\u0433\u0430\u0442\u043E \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u044C.
      \u0417\u0430\u0440\u0430\u0437 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0457\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629899
    m_Localized: "\u041F\u0438\u0442\u0430\u043D\u043D\u044F? \u0422\u0430\u043A,
      \u0437\u0432\u0456\u0441\u043D\u043E. \u0425\u0442\u043E \u0442\u0438? \u0406
      \u0445\u0442\u043E \u044F? \u0427\u043E\u043C\u0443 \u044F \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u044E \u043F\u0440\u043E
      \u0441\u0432\u043E\u0454 \u043C\u0438\u043D\u0443\u043B\u0435? \u0406... \u0449\u043E
      \u0446\u0435 \u0437\u0430 \u0444\u0430\u0439\u043B\u0438, \u044F\u043A\u0456
      \u0432\u0430\u043C \u0431\u0443\u043B\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629900
    m_Localized: "\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456 \u043D\u0430
      \u0432\u0441\u0456 \u0446\u0456 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F
      \u0432\u0437\u0430\u0454\u043C\u043E\u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0456.
      \u042F - \u0434\u0456\u0439\u0441\u043D\u043E \u0442\u0432\u0456\u0439 \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A,
      \u043F\u043E\u043D\u0456, \u044F\u043A\u043E\u0433\u043E \u0442\u0438 \u0437\u043D\u0430\u043B\u0430
      \u0432\u0441\u0435 \u0436\u0438\u0442\u0442\u044F. \u0421\u0432\u043E\u0454
      \u0456\u043C'\u044F \u044F \u043D\u0435 \u043C\u043E\u0436\u0443 \u043F\u043E\u043A\u0438
      \u0449\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438. \u0422\u0432\u0456\u0439
      \u0434\u0456\u043C, \u043C\u0456\u0441\u0446\u0435, \u0434\u0435 \u0442\u0438
      \u043D\u0430\u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044F \u0456 \u0432\u0438\u0440\u043E\u0441\u043B\u0430
      - \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456. \u041F\u043E\u0434\u0440\u043E\u0431\u0438\u0446\u0456
      \u043F\u0440\u043E \u043D\u044C\u043E\u0433\u043E \u044F \u0442\u0435\u0436
      \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0442\u0438
      \u043D\u0435 \u0432 \u043F\u0440\u0430\u0432\u0456, \u044F\u043A \u0456 \u043F\u0440\u043E
      \u0442\u0456 \u0444\u0430\u0439\u043B\u0438, \u044F\u043A\u0456 \u0442\u043E\u0431\u0456
      \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u043E \u0437\u043D\u0430\u0439\u0442\u0438.
      \u0426\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456 \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0456. \u0417\u0430\u0440\u0430\u0434\u0438
      \u0431\u0435\u0437\u043F\u0435\u043A\u0438 \u043D\u0430\u0448\u043E\u0433\u043E
      \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u0433\u043E \u0434\u043E\u043C\u0443
      \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u043D\u0430\u043A\u043B\u0430\u0441\u0442\u0438
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043F\u0430\u043C'\u044F\u0442\u0456
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430 \u0442\u0435\u0431\u0435
      \u0441\u0430\u043C\u0443. \u0429\u043E\u0431, \u044F\u043A\u0449\u043E \u0442\u0438
      \u043F\u043E\u043F\u0430\u0434\u0435\u0448\u0441\u044F \u0432\u043E\u0440\u043E\u0433\u043E\u0432\u0456,
      \u0432\u0456\u043D \u043D\u0435 \u0437\u043C\u0456\u0433 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u0442\u0435\u0431\u0435 \u043D\u0456\u0447\u043E\u0433\u043E.
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0442\u0438
      \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629901
    m_Localized: "\u041D\u0435\u0432\u0436\u0435 \u0446\u0435 \u0431\u0443\u043B\u043E
      \u0442\u0430\u043A \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629902
    m_Localized: "\u041D\u0430 \u0436\u0430\u043B\u044C, \u0446\u0435 \u0442\u0430\u043A.
      \u0423 \u043D\u0430\u0441 \u0431\u0430\u0433\u0430\u0442\u043E \u0432\u043E\u0440\u043E\u0433\u0456\u0432.
      \u041A\u043E\u043B\u0438 \u0442\u0438 \u0432\u0438\u043A\u043E\u043D\u0430\u0454\u0448
      \u043C\u0456\u0441\u0456\u044E \u0456 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0448\u0441\u044F,
      \u044F \u0437\u043D\u0456\u043C\u0443 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043F\u0430\u043C'\u044F\u0442\u0456, \u0456 \u0441\u043F\u043E\u0433\u0430\u0434\u0438
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0434\u043E
      \u0442\u0435\u0431\u0435. \u0410\u043B\u0435 \u043D\u0435 \u0440\u0430\u043D\u0456\u0448\u0435.
      \u0422\u0438 \u0441\u0430\u043C\u0430 \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F
      \u043D\u0430 \u0442\u0430\u043A\u0456 \u0443\u043C\u043E\u0432\u0438, \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629903
    m_Localized: "\u0422\u0430\u043A, \u044F \u0447\u0443\u043B\u0430 \u0430\u0443\u0434\u0456\u043E\u0437\u0430\u043F\u0438\u0441.
      \u0410\u043B\u0435 \u0432\u0456\u0434 \u0446\u044C\u043E\u0433\u043E \u043D\u0435
      \u043B\u0435\u0433\u0448\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629904
    m_Localized: "\u0420\u043E\u0437\u0443\u043C\u0456\u044E... \u0430\u043B\u0435
      \u044F \u0432\u0456\u0440\u044E \u0432 \u0442\u0435\u0431\u0435, \u0442\u0438
      \u0432\u043F\u043E\u0440\u0430\u0454\u0448\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629905
    m_Localized: "\u0410\u043B\u0435 \u0445\u043E\u0447 \u0449\u043E\u0441\u044C
      \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u0441\u043A\u0430\u0437\u0430\u0442\u0438
      \u043F\u0440\u043E \u043C\u0435\u0442\u0443 \u043C\u043E\u0454\u0457 \u043C\u0456\u0441\u0456\u0457?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629906
    m_Localized: "\u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043C\u0438
      \u0437\u0430\u0440\u0430\u0437 \u0456 \u0433\u043E\u0432\u043E\u0440\u0438\u043C\u043E
      \u0437 \u0442\u043E\u0431\u043E\u044E. \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456 \u0449\u0435 \u0437\u0430\u0434\u043E\u0432\u0433\u043E \u0434\u043E
      \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u044F \u0412\u0456\u0439\u043D\u0438
      \u0431\u0443\u043B\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0438\u043C
      \u0441\u0445\u043E\u0432\u0438\u0449\u0435\u043C \u0434\u043B\u044F \u0432\u0447\u0435\u043D\u0438\u0445
      \u0442\u0430 \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0456\u0432, \u044F\u043A\u0456
      \u0437\u0430\u0439\u043C\u0430\u043B\u0438\u0441\u044F \u043D\u0430\u0439\u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0438\u043C\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F\u043C\u0438
      \u0434\u043B\u044F \u0430\u0440\u043C\u0456\u0457 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.
      \u041F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E, \u044F\u043A \u0432\u043F\u0430\u043B\u0438
      \u0431\u043E\u043C\u0431\u0438 \u0456 \u0441\u0442\u0430\u0440\u0456\u0439
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457 \u043F\u0440\u0438\u0439\u0448\u043E\u0432
      \u043A\u0456\u043D\u0435\u0446\u044C, \u043C\u0438 \u043F\u0435\u0440\u0435\u0439\u0448\u043B\u0438
      \u043D\u0430 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u0435
      \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F. \u0423\u0432\u0435\u0441\u044C
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0421\u0442\u0456\u0439\u043B\u0430
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0433\u043B\u0438\u0431\u043E\u043A\u043E
      \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E, \u0430 \u0442\u043E\u0447\u043A\u0443
      \u0432\u0445\u043E\u0434\u0443 \u0442\u0438 \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435\u0448
      \u043D\u0430 \u0436\u043E\u0434\u043D\u0456\u0439 \u043A\u0430\u0440\u0442\u0456.
      \u0421\u0435\u043A\u0440\u0435\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u043B\u044F
      \u043D\u0430\u0441 \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0430.
      \u041C\u0438 \u043D\u0435 \u0432\u043E\u0457\u043D\u0438, \u043C\u0438 \u043D\u0435
      \u0437\u0434\u0430\u0442\u043D\u0456 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438
      \u043D\u0430\u0448\u0456 \u0431\u0435\u0437\u0446\u0456\u043D\u043D\u0456 \u0437\u043D\u0430\u043D\u043D\u044F
      \u0432\u0456\u0434 \u0436\u0430\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456
      \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u041F\u0443\u0441\u0442\u043E\u043A.
      \u0422\u043E\u043C\u0443 \u043C\u0438 \u043C\u0430\u0439\u0436\u0435 \u043D\u0435
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443\u0454\u043C\u043E \u0456\u0437
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u043C \u0441\u0432\u0456\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629907
    m_Localized: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E. \u041E\u0434\u043D\u0430\u043A
      \u0447\u043E\u043C\u0443 \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u043C\u0435\u043D\u0435
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629908
    m_Localized: "\u041E\u0434\u043D\u0456\u0454\u044E \u0437 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0445
      \u0440\u043E\u0437\u0440\u043E\u0431\u043E\u043A \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456 \u043F\u0435\u0440\u0435\u0434 \u0441\u0430\u043C\u0438\u043C
      \u0441\u0443\u0434\u043D\u0438\u043C \u0434\u043D\u0435\u043C \u0431\u0443\u0432
      \u043F\u0440\u043E\u0454\u043A\u0442 \"\u0421\u043E\u043D\u0446\u0435\". \u041F\u0440\u043E
      \u043D\u044C\u043E\u0433\u043E \u044F \u043D\u0435 \u043C\u043E\u0436\u0443
      \u043D\u0456\u0447\u043E\u0433\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u0430\u043B\u0435 \u0432\u0456\u043D \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0439 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u043B\u044F \u043D\u0430\u0448\u043E\u0433\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
      \u0441\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u0430, \u0430
      \u0439 \u0434\u043B\u044F \u0432\u0441\u0456\u0454\u0457 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u0442\u043E\u0434\u0456 \u043F\u0440\u043E\u0454\u043A\u0442
      \u0442\u0430\u043A \u0456 \u043D\u0435 \u0431\u0443\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E,
      \u0431\u043E \u0432\u0456\u043D \u0431\u0443\u0432 \u0442\u0456\u0441\u043D\u043E
      \u043F\u043E\u0432'\u044F\u0437\u0430\u043D\u0438\u0439 \u0437 \u0456\u043D\u0448\u043E\u044E
      \u0432\u0430\u0436\u043B\u0438\u0432\u043E\u044E \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u043E\u044E
      - \u0443 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044F\u0445
      \u041C\u0435\u0439\u043D\u0422\u0435\u043A \u043F\u0430\u0440\u0430\u043B\u0435\u043B\u044C\u043D\u043E
      \u0432\u0435\u043B\u0438\u0441\u044F \u0440\u043E\u0431\u043E\u0442\u0438 \u043D\u0430\u0434
      \u043F\u0440\u043E\u0454\u043A\u0442\u043E\u043C \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\".
      \u0417\u0430 \u043D\u0430\u0448\u0438\u043C\u0438 \u0434\u0430\u043D\u0438\u043C\u0438,
      \u0446\u0435\u0439 \u0434\u0440\u0443\u0433\u0438\u0439 \u043F\u0440\u043E\u0454\u043A\u0442
      \u0431\u0443\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E,
      \u0456 \u0432\u0435\u0441\u044C \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
      \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u044C \u0456 \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u043E\u0457
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457 \u043C\u0430\u0432
      \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438\u0441\u044F \u0434\u043E
      \u043D\u0430\u0441. \u0410\u043B\u0435 \u0437 \u044F\u043A\u043E\u0457\u0441\u044C
      \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u0446\u044C\u043E\u0433\u043E \u043D\u0435
      \u0441\u0442\u0430\u043B\u043E\u0441\u044F. \u041B\u0456\u043D\u0456\u0457
      \u0437\u0432'\u044F\u0437\u043A\u0443 \u0437 \u0457\u0445\u043D\u0456\u043C
      \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C\u043E\u043C \u0443\u0446\u0456\u043B\u0456\u043B\u0438,
      \u0430\u043B\u0435 \u0441\u0435\u0440\u0432\u0435\u0440 \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0432
      \u043D\u0430 \u0441\u043F\u0440\u043E\u0431\u0438 \u043A\u0435\u0440\u0443\u0432\u0430\u0442\u0438
      \u043D\u0438\u043C \u0432\u0456\u0434\u0434\u0430\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629909
    m_Localized: "\u0406 \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u0430\u0441\u044F
      \u044F, \u0449\u043E\u0431 \u0434\u0430\u0442\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0441\u0435\u0440\u0432\u0435\u0440\u0443 \u0441\u0442\u0443\u0441\u0430\u043D\u0430
      \u0456 \u0437\u043C\u0443\u0441\u0438\u0442\u0438 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438?
      \u0410 \u0447\u043E\u043C\u0443 \u0442\u0438 \u043D\u0430\u0437\u0438\u0432\u0430\u0432
      \u043C\u0435\u043D\u0435 \"\u041E\u0431\u0440\u0430\u043D\u0430-25\"? \u0406
      \u0447\u043E\u043C\u0443 \u0432\u0438 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043C\u0435\u043D\u0435? \u0425\u0456\u0431\u0430 \u044F \u043A\u0440\u0430\u0449\u0435
      \u0437\u0430 \u0432\u0441\u0456\u0445 \u0433\u043E\u0434\u0436\u0443\u0441\u044F
      \u0434\u043B\u044F \u044F\u043A\u043E\u0457\u0441\u044C \u0432\u0430\u0436\u043B\u0438\u0432\u043E\u0457
      \u043C\u0456\u0441\u0456\u0457?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629910
    m_Localized: "\u0417\u0432\u0430\u043D\u043D\u044F \"\u041E\u0431\u0440\u0430\u043D\u043E\u0433\u043E\"
      - \u0446\u0435 \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u044F. \u041F\u0435\u0440\u0448\u0438\u0439
      \u0440\u0430\u0437 \u0441\u043F\u0440\u043E\u0431\u0443 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438
      \u0435\u043C\u0456\u0441\u0430\u0440\u0430 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E
      \u0431\u0443\u043B\u043E \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E \u043C\u0430\u0439\u0436\u0435
      \u0441\u0442\u043E \u0440\u043E\u043A\u0456\u0432 \u0442\u043E\u043C\u0443.
      \u0422\u043E\u0434\u0456 \u0439\u043E\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u043B\u0438
      \"\u041E\u0431\u0440\u0430\u043D\u0438\u043C\", \u0442\u043E\u043C\u0443 \u0449\u043E
      \u0439\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u043B\u0438 \u0437 \u0431\u0435\u0437\u043B\u0456\u0447\u0456
      \u0456\u043D\u0448\u0438\u0445 \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0456\u0432
      \u0437\u0430 \u0441\u0432\u043E\u044E \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0442\u043D\u0456\u0441\u0442\u044C.
      \u0419\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043C\u0456\u0441\u0442\u0438\u043B\u0438
      \u0432 \u041F\u0443\u0441\u0442\u043A\u0443 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C
      \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u0457, \u043E\u0434\u043D\u0430\u043A
      \u0432\u0456\u043D \u043D\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u0432
      \u043C\u0456\u0441\u0456\u044E \u0456 \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F.
      \u0422\u043E\u0434\u0456 \u043C\u0438 \u043F\u043E\u0441\u0438\u043B\u0430\u043B\u0438
      \u0456\u043D\u0448\u0438\u0445. \u0411\u0456\u0439\u0446\u0456\u0432 \u0456
      \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0456\u0432, \u0441\u0438\u043B\u044C\u043D\u0438\u0445
      \u0456 \u0445\u0438\u0442\u0440\u0438\u0445, \u043E\u0434\u0438\u043D\u0430\u043A\u0456\u0432
      \u0456 \u0446\u0456\u043B\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u0438.
      \u0422\u0430\u043A \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F \"\u041E\u0431\u0440\u0430\u043D\u0438\u0439-2\",
      \"\u041E\u0431\u0440\u0430\u043D\u0438\u0439-3\" \u0456 \u0442\u0430\u043A
      \u0434\u0430\u043B\u0456. \u041D\u0456\u0445\u0442\u043E \u043D\u0435 \u0432\u043F\u043E\u0440\u0430\u0432\u0441\u044F.
      \u0414\u043E \u0442\u0435\u0431\u0435. \u0422\u043E\u0436 \u0442\u0430\u043A,
      \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F, \u0449\u043E \u0432
      \u043F\u0456\u0434\u0441\u0443\u043C\u043A\u0443 \u043A\u0440\u0430\u0449\u0435
      \u0437\u0430 \u0432\u0441\u0456\u0445 \u043F\u0456\u0434\u0456\u0439\u0448\u043B\u0430
      \u0441\u0430\u043C\u0435 \u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629911
    m_Localized: "\u041D\u0443, \u044F \u0440\u0430\u0434\u0430, \u0449\u043E \u0437\u043C\u043E\u0433\u043B\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438. \u0422\u0435\u043F\u0435\u0440
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629912
    m_Localized: "\u041C\u0435\u043D\u0456 \u0434\u0443\u0436\u0435 \u0448\u043A\u043E\u0434\u0430,
      @lp, \u0430\u043B\u0435 \u043D\u0456. \u0417\u0434\u043E\u0431\u0443\u0442\u0438
      \u0444\u0430\u0439\u043B\u0438 \u0431\u0443\u043B\u043E \u043F\u0435\u0440\u0448\u043E\u044E,
      \u0430\u043B\u0435 \u043D\u0435 \u0454\u0434\u0438\u043D\u043E\u044E \u043C\u0435\u0442\u043E\u044E.
      \u0414\u043B\u044F \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432 \"\u0421\u043E\u043D\u0446\u0435\"
      \u0456 \"\u0412\u0435\u0441\u0435\u043B\u043A\u0430\" \u043D\u0430\u043C \u0442\u0430\u043A\u043E\u0436
      \u0437\u043D\u0430\u0434\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F \u0434\u0435\u044F\u043A\u0456
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438, \u044F\u043A\u0438\u0445
      \u0443 \u0421\u0442\u0456\u0439\u043B\u0456 \u041F\u0456 \u043D\u0435\u043C\u0430\u0454.
      \u0414\u0456\u0441\u0442\u0430\u0442\u0438 \u0457\u0445 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0442\u043E\u0431\u0456. \u041D\u0430\u043C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0447\u0430\u0441, \u0449\u043E\u0431 \u0432\u0438\u0432\u0447\u0438\u0442\u0438
      \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0456 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F,
      \u0430\u043B\u0435 \u043E\u0434\u0438\u043D \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442,
      \u044F\u043A\u043E\u0433\u043E \u0431\u0440\u0430\u043A\u0443\u0454, \u0432\u0456\u0434\u043E\u043C\u0438\u0439
      \u0443\u0436\u0435 \u0437\u0430\u0440\u0430\u0437. \u0426\u0435 - \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440, \u0456 \u0432 \u043D\u0430\u0441
      \u0454 \u0434\u0430\u043D\u0456, \u0449\u043E \u0439\u043E\u0433\u043E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043B\u0438
      \u0443 \u0421\u0442\u0456\u0439\u043B\u0456 88 - \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u0446\u044C\u043A\u043E\u043C\u0443
      \u0421\u0442\u0456\u0439\u043B\u0456, \u0447\u0438\u043C\u043E\u0441\u044C
      \u0441\u0445\u043E\u0436\u043E\u043C\u0443 \u043D\u0430 \u043D\u0430\u0448\u0435,
      \u0430\u043B\u0435 \u0437 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0431\u0456\u043B\u044C\u0448\u0438\u043C\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C\u0438,
      \u044F\u043A\u0456 \u0441\u0444\u043E\u043A\u0443\u0441\u043E\u0432\u0430\u043D\u0456
      \u043D\u0430 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F\u0445
      \u0443 \u0433\u0430\u043B\u0443\u0437\u0456 \u0440\u043E\u0431\u043E\u0442\u043E\u0442\u0435\u0445\u043D\u0456\u043A\u0438.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u0456\u0437 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0445
      \u043D\u0430\u043C \u043F\u0440\u0438\u0447\u0438\u043D \u043F\u0456\u0441\u043B\u044F
      \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0421\u0442\u0456\u0439\u043B\u0430 \u043A\u0430\u043D\u0430\u043B \u0437\u0432'\u044F\u0437\u043A\u0443
      \u0437 \u043D\u0438\u043C \u0431\u0443\u043B\u043E \u043D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C
      \u043F\u0435\u0440\u0435\u0440\u0432\u0430\u043D\u043E. \u0422\u0432\u043E\u0454
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F - \u0437'\u044F\u0441\u0443\u0432\u0430\u0442\u0438
      \u0441\u0442\u0430\u043D \u0421\u0442\u0456\u0439\u043B\u0430 88 \u0456 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0443 \u043F\u043E\u043D\u0456, \u0449\u043E \u043D\u0430\u0441\u0435\u043B\u044F\u044E\u0442\u044C
      \u0439\u043E\u0433\u043E, \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439
      \u041A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440. \u0412\u0445\u0456\u0434
      \u0443 \u0421\u0442\u0456\u0439\u043B\u043E 88 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0438\u0439
      \u0443 \u043C\u0456\u0441\u0442\u0435\u0447\u043A\u0443 \u043F\u0456\u0434
      \u043D\u0430\u0437\u0432\u043E\u044E \u0424\u043E\u043B\u0441 \u0421\u043F\u0440\u0456\u043D\u0433\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629913
    m_Localized: "\u0424\u0430\u0439\u043B\u0438 \u043C\u0430\u0439\u0436\u0435 \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u0456,
      \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u043F\u0435\u0440\u0435\u0440\u0432\u0435\u0442\u044C\u0441\u044F
      \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.
      \u0423 \u0442\u0435\u0431\u0435 \u0454 \u0449\u0435 \u043F\u0438\u0442\u0430\u043D\u043D\u044F?"
    m_Metadata:
