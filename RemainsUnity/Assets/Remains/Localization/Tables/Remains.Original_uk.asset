  - m_Id: 2725241248
    m_Localized: "\u0420\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u043A\u0430\u043B.44"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241249
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0438\u0439
      \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440, \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439
      \u043E\u043F\u0442\u0438\u0447\u043D\u0438\u043C \u043F\u0440\u0438\u0446\u0456\u043B\u043E\u043C.
      \u041C\u0430\u0454 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0443 \u0432\u0431\u0438\u0432\u0447\u0443
      \u0441\u0438\u043B\u0443 \u0456 \u0433\u0430\u0440\u043D\u0443 \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C,
      \u043F\u0440\u043E\u0442\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0456 \u043F\u0430\u0442\u0440\u043E\u043D\u0438
      \u043A\u0430\u043B\u0456\u0431\u0440\u0443 .44."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241250
    m_Localized: "\"\u041C\u0430\u043B\u0438\u0439 \u041C\u0430\u043A\u0456\u043D\u0442\u043E\u0448\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241251
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440
      \u043A\u0430\u043B\u0456\u0431\u0440\u0443 .44, \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0439
      \u0432 \u0454\u0434\u0438\u043D\u043E\u043C\u0443 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0456
      \u0410\u0439\u0440\u043E\u043D\u0448\u043E\u0434 \u0424\u0430\u0439\u0440\u0430\u0440\u043C\u0441
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
      \u0415\u043F\u043F\u043B\u0434\u0436\u0435\u043A. \u041D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u0456
      \u0437 \u0431\u0456\u043B\u043E\u0457 \u0441\u043B\u043E\u043D\u043E\u0432\u043E\u0457
      \u043A\u0456\u0441\u0442\u043A\u0438 \u0454 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0442\u0440\u044C\u043E\u0445 \u0447\u0435\u0440\u0432\u043E\u043D\u0438\u0445
      \u044F\u0431\u043B\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241252
    m_Localized: "0.308-\u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241253
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u043F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0437 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438 \u043A\u0430\u043B\u0456\u0431\u0440\u0443
      0.308 \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u0443\u043C\u0456\u043B\u044C\u0446\u0435\u043C.
      \u0412\u0438\u0439\u0448\u043B\u0430 \u0432\u0435\u043B\u044C\u043C\u0438 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430,
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0430
      \u0456 \u0437\u0430\u0431\u0456\u0439\u043D\u0430 \u0437\u0431\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241254
    m_Localized: "12,7-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241255
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u043A\u0430\u043B\u0456\u0431\u0440\u0443 \u0437 \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u043E\u044E
      \u0432\u0431\u0438\u0432\u0447\u043E\u044E \u0441\u0438\u043B\u043E\u044E,
      \u0436\u0430\u0445\u043B\u0438\u0432\u043E\u044E \u0432\u0456\u0434\u0434\u0430\u0447\u0435\u044E
      \u0456 \u043E\u0433\u043B\u0443\u0448\u043B\u0438\u0432\u0438\u043C \"\u0431\u0430-\u0431\u0430\u0445\u043E\u043C\".
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454 \u043F\u0430\u0442\u0440\u043E\u043D\u0438
      \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u043C\u0438 \u0442\u0443\u043F\u043E\u043A\u0456\u043D\u0446\u0435\u0432\u0438\u043C\u0438
      \u043A\u0443\u043B\u044F\u043C\u0438, \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u043D\u044F
      \u044F\u043A\u0438\u0445 \u043F\u043E\u0434\u0456\u0431\u043D\u0456 \u0434\u043E
      \u0443\u0434\u0430\u0440\u0456\u0432 \u043A\u043E\u043F\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241256
    m_Localized: "\"\u0423\u0434\u0430\u0440 \u043A\u043E\u043F\u0438\u0442\u043E\u043C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241257
    m_Localized: "\u0426\u0435\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
      \u043D\u0435 \u0434\u0430\u0440\u043C\u0430 \u0442\u0430\u043A \u043D\u0430\u0437\u0432\u0430\u043D\u043E.
      \u0419\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0438 \u0440\u0430\u0434\u0448\u0435
      \u043D\u0430\u0433\u0430\u0434\u0443\u044E\u0442\u044C \u0443\u0434\u0430\u0440\u0438
      \u043A\u0443\u0432\u0430\u043B\u0434\u043E\u044E, \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E
      \u0447\u043E\u043C\u0443, \u0441\u0445\u043E\u0436\u0435, \u0442\u0443\u0442
      \u043D\u0435 \u043E\u0431\u0456\u0439\u0448\u043B\u043E\u0441\u044F \u0431\u0435\u0437
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0457 \u043C\u0430\u0433\u0456\u0457
      \u0437\u0435\u043C\u043D\u0438\u0445 \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241258
    m_Localized: "\u0416\u0430\u0445\u043B\u0438\u0432\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241259
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0437 12,7-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0430,
      \u0446\u0435\u0439 \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0439
      \u043D\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D
      \u043A\u0430\u043B\u0456\u0431\u0440\u0443 50 MG. \u0419\u043E\u0433\u043E
      \u0437\u0430\u0431\u0456\u0439\u043D\u0430 \u0441\u0438\u043B\u0430 \u0434\u0456\u0439\u0441\u043D\u043E
      \u0436\u0430\u0445\u0430\u0454, \u043C\u0430\u043B\u043E \u0432 \u0447\u043E\u043C\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0447\u0438\u0441\u044C \u0432\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0456\u0439
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u0446\u0456. \u041F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0432\u0456\u043D \u043C\u0430\u0454 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043C\u0435\u043D\u0448\u0438\u0439 \u0440\u043E\u0437\u043C\u0456\u0440 \u0456
      \u043F\u0440\u0438\u0441\u0442\u043E\u0439\u043D\u0443 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C,
      \u0430\u043B\u0435 \u0437\u0430 \u0446\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043F\u043B\u0430\u0442\u0438\u0442\u0438 \u0434\u043E\u0441\u0438\u0442\u044C
      \u043D\u0438\u0437\u044C\u043A\u043E\u044E \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044E
      \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241260
    m_Localized: "\"\u0427\u043E\u0440\u043D\u0435 \u0441\u0435\u0440\u0446\u0435\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241261
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u044F
      \"\u0416\u0430\u0445\u043B\u0438\u0432\u043E\u0433\u043E\" \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0430.
      \u0419\u043E\u0433\u043E \u043F\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u0438\u0439
      \u0441\u0442\u0432\u043E\u043B \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443
      \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0432\u043B\u0443\u0447\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0441\u0438\u043B\u0443 \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443,
      \u0430 \u043A\u043E\u0440\u043F\u0443\u0441, \u043F\u043E\u043A\u0440\u0438\u0442\u0438\u0439
      \u0447\u043E\u0440\u043D\u0438\u043C \u043B\u0430\u043A\u043E\u043C, \u043C\u0430\u0454
      \u043D\u0443 \u0434\u0443\u0436\u0435 \u0437\u043D\u0430\u0447\u043D\u0438\u0439
      \u0432\u0438\u0433\u043B\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241262
    m_Localized: "\u0417\u043E\u0440\u044F\u043D\u0438\u0439 \u0431\u043B\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241263
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0456 \u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0430
      \u0432 \u0443\u0441\u0456\u0445 \u0432\u0456\u0434\u043D\u043E\u0448\u0435\u043D\u043D\u044F\u0445
      \u0437\u0431\u0440\u043E\u044F. \u041F\u043E\u0434\u0435\u0439\u043A\u0443\u044E\u0442\u044C,
      \u0432\u043E\u043D\u0430 \u043D\u0435 \u0431\u0443\u043B\u0430 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u043F\u043E\u043D\u0456, \u0430 \u0432\u043F\u0430\u043B\u0430 \u043D\u0430
      \u0437\u0435\u043C\u043B\u044E \u0456\u0437 \u0437\u0456\u0440\u043E\u043A.
      \u0420\u0443\u0439\u043D\u0456\u0432\u043D\u0430 \u0441\u0438\u043B\u0430 \u0457\u0457
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0456\u0432 \u0434\u0443\u0436\u0435
      \u0432\u0438\u0441\u043E\u043A\u0430 \u0456 \u0437\u0430\u0445\u0438\u0441\u0442\u0443
      \u0432\u0456\u0434 \u043D\u0438\u0445 \u043D\u0435 \u0456\u0441\u043D\u0443\u0454,
      \u0430\u043B\u0435 \u0454 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438
      \u0437 \u0431\u043E\u0454\u0437\u0430\u043F\u0430\u0441\u043E\u043C - \u0437\u043E\u0440\u044F\u043D\u0438\u0439
      \u0431\u043B\u0430\u0441\u0442\u0435\u0440 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043B\u0438\u0448\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456 \u0435\u043D\u0435\u0440\u0433\u043E\u0432\u0443\u0437\u043B\u0438,
      \u044F\u043A\u0456 \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u0441\u043A\u043B\u0430\u0434\u043D\u043E \u0437\u043D\u0430\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241264
    m_Localized: "\"\u0412\u0456\u0440\u043D\u0456\u0441\u0442\u044C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241265
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442,
      \u0449\u043E \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0411\u0440\u0430\u0441\u0443
      \u0411\u0430\u043A\u0448\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241266
    m_Localized: "9-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442-\u043A\u0443\u043B\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241267
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442-\u043A\u0443\u043B\u0435\u043C\u0435\u0442,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043F\u043E\u0448\u0438\u0440\u0435\u043D\u0456 9-\u043C\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u0438.
      \u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0438\u0439, \u0434\u0435\u0448\u0435\u0432\u0438\u0439,
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u0456 \u043D\u0435
      \u0432\u0438\u043C\u0430\u0433\u0430\u0454 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u043D\u0430\u0432\u0438\u0447\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241268
    m_Localized: "10-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442-\u043A\u0443\u043B\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241269
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430 \u0442\u0430
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430 \u0437\u0431\u0440\u043E\u044F,
      \u043D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443 \u0432\u0456\u0434
      \u0433\u0440\u043E\u043C\u0456\u0437\u0434\u043A\u043E\u0457 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u043E\u0457
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0438, \u0456\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0432 \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241270
    m_Localized: "12,7-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442-\u043A\u0443\u043B\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241271
    m_Localized: "\u0412\u0430\u0436\u043A\u0438\u0439, \u0432\u0435\u043B\u0438\u043A\u043E\u043A\u0430\u043B\u0456\u0431\u0435\u0440\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442-\u043A\u0443\u043B\u0435\u043C\u0435\u0442.
      \u0417\u0430\u0432\u0434\u0430\u0454 \u0445\u043E\u0440\u043E\u0448\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u0456 \u043C\u0430\u0454 \u0447\u0443\u0434\u043E\u0432\u0443
      \u0437\u0443\u043F\u0438\u043D\u044F\u044E\u0447\u0443 \u0434\u0456\u044E,
      \u0430\u043B\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0434\u0435\u0444\u0456\u0446\u0438\u0442\u043D\u0456 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241272
    m_Localized: "\"\u0428\u043A\u0432\u0430\u043B\""
    m_Metadata:
