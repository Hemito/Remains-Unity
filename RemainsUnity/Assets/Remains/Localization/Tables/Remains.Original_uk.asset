      \u0433\u0440\u0430\u0432\u0446\u0456\u0432-\u043F\u043E\u0447\u0430\u0442\u043A\u0456\u0432\u0446\u0456\u0432.\n\u0412\u0438
      \u043F\u043E\u0447\u0438\u043D\u0430\u0454\u0442\u0435 \u0433\u0440\u0443,
      \u043C\u0430\u044E\u0447\u0438 150 \u043E\u0434\u0438\u043D\u0438\u0446\u044C
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F, +25 \u0437\u0430 \u0440\u0456\u0432\u0435\u043D\u044C.\n\u0417\u0434\u043E\u0440\u043E\u0432'\u044F
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u0435
      \u043D\u0430 30%.\n\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437 \u0456
      \u0441\u0430\u043C\u043E\u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u044F
