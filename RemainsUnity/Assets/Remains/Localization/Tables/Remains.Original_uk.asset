  - m_Id: 2729435178
    m_Localized: "\u041C\u0456\u0446\u043D\u0430 \u0456 \u0431\u043B\u0438\u0441\u043A\u0443\u0447\u0430
      \u0441\u0442\u0430\u043B\u0435\u0432\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430,
      \u0442\u0430\u043A\u0443 \u043D\u0435 \u0432\u0441\u044F\u043A\u0430 \u043A\u0443\u043B\u044F
      \u043F\u0440\u043E\u0431'\u0454. \u041C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0434\u043B\u044F \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0440\u0435\u043C\u043E\u043D\u0442\u0443 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435179
    m_Localized: "\u0411\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435180
    m_Localized: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0430 \u0437 \u043A\u0435\u0440\u0430\u043C\u0456\u043A\u0438
      \u0442\u0430 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0445 \u043F\u043E\u043B\u0456\u043C\u0435\u0440\u0456\u0432.
      \u0414\u0443\u0436\u0435 \u043C\u0456\u0446\u043D\u0430 \u0456 \u043B\u0435\u0433\u043A\u0430,
      \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432 \u0431\u043E\u0439\u043E\u0432\u0456\u0439 \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435181
    m_Localized: "\u0417\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435182
    m_Localized: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0430 \u0437 \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E\u0433\u043E
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0443, \u044F\u0432\u043D\u043E
      \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0430 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043C\u0430\u0433\u0456\u0457. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432 \u043C\u0430\u0433\u0456\u0447\u043D\u0456\u0439 \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435183
    m_Localized: "\u0425\u0456\u0442\u0438\u043D\u043E\u0432\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435184
    m_Localized: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0442\u043E\u0432\u0441\u0442\u043E\u0433\u043E
      \u0456 \u043C\u0456\u0446\u043D\u043E\u0433\u043E \u0445\u0456\u0442\u0438\u043D\u043E\u0432\u043E\u0433\u043E
      \u043F\u0430\u043D\u0446\u0438\u0440\u0430. \u0417\u0430 \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0433\u043E
      \u0432\u043C\u0456\u043D\u043D\u044F \u0437 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u0430
      \u0437\u043C\u0430\u0439\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438 \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u0443
      \u0431\u0440\u043E\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435185
    m_Localized: "\u041A\u0430\u043C\u0443\u0444\u043B\u044F\u0436\u043D\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435186
    m_Localized: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0430 \u0437 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043D\u0438\u0445
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432 \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u044E
      \u0444\u0430\u043A\u0442\u0443\u0440\u043E\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0440\u0435\u043C\u043E\u043D\u0442\u0443 \u0440\u043E\u0437\u0432\u0456\u0434\u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435187
    m_Localized: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0441\u0438\u043B\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435188
    m_Localized: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0437 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0445 \u0434\u043E\u0441\u044F\u0433\u043D\u0435\u043D\u044C
      \u0435\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u043E\u0457
      \u043D\u0430\u0443\u043A\u0438 \u0456 \u0442\u0435\u0445\u043D\u0456\u043A\u0438.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F\u043A\u0449\u043E \u0437\u0456\u0431\u0440\u0430\u0442\u0438
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0442\u0430\u043A\u0438\u0445 \u0434\u0435\u0442\u0430\u043B\u0435\u0439,
      \u0442\u043E \u0437 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u0434\u0435
      \u0441\u043F\u043E\u0440\u0443\u0434\u0438\u0442\u0438 \u043F\u043E\u0432\u043D\u0438\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435189
    m_Localized: "\u0410\u0440\u0430\u043C\u0456\u0434\u043D\u0430 \u0442\u043A\u0430\u043D\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435190
    m_Localized: "\u0410\u0440\u0430\u043C\u0456\u0434 \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0441\u0442\u0430\u043B\u044C, \u0430\u043B\u0435 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0432 \u043F'\u044F\u0442\u044C \u0440\u0430\u0437\u0456\u0432
      \u043B\u0435\u0433\u0448\u0438\u0439. \u0411\u0430\u0433\u0430\u0442\u043E\u0448\u0430\u0440\u043E\u0432\u0430
      \u0442\u043A\u0430\u043D\u0438\u043D\u0430 \u0437 \u0446\u044C\u043E\u0433\u043E
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0443 \u0434\u043E\u0431\u0440\u0435
      \u0437\u0430\u0442\u0440\u0438\u043C\u0443\u0454 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u0456
      \u043A\u0443\u043B\u0456 \u0456 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E
      \u043D\u0435 \u0433\u043E\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435191
    m_Localized: "\u0428\u043A\u0456\u0440\u044F\u043D\u0438\u0439 \u0440\u0435\u043C\u0456\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435192
    m_Localized: "\u0412\u0441\u0435 \u0449\u0435 \u044F\u043A \u043D\u043E\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435193
    m_Localized: "\u041B\u043E\u043F\u0430\u0442\u044C \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435194
    m_Localized: "\u0414\u043E\u0441\u0438\u0442\u044C \u043C\u0456\u0446\u043D\u0430
      \u0456 \u0433\u043E\u0441\u0442\u0440\u0430, \u0445\u043E\u0447\u0430 \u0456
      \u0442\u0440\u043E\u0445\u0438 \u0456\u0440\u0436\u0430\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435195
    m_Localized: "\u0413\u0443\u043C\u043E\u0432\u0438\u0439 \u0434\u0436\u0433\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435196
    m_Localized: "\u041D\u0430\u0432\u0456\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u043E\u043A\u0456\u0432 \u043D\u0435
      \u0432\u0442\u0440\u0430\u0442\u0438\u0432 \u0441\u0432\u043E\u0454\u0457 \u0435\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
