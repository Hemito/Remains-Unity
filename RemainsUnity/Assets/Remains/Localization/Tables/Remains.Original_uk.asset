  - m_Id: 2733630051
    m_Localized: "\u0421\u0442\u0430\u043D \u0441\u0438\u0441\u0442\u0435\u043C\u0438:
      \u042F\u0434\u0440\u043E \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430:
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C 17,56%. \u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C: \u043F\u0440\u0430\u0446\u044E\u0454.
      \u0421\u0438\u0441\u0442\u0435\u043C\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438:
      \u0430\u043A\u0442\u0438\u0432\u043D\u0456. \u041E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439
      \u0423\u043B\u044C\u0442\u0440\u0430-\u0432\u0430\u0440\u0442\u043E\u0432\u0438\u0439:
      \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0439."
