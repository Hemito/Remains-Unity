      m_Items: []
  - m_Id: 2725242173
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439,
      \u0449\u043E \u043F\u0456\u0434'\u0454\u0434\u043D\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0430. \u041F\u0456\u0434
      \u0447\u0430\u0441 \u0431\u043E\u044E \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u0454
      \u0441\u043B\u0430\u0431\u043A\u0456 \u043C\u0456\u0441\u0446\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
      \u043D\u0435 \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0456 \u0431\u0440\u043E\u043D\u0435\u044E,
      \u0456 \u043F\u0456\u0434\u0441\u0432\u0456\u0447\u0443\u0454 \u0457\u0445
      \u043B\u0430\u0437\u0435\u0440\u043E\u043C. \u0412\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435
      \u0448\u0430\u043D\u0441 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0430\u0442\u0430\u043A\u0443
      \u043F\u043E \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456\u0439 \u0442\u043E\u0447\u0446\u0456,
      \u044F\u043A\u0430 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0456\u0433\u043D\u043E\u0440\u0443\u0454
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0443 \u0431\u0440\u043E\u043D\u044E
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430. \u0428\u0430\u043D\u0441
      \u0432\u0438\u0449\u0438\u0439 \u043F\u0440\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u0456
      \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043E\u043A \u0456 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0456\u0432."
