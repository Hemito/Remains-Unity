  - m_Id: 2725242161
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442\u043D\u0430 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0430
      \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043F\u0440\u043E\u0454\u043A\u0442\u0443
      \"\u041A\u0456\u0431\u0435\u0440-\u043F\u043E\u043D\u0456\". \u0406\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442
      \u043F\u0456\u0434\u0441\u0438\u043B\u044E\u0454 \u0448\u043A\u0456\u0440\u0443
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043F\u043E\u043B\u0456\u043C\u0435\u0440\u043D\u0438\u043C\u0438
      \u0432\u043E\u043B\u043E\u043A\u043D\u0430\u043C\u0438, \u0449\u043E \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454
      \u043F\u043E\u0440\u0456\u0433 \u0448\u043A\u043E\u0434\u0438 \u043D\u0430
      #1. \u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0432\u0445\u043E\u0434\u0438\u0442\u044C \u0443 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C
      \u043F\u043E\u043A\u0443\u043F\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242162
    m_Localized: "\u041C\u043E\u0434\u0443\u043B\u044C \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0456\u0457"
    m_Metadata:
