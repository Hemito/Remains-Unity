    m_Localized: "\u042F \u043D\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u0442\u043E\u0431\u0456, @lp, \u043E\u0434\u043D\u0430\u043A \u043D\u0435
