      \u0441\u043A\u043B\u0430\u0434\u0443 \u0431\u0430\u0437\u0438 \"\u0415\u043F\u0441\u0438\u043B\u043E\u043D\".\n\u0417\u0430\u043F\u0438\u0441
      \u2116 57\n\u0414\u0430\u0442\u0430: 28.03.187\n\u041D\u0430\u0437\u0432\u0430:
      \"\u0421\u043B\u0443\u0445\u0430\u043D\u043D\u044F \u0437 \u043F\u0438\u0442\u0430\u043D\u043D\u044F
      \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0437 \u0430\u0431\u043E\u0440\u0438\u0433\u0435\u043D\u0430\u043C\u0438\"\n\u0413\u043E\u043B\u043E\u0432\u0443\u044E\u0447\u0438\u0439
      (\u041F): \u041F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A \u0412\u0456\u043D\u0434\u0444\u043B\u043E\u0443\n\u0414\u043E\u043F\u043E\u0432\u0456\u0434\u0430\u0447
      (\u0414): \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442 \u0421\u0430\u043C\u043C\u0440\u0435\u0440
      \u041B\u0456\u0444\n\u041E\u043F\u043E\u043D\u0435\u043D\u0442\u0438: \u0441\u0435\u0440\u0436\u0430\u043D\u0442
      \u0422\u0430\u043D\u0434\u0435\u0440 (\u0421), \u043C\u0430\u0439\u043E\u0440
      \u0421\u0430\u0444\u0444\u0435\u0440 (\u041C)\n\u0421\u0435\u043A\u0440\u0435\u0442\u0430\u0440:
      \u0430\u0434'\u044E\u0442\u0430\u043D\u0442 \u0424\u0435\u0439\u0440 \u041F\u043B\u0435\u0439*."
