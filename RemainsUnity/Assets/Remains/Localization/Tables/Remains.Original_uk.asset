  - m_Id: 2729435176
    m_Localized: "\u041C\u0456\u0446\u043D\u0456 \u0448\u043C\u0430\u0442\u043A\u0438
      \u0432\u0438\u0447\u0438\u043D\u0435\u043D\u043E\u0457 \u0442\u0430 \u0445\u0456\u043C\u0456\u0447\u043D\u043E
      \u043E\u0431\u0440\u043E\u0431\u043B\u0435\u043D\u043E\u0457 \u0448\u043A\u0456\u0440\u0438,
      \u043C\u043E\u0436\u0443\u0442\u044C \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0434\u043B\u044F \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0440\u0435\u043C\u043E\u043D\u0442\u0443 \u0448\u043A\u0456\u0440\u044F\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
