      \u0437\u0430\u0440\u044F\u0434 \u0434\u0440\u043E\u0431\u0443, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439,
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E, \u0434\u043B\u044F
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0456\u0432."
