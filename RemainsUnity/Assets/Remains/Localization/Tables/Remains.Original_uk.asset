  - m_Id: 2725241133
    m_Localized: "\u041C\u0456\u0441\u044F\u0447\u043D\u0438\u0439 \u041A\u043B\u0438\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241134
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0430 \u0442\u0443\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241135
    m_Localized: "\u0416\u0438\u0442\u0435\u043B\u044C \u0441\u0442\u0456\u0439\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241136
    m_Localized: "\u0420\u0435\u0430\u043A\u0442\u043E\u0440 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241137
    m_Localized: "\u041C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241138
    m_Localized: "\u0412\u043A\u0440\u0438\u0442\u0430 \u043E\u0431\u043B\u0443\u043F\u043B\u0435\u043D\u043E\u044E
      \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u044E \u0444\u0430\u0440\u0431\u043E\u044E,
      \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D\u0430\u043C\u0438 \u0456 \u044F\u043A\u043E\u044E\u0441\u044C
      \u043B\u0438\u043F\u043A\u043E\u044E \u0433\u0438\u0434\u043E\u0442\u043E\u044E.
      \u041D\u0435\u043F\u043E\u0433\u0430\u043D\u043E \u043F\u0456\u0434\u0456\u0439\u0434\u0435
      \u0434\u043B\u044F \u0437\u043B\u043E\u043C\u0443 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0438\u0445,
      \u0430\u043B\u0435 \u043D\u0435 \u0434\u0443\u0436\u0435 \u043C\u0456\u0446\u043D\u0438\u0445
      \u0434\u0432\u0435\u0440\u0435\u0439, \u0448\u0430\u0444 \u0456 \u044F\u0449\u0438\u043A\u0456\u0432.
      \u0414\u043B\u044F \u0437\u043B\u043E\u043C\u0443 \u0437\u0430\u043B\u0456\u0437\u043D\u0438\u0445
      \u0434\u0432\u0435\u0440\u0435\u0439 \u0456 \u0441\u0435\u0439\u0444\u0456\u0432
      \u043D\u0435 \u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241139
    m_Localized: "\"\u0414\u0440\u0443\u0433 \u0433\u0440\u0430\u0431\u0456\u0436\u043D\u0438\u043A\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241140
    m_Localized: "\u0406\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442, \u044F\u0432\u043D\u043E
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0434\u043B\u044F
      \u0437\u0430\u043D\u044F\u0442\u0442\u044F \u043D\u0435\u043F\u0440\u0430\u0432\u0435\u0434\u043D\u0438\u043C
      \u0440\u0435\u043C\u0435\u0441\u043B\u043E\u043C. \u0412\u0456\u043D \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u0439 \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443
      \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0443, \u043D\u0438\u043C
      \u043C\u043E\u0436\u043D\u0430 \u0437\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u0456\u0446\u043D\u0456 \u0437\u0430\u043B\u0456\u0437\u043D\u0456
      \u0434\u0432\u0435\u0440\u0456 \u0442\u0430 \u0440\u043E\u0437\u0431\u0438\u0432\u0430\u0442\u0438
      \u0431\u0435\u0442\u043E\u043D\u043D\u0456 \u0441\u0442\u0456\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241141
    m_Localized: "\u0428\u043C\u0430\u0442\u043E\u043A \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241142
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0448\u043C\u0430\u0442\u043E\u043A
      \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u0438, \u043E\u0431\u043C\u043E\u0442\u0430\u043D\u0438\u0439
      \u0456\u0437\u043E\u043B\u044F\u0446\u0456\u0439\u043D\u043E\u044E \u0441\u0442\u0440\u0456\u0447\u043A\u043E\u044E,
      \u0449\u043E\u0431 \u0439\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430
      \u0431\u0443\u043B\u043E \u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0432
      \u0437\u0443\u0431\u0430\u0445. \u0426\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0437\u0431\u0440\u043E\u0454\u044E \u043D\u0435 \u043D\u0430\u0437\u0432\u0435\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241143
    m_Localized: "\u0421\u043F\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241144
    m_Localized: "\u042F\u0432\u043B\u044F\u0454 \u0441\u043E\u0431\u043E\u044E \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u0443
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0443 \u0434\u0435\u0442\u0430\u043B\u044C,
      \u043F\u0440\u0438\u043A\u0440\u0443\u0447\u0435\u043D\u0443 \u0434\u0440\u043E\u0442\u043E\u043C
      \u0434\u043E \u043C\u0456\u0446\u043D\u043E\u0457 \u0434\u0435\u0440\u0435\u0432'\u044F\u043D\u043E\u0457
      \u043F\u0430\u043B\u0438\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241145
    m_Localized: "\"\u0423\u043A\u0443\u0441 \u0433\u0430\u0434\u044E\u043A\u0438\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241146
    m_Localized: "\u041D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443 \u0432\u0456\u0434
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u0441\u043F\u0438\u0441\u0430,
      \u0434\u0440\u0435\u0432\u043A\u043E \u0446\u044C\u043E\u0433\u043E \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E
      \u0437 \u043C\u0456\u0446\u043D\u043E\u0433\u043E \u0431\u0430\u043C\u0431\u0443\u043A\u0430,
      \u043D\u0430\u043A\u043E\u043D\u0435\u0447\u043D\u0438\u043A \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E
      \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u0438\u0439, \u0430 \u043D\u0430
      \u0434\u043E\u0434\u0430\u0442\u043E\u043A \u0434\u043E \u0432\u0441\u044C\u043E\u0433\u043E
      \u0449\u0435 \u0439 \u043E\u0442\u0440\u0443\u0454\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241147
    m_Localized: "\u041D\u0456\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241148
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u043A\u0443\u0445\u043E\u043D\u043D\u0438\u0439
      \u043D\u0456\u0436, \u0434\u043B\u044F \u0431\u043E\u044E \u043D\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241149
    m_Localized: "\u0422\u0435\u0441\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241150
    m_Localized: "\u0426\u0438\u043C \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u043C
      \u0456 \u0432\u0430\u0436\u043A\u0438\u043C \u043A\u0443\u0445\u043E\u043D\u043D\u0438\u043C
      \u043D\u043E\u0436\u0435\u043C \u043C\u043E\u0436\u043D\u0430 \u0437\u0430
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0430\u0448\u0430\u0442\u043A\u0443\u0432\u0430\u0442\u0438
      \u043A\u0430\u0447\u0430\u043D \u043A\u0430\u043F\u0443\u0441\u0442\u0438...
      \u0430\u0431\u043E \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C \u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241151
    m_Localized: "\u0417\u0430\u0437\u0443\u0431\u0440\u0435\u043D\u0438\u0439 \u043D\u0456\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241152
    m_Localized: "\u041D\u0456\u0436 \u0456\u0437 \u043A\u0440\u0438\u0432\u0438\u043C
      \u0456 \u0432\u0438\u0449\u0435\u0440\u0431\u043B\u0435\u043D\u0438\u043C \u043B\u0435\u0437\u043E\u043C,
      \u0432\u0435\u0441\u044C \u0456\u0440\u0436\u0430\u0432\u0438\u0439 \u0456
      \u0432 \u043F\u043B\u044F\u043C\u0430\u0445 \u0437\u0430\u0441\u043E\u0445\u043B\u043E\u0457
      \u043A\u0440\u043E\u0432\u0456. \u0421\u0442\u0440\u0430\u0448\u043D\u043E
      \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438, \u043A\u0438\u043C \u0456
      \u0434\u043B\u044F \u0447\u043E\u0433\u043E \u0432\u0456\u043D \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0432\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241153
    m_Localized: "\u0416\u0435\u0440\u0442\u043E\u0432\u043D\u0438\u0439 \u043D\u0456\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241154
    m_Localized: "\u0423\u043B\u044E\u0431\u043B\u0435\u043D\u0430 \u0456\u0433\u0440\u0430\u0448\u043A\u0430
      \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432-\u0441\u0430\u0434\u0438\u0441\u0442\u0456\u0432.
      \u0423\u0434\u0430\u0440\u0438 \u0446\u044C\u043E\u0433\u043E \u043D\u043E\u0436\u0430
      \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u044E\u0442\u044C \u0440\u044F\u0441\u043D\u0443
      \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241155
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0438\u0439 \u043D\u0456\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241156
    m_Localized: "\u0427\u0443\u0434\u043E\u0432\u0438\u0439 \u043D\u0456\u0436 \u0437
      \u044F\u043A\u0456\u0441\u043D\u043E\u0457 \u0441\u0442\u0430\u043B\u0456,
      \u044F\u043A\u0438\u0439 \u043D\u0430\u0432\u0456\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0431\u0430\u0433\u0430\u0442\u043E \u0440\u043E\u043A\u0456\u0432 \u043D\u0435
      \u0432\u0442\u0440\u0430\u0442\u0438\u0432 \u0441\u0432\u043E\u0454\u0457 \u0433\u043E\u0441\u0442\u0440\u043E\u0442\u0438.
      \u041D\u0435\u0437\u0430\u043C\u0456\u043D\u043D\u0430 \u0440\u0456\u0447,
      \u043A\u043E\u043B\u0438 \u0432 \u0431\u043E\u044E \u0434\u043E\u0445\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E \u0431\u043B\u0438\u0437\u044C\u043A\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443
      \u0437 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241157
    m_Localized: "\"\u0416\u0430\u043B\u043E\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241158
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u043E\u0439\u043E\u0432\u0438\u0439
      \u043D\u0456\u0436 \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043C\u0456\u0446\u043D\u043E\u0457 \u0441\u0442\u0430\u043B\u0456, \u0437
      \u0445\u0432\u0438\u043B\u044F\u0441\u0442\u0438\u043C \u0432\u0456\u0437\u0435\u0440\u0443\u043D\u043A\u043E\u043C
      \u043D\u0430 \u043B\u0435\u0437\u0456. \u041F\u0440\u0438\u0442\u043E\u043C\u0443
      \u0433\u043E\u0441\u0442\u0440\u0438\u0439, \u044F\u043A \u0431\u0440\u0438\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241159
    m_Localized: "\u0411\u0438\u0442\u0430 \u0437 \u0446\u0432\u044F\u0445\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241160
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0448\u043C\u0430\u0442\u043E\u043A
      \u0434\u043E\u0448\u043A\u0438 \u0437 \u0456\u0440\u0436\u0430\u0432\u0438\u043C\u0438
      \u0446\u0432\u044F\u0445\u0430\u043C\u0438, \u0449\u043E \u0441\u0442\u0438\u0440\u0447\u0430\u0442\u044C
      \u0456\u0437 \u043D\u0435\u0457. \u041F\u043E \u0441\u0443\u0442\u0456 \u0446\u0435
      \u043C\u043E\u0442\u043B\u043E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241161
    m_Localized: "\u041C\u0430\u0447\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241162
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u043D\u0456\u0436 \u0456\u0437
      \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C
      \u0456\u0437 \u043A\u0440\u0430\u0457\u043D\u0438 \u0437\u0435\u0431\u0440.
      \u041D\u0438\u043C \u0437\u0440\u0443\u0447\u043D\u043E \u043F\u0440\u043E\u0440\u0443\u0431\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043A\u0440\u0456\u0437\u044C \u0433\u0443\u0441\u0442\u0456 \u0437\u0430\u0440\u043E\u0441\u0442\u0456
      \u0430\u0431\u043E \u0448\u0438\u043D\u043A\u0443\u0432\u0430\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
      \u0443 \u043A\u0430\u043F\u0443\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241163
    m_Localized: "\"\u041F\u043E\u043A\u043B\u0438\u043A \u0434\u0436\u0443\u043D\u0433\u043B\u0456\u0432\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241164
    m_Localized: "\u041E\u0431\u0442\u044F\u0436\u0435\u043D\u0435 \u043C\u0430\u0447\u0435\u0442\u0435,
      \u043F\u0440\u0438\u043A\u0440\u0430\u0448\u0435\u043D\u0435 \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u043E\u043C
      \u0442\u0430 \u0456\u043D\u043A\u0440\u0443\u0441\u0442\u0430\u0446\u0456\u0454\u044E
      \u0437 \u043D\u0435\u0444\u0440\u0438\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241165
    m_Localized: "\u0421\u0432\u0438\u043D\u0446\u0435\u0432\u0430 \u0442\u0440\u0443\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241166
    m_Localized: "\u0412\u0430\u0436\u043A\u0430 \u0442\u0440\u0443\u0431\u0430 \u0437
      \u043C\u0430\u0441\u0438\u0432\u043D\u043E\u044E \u0433\u0430\u0439\u043A\u043E\u044E
      \u043D\u0430 \u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0456\u043D\u0446\u0456.
      \u0426\u0456\u0454\u044E \u0448\u0442\u0443\u043A\u043E\u044E \u043C\u043E\u0436\u043D\u0430
      \u043E\u0433\u0440\u0456\u0442\u0438 \u0442\u0430\u043A, \u0449\u043E \u043C\u0430\u043B\u043E
      \u043D\u0435 \u0437\u0434\u0430\u0441\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241167
    m_Localized: "\u0420\u0456\u0437\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241168
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0430 \u043F\u0438\u043B\u0430,
      \u0449\u043E \u043F\u0440\u0430\u0446\u044E\u0454 \u0432\u0456\u0434 \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043E\u043A.
      \u041C\u043E\u0436\u0435 \u0440\u043E\u0437\u043F\u0438\u043B\u044E\u0432\u0430\u0442\u0438
      \u043D\u0435 \u0434\u0443\u0436\u0435 \u0442\u0432\u0435\u0440\u0434\u0456
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u043A\u0456\u0441\u0442\u043A\u0438 \u0442\u0430 \u0447\u0435\u0440\u0435\u043F\u0438
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432. \u041F\u0440\u043E\u0442\u0438
      \u043C\u0435\u0442\u0430\u043B\u0443 \u043A\u0443\u0434\u0438 \u043C\u0435\u043D\u0448
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241169
    m_Localized: "\u0420\u043E\u0437\u043F\u0438\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241170
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u0440\u0456\u0437\u043D\u0438\u043A. \u041D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E,
      \u0443 \u0446\u044C\u043E\u0433\u043E \u0437\u0443\u0431\u0438 \u0437 \u043B\u0435\u0433\u043E\u0432\u0430\u043D\u043E\u0457
      \u0441\u0442\u0430\u043B\u0456, \u0449\u043E \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443
      \u0437 \u043B\u0435\u0433\u043A\u0456\u0441\u0442\u044E \u0440\u043E\u0437\u0440\u0456\u0437\u0430\u0442\u0438
      \u043D\u0435 \u043D\u0430\u0434\u0442\u043E \u043C\u0456\u0446\u043D\u0443
      \u0431\u0440\u043E\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241171
    m_Localized: "\u0410\u0432\u0442\u043E\u0441\u043E\u043A\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241172
    m_Localized: "\u041E\u0431\u0435\u0440\u0442\u043E\u0432\u0456 \u043B\u0435\u0437\u0430
      \u0446\u044C\u043E\u0433\u043E \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0443
      \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0456 \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u0449\u043E\u0431 \u0431\u0435\u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0437\u0443\u0441\u0438\u043B\u044C \u0440\u0456\u0437\u0430\u0442\u0438 \u043D\u0430
      \u0448\u043C\u0430\u0442\u043A\u0438 \u0440\u0456\u0437\u043D\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043E\u0431\u0440\u0443\u0445\u0442.
      \u0410\u043B\u0435 \u0442\u0430\u043A \u0441\u0430\u043C\u043E \u043B\u0435\u0433\u043A\u043E
      \u0432\u043E\u043D\u0438 \u0432\u043F\u043E\u0440\u0430\u044E\u0442\u044C\u0441\u044F
      \u0456 \u0437 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u044E \u0431\u0440\u043E\u043D\u0435\u044E,
      \u0456 \u0437 \u0442\u0438\u043C, \u0445\u0442\u043E \u0457\u0457 \u043D\u043E\u0441\u0438\u0442\u044C.
      \u0414\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u0441\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241173
    m_Localized: "\u041B\u0430\u043D\u0446\u044E\u0433\u043E\u0432\u0430 \u043F\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241174
    m_Localized: "\u041A\u043E\u043B\u0438\u0441\u044C \u0446\u0438\u043C \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C
      \u043F\u0438\u043B\u044F\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u0430,
      \u0442\u0435\u043F\u0435\u0440 \u0436\u0435, \u0447\u0435\u0440\u0435\u0437
      \u0431\u0440\u0430\u043A \u0434\u0435\u0440\u0435\u0432, \u043D\u0438\u043C
      \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u043F\u0438\u043B\u044E\u0432\u0430\u0442\u0438
      \u043D\u0430 \u0448\u043C\u0430\u0442\u043E\u0447\u043A\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432.
      \u041C\u0430\u0433\u0456\u0447\u043D\u043E \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0456
      \u0437\u0443\u0431\u0438 \u043B\u0435\u0433\u043A\u043E \u0432\u043F\u043E\u0440\u0430\u044E\u0442\u044C\u0441\u044F
      \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u043C, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0430\u0439\u0442\u0432\u0435\u0440\u0434\u0456\u0448\u0438\u043C \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u043E\u043C.
      \u0414\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
      \u0441\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241175
    m_Localized: "\u041B\u043E\u043F\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241176
    m_Localized: "\u041A\u043E\u043B\u0438\u0441\u044C \u0446\u0435 \u0431\u0443\u0432
      \u043F\u0440\u043E\u0441\u0442\u043E \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u0437\u0435\u043C\u043B\u044F\u043D\u0438\u0445 \u0440\u043E\u0431\u0456\u0442,
      \u0430\u043B\u0435 \u0433\u043E\u0441\u0442\u0440\u043E \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u0430
      \u043A\u0440\u043E\u043C\u043A\u0430 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0430
      \u0439\u043E\u0433\u043E \u043D\u0430 \u0437\u0431\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241177
    m_Localized: "\u041F\u0430\u043B\u0438\u0446\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241178
    m_Localized: "\u0412\u0430\u0436\u043A\u0430 \u0437\u0430\u043B\u0456\u0437\u043D\u0430
      \u0434\u0435\u0442\u0430\u043B\u044C, \u043F\u0440\u0438\u0432\u0430\u0440\u0435\u043D\u0430
      \u0434\u043E \u043C\u0456\u0446\u043D\u043E\u0433\u043E \u0456 \u0434\u043E\u0432\u0433\u043E\u0433\u043E
      \u0448\u0442\u0438\u0440\u044F. \u042F\u043A\u0449\u043E \u0431\u0438\u0442\u0438
      \u0437 \u0440\u043E\u0437\u043C\u0430\u0445\u0443, \u0442\u043E \u043F\u0440\u043E\u043B\u043E\u043C\u0438\u0442\u0438
      \u043A\u043E\u043C\u0443-\u043D\u0435\u0431\u0443\u0434\u044C \u0447\u0435\u0440\u0435\u043F
      \u0446\u0456\u0454\u044E \u0448\u0442\u0443\u043A\u043E\u044E \u043C\u043E\u0436\u043D\u0430
      \u0437\u0430\u043F\u0440\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241179
    m_Localized: "\u041A\u0443\u0432\u0430\u043B\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241180
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u0440\u043E\u0437\u0431\u0438\u0432\u0430\u043D\u043D\u044F
      \u0441\u0442\u0456\u043D, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u043E\u0440\u043E\u0436\u0438\u0445
      \u0447\u0435\u0440\u0435\u043F\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241181
    m_Localized: "\"\u041A\u0443\u043B\u0430\u043A \u043C\u0456\u043D\u043E\u0442\u0430\u0432\u0440\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241182
    m_Localized: "\u041A\u0443\u0432\u0430\u043B\u0434\u0430, \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044E \u0433\u0440\u0456\u0437\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E. \u041F\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u0435
      \u0434\u0440\u0435\u0432\u043A\u043E \u0437 \u043C\u0456\u0446\u043D\u043E\u0433\u043E
      \u0434\u0443\u0431\u0430 \u043E\u0431\u0431\u0438\u0442\u0435 \u0437\u0430\u043B\u0456\u0437\u043E\u043C,
      \u0430 \u0443\u0434\u0430\u0440\u043D\u0443 \u0447\u0430\u0441\u0442\u0438\u043D\u0443
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E \u0440\u0435\u0431\u0440\u0438\u0441\u0442\u043E\u044E
      \u0434\u043B\u044F \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F
      \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241183
    m_Localized: "\u0421\u043E\u043A\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241184
    m_Localized: "\u0426\u0456\u0454\u044E \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u043E\u044E
      \u0441\u043E\u043A\u0438\u0440\u043E\u044E \u0437\u0440\u0443\u0447\u043D\u043E
      \u043F\u0440\u043E\u0440\u0443\u0431\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0442\u043E\u0432\u043F\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241185
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0439
      \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241186
    m_Localized: "\u0422\u0430\u043A\u0456 \u043C\u0435\u0447\u0456 \u043F\u0456\u0434
      \u0447\u0430\u0441 \u0412\u0456\u0439\u043D\u0438 \u0432\u0438\u0434\u0430\u0432\u0430\u043B\u0438\u0441\u044F
      \u043A\u043E\u0436\u043D\u043E\u043C\u0443 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u043E\u043C\u0443
      \u043E\u0444\u0456\u0446\u0435\u0440\u0443, \u0449\u043E \u043C\u0430\u0454
      \u0437\u0432\u0430\u043D\u043D\u044F \u0446\u0435\u043D\u0442\u0443\u0440\u0456\u043E\u043D\u0430
      \u0456 \u0432\u0438\u0449\u0435. \u0425\u043E\u0447\u0430 \u0434\u043E \u0457\u0445
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F \u0441\u043F\u0440\u0430\u0432\u0430
      \u0434\u043E\u0445\u043E\u0434\u0438\u043B\u0430 \u0440\u0456\u0434\u043A\u043E,
      \u0442\u043E\u0436 \u0446\u0435 \u0440\u0430\u0434\u0448\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u043D\u0430
      \u0440\u0456\u0447, \u043D\u0456\u0436 \u0431\u043E\u0439\u043E\u0432\u0430
      \u0437\u0431\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241187
    m_Localized: "\"\u0421\u0432\u0456\u0442\u0430\u043D\u043E\u043A\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241188
    m_Localized: "\u0426\u0435\u0439 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0439
      \u043C\u0435\u0447, \u0432\u043E\u0447\u0435\u0432\u0438\u0434\u044C, \u043D\u0430\u043B\u0435\u0436\u0430\u0432
      \u044F\u043A\u0456\u0439\u0441\u044C \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0439
      \u0448\u0438\u0448\u0446\u0456. \u041F\u0440\u043E \u0446\u0435 \u0441\u0432\u0456\u0434\u0447\u0438\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u0435 \u043E\u0437\u0434\u043E\u0431\u043B\u0435\u043D\u043D\u044F
      \u0433\u0430\u0440\u0434\u0438 \u0456 \u043D\u0430\u043F\u0438\u0441 \u043D\u0430
      \u043A\u043B\u0438\u043D\u043A\u0443 \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u043C\u0438
      \u0433\u043B\u0456\u0444\u0430\u043C\u0438. \u041D\u0430 \u0436\u0430\u043B\u044C,
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u043C\u043E\u0436\u043B\u0438\u0432\u0438\u043C \u0439\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241189
    m_Localized: "\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0439 \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241190
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043B\u044F\u0434
      \u043D\u0430\u0447\u0435\u0431\u0442\u043E \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0439 \u043C\u0435\u0447,
      \u043E\u0441\u044C \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u043E \u0439\u043E\u0433\u043E
      \u043A\u043B\u0438\u043D\u043A\u0443 \u0440\u0430\u0437 \u0443 \u0440\u0430\u0437
      \u043F\u0440\u043E\u0431\u0456\u0433\u0430\u044E\u0442\u044C \u0440\u043E\u0437\u0440\u044F\u0434\u0438
      \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043E\u043A. \u0429\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456-\u0442\u043E
      \u0434\u043B\u044F \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0445
      \u043C\u0435\u0447\u0456\u0432 \u043D\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241191
    m_Localized: "\"\u0421\u043B\u043E\u0432\u043E \u0426\u0435\u0437\u0430\u0440\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241192
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0439
      \u043C\u0435\u0447, \u0449\u043E \u043A\u043E\u043B\u0438\u0441\u044C \u043D\u0430\u043B\u0435\u0436\u0430\u0432
      \u043B\u0435\u0433\u0430\u0442\u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u0456\u0437
      \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0438\u0445 \u043B\u0435\u0433\u0456\u043E\u043D\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241193
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u043A\u0438\u043D\u0434\u0436\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241194
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430 \u0437\u0431\u0440\u043E\u044F,
      \u0449\u043E \u043F\u043E\u0454\u0434\u043D\u0443\u0454 \u0432 \u0441\u043E\u0431\u0456
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457
      \u0442\u0430 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457.
      \u0417\u0430\u0432\u0434\u0430\u0454 \u0448\u043A\u043E\u0434\u0438 \u043F\u043B\u0430\u0437\u043C\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241195
    m_Localized: "\u041A\u0456\u0433\u043E\u0442\u044C \u0433\u043E\u043D\u0447\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241196
    m_Localized: "\u0414\u043E\u0432\u0433\u0438\u0439 \u043A\u0438\u043D\u0434\u0436\u0430\u043B,
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u0437 \u043A\u0456\u0433\u0442\u044F
      \u0432\u0430\u0442\u0430\u0436\u043A\u0430 \u043F\u0435\u043A\u0435\u043B\u044C\u043D\u0438\u0445
      \u0433\u043E\u043D\u0447\u0430\u043A\u0456\u0432, \u044F\u043A\u043E\u0433\u043E
      \u0432\u0438 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u043B\u0438 \u0432
      \u0431\u043E\u044E. \u0426\u0435\u0439 \u043A\u0456\u0433\u043E\u0442\u044C
      \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u0439 \u0437\u0430 \u0441\u0442\u0430\u043B\u044C
      \u0456 \u0433\u043E\u0441\u0442\u0440\u0456\u0448\u0438\u0439 \u0437\u0430
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439 \u0431\u043E\u0439\u043E\u0432\u0438\u0439
      \u043D\u0456\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241197
    m_Localized: "\u041C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241198
    m_Localized: "\u0421\u0442\u0430\u0440\u043E\u0432\u0438\u043D\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u0433\u043E \u0431\u043E\u044E,
      \u0456 \u0432\u0441\u0435 \u0449\u0435 \u0443 \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E\u043C\u0443
      \u0441\u0442\u0430\u043D\u0456. \u0414\u0443\u0436\u0435 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430
      \u0437\u0430 \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0433\u043E \u0432\u043C\u0456\u043D\u043D\u044F,
      \u0430\u043B\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454 \u0447\u0438\u043C\u0430\u043B\u043E\u0433\u043E
      \u0434\u043E\u0441\u0432\u0456\u0434\u0443 \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0437 \u043D\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241199
    m_Localized: "\"\u0417\u043E\u0440\u044F\u043D\u0430 \u043B\u044E\u0442\u044C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241200
    m_Localized: "\u0426\u0435\u0439 \u043C\u0435\u0447 \u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0442\u0438\u043C, \u0449\u043E \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u043D\u0435 \u0437\u0456 \u0441\u0442\u0430\u043B\u0456, \u0430 \u0437 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E\u0433\u043E
      \u043D\u0430\u0443\u0446\u0456 \u043C\u0435\u0442\u0430\u043B\u0443. \u0412\u0456\u043D
      \u043C\u0430\u0439\u0436\u0435 \u043D\u0435 \u0442\u0443\u043F\u0438\u0442\u044C\u0441\u044F,
      \u0430 \u0432\u043E\u0440\u043E\u0436\u0443 \u0431\u0440\u043E\u043D\u044E
      \u0440\u0456\u0436\u0435, \u044F\u043A \u043A\u0430\u0440\u0442\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241201
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241202
    m_Localized: "\u0425\u0430\u0439 \u0431\u0443\u0434\u0435 \u0437 \u0442\u043E\u0431\u043E\u044E
      \u0421\u0438\u043B\u0430, \u044E\u043D\u0438\u0439 \u043F\u0430\u0434\u0430\u0432\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241203
    m_Localized: "\"\u0410\u0443\u0440\u0443\u043C\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241204
    m_Localized: "\u041F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0439 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u043C\u0435\u0447, \u0449\u043E \u0441\u0432\u0456\u0442\u0438\u0442\u044C\u0441\u044F
      \u0437\u043E\u043B\u043E\u0442\u0438\u043C \u0441\u0432\u0456\u0442\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241205
    m_Localized: "\u0421\u0443\u043F\u0435\u0440\u043A\u0443\u0432\u0430\u043B\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241206
    m_Localized: "\u0412\u0438\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F, \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430
      \u0456\u043D\u0435\u0440\u0446\u0456\u0439\u043D\u0438\u043C \u0430\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u043E\u043C,
      \u0449\u043E \u043D\u0430\u043A\u043E\u043F\u0438\u0447\u0443\u0454 \u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0443
      \u0435\u043D\u0435\u0440\u0433\u0456\u044E. \u041F\u0456\u0434 \u0447\u0430\u0441
      \u0443\u0434\u0430\u0440\u0443 \u0432\u043E\u043D\u0430 \u0432\u0438\u0432\u0456\u043B\u044C\u043D\u044F\u0454\u0442\u044C\u0441\u044F,
      \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u044E\u0447\u0438 \u0441\u0438\u043B\u0443
      \u0443\u0434\u0430\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241207
    m_Localized: "\"\u041C\u043E\u043B\u043E\u0442 \u0432\u0456\u0439\u043D\u0438\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241208
    m_Localized: "\u0421\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E \u043E\u0431\u0442\u044F\u0436\u0435\u043D\u0430
      \u0441\u0443\u043F\u0435\u0440\u043A\u0443\u0432\u0430\u043B\u0434\u0430, \u044F\u0432\u043D\u043E
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0430 \u0434\u043B\u044F \u043A\u043E\u0433\u043E\u0441\u044C
      \u0434\u0443\u0436\u0435 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u0456
      \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E. \u0421\u0442\u0440\u0430\u0448\u043D\u043E
      \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438
      \u043F\u0440\u043E \u0442\u0435, \u044F\u043A\u043E\u0457 \u0436\u0430\u0445\u043B\u0438\u0432\u043E\u0457
      \u0441\u0438\u043B\u0438 \u0431\u0443\u0434\u0435 \u0457\u0457 \u0443\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241209
    m_Localized: "\u0422\u0435\u0440\u043C\u043E\u0441\u043F\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241210
    m_Localized: "\u0425\u043E\u0447\u0430 \u0446\u044F \u0437\u0431\u0440\u043E\u044F
      \u0456 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0434\u043E \u043A\u043B\u0430\u0441\u0443
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457, \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432\u043E\u043D\u0430 \u0434\u0443\u0436\u0435, \u0434\u0443\u0436\u0435
      \u0433\u0430\u0440\u044F\u0447\u0430! \u0417\u0430\u0432\u0434\u044F\u043A\u0438
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0456\u0439 \"\u0432\u0456\u0447\u043D\u0456\u0439\"
      \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0457\u0457 \u0432\u043E\u043B\u044C\u0444\u0440\u0430\u043C\u043E\u0432\u0435
      \u0436\u0430\u043B\u043E \u0432 \u0431\u043E\u044E \u043C\u043E\u0436\u0435
      \u0440\u043E\u0437\u0436\u0430\u0440\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438
      \u0432 \u043A\u0456\u043B\u044C\u043A\u0430 \u0442\u0438\u0441\u044F\u0447
      \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432, \u0437 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u044E
      \u043B\u0435\u0433\u043A\u0456\u0441\u0442\u044E \u043F\u0440\u043E\u043F\u0430\u043B\u044E\u044E\u0447\u0438
      \u0432\u043E\u0440\u043E\u0436\u0443 \u0431\u0440\u043E\u043D\u044E \u0456
      \u043F\u043B\u043E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241211
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u0441\u043F\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241212
    m_Localized: "\u0426\u044F \u0440\u0456\u0447 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u043E\u0432\u043D\u0456 \u043D\u0430\u0433\u0430\u0434\u0443\u0454 \u0441\u043F\u0438\u0441.
      \u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0436 \u0446\u0435
      \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0438\u0439 \u0441\u043F\u043B\u0430\u0432
      \u043C\u0430\u0433\u0456\u0457 \u0442\u0430 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439
      - \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F \u0431\u043B\u0438\u0436\u043D\u044C\u043E\u0433\u043E
      \u0431\u043E\u044E, \u0449\u043E \u0437\u0430\u0432\u0434\u0430\u0454 \u0446\u0456\u043B\u0456
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u043F\u043B\u0430\u0437\u043C\u043E\u044E \u0456 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0437\u043C\u0456\u043D\u043D\u0438\u0445 \u0431\u0430\u0442\u0430\u0440\u0435\u0439
      \u0434\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241213
    m_Localized: "\"\u041B\u043E\u0433\u043E\u0441\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241214
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u0441\u043F\u0438\u0441, \u043B\u0435\u0437\u043E \u044F\u043A\u043E\u0433\u043E
      \u0441\u044F\u0454 \u0445\u043E\u043B\u043E\u0434\u043D\u0438\u043C \u043C\u0456\u0441\u044F\u0447\u043D\u0438\u043C
      \u0441\u0432\u0456\u0442\u043B\u043E\u043C \u0456 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0442\u0440\u0435\u043C\u0442\u0438\u0442\u044C \u0432\u0456\u0434 \u0441\u0438\u043B\u0438,
      \u0449\u043E \u043F\u0435\u0440\u0435\u043F\u043E\u0432\u043D\u044E\u0454 \u0439\u043E\u0433\u043E.
      \u0421\u043A\u043B\u0430\u0434\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u044F\u043A\u0430 \u0441\u0430\u043C\u0435 \u043C\u0430\u0433\u0456\u044F
      \u0431\u0443\u043B\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0430
      \u0434\u043B\u044F \u0439\u043E\u0433\u043E \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F,
      \u0430\u043B\u0435 \u0432\u043E\u043D\u0430 \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E
      \u0432\u0441\u0435\u043B\u044F\u0454 \u043F\u043E\u0432\u0430\u0433\u0443 \u0456
      \u043D\u0430\u0432\u0456\u0442\u044C \u0441\u0442\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241215
    m_Localized: "\u041F\u043E\u0445\u043C\u0443\u0440\u0438\u0439 \u0436\u043D\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241216
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0437 \u043A\u0440\u0430\u0457\u043D\u0438 \u0437\u0435\u0431\u0440, \u0449\u043E
      \u0432\u043E\u043B\u043E\u0434\u0456\u0454 \u0437\u043B\u043E\u0432\u0456\u0441\u043D\u043E\u044E
      \u0456 \u043D\u0435\u0437\u0434\u043E\u043B\u0430\u043D\u043D\u043E\u044E \u0441\u0438\u043B\u043E\u044E.
      \u0412\u043E\u043D\u0430 \u0437\u0434\u0430\u0442\u043D\u0430 \u043F\u0435\u0440\u0435\u0440\u0456\u0437\u0430\u0442\u0438
      \u0442\u0456 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0456 \u043D\u0438\u0442\u043A\u0438,
      \u0449\u043E \u043F\u043E\u0432'\u044F\u0437\u0443\u044E\u0442\u044C \u0434\u0443\u0448\u0456
      \u0439 \u0442\u0456\u043B\u0430 \u0436\u0438\u0432\u0438\u0445 \u0456\u0441\u0442\u043E\u0442,
      \u0456\u0433\u043D\u043E\u0440\u0443\u044E\u0447\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0431\u0440\u043E\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241217
    m_Localized: "\u0421\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0438\u0439 \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241218
    m_Localized: "\u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043D\u0456\u044F\u043A\u0438\u0439
      \u0446\u0435 \u043D\u0435 \u043C\u0435\u0447, \u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u0430 \u0441\u0442\u0430\u043B\u0435\u0432\u0430
      \u043B\u043E\u043F\u0430\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440\u0430, \u043E\u0441\u043D\u043E\u0432\u0430
      \u044F\u043A\u043E\u0457 \u0434\u043B\u044F \u0437\u0440\u0443\u0447\u043D\u043E\u0441\u0442\u0456
      \u043E\u0431\u043C\u043E\u0442\u0430\u043D\u0430 \u0448\u043A\u0456\u0440\u044F\u043D\u0438\u043C
      \u0440\u0435\u043C\u0435\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241219
    m_Localized: "\u0422\u0435\u0441\u0442\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241220
    m_Localized: "\u0420\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u043A\u0430\u043B.
      32"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241221
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0440\u0456\u043B\u0430 \u0456 \u043C\u0430\u043B\u043E\u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430
      \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u0430 \u0437\u0431\u0440\u043E\u044F,
      \u043C\u0430\u0454 \u043D\u0438\u0437\u044C\u043A\u0443 \u0448\u043A\u043E\u0434\u0443
      \u0456 \u0442\u0435\u043C\u043F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241222
    m_Localized: "9-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241223
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0456\u0441\u0456\u043D\u044C\u043A\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u0432\u0438\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0434\u043E \u0412\u0456\u0439\u043D\u0438 \u0434\u043B\u044F \u043F\u043E\u0442\u0440\u0435\u0431
      \u0446\u0438\u0432\u0456\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241224
    m_Localized: "10-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241225
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0438\u0439,
      \u0448\u0438\u0440\u043E\u043A\u043E \u043F\u043E\u0448\u0438\u0440\u0435\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043F\u0430\u0442\u0440\u043E\u043D\u0438 10-\u043C\u043C. \u0419\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0430\u043C\u0438 \u0454 \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0430
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457, \u043D\u0430\u0434\u0456\u0439\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0434\u0435\u0448\u0435\u0432\u0438\u0437\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241226
    m_Localized: "\"\u0421\u0430\u043C\u043E\u0442\u043D\u0456\u0439 \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241227
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 10-\u043C\u043C
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
      \u0437\u0456\u0431\u0440\u0430\u043D\u0438\u0439 \u044F\u043A\u0438\u043C\u043E\u0441\u044C
      \u0442\u0430\u043B\u0430\u043D\u043E\u0432\u0438\u0442\u0438\u043C \u0443\u043C\u0456\u043B\u044C\u0446\u0435\u043C.
      \u0423 \u043D\u044C\u043E\u043C\u0443 \u0454 \u043D\u0438\u0437\u043A\u0430
      \u0441\u0443\u0442\u0442\u0454\u0432\u0438\u0445 \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E\u0441\u0442\u0435\u0439
      \u0432\u0456\u0434 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0457
      \u043C\u043E\u0434\u0435\u043B\u0456, \u0456 \u0437\u0430\u0433\u0430\u043B\u043E\u043C
      \u0439\u043E\u0433\u043E \u0431\u043E\u0439\u043E\u0432\u0456 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u043D\u0430 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0432\u0438\u0449\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241228
    m_Localized: "\u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442 \u0456\u0437 \u0433\u043B\u0443\u0448\u043D\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241229
    m_Localized: "\u0417\u043B\u0435\u0433\u043A\u0430 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      10-\u043C\u043C \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u0438\u0439
      \u0433\u043B\u0443\u0448\u043D\u0438\u043A\u043E\u043C. \u0412\u0438\u0434\u0430\u0454
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043C\u0435\u043D\u0448\u0435
      \u0448\u0443\u043C\u0443 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438,
      \u0430\u043B\u0435 \u0437\u0430 \u0446\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0440\u043E\u0437\u043F\u043B\u0430\u0447\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E\u044E \u0441\u0438\u043B\u043E\u044E
      \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443."
