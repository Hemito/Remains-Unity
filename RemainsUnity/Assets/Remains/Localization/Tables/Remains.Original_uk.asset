  - m_Id: 2725242169
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439,
      \u0449\u043E \u043F\u0456\u0434'\u0454\u0434\u043D\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0430. \u041D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0438\u0439
      \u043D\u0430 \u043F\u043E\u0448\u0443\u043A \u0434\u0440\u0456\u0431\u043D\u0438\u0445
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432,
      \u0432\u0456\u043D \u0434\u0430\u0441\u0442\u044C \u0432\u0430\u043C \u0437\u043C\u043E\u0433\u0443
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438 \u0437\u0430\u0433\u0443\u0431\u043B\u0435\u043D\u0456
      \u043A\u0440\u0438\u0448\u043A\u0438 \u0456 \u043F\u0430\u0442\u0440\u043E\u043D\u0438
      \u0432 \u043D\u0430\u0439\u043D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u0456\u0448\u0438\u0445
      \u043C\u0456\u0441\u0446\u044F\u0445."
