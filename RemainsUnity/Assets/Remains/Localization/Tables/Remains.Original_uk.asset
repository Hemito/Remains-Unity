  - m_Id: 2725241231
    m_Localized: "\u041D\u0430\u0439\u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0438\u0439
      \u0437\u0440\u0430\u0437\u043E\u043A \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0449\u043E \u0441\u0442\u0440\u0456\u043B\u044F\u0454
      \u0447\u0435\u0440\u0432\u043E\u043D\u0438\u043C\u0438 \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u043C\u0438
      \u043F\u0440\u043E\u043C\u0435\u043D\u044F\u043C\u0438. \u041D\u0435\u0432\u0438\u0441\u043E\u043A\u0430
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0438\u0437\u044C\u043A\u043E\u044E \u0432\u0438\u0442\u0440\u0430\u0442\u043E\u044E
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E
      \u0437 \u0433\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241232
    m_Localized: "\"\u0410\u043D\u0430\u0440\u0445\u0456\u0441\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241233
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0439 \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u0439
      \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442, \u0441\u0445\u043E\u0436\u0435,
      \u0437\u0456\u0431\u0440\u0430\u043D\u0438\u0439 \u0443\u0436\u0435 \u043F\u0456\u0441\u043B\u044F
      \u0412\u0456\u0439\u043D\u0438. \u0412\u0456\u043D \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u043E\u044E \u0456 \u0454\u043C\u043D\u0456\u0448\u043E\u044E
      \u0431\u0430\u0442\u0430\u0440\u0435\u0454\u044E, \u0430 \u043D\u0430 \u0439\u043E\u0433\u043E
      \u043A\u043E\u0440\u043F\u0443\u0441\u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u044E
      \u0444\u0430\u0440\u0431\u043E\u044E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \"\u0425\u041E\u0419!\"."
