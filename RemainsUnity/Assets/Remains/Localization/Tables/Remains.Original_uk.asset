      m_Items: []
  - m_Id: 2737824549
    m_Localized: "\u0427\u0430\u0441 \u0456\u0442\u0438 \u0437\u0430 \u0431\u0440\u043E\u043D\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824550
    m_Localized: "\u0429\u043E? @lp, \u0442\u0438 \u0442\u0443\u0442? \u0410\u043B\u0435
      \u044F\u043A \u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824551
    m_Localized: "\u041D\u0435\u043C\u0430\u0454 \u0447\u0430\u0441\u0443 \u043D\u0430
      \u0431\u0430\u043B\u0430\u0447\u043A\u0438, \u0432\u043E\u0440\u043E\u0433\u0438
      \u0432\u0436\u0435 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u043B\u043E\u043C\u043B\u044F\u0442\u044C\u0441\u044F
      \u0443 \u0434\u0432\u0435\u0440\u0456 \u0456 \u0441\u043A\u043E\u0440\u043E
      \u043C\u043E\u0436\u0443\u0442\u044C \u0443\u0432\u0456\u0440\u0432\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u044E\u0434\u0438. \u042F \u043C\u0430\u044E
      \u043D\u0430\u043C\u0456\u0440 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
      \u043F\u0440\u043E\u0442\u0438 \u043D\u0438\u0445 \u0432\u0430\u0448\u0443
      \"\u0411\u0440\u043E\u043D\u044E \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\".
      \u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C \u043C\u0435\u043D\u0456
      \u0432\u0434\u044F\u0433\u043D\u0443\u0442\u0438 \u0457\u0457 \u0456 \u043F\u043E\u044F\u0441\u043D\u0456\u0442\u044C
      \u0441\u043A\u043E\u0440\u0456\u0448\u0435, \u044F\u043A \u043D\u0435\u044E
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824552
    m_Localized: "\u0422\u043E\u0431\u0442\u043E \u044F\u043A \u0446\u0435 \"\u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C
      \u0432\u0434\u044F\u0433\u043D\u0443\u0442\u0438\"? \u0422\u0438, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448, \u0449\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0448. \u0406 \u0434\u0435 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824553
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043C\u0435\u0440\u0442\u0432\u0438\u0439!
      \u0412\u043E\u043D\u0438 \u0432\u0431\u0438\u043B\u0438 \u0439\u043E\u0433\u043E,
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u0432\u0438 \u0432\u0441\u0456 \u0441\u043B\u0443\u0445\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u043C\u0435\u043D\u0435, \u044F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0442\u0435
      \u0432\u0438\u0436\u0438\u0442\u0438 \u0441\u0430\u043C\u0456 \u0456 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u0421\u0442\u0456\u0439\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824554
    m_Localized: "\u0412\u0456\u043D \u043F\u043E\u043C\u0435\u0440?! \u0406 \u0449\u043E
      \u0442\u0435\u043F\u0435\u0440..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824555
    m_Localized: "\u0410\u043B\u0435 \u043C\u0438 \u0457\u0457 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043D\u0435
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0438! \u0426\u0435
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E
      \u044F\u043A \u0434\u043B\u044F \u0442\u0435\u0431\u0435, \u0442\u0430\u043A
      \u0456 \u0434\u043B\u044F \u0432\u0441\u0456\u0445 \u043D\u0430\u0432\u043A\u043E\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824556
    m_Localized: "\u041E\u0441\u044C \u0456 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u044E
      \u043F\u0440\u044F\u043C\u043E \u0432 \u0431\u043E\u044E! \u041D\u0443 \u0436
      \u0431\u043E! \u0427\u0430\u0441\u0443 \u043D\u0430 \u0441\u0443\u043F\u0435\u0440\u0435\u0447\u043A\u0438
      \u043D\u0435\u043C\u0430\u0454!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824557
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, @lp... \u0412\u043E\u043D\u0430...
      \u043C\u0430\u0454 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438.
      \u042F \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F. \u042F\u043A\u0449\u043E
      \u0446\u0435 \u0442\u0430\u043A, \u0443 \u0432\u043E\u0440\u043E\u0433\u0430
      \u043D\u0435 \u0431\u0443\u0434\u0435 \u0448\u0430\u043D\u0441\u0456\u0432
      \u043F\u0440\u043E\u0442\u0438 \u0442\u0435\u0431\u0435. \u0414\u0430\u0432\u0430\u0439\u0442\u0435,
      \u0445\u043B\u043E\u043F\u0446\u0456 \u0456 \u0434\u0456\u0432\u0447\u0430\u0442\u0430,
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
      \u0456\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824558
    m_Localized: "\u0415\u0435\u0435\u0435\u0435... \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
      \u0447\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824559
    m_Localized: "\u041D\u0435\u0439\u0440\u043E\u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441
      \"\u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\"
      \u043C\u0430\u0454 \u0437\u043B\u0438\u0442\u0438\u0441\u044F \u0437 \u0442\u0432\u043E\u0454\u044E
      \u043D\u0435\u0440\u0432\u043E\u0432\u043E\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E.
      \u0426\u0435, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0431\u0443\u0434\u0435...
      \u0442\u0440\u043E\u0445\u0438 \u0431\u043E\u043B\u044F\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824560
    m_Localized: "\u0406\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E
      \u0443\u0441\u043F\u0456\u0448\u043D\u043E. \u0421\u0443\u043C\u0456\u0441\u043D\u0456\u0441\u0442\u044C
      \u0456\u0437 \u043C\u043E\u0437\u043A\u043E\u043C \u043D\u043E\u0441\u0456\u044F
      - \u0432\u0438\u0449\u0430 \u0437\u0430 \u0441\u0435\u0440\u0435\u0434\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824561
    m_Localized: "\u0423\u0441\u0456 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0432
      \u043D\u043E\u0440\u043C\u0456. \u0420\u043E\u0431\u043E\u0447\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C...
      \u0435-\u0435-\u0435... 19 \u0432\u0456\u0434\u0441\u043E\u0442\u043A\u0456\u0432
      \u0432\u0456\u0434 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u043E\u0432\u043E\u0457,
      \u0430\u043B\u0435 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0454 \u0437\u0440\u043E\u0441\u0442\u0430\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824562
    m_Localized: "\u042F\u043A \u043F\u043E\u0447\u0443\u0432\u0430\u0454\u0448\u0441\u044F,
      @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824563
    m_Localized: "\u0414\u0443\u0436\u0435 \u0434\u0438\u0432\u043D\u0456 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F.
      \u0411\u0440\u043E\u043D\u044F \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F, \u043D\u0456\u0431\u0438
      \u0432\u043E\u043D\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430 \u043C\u0435\u043D\u0435...
      \u0406 \u0449\u0435, \u044F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E...
      \u0441\u0438\u043B\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824564
    m_Localized: "\u0426\u0435 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E,
      \u0442\u0432\u0456\u0439 \u043C\u043E\u0437\u043E\u043A \u0437\u0430\u0440\u0430\u0437
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454 \u0435\u0439\u0444\u043E\u0440\u0456\u044E,
      \u0430\u043B\u0435 \u043D\u0435 \u0434\u0430\u0439 \u0441\u0435\u0431\u0435
      \u043E\u0431\u0434\u0443\u0440\u0438\u0442\u0438. \u041F\u0430\u043C'\u044F\u0442\u0430\u0439,
      \"\u0411\u0440\u043E\u043D\u044F \u0410\u043B\u0456\u043A\u043E\u043D\u0430\"
      \u043D\u0435 \u0440\u043E\u0431\u0438\u0442\u044C \u0442\u0435\u0431\u0435
      \u043D\u0435\u0432\u0440\u0430\u0437\u043B\u0438\u0432\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824565
    m_Localized: "\u0420\u043E\u0431\u043E\u0447\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C
      - 24 \u0432\u0456\u0434\u0441\u043E\u0442\u043A\u0438 \u0432\u0456\u0434 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u043E\u0432\u043E\u0457,
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0437\u0440\u043E\u0441\u0442\u0430\u0454.
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438
      \u0432\u0445\u0456\u0434\u043D\u0456 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438
      \u0456 \u043F\u0456\u0434\u043A\u043E\u0440\u0438\u0433\u0443\u0432\u0430\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824566
    m_Localized: "\u0410\u043B\u0435 \u0446\u0435 \u0437\u0430\u0439\u043C\u0435
      \u043D\u0435 \u043E\u0434\u043D\u0443 \u0433\u043E\u0434\u0438\u043D\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824567
    m_Localized: "\u041D\u0430 \u0446\u0435 \u043D\u0435\u043C\u0430\u0454 \u0447\u0430\u0441\u0443!
      \u0412\u043F\u043E\u0440\u0430\u044E\u0441\u044F \u0437 \u0442\u0438\u043C,
      \u0449\u043E \u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824568
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u044E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043D\u044F
      \u0434\u0430\u0442\u0447\u0438\u043A\u0456\u0432. \u0412\u043E\u0440\u043E\u0433
      \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0443\u0454 \u0441\u0432\u043E\u0457
      \u0441\u0438\u043B\u0438 \u0431\u0456\u043B\u044F \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E
      \u0432\u0445\u043E\u0434\u0443. \u0412\u043E\u043D\u0438 \u0433\u043E\u0442\u0443\u044E\u0442\u044C
      \u043D\u043E\u0432\u0443 \u0433\u0440\u0443\u043F\u0443 \u0448\u0442\u0443\u0440\u043C\u0443!
      \u0421\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439\u0441\u044F \u0435\u0432\u0430\u043A\u0443\u0430\u0446\u0456\u0439\u043D\u0438\u043C
      \u0442\u0443\u043D\u0435\u043B\u0435\u043C - \u0442\u0430\u043C, \u043B\u0456\u0432\u043E\u0440\u0443\u0447,
      \u0432\u0456\u043D \u0442\u0435\u0431\u0435 \u0432\u0438\u0432\u0435\u0434\u0435
      \u043C\u0430\u0439\u0436\u0435 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u0432\u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824569
    m_Localized: "\u041D\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u0439 \u043F\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0456.
      \u0406 \u043D\u0435 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0441\u044F
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824570
    m_Localized: "\u041C\u0438 \u0431\u0443\u0434\u0435\u043C\u043E \u043C\u043E\u043B\u0438\u0442\u0438\u0441\u044F
      \u0437\u0430 \u0442\u0435\u0431\u0435 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u0457.
      \u0422\u0438 - \u043D\u0430\u0448 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u0448\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824571
    m_Localized: "\"\u0411\u0440\u043E\u043D\u044F \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\""
    m_Metadata:
      m_Items: []
  - m_Id: 2737824572
    m_Localized: "\"\u0411\u0440\u043E\u043D\u044F \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\"
      - \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0438\u0439 \u0441\u043F\u043B\u0430\u0432
      \u043C\u0430\u0433\u0456\u0457 \u0442\u0430 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439,
      \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u0443 \u0421\u0442\u0456\u0439\u043B\u0456
      \u041F\u0456. \u0412\u043E\u043D\u0430 \u0434\u0430\u0454 \u0441\u0432\u043E\u0454\u043C\u0443
      \u043D\u043E\u0441\u0456\u044E \u0447\u0443\u0434\u043E\u0432\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442,
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u043E \u043F\u043E\u043B\u044C\u043E\u0442\u0443,
      \u043F\u0456\u0434\u0441\u0438\u043B\u044E\u0454 \u0439\u043E\u0433\u043E \u0437\u0431\u0440\u043E\u044E
      \u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456,
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      \u0439\u043E\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F. \u041D\u0430\u0432\u0438\u0447\u043A\u0438
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0442\u044C
      \u043D\u0430 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u0431\u0440\u043E\u043D\u0456, \u043D\u0430\u0434\u0430\u044E\u0447\u0438
      \u0457\u0439 \u043D\u043E\u0432\u0438\u0445 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      (\u0434\u0438\u0432. \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \"\u041D\u0430\u0432\u0438\u0447\u043A\u0438\"
      \u0443 \u0432\u0430\u0448\u043E\u043C\u0443 \u041F\u0456\u043F\u0411\u0430\u043A\u0443).
      \u0423 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0456 \u0437 \u0431\u0440\u043E\u043D\u0435\u044E
      \u0439\u0434\u0435 \u043A\u0456\u043B\u044C\u043A\u0430 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u043E\u0434\u0438\u043D\u0438\u0446\u044C \u0437\u0431\u0440\u043E\u0457,
      \u044F\u043A\u0456 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u044C
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432 (\u0434\u0438\u0432.
      \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \"\u0417\u0431\u0440\u043E\u044F\"
      \u0443 \u0432\u0430\u0448\u043E\u043C\u0443 \u041F\u0456\u043F\u0411\u0430\u043A\u0443).\n\u0421\u0438\u043B\u0438
      \u0442\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456:\n-
      \u0417\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u043E \u043F\u043E\u043B\u044C\u043E\u0442\u0443
      \u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u044F
      \u0432 \u043F\u043E\u043B\u044C\u043E\u0442\u0456.\n- \u041F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0456 \u0437\u0430\u0445\u0438\u0441\u043D\u0456
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438.\n-
      \u041C\u0430\u0433\u0456\u0447\u043D\u0435 \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043D\u044F
      \u0432\u0441\u0456\u0445 \u0432\u0438\u0434\u0456\u0432 \u0437\u0431\u0440\u043E\u0457
      \u0442\u0430 \u0431\u043E\u0439\u043E\u0432\u043E\u0457 \u043C\u0430\u0433\u0456\u0457.\n-
      \u0411\u0443\u0434\u044C-\u044F\u043A\u0430 \u0437\u0431\u0440\u043E\u044F
      \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0430 \u0432\u0456\u0434 \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C
      \u0456 \u0437\u043D\u043E\u0441\u0443.\n- \u0412\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0435
      \u0431\u043E\u0439\u043E\u0432\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443
      \u0456 \u0449\u0438\u0442\u0430 (\u0434\u0438\u0432. \u0432\u043A\u043B\u0430\u0434\u043A\u0443
      \"\u041D\u0430\u0432\u0438\u0447\u043A\u0438\").\n- \u0406\u043C\u0443\u043D\u0456\u0442\u0435\u0442
      \u0434\u043E \u0442\u0440\u0430\u0432\u043C, \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0456\u044F
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438.\n\u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E:\n-
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0445\u0456\u043C\u0456\u0457,
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u0437\u0456\u043B\u044C (\u043E\u043A\u0440\u0456\u043C
      \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0445) \u0456
      \u0457\u0436\u0456.\n- \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
      \u0456\u043D\u0448\u0438\u0445 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C, \u043E\u043A\u0440\u0456\u043C
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u043E\u0433\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0449\u0438\u0442\u0430.\n- \u041A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430\u043C\u0438 \u041C\u0422\u041D."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824573
    m_Localized: "@lp? \u0429\u043E \u0446\u0435 \u043D\u0430 \u0442\u043E\u0431\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824574
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437.
      \u0426\u0435 - \u043F\u0440\u043E\u0435\u043A\u0442 \u043C\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430, \u0437\u0430 \u044F\u043A\u0438\u043C
      \u0442\u0430\u043A \u0433\u043D\u0430\u0432\u0441\u044F \u041A\u043E\u043B\u0434\u0441\u0430\u0439\u0442.
      \u0417\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F, \u044F \u0442\u0440\u043E\u0445\u0438
      \u0437\u0434\u0438\u0432\u043E\u0432\u0430\u043D\u0430, \u0449\u043E \u0442\u0438
      \u0432\u043F\u0456\u0437\u043D\u0430\u0432 \u043C\u0435\u043D\u0435 \u0432
      \u043D\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824575
    m_Localized: "\u041C\u0456\u0439 \u043B\u043E\u043A\u0430\u0442\u043E\u0440 \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0432
      \u0442\u0435\u0431\u0435 \u044F\u043A \u0434\u0440\u0443\u0436\u043D\u044E
      \u0446\u0456\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824576
    m_Localized: "\u042F\u0441\u043D\u043E. \u042F \u0431\u0430\u0447\u0443, \u0442\u0438
      \u0442\u0443\u0442 \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0454\u0448\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824577
    m_Localized: "\u0414\u0438\u043B\u0435\u0442\u0430\u043D\u0442\u0438. \u0412\u043E\u0440\u043E\u0433
      \u0432\u043E\u043B\u043E\u0434\u0456\u0454 \u0456\u0441\u0442\u043E\u0442\u043D\u043E\u044E
      \u0447\u0438\u0441\u0435\u043B\u044C\u043D\u043E\u044E \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u043E\u044E
      \u0456 \u0447\u0443\u0434\u043E\u0432\u0438\u043C \u0435\u043A\u0456\u043F\u0456\u0440\u0443\u0432\u0430\u043D\u043D\u044F\u043C,
      \u043F\u0440\u043E\u0442\u0435 \u0439\u043E\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F
      \u0433\u0443\u0431\u0438\u0442\u044C\u0441\u044F \u043F\u0456\u0441\u043B\u044F
      \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0436 \u0437\u0456\u0442\u043A\u043D\u0435\u043D\u043D\u044F
      \u0437 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u043C
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C \u0456 \u043D\u0435
      \u043C\u043E\u0436\u0435 \u0430\u0434\u0435\u043A\u0432\u0430\u0442\u043D\u043E
      \u0441\u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0443\u0432\u0430\u0442\u0438
      \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044E \u0433\u0440\u0443\u043F.
      \u041F\u043E\u043A\u0438 \u0449\u043E \u0442\u0430\u043A\u0442\u0438\u0447\u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0430 \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443
      \u0431\u043E\u0446\u0456. \u042F \u043F\u0440\u043E\u0441\u0442\u0435\u0436\u0443
      \u0437\u0430 \u0442\u0438\u043C, \u0449\u043E\u0431 \u0442\u0430\u043A \u0431\u0443\u043B\u043E
      \u0456 \u043D\u0430\u0434\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824578
    m_Localized: "\u0410\u0441\u043A\u0430\u0440\u0456? \u0406 \u0432\u0438 \u0442\u0435\u0436
      \u0442\u0443\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824579
    m_Localized: "\u041C\u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u043D\u0443\u043B\u0438
      \u0432\u0430\u043C \u043A\u043E\u043F\u0438\u0442\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438
      \u0437 \u0444\u043E\u0440\u0442\u043E\u043C \u0420\u043E\u043A\u0441. \u041C\u0438
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0430\u043C
      \u0456 \u0442\u0443\u0442. \u0427\u0430\u0441 \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F
      \u043C\u0438\u043D\u0443\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824580
    m_Localized: "\u0423\u0441\u0456 \u0446\u0456 \u0442\u0440\u0443\u043F\u0438
      - \u0432\u0430\u0448\u0430 \u0440\u043E\u0431\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824581
    m_Localized: "\u0412\u043E\u043D\u0438 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438, \u0449\u043E \u0457\u0445
      \u0443\u0431\u0438\u043B\u043E. \u041D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F,
      @lp, \u043C\u0438 \u043F\u043E\u0434\u0431\u0430\u0454\u043C\u043E \u043F\u0440\u043E
      \u0446\u0438\u0445 \u043B\u0435\u0442\u044E\u0447\u0438\u0445 \u0449\u0443\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824582
    m_Localized: "\u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824583
    m_Localized: "\u041D\u0443 \u044F\u043A, @lp, \u043D\u0430\u0432\u0456\u044E\u0454
      \u0441\u043F\u043E\u0433\u0430\u0434\u0438, \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824584
    m_Localized: "\u0410 \u044F\u043A \u0436\u0435. \u041F\u0440\u043E \u043D\u0430\u0448\u0443
      \u043F\u0435\u0440\u0448\u0443 \u0437\u0443\u0441\u0442\u0440\u0456\u0447.
      \u0422\u0456\u043B\u044C\u043A\u0438 \u044F \u0432\u0436\u0435 \u043D\u0435
      \u0442\u0430, \u0449\u043E \u0440\u0430\u043D\u0456\u0448\u0435, \u0456 \u0441\u0442\u0430\u0432\u043A\u0438
      \u0442\u0435\u043F\u0435\u0440 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0432\u0438\u0449\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824585
    m_Localized: "\u0422\u0438, \u0434\u043E \u0440\u0435\u0447\u0456, \u0442\u0435\u0436
      \u0437\u043C\u0456\u043D\u0438\u0432\u0441\u044F. \u0417\u0432\u0456\u0434\u043A\u0438
      \u0432 \u0442\u0435\u0431\u0435 \u0431\u0440\u043E\u043D\u044F \u0410\u043D\u043A\u043B\u0430\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824586
    m_Localized: "\u041F\u0440\u0438\u0445\u043E\u043F\u0438\u0432 \u043D\u0430 \u0434\u043E\u0432\u0433\u0443
      \u043F\u0430\u043C'\u044F\u0442\u044C, \u0449\u0435 \u0442\u043E\u0434\u0456,
      \u043A\u043E\u043B\u0438 \u0437\u0432\u0430\u043B\u0438\u0432 \u0437 \u0457\u0445\u043D\u044C\u043E\u0457
      \u0430\u0440\u043C\u0456\u0457. \u0410 \u0442\u0435\u043F\u0435\u0440 \u043E\u0441\u044C
      \u0456 \u0437\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F. \u0422\u0438
      \u0432\u0436\u0435 \u0431\u0443\u043B\u0430 \u0443 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0421\u0442\u0456\u0439\u043B\u0456? \u042F\u043A \u0442\u0430\u043C \u0448\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824587
    m_Localized: "\u0412\u0456\u0439\u0441\u044C\u043A\u0430 \u0410\u043D\u043A\u043B\u0430\u0432\u0443
      \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0438 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443,
      \u0430\u043B\u0435, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u043D\u0430\u043C
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u043D\u0438\u0449\u0438\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0456\u0437 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824588
    m_Localized: "\u0415\u0445... \u0448\u043A\u043E\u0434\u0430 \u0442\u0435\u0431\u0435
      \u0440\u043E\u0437\u0447\u0430\u0440\u0443\u0432\u0430\u0442\u0438, \u0430\u043B\u0435
      \u0454 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043A\u0430...
      \u0456 \u0432\u043E\u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0430. \u0414\u0443\u0436\u0435
      \u0432\u0435\u043B\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824589
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043C\u0435\u043D\u0456 \u0432\u043E\u0440\u043E\u0433\u0430.
      \u0423 \u043C\u0435\u043D\u0435 \u0454 \u043F\u0440\u043E \u0449\u043E \u0437
      \u043D\u0438\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824590
    m_Localized: "\u0426\u0435 \u0431\u0443\u0434\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E.
      \u0411\u043E\u044E\u0441\u044F, \u0410\u043D\u043A\u043B\u0430\u0432 \u043F\u0440\u0438\u0441\u043B\u0430\u0432
      \u043F\u043E \u043D\u0430\u0448\u0456 \u0434\u0443\u0448\u0456 [\u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434].
      \u041D\u0430\u043C \u0442\u043E \u0439\u043E\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u043D\u043E
      \u0447\u0435\u0440\u0435\u0437 \u0445\u043C\u0430\u0440\u0438, \u0430\u043B\u0435
      \u0432 \u043C\u043E\u044E \u0431\u0440\u043E\u043D\u044E \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u043E
      \u0442\u0443 \u0441\u0430\u043C\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443
      \u0440\u0430\u0434\u0456\u043E\u0437\u0432'\u044F\u0437\u043A\u0443, \u0448\u043E
      \u0439 \u0443 \u043D\u0438\u0445, \u0456 \u044F \u0447\u0443\u0432 \u0443\u0441\u0456
      \u0457\u0445\u043D\u0456 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824591
    m_Localized: "\u041C\u0435\u043D\u0456 \u0446\u044F \u043D\u0430\u0437\u0432\u0430
      \u043D\u0456 \u043F\u0440\u043E \u0449\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824592
    m_Localized: "\u0426\u0435 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0430
      \u043B\u0456\u0442\u0430\u044E\u0447\u0430 \u0444\u043E\u0440\u0442\u0435\u0446\u044F.
      \u0417 \u043A\u0443\u043F\u043E\u044E \u0433\u0430\u0440\u043C\u0430\u0442,
      \u0434\u0435\u0441\u0430\u043D\u0442\u043E\u043C \u0456 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043C
      \u043F\u043E\u043B\u0435\u043C. \u0429\u0430\u0441 \u043C\u0438 \u0431\u0438\u043B\u0438\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0437 \u0434\u0435\u0441\u0430\u043D\u0442\u043E\u043C,
      \u0430\u0434\u0436\u0435 \u0457\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0437\u044F\u0442\u0438 \u0442\u0432\u043E\u0454 \u0421\u0442\u0456\u0439\u043B\u043E,
      \u0430 \u043D\u0435 \u0431\u043E\u043C\u0431\u0438\u0442\u0438 \u0439\u043E\u0433\u043E,
      \u0442\u043E\u043C\u0443 \u0441\u0430\u043C \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434
      \u0456 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0432\u0441\u044F.
      \u0410\u043B\u0435 \u043F\u043E\u043A\u0438 \u0432\u0456\u043D \u0432\u0438\u0441\u0438\u0442\u044C
      \u0442\u0430\u043C, \u0443 \u043D\u0435\u0431\u0456, \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0438
      \u043D\u0430\u043C \u043D\u0435 \u0431\u0430\u0447\u0438\u0442\u0438. \u0412\u0456\u043D
      \u043C\u043E\u0436\u0435 \u0432\u0438\u0441\u043B\u0430\u0442\u0438 \u0449\u0435
      \u0434\u0435\u0441\u0430\u043D\u0442, \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0432\u043D\u0438\u0437 \u0456 \u0437\u0440\u0456\u0432\u043D\u044F\u0442\u0438
      \u0442\u0443\u0442 \u0443\u0441\u0435 \u0437 \u0437\u0435\u043C\u043B\u0435\u044E
      \u0430\u0431\u043E \u0441\u043A\u0438\u043D\u0443\u0442\u0438 \u0431\u043E\u043C\u0431\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430 \u043D\u0430\u0448\u0456
      \u0433\u043E\u043B\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824593
    m_Localized: "\u0417 \u0442\u0430\u043A\u0438\u043C \u0432\u043E\u0440\u043E\u0433\u043E\u043C
      \u043D\u0435 \u0432\u043F\u043E\u0440\u0430\u0442\u0438\u0441\u044F, @lp, \u043D\u0456\u044F\u043A.
      \u0411\u0443\u0434\u044C \u0432 \u043D\u0430\u0441 \u0446\u0456\u043B\u0430
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F \u041F\u041F\u041E \u0456 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0434\u0440\u0430\u043A\u043E\u043D\u0456\u0432 \u043D\u0430 \u0434\u043E\u0434\u0430\u0447\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824594
    m_Localized: "\u0410\u043B\u0435 \u043C\u0438 \u0436 \u043D\u0435 \u043C\u043E\u0436\u0435\u043C\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0434\u0430\u0442\u0438\u0441\u044F!
      \u0426\u044F \u0431\u0440\u043E\u043D\u044F, \u044F\u043A\u0430 \u0437\u0430\u0440\u0430\u0437
      \u043D\u0430 \u043C\u0435\u043D\u0456... \u0432\u043E\u043D\u0430 \u0440\u043E\u0431\u0438\u0442\u044C
      \u043C\u0435\u043D\u0435 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u043E\u044E,
      \u043D\u0456\u0436 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u0443\u044F\u0432\u0438\u0442\u0438.
      \u0406 \u0442\u0435\u043F\u0435\u0440 \u0443 \u043C\u0435\u043D\u0435 \u0454
      \u043A\u0440\u0438\u043B\u0430. \u042F \u043C\u043E\u0436\u0443 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0437\u043D\u0438\u0449\u0438\u0442\u0438 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434
      \u0443 \u043F\u043E\u0432\u0456\u0442\u0440\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824595
    m_Localized: "\u0426\u0435 \u0441\u0430\u043C\u043E\u0433\u0443\u0431\u0441\u0442\u0432\u043E,
      @lp. \u0425\u043E\u0447\u0430... \u0442\u0438 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0434\u0440\u0456\u0431\u043D\u0430 \u043C\u0456\u0448\u0435\u043D\u044C \u0434\u043B\u044F
      \u0433\u0430\u0440\u043C\u0430\u0442 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434\u0430.
      \u042F\u043A\u0449\u043E \u0437\u043C\u043E\u0436\u0435\u0448 \u0432\u0435\u0441\u044C
      \u0447\u0430\u0441 \u043A\u0440\u0443\u0442\u0438\u0442\u0438\u0441\u044F \u043D\u0430\u0432\u043A\u043E\u043B\u043E
      \u043D\u044C\u043E\u0433\u043E, \u043D\u0435 \u0434\u0430\u044E\u0447\u0438
      \u043F\u043E \u0441\u043E\u0431\u0456 \u0432\u043B\u0443\u0447\u0438\u0442\u0438,
      \u0456 \u044F\u043A\u0449\u043E \u0437\u0443\u043C\u0456\u0454\u0448 \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
      \u0439\u043E\u0433\u043E \u043F\u043E\u043B\u0435... \u0422\u043E\u0434\u0456
      \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u0441\u0430\u043D\u0442\u043D\u0438\u0439 \u043B\u044E\u043A \u0456
      \u0440\u043E\u0437\u043D\u0435\u0441\u0442\u0438 \u0434\u043E \u0431\u0456\u0441\u0430
      \u0439\u043E\u0433\u043E \u0440\u0435\u0430\u043A\u0442\u043E\u0440. \u0426\u044C\u043E\u0433\u043E
      \u0432\u0456\u043D \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824596
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
      \u043F\u043E\u043B\u0435, \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443, \u0437\u043D\u0438\u0449\u0438\u0442\u0438
      \u0440\u0435\u0430\u043A\u0442\u043E\u0440. \u041D\u0435 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u043F\u0456\u0434 \u0433\u0430\u0440\u043C\u0430\u0442\u0438. \u042F \u0432\u0441\u0435
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824597
    m_Localized: "\u0406 \u043F\u043E\u0442\u0456\u043C \u0434\u0443\u0436\u0435
      \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u043C\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
      \u0420\u0432\u043E\u043D\u0435 \u0442\u0430\u043A, \u0449\u043E \u043C\u0430\u043B\u043E
      \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043F\u043E\u043A\u0430\u0436\u0435\u0442\u044C\u0441\u044F.
      \u0413\u0430\u0440\u0430\u0437\u0434, @lp, \u044F\u043A\u0449\u043E \u0442\u0438
      \u0442\u0430\u043A \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430... \u042F
      \u0432\u043A\u0430\u0436\u0443 \u0442\u043E\u0431\u0456 \u043D\u0430\u043F\u0440\u044F\u043C\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824598
    m_Localized: "\u041C\u0438 \u0431\u0443\u0434\u0435\u043C\u043E \u0443\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u0446\u044E \u043F\u043E\u0437\u0438\u0446\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824599
    m_Localized: "\u0412\u043E\u0440\u043E\u0433 \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824600
    m_Localized: "\u041A\u0443\u0434\u0438 \u043B\u0435\u0442\u0456\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824601
    m_Localized: "\u0411\u0430\u0447\u0438\u0448 \u043E\u043D \u0442\u0443 \u0432\u0435\u043B\u0438\u043A\u0443
      \u0445\u043C\u0430\u0440\u0443, \u044F\u043A\u0430 \u043F\u0430\u043B\u0430\u0445\u043A\u043E\u0442\u0438\u0442\u044C
      \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u0430\u043C\u0438? \u041E\u0441\u044C
      \u0442\u0443\u0434\u0438 \u0442\u043E\u0431\u0456 \u0439 \u0442\u0440\u0435\u0431\u0430.
      \u041F\u0435\u0433\u0430\u0441\u0438 \u0432 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434\u0456
      \u043D\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435 \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u0437\u0440\u0435\u0430\u0433\u0443\u044E\u0442\u044C, \u0432\u043E\u043D\u0438
      \u043D\u0456\u0447\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E \u0449\u0430
      \u043D\u0435 \u0447\u0435\u043A\u0430\u044E\u0442\u044C. \u041D\u0430\u043F\u0435\u0432\u043D\u043E.
      \u041A\u043E\u0440\u043E\u0447 \u043B\u0435\u0442\u0438 \u0448\u0432\u0438\u0434\u0448\u0435,
      \u0456 \u0432\u0441\u0442\u0438\u0433\u043D\u0435\u0448 \u043F\u0456\u0434\u043B\u0435\u0442\u0456\u0442\u0438
      \u0434\u043E\u0441\u0438\u0442\u044C \u0431\u043B\u0438\u0437\u044C\u043A\u043E
      \u0434\u043B\u044F \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438, \u043F\u043E\u043A\u0438
      \u0432 \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0447\u043D\u0443\u0442\u044C
      \u043F\u0430\u043B\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824602
    m_Localized: "\u0406 \u0446\u0435, @lp. \u0412\u0438\u0436\u0438\u0432\u0438,
      \u0434\u043E\u0431\u0440\u0435? \u0422\u0438 \u043D\u0430\u0434\u0442\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u043E\u0434\u043E\u043B\u0430\u043B\u0430,
      \u0449\u043E\u0431 \u0437\u0430\u0440\u0430\u0437 \u043E\u0441\u044C \u0442\u0430\u043A
      \u043E\u0441\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824603
    m_Localized: "\u0426\u044F \u0431\u0440\u043E\u043D\u044F \u043D\u0435 \u0434\u0430\u0441\u0442\u044C
      \u043C\u0435\u043D\u0456 \u043F\u043E\u043C\u0435\u0440\u0442\u0438, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456.
      \u0417\u0430\u0440\u0430\u0437 \u044F \u0437\u043C\u043E\u0436\u0443 \u0445\u043E\u0447
      \u0446\u0456\u043B\u0435 \u043C\u0456\u0441\u0442\u043E \u0437\u043D\u0438\u0449\u0438\u0442\u0438.
      \u041D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F \u0437\u0430
      \u043C\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824604
    m_Localized: "\u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434 \u0442\u0435\u0436
      \u043C\u043E\u0436\u0435. \u0411\u0443\u0434\u044C \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824605
    m_Localized: "\u041D\u0435 \u0431\u0456\u0439\u0441\u044F. \u042F \u0431\u0443\u0434\u0443
      \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824606
    m_Localized: "\u041F\u043E\u043B\u0435 \u0432\u0438\u043C\u043A\u043D\u0443\u043B\u043E\u0441\u044F!
      \u0422\u0435\u043F\u0435\u0440 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824607
    m_Localized: "\u0410 \u0442\u0435\u043F\u0435\u0440 \u0448\u0432\u0438\u0434\u043A\u043E
      \u0432\u0430\u043B\u0438\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824608
    m_Localized: "\u0429\u043E... \u0449\u043E \u0446\u0435 \u0431\u0443\u043B\u043E?
      \u042F\u043A\u043E\u0433\u043E \u0441\u0456\u043D\u0430? \u042F \u043F\u0430\u0434\u0430\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824609
    m_Localized: "\u041C\u0435\u043D\u0435 \u043D\u0430\u043A\u0440\u0438\u043B\u043E
      \u0432\u0438\u0431\u0443\u0445\u043E\u043C! \u0406... \u044F \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043A\u0435\u0440\u0443\u044E \u0431\u0440\u043E\u043D\u0435\u044E!
      \u0412\u043E\u043D\u0430 \u0449\u043E, \u0432\u0438\u0440\u0443\u0431\u0438\u043B\u0430\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824610
    m_Localized: "\u041D\u0456-\u043D\u0456-\u043D\u0456-\u043D\u0456-\u043D\u0456!!!
      \u0414\u043E\u0432\u0431\u0430\u043D\u0456 \u043A\u0440\u0438\u043B\u0430,
      \u043F\u0440\u0430\u0446\u044E\u0439\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824611
    m_Localized: "\u041D\u0435 \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824612
    m_Localized: "\u0429\u043E \u0440\u043E\u0431\u0438\u0442\u0438?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824613
    m_Localized: "\u0410! \u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437!
      \u0421\u0430\u043C\u043E\u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u044F!
      \u0423\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438 \u043F\u0430\u0434\u0456\u043D\u043D\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824614
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824615
    m_Localized: "\u041D\u0435 \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824616
    m_Localized: "\u0417\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0441\u0438\u043B..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824617
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824618
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442\u044C, \u043E\u0441\u044C
      \u0442\u0430\u043A \u0432\u0441\u0435 \u0456 \u0441\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824619
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u043E\u0437\u0456\u0431'\u044E\u0441\u044F,
      \u0432\u043F\u0430\u0432\u0448\u0438 \u0437 \u0445\u043C\u0430\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824620
    m_Localized: "\u042F\u043A \u0436\u0435 \u0442\u0443\u043F\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824621
    m_Localized: "\u0417\u043B\u043E\u0432\u0438\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824622
    m_Localized: "\u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824623
    m_Localized: "\u0410\u0433\u0430\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824624
    m_Localized: "\u041E\u0441\u044C \u0446\u0435 \u0440\u0432\u0430\u043D\u0443\u043B\u043E
      \u0442\u0430\u043A \u0440\u0432\u0430\u043D\u0443\u043B\u043E! \u0419\u0456\u0456\u0456\u0456\u0456-\u0445\u0430\u0430\u0430\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824625
    m_Localized: "\u041E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824626
    m_Localized: "\u041D\u0435 \u0440\u043E\u0431\u0438 \u0442\u0430\u043A \u0431\u0456\u043B\u044C\u0448\u0435,
      \u0433\u0430\u0440\u0430\u0437\u0434? \u041F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043F\u0443\u0441\u0442\u0438 \u043C\u0435\u043D\u0435 \u043D\u0430
      \u0437\u0435\u043C\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824627
    m_Localized: "\u041D\u0443 \u0434\u043E\u0431\u0440\u0435, @lp! \u042F\u043A
      \u0441\u043A\u0430\u0436\u0435\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824628
    m_Localized: "\u042F\u043A \u0441\u043F\u0440\u0430\u0432\u0438 \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824629
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E \u0449\u0430. \u0410\u043B\u0435
      \u0442\u0438 \u0433\u043B\u044F\u043D\u044C! \u0410\u043D\u043A\u043B\u0430\u0432\u0456\u0432\u0446\u0456
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043B\u0435\u0442\u044F\u0442\u044C
      \u0432\u043D\u0438\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824630
    m_Localized: "\u0429\u043E \u0432\u043E\u043D\u0438 \u0442\u043E\u0434\u0456
      \u0440\u043E\u0431\u043B\u044F\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824631
    m_Localized: "\u041D\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u044E \u043F\u043E\u043A\u0438
      \u0448\u043E! \u0410\u043B\u0435, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0432\u043E\u043D\u0438 \u0437\u0430\u0440\u0430\u0437 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434! \u042F \u0431 \u0442\u0430\u043A \u0441\u0430\u043C\u043E
      \u0437\u0440\u043E\u0431\u0438\u0432, \u044F\u043A\u0431\u0438 \u043D\u0430\u0448
      \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434 \u0440\u0432\u043E\u043D\u0443\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824632
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0442\u043E\u0434\u0456 \u0448\u0432\u0438\u0434\u0448\u0435
      \u0434\u043E \u043D\u0430\u0448\u0438\u0445! \u0429\u043E \u0431 \u0442\u0430\u043C
      \u043D\u0435 \u0431\u0443\u043B\u043E, \u043C\u0438 \u0437\u0430\u0440\u0430\u0437
      \u043C\u0430\u0454\u043C\u043E \u0431\u0443\u0442\u0438 \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824633
    m_Localized: "\u041D\u0456, @lp, \u0437\u0432\u0438\u043D\u044F\u0439, \u0430\u043B\u0435
      \u044F \u0431\u0430\u0447\u0443, \u0448\u043E \u0442\u0438 \u0449\u0430\u0441
      \u0432\u0436\u0435 \u043D\u0435 \u0431\u043E\u0454\u0446\u044C. \u0422\u0430
      \u0439 \u0442\u0438 \u0443\u0436\u0435 \u0437\u0440\u043E\u0431\u0438\u043B\u0430
      \u0441\u0432\u043E\u044E \u0441\u043F\u0440\u0430\u0432\u0443. \u0414\u0430\u043B\u0456
      \u0432\u0436\u0435 \u0442\u0430\u043C \u0441\u0430\u043C\u0456 \u0431\u0435\u0437
      \u0442\u0435\u0431\u0435 \u0437\u0430\u043A\u0456\u043D\u0447\u0430\u0442\u044C
      \u0431\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824634
    m_Localized: "\u0406 \u043D\u0430\u0440\u0435\u0448\u0442\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824635
    m_Localized: "\u0421\u0445\u043E\u0436\u0435, \u0449\u043E \u0432\u0441\u0456
      \u043F\u0440\u0438\u0439\u0448\u043B\u0438, @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824636
    m_Localized: "\u0421\u0432\u044F\u0442\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F.
      \u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0436 \u043F\u043E\u043D\u0456
      \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824637
    m_Localized: "\u041F\u043E\u043D\u0456, \u0437\u0435\u0431\u0440. \u0417\u0435\u043C\u043D\u043E\u043F\u043E\u043D\u0456,
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432... \u043F\u0435\u0433\u0430\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824638
    m_Localized: "\u0406 \u0446\u0435 \u0449\u0435 \u043D\u0435 \u043A\u0456\u043D\u0435\u0446\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824639
    m_Localized: "\u0410\u043B\u0435 \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u0432 \u043D\u0430\u0441 \u0431\u0443\u0434\u0435 \u043F\u0435\u0440\u0435\u043F\u043E\u0447\u0438\u043D\u043E\u043A.
      \u0412\u0442\u0440\u0430\u0442\u0430 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C
      \u0441\u0432\u043E\u0433\u043E \u0444\u043B\u0430\u0433\u043C\u0430\u043D\u0441\u044C\u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u0456 \u0431\u0456\u043B\u044C\u0448\u043E\u0457
      \u0447\u0430\u0441\u0442\u0438\u043D\u0438 \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443\u044E\u0447\u043E\u0457
      \u0443\u0434\u0430\u0440\u043D\u043E\u0457 \u0433\u0440\u0443\u043F\u0438 \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u0438\u043B\u0430
      \u0432\u043E\u0440\u043E\u0433\u0430. \u041D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438,
      \u0449\u043E, \u0437\u0430 \u043C\u043E\u0457\u043C\u0438 \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u043D\u044F\u043C\u0438,
      \u0432\u0456\u043D \u043F\u0440\u0438\u0437\u0443\u043F\u0438\u043D\u0438\u0432
      \u0431\u043E\u0439\u043E\u0432\u0456 \u0434\u0456\u0457 \u0432 \u0456\u043D\u0448\u0438\u0445
      \u0440\u0435\u0433\u0456\u043E\u043D\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824640
    m_Localized: "\u0410\u0433\u0430\u0441\u044C. \u0422\u0430\u043A\u0438\u0445
      \u0432\u0442\u0440\u0430\u0442 \u0443 \u043D\u0430\u0441... \u0443 \u043D\u0438\u0445.
      \u0422\u0430\u043A\u0438\u0445 \u0432\u0442\u0440\u0430\u0442 \u0443 \u043D\u0438\u0445
      \u043D\u0435 \u0431\u0443\u043B\u043E... \u0422\u0430\u043A, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0431\u0443\u043B\u043E.
      \u041C\u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u043B\u0438
      \u0449\u0435, \u0437\u0432\u0456\u0441\u043D\u043E. \u0410\u043B\u0435 \u0442\u0435\u043F\u0435\u0440
      \u0443 \u043D\u0438\u0445 \u0442\u0430\u043C, \u0443 \u0445\u043C\u0430\u0440\u0430\u0445,
      \u043A\u0456\u043F\u0456\u0448 \u0437\u043D\u0430\u0442\u043D\u0438\u0439 \u043F\u0456\u0434\u043D\u044F\u0442\u0438\u0441\u044F
      \u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824641
    m_Localized: "\u041C\u0438 \u0437\u0456\u0431\u0440\u0430\u043B\u0438\u0441\u044F
      \u0442\u0443\u0442, \u0449\u043E\u0431 \u0440\u0430\u0437\u043E\u043C \u0437
      @lp \u0456 \u0412\u0435\u043B\u044C\u0432\u0435\u0442 \u0432\u0448\u0430\u043D\u0443\u0432\u0430\u0442\u0438
      \u043F\u0430\u043C'\u044F\u0442\u044C \u0457\u0445\u043D\u044C\u043E\u0433\u043E
      \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430. \u0414\u0443\u043C\u0430\u044E,
      \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457
      \u043A\u0440\u0430\u0449\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438
      \u043D\u0430 \u043F\u043E\u0442\u0456\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824642
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430, \u043A\u043E\u043B\u0435\u0433\u0438.
      \u0414\u043B\u044F \u0434\u0435\u043A\u043E\u0433\u043E - \u0434\u0440\u0443\u0433\u0430.
      \u0423\u0441\u0456 \u043C\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0434\u0440\u0443\u0437\u0456\u0432 \u0456 \u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0445.
      \u0417\u0430\u0440\u0430\u0437 \u043D\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441
      \u0432\u0456\u0434\u0434\u0430\u0442\u0438 \u043D\u0430\u043B\u0435\u0436\u043D\u0435
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0437 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824643
    m_Localized: "*\u0422\u0423\u0422 \u041F\u041E\u041A\u041E\u0407\u0422\u042C\u0421\u042F\n\u0421\u0406\u041B\u042C\u0412\u0415\u0420
      \u041C\u0415\u0419\u041D\n\u041F\u043E\u043D\u0456, \u044F\u043A\u0438\u0439
      \u0445\u043E\u0442\u0456\u0432 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
      \u043C\u0438\u043D\u0443\u043B\u0435.*"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824644
    m_Localized: "\u0425\u0430\u0439 \u043F\u0440\u0438\u0439\u043C\u0435 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F
      \u0432 \u043E\u0431\u0456\u0439\u043C\u0438 \u0439\u043E\u0433\u043E \u0434\u0443\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824645
    m_Localized: "\u0412\u0456\u043D \u043D\u0435 \u0431\u0443\u0432 \u0441\u0430\u043C\u043E\u0442\u043D\u0456\u043C
      \u0443 \u0441\u0432\u043E\u0457\u0445 \u043F\u0440\u0430\u0433\u043D\u0435\u043D\u043D\u044F\u0445.
      \u0411\u0430\u0433\u0430\u0442\u043E \u043F\u043E\u043D\u0456, \u044F\u043A\u0438\u0445
      \u044F \u0437\u043D\u0430\u0432, \u0445\u043E\u0442\u0456\u043B\u0438 \u0442\u043E\u0433\u043E
      \u0441\u0430\u043C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824646
    m_Localized: "\u0410\u043B\u0435 \u043D\u0435 \u0432\u0441\u0456 \u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438,
      \u0449\u043E \u0446\u0435 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824647
    m_Localized: "\u041C\u0438\u043D\u0443\u043B\u0435... \u041C\u0438\u043D\u0443\u043B\u0435
      \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u043E \u0440\u0430\u0437\u043E\u043C
      \u0456\u0437 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824648
    m_Localized: "\u041D\u0456. \u041C\u0438 \u0432\u0441\u0456 \u0441\u0442\u043E\u0457\u043C\u043E
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456 \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E.
      \u0412\u043E\u043D\u043E \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u0454 \u043D\u0430\u0441
      \u0456 \u0440\u043E\u0431\u0438\u0442\u044C \u0442\u0430\u043A\u0438\u043C\u0438,
      \u044F\u043A\u0438\u043C\u0438 \u043C\u0438 \u0454. \u0406 \u0432\u043E\u043D\u043E
      \u0437\u0440\u0435\u0448\u0442\u043E\u044E \u043F\u0440\u0438\u0432\u0435\u043B\u043E
      \u043D\u0430\u0441 \u0443\u0441\u0456\u0445 \u0441\u044E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824649
    m_Localized: "\u0426\u0456\u043A\u0430\u0432\u043E... \u0427\u0438 \u043C\u043E\u0436\u043D\u0430
      \u0431\u0443\u043B\u043E \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0432\u0441\u0435
      \u0456\u043D\u0430\u043A\u0448\u0435? \u042F\u043A\u0431\u0438 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u043D\u0435 \u043F\u043E\u0441\u0438\u043B\u0430\u0432 \u043D\u0430\u0441
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E, \u044F\u043A\u0431\u0438
      \u044F \u043D\u0435 \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438.
      \u0406 \u044F\u043A\u0431\u0438... \u043D\u0435 \u043F\u043E\u0434\u0456\u0457
      \u043D\u0430 \u0431\u0430\u0437\u0456 \u0410\u043D\u043A\u043B\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824650
    m_Localized: "\u0425\u0442\u043E \u0437\u043D\u0430\u0454. \u042F \u0431 \u0441\u043A\u0430\u0437\u0430\u0432,
      \u0449\u043E \u043C\u043E\u0436\u0435 \u0456\u043D\u0430\u043A\u0448\u0435
      \u0432\u0441\u0435 \u0431\u0443\u043B\u043E. \u0410\u043B\u0435 \u043D\u0435
      \u0441\u0438\u043B\u044C\u043D\u043E. \u0423\u0441\u0435 \u0446\u0435, \u0449\u043E
      \u0431\u0443\u043B\u043E, \u0432\u0441\u0435 \u0440\u0430\u043D\u043E \u0447\u0438
      \u043F\u0456\u0437\u043D\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F \u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824651
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0446\u0435 \u0439
      \u0442\u0430\u043A. \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456 \u043D\u0435
      \u043C\u043E\u0433\u043B\u043E \u0431\u0443\u0442\u0438 \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u043C
      \u0432\u0456\u0447\u043D\u0456\u0441\u0442\u044C. \u0420\u0430\u043D\u043E
      \u0447\u0438 \u043F\u0456\u0437\u043D\u043E \u0446\u0435 \u043C\u0430\u043B\u043E
      \u0441\u0442\u0430\u0442\u0438\u0441\u044F, \u0442\u0430\u043A \u0447\u0438
      \u0456\u043D\u0430\u043A\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824652
    m_Localized: "\u0410\u043B\u0435 \u0454 \u0434\u0435\u0449\u043E, \u0449\u043E
      \u043C\u043E\u0433\u043B\u043E \u0431 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u044F. \u041C\u0438 \u043C\u043E\u0433\u043B\u0438
      \u0431 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438
      \u043F\u043E\u043D\u0456, \u044F\u043A\u0456 \u0431\u0443\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u0456
      \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438 \u0436\u0430\u0445\u0438 \u041F\u0443\u0441\u0442\u043A\u0438
      \u0456 \u043D\u0435 \u0434\u0430\u0442\u0438 \u0457\u043C \u0441\u0435\u0431\u0435
      \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u0442\u0438. \u041F\u043E\u043D\u0456,
      \u044F\u043A\u0456 \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F
      \u0431 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0440\u0435\u0447\u0435\u0439 \u0443 \u0446\u044C\u043E\u043C\u0443 \u0441\u0432\u0456\u0442\u0456.
      \u0406 \u044F\u043A\u0456 \u0434\u0430\u043B\u0438 \u0431 \u043D\u0430\u0434\u0456\u044E
      \u043D\u0430 \u043A\u0440\u0430\u0449\u0435 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824653
    m_Localized: "\u0406\u0441\u0442\u0438\u043D\u043D\u043E \u0442\u0430\u043A.
      \u0426\u0435\u0439 \u0441\u0432\u0456\u0442 \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u0433\u0440\u0443\u0437 \u0443 \u0432\u0456\u0434\u0447\u0430\u0457
      \u0442\u0430 \u0431\u0456\u0434\u0430\u0445. \u0410\u043B\u0435 \u043F\u043E\u043A\u0438
      \u0454 \u0442\u0456, \u0445\u0442\u043E \u0432\u0456\u0440\u0438\u0442\u044C
      \u0443 \u043A\u0440\u0430\u0449\u0438\u0439 \u0441\u0432\u0456\u0442, \u043D\u0430\u0434\u0456\u044F
      \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824654
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438. \u0412\u0456\u0439\u043D\u0430
      \u043D\u0435 \u0437\u043C\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824655
    m_Localized: "\u0410\u043B\u0435 \u043F\u043E\u043D\u0456... \u041F\u043E\u043D\u0456
      \u043C\u043E\u0436\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824656
    m_Localized: "\u0413\u0435\u0439, @lp. \u042F \u0437\u043D\u0430\u044E, \u0448\u043E
      \u0447\u0430\u0441 \u0442\u0438\u043F \u043D\u0435 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439,
      \u0430\u043B\u0435 \u0437\u043D\u0430\u0454\u0448, \u0442\u043E\u0439 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434
      \u0442\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0445\u0440\u0456\u043D\u0456\u0442\u0438
      \u044F\u043A \u0440\u043E\u0437\u0431\u0438\u043B\u0430. \u0422\u0430 \u0431\u0440\u043E\u043D\u044F
      - \u0446\u0435 \u0456 \u0454 \u0442\u0430 \u0441\u043F\u0440\u0430\u0432\u0430,
      \u0437\u0430 \u044F\u043A\u043E\u044E \u0442\u0435\u0431\u0435 \u043F\u043E\u0441\u043B\u0430\u043B\u0438
      \u0434\u043E \u043D\u0430\u0441 \u0441\u044E\u0434\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824657
    m_Localized: "\u0422\u0430\u043A, \u0445\u043E\u0447 \u044F \u0439 \u043D\u0435
      \u0437\u043D\u0430\u043B\u0430 \u043F\u0440\u043E \u0446\u0435. \u0414\u0443\u043C\u0430\u044E,
      \u0443 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430 \u0431\u0443\u043B\u0438
      \u0456\u043D\u0448\u0456 \u043F\u043B\u0430\u043D\u0438, \u043D\u0456\u0436
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0446\u0435\u0439 \u0435\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442
      \u0443 \u0432\u0456\u0439\u043D\u0456 \u0437 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824658
    m_Localized: "\u0410\u043B\u0435 \u0432\u0456\u043D \u043D\u0430\u043C \u0434\u0443\u0436\u0435
      \u0434\u043E\u043F\u043E\u043C\u0456\u0433. \u041D\u0443, \u0442\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0430,
      \u044F \u043F\u0440\u043E \u0446\u0435. \u0412\u0456\u043D \u0449\u0435 \u043F\u0440\u0430\u0446\u044E\u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824659
    m_Localized: "\u041D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u0432\u0456\u043D
      \u0442\u0435\u043F\u0435\u0440 \u0437\u043C\u043E\u0436\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u044F\u043A \u0440\u0430\u043D\u0456\u0448\u0435. \u0410\u043B\u0435 \u044F\u043A
      \u043C\u0456\u043D\u0456\u043C\u0443\u043C \u043B\u0456\u0442\u0430\u0442\u0438
      \u0437 \u043D\u0438\u043C \u044F \u0437\u043C\u043E\u0436\u0443 \u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824660
    m_Localized: "\u0406 \u0442\u043E \u0445\u043B\u0456\u0431. \u0421\u043B\u0443\u0445,
      \u043F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448, \u044F \u0442\u043E\u0431\u0456
      \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u0432 \u0443 \u043D\u0430\u0441
      \u0443 \u0413\u0430\u0440\u0446\u044E\u044E\u0447\u043E\u043C\u0443 \u043A\u043E\u0440\u0456\u043D\u043D\u044F
      \u043F\u0443\u0441\u0442\u0438\u0442\u0438? \u042F\u043A\u0448\u043E \u0442\u0438
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B\u0430,
      \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044F \u0432 \u0441\u0438\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824661
    m_Localized: "\u042F \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435 \u0437\u043D\u0430\u044E.
      \u0410\u043B\u0435 \u0434\u044F\u043A\u0443\u044E. \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
      \u044F \u0442\u043E\u0447\u043D\u043E \u0431\u0443\u0434\u0443 \u0443 \u0432\u0430\u0441
      \u0437'\u044F\u0432\u043B\u044F\u0442\u0438\u0441\u044F. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043F\u0435\u0440\u0448\u0438\u0439 \u0447\u0430\u0441, \u043F\u043E\u043A\u0438
      \u043C\u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u043C\u043E\u0436\u0435\u043C\u043E
      \u0410\u043D\u043A\u043B\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824662
    m_Localized: "\u0417\u043D\u0430\u0454\u0448, \u0449\u043E\u0434\u043E \u0446\u044C\u043E\u0433\u043E.
      \u042F \u0449\u0430 \u043D\u0435 \u0431\u0443\u0434\u0443 \u0432\u0441\u0435
      \u043F\u043E\u044F\u0441\u043D\u044E\u0432\u0430\u0442\u0438 \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445,
      \u0430\u043B\u0435, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u0456\u0439\u043D\u0438
      \u0439 \u043D\u0435 \u0431\u0443\u0434\u0435 \u0434\u0430\u043B\u0456. \u0423
      \u043D\u0430\u0441 \u0442\u0430\u043C, \u043D\u0430\u0434 \u0445\u043C\u0430\u0440\u0430\u043C\u0438,
      \u0441\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0435,
      \u0456 \u0410\u043D\u043A\u043B\u0430\u0432 \u0442\u0430\u043C \u043D\u0435
      \u0432\u0441\u0435\u0441\u0438\u043B\u044C\u043D\u0438\u0439 \u0437\u043E\u0432\u0441\u0456\u043C.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043F\u0456\u0441\u043B\u044F
      \u0442\u0430\u043A\u0438\u0445 \u0432\u0442\u0440\u0430\u0442 \u0439\u043E\u0433\u043E
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u043C\u0435\u0442\u0443\u0442\u044C.
      \u0410 \u043C\u043E\u0436\u0435 \u0439 \u043D\u0456. \u0410\u043B\u0435 \u0442\u0435\u043F\u0435\u0440
      \u0443 \u043D\u044C\u043E\u0433\u043E \u0442\u043E\u0447\u043D\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438
      \u0431\u0443\u0434\u0443\u0442\u044C \u043A\u0440\u0456\u043C \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824663
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0456 \u043D\u043E\u0432\u0438\u043D\u0438.
      \u0414\u044F\u043A\u0443\u044E, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824664
    m_Localized: "\u041D\u0443, \u0446\u0435 \u0432\u0441\u0435 \u0449\u0435 \u0432\u0438\u043B\u0430\u043C\u0438
      \u043F\u043E \u0432\u043E\u0434\u0456 \u043F\u0438\u0441\u0430\u043D\u043E.
      \u0410\u043B\u0435 \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F
      \u0437\u0430\u0433\u0430\u043B\u043E\u043C. \u042F\u043A \u043D\u0430\u0441\u0442\u0430\u043D\u0435
      \u043C\u0438\u0440, \u0437\u0430\u0441\u043A\u0430\u043A\u0443\u0439 \u0434\u043E
      \u043D\u0430\u0441 \u0447\u0430\u0441\u0442\u0456\u0448\u0435, \u043C\u043E\u0436\u0435,
      \u043F\u043E\u043B\u0456\u0442\u0430\u0454\u043C\u043E \u0440\u0430\u0437\u043E\u043C.
      \u0414\u0430\u0432\u043D\u043E \u044F \u043D\u0435 \u043B\u0456\u0442\u0430\u0432
      \u043D\u0456 \u0437 \u043A\u0438\u043C \u0456\u0437 \u0434\u0440\u0443\u0437\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824665
    m_Localized: "\u041E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824666
    m_Localized: "\u0417\u043D\u0430\u0454\u0448, \u0443 \u0433\u043B\u0438\u0431\u0438\u043D\u0456
      \u0434\u0443\u0448\u0456 \u044F \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u043D\u0430\u043B\u0430,
      \u0449\u043E \u0442\u0430\u043A \u0432\u0441\u0435 \u0456 \u0441\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u043F\u0456\u0448\u043B\u0430
      \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430, \u0442\u043E\u043C\u0443
      \u0449\u043E \u0445\u043E\u0442\u0456\u043B\u0430 \u043D\u0435 \u0434\u0430\u0442\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824667
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436 \u0446\u0435 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043C\u043E\u044F \u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824668
    m_Localized: "\u0422\u0430\u043A. \u0422\u0432\u043E\u044F \u0442\u0435\u0436.
      \u0410\u043B\u0435 \u0432\u043E\u043D\u0430 \u043B\u0435\u0436\u0438\u0442\u044C
      \u0456 \u043D\u0430 \u043C\u0435\u043D\u0456. \u0410\u0434\u0436\u0435 \u0446\u0435
      \u044F \u0437\u0440\u0435\u0448\u0442\u043E\u044E \u0441\u0432\u043E\u0454\u044E
      \u0432\u0456\u0434\u043C\u043E\u0432\u043E\u044E \u0437\u043C\u0443\u0441\u0438\u043B\u0430
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438
      \u043D\u043E\u0432\u043E\u0433\u043E \u041E\u0431\u0440\u0430\u043D\u043E\u0433\u043E
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E. \u042F\u043A\u0431\u0438
      \u043D\u0435 \u044F, \u0442\u0438 \u0431 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F
      \u0432\u0434\u043E\u043C\u0430. \u0406 \u0445\u0442\u043E \u0437\u043D\u0430\u0454,
      \u044F\u043A \u0441\u043A\u043B\u0430\u043B\u0438\u0441\u044F \u0431 \u0441\u043F\u0440\u0430\u0432\u0438,
      \u044F\u043A\u0431\u0438 \u044F \u0432\u0438\u043A\u043E\u043D\u0430\u043B\u0430
      \u0441\u0432\u043E\u044E \u043C\u0456\u0441\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824669
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824670
    m_Localized: "\u042F\u043A\u0431\u0438 \u0442\u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
      \u0432 \u043C\u0438\u043D\u0443\u043B\u0435, \u0443 \u0434\u0435\u043D\u044C,
      \u043A\u043E\u043B\u0438 \u0442\u0438 \u0437\u0433\u043E\u043B\u043E\u0441\u0438\u043B\u0430\u0441\u044F
      \u0441\u0442\u0430\u0442\u0438 \u041E\u0431\u0440\u0430\u043D\u043E\u044E,
      \u0442\u0438 \u0431 \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F
      \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u043F\u0456\u0442\u0438 \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E? \u0417\u043D\u0430\u044E\u0447\u0438,
      \u0449\u043E \u043D\u0430 \u0442\u0435\u0431\u0435 \u0442\u0443\u0442 \u0447\u0435\u043A\u0430\u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824671
    m_Localized: "\u0411\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E. \u041F\u0456\u0441\u043B\u044F
      \u0432\u0441\u044C\u043E\u0433\u043E \u0442\u043E\u0433\u043E, \u0449\u043E
      \u044F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456,
      \u043C\u0435\u043D\u0456 \u0442\u0456\u043B\u044C\u043A\u0438 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435
      \u0445\u043E\u0447\u0435\u0442\u044C\u0441\u044F \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u0438
      \u0442\u0443\u0442 \u0445\u043E\u0447 \u0449\u043E\u0441\u044C. \u0426\u0435
      \u0431\u0443\u0434\u0435 \u0434\u043E\u0432\u0433\u0438\u0439 \u0448\u043B\u044F\u0445,
      @lp, \u0434\u0443\u0436\u0435 \u0434\u043E\u0432\u0433\u0438\u0439. \u0410\u043B\u0435
      \u044F\u043A\u0449\u043E \u044F \u043D\u0435 \u0432\u0456\u0440\u0438\u0442\u0438\u043C\u0443,
      \u0449\u043E \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
      \u043C\u0438\u0440 \u0446\u0438\u043C \u043F\u043E\u043D\u0456, \u044F \u043D\u0435
      \u0437\u043D\u0430\u044E, \u0443 \u0449\u043E \u043C\u0435\u043D\u0456 \u0432\u0456\u0440\u0438\u0442\u0438
      \u0432\u0437\u0430\u0433\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824672
    m_Localized: "\u042F \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443 \u043F\u043E\u043D\u0456
      \u0421\u0442\u0456\u0439\u043B\u0430 \u0442\u0443\u0442. \u0407\u043C \u0431\u0443\u0434\u0435
      \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043A\u043E \u0437\u0430\u0440\u0430\u0437,
      \u043F\u0456\u0441\u043B\u044F \u0441\u0442\u0456\u043B\u044C\u043A\u043E\u0445
      \u0436\u0435\u0440\u0442\u0432 \u0456 \u0437\u043D\u0430\u0439\u043E\u043C\u0441\u0442\u0432\u0430
      \u0437 \u043D\u043E\u0432\u0438\u043C \u0441\u0432\u0456\u0442\u043E\u043C.
      \u0410\u043B\u0435 \u043A\u043E\u043B\u0438 \u0441\u043F\u0440\u0430\u0432\u0438
      \u043F\u0440\u0438\u0439\u0434\u0443\u0442\u044C \u0443 \u043D\u043E\u0440\u043C\u0443,
      \u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0441\u044F \u0434\u043E
      \u0437\u0435\u0431\u0440 \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D\u0430.
      \u042F \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0457\u043C. \u0410
      \u0447\u0438\u043C \u0437\u0430\u0439\u043C\u0435\u0448\u0441\u044F \u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824673
    m_Localized: "\u0423 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454
      \u0432\u0438\u0431\u043E\u0440\u0443. \u042F \u0437\u0430\u0431\u043E\u0440\u0433\u0443\u0432\u0430\u043B\u0430
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0456\u0439
      \u041F\u0443\u0441\u0442\u0446\u0456 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E. \u0422\u0430 \u0439 \u043C\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043F\u0440\u043E \u0446\u0435, \u043F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448?
      \u0422\u0435\u043F\u0435\u0440, \u043A\u043E\u043B\u0438 \u0431\u0430\u0447\u0438\u043B\u0430
      \u0446\u0435 \u043C\u0456\u0441\u0446\u0435 \u043D\u0430 \u0432\u043B\u0430\u0441\u043D\u0456
      \u043E\u0447\u0456, \u044F \u043D\u0435 \u0437\u043C\u043E\u0436\u0443 \u043F\u043E\u043D\u0456
      \u0442\u0443\u0442 \u043A\u0438\u043D\u0443\u0442\u0438. \u042F\u043A \u0456
      \u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824674
    m_Localized: "\u0422\u0438 \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E
      \u043F\u0440\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0432.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043D\u0430\u0441\u0442\u0430\u0432
      \u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824675
    m_Localized: "\u041D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u0446\u0435
      \u0432\u0430\u0436\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824676
    m_Localized: "\u0406 \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824677
    m_Localized: "... \u042F \u0433\u043E\u0432\u043E\u0440\u0438\u0432, \u044F \u0432\u0436\u0435
      \u0434\u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u043D\u0430 \u0437\u0432'\u044F\u0437\u043A\u0443
      \u0437 \u0432\u0430\u0448\u0438\u043C \u0421\u0442\u0456\u0439\u043B\u043E\u043C.
      \u0417\u043D\u0430\u0454\u0448, \u0437\u0430\u0440\u0430\u0437, \u0447\u0435\u0440\u0435\u0437
      \u043C\u0430\u0439\u0436\u0435 \u0434\u0432\u0456\u0441\u0442\u0456 \u0440\u043E\u043A\u0456\u0432
      \u043F\u0456\u0441\u043B\u044F \u0412\u0456\u0439\u043D\u0438, \u0436\u0438\u0442\u0442\u044F
      \u0432 \u041F\u0443\u0441\u0442\u0446\u0456 \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u0446\u0443\u043A\u043E\u0440, \u0430\u043B\u0435 \u0442\u043E\u0434\u0456,
      \u0443 \u043F\u0435\u0440\u0448\u0456 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0456\u0442\u0442\u044F,
      \u0431\u0443\u043B\u043E \u0437\u043E\u0432\u0441\u0456\u043C \u0436\u0430\u0445\u043B\u0438\u0432\u043E.
      \u0423 \u044F\u043A\u0438\u0439\u0441\u044C \u043C\u043E\u043C\u0435\u043D\u0442
      \u044F \u0434\u0443\u043C\u0430\u0432, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0443\u0441\u044F
      \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u044E \u0440\u043E\u0437\u0443\u043C\u043D\u043E\u044E
      \u0456\u0441\u0442\u043E\u0442\u043E\u044E. \u0422\u043E\u043C\u0443 \u044F
      \u043D\u0430\u043C\u0430\u0433\u0430\u0432\u0441\u044F \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438
      \u0442\u0430\u043A\u0456 \u043E\u0441\u0442\u0440\u0456\u0432\u0446\u0456 \u0446\u0438\u0432\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u0457,
      \u044F\u043A \u0432\u0430\u0448 \u0434\u0456\u043C, \u0456 \u043E\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438
      \u0457\u0445. \u0414\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0432, \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0432
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u043A\u043E\u0457\u0442\u044C\u0441\u044F
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E, \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0430\u0432
      \u043F\u0440\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438.
      \u042F \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0432\u0441\u044F, \u0449\u043E
      \u043A\u043E\u043B\u0438 \u0421\u0442\u0456\u0439\u043B\u0443 \u041F\u0456
      \u043D\u0430\u0441\u0442\u0430\u043D\u0435 \u0447\u0430\u0441 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438
      \u0434\u0432\u0435\u0440\u0456, \u0446\u0435 \u0431\u0443\u0434\u0435 \u043D\u0435...
      \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824678
    m_Localized: "\u0410 \u0447\u043E\u043C\u0443 \u0442\u0438 \u043D\u0435 \u0432\u043C\u043E\u0432\u0438\u0432
      \u043D\u0430\u0441 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0441\u044F
      \u0441\u0432\u0456\u0442\u0443? \u0411\u0430\u0433\u0430\u0442\u044C\u043E\u043C
      \u043F\u043E\u043D\u0456 \u0442\u0443\u0442 \u043D\u0430\u0448\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430
      \u043C\u043E\u0433\u043B\u0430 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
      \u0436\u0438\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824679
    m_Localized: "\u0406 \u043D\u0435 \u043C\u0435\u043D\u0448\u0430 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0437\u0430\u0445\u043E\u0442\u0456\u043B\u0430 \u0431 \u0432\u0430\u0448\u043E\u0457
      \u0441\u043C\u0435\u0440\u0442\u0456. \u041F\u043E\u0432\u0456\u0440, @lp,
      \u044F \u0431\u0430\u0447\u0438\u0432 \u0431\u0435\u0437\u043B\u0456\u0447
      \u0440\u0430\u0437\u0456\u0432, \u044F\u043A \u0442\u0430\u043A\u0456 \u0421\u0442\u0456\u0439\u043B\u0430,
      \u044F\u043A \u0442\u0432\u043E\u0454, \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044F
      \u043B\u0438\u0448\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431
      \u0431\u0443\u0442\u0438 \u0437\u043D\u0438\u0449\u0435\u043D\u0438\u043C\u0438
      \u0430\u0431\u043E \u043F\u043E\u043D\u0435\u0432\u043E\u043B\u0435\u043D\u0438\u043C\u0438.
      \u042F \u043D\u0435 \u0445\u043E\u0442\u0456\u0432, \u0449\u043E\u0431 \u0442\u0430\u043A\u0430
      \u0434\u043E\u043B\u044F \u0441\u043F\u0456\u0442\u043A\u0430\u043B\u0430 \u0456
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824680
    m_Localized: "\u0410 \u043D\u0430 \u0449\u043E \u0442\u0438 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0432\u0441\u044F?
      \u0427\u043E\u043C\u0443 \u0434\u0443\u043C\u0430\u0432, \u0449\u043E \u043F\u043E\u0442\u0456\u043C
      \u0431\u0443\u0434\u0435 \u043A\u0440\u0430\u0449\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824681
    m_Localized: "\u042F \u043D\u0435 \u0434\u0443\u043C\u0430\u0432, \u0449\u043E
      \u0431\u0443\u0434\u0435 \u043A\u0440\u0430\u0449\u0435. \u042F \u043B\u0438\u0448\u0435
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0432\u0441\u044F. \u0406 \u043D\u0430\u043C\u0430\u0433\u0430\u0432\u0441\u044F
      \u0437\u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445
      \u043F\u043E\u043D\u0456. \u041F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448,
      \u044F \u0436 \u0436\u0438\u0432 \u0443 \u0447\u0430\u0441\u0438 \u0449\u0435
      \u0434\u043E \u0432\u0456\u0439\u043D\u0438. \u0406 \u0431\u0443\u0432 \u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0439
      \u0456\u0437 \u0431\u0430\u0433\u0430\u0442\u044C\u043C\u0430... \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u0438\u043C\u0438
      \u043F\u043E\u043D\u0456. \u0417\u0430\u0440\u0430\u0437 \u0443 \u0446\u0435
      \u0432\u0430\u0436\u043A\u043E \u043F\u043E\u0432\u0456\u0440\u0438\u0442\u0438,
      \u0430\u043B\u0435, @lp, \u0454 \u0442\u0430\u043A\u0456 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E\u0441\u0442\u0456,
      \u044F\u043A\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u043C\u0456\u043D\u0438\u0442\u0438
      \u0441\u0432\u0456\u0442. \u041D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u0440\u0430\u0437,
      \u0443 \u043D\u0430\u0448\u0456 \u0441\u0443\u0432\u043E\u0440\u0456 \u0447\u0430\u0441\u0438,
      \u0454 \u043D\u0430\u0434\u0456\u044F, \u0449\u043E \u0440\u0430\u043D\u043E
      \u0447\u0438 \u043F\u0456\u0437\u043D\u043E \u0432\u043E\u043D\u0438 \u043F\u0440\u0438\u0439\u0434\u0443\u0442\u044C
      \u0456 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0442\u0443\u0442
      \u0443\u0441\u0435 \u0437 \u043D\u0456\u0433 \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824682
    m_Localized: "\u0410\u043B\u0435 \u0442\u0430\u043A\u0456 \u043F\u043E\u043D\u0456
      - \u043E\u0434\u043D\u0456 \u0437 \u043C\u0456\u043B\u044C\u0439\u043E\u043D\u0430,
      \u0456 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438 \u0457\u0445 \u0432\u043A\u0440\u0430\u0439
      \u0432\u0430\u0436\u043A\u043E. \u041E\u0434\u043D\u0430\u043A \u0454 \u0439
      \u0442\u0456, \u0445\u0442\u043E \u0432\u0441\u0435 \u043E\u0434\u043D\u043E
      \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C \u0446\u0435\u0439 \u0441\u0432\u0456\u0442
      \u043D\u0430 \u043A\u0440\u0430\u0449\u0435. \u0410\u0441\u043A\u0430\u0440\u0456
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0432
      \u043F\u0440\u043E \u0432\u0430\u0441. \u0422\u0438 \u0456 \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      - \u0432\u0438 \u043D\u0435 \u043F\u0440\u0438\u0439\u043C\u0430\u0454\u0442\u0435
      \u0446\u0435\u0439 \u0441\u0432\u0456\u0442. \u0412\u0438 \u0445\u043E\u0447\u0435\u0442\u0435
      \u0439\u043E\u0433\u043E \u0437\u043C\u0456\u043D\u0438\u0442\u0438, \u0445\u043E\u0447\u0435\u0442\u0435
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0442\u0438\u043C,
      \u043A\u043E\u0433\u043E \u0432\u0456\u043D \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u043D\u0430 \u043C\u0435\u0436\u0443 \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F
      \u0456 \u0449\u043E\u0434\u043D\u044F \u043D\u0430\u0440\u0430\u0436\u0430\u0454
      \u043D\u0430 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443. \u0406
      \u0443 \u0432\u0430\u0441 \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824683
    m_Localized: "\u0426\u0435 \u0434\u0443\u0436\u0435 \u0442\u0435\u043F\u043B\u0456
      \u0441\u043B\u043E\u0432\u0430. \u0410\u043B\u0435 \u0436 \u0446\u0435 \u043C\u043E\u0454
      \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F \u043D\u0430 \u0431\u0430\u0437\u0443
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443 \u0440\u043E\u0437\u043F\u043E\u0447\u0430\u043B\u043E
      \u0432\u0456\u0439\u043D\u0443, \u0443 \u044F\u043A\u0456\u0439 \u0443\u0436\u0435
      \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438 \u0441\u043E\u0442\u043D\u0456.
      \u042F\u043A\u0449\u043E \u044F \u0456 \u0437\u043C\u0456\u043D\u0438\u043B\u0430
      \u0441\u0432\u0456\u0442, \u0442\u043E \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u043D\u0430 \u043A\u0440\u0430\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824684
    m_Localized: "\u0422\u043E\u0431\u0456 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F.
      \u0422\u0438, \u043D\u0430\u043F\u0435\u0432\u043D\u043E, \u0446\u044C\u043E\u0433\u043E
      \u043D\u0435 \u043F\u043E\u043C\u0456\u0447\u0430\u0454\u0448, \u0430\u043B\u0435
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0432\u0447\u0438\u043D\u043A\u0430\u043C\u0438
      \u0442\u0443\u0442 \u0432\u0438 \u0437 \u0412\u0435\u043B\u044C\u0432\u0435\u0442
      \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438 \u043F\u043E\u043D\u0456 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456
      \u043D\u0430\u0434\u0456\u044E. \u0423 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0436\u0438\u0442\u0442\u0456 \u0432\u043E\u043D\u0438 \u0431\u0430\u0447\u0438\u043B\u0438
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E
      \u0437\u043B\u0430, \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0456
      \u0442\u0430 \u0431\u0430\u0439\u0434\u0443\u0436\u043E\u0441\u0442\u0456.
      \u0411\u0430\u0433\u0430\u0442\u043E \u0445\u0442\u043E \u043F\u043E\u0447\u0430\u0432
      \u0432\u0442\u0440\u0430\u0447\u0430\u0442\u0438 \u0432\u0456\u0440\u0443 \u0432
      \u0442\u0435, \u0449\u043E \u0432\u0441\u0435 \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438
      \u0456\u043D\u0430\u043A\u0448\u0435. \u0421\u0432\u043E\u0454\u044E \u0431\u0435\u0437\u043A\u043E\u0440\u0438\u0441\u043B\u0438\u0432\u043E\u044E
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0456 \u0441\u0430\u043C\u043E\u0432\u0456\u0434\u0434\u0430\u043D\u0456\u0441\u0442\u044E
      \u0432\u0438 \u043D\u0430\u0433\u0430\u0434\u0430\u043B\u0438 \u0457\u043C,
      \u0449\u043E \u043C\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824685
    m_Localized: "\u0423 \u043A\u043E\u0436\u043D\u043E\u0457 \u0456\u0441\u0442\u043E\u0440\u0456\u0457
      \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u043C\u043E\u0440\u0430\u043B\u044C,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A? \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0432 \u0456\u0441\u0442\u043E\u0440\u0456\u0457 \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456 \u0432\u043E\u043D\u0430 \u0431\u0443\u043B\u0430 \u0431 \u0442\u0430\u043A\u043E\u044E:
      \"\u0431\u043B\u0430\u0433\u0438\u043C\u0438 \u043D\u0430\u043C\u0456\u0440\u0430\u043C\u0438
      \u0432\u0438\u043A\u043B\u0430\u0434\u0435\u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432 \u041F\u0435\u043A\u043B\u043E\". \u0414\u0443\u0436\u0435 \u0448\u043A\u043E\u0434\u0430,
      \u0449\u043E \u0432\u0441\u0435 \u0442\u0430\u043A \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u043E\u0441\u044F.
      \u0410\u043B\u0435 \u0449\u043E \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u0430\u0448\u043E\u0457... \u0412\u043E\u043D\u0430 \u0449\u0435 \u043D\u0435
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430. \u0406 \u044F \u0434\u0443\u043C\u0430\u044E,
      \u043C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0432\u0430\u043C \u0457\u0457 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824686
    m_Localized: "\u0422\u043E\u0434\u0456, \u0433\u0430\u0434\u0430\u044E, \u0442\u043E\u0431\u0456
      \u0432\u0430\u0440\u0442\u043E \u043F\u043E\u0447\u0430\u0442\u0438 \u0437
      \u0442\u043E\u0433\u043E, \u0449\u043E \u0442\u0438 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456\u0448\u0435
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0438 \u043C\u0435\u043D\u0456
      \u0441\u0432\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824687
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E.
      \u0422\u0430\u043A, \u0434\u0443\u043C\u0430\u044E, \u0437 \u0447\u0430\u0441\u043E\u043C
      \u044F \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C \u0442\u043E\u0431\u0456
      \u0441\u0432\u043E\u044E \u0456\u0441\u0442\u043E\u0440\u0456\u044E. \u0410
      \u043A\u0440\u0430\u0449\u0435 - \u0437\u0430\u043F\u0440\u043E\u0448\u0443
      \u0434\u043E \u0441\u0435\u0431\u0435, \u043A\u043E\u043B\u0438 \u0446\u044F
      \u0432\u0456\u0439\u043D\u0430 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F.
      \u0414\u043E\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824688
    m_Localized: "\u0414\u043E\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824689
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438.
      \u042F \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0447\u0430\u0441\u0443
      \u043F\u0440\u043E\u0431\u0443\u043B\u0430 \u0442\u0443\u0442, \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456. \u0410\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u0456\u0441\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E, \u0449\u043E
      \u0441\u0442\u0430\u043B\u043E\u0441\u044F, \u044F \u0431\u0430\u0447\u0443
      \u0442\u0430\u043A\u0435 \u0433\u0430\u0440\u043D\u0435 \u043D\u0435\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824690
    m_Localized: "\u0421\u0438\u043B\u0438 \u043F\u0435\u0433\u0430\u0441\u0456\u0432
      \u0431\u0443\u043B\u0438 \u0437\u043C\u0443\u0448\u0435\u043D\u0456 \u043F\u043E\u0441\u043F\u0456\u0448\u043D\u043E
      \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u0438\u0442\u0438 \u043D\u0430\u0432\u0435\u0440\u0445
      \u043F\u0456\u0441\u043B\u044F \u0432\u0442\u0440\u0430\u0442\u0438 \u0422\u0430\u043D\u0434\u0435\u0440\u0445\u0435\u0434\u0430.
      \u041D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0435\u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u043E,
      \u0449\u043E \u0432\u043E\u043D\u0438 \u043F\u043E\u0440\u0443\u0448\u0438\u043B\u0438
      \u0446\u0456\u043B\u0456\u0441\u043D\u0456\u0441\u0442\u044C \u0441\u0432\u043E\u0454\u0457
      \u0445\u043C\u0430\u0440\u043D\u043E\u0457 \u0437\u0430\u0432\u0456\u0441\u0438.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u0446\u0435 \u0442\u0440\u0438\u0432\u0430\u0442\u0438\u043C\u0435
      \u043D\u0435\u0434\u043E\u0432\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824691
    m_Localized: "\u041C\u0435\u043D\u0456 \u043A\u0430\u0437\u0430\u043B\u0438,
      \u0449\u043E \u0442\u0438 \u0436\u0438\u0432\u0435\u0448 \u0443\u0436\u0435
      \u0434\u0432\u0456 \u0441\u043E\u0442\u043D\u0456 \u0440\u043E\u043A\u0456\u0432.
      \u0426\u0435 \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824692
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435 \u043F\u0440\u0430\u0432\u0434\u0430.
      \u0422\u0430\u043A \u0443\u0436\u0435 \u0432\u0438\u0439\u0448\u043B\u043E,
      \u0449\u043E \u044F \u0441\u0442\u0430\u0432 \u0433\u0443\u043B\u0435\u043C.
      \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u0438\u043C
      \u0433\u0443\u043B\u0435\u043C, \u044F\u043A\u0449\u043E \u0431\u0443\u0442\u0438
      \u0442\u043E\u0447\u043D\u0438\u043C. \u041C\u0435\u043D\u0456 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E
      \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u0438\u0439
      \u0433\u043B\u0443\u0437\u0434, \u0430\u043B\u0435 \u043D\u0435 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E
      \u0431\u0430\u0447\u0438\u0442\u0438, \u044F\u043A \u0446\u0435\u0439 \u0441\u0432\u0456\u0442
      \u0441\u043A\u043E\u0447\u0443\u0454\u0442\u044C\u0441\u044F \u0432 \u0431\u0435\u0437\u043E\u0434\u043D\u044E
      \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u043B\u044F \u0456 \u0441\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824693
    m_Localized: "\u0422\u043E\u0431\u0442\u043E \u0442\u0438 \u0431\u0430\u0447\u0438\u0432
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E \u0434\u043E \u0432\u0456\u0439\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824694
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0406
      \u0442\u0430\u043A, @lp, \u0442\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0434\u0443\u043C\u0430\u0454\u0448. \u041D\u0435\u0431\u043E \u0437\u0430\u0440\u0430\u0437
      \u0442\u043E\u0447\u043D\u043E \u0442\u0430\u043A\u0435 \u0441\u0430\u043C\u0435,
      \u044F\u043A\u0438\u043C \u0432\u043E\u043D\u043E \u0431\u0443\u043B\u043E
      \u0442\u043E\u0434\u0456. \u0425\u043E\u0440\u043E\u0448\u0456 \u0447\u0430\u0441\u0438
      \u0431\u0443\u043B\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824695
    m_Localized: "\u0427\u0438 \u0454 \u0448\u0430\u043D\u0441... \u0427\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
      \u043C\u0438 \u043A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0442\u0435, \u0449\u043E
      \u0431\u0443\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824696
    m_Localized: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E. \u0417\u0430 \u0446\u0456
      \u0440\u043E\u043A\u0438 \u044F \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0440\u0430\u0437\u0456\u0432 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0432\u0441\u044F,
      \u0445\u0430\u043F\u0430\u0432\u0441\u044F \u0437\u0430 \u043F\u043E\u043C\u0438\u043B\u043A\u043E\u0432\u0456
      \u043E\u0431\u0456\u0446\u044F\u043D\u043A\u0438. \u0410\u043B\u0435 \u0432\u0441\u0435
      \u0436 \u0442\u0430\u043A\u0438. \u041F\u043E\u043A\u0438 \u0454 \u043F\u043E\u043D\u0456,
      \u044F\u043A\u0456 \u0445\u043E\u0447\u0443\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
      \u0442\u0443 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044E, \u0449\u043E
      \u0431\u0443\u043B\u0430 \u0440\u0430\u043D\u0456\u0448\u0435, \u0443 \u043D\u0430\u0441
      \u0443\u0441\u0435 \u0449\u0435 \u0454 \u0448\u0430\u043D\u0441. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u043D\u0435 \u043C\u0438, \u0430\u043B\u0435 \u043D\u0430\u0448\u0456 \u043D\u0430\u0449\u0430\u0434\u043A\u0438
      \u0437\u043C\u043E\u0436\u0443\u0442\u044C \u0436\u0438\u0442\u0438 \u043F\u0456\u0434
      \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u0441\u0442\u0438\u043C \u0456
      \u043A\u0440\u0430\u0441\u0438\u0432\u0438\u043C \u043D\u0435\u0431\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824697
    m_Localized: "\u042F\u043A\u0456 \u0443 \u0432\u0430\u0441 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0456
      \u043F\u043B\u0430\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824698
    m_Localized: "\u0412\u0456\u0439\u043D\u0430 \u0437 \u043F\u0435\u0433\u0430\u0441\u0430\u043C\u0438
      \u043D\u0435 \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u0430. \u0410\u043B\u0435
      \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u043C\u0438 \u0442\u0435\u043F\u0435\u0440
      \u043C\u043E\u0436\u0435\u043C\u043E \u0436\u0438\u0442\u0438, \u043D\u0435
      \u0431\u043E\u044F\u0447\u0438\u0441\u044C \u043A\u0430\u0442\u0456\u0432 \u041B\u0435\u0433\u0456\u043E\u043D\u0443.
      \u0417\u0430\u0432\u0434\u044F\u043A\u0438 \u0442\u0432\u043E\u0457\u0439 \u0434\u043E\u043F\u043E\u043C\u043E\u0437\u0456
      \u043D\u0430\u043C \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F. \u041C\u043E\u0454 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824699
    m_Localized: "\u041C\u0435\u043D\u0456 \u0448\u043A\u043E\u0434\u0430, \u0449\u043E
      \u0442\u0430\u043A \u0432\u0438\u0439\u0448\u043B\u043E \u0437 \u0442\u0432\u043E\u0457\u043C
      \u0434\u043E\u043C\u043E\u043C. \u0412\u043E\u0440\u043E\u0433 \u043F\u0456\u0434\u0441\u0442\u0443\u043F\u043D\u0438\u0439
      \u0456 \u0431\u0435\u0437\u0436\u0430\u043B\u0456\u0441\u043D\u0438\u0439.
      \u0410\u043B\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u043E\u043D\u0456
      \u0432\u0438\u0436\u0438\u043B\u0438. \u0422\u0435\u043F\u0435\u0440 \u0442\u0438
      \u0431\u0443\u0434\u0435\u0448 \u0437 \u043D\u0438\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824700
    m_Localized: "\u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u043F\u0435\u0440\u0448\u0438\u0439
      \u0447\u0430\u0441 \u044F \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438\u043C\u0443
      \u0457\u043C \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438\u0441\u044F \u0432\u0456\u0434
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432. \u0410 \u0449\u043E \u0431\u0443\u0434\u0435
      \u0434\u0430\u043B\u0456 - \u0445\u0442\u043E \u0437\u043D\u0430\u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824701
    m_Localized: "\u041D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0437\u0430\u0431\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043E\u0454 \u043A\u043E\u0440\u0456\u043D\u043D\u044F,
      @lp. \u041D\u0435\u043C\u0430\u0454 \u043D\u0456\u0447\u043E\u0433\u043E \u0432\u0430\u0436\u0447\u043E\u0433\u043E,
      \u043D\u0456\u0436 \u043F\u043E\u0440\u0432\u0430\u0442\u0438 \u0437\u0456
      \u0441\u0432\u043E\u0454\u044E \u0431\u0430\u0442\u044C\u043A\u0456\u0432\u0449\u0438\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824702
    m_Localized: "\u0422\u0438 \u0446\u0435 \u0434\u043E\u0431\u0440\u0435 \u0437\u043D\u0430\u0454\u0448,
      \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824703
    m_Localized: "\u0426\u0435 \u0442\u0430\u043A. \u0410\u043B\u0435 \u0442\u0435\u043F\u0435\u0440
      \u043C\u0456\u0439 \u0434\u0456\u043C - \u041A\u043E\u0432\u0435\u0440\u0442\u0441\u0430\u0439\u043D,
      \u043C\u043E\u0454 \u043A\u043E\u0440\u0456\u043D\u043D\u044F - \u0437\u0435\u0431\u0440\u0438,
      \u0449\u043E \u0436\u0438\u0432\u0443\u0442\u044C \u0443 \u043D\u044C\u043E\u043C\u0443.
      \u0406 \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824704
    m_Localized: "\u042F \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0443 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443 \u0446\u0435\u0439
      \u0434\u0456\u043C \u0431\u0443\u0434\u0435 \u043B\u0438\u0448\u0435 \u043F\u0440\u043E\u0446\u0432\u0456\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824705
    m_Localized: "\u0422\u0440\u0435\u0431\u0430 \u0436\u0438\u0442\u0438 \u0434\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824706
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u043C\u0438\u043B\u0430 \u043C\u043E\u044F
      @lp. \u041F\u043E\u0434\u0443\u043C\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438:
      \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u043E\u043A\u0456\u0432 \u043C\u0438
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0440\u0430\u0437\u043E\u043C \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0438,
      \u0430 \u0442\u0435\u043F\u0435\u0440... \u0426\u0435 \u043F\u0440\u043E\u0432\u0430\u043B,
      \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824707
    m_Localized: "\u041C\u0438 \u0436\u0438\u0432\u0456 \u0439 \u0441\u0442\u043E\u0457\u043C\u043E
      \u0442\u0443\u0442. \u0423 \u043D\u0430\u0448\u0456\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457
      \u0446\u0435 \u0432\u0436\u0435 \u0443\u0441\u043F\u0456\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824708
    m_Localized: "\u0410\u043B\u0435 \u0442\u0430\u043A\u043E\u044E \u0446\u0456\u043D\u043E\u044E,
      \u0442\u0430\u043A\u043E\u044E \u0446\u0456\u043D\u043E\u044E... \u0406 \u0432
      \u043D\u0430\u0441 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435\u043C\u0430\u0454
      \u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824709
    m_Localized: "\u0407\u0457 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824710
    m_Localized: "\u041D\u0456... \u041F\u043E\u0441\u043F\u0456\u0448\u043D\u0438\u0439
      \u0437\u0430\u043F\u0443\u0441\u043A \u043D\u0430 \u0437\u043D\u0438\u0436\u0435\u043D\u0456\u0439
      \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456 \u0432\u0438\u044F\u0432\u0438\u0432\u0441\u044F
      \u0434\u043B\u044F \u043D\u0435\u0457 \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u0438\u043C.
      \u041A\u0432\u0430\u043D\u0442\u043E\u0432\u0438\u0439 \u043A\u043E\u0433\u0456\u0442\u0430\u0442\u043E\u0440
      \u043D\u0435 \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u0432 \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C,
      \u0430 \u0430\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430,
      \u043C\u0430\u0431\u0443\u0442\u044C, \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0432\u0442\u0440\u0430\u0442\u0438\u0432 \u0441\u0438\u043B\u0443. \u0417\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043E\u0441\u0442\u043E\u0432, \u0436\u0430\u043B\u044E\u0433\u0456\u0434\u043D\u0430
      \u043F\u043E\u0434\u043E\u0431\u0430! \u0414\u0432\u0456 \u0441\u043E\u0442\u043D\u0456
      \u0440\u043E\u043A\u0456\u0432 \u0443\u0441\u0456 \u043C\u0438 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0438, \u0449\u043E\u0431
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043F\u0440\u043E\u0435\u043A\u0442,
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u043C\u0438 \u0442\u0443\u0442, \u0441\u0435\u0440\u0435\u0434
      \u043C\u043E\u0433\u0438\u043B \u0441\u0432\u043E\u0457\u0445 \u0442\u043E\u0432\u0430\u0440\u0438\u0448\u0456\u0432,
      \u044F\u043A\u0438\u0445 \u043C\u0438 \u043F\u0456\u0434\u0432\u0435\u043B\u0438.
      \u0423\u0441\u044F \u043D\u0430\u0448\u0430 \u0440\u043E\u0431\u043E\u0442\u0430
      \u0431\u0443\u043B\u0430 \u043C\u0430\u0440\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824711
    m_Localized: "\u0417\u0431\u0435\u0440\u0456\u0442\u044C\u0441\u044F, \u043F\u0440\u043E\u0444\u0435\u0441\u043E\u0440\u0435.
      \u042F\u043A\u0431\u0438 \u043C\u0438 \u043D\u0435 \u0437\u0440\u043E\u0431\u0438\u043B\u0438
      \u0446\u044C\u043E\u0433\u043E, \u0442\u043E \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438
      \u0431 \u0443\u0441\u0456. \u041C\u0435\u043D\u0456 \u0432\u0430\u0436\u043A\u043E
      \u0446\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438, \u0430\u043B\u0435
      \u0441\u0430\u043C\u0435 \u0442\u0430\u043A \u0437\u0430\u0433\u0430\u0440\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u043E\u043B\u044F. \u041D\u0430 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u0456\u0437 \u043D\u0430\u0441 \u043B\u0435\u0436\u0438\u0442\u044C \u0442\u044F\u0433\u0430\u0440
      \u043F\u0440\u043E\u0432\u0438\u043D\u0438, \u0456 \u0432 \u0434\u0435\u043A\u043E\u0433\u043E
      \u0432\u0456\u043D \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043A\u0438\u0439.
      \u0410\u043B\u0435 \u043C\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u0436\u0438\u0442\u0438 \u0434\u0430\u043B\u0456. \u0421\u0442\u0456\u0439\u043B\u043E
      \u041F\u0456 \u043C\u0430\u0454 \u0432\u0438\u0436\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824712
    m_Localized: "... \u0422\u0430\u043A. \u0422\u0430\u043A, \u0442\u0438 \u043C\u0430\u0454\u0448
      \u0440\u0430\u0446\u0456\u044E. \u041D\u0430 \u043D\u0430\u0441 \u0447\u0435\u043A\u0430\u0454
      \u0434\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0440\u043E\u0431\u043E\u0442\u0438.
      \u0426\u0456 \u0437\u0430\u0433\u0430\u0440\u0431\u043D\u0438\u043A\u0438 \u043D\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0431\u0438\u0432\u0430\u043B\u0438
      \u043F\u043E\u043D\u0456, \u0432\u043E\u043D\u0438 \u0437\u0430\u0432\u0434\u0430\u043B\u0438
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0421\u0442\u0456\u0439\u043B\u0443. \u041D\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438\u0441\u044F, \u0456
      \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u043D\u0430\u0439\u0442\u0438
      \u0441\u043F\u043E\u0441\u0456\u0431 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438
      \u0441\u0435\u0431\u0435 \u043D\u0430\u0434\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824713
    m_Localized: "\u041D\u043E\u0432\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824714
    m_Localized: "\u042F\u043A\u0435 \u0442\u0430\u043C, \u043D\u0435\u043C\u0430\u0454
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456... \u0414\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u043F\u0440\u0438\u0434\u0443\u043C\u0443\u0432\u0430\u0442\u0438 \u0449\u043E\u0441\u044C
      \u0456\u043D\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824715
    m_Localized: "\u0410 \u0449\u043E \u0449\u043E\u0434\u043E \u0427\u043E\u0440\u043D\u043E\u0457
      \u041A\u043D\u0438\u0433\u0438? \u042F \u043C\u043E\u0436\u0443 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438
      \u0457\u0457 \u0443 \u0432\u0430\u0441, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0457\u0457 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824716
    m_Localized: "\u041E, \u043D\u0456-\u043D\u0456-\u043D\u0456-\u043D\u0456, \u0437\u0430\u043B\u0438\u0448
      \u0457\u0457 \u0441\u043E\u0431\u0456. \u041F\u043E\u043A\u0438 \u044F \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432
      \u0456\u0437 \u0446\u0456\u0454\u044E \u0433\u0438\u0434\u043E\u0442\u043E\u044E,
      \u0443 \u043C\u0435\u043D\u0435, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0433\u0430\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0456\u0457 \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044F.
      \u0422\u0438 \u0431 \u043A\u0440\u0430\u0449\u0435 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u0457\u0457 \u0432\u0438\u043A\u0438\u043D\u0443\u043B\u0430 - \u043D\u0435
      \u0434\u0430\u0440\u043C\u0430 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u0437\u0435\u0431\u0440\u0438 \u0431\u043E\u044F\u043B\u0438\u0441\u044F \u0442\u0430\u043A\u043E\u0433\u043E
      \u0447\u0430\u043A\u043B\u0443\u043D\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824717
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u043F\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443 \u0434\u043E
      \u043D\u043E\u0432\u0438\u0445 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0456\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824718
    m_Localized: "\u041C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438. \u041D\u0435
      \u043C\u0435\u043D\u0456 \u0446\u0435 \u0432\u0438\u0440\u0456\u0448\u0443\u0432\u0430\u0442\u0438.
      \u0417\u0430\u0440\u0430\u0437 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0440\u0456\u0448\u0443\u0432\u0430\u0442\u0438.
      \u0422\u0440\u0435\u0431\u0430 \u0432\u0456\u0434\u0434\u0430\u0442\u0438 \u0434\u0430\u043D\u0438\u043D\u0443
      \u043F\u043E\u0432\u0430\u0433\u0438 \u0442\u0438\u043C, \u043A\u043E\u0433\u043E
      \u0437 \u043D\u0430\u043C\u0438 \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824719
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824720
    m_Localized: "\u042F\u043A \u0434\u0443\u043C\u0430\u0454\u0448, \u044F\u043A
      \u0436\u0435 \u0410\u043D\u043A\u043B\u0430\u0432\u0443 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u0442\u0430\u043A \u043B\u0435\u0433\u043A\u043E \u0437\u043D\u0430\u0439\u0442\u0438
      \u0421\u0442\u0456\u0439\u043B\u043E \u041F\u0456, \u0442\u0430 \u0449\u0435
      \u0439 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456
      \u0434\u0432\u0435\u0440\u0456 \u0431\u0435\u0437 \u0436\u043E\u0434\u043D\u0438\u0445
      \u0437\u0443\u0441\u0438\u043B\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824721
    m_Localized: "\u0417\u043D\u0430\u0454\u0448, \u0446\u0435 \u043C\u0435\u043D\u0456
      \u043D\u0435 \u0434\u0430\u0432\u0430\u043B\u043E \u0441\u043F\u043E\u043A\u043E\u044E
      \u0437 \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u043D\u044F \u043D\u0430\u043F\u0430\u0434\u0443.
      \u0417\u0432\u0456\u0441\u043D\u043E, \u0431\u0443\u043B\u043E \u043D\u0435
      \u0434\u043E \u0442\u043E\u0433\u043E, \u0430\u043B\u0435 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u044F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0447\u0430\u0441 \u043F\u043E\u0440\u0438\u0442\u0438\u0441\u044F
      \u0432 \u0430\u0440\u0445\u0456\u0432\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824722
    m_Localized: "\u0406 \u0449\u043E \u0442\u0438 \u0437'\u044F\u0441\u0443\u0432\u0430\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824723
    m_Localized: "\u0412\u0438\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F,
      \u043C\u0438 \u0432\u0435\u0441\u044C \u0446\u0435\u0439 \u0447\u0430\u0441
      \u0431\u0443\u043B\u0438 \u0432\u0435\u043B\u044C\u043C\u0438 \u043D\u0430\u0457\u0432\u043D\u0456,
      \u0432\u0432\u0430\u0436\u0430\u044E\u0447\u0438, \u0449\u043E \u043C\u0456\u0441\u0446\u0435
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u0421\u0442\u0456\u0439\u043B\u0430
      \u043D\u0456\u043A\u043E\u043C\u0443 \u043D\u0435 \u0431\u0443\u043B\u043E
      \u0432\u0456\u0434\u043E\u043C\u043E. \u041D\u0443 \u0441\u0430\u043C\u0430
      \u043F\u043E\u0434\u0443\u043C\u0430\u0439, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0437\u0443\u0441\u0438\u043B\u044C \u0432\u0438\u043C\u0430\u0433\u0430\u0454
      \u0439\u043E\u0433\u043E \u0431\u0443\u0434\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u043E,
      \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u0456\u0432
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u0431\u0440\u0430\u043B\u043E \u0443\u0447\u0430\u0441\u0442\u044C,
      \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0442\u0435\u0445\u043D\u0456\u043A\u0438,
      \u0437\u0430\u043A\u0443\u043F\u0456\u0432\u0435\u043B\u044C... \u0456 \u0432\u0441\u0435
      \u0446\u0435 \u0434\u0435\u0441\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0443\u0432\u0430\u043B\u043E\u0441\u044F,
      \u0442\u0430 \u0439 \u0437\u043D\u0430\u043B\u0438 \u043F\u0440\u043E \u0446\u0435
      \u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E \u043B\u044E\u0434\u0435\u0439.
      \u0417\u0432\u0456\u0441\u043D\u043E, \u0437\u0430 \u0442\u0456\u0454\u0457
      \u0440\u043E\u0437\u0440\u0443\u0445\u0438, \u0449\u043E \u043A\u043E\u0457\u0442\u044C\u0441\u044F
      \u0437\u0430\u0440\u0430\u0437 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456,
      \u0432\u0441\u044F \u0446\u044F \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F
      \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0433\u0443\u0431\u043B\u0435\u043D\u0430
      \u0456 \u0437\u0430\u0431\u0443\u0442\u0430. \u0410\u043B\u0435 \u0410\u043D\u043A\u043B\u0430\u0432
      - \u0456\u043D\u0448\u0430 \u0441\u043F\u0440\u0430\u0432\u0430. \u0421\u0443\u0434\u044F\u0447\u0438
      \u0437 \u0442\u043E\u0433\u043E, \u0449\u043E \u043C\u0435\u043D\u0456 \u043F\u0440\u043E
      \u043D\u044C\u043E\u0433\u043E \u0432\u0456\u0434\u043E\u043C\u043E, \u0443
      \u043D\u0438\u0445 \u0437\u0431\u0435\u0440\u0435\u0433\u043B\u043E\u0441\u044F
      \u0431\u0430\u0433\u0430\u0442\u043E \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445
      \u0431\u0430\u0437 \u0434\u0430\u043D\u0438\u0445. \u0407\u043C \u043D\u0456\u0447\u043E\u0433\u043E
      \u0431 \u043D\u0435 \u043A\u043E\u0448\u0442\u0443\u0432\u0430\u043B\u043E
      \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u043C\u0456\u0441\u0446\u0435
      \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043D\u043D\u044F \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0421\u0442\u0456\u0439\u043B\u0430, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0440\u043E\u0431\u0438\u0432\u0448\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0438\u0439
      \u0437\u0430\u043F\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824724
    m_Localized: "\u0410 \u044F\u043A \u0432\u043E\u043D\u0438 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u043B\u0438
      \u0434\u0432\u0435\u0440\u0456? \u0410\u0434\u0436\u0435 \u0432\u043E\u043D\u0438
      \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0456 \u0432\u0438\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u0443\u0434\u0430\u0440\u0438 \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824725
    m_Localized: "\u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u0432,
      \u0449\u043E \u0432\u043E\u043D\u0438 \u0445\u0430\u043A\u043D\u0443\u043B\u0438
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u0456\u0437 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0433\u043E
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443. \u0410\u043B\u0435
      \u043D\u0456\u0447\u043E\u0433\u043E \u043F\u043E\u0434\u0456\u0431\u043D\u043E\u0433\u043E.
      \u0423 \u043D\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0443\u043B\u0438
      \u043A\u043E\u0434\u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u0443! \u0412\u0438\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F,
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456 \u0434\u0432\u0435\u0440\u0456
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438,
      \u0432\u0432\u0456\u0432\u0448\u0438 \u043F\u043E\u0434\u0456\u0431\u043D\u0456
      \u043A\u043E\u0434\u0438. \u0410 \u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u0437\u043D\u0430\u043B\u0438, \u0449\u043E \u0442\u0430\u043A\u0456
      \u0456\u0441\u043D\u0443\u044E\u0442\u044C. \u041D\u0443 \u0442\u043E\u0431\u0442\u043E
      \u044F \u043D\u0435 \u0437\u043D\u0430\u0432... \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u043C\u0430\u0432 \u0437\u043D\u0430\u0442\u0438, \u0430\u043B\u0435 \u0447\u043E\u043C\u0443\u0441\u044C
      \u043D\u0435 \u0432\u0436\u0438\u0432 \u0436\u043E\u0434\u043D\u0438\u0445
      \u0437\u0430\u0445\u043E\u0434\u0456\u0432. \u0410 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0436 \u0431\u0443\u043B\u043E \u0431 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u0442\u0438 \u0434\u0432\u0435\u0440\u0456
      \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u043E. \u0410\u043B\u0435,
      \u044F\u043A \u044F \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u044E, \u0446\u0435
      \u0431\u0443\u043B\u043E \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E
      \u044F\u043A\u0438\u043C\u0438\u0441\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438
      \u0434\u0432\u043E\u0445\u0441\u043E\u0442\u0440\u0456\u0447\u043D\u043E\u0457
      \u0434\u0430\u0432\u043D\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824726
    m_Localized: "\u0410\u043B\u0435 \u044F \u0442\u043E\u0431\u0456 \u043E\u0431\u0456\u0446\u044F\u044E,
      \u0442\u0435\u043F\u0435\u0440 \u0443\u0441\u0435 \u0431\u0443\u0434\u0435
      \u0456\u043D\u0430\u043A\u0448\u0435. \u042F \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E
      \u0437\u0430\u0439\u043C\u0443\u0441\u044F \u0440\u0435\u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0454\u044E
      \u0432\u0441\u0456\u0454\u0457 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438.
      \u041F\u043E\u0434\u0456\u0431\u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824727
    m_Localized: "\u0425\u0435\u0445. \u041E\u0442 \u0443\u0436\u0435 \u043D\u0435
      \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430 \u0431, \u0449\u043E \u0421\u0456\u043B\u044C\u0432\u0435\u0440
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C \u043E\u0441\u044C \u0442\u0430\u043A.
      \u0419\u043E\u043C\u0443 \u0431 \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u0456\u0448\u043B\u0430
      \u0441\u043C\u0435\u0440\u0442\u044C \u0443 \u043B\u0456\u0436\u043A\u0443
      \u0440\u043E\u043A\u0456\u0432 \u0442\u0430\u043A \u0443 \u0434\u0435\u0432'\u044F\u043D\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824728
    m_Localized: "\u041D\u0456\u043A\u043E\u043C\u0443 \u0442\u0430\u043A\u0430 \u0441\u043C\u0435\u0440\u0442\u044C
      \u043D\u0435 \u0439\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824729
    m_Localized: "\u0422\u0438 \u043F\u0440\u043E \u043B\u0456\u0436\u043A\u043E?
      \u0427\u0438 \u043F\u0440\u043E \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824730
    m_Localized: "\u041F\u0440\u043E \u043E\u0431\u0438\u0434\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824731
    m_Localized: "\u0410. \u0415\u043C. \u041D\u0443 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824732
    m_Localized: "\u0417\u043D\u0430\u0454\u0448, \u0442\u0438 \u043D\u0430\u0441
      \u0443\u0441\u0456\u0445 \u0443 \u043F\u0456\u0434\u0441\u0443\u043C\u043A\u0443
      \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u0430. \u041C\u0435\u043D\u0456
      \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043B\u0438, \u044F\u043A \u0442\u0438
      \u0437\u0431\u0438\u043B\u0430 \u0442\u043E\u0439 \u0430\u043D\u043A\u043B\u0430\u0432\u0456\u0432\u0441\u044C\u043A\u0438\u0439
      \u0444\u043B\u0430\u0433\u043C\u0430\u043D. \u042F\u043A\u0431\u0438 \u043D\u0435
      \u0442\u0438 \u0456 \u0431\u0440\u043E\u043D\u044F, \u043D\u0430\u0441 \u0431\u0438
      \u0432\u0441\u0456\u0445 \u0443\u0431\u0438\u043B\u0438. \u041D\u0430\u043F\u0435\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824733
    m_Localized: "\u0414\u044F\u043A\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824734
    m_Localized: "\u0422\u043E\u0431\u0456 \u0441\u043F\u0430\u0441\u0438\u0431\u0456.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
      \u0442\u043E\u0431\u0456 \u043F\u0430\u043C'\u044F\u0442\u044C \u0447\u0438
      \u043D\u0456, \u0430\u043B\u0435 \u044F \u043F\u0430\u043C'\u044F\u0442\u0430\u044E,
      \u044F\u043A \u043C\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E \u0440\u0430\u043D\u0456\u0448\u0435
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0438. \u0422\u0438 \u0431\u0443\u043B\u0430
      \u0442\u0430\u043A\u043E\u044E \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E\u044E.
      \u042F \u0431 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430,
      \u0449\u043E \u0442\u0438 \u0441\u0442\u0430\u043D\u0435\u0448, \u0433\u043C,
      \u0433\u0435\u0440\u043E\u0454\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824735
    m_Localized: "\u042F \u043D\u0435 \u0433\u0435\u0440\u043E\u0439. \u0406 \u044F\u043A\u0431\u0438
      \u044F \u043D\u0435 \u0441\u0442\u0430\u043B\u0430 \u0442\u0430\u043A\u043E\u044E,
      \u044F\u043A\u0430 \u044F \u0454 \u0437\u0430\u0440\u0430\u0437, \u044F \u0431
      \u043D\u0435 \u0432\u0438\u0436\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824736
    m_Localized: "\u0422\u0430\u043A, \u0434\u043E \u0440\u0435\u0447\u0456, \u0442\u0438
      \u0436 \u0443\u0441\u0435 \u0449\u0435 \u043C\u0435\u043D\u0456 \u0432\u0438\u043D\u043D\u0430
      \u043C\u043E\u0457 \u0436\u0443\u0440\u043D\u0430\u043B\u0438 \u043F\u0440\u043E
      \u0421\u0443\u043F\u0435\u0440\u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824737
    m_Localized: "\u0423\u043F\u0441. \u041F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F,
      \u0437\u043D\u0430\u0447\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824738
    m_Localized: "\u042F\u043A \u0441\u0435\u0431\u0435 \u0437\u0430\u0440\u0430\u0437
      \u043F\u043E\u0447\u0443\u0432\u0430\u044E\u0442\u044C \u0456\u043D\u0448\u0456
      \u0436\u0438\u0442\u0435\u043B\u0456 \u0421\u0442\u0456\u0439\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824739
    m_Localized: "\u041F\u0440\u0438\u0433\u043D\u0456\u0447\u0435\u043D\u043E. \u041C\u0430\u0439\u0436\u0435
      \u0443 \u0432\u0441\u0456\u0445 \u0430\u0431\u043E \u0448\u043E\u043A, \u0430\u0431\u043E
      \u0441\u0442\u0440\u0435\u0441. \u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C
      \u0456\u0437 \u043D\u0438\u0445 \u0432\u043F\u043E\u0440\u0430\u0454\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E, \u0430\u043B\u0435
      \u044F \u043F\u0440\u043E\u0441\u0442\u0435\u0436\u0443 \u0437\u0430 \u0442\u0438\u043C,
      \u0449\u043E\u0431 \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u0432\u043F\u0430\u0432
      \u0443 \u0434\u0435\u043F\u0440\u0435\u0441\u0456\u044E. \u0422\u0430\u043A\u0456
      \u0440\u0435\u0447\u0456 \u043D\u0435 \u0449\u043E\u0434\u043D\u044F \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u044E\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824740
    m_Localized: "\u041C\u0435\u043D\u0456 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0446\u0435 \u0447\u0438\u043C\u043E\u0441\u044C \u0441\u0445\u043E\u0436\u0435
      \u0434\u043B\u044F \u043D\u0438\u0445 \u043D\u0430 \u043C\u0456\u0439 \u043F\u0435\u0440\u0448\u0438\u0439
      \u0434\u0435\u043D\u044C \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456.
      \u0422\u0456\u043B\u044C\u043A\u0438 \u0443 \u0431\u0456\u043B\u044C\u0448\u0438\u0445
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0430\u0445. \u0416\u0438\u0442\u0435\u043B\u0456
      \u0421\u0442\u0456\u0439\u043B\u0430 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0431\u0443\u0434\u0443\u0442\u044C \u043A\u043E\u043B\u0438\u0448\u043D\u0456\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824741
    m_Localized: "\u041A\u043E\u043B\u0438\u0448\u043D\u0456\u043C\u0438 - \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E.
      \u0410\u043B\u0435 \u043F\u043E\u043A\u0438 \u0449\u043E \u043C\u0438 \u0449\u0435
      \u0446\u0456\u043B\u043A\u043E\u043C \u043C\u043E\u0436\u0435\u043C\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0434\u043E \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E \u0436\u0438\u0442\u0442\u044F.
      \u042F\u043A\u0449\u043E \u043D\u0430\u043C \u0446\u0435 \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824742
    m_Localized: "\u042F \u043D\u0435 \u043C\u043E\u0436\u0443 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u0437\u0430 \u0432\u0441\u0456\u0445. \u041C\u043E\u0436\u0443 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0442\u0438\u0441\u044F, \u0449\u043E
      \u0456\u043D\u0448\u0456 \u0432\u0438\u0440\u0456\u0448\u0430\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u044F\u0433\u043D\u0443\u0442\u0438
      \u043A\u043E\u043F\u0438\u0442\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438.
      \u0410\u043B\u0435 \u044F \u043E\u0431\u0456\u0446\u044F\u044E, \u0449\u043E
      \u044F \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u0437\u0440\u043E\u0431\u043B\u044E
      \u0432\u0441\u0435, \u0449\u043E \u0432\u0456\u0434 \u043C\u0435\u043D\u0435
      \u0432\u0438\u043C\u0430\u0433\u0430\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F,
      \u0449\u043E\u0431 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u0441\u0432\u0456\u0439
      \u0434\u0456\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824743
    m_Localized: "\u0421\u043A\u0430\u0436\u0438, @lp. \u042F\u043A \u0448\u0432\u0438\u0434\u043A\u043E
      \u0442\u0438 \u0437\u0432\u0438\u043A\u043B\u0430 \u0431\u0430\u0447\u0438\u0442\u0438
      \u0441\u043C\u0435\u0440\u0442\u044C \u0456\u043D\u0448\u0438\u0445 \u043F\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824744
    m_Localized: "\u0415\u043C... \u0423 \u043C\u0435\u043D\u0435 \u0431\u0443\u043B\u043E
      \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824745
    m_Localized: "\u041D\u0430\u043C \u0456\u0437 \u0442\u043E\u0431\u043E\u044E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
      \u043F\u0440\u043E \u0446\u0435 \u0431\u0456\u043B\u044C\u0448 \u0491\u0440\u0443\u043D\u0442\u043E\u0432\u043D\u043E.
      \u041A\u043E\u043B\u0438 \u0431\u0443\u0434\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C.
      \u0422\u0432\u043E\u0454 \u043D\u043E\u0432\u0435 \u0436\u0438\u0442\u0442\u044F
      \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435,
      @lp. \u041D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F \u0442\u0432\u043E\u0433\u043E
      \u0444\u0456\u0437\u0438\u0447\u043D\u043E\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F,
      \u0430 \u0439 \u0434\u043B\u044F \u043F\u0441\u0438\u0445\u0456\u043A\u0438.
      \u042F \u0437\u043D\u0430\u044E, \u0442\u0438 \u0441\u0430\u043C\u0430 \u0446\u0435
      \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448. \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C
      \u043F\u0440\u043E \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824746
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u043E, \u0437\u0430
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824747
    m_Localized: "\u0417 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F\u043C,
      @lp."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824748
    m_Localized: "\u0420\u0430\u0434\u0430 \u0431\u0430\u0447\u0438\u0442\u0438 \u0442\u0435\u0431\u0435
      \u0436\u0438\u0432\u0438\u043C, \u0414\u0430\u0439\u043A\u0456\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824749
    m_Localized: "\u0410 \u0432\u0436\u0435 \u044F-\u0442\u043E \u044F\u043A \u0440\u0430\u0434\u0438\u0439!
      \u042F \u0432\u0436\u0435 \u0434\u0443\u043C\u0430\u0432 \u0431\u0443\u043B\u043E,
      \u0449\u043E \u043D\u0430\u043C \u043A\u0456\u043D\u0435\u0446\u044C \u0443\u0441\u0456\u043C
      \u043F\u0440\u0438\u0439\u0448\u043E\u0432. \u0410\u043D\u043A\u043B\u0430\u0432,
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F \u043C\u043E\u044F \u043C\u0438\u043B\u043E\u0441\u0442\u0438\u0432\u0430!
      \u0421\u043A\u0430\u0437\u0430\u0432 \u0431\u0438 \u0445\u0442\u043E \u043C\u0435\u043D\u0456
      \u0442\u0430\u043A\u0435 \u0440\u043E\u043A\u043E\u043C \u0440\u0430\u043D\u0456\u0448\u0435,
      \u043D\u0435 \u043F\u043E\u0432\u0456\u0440\u0438\u0432 \u0431\u0438 \u0432
      \u0436\u0438\u0442\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824750
    m_Localized: "\u041D\u0443, \u0442\u0435\u043F\u0435\u0440 \u043C\u043E\u0436\u043D\u0430
      \u0437\u0456\u0442\u0445\u043D\u0443\u0442\u0438 \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824751
    m_Localized: "\u0410\u0433\u0430\u0441\u044C. \u0423\u0441\u0456 \u0446\u0456
      \u0440\u0435\u0439\u0434\u0435\u0440\u0438 \u0437 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044F\u043C\u0438
      \u0442\u0435\u043F\u0435\u0440 \u043D\u0430\u043C \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u0435\u044E
      \u0437\u0434\u0430\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F.
      \u0412\u0435\u0441\u044C \u0442\u0430\u0431\u0456\u0440 \u0433\u0443\u0434\u0435
      \u043F\u0440\u043E \u0442\u0435, \u044F\u043A \u0442\u0438 \u0442\u0443 \u0431\u043B\u044F\u0448\u0430\u043D\u043A\u0443
      \u0440\u043E\u0437\u043A\u0440\u0438\u043B\u0430! \u041F\u043E\u0432\u0456\u0440,
      \u0442\u0430\u043A\u0435 \u043D\u0435\u0441\u043A\u043E\u0440\u043E \u0437\u0430\u0431\u0443\u0434\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824752
    m_Localized: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u043D\u0435 \u0431\u0443\u0434\u0435\u043C\u043E \u043D\u0430 \u0446\u044C\u043E\u043C\u0443
      \u0437\u0430\u0433\u043E\u0441\u0442\u0440\u044E\u0432\u0430\u0442\u0438 \u0443\u0432\u0430\u0433\u0443.
      \u0414\u043B\u044F \u043C\u0435\u043D\u0435 \u0442\u043E\u0439 \u0431\u0456\u0439
      - \u0446\u0435 \u043F\u0430\u043C'\u044F\u0442\u044C \u043F\u0440\u043E \u0437\u0430\u0433\u0438\u0431\u043B\u0438\u0445
      \u0436\u0438\u0442\u0435\u043B\u0456\u0432 \u0421\u0442\u0456\u0439\u043B\u0430
      \u041F\u0456, \u0430 \u043D\u0435 \u0441\u043B\u0430\u0432\u043D\u0456 \u0456\u0441\u0442\u043E\u0440\u0456\u0457
      \u043F\u0440\u043E \u0437\u0432\u0438\u0442\u044F\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824753
    m_Localized: "\u042F\u043A \u0441\u043A\u0430\u0436\u0435\u0448. \u041D\u0435
      \u0431\u0443\u0434\u0435\u043C\u043E \u0442\u043E\u0434\u0456. \u0410\u043B\u0435
      \u0432\u0441\u0435 \u0436, @lp. \u041F\u0456\u0441\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E,
      \u0449\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F, \u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0431\u0443\u0434\u0435\u0448
      \u043D\u0456 \u0434\u043B\u044F \u043A\u043E\u0433\u043E \u0447\u0443\u0436\u043E\u044E
      \u0442\u0443\u0442. \u041F\u0430\u043C'\u044F\u0442\u0430\u0439 \u043F\u0440\u043E
      \u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824754
    m_Localized: "\u0412\u0456\u0442\u0430\u044E \u0442\u0435\u0431\u0435, \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u0446\u044F.
      \u0412\u0430\u0436\u043A\u0438\u0439 \u0431\u0443\u0432 \u0448\u043B\u044F\u0445,
      \u0449\u043E \u043F\u0440\u043E\u0439\u0448\u043B\u0430 \u0442\u0438 \u0437
      \u043D\u0430\u0448\u043E\u0457 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824755
    m_Localized: "\u0422\u0430\u043A, \u0432\u0430\u0436\u043A\u0438\u0439. \u0406
      \u0432\u0456\u043D \u0449\u0435 \u043D\u0435 \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u0438\u0439.
      \u0427\u0438 \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824756
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u041F\u043E\u043A\u0438
      \u0442\u0438 \u0436\u0438\u0432\u0430, \u0442\u0432\u043E\u044F \u0434\u043E\u043B\u044F
      \u0431\u0443\u0434\u0435 \u0442\u0435\u0431\u0435 \u0432\u0435\u0441\u0442\u0438.
      \u0410\u043B\u0435 \u0432\u043E\u043D\u0430 \u043E\u0431\u0442\u044F\u0436\u0435\u043D\u0430
      \u0447\u043E\u0440\u043D\u043E\u044E \u0442\u0456\u043D\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824757
    m_Localized: "\u0422\u0438 \u043F\u0440\u043E \u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824758
    m_Localized: "\u0427\u043E\u0440\u043D\u0430 \u043A\u043D\u0438\u0433\u0430.
      \u0417\u0430\u043D\u0430\u0434\u0442\u043E \u043F\u0456\u0437\u043D\u043E \u0434\u0456\u0439\u0448\u043B\u0438
      \u0434\u043E \u043C\u0435\u043D\u0435 \u0437\u0432\u0456\u0441\u0442\u043A\u0438,
      \u0449\u043E \u0446\u044F \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0430
      \u0440\u0456\u0447 \u043E\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F \u0432
      \u043A\u043E\u043F\u0438\u0442\u0430\u0445 \u043D\u0435 \u0442\u043E\u0433\u043E
      \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824759
    m_Localized: "\u0412\u043E\u043D\u0430 \u0431\u0443\u043B\u0430 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0430
      \u0434\u043B\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E\u0454\u043A\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824760
    m_Localized: "\u0411\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E, \u0432\u043E\u043D\u0430
      \u0431\u0443\u043B\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430.
      \u0422\u0430\u043A \u0441\u0430\u043C\u043E, \u044F\u043A \u0432\u043E\u043D\u0430
      \u0431\u0443\u043B\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0432\u0441\u0456\u043C
      \u0442\u0438\u043C \u043D\u0435\u0449\u0430\u0441\u043D\u0438\u043C \u0434\u0443\u0448\u0430\u043C,
      \u044F\u043A\u0456 \u0437\u0433\u0443\u0431\u0438\u043B\u0430 \u0440\u0430\u043D\u0456\u0448\u0435.
      \u041F\u043E\u0442\u0440\u0435\u0431\u0430 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0443\u0441\u0456\u0445 \u0434\u043E \u0427\u043E\u0440\u043D\u043E\u0457
      \u041A\u043D\u0438\u0433\u0438. \u0410\u043B\u0435 \u043D\u0456\u043A\u043E\u043B\u0438
      \u043D\u0435 \u0434\u0430\u0441\u0442\u044C \u0432\u043E\u043D\u0430 \u0432\u0430\u043C
      \u0431\u0430\u0436\u0430\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824761
    m_Localized: "\u041E\u0434\u043D\u0430\u043A \u043F\u0440\u043E\u0454\u043A\u0442
      \u0431\u0443\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E,
      \u0456 \u0431\u0440\u043E\u043D\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0430
      \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u043C\u0456\u0439 \u0434\u0456\u043C
      \u0432\u0456\u0434 \u0437\u0430\u0433\u0430\u0440\u0431\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824762
    m_Localized: "\u0417\u0430\u0433\u0430\u0440\u0431\u043D\u0438\u043A\u0456\u0432?
      \u0427\u0438 \u043D\u0435 \u0442\u0438\u0445 \u0437\u0430\u0433\u0430\u0440\u0431\u043D\u0438\u043A\u0456\u0432,
      \u043F\u0440\u043E \u044F\u043A\u0438\u0445 \u0442\u0438 \u043D\u0435 \u0447\u0443\u043B\u0430
      \u043D\u0430\u0432\u0456\u0442\u044C \u0434\u043E \u0442\u043E\u0433\u043E,
      \u044F\u043A \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0430 \u043A\u043D\u0438\u0433\u0430
      \u044F\u0432\u0438\u043B\u0430 \u0441\u0435\u0431\u0435? \u0417\u0433\u0430\u0434\u0430\u0439,
      @lp. \u0417\u0433\u0430\u0434\u0430\u0439, \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u043B\u043E\u0441\u044F
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0456 \u0431\u043B\u0438\u0437\u044C\u043A\u0438\u043C\u0438
      \u0442\u0432\u043E\u0457\u043C\u0438 \u0432\u0456\u0434\u0442\u043E\u0434\u0456,
      \u044F\u043A \u0442\u0438 \u0437\u0434\u043E\u0431\u0443\u043B\u0430 \u0446\u044E
      \u0440\u0456\u0447. \u0427\u0438 \u0431\u0430\u0433\u0430\u0442\u043E \u0449\u0430\u0441\u0442\u044F
      \u0437\u0430\u0437\u043D\u0430\u043B\u0430 \u0442\u0438? \u0410\u0431\u043E
      \u0436 \u043F\u043E\u0433\u0440\u043E\u0437\u0438 \u0439 \u043F\u0440\u0438\u043A\u0440\u043E\u0449\u0456
      \u043F\u043E\u0441\u0438\u043F\u0430\u043B\u0438\u0441\u044F, \u044F\u043A
      \u0437-\u043F\u0456\u0434 \u043A\u043E\u043F\u0438\u0442\u0430 \u0417\u043E\u0440\u044F\u043D\u043E\u0457
      \u041A\u043E\u0431\u0438\u043B\u0438\u0446\u0456? \u0427\u0438 \u0431\u0443\u043B\u0430
      \u0442\u0438 \u0441\u0430\u043C\u0430 \u0441\u043E\u0431\u043E\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824763
    m_Localized: "\u0422\u0438 \u043F\u0440\u043E \u0442\u0435, \u0449\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824764
    m_Localized: "\u0414\u043E\u043B\u044F \u043D\u0435\u0437\u0431\u0430\u0433\u043D\u0435\u043D\u043D\u0430
      \u0434\u043B\u044F \u043D\u0430\u0441, \u0441\u043C\u0435\u0440\u0442\u043D\u0438\u0445.
      \u0410\u043B\u0435 \u0442\u0430\u043A\u0456 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438,
      \u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0438\u0445
      \u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u0441\u0442\u043E\u044F\u0442\u044C
      \u0432\u0438\u0449\u0435 \u0437\u0430 \u0441\u0432\u0456\u0442 \u0436\u0438\u0432\u0438\u0445.
      \u0412\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E, \u043D\u0456\u0431\u0438 \u0433\u043B\u0438\u043D\u0443
      \u043F\u0456\u0434 \u043A\u043E\u043F\u0438\u0442\u0430\u043C\u0438 \u0432\u043C\u0456\u043B\u043E\u0433\u043E
      \u0433\u043E\u043D\u0447\u0430\u0440\u0430 - \u043C'\u044F\u043A\u043E, \u0430\u043B\u0435
      \u043D\u0435\u0432\u0431\u043B\u0430\u0433\u0430\u043D\u043D\u043E. \u041A\u043E\u043B\u0438
      \u0445\u043E\u0447\u0435\u0448 \u043F\u0440\u043E\u0436\u0438\u0442\u0438 \u0440\u0435\u0448\u0442\u0443
      \u0436\u0438\u0442\u0442\u044F \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E,
      \u0442\u0440\u0438\u043C\u0430\u0439\u0441\u044F \u043F\u043E\u0434\u0430\u043B\u0456
      \u0432\u0456\u0434 \u043F\u043E\u0434\u0456\u0431\u043D\u043E\u0433\u043E \u0437\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824765
    m_Localized: "\u0426\u0435... \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0434\u0438\u0432\u043D\u043E,
      \u0449\u043E\u0431 \u0431\u0443\u0442\u0438 \u043F\u0440\u0430\u0432\u0434\u043E\u044E.
      \u0422\u0430 \u043D\u0456, \u0446\u0435 \u043C\u0430\u044F\u0447\u043D\u044F.
      \u0412\u0438\u0431\u0430\u0447, \u0417\u0430\u043C\u0431\u0435\u0437\u0456.
      \u041C\u043E\u0436\u0435, \u0446\u044F \u043A\u043D\u0438\u0436\u043A\u0430
      \u0439 \u0437\u0433\u0443\u0431\u043D\u0430, \u0430\u043B\u0435 \u044F \u043D\u0435
      \u0437\u0430\u043B\u0438\u0448\u0443 \u0442\u0430\u043A\u0438\u0439 \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u0439
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u0434\u0435 \u043F\u043E\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824766
    m_Localized: "\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0446\u044F \u043C\u043E\u0436\u0435
      \u043E\u0431\u0456\u0439\u0442\u0438\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u043E
      \u0432 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443.
      \u0410\u043B\u0435 \u044F \u043D\u0435 \u043C\u043E\u0436\u0443 \u0437\u043C\u0443\u0441\u0438\u0442\u0438
      \u0442\u0435\u0431\u0435. \u041A\u043E\u043B\u0438 \u0427\u043E\u0440\u043D\u0430
      \u041A\u043D\u0438\u0433\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0435 \u0442\u0435\u0431\u0435
      \u0434\u043E \u0437\u0430\u0433\u0438\u0431\u0435\u043B\u0456, \u0456 \u0442\u0432\u043E\u0457
      \u043A\u0456\u0441\u0442\u043A\u0438 \u0432\u0456\u0434\u043F\u043E\u043B\u0456\u0440\u0443\u0454
      \u0432\u0456\u0442\u0435\u0440 \u043F\u0443\u0441\u0442\u0435\u043B\u0456,
      \u044F \u043F\u0440\u0438\u0439\u0434\u0443 \u0456 \u043F\u043E\u0445\u043E\u0432\u0430\u044E
      \u0457\u0445. \u0410\u043B\u0435 \u043B\u0438\u0448\u0435 \u043F\u0456\u0441\u043B\u044F
      \u0442\u043E\u0433\u043E, \u044F\u043A \u043F\u043E\u0445\u043E\u0432\u0430\u044E
      \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E \u0446\u044E \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0443
      \u0440\u0456\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824767
    m_Localized: "\u0415\u043C\u043C... \u0414\u044F\u043A\u0443\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824768
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u043C\u0438 \u0434\u0440\u0443\u0437\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824769
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 2737824770
    m_Localized: "\u041A\u043E\u043B\u0438 \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F, \u0432\u0456\u043D
      \u0431\u0430\u0433\u0430\u0442\u043E \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0432
      \u043D\u0430\u043C \u043F\u0440\u043E \u0442\u0432\u0456\u0439 \u043D\u043E\u0432\u0438\u0439
      \u043A\u043E\u0441\u0442\u044E\u043C \u0456 \u0439\u043E\u0433\u043E \u043C\u0430\u0433\u0456\u044E.
      \u0423 \u0442\u0435\u0431\u0435 \u0431\u0443\u0432 \u0410\u043C\u0443\u043B\u0435\u0442
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430! \u042F \u0431 \u0443\u0441\u0435
      \u0432\u0456\u0434\u0434\u0430\u043B\u0430 \u0437\u0430 \u0442\u0435, \u0449\u043E\u0431
      \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824771
    m_Localized: "\u0412\u0438\u0431\u0430\u0447, \u0430\u043B\u0435 \u0432\u0456\u043D
      \u0431\u0443\u0432 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0434\u043B\u044F
      \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0438\u0445 \u0441\u043F\u0440\u0430\u0432.
      \u041F\u043E\u0440\u044F\u0442\u0443\u043D\u043A\u0443, \u043C\u043E\u0433\u043E
      \u0434\u043E\u043C\u0443, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824772
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u0437\u043D\u0430\u044E. \u0410\u043B\u0435
      \u0432\u0441\u0435 \u0436 - \u0445\u043E\u0447 \u0431\u0438 \u0440\u0430\u0437
      \u043F\u0456\u0434\u0456\u0439\u0448\u043B\u0430 \u0437 \u043D\u0438\u043C.
      \u0412\u0456\u043D \u0449\u0435 \u0443 \u0442\u0435\u0431\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824773
    m_Localized: "\u041D\u0456, \u0432\u0456\u043D \u0432\u0438\u0433\u043E\u0440\u0456\u0432
      \u0443 \u0431\u043E\u044E \u0456 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435
      \u0456\u0441\u043D\u0443\u0454. \u0412\u0438\u0431\u0430\u0447, \u0449\u043E
      \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430 \u0441\u043E\u0431\u0456
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0439\u043E\u0433\u043E
      \u0432 \u0431\u0438\u0442\u0432\u0456, \u044F\u043A\u0430 \u0432\u0438\u0440\u0456\u0448\u0443\u0432\u0430\u043B\u0430
      \u0434\u043E\u043B\u044E \u0441\u043E\u0442\u0435\u043D\u044C \u0456\u043D\u0448\u0438\u0445
      \u043F\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824774
    m_Localized: "... \u0412\u0438\u0431\u0430\u0447. \u041C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430
      \u0431\u0443\u0442\u0438 \u0431\u0456\u043B\u044C\u0448 \u0432\u0432\u0456\u0447\u043B\u0438\u0432\u043E\u044E.
      \u0410\u043B\u0435, \u0441\u0432\u044F\u0442\u0430 \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F,
      \u0410\u043C\u0443\u043B\u0435\u0442 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430
      - \u0446\u0435 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044F \u043B\u0435\u0433\u0435\u043D\u0434\u0430!
      \u0422\u0430 \u0449\u043E \u0442\u0430\u043C \u043B\u0435\u0433\u0435\u043D\u0434\u0430!
      \u041F\u0440\u043E \u0439\u043E\u0433\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0443
      \u0441\u043A\u043B\u0430\u0434\u0430\u043B\u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u0438!
      \u0406 \u043F\u0440\u043E \u0439\u043E\u0433\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824775
    m_Localized: "\u0422\u0430\u043A, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043C\u0435\u043D\u0456 \u0434\u0456\u0439\u0441\u043D\u043E \u0432\u0430\u0440\u0442\u043E
      \u0431\u0443\u043B\u043E \u043F\u0456\u0434\u0456\u0439\u0442\u0438 \u0434\u043E
      \u0442\u0435\u0431\u0435 \u0437 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824776
    m_Localized: "\u0426\u044F \u0431\u0440\u043E\u043D\u044F... \u0421\u0432\u044F\u0442\u0430
      \u0421\u0435\u043B\u0435\u0441\u0442\u0456\u044F, \u0449\u043E \u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824777
    m_Localized: "\u041F\u0440\u043E\u0435\u043A\u0442 \u0443\u0447\u0435\u043D\u0438\u0445
      \u043C\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430. \u0412\u0456\u043D
      \u0431\u0443\u0432 \u0434\u0443\u0436\u0435 \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0439
      \u0443 \u0431\u043E\u044E \u0437 \u0410\u043D\u043A\u043B\u0430\u0432\u043E\u043C,
      \u0430\u043B\u0435 \u0437\u0430\u0440\u0430\u0437 \u0432\u0456\u043D \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0445\u0456\u0431\u0430 \u0449\u043E \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0442\u0438
      \u043C\u0435\u043D\u0456 \u043B\u0456\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824778
    m_Localized: "\"\u0425\u0456\u0431\u0430 \u0449\u043E\"? \u0422\u0430 \u0445\u0442\u043E
      \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E \u0432 \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0456
      \u0442\u043E\u0431\u0456 \u0434\u0443\u0448\u0443 \u043F\u0440\u043E\u0434\u0430\u0441\u0442\u044C
      \u0443\u0436\u0435 \u0437\u0430 \u0446\u0435! \u041D\u0430 \u0449\u043E \u0436
      \u0432\u0456\u043D \u0431\u0443\u0432 \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0440\u0430\u043D\u0456\u0448\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824779
    m_Localized: "\u0415\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0443\u0432\u0430\u0442\u0438
      \u0441\u0438\u043B\u0443, \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0443
      \u0439\u043E\u0433\u043E \u0442\u0432\u043E\u0440\u0446\u044F\u043C, \u0456
      \u043D\u0430\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0431\u0456\u0434\u0438.
      \u041D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824780
    m_Localized: "\u041D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0437\u0430\u043A\u0456\u043D\u0447\u0443\u0454\u0442\u044C\u0441\u044F
      \u0456\u0441\u0442\u043E\u0440\u0456\u044F \u043F\u043E\u043D\u0456 \u043D\u0430
      \u0456\u043C'\u044F @lp. \u0410\u043B\u0435 \u043D\u0435 \u0432\u0430\u0448\u0430
      \u0433\u0440\u0430. \u0412\u0438 \u0439 \u0434\u0430\u043B\u0456 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438 \u041F\u0443\u0441\u0442\u043A\u043E\u044E,
      \u0431\u0438\u0442\u0438\u0441\u044F \u0437 \u0432\u043E\u0440\u043E\u0433\u0430\u043C\u0438,
      \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F,
      \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0440\u0456\u0432\u043D\u0456
      \u0442\u0430 \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u043A\u043E\u043B\u0435\u043A\u0446\u0456\u044E
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432. \u041C\u0438 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0454\u043C\u043E\u0441\u044F,
      \u0449\u043E \u0432\u0430\u043C \u0431\u0443\u043B\u043E \u0442\u0430\u043A
      \u0441\u0430\u043C\u043E \u043F\u0440\u0438\u0454\u043C\u043D\u043E \u0433\u0440\u0430\u0442\u0438
      \u0432 \u0446\u044E \u0433\u0440\u0443, \u044F\u043A \u043D\u0430\u043C \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u043D\u0430\u0434 \u043D\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824781
    m_Localized: "\u0410 \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u0438\u0445 \u0442\u0438\u0442\u0440\u0456\u0432
      \u043D\u0435 \u0431\u0443\u0434\u0435! \u041D\u0430\u0444\u0456\u0433 \u0432\u043E\u043D\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456? \u0425\u0442\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u0447\u0438\u0442\u0430\u0454 \u0446\u0456 \u0441\u0442\u0456\u043D\u0438
      \u0442\u0435\u043A\u0441\u0442\u0443 \u0456 \u0434\u043E\u0432\u0433\u0456
      \u0441\u043F\u0438\u0441\u043A\u0438 \u043F\u0440\u0456\u0437\u0432\u0438\u0449
      \u0442\u0438\u0445, \u0445\u0442\u043E \u0442\u0430\u043C \u0445\u043E\u0447
      \u0442\u0440\u043E\u0445\u0438 \u0431\u0440\u0430\u0432 \u0443\u0447\u0430\u0441\u0442\u044C
      \u0443 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u0456 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0443?
      \u041C\u0430\u0431\u0443\u0442\u044C, \u043D\u0456\u0445\u0442\u043E, \u043A\u0440\u0456\u043C
      \u0441\u0430\u043C\u0438\u0445 \u0442\u0432\u043E\u0440\u0446\u0456\u0432.
      \u0422\u043E\u0436 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u0433\u0440\u0443\u0437\u0438\u0442\u0438 \u0432\u0430\u0441, \u043A\u0440\u0430\u0449\u0435
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u043C\u043E \u0433\u0440\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824782
    m_Localized: "\u042F \u0431\u0430\u0447\u0443, \u0443 \u0442\u0435\u0431\u0435
      \u043D\u0435\u043C\u0430\u0454 \u043D\u0456\u044F\u043A\u043E\u0457 \u0431\u0440\u043E\u043D\u0456.
      \u041E\u0434\u0438\u043D \u0442\u0456\u043B\u044C\u043A\u0438... \u043A\u043E\u043C\u0431\u0456\u043D\u0435\u0437\u043E\u043D?
      \u0423 \u0442\u0430\u043A\u043E\u043C\u0443 \u043E\u0434\u044F\u0437\u0456
      \u0442\u0438 \u043D\u0430 \u041F\u0443\u0441\u0442\u0438\u0449\u0430\u0445
      \u0434\u043E\u0432\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0442\u044F\u0433\u043D\u0435\u0448.
      \u0425\u043E\u0447\u0435\u0448 \u0432\u0438\u0436\u0438\u0442\u0438 - \u043F\u043E\u0434\u0431\u0430\u0439
      \u043F\u0440\u043E \u0441\u0432\u0456\u0439 \u0437\u0430\u0445\u0438\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824783
    m_Localized: "\u0429\u043E? \u0410... \u043D\u0443 \u0442\u0430\u043A. \u041D\u0456\u0447\u043E\u0433\u043E
      \u0456\u043D\u0448\u043E\u0433\u043E \u0432 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454.
      \u0410 \u0442\u0438, \u0437\u043D\u0430\u0447\u0438\u0442\u044C, \u043C\u043E\u0436\u0435\u0448
      \u043C\u0435\u043D\u0456 \u0432 \u0446\u044C\u043E\u043C\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824784
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E. \u0411\u0440\u043E\u043D\u044F
      - \u043C\u0456\u0439 \u0431\u0456\u0437\u043D\u0435\u0441 \u0442\u0443\u0442.
      \u041E\u0434\u043D\u0430\u043A \u0440\u043E\u0437\u0447\u0430\u0440\u0443\u044E:
      \u0437\u0430\u0440\u0430\u0437 \u0443 \u043C\u0435\u043D\u0435 \u043D\u0430
      \u0441\u043A\u043B\u0430\u0434\u0456 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
      \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u044C\u0441\u044F \u0442\u0432\u043E\u0433\u043E
      \u0440\u043E\u0437\u043C\u0456\u0440\u0443. \u0425\u0456\u0431\u0430 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0443\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0438\u0439 \u043A\u043E\u043C\u0431\u0456\u043D\u0435\u0437\u043E\u043D
      \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442 \u0442\u0432\u043E\u0433\u043E
      \u0442\u0430 \u043F\u0430\u0440\u0430 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0445
      \u043A\u043E\u0441\u0442\u044E\u043C\u0456\u0432. \u0410\u043B\u0435 \u0432\u0441\u0435
      \u0436 \u0446\u0435 \u043A\u0440\u0430\u0449\u0435, \u043D\u0456\u0436 \u043D\u0456\u0447\u043E\u0433\u043E,
      \u0442\u043E\u0436 \u043E\u0441\u044C, \u043F\u043E\u0433\u043B\u044F\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824785
    m_Localized: "\u0412\u0438\u0433\u043B\u044F\u0434\u0430\u0454 \u044F\u043A\u043E\u0441\u044C
      \u043D\u0435 \u0434\u0443\u0436\u0435. \u0410 \u0442\u043E\u0447\u043D\u043E
      \u043D\u0435\u043C\u0430\u0454 \u043D\u0456\u0447\u043E\u0433\u043E \u043A\u0440\u0430\u0449\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824786
    m_Localized: "\u0417\u0432\u0456\u0434\u043A\u0438? \u0423 \u0446\u044C\u043E\u043C\u0443
      \u0442\u0430\u0431\u043E\u0440\u0456 \u0437 \u0442\u0432\u043E\u0457\u043C
      \u0440\u043E\u0437\u043C\u0456\u0440\u043E\u043C \u0442\u0456\u043B\u044C\u043A\u0438
      \u043B\u043E\u0448\u0430\u0442\u0430. \u041C\u043E\u0436\u0435\u0448 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u043F\u0438\u0442\u0430\u0442\u0438 \u0432 \u0456\u043D\u0448\u0438\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456\u0432 - \u0431\u0440\u043E\u043D\u0435\u044E
      \u0442\u0443\u0442 \u0437\u0430\u0439\u043C\u0430\u044E\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438
      \u044F. \u0410\u043B\u0435 \u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F,
      \u0441\u043A\u043E\u0440\u043E \u043E\u0447\u0456\u043A\u0443\u044E\u0442\u044C\u0441\u044F
      \u043D\u043E\u0432\u0456 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438.
      \u041E\u0441\u044C \u0442\u043E\u0434\u0456 \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u043F\u0456\u0434\u0431\u0435\u0440\u0435\u043C\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u0435
      \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0449\u0435.
      \u0410 \u043F\u043E\u043A\u0438 \u0433\u043E\u0442\u0443\u0439 \u043A\u0440\u0438\u0448\u043A\u0438,
      \u0445\u043E\u0440\u043E\u0448\u0430 \u0431\u0440\u043E\u043D\u044F \u043A\u043E\u0448\u0442\u0443\u0454
      \u043D\u0435\u0434\u0435\u0448\u0435\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824787
    m_Localized: "\u0422\u0430\u043A, \u0456 \u044F\u043A\u0449\u043E \u043F\u043E\u0448\u043A\u043E\u0434\u0438\u0448
      \u0441\u0432\u043E\u044E \u0431\u0440\u043E\u043D\u044E - \u043D\u0443 \u0442\u0430\u043C
      \u0445\u0456\u0431\u0430 \u043C\u0430\u043B\u043E \u0449\u043E, \u0443 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0456\u043B\u043A\u0443
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0448 \u0430\u0431\u043E \u0437\u0430
      \u0446\u0432\u044F\u0445 \u0437\u0430\u0447\u0435\u043F\u0438\u0448\u0441\u044F
      - \u0442\u044F\u0433\u043D\u0438 \u0457\u0457 \u0434\u043E \u043C\u0435\u043D\u0435.
      \u042F \u0432\u043C\u0438\u0442\u044C \u0443\u0441\u0435 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0436\u0443.
      \u041D\u0435 \u0431\u0435\u0437\u043F\u043B\u0430\u0442\u043D\u043E, \u0437\u0432\u0456\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824788
    m_Localized: "\u0423\u0442\u0456\u043C, \u044F\u043A\u0449\u043E \u043A\u043E\u043F\u0438\u0442\u0430
      \u0434\u0430\u044E\u0442\u044C \u0437\u043C\u043E\u0433\u0443 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u0431\u0440\u043E\u043D\u044E \u0441\u0430\u043C\u043E\u0442\u0443\u0436\u043A\u0438,
      \u0442\u043E \u043C\u043E\u0436\u0435\u0448 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043C\u043E\u0457\u043C \u0432\u0435\u0440\u0441\u0442\u0430\u043A\u043E\u043C,
      \u043C\u0435\u043D\u0456 \u043D\u0435 \u0448\u043A\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824789
    m_Localized: "\u041E\u0441\u044C, \u044F\u043A \u0456 \u043E\u0431\u0456\u0446\u044F\u0432,
      \u043D\u043E\u0432\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430.
      \u0422\u0432\u043E\u0433\u043E \u0440\u043E\u0437\u043C\u0456\u0440\u0443 \u0454
      \u0434\u0432\u0456 \u0440\u0435\u0447\u0456: \u0448\u043A\u0456\u0440\u044F\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F \u0456 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0430.
      \u041F\u0440\u0438\u0434\u0438\u0432\u043B\u044F\u0439\u0441\u044F, \u043E\u0446\u0456\u043D\u044E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824790
    m_Localized: "\u0426\u0456\u043A\u0430\u0432\u043E. \u0406 \u044F\u043A\u0430
      \u0437 \u043D\u0438\u0445 \u043A\u0440\u0430\u0449\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824791
    m_Localized: "\u0423 \u043A\u043E\u0436\u043D\u043E\u0457 \u0454 \u0441\u0432\u043E\u0457
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0438 \u0442\u0430 \u043D\u0435\u0434\u043E\u043B\u0456\u043A\u0438.
      \u041C\u0435\u0442\u0430\u043B\u0435\u0432\u0430 \u043C\u043E\u0436\u0435 \u043F\u043E\u043C'\u044F\u043A\u0448\u0438\u0442\u0438
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441 \u0432\u0456\u0434 \u043A\u0443\u043B\u044C
      \u0456 \u0443\u0434\u0430\u0440\u0456\u0432, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0443\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0432\u0456\u0434 \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u043E\u0434\u043D\u0430\u043A \u0441\u0430\u043C\u0430
      \u043F\u043E \u0441\u043E\u0431\u0456 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0432\u0430\u0436\u043A\u0430 \u0456 \u0431\u0443\u0434\u0435 \u0442\u0435\u0431\u0435
      \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0432\u0430\u0442\u0438.
      \u0422\u043E\u0434\u0456 \u044F\u043A \u0448\u043A\u0456\u0440\u044F\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F \u043B\u0435\u0433\u043A\u0430, \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u044C
      \u0432\u0456\u0434 \u0436\u0430\u0440\u0443, \u0456\u043A\u043B\u0456\u0432
      \u0456 \u043F\u0430\u0437\u0443\u0440\u0456\u0432 \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432,
      \u0430\u043B\u0435 \u043F\u0440\u043E\u0442\u0438 \u043A\u0443\u043B\u044C
      \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435. \u0412\u0438\u0431\u0456\u0440
      \u0437\u0430 \u0442\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824792
    m_Localized: "\u0410 \u043E\u0431\u0438\u0434\u0432\u0456 \u043E\u0434\u0440\u0430\u0437\u0443
      \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0432\u0434\u044F\u0433\u043D\u0443\u0442\u0438?
      \u041D\u0443, \u0448\u043A\u0456\u0440\u044F\u043D\u0443 \u043F\u0456\u0434
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824793
    m_Localized: "\u041F\u0444\u0444. \u0421\u043C\u0456\u0448\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824794
    m_Localized: "\u0410 \u0447\u0438 \u043D\u0435\u043C\u0430\u0454 \u0432 \u0442\u0435\u0431\u0435
      \u0447\u043E\u0433\u043E\u0441\u044C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824795
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0433\u043E? \u0423
      \u044F\u043A\u043E\u043C\u0443 \u043F\u043B\u0430\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824796
    m_Localized: "\u041D\u0443, \u0447\u043E\u0433\u043E\u0441\u044C, \u0449\u043E
      \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u043B\u043E\u0441\u044F \u0431
      \u0432\u0456\u0434 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824797
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456 \u043D\u0435 \u0456\u0441\u043D\u0443\u0454,
      \u0443 \u0432\u0441\u0456\u0445 \u0432\u0456\u0434\u043E\u043C\u0438\u0445
      \u043C\u0435\u043D\u0456 \u0442\u0438\u043F\u0456\u0432 \u0454 \u0441\u0432\u043E\u0457
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u0456. \u0410\u043B\u0435
      \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u043F\u0440\u043E \u0449\u043E
      \u0442\u0438. \u041C\u0456\u0439 \u0441\u0442\u0430\u0440\u0438\u0439 \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044C
      \u0412\u043E\u0432\u043A \u043A\u043E\u043B\u0438\u0441\u044C \u0434\u0430\u0432
      \u043C\u0435\u043D\u0456 \u0441\u0445\u0435\u043C\u0443, \u0437\u0430 \u044F\u043A\u043E\u044E
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043A\u0438
      \u0437 \u043F\u0430\u043D\u0446\u0438\u0440\u0456\u0432 \u0440\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u0456\u0432.
      \u042F\u043A \u0442\u0438, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u043D\u0430\u0454\u0448,
      \u0457\u0445\u043D\u0456 \u0445\u0456\u0442\u0438\u043D\u043E\u0432\u0456 \u043F\u0430\u043D\u0446\u0438\u0440\u0438
      \u0434\u0443\u0436\u0435 \u043C\u0456\u0446\u043D\u0456, \u0430\u043B\u0435
      \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u043B\u0435\u0433\u043A\u0456
      \u0442\u0430 \u0433\u043D\u0443\u0447\u043A\u0456, \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u044C
      \u0457\u0445 \u0447\u0443\u0434\u043E\u0432\u0438\u043C \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u043E\u043C.
      \u041E\u0434\u043D\u0430\u043A \u0434\u043E \u0446\u044C\u043E\u0433\u043E
      \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0443 \u0432
      \u043C\u0435\u043D\u0435 \u043A\u043E\u043F\u0438\u0442\u0430 \u043F\u043E\u043A\u0438
      \u0449\u043E \u043D\u0435 \u0434\u0456\u0439\u0448\u043B\u0438, \u0442\u0430
      \u0439 \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0438 \u0434\u0456\u0439\u0434\u0443\u0442\u044C.
      \u0422\u043E\u0436, \u044F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0448,
      \u043C\u043E\u0436\u0443 \u043F\u0440\u043E\u0434\u0430\u0442\u0438 \u0442\u043E\u0431\u0456
      \u0457\u0457 \u043A\u043E\u043F\u0456\u044E \u0437\u0430 \u0434\u043E\u0441\u0438\u0442\u044C
      \u043F\u043E\u043C\u0456\u0440\u043D\u0443 \u0446\u0456\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824798
    m_Localized: "\u042F \u0434\u0438\u0432\u043B\u044E\u0441\u044F, \u043C\u043E\u044F
      \u0441\u0445\u0435\u043C\u0430 \u0442\u043E\u0431\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u0430\u0441\u044F.
      \u0406 \u044F\u043A \u0431\u0440\u043E\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824799
    m_Localized: "\u0422\u0440\u043E\u0445\u0438 \u043D\u0430\u0442\u0438\u0440\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824800
    m_Localized: "\u0407\u0439 \u043D\u0435 \u0437\u0430\u0432\u0430\u0434\u0438\u0442\u044C
      \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430 \u043F\u0456\u0434\u0433\u043E\u043D\u043A\u0430.
      \u0422\u043E\u0434\u0456 \u0432\u043E\u043D\u0430 \u0437\u043C\u043E\u0436\u0435
      \u0441\u043B\u0443\u0436\u0438\u0442\u0438 \u0442\u043E\u0431\u0456 \u0449\u0435
      \u043A\u0440\u0430\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824801
    m_Localized: "\u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0432\u0447\u043E\u0440\u0430
      \u0432 \u0442\u0430\u0431\u0456\u0440 \u043F\u0440\u0438\u0439\u0448\u043E\u0432
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0456 \u0441\u0435\u0440\u0435\u0434
      \u0440\u0435\u0447\u0435\u0439 \u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436
      \u0431\u0443\u0432 \u0446\u0456\u043B\u0438\u0439 \u044F\u0449\u0438\u043A
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u043E\u0457 \u0431\u043E\u0439\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456. \u0422\u0432\u0456\u0439 \u0440\u043E\u0437\u043C\u0456\u0440
      \u0442\u0435\u0436 \u0454. \u0425\u043E\u0447\u0435\u0448 \u043F\u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824802
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0443\u0439, \u0449\u043E \u0432
      \u0442\u0435\u0431\u0435 \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824803
    m_Localized: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0439
      \u0437\u0440\u0430\u0437\u043E\u043A \u0440\u043E\u0437\u0440\u043E\u0431\u043E\u043A
      \u041C\u0412\u0422. \u041F\u043E\u043B\u0456\u043C\u0435\u0440\u043D\u043E-\u043A\u0435\u0440\u0430\u043C\u0456\u0447\u043D\u0456
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0438, \u0432\u043E\u0433\u043D\u0435\u0441\u0442\u0456\u0439\u043A\u0430
      \u0442\u043A\u0430\u043D\u0438\u043D\u0430 \u0437 \u043A\u0435\u0432\u043B\u0430\u0440\u043E\u0432\u043E\u044E
      \u043F\u0456\u0434\u043A\u043B\u0430\u0434\u043A\u043E\u044E. \u0421\u043A\u0440\u043E\u0454\u043D\u0430
      \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u043D\u043E\u043C, \u0449\u043E\u0431
      \u043D\u0435 \u043E\u0431\u043C\u0435\u0436\u0443\u0432\u0430\u0442\u0438 \u0440\u0443\u0445\u0456\u0432.
      \u0406\u0434\u0435\u0430\u043B\u044C\u043D\u0430 \u0434\u043B\u044F \u0443\u043C\u043E\u0432
      \u0431\u043E\u044E \u043D\u0430 \u0441\u0435\u0440\u0435\u0434\u043D\u0456\u0445
      \u0456 \u0431\u043B\u0438\u0436\u043D\u0456\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044F\u0445
      \u043F\u0440\u043E\u0442\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043E\u0433\u043E \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824804
    m_Localized: "\u0410 \u044F\u043A \u0449\u043E\u0434\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443
      \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824805
    m_Localized: "\u041E\u0441\u044C \u0456\u0437 \u0446\u0438\u043C \u0433\u0456\u0440\u0448\u0435.
      \u0426\u044E \u0431\u0440\u043E\u043D\u044E \u0431\u0443\u043B\u043E \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E
      \u0449\u0435 \u0434\u043E \u0442\u043E\u0433\u043E, \u044F\u043A \u043F\u043E\u0434\u0456\u0431\u043D\u0430
      \u0437\u0431\u0440\u043E\u044F \u043D\u0430\u0431\u0443\u043B\u0430 \u043C\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u043F\u043E\u0448\u0438\u0440\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824806
    m_Localized: "\u041E\u0434\u043D\u0430\u043A \u044F\u043A\u0449\u043E \u0442\u043E\u0431\u0456
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0437\u0430\u0445\u0438\u0441\u0442
      \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432, \u044F \u043C\u043E\u0436\u0443
      \u0442\u043E\u0431\u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438.
      \u041D\u0430 \u0441\u043A\u043B\u0430\u0434\u0456 \u0432 \u043C\u0435\u043D\u0435
      \u043B\u0435\u0436\u0438\u0442\u044C \u043D\u0435\u043F\u0440\u043E\u0434\u0430\u043D\u0438\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456. \u0412\u043E\u043D\u0430 \u0431\u0443\u043B\u0430
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u043F\u0440\u043E\u0442\u0438\u0434\u0456\u0457 \u0442\u0430\u043A\u0456\u0439
      \u0437\u0431\u0440\u043E\u0457 \u0456 \u0434\u043E\u0431\u0440\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u0456\u0437 \u0437\u0430\u0445\u0438\u0441\u0442\u043E\u043C \u043D\u043E\u0441\u0456\u044F
      \u0432\u0456\u0434 \u043B\u0430\u0437\u0435\u0440\u0456\u0432, \u043F\u043B\u0430\u0437\u043C\u0438
      \u0442\u0430 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438. \u042F\u043A\u0449\u043E
      \u043F\u043B\u0430\u043D\u0443\u0454\u0448 \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0442\u0438
      \u043D\u0435\u0440\u043E\u0437\u0433\u0440\u0430\u0431\u043E\u0432\u0430\u043D\u0438\u0439
      \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0439 \u0437\u0430\u0432\u043E\u0434
      \u0430\u0431\u043E \u0456\u043D\u0448\u0435 \u043C\u0456\u0441\u0446\u0435
      \u0437 \u043A\u0443\u043F\u043E\u044E \u0440\u043E\u0431\u043E\u0442\u0456\u0432,
      \u0446\u044F \u0431\u0440\u043E\u043D\u044F - \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439
      \u0432\u0438\u0431\u0456\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824807
    m_Localized: "\u0422\u043E\u0431\u0442\u043E \u044F\u043A\u0449\u043E \u044F
      \u043E\u0434\u044F\u0433\u043D\u0443 \u0431\u043E\u0439\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E,
      \u0430 \u043F\u043E\u0432\u0435\u0440\u0445 \u043D\u0435\u0457 - \u043C\u0430\u0433\u0456\u0447\u043D\u0443
      \u043D\u0430 \u043F\u0430\u0440\u0443 \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432
      \u0431\u0456\u043B\u044C\u0448\u0443, \u044F \u0431\u0443\u0434\u0443 \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0430
      \u0432\u0456\u0434 \u0443\u0441\u044C\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824808
    m_Localized: "\u0426\u0435 \u0442\u0430\u043A \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454,
      @lp. \u0417 \u0434\u043E\u0441\u0432\u0456\u0434\u043E\u043C \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824809
    m_Localized: "\u0414\u0430\u0440\u043E\u0432\u0430! \u0422\u0435\u0436 \u043B\u044E\u0431\u0438\u0448
      \u0443\u0441\u0435 \u043F\u0456\u0434\u0440\u0438\u0432\u0430\u0442\u0438 \u043A
      \u0445\u0440\u0456\u043D\u0430\u043C? \u041D\u0443 \u0442\u0430\u043A \u0449\u043E\u0431
      - \u0445\u0440\u044F\u0441\u044C! \u0411\u0434\u0438\u0449! \u041F\u0438\u0449-\u043F\u0438\u0449-\u043F\u0438\u0449!
      \u0429\u043E \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F
      - \u0434\u0438\u043D\u0430\u043C\u0456\u0442, \u0433\u0440\u0430\u043D\u0430\u0442\u0438
      \u0447\u0438 \u043C\u0456\u043D\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824810
    m_Localized: "\u0425\u043C... \u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0437\u043D\u0430\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824811
    m_Localized: "\u042F\u043A \u043D\u0430 \u043C\u0435\u043D\u0435, \u0442\u0430\u043A
      \u043D\u0430\u0439\u043F\u0440\u0438\u043A\u043E\u043B\u044C\u043D\u0456\u0448\u0435
      - \u0446\u0435 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442.
      \u0424\u0448\u0443\u0443\u0443\u0443\u0443\u0443\u0445! \u0411\u0430\u0431\u0430\u0445!
      \u0423\u0441\u0456 \u0432\u043E\u0440\u043E\u0433\u0438 \u043D\u0430 \u0448\u043C\u0430\u0442\u043E\u0447\u043A\u0438!
      \u0420\u0435\u0430\u043B\u044C\u043D\u0430 \u0436\u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824812
    m_Localized: "\u0425\u043E\u0447\u0430, \u0437\u0432\u0456\u0441\u043D\u043E,
      \u0456 \u0432 \u043C\u0456\u043D \u0454 \u0441\u0432\u0456\u0439 \u043F\u0440\u0438\u043A\u043E\u043B.
      \u042F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0448 \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
      \u0432\u043E\u0440\u043E\u0433\u0430\u043C \u043D\u0435\u0436\u0434\u0430\u043D\u0447\u0438\u043A,
      \u0442\u043E \u043A\u0440\u0430\u0449\u043E\u0433\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u0443
      \u043D\u0435\u043C\u0430. \u0417\u0430\u043D\u0438\u043A\u0430\u0439 \u043F\u0430\u0440\u0443
      \u0448\u0442\u0443\u043A \u0443 \u043D\u0438\u0445 \u043D\u0430 \u0448\u043B\u044F\u0445\u0443,
      \u0432\u043E\u043D\u0438 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u043F\u0440\u043E\u0441\u0435\u0447\u0443\u0442\u044C, \u0447\u0438\u043C
      \u0457\u0445 \u043D\u0430\u043A\u0440\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824813
    m_Localized: "\u0410\u0431\u043E \u043E\u0441\u044C, \u0442\u0438\u043F\u0443,
      \u0442\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043E\u0431\u043D\u0435\u0441\u0442\u0438
      \u0441\u0435\u0439\u0444, \u0430\u0431\u043E \u0442\u0430\u043C \u044F\u043A\u0438\u0439\u0441\u044C
      \u0441\u043A\u043B\u0430\u0434 \u0456\u0437 \u0431\u0430\u0440\u0430\u0445\u043B\u043E\u043C
      \u0431\u043E\u043C\u0431\u0430\u043D\u0443\u0442\u0438, \u0430 \u0437\u0430\u043C\u043A\u0438
      \u0434\u0443\u0436\u0435 \u0432\u0436\u0435 \u0445\u0438\u0442\u0440\u043E\u0436\u043E\u043F\u043E
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0456? \u0425\u043E\u0440\u043E\u0448\u0430
      \u0431\u043E\u043C\u0431\u0430 \u0430\u0431\u043E \u043F\u0430\u0440\u0430
      \u0437\u0432'\u044F\u0437\u043E\u043A \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u0443
      \u043B\u0435\u0433\u043A\u043E \u0440\u043E\u0437\u0440\u0443\u043B\u044F\u0442\u044C
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824814
    m_Localized: "\u041E\u0433\u043E, \u0443 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438
      \u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u044C?
      \u0420\u0430\u043D\u0456\u0448\u0435 \u044F \u043F\u0440\u043E \u0446\u0435
      \u044F\u043A\u043E\u0441\u044C \u0456 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824815
    m_Localized: "\u041D\u0443 \u0430 \u0442\u043E! \u041A\u043E\u0440\u043E\u0442\u0448\u0435,
      \u044F\u043A\u0449\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0448 \u043F\u0440\u0438\u043A\u0443\u043F\u0438\u0442\u0438
      \u044F\u043A\u0438\u0445\u043E\u0441\u044C \u0444\u0435\u0454\u0440\u0432\u0435\u0440\u043A\u0456\u0432,
      \u0442\u043E \u0421\u043C\u043E\u0443\u043A\u0456 \u041F\u0456\u0442 \u0456
      \u0439\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0447\u0438\u043A
      \u0434\u043E \u0442\u0432\u043E\u0457\u0445 \u043F\u043E\u0441\u043B\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824816
    m_Localized: "\u0413\u0435\u0439, \u043F\u043E\u0434\u0440\u0443\u0433\u043E,
      \u0437\u0438\u0440 \u0441\u044E\u0434\u0438, \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u0441\u0435\u0437\u043E\u043D\u0456
      - \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0433\u0440\u0430\u043D\u0430\u0442\u0438. \u0404 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0456
      - \u0440\u0443\u043B\u044F\u0442\u044C \u043F\u0440\u043E\u0442\u0438 \u0432\u0441\u044F\u043A\u0438\u0445
      \u0432\u0438\u0440\u043E\u0434\u043A\u0456\u0432, \u0456 \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0456
      - \u043F\u0440\u043E\u0442\u0438 \u0445\u043E\u0434\u044F\u0447\u0438\u0445
      \u0432\u0456\u0434\u0435\u0440 \u0456\u0437 \u0431\u043E\u043B\u0442\u0430\u043C\u0438.
      \u0411\u0435\u0440\u0438, \u043F\u043E\u043A\u0438 \u0449\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824817
    m_Localized: "\u0426\u0456 \u0433\u0440\u0430\u043D\u0430\u0442\u0438 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0456
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824818
    m_Localized: "\u0422\u0438 \u0449\u043E, \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u0432 \u0442\u0435\u043C\u0456? \u041D\u0430 \u0434\u043E\u0444\u0456\u0433\u0430
      \u0432\u0456\u0434\u0441\u043E\u0442\u043A\u0456\u0432 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0456!
      \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430, \u0454 \u0456 \u0432\u0456\u0434\u0441\u0442\u0456\u0439\u043D\u0456
      \u043C\u043E\u043C\u0435\u043D\u0442\u0438, \u043D\u0456\u044F\u043A\u043E\u0433\u043E
      \u0442\u043E\u0431\u0456 \u0433\u0443\u0440\u043A\u043E\u0442\u0443 \u0432\u0456\u0434
      \u0432\u0438\u0431\u0443\u0445\u0443. \u041D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435 \u0437\u0431\u0443\u0434\u0436\u0443\u0454 \u0437\u043E\u0432\u0441\u0456\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824819
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0445\u0430\u0439! \u0422\u0443\u0442
      \u0443 \u0442\u0435\u0431\u0435 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438 \u0432 \u043E\u0434\u043D\u043E\u043C\u0443
      \u043C\u0456\u0441\u0446\u0456, \u0430 \u0442\u0438 \u0449\u0435 \u0439 \u0432\u0435\u0441\u044C
      \u0447\u0430\u0441 \u043A\u0443\u0440\u0438\u0448. \u0425\u0456\u0431\u0430
      \u0446\u0435 \u043D\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824820
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824821
    m_Localized: .........
    m_Metadata:
      m_Items: []
  - m_Id: 2737824822
    m_Localized: "\u041D\u0454\u0454\u0454\u0454\u0454........."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824823
    m_Localized: "\u0426\u0456\u043A\u0430\u0432\u043B\u044F\u0442\u044C \u0440\u0435\u0430\u043B\u044C\u043D\u043E
      \u0432\u0435\u043B\u0438\u043A\u0456 \u0432\u043E\u043B\u0438\u043D\u0438?
      \u041D\u0456, \u0432 \u043D\u0430\u0442\u0443\u0440\u0456, \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0456! \u041E\u0441\u044C,
      \u0437\u0430\u0446\u0456\u043D\u0438: \u0431\u0430\u0433\u0430\u0442\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0438\u0439
      \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442 \u0456 \u0440\u0430\u043A\u0435\u0442\u043D\u0430
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824824
    m_Localized: "\u0406 \u043E\u0441\u044C \u0449\u0435 - \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0456
      \u0431\u043E\u043C\u0431\u0438, \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u0432\u043E\u0440\u043E\u0442\u0438\u0442\u0438
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0443 \u0441\u0442\u0456\u043D\u0443
      \u043D\u0430\u0445\u0440\u0456\u043D, \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0456
      \u0434\u0432\u0435\u0440\u0456, \u0430\u0431\u043E \u0440\u043E\u0437\u0445\u0440\u0456\u043D\u0430\u0447\u0438\u0442\u0438
      \u0434\u0432\u0435\u0440\u0446\u044F\u0442\u0430 \u0441\u0435\u0439\u0444\u0430
      - \u0441\u0430\u043C \u043D\u0430\u043C\u0443\u0442\u0438\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824825
    m_Localized: "\u0429\u043E, \u043F\u0440\u0430\u0432\u0434\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0441\u0442\u0456\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824826
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824827
    m_Localized: "\u041D\u0443, \u044F\u043A\u0449\u043E \u0442\u0430\u043A \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438
      \u043F\u0438\u0442\u0430\u043D\u043D\u044F - \u0442\u043E \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043D\u0456\u0444\u0456\u0433\u0430. \u041F\u0456\u0432\u043C\u0435\u0442\u0440\u043E\u0432\u0443
      \u0441\u0442\u0430\u043B\u0435\u0432\u0443 \u0441\u0442\u0456\u043D\u0443,
      \u044F\u0441\u043D\u0438\u0439 \u043F\u0435\u043D\u044C, \u043D\u0435 \u0432\u0456\u0437\u044C\u043C\u0435.
      \u0410\u043B\u0435 \u043E\u0441\u044C \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
      \u0456\u043D\u0448\u0443 - \u044F\u043A \u043A\u043E\u043F\u0438\u0442\u043E\u043C
      \u043E\u0431 \u0430\u0441\u0444\u0430\u043B\u044C\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824828
    m_Localized: "\u041E\u0433\u043E, \u0441\u043B\u0443\u0445, \u043A\u043B\u044C\u043E\u0432\u0430
      \u0431\u0440\u043E\u043D\u044F! \u0414\u0435 \u0442\u0430\u043A\u0443 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0438\u0447\u0435\u043F\u0438\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824829
    m_Localized: "\u0421\u0442\u0432\u043E\u043B\u0438, \u0433\u0430\u0440\u043C\u0430\u0442\u0438,
      \u043D\u0430\u0431\u043E\u0457... \u041F\u0456\u0434\u0445\u043E\u0434\u044C,
      \u0432\u0438\u0431\u0438\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824830
    m_Localized: "\u0429\u043E \u0442\u0438 \u043F\u0440\u043E\u0434\u0430\u0454\u0448,
      \u0437\u0431\u0440\u043E\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824831
    m_Localized: "\u0421\u0430\u043C\u043E \u0441\u043E\u0431\u043E\u044E! \u042F
      - \u0411\u0440\u0430\u0441\u0441 \u0411\u0430\u043A\u0448\u043E\u0442, \u0456
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u0431\u0456\u0437\u043D\u0435\u0441\u0456
      \u043C\u043E\u044F \u0441\u0456\u043C'\u044F \u0432\u0436\u0435 \u0442\u0440\u0438
      \u043F\u043E\u043A\u043E\u043B\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824832
    m_Localized: "\u0423 \u043C\u0435\u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0456 \u0441\u0442\u0432\u043E\u043B\u0438,
      \u0433\u0430\u0440\u0430\u043D\u0442\u0456\u044F \u044F\u043A\u043E\u0441\u0442\u0456,
      \u0443\u0441\u0456\u043B\u044F\u043A\u0438\u0439 \u043C\u043E\u0442\u043B\u043E\u0445
      \u043D\u0435 \u0442\u0440\u0438\u043C\u0430\u0454\u043C\u043E... \u0422\u043E
      \u044F\u043A\u0456\u0439 \u0437\u0431\u0440\u043E\u0457 \u043D\u0430\u0434\u0430\u0454\u0448
      \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443, \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u0456\u0439
      \u0447\u0438 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0456\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824833
    m_Localized: "\u0410 \u044F\u043A\u0443 \u0442\u0438 \u0441\u0430\u043C \u043F\u043E\u0440\u0430\u0434\u0438\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824834
    m_Localized: "\u041C\u0435\u043D\u0456 \u0431\u0456\u043B\u044C\u0448\u0435 \u0434\u043E
      \u0434\u0443\u0448\u0456 \u0441\u0442\u0430\u0440\u0438\u0439 \u0434\u043E\u0431\u0440\u0438\u0439
      \u0432\u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0456\u043B. \u0412\u043E\u043D\u0430
      \u0434\u0435\u0448\u0435\u0432\u0448\u0430, \u043D\u0430\u0434\u0456\u0439\u043D\u0456\u0448\u0430,
      \u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0430 \u0443 \u0434\u043E\u0433\u043B\u044F\u0434\u0456
      \u0456 \u043C\u043E\u0436\u0435 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0442\u0430\u043C, \u0434\u0435 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0456 \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u0454 - \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E. \u0410\u043B\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
      \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E \u0454 \u0431\u0435\u0437\u043B\u0456\u0447
      \u0440\u0456\u0437\u043D\u0438\u0445 \u043A\u0430\u043B\u0456\u0431\u0440\u0456\u0432,
      \u0456 \u043F\u0430\u0442\u0440\u043E\u043D\u0438 \u0432\u0456\u0434 \u043E\u0434\u043D\u0456\u0454\u0457
      \u0441\u0442\u0440\u0435\u043B\u044C\u043A\u0438, \u043D\u0430\u0439\u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435,
      \u043D\u0435 \u043F\u0456\u0434\u0456\u0439\u0434\u0443\u0442\u044C \u0434\u043E
      \u0456\u043D\u0448\u043E\u0457. \u0422\u0443\u0442 \u0443\u0436\u0435 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u043F\u043E\u0440\u043E\u0431\u0438\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824835
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0430
      \u0436 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0456 \u0441\u043F\u0430\u0440\u043A-\u0431\u0430\u0442\u0430\u0440\u0435\u0457,
      \u044F\u043A\u0456 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0442\u044C \u0434\u043E
      \u0447\u043E\u0433\u043E \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E,
      \u0456 \u0446\u0435, \u0442\u0440\u0435\u0431\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
      \u0434\u0443\u0436\u0435 \u0437\u0440\u0443\u0447\u043D\u043E. \u041A\u0440\u0456\u043C
      \u0442\u043E\u0433\u043E, \u043B\u0430\u0437\u0435\u0440, \u043F\u043B\u0430\u0437\u043C\u0430
      \u0430\u0431\u043E \u0432\u043E\u0433\u043E\u043D\u044C \u043C\u043E\u0436\u0443\u0442\u044C
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0442\u0430\u043C,
      \u0434\u0435 \u043D\u0435 \u0432\u043F\u043E\u0440\u0430\u044E\u0442\u044C\u0441\u044F
      \u043A\u0443\u043B\u0456. \u0404 \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456
      \u0442\u0430\u043A\u0456 \u0442\u0432\u0430\u0440\u044E\u043A\u0438, \u043F\u0440\u043E\u0442\u0438
      \u044F\u043A\u0438\u0445 \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442
      \u0456 \u0437\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F. \u0422\u0456
      \u0436 \u0441\u043B\u0438\u043C\u0430\u043A\u0438, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824836
    m_Localized: "\u0422\u0430\u043A\u043E\u0436 \u0443 \u043C\u0435\u043D\u0435,
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E, \u043C\u043E\u0436\u043D\u0430
      \u043A\u0443\u043F\u0438\u0442\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
      \u043D\u0430\u0431\u043E\u0457 \u0456 \u0431\u0430\u0442\u0430\u0440\u0435\u0457.
      \u0410 \u044F\u043A\u0449\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0448
      \u043F\u043E\u0442\u0440\u0435\u043D\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
      \u0442\u043E \u0443 \u043D\u0430\u0441 \u0454 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u0435 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0438\u0449\u0435,
      \u0434\u0432\u0435\u0440\u0456 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824837
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0435 \u043D\u0430\u0434\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u043D\u043E\u0432\u0438\u0445 \u0433\u0430\u0440\u043C\u0430\u0442! \u041F\u0456\u0434\u0445\u043E\u0434\u044C,
      \u0432\u0438\u0431\u0438\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824838
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
      \u0432 \u043A\u043B\u0456\u043D\u0456\u043A\u0443 \u0414\u043E\u043A\u0430
      \u0421\u0435\u043F\u0441\u0438\u0441\u0443. \u0426\u0435 \u044F, \u044F\u043A\u0449\u043E
      \u0449\u043E. \u041F\u043E\u0432\u043D\u0438\u0439 \u0441\u043F\u0435\u043A\u0442\u0440
      \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0445 \u043F\u043E\u0441\u043B\u0443\u0433.
      \u041B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u0440\u0430\u043D,
      \u043A\u043E\u043D\u0442\u0443\u0437\u0456\u0439, \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0456\u0432,
      \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u0432\u043E\u0457 \u0445\u0432\u043E\u0440\u043E\u0431\u0438
      \u0456 - \u043C\u043E\u044F \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F
      - \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u043D\u044F \u043A\u0440\u043E\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824839
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u0414\u043E\u043A, \u044F
      @lp. \u041D\u0435 \u0434\u0443\u0436\u0435-\u0442\u043E \u0446\u0435 \u043C\u0456\u0441\u0446\u0435
      \u0441\u0445\u043E\u0436\u0435 \u043D\u0430 \u043A\u043B\u0456\u043D\u0456\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824840
    m_Localized: "\u0426\u0435 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435,
      \u0449\u043E \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0442\u0443\u0442. \u0429\u043E\u0439\u043D\u043E \u0442\u0435\u0431\u0435
      \u043F\u0456\u0434\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C \u0440\u0435\u0439\u0434\u0435\u0440
      \u0430\u0431\u043E \u0432\u043A\u0443\u0441\u0438\u0442\u044C \u0434\u0438\u043A\u0438\u0439
      \u0433\u0443\u043B\u044C - \u0430 \u0446\u0435 \u0440\u0430\u043D\u043E \u0447\u0438
      \u043F\u0456\u0437\u043D\u043E \u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F
      - \u0442\u043E\u0431\u0456 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F, \u043E\u043A\u0440\u0456\u043C
      \u044F\u043A \u043F\u0440\u0438\u0439\u0442\u0438 \u0434\u043E \u043C\u0435\u043D\u0435.
      \u0406 \u0432\u0436\u0435 \u043F\u043E\u0432\u0456\u0440, \u0443 \u0446\u0435\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448
      \u0433\u0456\u0434\u043D\u043E \u043E\u0446\u0456\u043D\u0438\u0442\u0438 \u0446\u0435
      \u043C\u0456\u0441\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824841
    m_Localized: "\u0427\u043E\u043C\u0443 \u0431 \u043C\u0435\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
      \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043C \u0437\u0456\u043B\u043B\u044F\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824842
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2737824843
    m_Localized: "\u0422\u0438 \u043D\u0435 \u0441\u0438\u043B\u044C\u043D\u0430
      \u0432 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0456, \u0432\u0456\u0440\u043D\u043E?
      \"\u041B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456 \u0437\u0456\u043B\u043B\u044F\",
      \u044F\u043A \u0442\u0438 \u0457\u0445 \u043D\u0430\u0437\u0432\u0430\u043B\u0430
      - \u0446\u0435 \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0436
      \u0441\u0438\u043B\u044C\u043D\u0456 \u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438\u0432\u043D\u0456
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438. \u042F\u043A\u0449\u043E
      \u0442\u0438 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0448 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0443
      \u0442\u0440\u0430\u0432\u043C\u0443, \u043F\u0440\u0438\u043F\u0443\u0441\u0442\u0456\u043C\u043E,
      \u043F\u0435\u0440\u0435\u043B\u043E\u043C \u0430\u0431\u043E \u0441\u0442\u0440\u0443\u0441
      \u043C\u043E\u0437\u043A\u0443, \u0442\u0432\u0456\u0439 \u0454\u0434\u0438\u043D\u0438\u0439
      \u0448\u0430\u043D\u0441 \u043E\u0434\u0443\u0436\u0430\u0442\u0438 - \u0434\u043E\u0431\u0440\u0438\u0439
      \u043B\u0456\u043A\u0430\u0440, \u044F\u043A\u0438\u0439 \u0432\u043E\u043B\u043E\u0434\u0456\u0454
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u043C\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0456 \u043B\u0456\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824844
    m_Localized: "\u042F\u043A\u0456-\u0442\u0430\u043A\u0456 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824845
    m_Localized: "\u0420\u0435\u043F\u0430\u0440\u0430\u0442\u0438\u0432\u043D\u0456.
      \u0423 \u0441\u0435\u043D\u0441\u0456, \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0443\u0432\u0430\u043B\u044C\u043D\u0456.
      \u041A\u043E\u0440\u043E\u0442\u0448\u0435 - \u0442\u0432\u043E\u0454 \u0442\u0456\u043B\u043E
      \u0432\u0435\u0441\u044C \u0447\u0430\u0441 \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438\u0441\u044F \u0434\u043E
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u0443,
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0432\u0438\u043B\u0456\u043A\u043E\u0432\u0443\u044E\u0447\u0438
      \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456 \u043F\u043E\u0440\u0456\u0437\u0438,
      \u0437\u0430\u0431\u043E\u0457 \u0442\u0430 \u0456\u043D\u0448\u0435, \u0456
      \u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438\u0432\u043D\u0456 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438
      \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u044E\u0442\u044C \u0446\u0435\u0439
      \u043F\u0440\u043E\u0446\u0435\u0441 \u0443 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u0430\u0437\u0456\u0432. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E
      \u0442\u043E\u0431\u0456 \u0437\u0430\u0432\u0434\u0430\u043D\u043E \u0442\u0440\u0430\u0432\u043C\u0443,
      \u0437 \u044F\u043A\u043E\u044E \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C
      \u043D\u0435 \u0437\u043C\u043E\u0436\u0435 \u0432\u043F\u043E\u0440\u0430\u0442\u0438\u0441\u044F
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E, \u0442\u043E\u0431\u0456
      \u0442\u0432\u043E\u0457 \u0437\u0456\u043B\u043B\u044F \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0456\u044F\u043A \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824846
    m_Localized: "\u042F \u0431\u0430\u0447\u0443, \u0443 \u0442\u0435\u0431\u0435
      \u0454 \u041F\u0456\u043F\u0411\u0430\u043A? \u0423 \u0446\u044C\u043E\u043C\u0443
      \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
      \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0439 \u043C\u043E\u0434\u0443\u043B\u044C,
      \u0449\u043E \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0454 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430. \u0417\u0432\u0456\u0441\u043D\u043E,
      \u043A\u0456\u0441\u0442\u043A\u0443, \u0449\u043E \u0441\u0442\u0438\u0440\u0447\u0438\u0442\u044C,
      \u0430\u0431\u043E \u0433\u043B\u0438\u0431\u043E\u043A\u0438\u0439 \u043F\u043E\u0440\u0456\u0437
      \u0442\u0438 \u0437\u0434\u0430\u0442\u043D\u0430 \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u0438
      \u0439 \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E, \u0430\u043B\u0435
      \u0441\u043F\u0440\u0430\u0432\u043D\u0438\u0439 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u0432\u0430\u0442\u0438 \u0432\u0441\u0456
      \u043F\u0440\u043E\u0446\u0435\u0441\u0438 \u0432 \u0442\u0432\u043E\u0454\u043C\u0443
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0456 \u0442\u0430 \u043F\u043E\u0440\u0456\u0432\u043D\u044E\u0432\u0430\u0442\u0438
      \u0457\u0445 \u0456\u0437 \u043D\u043E\u0440\u043C\u043E\u044E. \u0422\u043E\u0431\u0442\u043E
      \u0432\u0456\u043D \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u044C, \u0449\u043E
      \u0437 \u0442\u043E\u0431\u043E\u044E \u0449\u043E\u0441\u044C \u043D\u0435
      \u0442\u0430\u043A, \u043D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E
      \u0442\u0438 \u0441\u0430\u043C\u0430 \u043F\u043E\u0447\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0448\u0441\u044F
      \u0447\u0443\u0434\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824847
    m_Localized: "\u0410\u0433\u0430. \u0412\u0456\u043D \u0443 \u0442\u0435\u0431\u0435
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0432\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u0438\u0439.
      \u0421\u0435\u043A\u0443\u043D\u0434\u043E\u0447\u043A\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824848
    m_Localized: "\u041C\u0435\u0434\u0438\u0447\u043D\u0438\u0439 \u043C\u043E\u0434\u0443\u043B\u044C
      \u0442\u0435\u043F\u0435\u0440 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439
      \u0443 \u041F\u0456\u043F\u0411\u0430\u0446\u0456. \u0412\u043A\u043B\u0430\u0434\u043A\u0430
      [\u0421\u0442\u0430\u0442\u0443\u0441]-[\u0417\u0434\u043E\u0440\u043E\u0432'\u044F]"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824849
    m_Localized: "\u0423\u0441\u0435, \u0433\u043E\u0442\u043E\u0432\u043E! \u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044C
      \u043F\u043E\u0441\u043B\u0443\u0433\u0438 - \u0441\u0442\u043E \u043A\u0440\u0438\u0448\u043E\u043A.
      \u0416\u0430\u0440\u0442\u0443\u044E, \u044F \u0437\u0430 \u0442\u0430\u043A\u0435
      \u0433\u0440\u043E\u0448\u0456 \u043D\u0435 \u0431\u0435\u0440\u0443. \u0410\u043B\u0435
      \u043F\u0440\u043E \u0432\u0441\u044F\u043A \u0432\u0438\u043F\u0430\u0434\u043E\u043A
      \u043E\u0441\u044C, \u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0441\u044F
      \u0437 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044E \u043F\u043E\u0441\u043B\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824850
    m_Localized: "\u041E\u0434\u043D\u0430\u043A, \u0446\u0456\u043D\u0438 \u0443
      \u0442\u0435\u0431\u0435 \u043D\u0435\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824851
    m_Localized: "\u0412\u043E\u043D\u0438 \u0439 \u043D\u0435 \u0431\u0443\u0434\u0443\u0442\u044C
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C\u0438. \u042F\u043A\u0449\u043E
      \u0442\u0438 \u0434\u0443\u043C\u0430\u0454\u0448, \u0449\u043E \u043C\u0435\u0434\u0438\u0447\u043D\u0456
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0438 - \u0446\u0435 \u0434\u0435\u0448\u0435\u0432\u0435
      \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F, \u0442\u043E
      \u044F \u0442\u0435\u0431\u0435 \u0440\u043E\u0437\u0447\u0430\u0440\u0443\u044E.
      \u041C\u0430\u0439\u0436\u0435 \u0432\u0441\u0456 \u0433\u0440\u043E\u0448\u0456,
      \u0449\u043E \u044F \u0437\u0430\u0440\u043E\u0431\u043B\u044F\u044E, \u0439\u0434\u0443\u0442\u044C
      \u043D\u0430 \u0437\u0430\u043A\u0443\u043F\u0456\u0432\u043B\u044E \u043D\u043E\u0432\u0438\u0445
      \u043B\u0456\u043A\u0456\u0432 \u0456 \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F,
      \u0441\u043E\u0431\u0456 \u044F \u0437\u0430\u043B\u0438\u0448\u0430\u044E
      \u043B\u0438\u0448\u0435 \u043C\u0456\u0437\u0435\u0440\u043D\u0443 \u0447\u0430\u0441\u0442\u0438\u043D\u0443.
      \u0406 \u044F\u043A\u0449\u043E \u043C\u043E\u044F \u043A\u043B\u0456\u043D\u0456\u043A\u0430
      \u043F\u0440\u043E\u0433\u043E\u0440\u0438\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0442\u0435, \u0449\u043E \u044F \u0442\u0440\u0438\u043C\u0430\u0432 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u043D\u0438\u0437\u044C\u043A\u0456 \u0446\u0456\u043D\u0438, \u0432\u0433\u0430\u0434\u0430\u0439,
      \u0445\u0442\u043E \u0432\u0456\u0434 \u0446\u044C\u043E\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u0454
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824852
    m_Localized: "\u0410\u043B\u0435 \u044F \u043D\u0435 \u0437\u0432\u0456\u0440
      \u044F\u043A\u0438\u0439\u0441\u044C. \u042F\u043A\u0449\u043E \u0442\u0438
      \u0431\u0443\u0434\u0435\u0448 \u043F\u043E\u043C\u0438\u0440\u0430\u0442\u0438,
      \u0430 \u0443 \u0442\u0432\u043E\u0457\u0439 \u043A\u0438\u0448\u0435\u043D\u0456
      \u043D\u0435 \u0431\u0443\u0434\u0435 \u043D\u0456 \u043A\u0440\u0438\u0448\u0435\u0447\u043A\u0438,
      \u044F \u043C\u043E\u0436\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0442\u043E\u0431\u0456 \u0456 \u0431\u0435\u0437\u043F\u043B\u0430\u0442\u043D\u043E.
      \u0410\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443.
      \u041D\u0435 \u0432\u0430\u0440\u0442\u043E \u0437\u043B\u043E\u0432\u0436\u0438\u0432\u0430\u0442\u0438
      \u0447\u0443\u0436\u043E\u044E \u0434\u043E\u0431\u0440\u043E\u0442\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824853
    m_Localized: "@lp, \u043F\u0456\u0434\u0456\u0439\u0434\u0438 \u0441\u044E\u0434\u0438,
      \u0454 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044F. \u041E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0442\u0438 \u0454 \u043C\u043E\u0457\u043C \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u043C
      \u043A\u043B\u0456\u0454\u043D\u0442\u043E\u043C, \u044F \u043C\u0430\u0432
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u0441\u0444\u043E\u0440\u043C\u0443\u0432\u0430\u0442\u0438 \u0443\u044F\u0432\u043B\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0442\u0432\u043E\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0443.
      \u0406 \u0442\u043E\u0432\u0449\u0438\u043D\u0443 \u0442\u0432\u043E\u0433\u043E
      \u0433\u0430\u043C\u0430\u043D\u0446\u044F. \u0422\u043E\u043C\u0443 \u044F
      \u0432\u0432\u0430\u0436\u0430\u044E \u0437\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u0435
      \u0437\u0430\u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0442\u043E\u0431\u0456 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456 \u043F\u043E\u0441\u043B\u0443\u0433\u0438
      \u043A\u043B\u0456\u043D\u0456\u043A\u0438: \u043A\u0456\u0431\u0435\u0440\u043D\u0435\u0442\u0438\u0447\u043D\u0456
      \u0456\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824854
    m_Localized: "\u0429\u043E? \u0410\u043B\u0435 \u044F \u0437\u043E\u0432\u0441\u0456\u043C
      \u043D\u0435 \u0445\u043E\u0447\u0443 \u0441\u0442\u0430\u0432\u0430\u0442\u0438
      \u043A\u0456\u0431\u043E\u0440\u0433\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824855
    m_Localized: "\u042F\u043A\u0449\u043E \u0442\u0438 \u0443\u044F\u0432\u043B\u044F\u0454\u0448
      \u0446\u0435 \u044F\u043A \u0437\u0430\u043B\u0456\u0437\u043D\u0456 \u043A\u043E\u043F\u0438\u0442\u0430
      \u0439 \u043E\u0447\u0456 \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0445,
      \u0442\u043E \u043D\u0456, \u044F \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044F
      \u0432\u0456\u0434\u043F\u0438\u043B\u044E\u0432\u0430\u0442\u0438 \u0442\u043E\u0431\u0456
      \u043D\u043E\u0433\u0443, \u0449\u043E\u0431 \u043F\u0440\u0438\u0447\u0435\u043F\u0438\u0442\u0438
      \u043D\u0430 \u0457\u0457 \u043C\u0456\u0441\u0446\u0435 \u043A\u0456\u0431\u0435\u0440\u0431\u043E\u043B\u0432\u0430\u043D\u043A\u0443.
      \u041C\u043E\u0457 \u0456\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442\u0438
      \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u0456 \u0439 \u043D\u0435
      \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u044F\u044E\u0442\u044C \u0436\u043E\u0434\u043D\u0438\u0445
      \u0432\u0442\u0440\u0430\u0442 \u0443 \u0440\u0443\u0445\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u0430\u0431\u043E \u0447\u0443\u0442\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u043A\u043B\u0456\u0454\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824856
    m_Localized: "\u041F\u0440\u0438\u043F\u0443\u0441\u0442\u0438\u043C\u043E, \u044F
      \u043F\u043E\u0433\u043E\u0434\u0436\u0443\u0441\u044F. \u0429\u043E \u0432\u0456\u0434
      \u043C\u0435\u043D\u0435 \u0431\u0443\u0434\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824857
    m_Localized: "\u0422\u0456\u043B\u044C\u043A\u0438 \u0433\u0440\u043E\u0448\u0456.
      \u041E\u043F\u043B\u0430\u0447\u0443\u0454\u0448 \u0456\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442,
      \u044F \u0432\u0432\u043E\u0434\u0436\u0443 \u0442\u0435\u0431\u0435 \u0432
      \u0441\u0442\u0430\u043D \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043D\u0430\u0440\u043A\u043E\u0437\u0443 \u0456 \u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443
      \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u044E. \u0422\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043F\u043B\u044E\u0449\u0438\u0448 \u043E\u0447\u0456 \u0456
      \u0432\u0456\u0434\u043A\u0440\u0438\u0454\u0448 \u0437 \u0443\u0436\u0435
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u043C \u0456\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0442\u043E\u043C
      \u0456 \u043D\u043E\u0432\u0438\u043C\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824858
    m_Localized: "\u0410 \u043D\u0435 \u0437\u0430\u0440\u0456\u0436\u0435\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824859
    m_Localized: "\u042F \u043D\u0435 \u043F\u0440\u0438\u043F\u0443\u0441\u043A\u0430\u044E\u0441\u044F
      \u043F\u043E\u043C\u0438\u043B\u043E\u043A \u0443 \u0441\u0432\u043E\u0457\u0439
      \u0440\u043E\u0431\u043E\u0442\u0456, \u0456\u043D\u0430\u043A\u0448\u0435
      \u043D\u0435 \u0431\u0443\u0432 \u0431\u0438 \u0442\u0443\u0442. \u0410 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E
      \u044F \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0432\u0431\u0438\u0432\u0430\u0442\u0438\u043C\u0443
      \u043A\u0443\u0440\u043A\u0443, \u0449\u043E \u043D\u0435\u0441\u0435 \u043C\u0435\u043D\u0456
      \u0437\u043E\u043B\u043E\u0442\u0456 \u044F\u0439\u0446\u044F. \u041C\u043E\u0436\u0435\u0448
      \u0432\u0442\u0438\u0445\u043E\u043C\u0438\u0440\u0438\u0442\u0438 \u0441\u0432\u043E\u044E
      \u043F\u0430\u0440\u0430\u043D\u043E\u044E. \u0414\u043E \u0440\u0435\u0447\u0456,
      \u043F\u043E\u0441\u043B\u0443\u0433\u0438 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0430
      \u044F \u0442\u0435\u0436 \u043D\u0430\u0434\u0430\u044E, \u0437\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824860
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432! \u0420\u0430\u0434\u0430
      \u0431\u0430\u0447\u0438\u0442\u0438 \u0432 \u043C\u043E\u0457\u0439 \u0441\u043A\u0440\u043E\u043C\u043D\u0456\u0439
      \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u0456. \u042F \u0412\u0456\u043D\u0440\u0456,
      \u0430 \u0442\u0435\u0431\u0435 \u044F\u043A \u0437\u0432\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824861
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u0412\u0456\u043D\u0440\u0456,
      \u044F @lp. \u0427\u0438\u043C \u0436\u0435 \u0442\u0438 \u0442\u0443\u0442
      \u0437\u0430\u0439\u043C\u0430\u0454\u0448\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824862
    m_Localized: "\u0423\u0441\u0456\u043C \u043F\u043E\u0442\u0440\u043E\u0445\u0443.
      \u0420\u0435\u043C\u043E\u043D\u0442\u0443\u044E \u0437\u0431\u0440\u043E\u044E,
      \u043F\u0440\u0430\u0441\u043A\u0438, \u0442\u043E\u0441\u0442\u0435\u0440\u0438,
      \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u044E \u043D\u0430 \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0438
      \u0441\u0442\u0430\u0440\u0438\u0439 \u043C\u043E\u0442\u043B\u043E\u0445.
      \u0423 \u043C\u0435\u043D\u0435 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0441\u0432\u043E\u0454
      \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F, \u043A\u0443\u043F\u0438\u0442\u0438
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0434\u0435\u0442\u0430\u043B\u0456,
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438 \u0442\u0430
      \u0432\u0441\u044F\u043A\u0456 \u043A\u043E\u0440\u0438\u0441\u043D\u0456 \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824863
    m_Localized: "\u0422\u0430\u043A\u043E\u0436 \u044F \u0437\u0430\u0439\u043C\u0430\u044E\u0441\u044F
      \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044F\u043C
      \u0456 \u043F\u0440\u043E\u0434\u0430\u0436\u0435\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u041D\u0443, \u0437\u043D\u0430\u0454\u0448
      - \u0443\u0441\u044C\u043E\u0433\u043E, \u0447\u0438\u043C \u043C\u043E\u0436\u043D\u0430
      \u0431\u0438\u0442\u0438, \u0440\u0456\u0437\u0430\u0442\u0438 \u0439 \u043A\u043E\u043B\u043E\u0442\u0438,
      \u0432\u0456\u0434 \u043D\u043E\u0436\u0430 \u0434\u043E \u043A\u0443\u0432\u0430\u043B\u0434\u0438.
      \u0412\u043E\u043D\u0430, \u043D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u0457
      \u0447\u0438 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457,
      \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432,
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u044C
      \u0456 \u043D\u0435 \u0434\u0430\u0441\u0442\u044C \u043E\u0441\u0456\u0447\u043A\u0443.
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u043C\u0456\u0442\u0438 \u043D\u0435\u044E \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824864
    m_Localized: "\u0410 \u044F \u043C\u043E\u0436\u0443 \u043D\u0430\u0432\u0447\u0438\u0442\u0438\u0441\u044F
      \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044F\u0442\u0438 \u0437\u0431\u0440\u043E\u044E
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824865
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E. \u0414\u043B\u044F \u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u0442\u043E\u0431\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0441\u0445\u0435\u043C\u0430. \u042F\u043A\u0449\u043E \u0442\u0438 \u043D\u0435
      \u0432\u043C\u0456\u0454\u0448 \u0432\u0438\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438
      \u0440\u0435\u0447\u0456 \u043F\u0440\u043E\u0441\u0442\u043E \u0432 \u0433\u043E\u043B\u043E\u0432\u0456,
      \u0437\u0432\u0456\u0441\u043D\u043E. \u0421\u0445\u0435\u043C\u0438 \u043C\u043E\u0436\u043D\u0430
      \u043A\u0443\u043F\u0438\u0442\u0438 \u0432 \u043C\u0430\u0439\u0441\u0442\u0440\u0456\u0432,
      \u0430 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0443\u0434\u0430\u0447\u0443 \u0456 \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438
      \u0432 \u0440\u0456\u0437\u043D\u0438\u0445 \u043C\u0456\u0441\u0446\u044F\u0445
      \u043D\u0430 \u041F\u0443\u0441\u0442\u0446\u0456 - \u0443 \u0437\u0430\u043D\u0435\u0434\u0431\u0430\u043D\u0438\u0445
      \u0431\u0443\u0434\u0456\u0432\u043B\u044F\u0445, \u0443 \u0441\u0435\u0439\u0444\u0430\u0445,
      \u043F\u0438\u0441\u044C\u043C\u043E\u0432\u0438\u0445 \u0441\u0442\u043E\u043B\u0430\u0445
      \u0430\u0431\u043E \u043A\u043D\u0438\u0436\u043A\u043E\u0432\u0438\u0445 \u0448\u0430\u0444\u0430\u0445.
      \u042F\u043A\u0449\u043E \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u0432
      \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u0456 \u0431\u0443\u043B\u043E
      \u0441\u0443\u0445\u0435, \u0430 \u043F\u0430\u043F\u0456\u0440 \u0433\u0430\u0440\u043D\u0438\u0439,
      \u043C\u043E\u0436\u0435, \u0432\u0456\u043D \u0456 \u043D\u0435 \u0440\u043E\u0437\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432 \u0442\u0435\u0431\u0435 \u0432
      \u043A\u043E\u043F\u0438\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824866
    m_Localized: "\u041F\u043E\u0442\u0456\u043C, \u044F\u043A\u0449\u043E \u0443
      \u0442\u0435\u0431\u0435 \u0454 \u0432\u0441\u0456 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456
      \u0434\u0435\u0442\u0430\u043B\u0456 \u0456 \u043A\u043E\u043F\u0438\u0442\u0430
      \u043D\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456,
      \u0437\u0431\u0440\u043E\u044E \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u0434\u0435
      \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u043D\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u0442\u0456,
      \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442 \u0442\u043E\u0433\u043E,
      \u0449\u043E \u0441\u0442\u043E\u0457\u0442\u044C \u0443 \u043C\u043E\u0457\u0439
      \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824867
    m_Localized: "\u042F\u043A\u0449\u043E \u0434\u043E\u0431\u0440\u0435 \u043D\u0430\u0442\u0440\u0435\u043D\u0443\u0454\u0448\u0441\u044F,
      \u0442\u043E \u0437\u043C\u043E\u0436\u0435\u0448 \u043C\u0430\u0439\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438
      \u0437\u0430\u043B\u0456\u0437\u044F\u043A\u0438 \u043D\u0435 \u0433\u0456\u0440\u0448\u0456
      \u0437\u0430 \u0442\u0456, \u0449\u043E \u0440\u0430\u043D\u0456\u0448\u0435
      \u0440\u043E\u0431\u0438\u043B\u0438 \u043D\u0430 \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445
      \u0437\u0430\u0432\u043E\u0434\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824868
    m_Localized: "\u0423 \u0442\u0435\u0431\u0435 \u0432\u0438\u0439\u0448\u043B\u043E
      \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0410\u0432\u0442\u043E\u0414\u043E\u043A\u0430? \u041F\u043E\u0432\u0430\u0436\u0430\u044E!
      \u041C\u0435\u043D\u0456 \u0446\u0435 \u0442\u0430\u043A \u0456 \u043D\u0435
      \u0432\u0434\u0430\u043B\u043E\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824869
    m_Localized: "\u0410, \u043E\u0441\u044C \u0456 \u0442\u0438. \u042F \u0447\u0435\u043A\u0430\u043B\u0430
      \u043D\u0430 \u0442\u0435\u0431\u0435, @lp!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824870
    m_Localized: "\u041D\u0443 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E \u0447\u0435\u043A\u0430\u043B\u0430.
      \u042F\u043A \u0436\u0435 \u044F \u043C\u043E\u0433\u043B\u0430 \u0441\u044E\u0434\u0438
      \u043D\u0435 \u0437\u0430\u0439\u0442\u0438? \u0426\u0435 \u0431\u0443\u043B\u043E
      \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u043D\u0430\u043F\u0435\u0440\u0435\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824871
    m_Localized: "\u0415-\u0435-\u0435... \u0406 \u0442\u0438 \u043D\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u0454\u0448,
      \u0437\u0432\u0456\u0434\u043A\u0438 \u044F \u0437\u043D\u0430\u044E \u0442\u0432\u043E\u0454
      \u0456\u043C'\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824872
    m_Localized: "\u041D\u0456, \u044F \u0436 \u0442\u0435\u0436 \u0437\u043D\u0430\u044E
      \u0442\u0432\u043E\u0454 \u0456\u043C'\u044F, \u0414\u0430\u0441\u0442\u0456
      \u041D\u0435\u0431\u0443\u043B\u0430. \u0412\u043E\u043D\u043E, \u043C\u043E\u0436\u043D\u0430
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0442\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824873
    m_Localized: "\u0422\u043E\u0434\u0456 \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E.
      \u0422\u0438 \u0442\u0435\u0436 \u0432\u043E\u043B\u043E\u0434\u0456\u0454\u0448
      \u0446\u0438\u043C \u0434\u0430\u0440\u043E\u043C - \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0442\u0438
      \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454 \u0456 \u0434\u0456\u0437\u043D\u0430\u0432\u0430\u0442\u0438\u0441\u044F
      \u0456\u043C\u0435\u043D\u0430 \u0456\u043D\u0448\u0438\u0445 \u043F\u043E\u043D\u0456
      \u0449\u0435 \u0434\u043E \u0442\u043E\u0433\u043E, \u044F\u043A \u0437 \u043D\u0438\u043C\u0438
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0448. \u0426\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043F\u0440\u043E \u0442\u0435, \u0449\u043E \u0432 \u0442\u0435\u0431\u0435
      \u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824874
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430? \u0410\u043B\u0435 \u0434\u043E\u0441\u0456
      \u0432 \u043C\u0435\u043D\u0435 \u043D\u0435 \u0432\u0438\u0445\u043E\u0434\u0438\u043B\u0438
      \u0436\u043E\u0434\u043D\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u043A\u0440\u0456\u043C \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u0443.
      \u042F \u0437\u0430\u0432\u0436\u0434\u0438 \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0449\u043E \u043C\u0430\u0433\u0456\u044F - \u0446\u0435 \u043D\u0435 \u043C\u043E\u0454..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824875
    m_Localized: "\u0417\u043E\u0432\u0441\u0456\u043C \u043D\u0456. \u042F\u043A\u0449\u043E
      \u0445\u043E\u0447\u0435\u0448 \u0441\u0442\u0430\u0442\u0438 \u043C\u0430\u0433\u043E\u043C,
      \u044F \u043C\u043E\u0436\u0443 \u0442\u043E\u0431\u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0456 \u043D\u0430\u0432\u0447\u0438\u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0433\u043E
      \u0447\u0430\u043A\u043B\u0443\u043D\u0441\u0442\u0432\u0430. \u0410\u043B\u0435
      \u0447\u0430\u0440\u043E\u0434\u0456\u0439\u0441\u044C\u043A\u0443 \u0441\u0438\u043B\u0443
      \u0442\u0438 \u043C\u0430\u0454\u0448 \u0440\u043E\u0437\u0432\u0438\u043D\u0443\u0442\u0438
      \u0441\u0430\u043C\u0430, \u0442\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0448
      \u043E\u0432\u043E\u043B\u043E\u0434\u0456\u0442\u0438 \u0446\u0438\u043C \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043E\u043C,
      \u043F\u043E\u043A\u0438 \u043D\u0435 \u043D\u0430\u0432\u0447\u0438\u0448\u0441\u044F
      \u0447\u0435\u0440\u043F\u0430\u0442\u0438 \u043C\u0430\u0433\u0456\u044E \u0456\u0437
      \u0441\u0430\u043C\u043E\u0457 \u0441\u0435\u0431\u0435. \u0417\u0430\u0433\u043B\u044F\u0434\u0430\u0439
      \u0434\u043E \u043C\u0435\u043D\u0435 \u0447\u0430\u0441 \u0432\u0456\u0434
      \u0447\u0430\u0441\u0443. \u042F \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u0442\u0438\u043C\u0443
      \u0437\u043C\u0456\u043D\u0438 \u0442\u0432\u043E\u0433\u043E \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B\u0443
      \u0456 \u0437\u043C\u043E\u0436\u0443 \u043D\u0430\u0432\u0447\u0438\u0442\u0438
      \u043D\u043E\u0432\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824876
    m_Localized: "\u0429\u043E \u0449\u0435 \u0442\u0438 \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0454\u0448,
      \u043A\u0440\u0456\u043C \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824877
    m_Localized: "\u0414\u043E \u043C\u043E\u0433\u043E \u043A\u0440\u0443\u0433\u043E\u0437\u043E\u0440\u0443
      \u0432\u0445\u043E\u0434\u044F\u0442\u044C \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u043F\u0456\u0437\u043D\u0430\u043D\u043D\u044F.
      \u042F\u043A\u0449\u043E \u0442\u0438 \u0432\u043E\u043B\u043E\u0434\u0456\u0454\u0448
      \u043D\u0430\u043B\u0435\u0436\u043D\u0438\u043C \u0442\u0435\u0440\u043F\u0456\u043D\u043D\u044F\u043C
      \u0456 \u0443\u0432\u0430\u0436\u043D\u0456\u0441\u0442\u044E, \u044F \u043C\u043E\u0436\u0443
      \u043D\u0430\u0432\u0447\u0438\u0442\u0438 \u0442\u0435\u0431\u0435 \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u0443
      \u0430\u043B\u0445\u0456\u043C\u0456\u0457. \u0422\u0430\u043A\u043E\u0436
      \u044F \u043C\u043E\u0436\u0443 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
      \u0440\u0435\u0446\u0435\u043F\u0442\u0430\u043C\u0438, \u0447\u0430\u0440\u0456\u0432\u043D\u0438\u043C\u0438
      \u0442\u0440\u0430\u0432\u0430\u043C\u0438 \u0456 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438\u043C
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F\u043C. \u0406
      \u0449\u0435... \u0442\u043E\u0431\u0456 \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F
      \u043C\u043E\u044F \u043C\u0430\u0433\u0456\u0447\u043D\u0430 \u043A\u0443\u043B\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824878
    m_Localized: "\u041E \u0442\u0430\u043A, \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430
      \u043A\u0443\u043B\u044F \u0437 \u0442\u0438\u0445, \u0449\u043E \u044F \u0431\u0430\u0447\u0438\u043B\u0430.
      \u0412\u043E\u043D\u0430 \u043F\u0440\u043E\u0440\u043E\u043A\u0443\u0454 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824879
    m_Localized: "\u0426\u0435 \u0432\u043E\u043D\u0430 \u0442\u0435\u0436 \u043C\u043E\u0436\u0435.
      \u0410\u043B\u0435 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u043D\u0435\u044E
      \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043B\u044F
      \u0456\u043D\u0448\u043E\u0457 \u043C\u0435\u0442\u0438 - \u0449\u043E\u0431
      \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0441\u0432\u043E\u044E \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0441\u0442\u044C.
      \u041D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0441\u044F, \u0446\u0435
      \u043B\u0438\u0448\u0435 \u0456\u043B\u044E\u0437\u0456\u044F, \u0432\u0438\u0434\u0438\u043C\u0430
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u043E\u0431\u0456, \u043D\u0430\u0432\u0456\u044E\u0432\u0430\u043D\u043D\u044F,
      \u044F\u043A\u0449\u043E \u043C\u043E\u0436\u043D\u0430 \u0442\u0430\u043A
      \u0432\u0438\u0441\u043B\u043E\u0432\u0438\u0442\u0438\u0441\u044F. \u0422\u0432\u043E\u0457
      \u0437\u043D\u0430\u0439\u043E\u043C\u0456 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043F\u043E\u043C\u0456\u0442\u044F\u0442\u044C
      \u0456 \u0432\u043F\u0456\u0437\u043D\u0430\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0442\u0435\u0431\u0435, \u044F\u043A \u0456 \u0440\u0430\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824880
    m_Localized: "\u0417\u0434\u0440\u0430\u0441\u0442\u0443\u0439, \u0434\u043E\u0440\u043E\u0433\u0435\u043D\u044C\u043A\u0430!
      \u0422\u0438 \u0442\u0443\u0442 \u0443\u043F\u0435\u0440\u0448\u0435, \u0447\u0438
      \u043D\u0435 \u0442\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824881
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u043D\u044F,
      \u043C\u0456\u0441\u0456\u0441. \u0412\u0456\u0440\u043D\u043E, \u044F \u0449\u043E\u0439\u043D\u043E
      \u043F\u0440\u0438\u0431\u0443\u043B\u0430 \u0441\u044E\u0434\u0438. \u041C\u043E\u0454
      \u0456\u043C'\u044F @lp, \u0430 \u0412\u0430\u0448\u0435?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824882
    m_Localized: "\u0425\u043E\u043B\u043B\u0456 \u0428\u0430\u0439\u043D. \u0422\u0430\u043A
      \u043F\u0440\u0438\u0454\u043C\u043D\u043E \u0431\u0430\u0447\u0438\u0442\u0438
      \u043D\u043E\u0432\u0456 \u043E\u0431\u043B\u0438\u0447\u0447\u044F \u0432
      \u043D\u0430\u0448\u043E\u043C\u0443 \u0442\u0430\u0431\u043E\u0440\u0456.
      \u042F \u0442\u0443\u0442 \u0449\u043E\u0441\u044C \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E \u043A\u0443\u0445\u0430\u0440\u044F,
      \u0442\u043E\u0436 \u044F\u043A\u0449\u043E \u0437\u0433\u043E\u043B\u043E\u0434\u043D\u0456\u0454\u0448,
      \u044F \u0437\u0430\u0432\u0436\u0434\u0438 \u0440\u0430\u0434\u0430 \u043D\u0430\u0433\u043E\u0434\u0443\u0432\u0430\u0442\u0438
      \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824883
    m_Localized: "\u041D\u0430\u0432\u0456\u0442\u044C \u0442\u0430\u043A? \u0410
      \u0449\u043E \u0443 \u0412\u0430\u0441 \u0443 \u043C\u0435\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824884
    m_Localized: "\u0422\u0430 \u0432\u0441\u0435 \u0449\u043E \u0454! \u0414\u043E\u0432\u043E\u0454\u043D\u043D\u0456
      \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0438, \u043E\u0432\u043E\u0447\u0456
      \u0442\u0430 \u0444\u0440\u0443\u043A\u0442\u0438 \u0437 \u0444\u0435\u0440\u043C,
      \u043C'\u044F\u0441\u043E, \u043D\u0430\u0432\u0456\u0442\u044C \u0432\u0438\u043F\u0456\u0447\u043A\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824885
    m_Localized: "\u041C'\u044F\u0441\u043E? \u0412\u0438 \u0457\u0441\u0442\u0435
      \u0442\u0443\u0442 \u043C'\u044F\u0441\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824886
    m_Localized: "\u0410 \u0449\u043E \u0442\u0435\u0431\u0435 \u0434\u0438\u0432\u0443\u0454?
      \u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u0449\u043E \u0432\u0441\u0456
      \u043F\u043E\u043D\u0456 \u0457\u0434\u044F\u0442\u044C \u043C'\u044F\u0441\u043E.
      \u0426\u0435, \u0437\u0432\u0456\u0441\u043D\u043E, \u043D\u0435 \u043D\u0430\u0439\u0441\u043C\u0430\u0447\u043D\u0456\u0448\u0430
      \u0440\u0456\u0447, \u0430\u043B\u0435 \u043A\u043E\u043B\u0438 \u0432\u0441\u044C\u043E\u0433\u043E
      \u043C\u0430\u043B\u043E, \u043D\u0430\u0432\u0456\u0442\u044C \u0445\u0432\u0456\u0441\u0442
      \u0441\u0432\u0456\u0439 \u0437\u0436\u0443\u0432\u0430\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u0431\u0443\u0434\u0435\u0448. \u0422\u0438 \u0440\u0430\u043D\u0456\u0448\u0435
      \u0433\u043E\u043B\u043E\u0434\u0443\u0432\u0430\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824887
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430
      \u0412\u0430\u0441. \u0410\u043B\u0435 \u0412\u0438 \u0449\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0449\u043E\u0441\u044C \u043F\u0440\u043E \u0444\u0435\u0440\u043C\u0438.
      \u0423 \u0432\u0430\u0441 \u0442\u0443\u0442 \u0442\u0443\u0442 \u0454 \u0444\u0435\u0440\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824888
    m_Localized: "\u0423 \u043D\u0430\u0441 - \u043D\u0456. \u0410\u043B\u0435 \u0454
      \u043F\u043E\u043D\u0456, \u044F\u043A\u0456 \u0437\u0430\u0439\u043C\u0430\u044E\u0442\u044C\u0441\u044F
      \u0446\u0456\u0454\u044E \u0441\u043F\u0440\u0430\u0432\u043E\u044E. \u0407\u0445
      \u043C\u0430\u043B\u043E, \u0430 \u0437\u0435\u043C\u043B\u0456, \u0434\u0435
      \u043C\u043E\u0436\u043D\u0430 \u0449\u043E\u0441\u044C \u0432\u0438\u0440\u043E\u0449\u0443\u0432\u0430\u0442\u0438,
      \u0449\u0435 \u043C\u0435\u043D\u0448\u0435. \u0422\u043E\u043C\u0443 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438
      \u0437 \u0444\u0435\u0440\u043C\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u043D\u0435\u0434\u0435\u0448\u0435\u0432\u0456. \u0410\u043B\u0435 \u0437\u0430\u0442\u0435
      \u0432\u043E\u043D\u0438 \u0441\u043C\u0430\u0447\u043D\u0456\u0448\u0456 \u0442\u0430
      \u043A\u043E\u0440\u0438\u0441\u043D\u0456\u0448\u0456 \u0437\u0430 \u0432\u0441\u0435!
      \u0423 \u043C\u0435\u043D\u0435 \u0454 \u043E\u0432\u0435\u0441, \u043A\u0430\u0440\u0442\u043E\u043F\u043B\u044F,
      \u043E\u0433\u0456\u0440\u043A\u0438, \u043C\u043E\u043B\u043E\u043A\u043E
      \u0439 \u043C\u0430\u0441\u043B\u043E \u0432\u0456\u0434 \u0444\u0435\u0440\u043C\u0435\u0440\u0441\u044C\u043A\u0438\u0445
      \u0431\u0440\u0430\u043C\u0456\u043D\u0456\u0432, \u0456\u0437 \u0444\u0435\u0440\u043C\u0435\u0440\u0441\u044C\u043A\u043E\u0433\u043E
      \u0437\u0435\u0440\u043D\u0430 \u044F \u043F\u0435\u0447\u0443 \u0445\u043B\u0456\u0431.
      \u0406\u043D\u043E\u0434\u0456 \u0437\u0430\u0432\u043E\u0437\u044F\u0442\u044C
      \u0449\u0435 \u0432\u0441\u044F\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824889
    m_Localized: "\u041E\u0441\u044C \u0446\u0435 \u0432\u0436\u0435 \u0437\u0432\u0443\u0447\u0438\u0442\u044C
      \u0442\u0440\u043E\u0445\u0438 \u043A\u0440\u0430\u0449\u0435! \u042F\u043A\u0449\u043E
      \u0437\u0433\u043E\u043B\u043E\u0434\u043D\u0456\u044E, \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E
      \u043A\u0443\u043F\u043B\u044E \u0443 \u0412\u0430\u0441 \u0447\u043E\u0433\u043E\u0441\u044C
      \u0456\u0437 \u0444\u0435\u0440\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824890
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442. \u0422\u0438 \u0442\u0435\u0436
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824891
    m_Localized: "\u0422\u0430\u043A \u0442\u043E\u0447\u043D\u043E. \u041F\u0438\u0441\u0430\u0440
      \u0410\u043C\u0430\u0440\u0430\u043D\u0442\u0430 \u0456\u0437 \u0437\u0430\u0433\u043E\u043D\u0443
      \u0417\u043E\u0440\u044F\u043D\u043E\u0433\u043E \u041F\u0430\u043B\u0430\u0434\u0438\u043D\u0430
      \u0421\u0442\u0456\u043B\u0425\u0443\u0432\u0437\u0430. \u042F \u0442\u0430\u043A
      \u0432\u0432\u0430\u0436\u0430\u044E, \u0442\u0438 \u0432\u0436\u0435 \u0437\u043D\u0430\u0439\u043E\u043C\u0430
      \u0437 \u043D\u0438\u043C, \u0440\u0430\u0437 \u0442\u043E\u0431\u0456 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0438
      \u0431\u0443\u0442\u0438 \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u044C\u043E\u044E
      \u0442\u0443\u0442, \u0443 \u043D\u0430\u0448\u043E\u043C\u0443 \u0442\u0430\u0431\u043E\u0440\u0456.
      \u041D\u0456\u0447\u043E\u0433\u043E \u0442\u0443\u0442 \u043D\u0435 \u0447\u0456\u043F\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824892
    m_Localized: "\u041F\u0438\u0441\u0430\u0440 - \u0446\u0435 \u0442\u0432\u043E\u0454
      \u0437\u0432\u0430\u043D\u043D\u044F? \u0410\u043B\u0435 \u044F \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0449\u043E \u0432\u0441\u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0456
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438 - \u0437\u0435\u043C\u043D\u043E\u043F\u043E\u043D\u0456
      \u0432 \u0441\u0438\u043B\u043E\u0432\u0456\u0439 \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824893
    m_Localized: "\u0426\u0435 \u043F\u043E\u043C\u0438\u043B\u043A\u043E\u0432\u0430
      \u0434\u0443\u043C\u043A\u0430. \u0404\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0438
      \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0443\u0442\u044C \u0432\u0441\u0442\u0443\u043F\u0430\u0442\u0438
      \u0434\u043E \u043B\u0430\u0432 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, \u0430\u043B\u0435
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0441\u0442\u0430\u044E\u0442\u044C
      \u043F\u0438\u0441\u0430\u0440\u044F\u043C\u0438. \u041D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u043B\u0438\u0446\u0430\u0440\u0456\u0432 \u0456 \u043F\u0430\u043B\u0430\u0434\u0438\u043D\u0456\u0432
      \u043C\u0438 \u0437\u0430\u0439\u043C\u0430\u0454\u043C\u043E\u0441\u044F \u0440\u0456\u0437\u043D\u043E\u044E
      \u043D\u0435\u0431\u043E\u0439\u043E\u0432\u043E\u044E \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044E.
      \u041D\u0430 \u043D\u0430\u0448\u0438\u0445 \u043F\u043B\u0435\u0447\u0430\u0445
      \u043B\u0435\u0436\u0430\u0442\u044C \u0443\u0441\u0456 \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0441\u044C\u043A\u0456
      \u0442\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0439\u043D\u0456
      \u043F\u0438\u0442\u0430\u043D\u043D\u044F, \u0442\u0435\u0445\u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F,
      \u043D\u0430\u0443\u043A\u043E\u0432\u0456 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u0442\u0430 \u0456\u043D\u0448\u0435 \u0432 \u0446\u044C\u043E\u043C\u0443
      \u0440\u043E\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824894
    m_Localized: "\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E, \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u0441\u0438\u043B\u043E\u0432\u043E\u0457 \u0431\u0440\u043E\u043D\u0456 \u043C\u0438
      \u043D\u043E\u0441\u0438\u043C\u043E \u0432\u0431\u0440\u0430\u043D\u043D\u044F
      \u043F\u0438\u0441\u0430\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824895
    m_Localized: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u043F\u043E\u0445\u043E\u0434\u0456
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u044F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u044E
      \u0437\u0430 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043D\u043D\u044F \u0437\u0430\u0433\u043E\u043D\u0443
      \u043F\u0430\u0439\u043A\u0430\u043C\u0438 \u0456 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438,
      \u0437\u0432'\u044F\u0437\u043E\u043A \u0456\u0437 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u0438\u043C
      \u0446\u0435\u043D\u0442\u0440\u043E\u043C, \u0440\u0435\u043C\u043E\u043D\u0442
      \u0437\u0431\u0440\u043E\u0457, \u0431\u0440\u043E\u043D\u0456 \u0442\u0430
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F. \u041E\u0442\u0440\u0443\u0439\u043D\u0435
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430
      \u0434\u0443\u0436\u0435 \u0448\u0432\u0438\u0434\u043A\u043E \u0432\u0438\u0432\u043E\u0434\u0438\u0442\u044C
      \u0437 \u043B\u0430\u0434\u0443 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0443
      \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E, \u0442\u043E\u043C\u0443
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0431\u0430\u0433\u0430\u0442\u043E.
      \u0429\u0435 \u043F\u0438\u0442\u0430\u043D\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824896
    m_Localized: "\u0417\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F, \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F...
      \u041C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043F\u043E\u0442\u043E\u0440\u0433\u0443\u0432\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824897
    m_Localized: "\u0426\u0435 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043D\u043E.
      \u041E\u0441\u043E\u0431\u0438\u0441\u0442\u043E \u044F \u0432\u0432\u0430\u0436\u0430\u044E,
      \u0449\u043E \u0442\u043E\u0440\u0433\u0456\u0432\u043B\u044F \u0437 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438
      \u041F\u0443\u0441\u0442\u043E\u043A \u043D\u0430\u043C \u0443\u0441\u0456\u043C
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824898
    m_Localized: "\u0410 \u044F\u043A \u0449\u043E\u0434\u043E \u0441\u0438\u043B\u043E\u0432\u043E\u0457
      \u0431\u0440\u043E\u043D\u0456? \u0407\u0457 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448
      \u043C\u0435\u043D\u0456 \u043F\u0440\u043E\u0434\u0430\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824899
    m_Localized: "\u0412\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u043E. \u041F\u043E-\u043F\u0435\u0440\u0448\u0435,
      \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E \u043C\u0430\u044E\u0442\u044C
      \u043F\u0440\u0430\u0432\u043E \u043D\u043E\u0441\u0438\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0421\u0442\u0430\u043B\u0435\u0432\u0456 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0438.
      \u041F\u043E-\u0434\u0440\u0443\u0433\u0435, \u0443 \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u043B\u0438\u0446\u0430\u0440\u044F \u0432 \u0437\u0430\u0433\u043E\u043D\u0456
      \u0454 \u0442\u0456\u043B\u044C\u043A\u0438 \u0439\u043E\u0433\u043E \u0432\u043B\u0430\u0441\u043D\u0438\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0431\u0440\u043E\u043D\u0456,
      \u0437\u0430\u0439\u0432\u0438\u0445 \u043D\u0435\u043C\u0430\u0454. \u0406
      \u043F\u043E-\u0442\u0440\u0435\u0442\u0454, \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0443
      \u0431\u0440\u043E\u043D\u044F \u043B\u0438\u0446\u0430\u0440\u044F \u0432\u0441\u0435
      \u043E\u0434\u043D\u043E \u043D\u0435 \u043F\u0456\u0434\u0456\u0439\u0448\u043B\u0430
      \u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824900
    m_Localized: "\u0410\u043B\u0435 \u044F \u043C\u043E\u0436\u0443 \u043F\u0440\u043E\u0434\u0430\u0442\u0438
      \u0442\u043E\u0431\u0456 \u0434\u0435\u044F\u043A\u0443 \u0437\u0431\u0440\u043E\u044E
      \u0456 \u043D\u0430\u0434\u043B\u0438\u0448\u043A\u0438 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
      \u0442\u0432\u043E\u0454 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F,
      \u044F\u043A\u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824901
    m_Localized: "\u0406\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430 \u0431\u043E\u043C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824902
    m_Localized: "\u041D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043A\u0430\u0436\u0438.
      \u042F \u0447\u0443\u043B\u0430 \u0432\u0430\u0448\u0443 \u0440\u043E\u0437\u043C\u043E\u0432\u0443
      \u0437 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u043E\u043C. \u0422\u0438
      \u0445\u043E\u0447\u0435\u0448 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0432 \u0431\u0443\u043D\u043A\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824903
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0434\u043E \u0432\u0456\u0434\u043E\u043C\u0430:
      \u044F \u043D\u0435 \u0441\u0445\u0432\u0430\u043B\u044E\u044E. \u041D\u0435\u043C\u0430
      \u0447\u043E\u0433\u043E \u0442\u043E\u0431\u0456 \u0442\u0430\u043C \u0440\u043E\u0431\u0438\u0442\u0438,
      \u043D\u0435\u0433\u043E\u0436\u0435 \u043A\u043E\u043C\u0443\u0441\u044C \u043D\u0430
      \u043A\u0448\u0442\u0430\u043B\u0442 \u0442\u0435\u0431\u0435 \u0432\u0431\u0438\u0432\u0430\u0442\u0438
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \u0456 \u0440\u043E\u0437\u0442\u044F\u0433\u0443\u0432\u0430\u0442\u0438
      \u0437 \u0442\u0430\u043A\u0438\u043C\u0438 \u0437\u0443\u0441\u0438\u043B\u043B\u044F\u043C\u0438
      \u0437\u0456\u0431\u0440\u0430\u043D\u0456 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824904
    m_Localized: "\u0410\u043B\u0435 \u0437\u0430\u0440\u0430\u0437 \u0432\u043E\u043D\u0438
      \u0432 \u043A\u043E\u043F\u0438\u0442\u0430\u0445 \u043D\u0430\u0448\u043E\u0433\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430, \u0456 \u0437\u0430\u0432\u0434\u0430\u043D\u0430
      \u0439\u043E\u043C\u0443 \u0448\u043A\u043E\u0434\u0430 \u0431\u0443\u0434\u0435
      \u043D\u0430\u043C \u043D\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u044C.
      \u0422\u043E\u043C\u0443 \u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443
      \u0442\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824905
    m_Localized: "\u0429\u043E \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u043D\u0430\u0442\u0438 \u043F\u0440\u043E \u0446\u0435\u0439 \u0431\u0443\u043D\u043A\u0435\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824906
    m_Localized: "\u0426\u0435 \u043D\u0430\u0439\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0456\u0448\u0438\u0439
      \u043E\u0431'\u0454\u043A\u0442, \u044F\u043A\u0438\u0439 \u043C\u0435\u043D\u0456
      \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044F \u0431\u0430\u0447\u0438\u0442\u0438.
      \u0406 \u0440\u0456\u0447 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0432 \u043E\u0445\u043E\u0440\u043E\u043D\u0456. \u0422\u043E\u0431\u0456
      \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438
      \u043D\u0430\u0439\u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0456 \u0441\u0442\u0443\u043B\u043A\u0438
      \u043D\u0430 \u0432\u0445\u043E\u0434\u0456 \u0432 \u0431\u0443\u043D\u043A\u0435\u0440,
      \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E \u0442\u043E\u0431\u0456
      \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u0438
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443, \u043D\u0430 \u0442\u0435\u0431\u0435
      \u0447\u0435\u043A\u0430\u0454 \u0434\u0440\u0443\u0433\u0438\u0439 \u0435\u0448\u0435\u043B\u043E\u043D
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443: \u0441\u0438\u043B\u043E\u0432\u0435
      \u043F\u043E\u043B\u0435, \u044F\u043A\u0435 \u0444\u0430\u043A\u0442\u0438\u0447\u043D\u043E
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u043F\u0440\u043E\u0431\u0438\u0442\u0438
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0433\u0440\u0443\u0431\u043E\u0457
      \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824907
    m_Localized: "\u0410\u043B\u0435 \u0443 \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u043B\u044F
      \u0454 \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456\u0441\u0442\u044C.
      \u0419\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E
      \u0437\u043D\u0435\u0441\u0442\u0440\u0443\u043C\u0438\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0432\u043F\u043B\u0438\u0432 \u043D\u0430 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B
      \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0438\u043C
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2737824908
    m_Localized: "\u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u043E\u044E
      \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824909
    m_Localized: "\u0417\u0432\u0456\u0441\u043D\u043E \u0436 \u043D\u0456. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0434\u0435\u0449\u043E \u043D\u0430 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0435 - \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u0430
      \u0431\u043E\u043C\u0431\u0430. \u041C\u043E\u044F \u0432\u043B\u0430\u0441\u043D\u0430
      \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0430, \u044F\u043A\u0440\u0430\u0437
      \u0434\u043B\u044F \u0442\u0430\u043A\u0438\u0445 \u0432\u0438\u043F\u0430\u0434\u043A\u0456\u0432.
      \u041C\u043E\u0436\u0443 \u0442\u043E\u0431\u0456 \u043F\u0440\u043E\u0434\u0430\u0442\u0438
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0448\u0442\u0443\u043A. \u0410\u043B\u0435
      \u043F\u0430\u043C'\u044F\u0442\u0430\u0439 - \u0441\u0438\u043B\u043E\u0432\u0435
      \u043F\u043E\u043B\u0435 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435\u043D\u0430\u0434\u043E\u0432\u0433\u043E \u0456 \u0448\u0432\u0438\u0434\u043A\u043E
      \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F, \u0432\u0438\u0439\u0442\u0438
      \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C \u0448\u043B\u044F\u0445\u043E\u043C
      \u0442\u0438 \u0432\u0436\u0435 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0448.
      \u0426\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2737824910
    m_Localized: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E."
