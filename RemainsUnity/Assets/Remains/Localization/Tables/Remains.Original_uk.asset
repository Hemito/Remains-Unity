  - m_Id: 2725242175
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u0438\u0439 \u0442\u0435\u0445\u043D\u043E-\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C \u0434\u043B\u044F \u041F\u0456\u043F\u0411\u0430\u043A\u0430,
      \u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043C\u0430\u0433\u0456\u044E \u0456\u043B\u044E\u0437\u0456\u0439. \u041F\u043E\u0437\u0430
      \u0431\u043E\u0454\u043C \u0434\u0456\u0454 \u044F\u043A \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043A\u0430\u043C\u0443\u0444\u043B\u044F\u0436\u0443,
      \u0437\u043D\u0438\u0436\u0443\u044E\u0447\u0438 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C,
      \u0437 \u044F\u043A\u043E\u0457 \u0432\u043E\u0440\u043E\u0433\u0438 \u0432\u0430\u0441
      \u0431\u0430\u0447\u0438\u0442\u0438\u043C\u0443\u0442\u044C. \u0423 \u0431\u043E\u044E
      \u0436 \u0441\u0442\u0432\u043E\u0440\u044E\u0454 \u0456\u043B\u044E\u0437\u043E\u0440\u043D\u0456
      \u043F\u0435\u0440\u0435\u0448\u043A\u043E\u0434\u0438, \u0449\u043E \u0443\u0441\u043A\u043B\u0430\u0434\u043D\u044E\u044E\u0442\u044C
      \u043F\u0440\u0438\u0446\u0456\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u043F\u043E
      \u0432\u0430\u0441. \u0417\u0431\u0456\u043B\u044C\u0448\u0443\u0454 \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0431\u043E\u043D\u0443\u0441 \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F
      \u043D\u0430 #1."
    m_Metadata:
      m_Items: []
  - m_Id: 2725242176
    m_Localized: "\u0420\u0435\u0430\u043D\u0456\u043C\u0430\u0446\u0456\u0439\u043D\u0438\u0439
