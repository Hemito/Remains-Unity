  - m_Id: 2729436353
    m_Localized: "\u0423\u0432\u0430\u0433\u0430! \u041C\u0435\u0434\u0438\u0447\u043D\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043E.
      \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0437\u0430 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F\u043C
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0438\u0439.
      \u0417\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F \u0434\u043E \u043A\u0432\u0430\u043B\u0456\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u041F\u0456\u043F\u0411\u0430\u043A-\u0442\u0435\u0445\u043D\u0456\u043A\u0430
      \u0434\u043B\u044F \u0443\u0441\u0443\u043D\u0435\u043D\u043D\u044F \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u0456."
