      m_Items: []
  - m_Id: 2725241015
    m_Localized: "\u0425\u0438\u0436\u0430 \u0440\u0438\u0431\u0430-\u043C\u0443\u0442\u0430\u043D\u0442,
      \u0449\u043E \u0436\u0438\u0432\u0435 \u0432 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457.
      \u0428\u0432\u0438\u0434\u043A\u0430, \u0441\u0442\u0440\u0456\u043C\u043A\u0430
      \u0456 \u0434\u0443\u0436\u0435 \u0431\u043E\u043B\u044F\u0447\u0435 \u043A\u0443\u0441\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241016
    m_Localized: "\u0417\u0443\u0431\u0430\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241017
    m_Localized: "\u0425\u0438\u0436\u0430 \u0440\u0438\u0431\u0430-\u043C\u0443\u0442\u0430\u043D\u0442,
      \u0449\u043E \u0436\u0438\u0432\u0435 \u0432 \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457.
      \u041C\u0430\u0454 \u043F\u043E\u0442\u0443\u0436\u043D\u0456 \u0449\u0435\u043B\u0435\u043F\u0438
      \u0456 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0456 \u0437\u0443\u0431\u0438,
      \u0432\u0431\u0438\u0442\u0438 \u0457\u0457 \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E
      \u043D\u0435 \u0442\u0430\u043A \u0432\u0436\u0435 \u0439 \u043B\u0435\u0433\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241018
    m_Localized: "\u0420\u0438\u0431\u0430-\u0437\u043E\u043C\u0431\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241019
    m_Localized: "\u0420\u0438\u0431\u0430-\u043C\u043E\u043D\u0441\u0442\u0440,
      \u0449\u043E \u043C\u0435\u0448\u043A\u0430\u0454 \u0432 \u0440\u043E\u0436\u0435\u0432\u0456\u0439
      \u0432\u043E\u0434\u0456 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241020
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241021
    m_Localized: "\u0426\u044F \u0434\u0440\u0456\u0431\u043D\u0430 \u0442\u0432\u0430\u0440\u044E\u043A\u0430
      \u0448\u0432\u0438\u0434\u0448\u0435 \u0434\u0440\u0430\u0442\u0443\u0454,
      \u043D\u0456\u0436 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0437\u0430\u0433\u0440\u043E\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241022
    m_Localized: "\u0407\u0434\u043A\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241023
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442, \u0449\u043E
      \u043F\u043B\u044E\u0454\u0442\u044C\u0441\u044F \u0457\u0434\u043A\u043E\u044E
      \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241024
    m_Localized: "\u041E\u0442\u0440\u0443\u0439\u043D\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241025
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442, \u0449\u043E
      \u0441\u0442\u0440\u0456\u043B\u044F\u0454 \u043E\u0442\u0440\u0443\u0439\u043D\u0438\u043C\u0438
      \u0448\u0438\u043F\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241026
    m_Localized: "\u0422\u043E\u0432\u0441\u0442\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241027
    m_Localized: "\u0414\u0443\u0436\u0435 \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442 \u0456\u0437 \u0442\u043E\u0432\u0441\u0442\u0438\u043C
      \u043F\u0430\u043D\u0446\u0438\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241028
    m_Localized: "\u0417\u0443\u0431\u0430\u0441\u0442\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241029
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442, \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0438\u0439
      \u0431\u0440\u0438\u0442\u0432\u0435\u043D\u043E-\u0433\u043E\u0441\u0442\u0440\u0438\u043C\u0438
      \u0437\u0443\u0431\u0430\u043C\u0438. \u0426\u0435\u0439 \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0456\u043D\u0448\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241030
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241031
    m_Localized: "\u0426\u0435\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442
      \u0432\u0435\u0441\u044C \u043F\u0440\u043E\u0441\u043E\u0447\u0438\u0432\u0441\u044F
      \u0420\u043E\u0436\u0435\u0432\u043E\u044E \u0425\u043C\u0430\u0440\u043E\u044E
      \u0456 \u043E\u0442\u0440\u0438\u043C\u0430\u0432 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u043F\u043B\u044E\u0432\u0430\u0442\u0438\u0441\u044F \u0457\u0457 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241032
    m_Localized: "\u041A\u043E\u0448\u043C\u0430\u0440\u043D\u0438\u0439 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241033
    m_Localized: "\u0416\u0430\u0445\u043B\u0438\u0432\u0435 \u0456 \u043C\u0435\u0440\u0437\u0435\u043D\u043D\u0435
      \u043F\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0420\u043E\u0436\u0435\u0432\u043E\u0457
      \u0425\u043C\u0430\u0440\u0438 \u0437 \u0433\u043E\u0441\u0442\u0440\u0438\u043C\u0438
      \u0437\u0443\u0431\u0430\u043C\u0438. \u0412\u0456\u043D \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0432\u0433\u0440\u0438\u0437\u0430\u0442\u0438\u0441\u044F
      \u0443 \u0441\u0432\u043E\u044E \u0436\u0435\u0440\u0442\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241034
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241035
    m_Localized: "\u041D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0456 \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u0435\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0443,
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439, \u044F\u043A
      \u0434\u0456\u0436\u043A\u0430, \u0456 \u043D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E
      \u0436\u0438\u0432\u0443\u0447\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241036
    m_Localized: "\u0413\u043D\u0456\u0437\u0434\u043E \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241037
    m_Localized: "\u041C\u0435\u0440\u0437\u0435\u043D\u043D\u0435, \u043F\u0443\u043B\u044C\u0441\u0443\u044E\u0447\u0435,
      \u0441\u043F\u043B\u0438\u0432\u0430\u044E\u0447\u0435 \u0441\u043B\u0438\u0437\u043E\u043C
      \u0449\u043E\u0441\u044C, \u0449\u043E \u043F\u043B\u043E\u0434\u0438\u0442\u044C
      \u0432\u0441\u0435 \u043D\u043E\u0432\u0438\u0445 \u0456 \u043D\u043E\u0432\u0438\u0445
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432, \u043F\u043E\u043A\u0438
      \u0439\u043E\u0433\u043E \u043D\u0435 \u0437\u043D\u0438\u0449\u0438\u0448.
      \u0404 \u043F\u0456\u0434\u043E\u0437\u0440\u0430, \u0449\u043E \u0446\u0435
      \u0442\u0435\u0436 \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442,
      \u0430\u043B\u0435 \u0436\u0430\u0445\u043B\u0438\u0432\u043E \u043C\u0443\u0442\u043E\u0432\u0430\u043D\u0438\u0439
      \u0456 \u0432\u0438\u0440\u043E\u0441\u043B\u0438\u0439 \u0434\u043E \u0433\u0456\u0433\u0430\u043D\u0442\u0441\u044C\u043A\u0438\u0445
      \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241038
    m_Localized: "\u0420\u0430\u0434\u0442\u0430\u0440\u0433\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241039
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u0442\u0430\u0440\u0433\u0430\u043D,
      \u0449\u043E \u043C\u0443\u0442\u0443\u0432\u0430\u0432 \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457 \u0442\u0430
      \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0432\u0441\u044F \u0432 \u0440\u043E\u0437\u043C\u0456\u0440\u0430\u0445.
      \u041D\u0435 \u0442\u0435 \u0449\u043E\u0431 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439,
      \u0430\u043B\u0435 \u0432\u0441\u0435 \u0436 \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0431\u043E\u043B\u044F\u0447\u0435 \u0432\u043A\u0443\u0441\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241040
    m_Localized: "\u0429\u0443\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241041
    m_Localized: "\u041D\u0430\u0447\u0435\u0431\u0442\u043E \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0449\u0443\u0440, \u0442\u0456\u043B\u044C\u043A\u0438 \u0445\u0438\u0436\u0438\u0439
      \u0456 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0438\u0439. \u041C\u0435\u0448\u043A\u0430\u0454,
      \u044F\u043A \u0456 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0449\u0443\u0440\u0430\u043C,
      \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0441\u043A\u0440\u0456\u0437\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241042
    m_Localized: "\u041A\u0440\u043E\u0442\u043E\u0449\u0443\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241043
    m_Localized: "\u041C\u0443\u0442\u043E\u0432\u0430\u043D\u0430 \u043F\u043E\u043C\u0456\u0441\u044C
      \u0449\u0443\u0440\u0430 \u0456 \u043A\u0440\u043E\u0442\u0430, \u0434\u0443\u0436\u0435
      \u0432\u0435\u043B\u0438\u043A\u0438\u0439, \u0437 \u0433\u043E\u0441\u0442\u0440\u0438\u043C\u0438
      \u0437\u0443\u0431\u0430\u043C\u0438 \u0456 \u0431\u0435\u0437\u0433\u043B\u0443\u0437\u0434\u0438\u043C
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241044
    m_Localized: "\u0420\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241045
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0456\u043E\u043D-\u043C\u0443\u0442\u0430\u043D\u0442,
      \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u043D\u0456 \u0440\u043E\u0437\u043C\u0456\u0440\u0438,
      \u043C\u0456\u0446\u043D\u0438\u0439 \u0445\u0456\u0442\u0438\u043D\u043E\u0432\u0438\u0439
      \u043F\u0430\u043D\u0446\u0438\u0440 \u0456 \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u0435
      \u0436\u0430\u043B\u043E. \u0412\u043A\u0440\u0430\u0439 \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u0438 \u0434\u043E \u043D\u044C\u043E\u0433\u043E
      \u0431\u043B\u0438\u0437\u044C\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241046
    m_Localized: "\u041A\u0440\u0438\u0432\u0430\u0432\u0438\u0439 \u0440\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241047
    m_Localized: "\u0421\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E
      \u0440\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u0430, \u0430\u043B\u0435
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0430\u0442\u0430\u043A\u0438 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u043E\u0442\u0440\u0443\u0442\u0438 \u0432\u043F\u043E\u0440\u0441\u043A\u0443\u0454
      \u0444\u0435\u0440\u043C\u0435\u043D\u0442, \u0449\u043E \u043F\u0435\u0440\u0435\u0448\u043A\u043E\u0434\u0436\u0430\u0454
      \u0437\u0433\u043E\u0440\u0442\u0430\u043D\u043D\u044E \u043A\u0440\u043E\u0432\u0456,
      \u0442\u043E\u0436 \u0439\u043E\u0433\u043E \u0436\u0435\u0440\u0442\u0432\u0430
      \u043C\u043E\u0436\u0435 \u0437\u0430\u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043C\u0435\u0440\u0442\u0438
      \u0432\u0456\u0434 \u043A\u0440\u043E\u0432\u043E\u0432\u0442\u0440\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241048
    m_Localized: "\u0416\u0430\u0445\u043B\u0438\u0432\u0438\u0439 \u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241049
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0456\u043E\u043D, \u0449\u043E
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0432\u0441\u044F \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u0420\u043E\u0436\u0435\u0432\u043E\u0457 \u0425\u043C\u0430\u0440\u0438
      \u043D\u0430 \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0441\u0442\u0440\u0430. \u0411\u0456\u043B\u044C\u0448\u0438\u0439
      \u0456 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u0440\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241050
    m_Localized: "\u041C\u0443\u0440\u0430\u0445\u0430-\u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241051
    m_Localized: "\u0413\u0456\u0433\u0430\u043D\u0442\u0441\u044C\u043A\u0438\u0439
      \u043C\u0443\u0440\u0430\u0445\u0430, \u0449\u043E \u043C\u0443\u0442\u0443\u0432\u0430\u0432,
      \u0434\u0443\u0436\u0435 \u0431\u043E\u043B\u044F\u0447\u0435 \u043A\u0443\u0441\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241052
    m_Localized: "\u041C\u0443\u0440\u0430\u0445\u0430-\u0441\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241053
    m_Localized: "\u0426\u0435\u0439 \u043C\u0443\u0440\u0430\u0445\u0430-\u043C\u0443\u0442\u0430\u043D\u0442
      \u043C\u0430\u0454 \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u0456\u0433\u0430\u043D\u0442\u0441\u044C\u043A\u0456
      \u0449\u0435\u043B\u0435\u043F\u0438, \u0442\u043E\u0436 \u0432\u0456\u0434
      \u0439\u043E\u0433\u043E \u0443\u043A\u0443\u0441\u0456\u0432 \u043D\u0456\u043A\u043E\u043C\u0443
      \u043D\u0435 \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241054
    m_Localized: "\u0412\u043E\u0433\u043D\u044F\u043D\u0438\u0439 \u043C\u0443\u0440\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241055
    m_Localized: "\u041C\u0443\u0440\u0430\u0445\u0430-\u043C\u0443\u0442\u0430\u043D\u0442,
      \u0449\u043E \u043C\u0430\u0454 \u0432\u043E\u0433\u043D\u0435\u0442\u0432\u043E\u0440\u043D\u0443
      \u0437\u0430\u043B\u043E\u0437\u0443 \u0456 \u0437\u0434\u0430\u0442\u043D\u0438\u0439
      \u0432\u0438\u0434\u0438\u0445\u0430\u0442\u0438 \u043F\u043E\u043B\u0443\u043C'\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241056
    m_Localized: "\u041C\u0443\u0440\u0430\u0448\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241057
    m_Localized: "\u041E\u0434\u0438\u043D \u0456\u0437 \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u0438\u0445
      \u0432\u0438\u0445\u043E\u0434\u0456\u0432 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u043E\u0457
      \u043C\u0443\u0440\u0430\u0448\u0438\u043D\u043E\u0457 \u043A\u043E\u043B\u043E\u043D\u0456\u0457.
      \u042F\u043A\u0449\u043E \u0439\u043E\u0433\u043E \u043D\u0435 \u0437\u043D\u0438\u0449\u0438\u0442\u0438,
      \u043C\u0443\u0440\u0430\u0445\u0438 \u043B\u0456\u0437\u0442\u0438\u043C\u0443\u0442\u044C
      \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u0438\u043C \u043F\u043E\u0442\u043E\u043A\u043E\u043C
      \u0437\u043D\u043E\u0432\u0443 \u0456 \u0437\u043D\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241058
    m_Localized: "\u0416\u0430\u0445\u043B\u0438\u0432\u0438\u0439 \u0441\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241059
    m_Localized: "\u0414\u043E\u0441\u0442\u043E\u0432\u0456\u0440\u043D\u043E \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E,
      \u044F\u043A\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u0430 \u0456 \u043F\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0446\u0438\u0445 \u0434\u0438\u0432\u043D\u0438\u0445 \u043F\u043E\u0432\u0437\u0443\u0447\u0438\u0445
      \u0443\u0442\u0432\u043E\u0440\u0435\u043D\u044C. \u0411\u0443\u043B\u043E
      \u0432\u0438\u0441\u043B\u043E\u0432\u043B\u0435\u043D\u043E \u0433\u0456\u043F\u043E\u0442\u0435\u0437\u0443,
      \u0449\u043E \u0446\u0435\u0439 \u0441\u043B\u0438\u0437 - \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043A\u043E\u043B\u043E\u043D\u0456\u0457 \u043C\u0456\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C\u0456\u0432,
      \u044F\u043A\u0456 \u043C\u0443\u0442\u0443\u0432\u0430\u043B\u0438 \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u041F\u043E\u0440\u0447\u0456. \u041D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u0442\u0438\u043C, \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C
      \u0443 \u0441\u043E\u0431\u0456 \u0457\u0434\u043A\u0456 \u043A\u0438\u0441\u043B\u043E\u0442\u0438
      \u0442\u0430 \u0456\u043D\u0448\u0443 \u0445\u0456\u043C\u0456\u0447\u043D\u0443
      \u0433\u0438\u0434\u043E\u0442\u0443, \u0430\u043B\u0435, \u043D\u0430 \u0449\u0430\u0441\u0442\u044F,
      \u043D\u0456 \u043D\u0430 \u043A\u043E\u0433\u043E \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u0454,
      \u0442\u043E\u0436 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0438 \u043D\u0430
      \u043D\u044C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241060
    m_Localized: "\u041A\u0440\u0456\u043E-\u0441\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241061
    m_Localized: "\u0414\u0443\u0436\u0435 \u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u043F\u043E\u0432\u0437\u0443\u0447\u0438\u0439 \u0441\u043B\u0438\u0437,
      \u0449\u043E \u0432\u0440\u0430\u0436\u0430\u0454 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0438\u043C
      \u0445\u043E\u043B\u043E\u0434\u043E\u043C \u043A\u043E\u0436\u043D\u043E\u0433\u043E,
      \u0445\u0442\u043E \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241062
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u0441\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241063
    m_Localized: "\u041F\u043E\u0432\u0437\u0443\u0447\u0438\u0439 \u0441\u043B\u0438\u0437,
      \u043F\u0440\u043E\u0441\u043E\u0447\u0435\u043D\u0438\u0439 \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0441\u044C\u043A\u043E\u044E
      \u043C\u0430\u0433\u0456\u0454\u044E \u0420\u043E\u0436\u0435\u0432\u043E\u0457
      \u0425\u043C\u0430\u0440\u0438. \u0423 \u0436\u043E\u0434\u043D\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0442\u043E\u0440\u043A\u0430\u0442\u0438\u0441\u044F
      \u0434\u043E \u043D\u044C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241064
    m_Localized: "\u0420\u0456\u0439 \u043D\u0435\u043A\u0440\u043E\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241065
    m_Localized: "\u041F\u0440\u043E \u043F\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0446\u0456\u0454\u0457 \u0434\u0438\u0432\u043D\u043E\u0457 \u0456 \u043B\u044F\u043A\u0430\u044E\u0447\u043E\u0457
      \u0441\u0443\u0442\u043D\u043E\u0441\u0442\u0456 \u043C\u0430\u043B\u043E \u0449\u043E
      \u043C\u043E\u0436\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u043A\u0440\u0456\u043C
      \u0442\u043E\u0433\u043E, \u0449\u043E \u0432\u043E\u043D\u0430 \u0454 \u043F\u043E\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F\u043C
      \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442\u0456\u0457. \u041D\u0435\u043A\u0440\u043E\u0441\u043F\u0440\u0430\u0439\u0442\u0438
      \u0432\u0456\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442\u044C
      \u043A\u0440\u0456\u0437\u044C \u0441\u0442\u0456\u043D\u0438 \u0456 \u0444\u0456\u0437\u0438\u0447\u043D\u0456
      \u0430\u0442\u0430\u043A\u0438 \u043D\u0435 \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C
      \u0457\u043C \u0436\u043E\u0434\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241066
    m_Localized: "\u041F\u0440\u0438\u043C\u0430\u0440\u0430 \u0441\u043C\u0435\u0440\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241067
    m_Localized: "\u0420\u043E\u0431\u043E\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241068
    m_Localized: "\u0420\u043E\u0431\u043E\u0442\u0438 \u0454 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u043C
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u043E\u0457 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0456\u0457,
      \u044F\u043A\u0443 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u044F \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043B\u0430
      \u0432 \u0440\u043E\u043A\u0438, \u0449\u043E \u043F\u0435\u0440\u0435\u0434\u0443\u044E\u0442\u044C
      \u0412\u0435\u043B\u0438\u043A\u0456\u0439 \u0412\u0456\u0439\u043D\u0456.
      \u0412\u043E\u043D\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u044C \u0441\u043E\u0431\u043E\u044E
      \u043F\u043E\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u043D\u0430\u0439\u043F\u0435\u0440\u0435\u0434\u043E\u0432\u0456\u0448\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439 \u0437\u0435\u043C\u043D\u0438\u0445
      \u043F\u043E\u043D\u0456 \u0442\u0430 \u043C\u0430\u0433\u0456\u0457 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0456\u0432
      \u0456 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u043B\u044F
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u043D\u0430\u0439\u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456\u0448\u0438\u0445
      \u0437\u0430\u0432\u0434\u0430\u043D\u044C - \u0432\u0456\u0434 \u0432\u0435\u0434\u0435\u043D\u043D\u044F
      \u0434\u043E\u043C\u0430\u0448\u043D\u044C\u043E\u0433\u043E \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0441\u0442\u0432\u0430
      \u0434\u043E \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u0432\u043B\u0430\u0441\u043D\u043E\u0441\u0442\u0456.
      \u0423 \u0432\u043E\u0454\u043D\u043D\u0456 \u0440\u043E\u043A\u0438 \u0442\u0430\u043A\u043E\u0436
      \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F \u0431\u043E\u0439\u043E\u0432\u0456
      \u043C\u043E\u0434\u0435\u043B\u0456, \u044F\u043A\u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0438
      \u0443 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445 \u0434\u0456\u044F\u0445.
      \u0425\u043E\u0447\u0430 \u043D\u0438\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0456\u0432
      \u0443\u0436\u0435 \u043D\u0456\u0445\u0442\u043E \u043D\u0435 \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u0454,
      \u0431\u0430\u0433\u0430\u0442\u043E \u0445\u0442\u043E \u0437 \u043D\u0438\u0445
      \u0443\u0441\u0435 \u0449\u0435 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u0454,
      \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438 \u043D\u0430 \u043C\u0438\u043D\u0443\u043B\u0456
      \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F. \u041F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E
      \u0446\u0435 \u0431\u043E\u0439\u043E\u0432\u0456 \u0442\u0430 \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438, \u044F\u043A\u0456 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u044E\u0442\u044C
      \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u043A\u043B\u0430\u0434\u0435\u043D\u0456
      \u0432 \u043D\u0438\u0445 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0438
      \u0456 \u0433\u043E\u0442\u043E\u0432\u0456 \u043E\u0431\u0440\u0443\u0448\u0438\u0442\u0438
      \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u043C\u0456\u0446\u044C \u043D\u0430
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E \u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0430,
      \u044F\u043A\u0438\u0439 \u0432\u0442\u043E\u0440\u0433\u0441\u044F \u0432
      \u0457\u0445\u043D\u0456 \u0432\u043E\u043B\u043E\u0434\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241069
    m_Localized: "\u0422\u0443\u0440\u0435\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241070
    m_Localized: "\u0422\u0443\u0440\u0435\u043B\u0456 - \u0446\u0435 \u0441\u0442\u0430\u0446\u0456\u043E\u043D\u0430\u0440\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456
      \u0434\u043B\u044F \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u0440\u0456\u0437\u043D\u0438\u0445
      \u043E\u0431'\u0454\u043A\u0442\u0456\u0432. \u041C\u0430\u044E\u0442\u044C
      \u043F\u043E\u0442\u0443\u0436\u043D\u0435 \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F,
      \u044F\u043A-\u043E\u0442 \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0438
      \u0442\u0430 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0433\u0430\u0440\u043C\u0430\u0442\u0438, \u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u044E\u0442\u044C
      \u0432\u043E\u0433\u043E\u043D\u044C \u043F\u043E \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0443, \u0449\u043E \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u0454
      \u0432 \u0437\u043E\u043D\u0443 \u0457\u0445\u043D\u044C\u043E\u0457 \u0434\u0456\u0457.
      \u042F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0442\u0443\u0440\u0435\u043B\u0456
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u043E\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E \u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0443\u0442\u0438 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0456
      \u0430\u0431\u043E \u043F\u0435\u0440\u0435\u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0456
      \u0447\u0435\u0440\u0435\u0437 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241071
    m_Localized: "\u041F\u0456\u0434\u0432\u0456\u0441\u043D\u0430 \u0442\u0443\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241072
    m_Localized: "\u041F\u0456\u0434\u0432\u0456\u0441\u043D\u0456 \u0442\u0443\u0440\u0435\u043B\u0456
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0441\u0442\u0435\u043B\u0456. \u0412\u043E\u043D\u0438 \u0434\u043E\u0441\u0438\u0442\u044C
      \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0456, \u0430\u043B\u0435
      \u043F\u043E\u0433\u0430\u043D\u043E \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0456
      \u0432\u0456\u0434 \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0457\u0445 \u043C\u043E\u0436\u043D\u0430
      \u0437\u043D\u0438\u0449\u0438\u0442\u0438, \u044F\u043A\u0449\u043E \u043F\u043E\u0448\u043A\u043E\u0434\u0438\u0442\u0438
      \u043A\u0440\u0456\u043F\u043B\u0435\u043D\u043D\u044F. \u0417\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044E\u0442\u044C\u0441\u044F
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0456 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0457,
      \u0449\u043E \u0432\u0438\u0441\u0443\u0432\u0430\u044E\u0442\u044C\u0441\u044F
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 \u0431\u043E\u0439\u043E\u0432\u043E\u043C\u0443
      \u0440\u0435\u0436\u0438\u043C\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241073
    m_Localized: "\u041D\u0430\u0437\u0435\u043C\u043D\u0430 \u0442\u0443\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241074
    m_Localized: "\u041D\u0430\u0437\u0435\u043C\u043D\u0456 \u0442\u0443\u0440\u0435\u043B\u0456
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0437\u0456, \u0432\u043E\u043D\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0443\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0456
      \u0456 \u043C\u0430\u044E\u0442\u044C \u043C\u0456\u0446\u043D\u0443 \u0431\u0440\u043E\u043D\u044E,
      \u0449\u043E \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0457\u0445 \u0432\u0456\u0434
      \u043A\u0443\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241075
    m_Localized: "\u0421\u0442\u0456\u043D\u043D\u0430 \u0442\u0443\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241076
    m_Localized: "\u0421\u0442\u0456\u043D\u043D\u0456 \u0442\u0443\u0440\u0435\u043B\u0456
      \u043F\u0440\u0438\u043A\u0440\u0456\u043F\u043B\u044E\u044E\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E
      \u0434\u043E \u0441\u0442\u0456\u043D\u0438 \u0430\u0431\u043E \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C
      \u043D\u0430 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0443 \u0440\u0435\u0439\u043A\u0443,
      \u044F\u043A\u043E\u044E \u0432\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F \u0437 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043A\u0456\u043D\u0446\u044F \u0432 \u0456\u043D\u0448\u0438\u0439. \u0407\u0445\u043D\u0454
      \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F \u043C\u043E\u0436\u0435 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0432\u0441\u0456 \u0442\u0440\u0438\u0441\u0442\u0430 \u0448\u0456\u0441\u0442\u0434\u0435\u0441\u044F\u0442
      \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241077
    m_Localized: "\u0417\u0430\u0445\u0438\u0449\u0435\u043D\u0430 \u0442\u0443\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241078
    m_Localized: "\u0426\u044E \u0442\u0443\u0440\u0435\u043B\u044C \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E
      \u043D\u0430 \u0432\u0430\u0436\u043A\u043E\u043C\u0443, \u043D\u0430\u0434\u0456\u0439\u043D\u043E\u043C\u0443
      \u0448\u0442\u0430\u0442\u0438\u0432\u0456, \u0432\u043E\u043D\u0430 \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0430
      \u0431\u0440\u043E\u043D\u0435\u043B\u0438\u0441\u0442\u0430\u043C\u0438 \u0456
      \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C \u0441\u0438\u043B\u043E\u0432\u0438\u043C
      \u043F\u043E\u043B\u0435\u043C, \u0449\u043E \u0443\u0441\u043F\u0456\u0448\u043D\u043E
      \u043F\u0440\u043E\u0442\u0438\u0434\u0456\u0454 \u044F\u043A \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u0438\u043C,
      \u0442\u0430\u043A \u0456 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C
      \u0432\u043F\u043B\u0438\u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241079
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0430 \u0442\u0443\u0440\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241080
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0456 \u0441\u0442\u0435\u043B\u044C\u043E\u0432\u0456
      \u0442\u0443\u0440\u0435\u043B\u0456. \u041D\u0430 \u0432\u0456\u0434\u043C\u0456\u043D\u0443
      \u0432\u0456\u0434 \u0434\u043E\u0441\u0438\u0442\u044C \u043A\u0432\u043E\u043B\u0438\u0445
      \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439,
      \u0446\u0456 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u043B\u044F
      \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445
      \u043E\u0431'\u0454\u043A\u0442\u0456\u0432, \u0430 \u0442\u043E\u043C\u0443
      \u043C\u0430\u044E\u0442\u044C \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0438\u0439
      \u043A\u043E\u0440\u043F\u0443\u0441 \u0456 \u043C\u0456\u0446\u043D\u0443
      \u0431\u0440\u043E\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241081
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0456 \u0440\u043E\u0431\u043E\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241082
    m_Localized: "\u041A\u043B\u0430\u0441 \u0440\u043E\u0431\u043E\u0442\u0456\u0432
      \u0440\u043E\u0437\u043C\u0456\u0440\u043E\u043C \u0437 \u043F\u043E\u043D\u0456
      \u0430\u0431\u043E \u043D\u0430\u0432\u0456\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u0438\u0439.
      \u041F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u043B\u044F
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0440\u0456\u0437\u043D\u0438\u0445
      \u0440\u043E\u0431\u0456\u0442 \u0430\u0431\u043E \u0431\u043E\u0439\u043E\u0432\u0438\u0445
      \u0437\u0430\u0432\u0434\u0430\u043D\u044C. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0442\u0430\u043A\u0456 \u0440\u043E\u0431\u043E\u0442\u0438 \u043C\u0430\u044E\u0442\u044C
      \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u0438\u0439 \u0448\u0442\u0443\u0447\u043D\u0438\u0439
      \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442, \u043C\u0456\u0446\u043D\u0438\u0439
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441
      \u0456 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0435
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F, \u0443 \u0431\u043E\u0439\u043E\u0432\u0438\u0445
      \u043C\u043E\u0434\u0435\u043B\u0435\u0439 \u0432\u0435\u043B\u044C\u043C\u0438
      \u043F\u043E\u0442\u0443\u0436\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241083
    m_Localized: "\u0420\u043E\u0431\u043E\u043C\u043E\u0437\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241084
    m_Localized: "\u041E\u0434\u043D\u0430 \u0437 \u043F\u0435\u0440\u0448\u0438\u0445
      \u0441\u0435\u0440\u0456\u0439\u043D\u0438\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439
      \u0431\u0430\u0433\u0430\u0442\u043E\u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0445
      \u0440\u043E\u0431\u043E\u0442\u0456\u0432, \u0443 \u044F\u043A\u0456\u0439
      \u0432 \u044F\u043A\u043E\u0441\u0442\u0456 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u0436\u0438\u0432\u0438\u0439
      \u043C\u043E\u0437\u043E\u043A, \u043F\u043E\u043C\u0456\u0449\u0435\u043D\u0438\u0439
      \u0443 \u0441\u043A\u043B\u044F\u043D\u0443 \u043A\u043E\u043B\u0431\u0443.
      \u041C\u0430\u0454 \u0434\u0432\u0430 \u0448\u043B\u0430\u043D\u0433\u043E\u043F\u043E\u0434\u0456\u0431\u043D\u0456
      \u043C\u0430\u043D\u0456\u043F\u0443\u043B\u044F\u0442\u043E\u0440\u0438, \u0449\u043E
      \u0434\u0430\u044E\u0442\u044C \u0437\u043C\u043E\u0433\u0443 \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0440\u0456\u0437\u043D\u0456 \u0434\u0456\u0457, \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0433\u0443\u0441\u0435\u043D\u0438\u0447\u043D\u043E\u043C\u0443
      \u0448\u0430\u0441\u0456, \u043C\u0430\u0454 \u0441\u043B\u0430\u0431\u043A\u0435
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F \u043D\u0430 \u043A\u0448\u0442\u0430\u043B\u0442
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0440\u043E\u0437\u0440\u044F\u0434\u043D\u0438\u043A\u0430
      \u0430\u0431\u043E \u043B\u0430\u0437\u0435\u0440\u0430. \u0417\u0430\u0433\u0430\u043B\u043E\u043C
      \u0446\u044F \u043C\u043E\u0434\u0435\u043B\u044C \u043C\u0430\u0454 \u0431\u0435\u0437\u043B\u0456\u0447
      \u043C\u0456\u043D\u0443\u0441\u0456\u0432 \u0456 \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u043F\u0440\u0438\u0441\u0442\u043E\u0441\u043E\u0432\u0430\u043D\u0430
      \u0434\u043B\u044F \u0431\u043E\u044E. \u0420\u043E\u0431\u043E\u043C\u0456\u0437\u043A\u0438
      \u0434\u043E\u0432\u043E\u043B\u0456 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456,
      \u043D\u0435\u0437\u0433\u0440\u0430\u0431\u043D\u0456, \u0442\u0443\u043F\u0443\u0432\u0430\u0442\u0456
      \u0439 \u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u0432\u0435\u043B\u0438\u043A\u043E\u0457 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241085
    m_Localized: "\u041F\u0440\u043E\u0442\u0435\u043A\u0442\u043E\u043F\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241086
    m_Localized: "\u041F\u043E\u0448\u0438\u0440\u0435\u043D\u0430 \u043C\u043E\u0434\u0435\u043B\u044C
      \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E \u0440\u043E\u0431\u043E\u0442\u0430,
      \u0449\u043E \u0437\u043E\u0432\u043D\u0456 \u043D\u0430\u0433\u0430\u0434\u0443\u0454
      \u043F\u043E\u043D\u0456. \u0412\u0456\u043D \u043C\u043E\u0436\u0435 \u0432\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438
      \u0442\u0430\u043A\u0456 \u0444\u0443\u043D\u043A\u0446\u0456\u0457, \u044F\u043A:
      \u0437\u0430\u0445\u0438\u0441\u0442 \u0441\u0432\u043E\u0457\u0445 \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0456\u0432,
      \u043E\u0445\u043E\u0440\u043E\u043D\u0430 \u0440\u0456\u0437\u043D\u0438\u0445
      \u043E\u0431'\u0454\u043A\u0442\u0456\u0432, \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F
      \u043F\u0440\u0430\u0432\u043E\u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u0442\u043E\u0449\u043E.
      \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0432\u0456\u043D \u043C\u0430\u0454
      \u043C\u0456\u0446\u043D\u0443 \u0431\u0440\u043E\u043D\u044E \u0456 \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F
      \u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0457 \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456.
      \u0414\u0435\u044F\u043A\u0430 \u043D\u0435\u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043A\u0456\u0441\u0442\u044C
      \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u043E\u043C
      \u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u0457, \u044F\u043A\u0438\u0439
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0440\u043E\u0431\u043E\u0442\u0443
      \u043F\u0435\u0432\u043D\u0438\u0439 \u0447\u0430\u0441 \u0448\u0438\u0440\u044F\u0442\u0438
      \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456 \u0442\u0430 \u043F\u0456\u0434\u043D\u0456\u043C\u0430\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0432\u0438\u0441\u043E\u0447\u0438\u043D\u0438. \u041D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438
      \u043D\u0430 \u0442\u0435, \u0449\u043E \u0457\u0445\u043D\u0456 \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0456
      \u043F\u043E\u043C\u0435\u0440\u043B\u0438 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F
      \u0442\u043E\u043C\u0443, \u043F\u0440\u043E\u0442\u0435\u043A\u0442\u043E\u043F\u043E\u043D\u0438
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u044E\u0442\u044C \u043F\u0430\u0442\u0440\u0443\u043B\u044E\u0432\u0430\u0442\u0438
      \u0432\u0432\u0456\u0440\u0435\u043D\u0456 \u0457\u043C \u043E\u0431'\u0454\u043A\u0442\u0438
      \u0456 \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u043F\u043B\u044F\u0442\u044C
      \u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241087
    m_Localized: "\u041C\u0456\u0441\u0442\u0435\u0440 \u0421\u043C\u0456\u043B\u0438\u0432\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241088
    m_Localized: "\u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0430 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u044F
      \u043F\u043E\u0431\u0443\u0442\u043E\u0432\u043E\u0433\u043E \u0440\u043E\u0431\u043E\u0442\u0430
      \"\u041C\u0456\u0441\u0442\u0435\u0440 \u041F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\",
      \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u0446\u0456\u043B\u0438\u043C
      \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u043E\u043C \u0432\u0441\u0456\u043B\u044F\u043A\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u0404 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0430
      \u0433\u0430\u0440\u043C\u0430\u0442\u0430 \u0434\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0456\u0445
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u0439, \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442
      \u0434\u043B\u044F \u0431\u043B\u0438\u0436\u043D\u0456\u0445 \u0456 \u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0440\u043D\u0430
      \u043F\u0438\u043B\u0430 \u0434\u043B\u044F \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443 \u0437 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C.
      \u0414\u043B\u044F \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0440\u043E\u0431\u043E\u0442 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043C\u0430\u0433\u0456\u044E \u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u0457,
      \u0449\u043E \u0434\u0430\u0454 \u0439\u043E\u043C\u0443 \u0437\u043C\u043E\u0433\u0443
      \u043F\u0430\u0440\u0438\u0442\u0438 \u043D\u0430\u0434 \u0437\u0435\u043C\u043B\u0435\u044E
      \u0432 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456.
      \u041F\u0456\u0434 \u0447\u0430\u0441 \u0412\u0456\u0439\u043D\u0438 \u0446\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u044F\u0445 \u0431\u0438\u0442\u0432, \u0430\u043B\u0435
      \u0437\u0430\u0440\u0430\u0437 \u0457\u0445 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u043D\u0435 \u0442\u0430\u043A \u0432\u0436\u0435 \u0439 \u0431\u0430\u0433\u0430\u0442\u043E.
      \u041D\u0430 \u0436\u0430\u043B\u044C, \u0457\u0445\u043D\u0456 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0456
      \u043C\u0456\u0437\u043A\u0438 \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0433\u043B\u044E\u0447\u0438\u043B\u0438,
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0438 \u0432\u0436\u0435
      \u043D\u0435 \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u044E\u0442\u044C
      \u0434\u0440\u0443\u0437\u0456\u0432 \u0432\u0456\u0434 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241089
    m_Localized: "\u0415\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241090
    m_Localized: "\u0415\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0438 -
      \u0432\u0435\u0440\u0448\u0438\u043D\u0430 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439
      \u0441\u0442\u0430\u0440\u043E\u0457 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457
      - \u0431\u0443\u043B\u0438 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0456
      \u043D\u0435\u0437\u0430\u0434\u043E\u0432\u0433\u043E \u0434\u043E \u0430\u043F\u043E\u043A\u0430\u043B\u0456\u043F\u0441\u0438\u0441\u0443.
      \u041F\u0435\u0440\u0448\u0456 \u043C\u043E\u0434\u0435\u043B\u0456 \u0431\u0443\u043B\u0438
      \u0446\u0456\u043B\u043A\u043E\u043C \u043C\u0438\u0440\u043D\u0438\u043C\u0438,
      \u0430\u043B\u0435 \u043C\u0430\u0439\u0436\u0435 \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u0436 \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F \u0456 \u0431\u043E\u0439\u043E\u0432\u0456
      \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0457, \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0456
      \u043D\u043E\u0432\u0456\u0442\u043D\u044C\u043E\u044E \u0437\u0431\u0440\u043E\u0454\u044E,
      \u0435\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043D\u0438\u043C \u0437\u0430\u0445\u0438\u0441\u0442\u043E\u043C
      \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u0434\u0435\u044F\u043A\u0438\u043C\u0438
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F\u043C\u0438. \u0423
      \u0431\u043E\u044F\u0445 \u0432\u043E\u043D\u0438 \u043D\u0435 \u0431\u0440\u0430\u043B\u0438
      \u0443\u0447\u0430\u0441\u0442\u0456 \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u043E\u044E
      \u0432\u0438\u043D\u044F\u0442\u043A\u043E\u0432\u0443 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0434\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0443, \u0430\u043B\u0435
      \u0441\u043B\u0443\u0436\u0438\u043B\u0438 \u0431\u0430\u0433\u0430\u0442\u0438\u043C
      \u0456 \u0432\u043F\u043B\u0438\u0432\u043E\u0432\u0438\u043C \u043E\u0441\u043E\u0431\u0430\u043C
      \u044F\u043A \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0456 \u0439 \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u0438,
      \u0434\u043E \u0442\u043E\u0433\u043E \u0436 \u043C\u0430\u043B\u0438 \u0432\u0438\u0433\u043B\u044F\u0434
      \u0456 \u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u0438\u0441\u044F
      \u043C\u0430\u0439\u0436\u0435 \u044F\u043A \u0436\u0438\u0432\u0456 \u043F\u043E\u043D\u0456.
      \u041D\u0438\u043D\u0456 \u0432\u0446\u0456\u043B\u0456\u043B\u0456 \u0435\u043A\u0432\u0456\u0434\u0440\u043E\u0457\u0434\u0438,
      \u0441\u0445\u043E\u0436\u0435, \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u043E\u0441\u0442\u0430\u043D\u043D\u0456 \u0437\u0430\u043B\u0438\u0448\u043A\u0438
      \u0441\u0432\u043E\u0433\u043E \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0433\u043E
      \u0440\u043E\u0437\u0443\u043C\u0443 \u0456 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u0447\u0438\u043C\u0430\u043B\u0443 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241091
    m_Localized: AJ-17
    m_Metadata:
      m_Items: []
  - m_Id: 2725241092
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u0440\u043E\u0431\u043E\u0442,
      \u0437\u043D\u0430\u0447\u043D\u043E \u043A\u0440\u0443\u0442\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E.
      \u041E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439 \u0432\u0430\u0436\u043A\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E \u0456 \u0431\u0440\u043E\u043D\u0435\u044E,
      \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u043E\u043C
      \u043B\u0435\u0432\u0456\u0442\u0430\u0446\u0456\u0457, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u043C \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0438\u043C
      \u043A\u043E\u043D\u0442\u0443\u0440\u043E\u043C, \u0449\u043E \u0437\u0430\u0445\u0438\u0449\u0430\u0454
      \u0440\u043E\u0431\u043E\u0442\u0430 \u0432\u0456\u0434 \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241093
    m_Localized: "\u041C\u0456\u0441\u0442\u0435\u0440 \u0417\u0430\u0445\u0438\u0441\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241094
    m_Localized: "\u041C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439
      \u0434\u043B\u044F \u043F\u043E\u0442\u0440\u0435\u0431 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432 \"\u041C\u0456\u0441\u0442\u0435\u0440
      \u0421\u043C\u0456\u043B\u0438\u0432\u0435\u0446\u044C\", \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439
      \u0431\u0456\u043B\u044C\u0448 \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241095
    m_Localized: "\u0412\u0430\u0440\u0442\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241096
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0438\u0439 \u0440\u043E\u0431\u043E\u0442,
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u0454\u044E
      \u0420\u043E\u0431\u0440\u043E\u043D\u043A\u043E \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0412\u0456\u0439\u043D\u0438, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439
      \u0434\u043B\u044F \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u043D\u0430\u0439\u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0438\u0445
      \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445, \u0434\u0435\u0440\u0436\u0430\u0432\u043D\u0438\u0445
      \u0456 \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0443\u0447\u0430\u0441\u0442\u0456
      \u0432 \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0434\u0456\u044F\u0445
      \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u043D\u0430 \u043B\u0456\u043D\u0456\u0457 \u0444\u0440\u043E\u043D\u0442\u0443.
      \u042F\u0432\u043B\u044F\u0454 \u0441\u043E\u0431\u043E\u044E \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
      \u0442\u0430\u043D\u043A, \u0440\u043E\u0437\u043C\u0456\u0440\u0430\u043C\u0438
      \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0438\u0439
      \u0437\u0430 \u043F\u043E\u043D\u0456, \u0449\u043E \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0447\u043E\u0442\u0438\u0440\u044C\u043E\u0445 \u043A\u043E\u043B\u0435\u0441\u0430\u0445.
      \u0414\u043E\u0431\u0440\u0435 \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0439
      \u0456 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0439 \u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
      \u0432\u0438\u0434\u0430\u043C\u0438 \u0432\u0430\u0436\u043A\u043E\u0433\u043E
      \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F, \u044F\u043A-\u043E\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456
      \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0438, \u0440\u0430\u043A\u0435\u0442\u043D\u0456
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0442\u0430 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0456
      \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F. \u041D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439 \u0443 \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241097
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430-\u0432\u0430\u0440\u0442\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241098
    m_Localized: "\u0411\u0456\u043B\u044C\u0448\u0430 \u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0430
      \u0432\u0435\u0440\u0441\u0456\u044F \u0412\u0430\u0440\u0442\u043E\u0432\u043E\u0433\u043E,
      \u0442\u0430 \u0449\u0435 \u0439 \u043B\u0456\u0442\u0430\u044E\u0447\u0430.
      \u0423\u043B\u044C\u0442\u0440\u0430-\u0432\u0430\u0440\u0442\u043E\u0432\u0438\u0439
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u0438\u0439 \u0432\u0430\u0436\u043A\u043E\u044E
      \u0431\u0440\u043E\u043D\u0435\u044E, \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C
      \u0449\u0438\u0442\u043E\u043C, \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u043C
      \u043C\u0456\u043D\u0456\u0433\u0430\u043D\u043E\u043C \u0456 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u043E\u044E
      \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E
      \u0437\u0430\u043B\u043F\u043E\u0432\u043E\u0433\u043E \u0432\u043E\u0433\u043D\u044E.
      \u0411\u0438\u0442\u0432\u0430 \u0437 \u0442\u0430\u043A\u0438\u043C \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C
      - \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0435 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F
      \u0434\u043B\u044F \u0431\u0443\u0434\u044C-\u043A\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241099
    m_Localized: "\u0411\u043E\u043C\u0431\u0430\u0440\u0434\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241100
    m_Localized: "\u0417\u043D\u0430\u0447\u043D\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u0438\u0439
      \u0443 \u0440\u043E\u0437\u043C\u0456\u0440\u0430\u0445 \u0431\u043E\u0439\u043E\u0432\u0438\u0439
      \u0434\u0440\u043E\u043D - \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
      \u043B\u0456\u0442\u0430\u044E\u0447\u0438\u0439 \u0442\u0430\u043D\u043A.
      \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u0454
      \u043D\u0430\u0439\u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0456 \u043E\u0431'\u0454\u043A\u0442\u0438,
      \u0449\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u044C \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u043C
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241101
    m_Localized: "\u0414\u0440\u0456\u0431\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241102
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0456 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u043B\u044F
      \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u043F\u0435\u0432\u043D\u0438\u0445
      \u0437\u0430\u0432\u0434\u0430\u043D\u044C, \u043D\u0435 \u043C\u0430\u044E\u0442\u044C
      \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u0442\u043E\u0433\u043E \u0428\u0406
      \u0456 \u0434\u0456\u044E\u0442\u044C \u0432\u0438\u043A\u043B\u044E\u0447\u043D\u043E
      \u0437\u0430 \u0437\u0430\u043A\u043B\u0430\u0434\u0435\u043D\u043E\u044E \u0432
      \u043D\u0438\u0445 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241103
    m_Localized: "\u0421\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241104
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043B\u0456\u0442\u0430\u044E\u0447\u0438\u0439
      \u0440\u043E\u0431\u043E\u0442, \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E\u043C
      \u041C\u043E\u0440\u0430\u043B\u0456. \u0421\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0438
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u044F\u043A \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0456 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0447\u0456,
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0442\u0440\u0430\u043D\u0441\u043B\u044E\u044E\u0447\u0438
      \u043F\u0430\u0442\u0440\u0456\u043E\u0442\u0438\u0447\u043D\u0456 \u0440\u0430\u0434\u0456\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0456
      \u0439 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u0437\u0430\u0439\u043C\u0430\u044E\u0447\u0438\u0441\u044C
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0438\u043C \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F\u043C
      \u0437\u0430 \u0433\u0440\u043E\u043C\u0430\u0434\u044F\u043D\u0430\u043C\u0438.
      \u0417\u0430\u0440\u0430\u0437 \u0431\u0435\u0437\u043B\u0456\u0447 \u0441\u043F\u0440\u0430\u0439\u0442-\u0431\u043E\u0442\u0456\u0432
      \u0443\u0441\u0435 \u0449\u0435 \u043C\u043E\u0436\u043D\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438
      \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445. \u041D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u0432\u043E\u043D\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043D\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C, \u043A\u0440\u0456\u043C
      \u0442\u0438\u0445 \u0432\u0438\u043F\u0430\u0434\u043A\u0456\u0432, \u043A\u043E\u043B\u0438
      \u043D\u0438\u043C\u0438 \u043A\u0435\u0440\u0443\u0454 \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0430
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0442\u0430\u0440\u0438\u0445
      \u0440\u0435\u0436\u0438\u043C\u043D\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432.
      \u0423 \u0446\u044C\u043E\u043C\u0443 \u0440\u0430\u0437\u0456 \u0432\u043E\u043D\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438 \u043F\u043E\u0440\u0443\u0448\u043D\u0438\u043A\u0430
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0430\u043B\u043E\u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241105
    m_Localized: "\u0412\u0435\u0440\u0442\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241106
    m_Localized: "\u041B\u0456\u0442\u0430\u044E\u0447\u0438\u0439 \u0440\u043E\u0431\u043E\u0442-\u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A,
      \u044F\u043A\u0438\u0439 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0456 \u0437\u0431\u043E\u0440\u0443 \u0434\u0430\u043D\u0438\u0445 \u0443
      \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0443\u043C\u043E\u0432\u0430\u0445.
      \u041C\u043E\u0436\u0435 \u044F\u043A \u0434\u0456\u044F\u0442\u0438 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E,
      \u0442\u0430\u043A \u0456 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0440\u0430\u0434\u0456\u043E\u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443,
      \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0447\u0438 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F \u0437 \u043A\u0430\u043C\u0435\u0440\u0438
      \u0440\u043E\u0431\u043E\u0442\u0430 \u043F\u0440\u044F\u043C\u043E \u043D\u0430
      \u0432\u0456\u0437\u043E\u0440 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430.
      \u0422\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0456 \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0432 \u0431\u043E\u044E - \u043B\u043E\u043F\u0430\u0442\u0456 \u0439\u043E\u0433\u043E
      \u043F\u0440\u043E\u043F\u0435\u043B\u0435\u0440\u0430 \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0456
      \u0437 \u043C\u0456\u0446\u043D\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0443
      \u0456 \u0433\u043E\u0441\u0442\u0440\u043E \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u0456,
      \u0442\u043E\u0436 \u0446\u0456\u043B\u043A\u043E\u043C \u043F\u0440\u0438\u0434\u0430\u0442\u043D\u0456
      \u044F\u043A \u0440\u0456\u0436\u0443\u0447\u0430 \u0437\u0431\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241107
    m_Localized: "\u0420\u043E\u043B\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241108
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0456 \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438, \u0449\u043E \u043D\u0430\u0433\u0430\u0434\u0443\u044E\u0442\u044C
      \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0456 \u043C'\u044F\u0447\u0456.
      \u041F\u0440\u0438 \u043F\u043E\u044F\u0432\u0456 \u0432 \u043F\u043E\u043B\u0456
      \u0437\u043E\u0440\u0443 \u0432\u043E\u0440\u043E\u0436\u043E\u0433\u043E \u043E\u0431'\u0454\u043A\u0442\u0430
      \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C \u043A\u043E\u0442\u0438\u0442\u0438\u0441\u044F
      \u0434\u043E \u043D\u044C\u043E\u0433\u043E, \u043F\u0440\u0430\u0433\u043D\u0443\u0447\u0438
      \u0437\u0430\u0432\u0434\u0430\u0442\u0438 \u0443\u0434\u0430\u0440\u0443 \u0456
      \u0432\u0440\u0430\u0437\u0438\u0442\u0438 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C
      \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u043C \u0440\u043E\u0437\u0440\u044F\u0434\u043E\u043C,
      \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0432\u0438\u0441\u043E\u043A\u043E \u043F\u0456\u0434\u0441\u0442\u0440\u0438\u0431\u0443\u0432\u0430\u0442\u0438
      \u0456 \u0432\u0456\u0434\u0441\u043A\u0430\u043A\u0443\u0432\u0430\u0442\u0438
      \u0432\u0456\u0434 \u0441\u0442\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241109
    m_Localized: "\u0420\u043E\u043B\u0435\u0440 \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241110
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0439 \u0440\u043E\u043B\u0435\u0440,
      \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u0438\u0439 \u0432\u043B\u0430\u0441\u043D\u0438\u043C
      \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0438\u043C \u043C\u0456\u043D\u0456-\u0440\u0435\u0430\u043A\u0442\u043E\u0440\u043E\u043C,
      \u044F\u043A\u0438\u0439 \u043D\u0430\u0434\u0430\u0454 \u0439\u043E\u043C\u0443
      \u0432\u0435\u043B\u0438\u043A\u0443 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0432\u0438\u0431\u0443\u0445\u043E\u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0441\u0442\u044C.
      \u0423 \u043A\u043E\u043C\u0431\u0456\u043D\u0430\u0446\u0456\u0457 \u0437
      \u0432\u0438\u0441\u043E\u043A\u043E\u044E \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044E
      \u0456 \u0432\u0438\u043D\u044F\u0442\u043A\u043E\u0432\u043E \u043C\u0456\u0446\u043D\u0438\u043C
      \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u043C, \u0446\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0447\u0438\u043C\u0430\u043B\u0443 \u0437\u0430\u0433\u0440\u043E\u0437\u0443"
    m_Metadata:
      m_Items: []
