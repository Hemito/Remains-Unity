  - m_Id: 2725242177
    m_Localized: "\u0414\u043E\u043F\u043E\u0432\u043D\u0435\u043D\u043D\u044F \u0434\u043E
      \u043C\u0435\u0434\u0438\u0447\u043D\u043E\u0433\u043E \u043C\u043E\u0434\u0443\u043B\u044F
      \u041F\u0456\u043F\u0411\u0430\u043A\u0430. \u041F\u043E\u0441\u0442\u0456\u0439\u043D\u043E
      \u0441\u0442\u0435\u0436\u0438\u0442\u044C \u0437\u0430 \u0432\u0430\u0448\u0438\u043C
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F\u043C, \u0437\u0430 \u043F\u043E\u044F\u0432\u0438
      \u043F\u0440\u044F\u043C\u043E\u0457 \u0437\u0430\u0433\u0440\u043E\u0437\u0438
      \u0434\u043B\u044F \u0436\u0438\u0442\u0442\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E
      \u0437\u0430\u0434\u0456\u044E\u0454 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C, \u0449\u043E \u0434\u0430\u0441\u0442\u044C
      \u0432\u0430\u043C \u0437\u043C\u043E\u0433\u0443 \u0432\u0438\u0436\u0438\u0442\u0438
      \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C \u0443 \u0440\u0430\u0437\u0456
      \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438. \u041F\u0456\u0441\u043B\u044F \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0434\u043E\u0441\u0438\u0442\u044C
      \u0442\u0440\u0438\u0432\u0430\u043B\u0438\u0439 \u0447\u0430\u0441 \u043D\u0430
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443."
