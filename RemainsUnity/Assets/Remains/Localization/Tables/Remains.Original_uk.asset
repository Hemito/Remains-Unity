      \u0432 \u0456\u0441\u0442\u043E\u0440\u0456\u044E \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043E\u0431\u0456\u0434\u043D\u044C\u043E\u0457 \u043F\u0435\u0440\u0435\u0440\u0432\u0438.
      \u0417\u0430\u0431\u0440\u0443\u0434\u043D\u0438\u043B\u0430\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u043E\u044E
      \u043D\u0430\u0437\u0430\u0434 \u043D\u0430 \u0440\u043E\u0431\u043E\u0447\u0435
      \u043C\u0456\u0441\u0446\u0435 \u0456 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
      \u043F\u043E\u043C\u0438\u0442\u0438 \u043A\u043E\u043F\u0438\u0442\u0430 \u0431\u0456\u043B\u044F
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E \u0443\u043C\u0438\u0432\u0430\u043B\u044C\u043D\u0438\u043A\u0430.
      \u0422\u0456\u043B\u044C\u043A\u0438 \u043E\u0441\u044C \u0437\u0430 \u0443\u043C\u0438\u0432\u0430\u043B\u044C\u043D\u0438\u043A
      \u0432\u043E\u043D\u0430 \u043F\u0440\u0438\u043C\u0443\u0434\u0440\u0438\u043B\u0430\u0441\u044F
      \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438 \u043F\u0440\u043E\u043C\u0438\u0441\u043B\u043E\u0432\u0438\u0439
      \u0432\u043E\u0434\u043D\u0438\u0439 \u0440\u0456\u0437\u0430\u043A. \"\u041A\u0440\u0430\u043F\u043B\u044F
      \u0432\u043E\u0434\u0438 \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0434\u0456
