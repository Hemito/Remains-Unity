  - m_Id: 2729435467
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0420\u0435\u043C\u043E\u043D\u0442\"
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0432\u0430\u043C \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u0432\u0430\u0448\u0443 \u0437\u0431\u0440\u043E\u044E \u0456 \u0431\u0440\u043E\u043D\u044E
      \u0432 \u0440\u043E\u0431\u043E\u0447\u043E\u043C\u0443 \u0441\u0442\u0430\u043D\u0456
      \u0442\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0440\u0456\u0437\u043D\u0456 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438.
      [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C \u0440\u0435\u043C\u043E\u043D\u0442\u0443
      \u043D\u0430 #1 (\u0437\u0430 #2 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u0445)
      \u0456 \u0448\u043A\u043E\u0434\u0438 \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457 \u043D\u0430 #3.[br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C
      \u0440\u0456\u0432\u043D\u0435\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438
      \u0441\u0442\u0430\u044E\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
      \u043D\u043E\u0432\u0456 \u0441\u0445\u0435\u043C\u0438 \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0438
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438,
      \u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0430\u0431\u043E \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0430\u0442\u0438
      \u0432\u0441\u0435 \u0431\u0456\u043B\u044C\u0448 \u0441\u043A\u043B\u0430\u0434\u043D\u0456
      \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435468
    m_Localized: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435469
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430\"
      \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0432\u043F\u043B\u0438\u0432\u0430\u0454 \u043D\u0430 \u0432\u0430\u0448\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0456 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C
      \u0437\u0446\u0456\u043B\u044E\u0432\u0430\u0442\u0438 \u0441\u0435\u0431\u0435,
      \u043D\u0435 \u0432\u0434\u0430\u044E\u0447\u0438\u0441\u044C \u0434\u043E
      \u043F\u043E\u0441\u043B\u0443\u0433 \u043C\u0435\u0434\u0438\u043A\u0456\u0432.
      [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u044C\u0441\u044F
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0445
      \u0437\u0456\u043B\u044C \u0442\u0430 \u0456\u043D\u0448\u0438\u0445 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u0456\u0432
      \u043D\u0430 #1 (\u0437\u0430 #2 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u0445).[br]-
      \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0431\u0443\u0434\u0435 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u0437\u0434\u043E\u0440\u043E\u0432'\u044F,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0432\u0441\u0435 \u0431\u0456\u043B\u044C\u0448 \u0441\u043A\u043B\u0430\u0434\u043D\u0456
      \u043C\u0435\u0434\u0438\u0447\u043D\u0456 \u0437\u0430\u0441\u043E\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435470
    m_Localized: "\u0417\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435471
    m_Localized: "\u041D\u0430\u0432\u0438\u0447\u043A\u0430 \"\u0417\u043B\u043E\u043C\"
      \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u0432\u0430\u043C \u0432\u0456\u0434\u043C\u0438\u043A\u0430\u0442\u0438
      \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u0456 \u0437\u0430\u043C\u043A\u0438.
      [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u043C
      \u043E\u0447\u043A\u043E\u043C \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
      \u0443\u0441\u043F\u0456\u0448\u043D\u043E\u0433\u043E \u0437\u043B\u043E\u043C\u0443
      \u0437\u0430\u043C\u043A\u0430 \u0431\u0443\u0434\u0435 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
      \u0430 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u0438
      \u0437\u0430\u043C\u043E\u043A - \u0437\u043C\u0435\u043D\u0448\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
      [br]- \u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C
      \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u043B\u0430\u043C\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u043C\u043A\u0438
      \u0432\u0441\u0435 \u0431\u0456\u043B\u044C\u0448 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0445
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435472
    m_Localized: "\u041D\u0430\u0443\u043A\u0430"
