    m_Metadata:
      m_Items: []
  - m_Id: 2725241552
    m_Localized: "\u041C\u0456\u0441\u044F\u0447\u043D\u0430 \u0430\u043B\u0435\u0431\u0430\u0440\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241553
    m_Localized: "\u0417\u0431\u0440\u043E\u044F \u0437 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443
      \u0431\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430.
      \u0421\u0442\u0432\u043E\u0440\u0435\u043D\u0430 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043C\u0430\u0433\u0456\u0457 \u043F\u0440\u0438\u043C\u0430\u0440\u043D\u0430
      \u0430\u043B\u0435\u0431\u0430\u0440\u0434\u0430, \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u043B\u0435\u0433\u043A\u0430, \u0433\u043E\u0441\u0442\u0440\u0430 \u0456
      \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u043B\u0430\u043C\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241554
    m_Localized: "\u0421\u043E\u043D\u044F\u0447\u043D\u0438\u0439 \u0432\u0456\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241555
    m_Localized: "\u0417\u0431\u0440\u043E\u044F \u0437 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443
      \u0431\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430.
      \u0417\u0430 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u043C \u0434\u0456\u0457
      \u0441\u0445\u043E\u0436\u0430 \u0437 \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u044E,
      \u0430\u043B\u0435 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u043A\u0443\u043B\u0456 \u0432 \u043D\u0456\u0439 \u0441\u0442\u0432\u043E\u0440\u044E\u044E\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241556
    m_Localized: "\u0422\u0443\u043C\u0430\u043D\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241557
    m_Localized: "\u0417\u0431\u0440\u043E\u044F \u0437 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443
      \u0431\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430.
      \u0417\u0430 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u043C \u0434\u0456\u0457
      \u0441\u0445\u043E\u0436\u0430 \u043D\u0430 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0443,
      \u0430\u043B\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u0431\u0430\u0442\u0430\u0440\u0435\u044E, \u0449\u043E \u0437\u0430\u0440\u044F\u0434\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E
      \u0432\u0456\u0434 \u0434\u0436\u0435\u0440\u0435\u043B\u0430 \u0435\u043D\u0435\u0440\u0433\u0456\u0457
      \u0441\u0430\u043C\u043E\u0457 \u0431\u0440\u043E\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241558
    m_Localized: "\u0421\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241559
    m_Localized: "\u0417\u0431\u0440\u043E\u044F \u0437 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443
      \u0431\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430.
      \u0417\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0447\u0430\u0441
      \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454 \u0431\u0435\u0437\u043B\u0456\u0447
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432,
      \u044F\u043A\u0456 \u043F\u0440\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456
      \u0437 \u0446\u0456\u043B\u043B\u044E \u0432\u0438\u0431\u0443\u0445\u0430\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241560
    m_Localized: "\u041F\u043E\u043B\u044F\u0440\u043D\u0435 \u0441\u044F\u0439\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241561
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0435 \u0432 \u0431\u0440\u043E\u043D\u044E
      \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430. \u0421\u0442\u0432\u043E\u0440\u044E\u0454
      \u0441\u043F\u043B\u0435\u0441\u043A\u0438 \u0440\u0443\u0439\u043D\u0456\u0432\u043D\u043E\u0457
      \u043A\u043E\u0441\u043C\u0456\u0447\u043D\u043E\u0457 \u0435\u043D\u0435\u0440\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241562
    m_Localized: "\u041A\u043E\u043C\u0431\u0456\u043D\u0435\u0437\u043E\u043D \u0421\u0442\u0456\u0439\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241563
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u043E\u0434\u044F\u0433,
      \u044F\u043A\u0438\u0439 \u043D\u043E\u0441\u044F\u0442\u044C \u0443\u0441\u0456
      \u0436\u0438\u0442\u0435\u043B\u0456 \u0421\u0442\u0456\u0439\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241566
    m_Localized: "\u041F\u043E\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u043A\u043E\u043C\u0431\u0456\u043D\u0435\u0437\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241567
    m_Localized: "\u041A\u043E\u043C\u0431\u0456\u043D\u0435\u0437\u043E\u043D \u0421\u0442\u0456\u0439\u043B\u0430
      \u0437 \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u043E\u0457 \u0442\u043A\u0430\u043D\u0438\u043D\u0438.
      \u0417\u0430\u0445\u0438\u0449\u0430\u0454 \u0442\u0430\u043A \u0441\u043E\u0431\u0456,
      \u0430\u043B\u0435 \u0432\u0441\u0435 \u0436 \u0446\u0435 \u043A\u0440\u0430\u0449\u0435,
      \u043D\u0456\u0436 \u043D\u0456\u0447\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241568
    m_Localized: "\u0410\u043D\u0442\u0438\u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0439\u043D\u0438\u0439
      \u043A\u043E\u0441\u0442\u044E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241569
    m_Localized: "\u041A\u043E\u0441\u0442\u044E\u043C \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438
      \u0432 \u043C\u0456\u0441\u0446\u044F\u0445 \u0456\u0437 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0438\u043C
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0439\u043D\u0438\u043C \u0444\u043E\u043D\u043E\u043C.
      \u041C\u0430\u0454 \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0456 \u0444\u0456\u043B\u044C\u0442\u0440\u0438
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F. \u0422\u0430\u043A\u043E\u0436
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454 \u0434\u0438\u0445\u0430\u0442\u0438
      \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241570
    m_Localized: "\u041A\u043E\u0441\u0442\u044E\u043C \u0445\u0456\u043C\u0437\u0430\u0445\u0438\u0441\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241571
    m_Localized: "\u0413\u0443\u043C\u043E\u0432\u0438\u0439 \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440,
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439 \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438
      \u0432 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u043E\u043C\u0443 \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0456.
      \u041C\u0430\u0454 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438
      \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u043E\u0442\u0440\u0443\u0442
      \u0456 \u043A\u0438\u0441\u043B\u043E\u0442\u0438, \u0430\u043B\u0435, \u0441\u0445\u043E\u0436\u0435,
      \u043F\u043E\u0434\u0435\u043A\u0443\u0434\u0438 \u0432 \u043D\u044C\u043E\u0433\u043E
      \u0440\u043E\u0437\u0441\u043E\u0445\u043B\u0438\u0441\u044F \u0443\u0449\u0456\u043B\u044C\u043D\u044E\u0432\u0430\u0447\u0456,
      \u0442\u043E\u0436 \u0437\u0430\u0445\u0438\u0441\u0442 \u043D\u0435 \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0438\u0439.
      \u0422\u0430\u043A\u043E\u0436 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454
      \u0434\u0438\u0445\u0430\u0442\u0438 \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241572
    m_Localized: "\u0428\u043A\u0456\u0440\u044F\u043D\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241573
    m_Localized: "\u0411\u0440\u043E\u043D\u044F, \u0437\u0448\u0438\u0442\u0430
      \u0437 \u0442\u043E\u0432\u0441\u0442\u0438\u0445 \u0448\u043A\u0443\u0440
      \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u0430
      \u0437 \u041F\u0443\u0441\u0442\u043E\u043A. \u0414\u0430\u0454 \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0431\u0456\u043B\u044C\u0448\u043E\u0441\u0442\u0456
      \u0432\u0438\u0434\u0456\u0432 \u0448\u043A\u043E\u0434\u0438, \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0432\u0456\u0434 \u0432\u043E\u0433\u043D\u044E, \u0430\u043B\u0435 \u043E\u0441\u044C
      \u043A\u0443\u043B\u0456 \u0437\u0443\u043F\u0438\u043D\u044F\u0454 \u043F\u043E\u0433\u0430\u043D\u0435\u043D\u044C\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241574
    m_Localized: "\u041C\u0435\u0442\u0430\u043B\u0435\u0432\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241575
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u043E\u0433\u043E
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430, \u0449\u043E
      \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u043F\u043E\u0433\u0430\u043D\u043E
      \u0441\u043A\u0440\u0456\u043F\u043B\u0435\u043D\u0438\u0445 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D. \u0425\u043E\u0447\u0430 \u0432\u043E\u043D\u0430
      \u0456 \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454
      \u0432\u0456\u0434 \u043A\u0443\u043B\u044C, \u0430\u043B\u0435 \u043F\u0440\u0438
      \u0446\u044C\u043E\u043C\u0443 \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043A\u0430
      \u0456 \u0441\u043A\u043E\u0432\u0443\u0454 \u0440\u0443\u0445\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241576
    m_Localized: "\u0411\u043E\u0439\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241577
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E\u0457
      \u044F\u043A\u043E\u0441\u0442\u0456, \u043E\u0441\u043D\u043E\u0432\u0443
      \u044F\u043A\u043E\u0457 \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0438 \u0437\u0456 \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0445
      \u043F\u043E\u043B\u0456\u043C\u0435\u0440\u0456\u0432 \u0456 \u043A\u0435\u0440\u0430\u043C\u0456\u043A\u0438.
      \u041F\u043E\u043A\u043B\u0438\u043A\u0430\u043D\u0430 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0431\u0430\u043B\u0456\u0441\u0442\u0438\u0447\u043D\u0438\u0439
      \u0437\u0430\u0445\u0438\u0441\u0442, \u043C\u0430\u044E\u0447\u0438 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u043C\u0430\u043B\u0443
      \u0432\u0430\u0433\u0443 \u0456 \u043D\u0435 \u043E\u0431\u043C\u0435\u0436\u0443\u044E\u0447\u0438
      \u0440\u0443\u0445\u0456\u0432 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241578
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241579
    m_Localized: "\u0423\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0435\u043D\u0430
      \u0431\u043E\u0439\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
      \u0435\u043B\u0456\u0442\u043D\u0438\u0445 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u0445
      \u0437\u0430\u0433\u043E\u043D\u0456\u0432. \u0417\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0443\u0454
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0441\u0435\u0440\u0435\u0434 \u0443\u0441\u0456\u0445 \u0432\u0438\u0434\u0456\u0432
      \u0431\u0440\u043E\u043D\u0456, \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0447\u0438\u0441\u044C
      \u043B\u0438\u0448\u0435 \u0441\u0438\u043B\u043E\u0432\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241580
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241581
    m_Localized: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0430 \u0431\u0440\u043E\u043D\u044F,
      \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0430 \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u0449\u043E\u0431 \u043F\u0440\u043E\u0442\u0438\u0434\u0456\u044F\u0442\u0438
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u043C
      \u0432\u043F\u043B\u0438\u0432\u0430\u043C. \u0412\u0456\u0434 \u043A\u0443\u043B\u044C
      \u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u0444\u0456\u0437\u0438\u0447\u043D\u0438\u0445
      \u0430\u0442\u0430\u043A \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0441\u043B\u0430\u0431\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241582
    m_Localized: "\u041C\u0456\u0441\u044F\u0447\u043D\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241583
    m_Localized: "\u0411\u0440\u043E\u043D\u044F, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
      \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u043C\u0430\u0433\u0456\u0432.
      \u0412\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0456 \u0442\u0430\u043B\u0456\u0441\u043C\u0430\u043D\u0438
      \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0430\u0445\u0438\u0449\u0430\u044E\u0442\u044C
      \u0432\u0456\u0434 \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445
      \u0432\u043F\u043B\u0438\u0432\u0456\u0432, \u0430 \u0439 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u044E\u0442\u044C
      \u0441\u0438\u043B\u0443 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241584
    m_Localized: "\u0425\u0456\u0442\u0438\u043D\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241585
    m_Localized: "\u041B\u0435\u0433\u043A\u0430 \u0456 \u043C\u0456\u0446\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F \u0437 \u0442\u043E\u0432\u0441\u0442\u0438\u0445
      \u0445\u0456\u0442\u0438\u043D\u043E\u0432\u0438\u0445 \u043F\u0430\u043D\u0446\u0438\u0440\u0456\u0432
      \u0440\u0430\u0434\u0441\u043A\u043E\u0440\u043F\u0456\u043E\u043D\u0456\u0432.
      \u0411\u0430\u0437\u043E\u0432\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0437\u043D\u0430\u0447\u043D\u043E
      \u043F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u0438\u0439. \u0414\u0430\u0454
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442
      \u0432\u0456\u0434 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u0444\u0456\u0437\u0438\u0447\u043D\u0438\u0445
      \u0430\u0442\u0430\u043A, \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E
      \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0456\u0434 \u0456\u043A\u043B\u0456\u0432
      \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432, \u0430\u043B\u0435 \u0432\u0456\u0434
      \u043A\u0443\u043B\u044C \u0456 \u043C\u0430\u0433\u0456\u0457 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u0440\u044F\u0442\u0443\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241586
    m_Localized: "\u0420\u043E\u0437\u0432\u0456\u0434\u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241587
    m_Localized: "\u041B\u0435\u0433\u043A\u0430 \u0431\u0440\u043E\u043D\u044F,
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432
      \u0456 \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u0456\u0432.
      \u0407\u0457 \u043A\u0430\u043C\u0443\u0444\u043B\u044F\u0436\u043D\u0435 \u0437\u0430\u0431\u0430\u0440\u0432\u043B\u0435\u043D\u043D\u044F
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0437\u043B\u0438\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044E \u0456
      \u0434\u0456\u044F\u0442\u0438 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u043E,
      \u0432 \u0431\u043E\u044E \u0436 \u0437\u0431\u0438\u0432\u0430\u0454 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u0437 \u043F\u0430\u043D\u0442\u0435\u043B\u0438\u043A\u0443, \u043D\u0435
      \u0434\u0430\u044E\u0447\u0438 \u044F\u043A \u0441\u043B\u0456\u0434 \u043F\u0440\u0438\u0446\u0456\u043B\u0438\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241588
    m_Localized: "\u041F\u0440\u043E\u0442\u043E\u0442\u0438\u043F \u0441\u0442\u0435\u043B\u0441-\u0431\u0440\u043E\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241589
    m_Localized: "\u0423\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0430 \u0431\u0440\u043E\u043D\u044F
      \u0437 \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u043E\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043A\u0430\u043C\u0443\u0444\u043B\u044F\u0436\u0443.
      \u0426\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0445\u043E\u0436\u0430
      \u0437\u0430 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u043C \u0434\u0456\u0457
      \u0437\u0456 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C \u0421\u0442\u0435\u043B\u0441\u0411\u0430\u043A\u043E\u043C,
      \u0430\u043B\u0435 \u0457\u0457 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043D\u0435\u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0443 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0440\u0430\u0437\u0456\u0432, \u043B\u0438\u0448\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0447\u0438
      \u043F\u0435\u0432\u043D\u043E\u0433\u043E \u0447\u0430\u0441\u0443 \u043D\u0430
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u043D\u043D\u044F.
      \u0414\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      @1 \u0430\u0431\u043E @2."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241590
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0441\u0430\u043F\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241591
    m_Localized: "\u0412\u0430\u0436\u043A\u0430, \u0430\u043B\u0435 \u043C\u0456\u0446\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F, \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E\u044E \u0430\u043C\u043E\u0440\u0442\u0438\u0437\u0443\u044E\u0447\u043E\u044E
      \u043F\u0456\u0434\u043A\u043B\u0430\u0434\u043A\u043E\u044E, \u0432\u043E\u0433\u043D\u0435\u0442\u0440\u0438\u0432\u043A\u0438\u043C
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u043C \u0448\u0430\u0440\u043E\u043C
      \u0456 \u0433\u043B\u0443\u0445\u0438\u043C \u0448\u043E\u043B\u043E\u043C\u043E\u043C.
      \u0412\u0456\u0434\u043C\u0456\u043D\u043D\u043E \u0437\u0430\u0445\u0438\u0449\u0430\u0454
      \u0432\u0456\u0434 \u0443\u0434\u0430\u0440\u0456\u0432, \u0432\u043E\u0433\u043D\u044E
      \u0442\u0430 \u0432\u0438\u0431\u0443\u0445\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241592
    m_Localized: "\u041E\u0434\u044F\u0433 \u0448\u0443\u043A\u0430\u0447\u0430 \u0441\u043A\u0430\u0440\u0431\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241593
    m_Localized: "\u041F\u043E\u043A\u0438 \u0432\u0438 \u043D\u043E\u0441\u0438\u0442\u0435
      \u0446\u0435\u0439 \u043E\u0434\u044F\u0433, \u0437 \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0432\u0431\u0438\u0442\u043E\u0433\u043E \u0432\u0430\u043C\u0438 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u043C\u043E\u0436\u0435 \u0432\u0438\u043F\u0430\u0441\u0442\u0438 \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0438\u0439
      \u043A\u0430\u043C\u0456\u043D\u044C (\u0449\u043E \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u0439
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A, \u0442\u043E
      \u0431\u0456\u043B\u044C\u0448\u0430 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C)."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241594
    m_Localized: "\u0428\u043A\u0430\u0440\u043F\u0435\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241595
    m_Localized: "\u041F\u043E\u043A\u0438 \u0432\u0438 \u043D\u043E\u0441\u0438\u0442\u0435
      \u0446\u0435\u0439 \"\u043A\u043E\u0441\u0442\u044E\u043C\", \u0440\u0435\u0439\u0434\u0435\u0440\u0438,
      \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0456 \u0442\u0430
      \u043D\u0430\u0439\u043C\u0430\u043D\u0446\u0456 \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u043D\u0430 \u0432\u0430\u0441 \u0434\u043E\u0442\u0438, \u0434\u043E\u043A\u0438
      \u0432\u0438 \u0457\u0445 \u043D\u0435 \u0441\u043F\u0440\u043E\u0432\u043E\u043A\u0443\u0454\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241596
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241597
    m_Localized: "\u0426\u044E \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E
      \u0431\u0443\u043B\u043E \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E \u043D\u0430
      \u043E\u0441\u043D\u043E\u0432\u0456 \u0431\u0440\u043E\u043D\u0456 \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432, \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u0432\u043E\u043D\u0430 \u0437\u0430\u0437\u043D\u0430\u043B\u0430 \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u0438\u0445
      \u0437\u043C\u0456\u043D \u0456 \u0441\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u044F
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457 - \u0448\u043E\u043B\u043E\u043C
      \u043F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u043E \u043F\u0456\u0434
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430, \u0434\u0435\u044F\u043A\u0456
      \u0431\u0440\u043E\u043D\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0438
      \u0437\u043D\u044F\u0442\u043E, \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0445 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0456\u0432
      \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u044F. \u041C\u0430\u0454 \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0456
      \u0437\u0430\u0445\u0438\u0441\u043D\u0456 \u044F\u043A\u043E\u0441\u0442\u0456,
      \u0430\u043B\u0435 \u0432\u0435\u043B\u0438\u043A\u0430 \u0432\u0430\u0433\u0430
      \u0437\u043D\u0430\u0447\u043D\u043E \u043E\u0431\u043C\u0435\u0436\u0443\u0454
      \u0440\u0443\u0445\u043B\u0438\u0432\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241598
    m_Localized: "\u041F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u0430
      \u0431\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241599
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0432\u0430\u0440\u0442\u043E\u0432\u0438\u0445
      \u043F\u0440\u0430\u0432\u043E\u043F\u043E\u0440\u044F\u0434\u043A\u0443, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u043C\u0430\u0439\u0436\u0435 \u0432 \u0441\u0430\u043C\u043E\u043C\u0443
      \u043A\u0456\u043D\u0446\u0456 \u0412\u0456\u0439\u043D\u0438 \u043D\u0430
      \u043E\u0441\u043D\u043E\u0432\u0456 \u0430\u0440\u043C\u0456\u0439\u0441\u044C\u043A\u043E\u0457
      \u0431\u043E\u0439\u043E\u0432\u043E\u0457 \u0431\u0440\u043E\u043D\u0456.
      \u0411\u0440\u043E\u043D\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0438
      \u0432 \u043D\u0456\u0439 \u0437\u0430\u043C\u0456\u043D\u0435\u043D\u0456
      \u043D\u0430 \u0431\u0430\u0433\u0430\u0442\u043E\u0448\u0430\u0440\u043E\u0432\u0443
      \u0430\u0440\u0430\u043C\u0456\u0434\u043D\u0443 \u0442\u043A\u0430\u043D\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241600
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241601
    m_Localized: "\u0423\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F \u0432\u0456\u0439\u0441\u044C\u043A \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F. \u041C\u0430\u0454
      \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0434\u0456\u0430\u043F\u0430\u0437\u043E\u043D
      \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0445 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A\u0456\u0432,
      \u0449\u043E \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0442\u044C \u043F\u0456\u0434
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0443 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241602
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0410\u043D\u043A\u043B\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241603
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u043E\u0431\u043B\u0435\u043D\u0430
      \u0441\u0438\u043B\u043E\u0432\u0430 \u0431\u0440\u043E\u043D\u044F \u043F\u0435\u0433\u0430\u0441\u0456\u0432
      \u0410\u043D\u043A\u043B\u0430\u0432\u0443. \u041F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E
      \u0437 \u0441\u0438\u043B\u043E\u0432\u043E\u044E \u0431\u0440\u043E\u043D\u0435\u044E
      \u0421\u0442\u0430\u043B\u0435\u0432\u0438\u0445 \u0420\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u0456\u0432,
      \u0446\u044F - \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043B\u0435\u0433\u0448\u0430
      \u0456 \u0431\u0456\u043B\u044C\u0448\u0435 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0430
      \u043D\u0430 \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u043C\u0430\u0433\u0456\u0457,
      \u043D\u0456\u0436 \u0432\u0456\u0434 \u0444\u0456\u0437\u0438\u0447\u043D\u0438\u0445
      \u0432\u043F\u043B\u0438\u0432\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241604
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \"\u0417\u0430\u0442\u0435\u043C\u043D\u0435\u043D\u043D\u044F\""
    m_Metadata:
      m_Items: []
  - m_Id: 2725241605
    m_Localized: "\u0415\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 -
      \u0443\u0441\u0435, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0432\u0456\u0434 \"\u0411\u0440\u043E\u043D\u0456 \u0410\u043B\u0456\u043A\u043E\u0440\u043D\u0430\".
      \u0412\u0456\u043D \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u0430\u0454
      \u043C\u0430\u0433\u0456\u0447\u043D\u0438\u0445 \u043F\u0456\u0434\u0441\u0438\u043B\u0435\u043D\u044C,
      \u0430\u043B\u0435 \u0441\u0430\u043C \u043F\u043E \u0441\u043E\u0431\u0456
      \u0434\u043E\u0432\u043E\u043B\u0456 \u043C\u0456\u0446\u043D\u0438\u0439 \u0456
      \u043B\u0435\u0433\u043A\u0438\u0439, \u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u0435
      - \u0434\u0430\u0454 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043B\u0456\u0442\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241606
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0441\u043E\u043B\u0434\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241607
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0456\u0437 \u0441\u043E\u043B\u0434\u0430\u0442\u0441\u044C\u043A\u043E\u0433\u043E
      \u0436\u0435\u0442\u043E\u043D\u0430, \u043D\u0430 \u044F\u043A\u043E\u043C\u0443
      \u0432\u0438\u0434\u043D\u043E \u0433\u043B\u0438\u0431\u043E\u043A\u0443 \u0432\u043C'\u044F\u0442\u0438\u043D\u0443
      \u0432\u0456\u0434 \u043A\u0443\u043B\u0456. \u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
      \u0436\u0435\u0442\u043E\u043D \u0437\u0443\u043F\u0438\u043D\u0438\u0432 \u043A\u0443\u043B\u044E
      \u0456 \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0432
      \u0436\u0438\u0442\u0442\u044F \u0441\u0432\u043E\u0454\u043C\u0443 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u043E\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241608
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u043C\u0435\u0445\u0430\u043D\u0456\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241609
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u043E
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u0437 \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0438\u0445
      \u0434\u0440\u043E\u0442\u0438\u043A\u0456\u0432, \u0431\u043E\u043B\u0442\u0438\u043A\u0456\u0432
      \u0456 \u0448\u0435\u0441\u0442\u0435\u0440\u0435\u043D\u044C, \u0449\u043E
      \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C \u0446\u0456\u043A\u0430\u0432\u0443
      \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241610
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0441\u0430\u043F\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241611
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0456\u0437 \u0434\u0435\u0442\u043E\u043D\u0430\u0442\u043E\u0440\u0430 \u043F\u0440\u043E\u0442\u0438\u043F\u0456\u0445\u043E\u0442\u043D\u043E\u0457
      \u043C\u0456\u043D\u0438, \u0449\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432,
      \u043D\u0430\u0434\u0456\u043B\u0435\u043D\u0438\u0439 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435\u0432\u043B\u043E\u0432\u0438\u043C\u043E\u044E \u043C\u0430\u0433\u0456\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241612
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0434\u0438\u043A\u0443\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241613
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0437 \u0456\u043A\u043B\u0430
      \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u0445\u0438\u0436\u0430\u043A\u0430, \u043F\u0440\u0438\u043A\u0440\u0430\u0448\u0435\u043D\u043E\u0433\u043E
      \u043F\u0456\u0440'\u044F\u043C. \u0419\u043E\u0433\u043E \u043C\u0430\u0433\u0456\u044F
      \u043C\u0430\u0454 \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438 \u0432\u0456\u0434
      \u0434\u0438\u043A\u0438\u0445 \u0437\u0432\u0456\u0440\u0456\u0432 \u0456
      \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241614
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u043F\u0456\u0440\u043E\u043C\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241615
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0430\u043C\u0443\u043B\u0435\u0442,
      \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439 \u0456\u0437 \u0432\u043E\u0433\u043D\u044F\u043D\u043E\u0433\u043E
      \u0430\u0433\u0430\u0442\u0443. \u041F\u0440\u043E\u0442\u0438\u0434\u0456\u0454
      \u0441\u043F\u0435\u0446\u0456 \u0442\u0430 \u0432\u043E\u0433\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241616
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0447\u0430\u0440\u043E\u0434\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241617
    m_Localized: "\u041C\u043E\u0433\u0443\u0442\u043D\u0456\u0439 \u0430\u043C\u0443\u043B\u0435\u0442,
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439 \u0432\u0435\u043B\u0438\u043A\u0438\u043C
      \u0447\u0430\u0440\u0456\u0432\u043D\u0438\u043A\u043E\u043C. \u0417\u0430\u0445\u0438\u0449\u0430\u0454
      \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430 \u0432\u0456\u0434 \u0432\u043E\u0440\u043E\u0436\u043E\u0457
      \u043C\u0430\u0433\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241618
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0442\u0456\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241619
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439
      \u0437\u0435\u0431\u0440\u0430\u043C\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u0457\u0445\u043D\u044C\u043E\u0457 \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u043E\u0457
      \u0442\u0430 \u0437\u043B\u043E\u0432\u0456\u0441\u043D\u043E\u0457 \u043C\u0430\u0433\u0456\u0457.
      \u041F\u043E\u043A\u0440\u0430\u0449\u0443\u0454 \u0441\u043A\u0440\u0438\u0442\u043D\u0456\u0441\u0442\u044C
      \u0456 \u0443\u0445\u0438\u043B\u0435\u043D\u043D\u044F \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241620
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u043F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044F
      \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241621
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442, \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439
      \u0434\u043B\u044F \u043F\u0435\u0433\u0430\u0441\u0456\u0432, \u044F\u043A\u0456
      \u043C\u0430\u044E\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0443 \u0437
      \u0433\u0440\u043E\u0437\u043E\u0432\u0438\u043C\u0438 \u0445\u043C\u0430\u0440\u0430\u043C\u0438.
      \u0414\u0443\u0436\u0435 \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0454
      \u0432\u0456\u0434 \u0443\u0434\u0430\u0440\u0456\u0432 \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241622
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0447\u043E\u0440\u043D\u043E\u043A\u043D\u0438\u0436\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241623
    m_Localized: "\u0410\u043C\u0443\u043B\u0435\u0442 \u0456\u0437 \u043F\u043E\u043B\u0456\u0440\u043E\u0432\u0430\u043D\u043E\u0457
