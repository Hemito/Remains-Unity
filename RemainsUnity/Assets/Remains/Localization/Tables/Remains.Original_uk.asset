      m_Items: []
  - m_Id: 2725241481
    m_Localized: "\u0416\u0430\u0440-\u044F\u0439\u0446\u0435, \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0435
      \u043D\u0430 \u043C\u0456\u043D\u0443. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0431\u0443\u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C
      \u043C\u0430\u0439\u0441\u0442\u0440\u043E\u043C \u0443 \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u0456
      \u0437 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u043E\u044E, \u0449\u043E\u0431
      \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043F\u043E\u0434\u0456\u0431\u043D\u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456
      \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241482
    m_Localized: "\u0417\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0430 \u043C\u0456\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241483
    m_Localized: "\u0426\u044F \u043C\u0456\u043D\u0430 \u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0430
      \u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0443 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432\u0443
      \u0442\u0430 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0443, \u0430 \u0447\u0435\u0440\u0435\u0437
      \u043A\u0430\u043C\u0443\u0444\u043B\u044F\u0436\u043D\u0435 \u0437\u0430\u0431\u0430\u0440\u0432\u043B\u0435\u043D\u043D\u044F
      \u0457\u0457 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435 \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u0438.
      \u041A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0437\u0435\u0431\u0440\u0438,
      \u044F\u043A\u0456 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C
      \u0442\u0430\u043A\u0456 \u043C\u0456\u043D\u0438, \u0447\u0430\u0441\u0442\u043E
      \u043D\u0430\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C \u043D\u0430 \u043D\u0438\u0445
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F \u043A\u0430\u0439\u0434\u0430\u043D\u0456\u0432,
      \u0449\u043E \u0440\u043E\u0431\u0438\u0442\u044C \u0457\u0445 \u0449\u0435
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241484
    m_Localized: "\u0412\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430 X-37"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241485
    m_Localized: "\u041D\u0435\u0432\u0435\u043B\u0438\u043A\u0456, \u0430\u043B\u0435
      \u043F\u043E\u0442\u0443\u0436\u043D\u0456 \u0437\u0430\u0440\u044F\u0434\u0438
      \u043F\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0457 \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438,
      \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0456 \u0440\u0430\u0434\u0456\u043E\u0434\u0435\u0442\u043E\u043D\u0430\u0442\u043E\u0440\u043E\u043C.
      \u041C\u043E\u0436\u043D\u0430 \u0437\u0430\u043A\u043B\u0430\u0441\u0442\u0438
      \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0437\u0430\u0440\u044F\u0434\u0456\u0432, \u0430 \u043F\u043E\u0442\u0456\u043C
      \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E
      \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u043D\u043D\u044F\u043C \u043A\u043D\u043E\u043F\u043A\u0438.
      \u0414\u043B\u044F \u0434\u0435\u0442\u043E\u043D\u0430\u0446\u0456\u0457 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438
      [R]. \u0412\u0438\u0431\u0443\u0445\u043D\u0443\u0442\u044C \u0442\u0456\u043B\u044C\u043A\u0438
      \u0437\u0430\u0440\u044F\u0434\u0438, \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456
      \u0432 \u043E\u0434\u043D\u0456\u0439 \u043A\u0456\u043C\u043D\u0430\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241486
    m_Localized: "\u0417\u0432'\u044F\u0437\u043A\u0430 \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241487
    m_Localized: "\u041A\u0456\u043B\u044C\u043A\u0430 \u0434\u0438\u043D\u0430\u043C\u0456\u0442\u043D\u0438\u0445
      \u0448\u0430\u0448\u043E\u043A, \u0441\u043A\u0440\u0443\u0447\u0435\u043D\u0438\u0445
      \u0440\u0430\u0437\u043E\u043C \u0456\u0437\u043E\u043B\u044F\u0446\u0456\u0439\u043D\u043E\u044E
      \u0441\u0442\u0440\u0456\u0447\u043A\u043E\u044E. \u0411\u0456\u043B\u044C\u0448
      \u0437\u0440\u0443\u0447\u043D\u0438\u0439 \u0437\u0430\u0441\u0456\u0431 \u0440\u0443\u0439\u043D\u0443\u0432\u0430\u043D\u043D\u044F
      \u0441\u0442\u0456\u043D, \u043D\u0456\u0436 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0434\u0438\u043D\u0430\u043C\u0456\u0442, \u0430\u043B\u0435 \u043C\u0456\u0446\u043D\u043E\u043C\u0443
      \u0431\u0435\u0442\u043E\u043D\u0443 \u043D\u0435 \u0437\u0430\u0432\u0434\u0430\u0454
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241488
    m_Localized: "\u0421\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0430 \u0431\u043E\u043C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241489
    m_Localized: "\u0412\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430 \u043D\u0430
      \u043E\u0441\u043D\u043E\u0432\u0456 \u0442\u0440\u043E\u0442\u0438\u043B\u0443,
      \u0441\u0442\u0430\u043D\u0435 \u0432 \u043F\u0440\u0438\u0433\u043E\u0434\u0456
      \u0434\u043B\u044F \u0440\u0443\u0439\u043D\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0435 \u0434\u0443\u0436\u0435 \u043C\u0456\u0446\u043D\u0438\u0445
      \u0441\u0442\u0456\u043D. \u041C\u0456\u0446\u043D\u0456 \u0441\u0442\u0456\u043D\u0438
      \u043C\u043E\u0436\u0435 \u043D\u0435 \u0432\u0437\u044F\u0442\u0438 \u0437
      \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241490
    m_Localized: "\u0412\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0430 C-4"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241491
    m_Localized: "\u0414\u0443\u0436\u0435 \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u0439
      \u0432\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439,
      \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u0437\u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0439\u043C\u0456\u0446\u043D\u0456\u0448\u0443
      \u0431\u0435\u0442\u043E\u043D\u043D\u0443 \u0441\u0442\u0456\u043D\u0443.
      \u041F\u0440\u043E\u0442\u0438 \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u0445
      \u0441\u0442\u0456\u043D \u043C\u0430\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241492
    m_Localized: "\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0430
      \u043A\u0443\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241493
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u0438\u0442\u0438
      \u0432 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u043E\u0432\u0430\u043D\u0438\u043C
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0438\u043C
      \u043F\u043E\u043B\u0435\u043C, \u0449\u043E \u0437\u0430\u0432\u0434\u0430\u0454
      \u0443\u0434\u0430\u0440\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438 \u0456
      \u0432\u0456\u0434\u043A\u0438\u0434\u0430\u0454 \u0439\u043E\u0433\u043E \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241494
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241495
    m_Localized: "\u041E\u0434\u043D\u0435 \u0437 \u0431\u0430\u0437\u043E\u0432\u0438\u0445
      \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C,
      \u0449\u043E \u0432\u0438\u0441\u0442\u0440\u0456\u043B\u044E\u0454 \u0432
      \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043F\u0440\u043E\u0441\u0442\u0438\u0439
      \u0441\u043D\u0430\u0440\u044F\u0434 \u0437 \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457. \u0417\u0430 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u043C
      \u0434\u0456\u0457 \u0446\u0435\u0439 \u0441\u043D\u0430\u0440\u044F\u0434
      \u043D\u0430\u0433\u0430\u0434\u0443\u0454 \u043F\u043B\u0430\u0437\u043C\u043E\u0432\u0443
      \u0437\u0431\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241496
    m_Localized: "\u041A\u0440\u0438\u0436\u0430\u043D\u0438\u0439 \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241497
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043E\u0431\u0440\u0443\u0448\u0443\u0454 \u043D\u0430 \u0432\u043E\u0440\u043E\u0433\u0430
      \u0448\u043A\u0432\u0430\u043B \u0433\u043E\u0441\u0442\u0440\u0438\u0445 \u043A\u0440\u0438\u0436\u0438\u043D\u043E\u043A,
      \u0449\u043E \u0440\u0430\u043D\u044F\u0442\u044C \u0456 \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0443\u044E\u0442\u044C
      \u0439\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241498
    m_Localized: "\u041F\u0440\u0438\u043C\u0430\u0440\u043D\u0456 \u043B\u0435\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241499
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F, \u0449\u043E
      \u0441\u0442\u0432\u043E\u0440\u044E\u0454 \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u043A\u0456\u043B\u044C\u043A\u0430 \u043D\u0430\u0439\u0433\u043E\u0441\u0442\u0440\u0456\u0448\u0438\u0445
      \u043F\u0440\u0438\u043C\u0430\u0440\u043D\u0438\u0445 \u043B\u0435\u0437,
      \u044F\u043A\u0456 \u0440\u043E\u0437\u043B\u0456\u0442\u0430\u044E\u0442\u044C\u0441\u044F
      \u0432\u0456\u044F\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241500
    m_Localized: "\u041F\u043E\u0434\u0438\u0445 \u0434\u0440\u0430\u043A\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241501
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0454 \u043C\u0430\u0433\u0456\u0447\u043D\u0443
      \u0441\u0438\u043B\u0443 \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430
      \u043D\u0430 \u043F\u043E\u0442\u0456\u043A \u0432\u043E\u0433\u043D\u044E,
      \u0449\u043E \u043D\u0430\u0433\u0430\u0434\u0443\u0454 \u0434\u0440\u0430\u043A\u043E\u043D\u044F\u0447\u0435
      \u043F\u043E\u043B\u0443\u043C'\u044F, \u0430\u043B\u0435, \u0437\u0432\u0456\u0441\u043D\u043E,
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0440\u0443\u0439\u043D\u0456\u0432\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241502
    m_Localized: "\u0411\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241503
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0432\u0440\u0430\u0436\u0430\u0454 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u043C\u0430\u0439\u0436\u0435 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u044E
      \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u043A\u043E\u044E. \u0417\u0430\u0432\u0434\u0430\u0454
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0448\u043A\u043E\u0434\u0438, \u044F\u043A\u0449\u043E
      \u0446\u0456\u043B\u044C \u0442\u043E\u0440\u043A\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437\u0435\u043C\u043B\u0456, \u043F\u0440\u043E\u0442\u0438 \u0446\u0456\u043B\u0435\u0439
      \u0443 \u043F\u043E\u0432\u0456\u0442\u0440\u0456 \u043D\u0435 \u0442\u0430\u043A\u0430
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241504
    m_Localized: "\u0412\u043E\u0433\u043D\u044F\u043D\u0430 \u043A\u0443\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241505
    m_Localized: "\u041A\u043B\u0430\u0441\u0438\u043A\u0430 \u0431\u043E\u0439\u043E\u0432\u043E\u0457
      \u043C\u0430\u0433\u0456\u0457. \u0412\u043E\u0433\u043D\u044F\u043D\u0438\u0439
      \u0437\u0433\u0443\u0441\u0442\u043E\u043A, \u0449\u043E \u0432\u0438\u0431\u0443\u0445\u0430\u0454
      \u043F\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u0456 \u0432
      \u0446\u0456\u043B\u044C, \u043F\u043E\u0434\u0456\u0431\u043D\u043E \u0434\u043E
      \u0441\u043D\u0430\u0440\u044F\u0434\u0430 \u0437 \u0431\u0430\u0437\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241506
    m_Localized: "\u041C\u0430\u0433\u0456\u0447\u043D\u0438\u0439 \u043F\u0440\u043E\u043C\u0456\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241507
    m_Localized: "\u0426\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0454 \u043C\u0430\u0433\u0456\u044E
      \u0454\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430 \u043D\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0438\u0441\u0442\u0443
      \u0435\u043D\u0435\u0440\u0433\u0456\u044E \u0440\u0443\u0439\u043D\u0456\u0432\u043D\u043E\u0457
      \u0441\u0438\u043B\u0438. \u041C\u0430\u0454 \u0434\u043E\u0441\u0438\u0442\u044C
      \u0432\u0438\u0441\u043E\u043A\u0443 \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C
      \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0456\u0439 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241508
    m_Localized: "\u0425\u0432\u0438\u043B\u044F \u0434\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241509
    m_Localized: "\u0414\u0443\u0436\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F. \u0414\u043E\u0437\u0432\u043E\u043B\u044F\u0454
      \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0438 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0443
      \u0443\u0434\u0430\u0440\u043D\u0443 \u0445\u0432\u0438\u043B\u044E, \u0441\u0445\u043E\u0436\u0443
      \u043D\u0430 \u0432\u0438\u0431\u0443\u0445\u043E\u0432\u0443, \u0430\u043B\u0435
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0441\u043F\u0440\u044F\u043C\u043E\u0432\u0430\u043D\u043E\u0457
      \u0434\u0456\u0457. \u0423\u0441\u0456 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438,
      \u044F\u043A\u0456 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438 \u043F\u0456\u0434
      \u0457\u0457 \u0432\u043F\u043B\u0438\u0432, \u043E\u0442\u0440\u0438\u043C\u0430\u044E\u0442\u044C
      \u0432\u0430\u0436\u043A\u0456 \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456
      \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241510
    m_Localized: "\u0427\u043E\u0440\u043D\u0435 \u0441\u043E\u043D\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241511
    m_Localized: "\u041E\u0434\u043D\u0435 \u0437 \u043D\u0430\u0439\u043F\u043E\u0442\u0443\u0436\u043D\u0456\u0448\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u0432 \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0456
      \u043C\u0430\u0433\u0430. \u0417\u0430\u0432\u0434\u0430\u0454 \u0432\u0435\u043B\u0438\u043A\u043E\u0457
      \u0448\u043A\u043E\u0434\u0438 \u0439 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0435 \u043F\u0440\u043E\u0442\u0438
      \u0441\u043A\u0443\u043F\u0447\u0435\u043D\u044C \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
      \u0430\u043B\u0435 \u0434\u0443\u0436\u0435 \u0432\u0438\u043C\u043E\u0433\u043B\u0438\u0432\u0435
      \u0434\u043E \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457 \u0441\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241512
    m_Localized: "\u041F\u0440\u043E\u043C\u0456\u043D\u044C \u0441\u043C\u0435\u0440\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241513
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F, \u0449\u043E
      \u0441\u0442\u0432\u043E\u0440\u044E\u0454 \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u0439
      \u043F\u043E\u0442\u0456\u043A \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457, \u044F\u043A\u0430 \u0432\u0431\u0438\u0432\u0430\u0454
      \u0432\u0441\u0435 \u0436\u0438\u0432\u0435 \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443
      \u0448\u043B\u044F\u0445\u0443, \u043F\u0440\u0438\u0447\u043E\u043C\u0443
      \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C \u0434\u043B\u044F \u043D\u044C\u043E\u0433\u043E
      \u043D\u0435 \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F.
      \u041D\u0430 \u043D\u0435\u0436\u0438\u0432\u0438\u0445 \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0456\u0432
      \u043D\u0435 \u0434\u0456\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241514
    m_Localized: "\u0422\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0438\u0439
      \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241515
    m_Localized: "\u041F\u043E\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u043E\u0457
      \u043A\u0443\u043B\u0456, \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454
      \u043E\u0434\u0440\u0430\u0437\u0443 5 \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0442\u0438\u0447\u043D\u0438\u0445
      \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432, \u0449\u043E \u0437\u0430\u0432\u0434\u0430\u044E\u0442\u044C
      \u0446\u0456\u043B\u0456 \u0443\u0434\u0430\u0440\u043D\u043E\u0457 \u0448\u043A\u043E\u0434\u0438
      \u0456 \u0437 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u043E\u044E
      \u0441\u0438\u043B\u043E\u044E \u0432\u0456\u0434\u043A\u0438\u0434\u0430\u044E\u0442\u044C
      \u0457\u0457 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2725241516
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u0456 \u0432\u043E\u0433\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241517
    m_Localized: "\u0414\u0443\u0436\u0435 \u043F\u043E\u0442\u0443\u0436\u043D\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F, \u0449\u043E
      \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0442\u0438
      \u043F\u043E\u0442\u043E\u043A\u0438 \u0437\u043E\u0440\u044F\u043D\u043E\u0457
      \u0435\u043D\u0435\u0440\u0433\u0456\u0457, \u0432\u0456\u0434 \u044F\u043A\u043E\u0457
      \u043D\u0435\u043C\u0430\u0454 \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043A\u0443."
    m_Metadata:
