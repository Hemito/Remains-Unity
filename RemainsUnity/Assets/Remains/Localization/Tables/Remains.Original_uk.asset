      \u0441\u043B\u043E\u0442\u0430] ([1]-[0],[-],[=]), \u0449\u043E\u0431 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u0442\u0438
      \u0431\u0440\u043E\u043D\u044E \u0432 \u0446\u0435\u0439 \u0441\u043B\u043E\u0442,
      \u0430\u0431\u043E \u0441\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F.
      \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438 \u0446\u044E \u0436
      \u043A\u043B\u0430\u0432\u0456\u0448\u0443 \u0432 \u0433\u0440\u0456, \u0432\u0438
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0448\u0432\u0438\u0434\u043A\u043E
      \u0432\u0434\u044F\u0433\u043D\u0443\u0442\u0438 \u0446\u044E \u0431\u0440\u043E\u043D\u044E,
      \u044F\u043A\u0449\u043E \u0442\u0456\u043B\u044C\u043A\u0438 \u0432\u0430\u0441
      \u0443 \u0446\u0435\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u043D\u0435
      \u0430\u0442\u0430\u043A\u0443\u044E\u0442\u044C.\n\u0422\u0430\u043A\u043E\u0436
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
