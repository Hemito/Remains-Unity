  - m_Id: 2725241405
    m_Localized: "\u0420\u0430\u043A\u0435\u0442\u043D\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430
      \u0437 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u0438\u043C\u0438 \u0431\u043E\u0439\u043E\u0432\u0438\u043C\u0438
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438
      \u0456 \u043B\u0430\u0437\u0435\u0440\u043D\u0438\u043C \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u043D\u044F\u043C,
      \u0449\u043E \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0443\u0454 \u0431\u0456\u043B\u044C\u0448\u0443
      \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C \u043F\u0440\u0438 \u0441\u0442\u0440\u0456\u043B\u044C\u0431\u0456."
    m_Metadata:
