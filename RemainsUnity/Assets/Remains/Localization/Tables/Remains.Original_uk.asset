    m_Metadata:
      m_Items: []
  - m_Id: 2729435854
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u0433\u0440\u0430\u0442\u0438,
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043D\u0435 \u0437\u0430\u043C\u043E\u0440\u043E\u0447\u0443\u044E\u0447\u0438\u0441\u044C.\n\u0412\u0438
      \u043F\u043E\u0447\u0438\u043D\u0430\u0454\u0442\u0435 \u0433\u0440\u0443,
      \u043C\u0430\u044E\u0447\u0438 200 \u043E\u0434\u0438\u043D\u0438\u0446\u044C
      \u0437\u0434\u043E\u0440\u043E\u0432'\u044F, +25 \u0437\u0430 \u0440\u0456\u0432\u0435\u043D\u044C.\n\u0417\u0434\u043E\u0440\u043E\u0432'\u044F
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u0437\u043C\u0435\u043D\u0448\u0435\u043D\u043E
      \u043D\u0430 60%.\n\u041F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438\u043C\u0435
      \u0442\u0440\u0430\u0432\u043C.\n\u041F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F
      \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443 \u0442\u043E\u0447\u043A\u0443
      \u043D\u0435 \u0434\u0430\u0454 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445
      \u0448\u0442\u0440\u0430\u0444\u0456\u0432.\n\u0412\u043E\u0440\u043E\u0433\u0438
      \u0433\u0456\u0440\u0448\u0435 \u0447\u0443\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435855
    m_Localized: "\u041B\u0435\u0433\u043A\u043E"
    m_Metadata:
