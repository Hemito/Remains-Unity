  - m_Id: 2742018258
    m_Localized: "\u041D\u0435\u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0438\u0439 \u043B\u0438\u0441\u0442,
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u0439
      \u043E\u0434\u043D\u0438\u043C \u0437 \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0456\u0432,
      \u044F\u043A\u0456 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0438 \u0443
      \u0432\u0456\u0434\u0434\u0456\u043B\u0456, \u0437\u0430 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0434\u043D\u0456\u0432 \u0434\u043E \u043F\u0430\u0434\u0456\u043D\u043D\u044F
      \u0431\u043E\u043C\u0431:"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018259
    m_Localized: "\"\u041D\u0456, \u043D\u0443 \u0442\u0438 \u043F\u0440\u0438\u043A\u0438\u043D\u044C,
      \u0449\u043E \u0446\u0456 \u043D\u0435\u0434\u043E\u0443\u043C\u043A\u0443\u0432\u0430\u0442\u0456
      \u0431\u0430\u0440\u0430\u043D\u0438 \u0437 \u043D\u0430\u0443\u043A\u043E\u0432\u043E\u0433\u043E
      \u0432\u0456\u0434\u0434\u0456\u043B\u0443 \u0432\u0447\u0443\u0434\u0438\u043B\u0438!
      \u041F\u0430\u043C'\u044F\u0442\u0430\u0454\u0448, \u044F\u043A \u043C\u0456\u0441\u044F\u0446\u044F
      \u043F\u0456\u0432\u0442\u043E\u0440\u0430 \u0442\u043E\u043C\u0443 \u044F
      \u043F\u043E\u043A\u0430\u0437\u0443\u0432\u0430\u0432 \u0442\u043E\u0431\u0456
      \u043F\u0430\u0440\u0442\u0456\u044E \u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0456\u0432? \u0412\u043E\u043D\u0438
      \u0436 \u043C\u0435\u043D\u0456 \u0441\u0430\u043C\u0456 \u0457\u0457 \u0432\u0456\u0434\u0434\u0430\u043B\u0438,
      \u0442\u0438\u043F\u0443 \u044F\u043A \u043F\u043E\u0434\u044F\u043A\u0443
      \u0437\u0430 \u043C\u0430\u0433\u043E\u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0456
      \u043A\u043E\u0442\u0443\u0448\u043A\u0438. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u043B\u0438, \u0449\u043E \u0437 \u0446\u0438\u043C\u0438
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0430\u043C\u0438 \u0440\u043E\u0431\u0438\u0442\u0438,
      \u043E\u0442 \u0456 \u0437\u0431\u0430\u0433\u0440\u0438\u043B\u0438 \u043C\u0435\u043D\u0456,
      \u0440\u0430\u043F\u0442\u043E\u043C \u044F \u0437\u043D\u0430\u0439\u0434\u0443
      \u0457\u043C \u044F\u043A\u0435\u0441\u044C \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F.
      \u0406 \u044F \u0436, \u043C\u0430\u0442\u0438 \u043C\u043E\u044F \u043A\u043E\u0431\u0438\u043B\u0430,
      \u0437\u043D\u0430\u0439\u0448\u043E\u0432! \u0412\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F,
      \u0449\u043E \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0438 \u0440\u0435\u0430\u0433\u0443\u044E\u0442\u044C
      \u043D\u0430 \u043F\u0435\u0432\u043D\u0438\u0439 \u0434\u0456\u0430\u043F\u0430\u0437\u043E\u043D
      \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F,
      \u043F\u0440\u0438\u0447\u043E\u043C\u0443 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0440\u0435\u0430\u0433\u0443\u044E\u0442\u044C, \u0430 \u043F\u043E\u0441\u0438\u043B\u044E\u044E\u0442\u044C
      \u0456 \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C \u0439\u043E\u0433\u043E
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456. \u041F\u0440\u0438\u043A\u0438\u043D\u044C!
      \u041F\u043E\u0434\u0440\u043E\u0431\u0438\u0446\u0456 \u043C\u043E\u0436\u0443
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0442\u0438 \u043F\u0440\u0438
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456, \u0430\u043B\u0435 \u0441\u0443\u0442\u044C
      \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E \u0437 \u0446\u044C\u043E\u0433\u043E
      \u043C\u043E\u0436\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043F\u043E\u0442\u0443\u0436\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E. \u0426\u0435 \u0442\u043E\u0431\u0456 \u043D\u0435
      \u044F\u043A\u0456\u0441\u044C \u043C\u043B\u044F\u0432\u0456 \u043B\u0430\u0437\u0435\u0440\u043D\u0456
      \u043F\u0440\u043E\u043C\u0435\u043D\u0456, \u043C\u043E\u0457 \"\u043F\u0440\u043E\u043C\u0435\u043D\u0456
      \u0434\u043E\u0431\u0440\u0430\", \u0437\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u0438\u043C\u0438
      \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u0430\u043C\u0438, \u043F\u0440\u043E\u043F\u0430\u043B\u044E\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C
      \u0441\u0438\u043B\u043E\u0432\u0443 \u0431\u0440\u043E\u043D\u044E, \u044F\u043A
      \u043F\u0430\u043F\u0456\u0440. \u042F \u0432\u0436\u0435 \u0439 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456
      \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F \u043D\u0430\u043A\u0438\u0434\u0430\u0432,
      \u044F\u043A \u0440\u0430\u043F\u0442\u043E\u043C \u0446\u0456 \u043B\u043E\u043F\u0443\u0445\u0438
      \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u043E\u0434\u0443\u043C\u0430\u043B\u0438\u0441\u044F.
      \u0412\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E, \u0445\u0442\u043E
      \u0457\u043C \u043D\u0430\u0441\u0442\u0443\u043A\u0430\u0432, \u0449\u043E
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0438 \u0446\u0456 - \u0434\u0430\u043B\u0435\u043A\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u043B\u0438\u0441\u043A\u0443\u0447\u0456
      \u0448\u0442\u0443\u043A\u043E\u0432\u0438\u043D\u0438. \u0410\u043B\u0435
      \u0442\u0435\u043F\u0435\u0440 \u0432\u043E\u043D\u0438 \u043C\u0435\u043D\u0456
      \u0437\u0430\u044F\u0432\u043B\u044F\u044E\u0442\u044C, \u0449\u043E \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0438,
      \u0442\u0438\u043F\u0443, \u0437\u0430\u043A\u043E\u043D\u043D\u0430 \u0432\u043B\u0430\u0441\u043D\u0456\u0441\u0442\u044C
      \u0457\u0445\u043D\u044C\u043E\u0433\u043E \u0432\u0456\u0434\u0434\u0456\u043B\u0443
      \u043F\u0456\u0434 \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u0442\u0430\u043C
      \u043A\u043B\u044F\u0442\u0438\u043C \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u043D\u0438\u043C
      \u043D\u043E\u043C\u0435\u0440\u043E\u043C, \u044F\u043A\u0443 \u043D\u0456\u0431\u0438\u0442\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438.
      \u042F\u0441\u043D\u0438\u0439 \u043F\u0435\u043D\u044C, \u044F \u0457\u0445
      \u0456 \u043F\u043E\u0441\u043B\u0430\u0432 \u0443 \u0442\u0435 \u043C\u0456\u0441\u0446\u0435,
      \u043A\u0443\u0434\u0438 \u0441\u043E\u043D\u0446\u0435 \u043D\u0435 \u0441\u0432\u0456\u0442\u0438\u0442\u044C.
      \u041F\u043E\u043A\u0438 \u043D\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u044E
      \u043F\u0430\u0442\u0435\u043D\u0442 \u043D\u0430 \u0441\u0432\u043E\u044E
      \"\u0414\u0440\u0443\u0436\u0431\u043E-\u0433\u0430\u0440\u043C\u0430\u0442\u0443\"
      (\u0440\u043E\u0431\u043E\u0447\u0430 \u043D\u0430\u0437\u0432\u0430, \u0445\u0435-\u0445\u0435),
      \u0431\u043E\u043B\u0442 \u0457\u043C \u0432\u0456\u0434 \u043C\u0435\u043D\u0435
      \u0434\u0456\u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F. \u0422\u043E\u0434\u0456
      \u0432\u043E\u043D\u0438 \u0439 \u043F\u0440\u0438\u0433\u0440\u043E\u0437\u0438\u043B\u0438
      \u043F\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0441\u043B\u0443\u0436\u0431\u0443
      \u0431\u0435\u0437\u043F\u0435\u043A\u0438. \u041F\u0440\u0438\u0439\u0442\u0438
      \u0456 \u0432\u0438\u043B\u0443\u0447\u0438\u0442\u0438 \u043D\u0430\u0441\u0438\u043B\u044C\u043D\u043E.
      \u041D\u0443 \u044F \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0438\u043A\u0438
      \u0456 \u0441\u0445\u043E\u0432\u0430\u0432. \u041F\u043E \u0432\u0441\u044C\u043E\u043C\u0443
      \u0446\u0435\u0445\u0443 \u0437\u0430\u043D\u0438\u043A\u0430\u0432 \u0443
      \u0440\u0456\u0437\u043D\u0438\u0445 \u043C\u0456\u0441\u0446\u044F\u0445,
      \u0444\u0456\u0433 \u0432\u043E\u043D\u0438 \u0442\u0435\u043F\u0435\u0440
      \u0449\u043E\u0441\u044C \u0443 \u043C\u0435\u043D\u0435 \u0437\u0430\u0431\u0435\u0440\u0443\u0442\u044C.
      \u041D\u0435 \u0434\u0438\u0432\u0443\u0439\u0441\u044F, \u044F\u043A\u0449\u043E
      \u043C\u043E\u0457 \"\u0414\u0440\u0443\u0436\u0431\u043E-\u0433\u0430\u0440\u043C\u0430\u0442\u0438\"
      \u0432\u0438\u0442\u0456\u0441\u043D\u044F\u0442\u044C \u043B\u0430\u0437\u0435\u0440\u043D\u0456
      \u0449\u0435 \u0434\u043E \u043A\u0456\u043D\u0446\u044F \u0412\u0456\u0439\u043D\u0438.
      \u041C\u043E\u0436\u0435 \u044F\u043A\u0440\u0430\u0437 \u0432\u043E\u043D\u0438
      \u043D\u0430\u043C \u0456 \u043F\u0440\u0438\u043D\u0435\u0441\u0443\u0442\u044C
      \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0443. \u041D\u0435\u0445\u0430\u0439
      \u0441\u043C\u0443\u0433\u0430\u0441\u0442\u0456 \u0432\u0438\u0440\u043E\u0434\u043A\u0438
      \u043F\u043B\u0430\u0447\u0443\u0442\u044C! \u042F\u043A \u0434\u0443\u043C\u0430\u0454\u0448,
      \u043C\u043E\u0436\u0435 \u043C\u0435\u043D\u0435 \u0439 \u043E\u0440\u0434\u0435\u043D\u043E\u043C
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u044F\u0442\u044C?\""
