    m_Localized: "\u041F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B. 308"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241667
    m_Localized: "\u0413\u0432\u0438\u043D\u0442\u0456\u0432\u043A\u043E\u0432\u0438\u0439
      \u043F\u0430\u0442\u0440\u043E\u043D, \u044F\u043A\u0438\u0439 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E \u0443 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u044C\u043A\u0438\u0445
