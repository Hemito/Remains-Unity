      \u0433\u0443\u043B\u044F\u043C \u043A\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435279
    m_Localized: "\u0420\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0439
      \u0441\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435280
    m_Localized: "\u0421\u0432\u0456\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u0442\u0435\u043C\u0440\u044F\u0432\u0456
      \u043D\u0435\u0437\u0434\u043E\u0440\u043E\u0432\u0438\u043C, \u043E\u0442\u0440\u0443\u0439\u043D\u043E-\u0437\u0435\u043B\u0435\u043D\u0438\u043C
      \u0441\u0432\u0456\u0442\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435281
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0438\u043D\u043A\u0430 \u043A\u0440\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435282
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0438\u043D\u043A\u0430 \u043A\u0440\u0438\u043B\u0430
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043A\u0440\u043E\u0432\u043E\u043A\u0440\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435283
    m_Localized: "\u0406\u043A\u043B\u043E \u0432\u0430\u043C\u043F\u0456\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435284
    m_Localized: "\u0406\u043A\u043B\u043E \u043A\u0440\u043E\u0432\u043E\u043A\u0440\u0438\u043B\u0430,
      \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0440\u0435\u0447\u043E\u0432\u0438\u043D\u0443,
      \u0449\u043E \u043D\u0435 \u0434\u0430\u0454 \u043A\u0440\u043E\u0432\u0456
      \u0437\u0433\u043E\u0440\u0442\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435285
    m_Localized: "\u041A\u0440\u0438\u043B\u043E \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435286
    m_Localized: "\u041D\u0430\u0433\u0430\u0434\u0443\u0454 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0435
      \u043A\u0440\u0438\u043B\u043E \u043A\u043E\u043C\u0430\u0445\u0438, \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0445 \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435287
    m_Localized: "\u041E\u043A\u043E \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435288
    m_Localized: "\u0424\u0430\u0441\u0435\u0442\u043E\u0447\u043D\u0435 \u043E\u043A\u043E,
      \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0440\u0430\u0439\u0434\u0443\u0436\u043D\u0438\u043C\u0438 \u043A\u043E\u043B\u044C\u043E\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435289
    m_Localized: "\u0429\u0443\u0440\u044F\u0447\u0430 \u043F\u0435\u0447\u0456\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435290
    m_Localized: "\u0424\u0435-\u0435-\u0435-\u0435, \u0431\u0440\u0438\u0434\u043E\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435291
    m_Localized: "\u0429\u0443\u0440\u044F\u0447\u0438\u0439 \u0445\u0432\u0456\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435292
    m_Localized: "\u0421\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u0447\u0435\u0440\u0432'\u044F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435293
    m_Localized: "\u0416\u0438\u0440 \u043C\u043E\u043D\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435294
    m_Localized: "\u0423 \u0440\u0430\u0437\u0456 \u043F\u043E\u0442\u0440\u0435\u0431\u0438
      \u043C\u043E\u0436\u0435 \u0437\u0430\u043C\u0456\u043D\u0438\u0442\u0438 \u043C\u0430\u0448\u0438\u043D\u043D\u0435
      \u043C\u0430\u0441\u0442\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435295
    m_Localized: "\u0420\u0438\u0431'\u044F\u0447\u0438\u0439 \u0436\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435296
    m_Localized: "\u0414\u0435\u0445\u0442\u043E \u0432\u0432\u0430\u0436\u0430\u0454
      \u0446\u044E \u0441\u043C\u0435\u0440\u0434\u044E\u0447\u0443 \u0440\u0435\u0447\u043E\u0432\u0438\u043D\u0443
      \u043A\u043E\u0440\u0438\u0441\u043D\u043E\u044E \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432'\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435297
    m_Localized: "\u0412\u043E\u0433\u043D\u0435\u0442\u0432\u043E\u0440\u043D\u0430
      \u0437\u0430\u043B\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435298
    m_Localized: "\u0414\u0430\u0454 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u0434\u0435\u044F\u043A\u0438\u043C \u0456\u0441\u0442\u043E\u0442\u0430\u043C
      \u0432\u0438\u0434\u0438\u0445\u0430\u0442\u0438 \u0432\u043E\u0433\u043E\u043D\u044C.
      \u0423 \u043D\u0456\u0439 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0430 \u043C\u0430\u0433\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435299
    m_Localized: "\u0427\u0430\u0440\u0456\u0432\u043D\u0456 \u0442\u0440\u0430\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435300
    m_Localized: "\u0420\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456
      \u0440\u043E\u0441\u043B\u0438\u043D\u0438, \u0449\u043E \u043C\u0430\u044E\u0442\u044C
      \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456,
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0434\u043B\u044F \u0431\u0456\u043B\u044C\u0448\u043E\u0441\u0442\u0456
      \u0437\u0456\u043B\u043B\u044F. \u041D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0445 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E,
      \u0430\u043B\u0435 \u0434\u0435\u044F\u043A\u0456 \u0437\u0435\u0431\u0440\u0438
      \u0437\u0430\u0440\u043E\u0431\u043B\u044F\u044E\u0442\u044C \u0441\u043E\u0431\u0456
      \u043D\u0430 \u0436\u0438\u0442\u0442\u044F \u0442\u0438\u043C, \u0449\u043E
      \u0437\u0431\u0438\u0440\u0430\u044E\u0442\u044C \u0442\u0440\u0430\u0432\u0438
      \u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435301
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u043F\u043E\u0440\u043E\u0448\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435302
    m_Localized: "\u0423\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0438\u0439
      \u0437\u0430\u0441\u0456\u0431 \u043D\u0430 \u0432\u0441\u0456 \u0432\u0438\u043F\u0430\u0434\u043A\u0438
      \u0436\u0438\u0442\u0442\u044F, \u043C\u0430\u0454 \u0442\u0438\u0441\u044F\u0447\u0443
      \u0439 \u043E\u0434\u043D\u0435 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435303
    m_Localized: "\u0427\u0430\u0440\u0456\u0432\u043D\u0438\u0439 \u043F\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435304
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u0430
      \u043C\u0430\u0433\u0456\u0447\u043D\u0430 \u0435\u0441\u0435\u043D\u0446\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435305
    m_Localized: "\u0420\u043E\u0436\u0435\u0432\u0438\u0439 \u0441\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435306
    m_Localized: "\u0421\u043B\u0438\u0437, \u0449\u043E \u0432\u0432\u0456\u0431\u0440\u0430\u0432
      \u0432 \u0441\u0435\u0431\u0435 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u043E\u0432\u0430\u043D\u0443
      \u0420\u043E\u0436\u0435\u0432\u0443 \u0425\u043C\u0430\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435307
    m_Localized: "\u0422\u0435\u043C\u043D\u0430 \u0434\u0443\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435308
    m_Localized: "\u0415\u0444\u0435\u043C\u0435\u0440\u043D\u0430 \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0456\u044F,
      \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F \u043F\u0456\u0441\u043B\u044F
      \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F \u0440\u043E\u044E \u043D\u0435\u043A\u0440\u043E\u0441\u043F\u0440\u0430\u0439\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2729435309
    m_Localized: "\u0420\u0456\u0433 \u0432\u0456\u0434\u044C\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2729435310
    m_Localized: "\u0420\u0456\u0433 \u0434\u0443\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442\u0441\u044C\u043A\u043E\u0433\u043E
