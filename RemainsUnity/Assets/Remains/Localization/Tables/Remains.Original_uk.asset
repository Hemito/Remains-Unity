  - m_Id: 2733629775
    m_Localized: "[\u0412\u0435\u043B\u0438\u043A\u0430 \u0412\u0456\u0439\u043D\u0430]
      - \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u0430 \u0432\u0456\u0439\u043D\u0430
      \u043C\u0456\u0436 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0454\u044E
      \u0442\u0430 \u0406\u043C\u043F\u0435\u0440\u0456\u0454\u044E \u0437\u0435\u0431\u0440,
      \u0449\u043E \u0441\u0442\u0430\u043B\u0430\u0441\u044F \u0431\u043B\u0438\u0437\u044C\u043A\u043E
      \u0434\u0432\u043E\u0445\u0441\u043E\u0442 \u0440\u043E\u043A\u0456\u0432 \u0442\u043E\u043C\u0443.
      \u0426\u044F \u0432\u0456\u0439\u043D\u0430 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044F
      \u0432\u0437\u0430\u0454\u043C\u043D\u0438\u043C \u0432\u0438\u043D\u0438\u0449\u0435\u043D\u043D\u044F\u043C
      \u0456 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F\u043C
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457 \u043D\u0430 \u041F\u0443\u0441\u0442\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629776
    m_Localized: "[\u041C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F]
      - \u043F\u043E\u0441\u0438\u043B\u0435\u043D\u0456 \u043D\u0430 \u0431\u0430\u0433\u0430\u0442\u043E
      \u043F\u043E\u0440\u044F\u0434\u043A\u0456\u0432 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F, \u044F\u043A\u0456
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0443 \u0412\u0435\u043B\u0438\u043A\u0456\u0439 \u0412\u0456\u0439\u043D\u0456
      \u044F\u043A \u0437\u0431\u0440\u043E\u044F \u043C\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629777
    m_Localized: "[\u0416\u0430\u0440-\u0431\u043E\u043C\u0431\u0430] - \u0437\u0435\u0431\u0440\u0438\u043D\u0441\u044C\u043A\u0435
      \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456 \u0434\u0440\u0430\u043A\u043E\u043D\u044F\u0447\u043E\u0433\u043E
      \u0432\u043E\u0433\u043D\u044E, \u043F\u043E\u043C\u0456\u0449\u0435\u043D\u0435
      \u0432 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439.
      \u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u0441\u0442\u0432\u043E\u0440\u044E\u0454
      \u0436\u0430\u0445\u043B\u0438\u0432\u043E\u0457 \u0441\u0438\u043B\u0438 \u0432\u0438\u0431\u0443\u0445,
      \u0437\u0434\u0430\u0442\u043D\u0438\u0439 \u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438
      \u0446\u0456\u043B\u0456 \u043C\u0456\u0441\u0442\u0430 \u0443\u0434\u0430\u0440\u043D\u043E\u044E
      \u0445\u0432\u0438\u043B\u0435\u044E \u0456 \u0437\u0430\u0440\u0430\u0436\u0430\u0442\u0438
      \u043C\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044C \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u044E
      \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0454\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629778
    m_Localized: "[\u0420\u043E\u0436\u0435\u0432\u0430 \u0425\u043C\u0430\u0440\u0430]
      - \u0436\u0430\u0445\u043B\u0438\u0432\u0435 \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u0449\u043E \u0437\u043D\u0438\u0449\u0438\u043B\u043E \u0441\u0442\u043E\u043B\u0438\u0446\u044E
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457 \u041A\u0430\u043D\u0442\u0435\u0440\u043B\u043E\u0442.
      \u0426\u0435 \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u0430
      \u0445\u043C\u0430\u0440\u0430 \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0433\u043E \u0433\u0430\u0437\u0443
      \u0440\u043E\u0436\u0435\u0432\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u043E\u0440\u0443,
      \u0449\u043E \u0432\u0431\u0438\u0432\u0430\u0454 \u0432\u0441\u0435 \u0436\u0438\u0432\u0435.
      \u0412\u0456\u0434 \u043D\u0435\u0457 \u043D\u0435 \u0456\u0441\u043D\u0443\u0454
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0430\u0445\u0438\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629779
    m_Localized: "[\u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A] - \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0456\u044F,
      \u0449\u043E \u0456\u0441\u043D\u0443\u0432\u0430\u043B\u0430 \u0434\u043E
      \u0412\u0435\u043B\u0438\u043A\u043E\u0457 \u0412\u0456\u0439\u043D\u0438.
      \u0412\u0456\u0434\u043E\u043C\u0430 \u0442\u0438\u043C, \u0449\u043E \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u043B\u0430
      \u0431\u0435\u0437\u043B\u0456\u0447 \u0421\u0442\u0456\u0439\u043B-\u043F\u0440\u0438\u0442\u0443\u043B\u043A\u0456\u0432,
      \u0443 \u044F\u043A\u0438\u0445 \u043F\u043E\u043D\u0456 \u043C\u0430\u043B\u0438
      \u0432\u0438\u0436\u0438\u0442\u0438 \u0432 \u0440\u0430\u0437\u0456 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F
      \u0437\u0431\u0440\u043E\u0457 \u043C\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u0443\u0440\u0430\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629780
    m_Localized: "[\u041F\u0456\u043F\u0411\u0430\u043A] - \u043F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u0438\u0439
      \u043A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440, \u0440\u043E\u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A, \u044F\u043A\u0438\u0439
      \u043F\u043E\u043D\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u043D\u043E\u0441\u0438\u0442\u0438
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0456\u0439 \u043D\u043E\u0437\u0456.
      \u041C\u0430\u0454 \u0431\u0435\u0437\u043B\u0456\u0447 \u0444\u0443\u043D\u043A\u0446\u0456\u0439
      - \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043D\u043D\u044F \u0437\u0434\u043E\u0440\u043E\u0432'\u044F
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430, \u0441\u043E\u0440\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E, \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u044F
      \u0456 \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u044F, \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u0444\u0430\u0439\u043B\u0456\u0432
      \u0456 \u0432\u0435\u0434\u0435\u043D\u043D\u044F \u0437\u0430\u043F\u0438\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629781
    m_Localized: "[\u0417.\u041F.\u0421.] - \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u041F\u0440\u0438\u0446\u0456\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0421\u0442\u0456\u0439\u043B-\u0422\u0435\u043A.
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F,
      \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0435 \u0432 \u041F\u0456\u043F\u0411\u0430\u043A,
      \u0449\u043E \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0437\u0443\u043F\u0438\u043D\u044F\u0442\u0438
      \u0441\u0443\u0431'\u0454\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0431\u0456\u0433
      \u0447\u0430\u0441\u0443 \u0456 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454
      \u043F\u0440\u0438\u0446\u0456\u043B\u044E\u0432\u0430\u043D\u043D\u044E \u0437
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629782
    m_Localized: "[\u0421\u0442\u0456\u0439\u043B\u043E] - \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u0438\u0439 \u043F\u0456\u0434\u0437\u0435\u043C\u043D\u0438\u0439
      \u043F\u0440\u0438\u0442\u0443\u043B\u043E\u043A \u0434\u043B\u044F \u043F\u043E\u043D\u0456,
      \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0439 \u043D\u0430
      \u0442\u0440\u0438\u0432\u0430\u043B\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F.
      \u041F\u0456\u0434 \u0447\u0430\u0441 \u0412\u0456\u0439\u043D\u0438 \u0431\u0443\u043B\u043E
      \u043F\u043E\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u043E \u043F\u043E\u043D\u0430\u0434
      \u0441\u043E\u0442\u043D\u044E \u0441\u0442\u0456\u0439\u043B, \u0430\u043B\u0435
      \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0456\u0437 \u043D\u0438\u0445,
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0456\u0437\u043D\u0456 \u043F\u0440\u0438\u0447\u0438\u043D\u0438,
      \u0442\u0435\u043F\u0435\u0440 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0456,
      \u0430 \u0432\u0441\u0456 \u0457\u0445\u043D\u0456 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456
      \u0437\u0430\u0433\u0438\u043D\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629783
    m_Localized: "\u041C\u0406\u041D\u0406\u0421\u0422\u0415\u0420\u0421\u0422\u0412\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629784
    m_Localized: "\u0428\u0456\u0441\u0442\u044C \u0443\u0440\u044F\u0434\u043E\u0432\u0438\u0445
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0439, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0445
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0412\u0435\u043B\u0438\u043A\u043E\u0457
      \u0412\u0456\u0439\u043D\u0438 \u043F\u0440\u0430\u0432\u043B\u044F\u0447\u043E\u044E
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u043E\u044E \u041B\u0443\u043D\u043E\u044E,
      \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u044E \u043C\u0435\u0442\u043E\u044E
      \u044F\u043A\u0438\u0445 \u0431\u0443\u043B\u0430 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0430
      \u0443 \u0412\u0456\u0439\u043D\u0456 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0434\u0435\u0440\u0436\u0430\u0432\u043D\u043E\u0457 \u0446\u0456\u043B\u0456\u0441\u043D\u043E\u0441\u0442\u0456
      \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0457. \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430\u043C\u0438
      \u043A\u0435\u0440\u0443\u0432\u0430\u043B\u0438 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043A\u0438
      \u0415\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432 \u0413\u0430\u0440\u043C\u043E\u043D\u0456\u0457.\n[\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0422\u0430\u0454\u043C\u043D\u0438\u0445 \u041D\u0430\u0443\u043A], \u0441\u043A\u043E\u0440\u043E\u0447\u0435\u043D\u043E
      [\u041C\u0422\u041D] - \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E,
      \u043E\u0447\u043E\u043B\u044E\u0432\u0430\u043D\u0435 \u0422\u0432\u0430\u0439\u043B\u0430\u0439\u0442
      \u0421\u043F\u0430\u0440\u043A\u043B. \u041C\u0422\u041D \u0437\u0434\u0435\u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E
      \u0437\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u043E\u044E
      \u043C\u0430\u0433\u0456\u0447\u043D\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0442\u0430 \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C.\n[\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0421\u0442\u0438\u043B\u044E] - \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E,
      \u043E\u0447\u043E\u043B\u044E\u0432\u0430\u043D\u0435 \u0420\u0430\u0440\u0456\u0442\u0456.
      \u0417\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F \u043F\u0440\u0438\u043A\u0440\u0430\u0448\u0430\u043D\u043D\u044F\u043C
      \u0432\u0443\u043B\u0438\u0446\u044C, \u0432\u0438\u043F\u0443\u0441\u043A\u043E\u043C
      \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0438\u0445 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u043E
      \u0437\u0430 \u0446\u0435\u043D\u0437\u0443\u0440\u0443.\n[\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u041C\u0438\u0440\u0443] - \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E,
      \u043E\u0447\u043E\u043B\u044E\u0432\u0430\u043D\u0435 \u0424\u043B\u0430\u0442\u0442\u0435\u0440\u0448\u0430\u0439.
      \u0417\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F \u043F\u0438\u0442\u0430\u043D\u043D\u044F\u043C\u0438
      \u043E\u0445\u043E\u0440\u043E\u043D\u0438 \u0437\u0434\u043E\u0440\u043E\u0432'\u044F,
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u043E\u043C \u043B\u0456\u043A\u0456\u0432,
      \u0442\u0430\u043A\u0438\u0445 \u044F\u043A \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0456
      \u0437\u0456\u043B\u043B\u044F, \u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u0438\u043C \u0443 \u0431\u043E\u044F\u0445.
      \u0421\u0430\u043C\u0435 \u0446\u0435 \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0435
      \u0437\u0430 \u0432\u0438\u043D\u0430\u0445\u0456\u0434 \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C.\n[\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u041C\u043E\u0440\u0430\u043B\u0456] - \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E,
      \u043E\u0447\u043E\u043B\u044E\u0432\u0430\u043D\u0435 \u041F\u0456\u043D\u043A\u0456
      \u041F\u0430\u0439. \u041E\u0444\u0456\u0446\u0456\u0439\u043D\u043E \u0437\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F
      \u043F\u0430\u0442\u0440\u0456\u043E\u0442\u0438\u0447\u043D\u0438\u043C \u0432\u0438\u0445\u043E\u0432\u0430\u043D\u043D\u044F\u043C,
      \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F\u043C \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0434\u0443\u0445\u0443 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F
      \u0442\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0454\u044E
      \u0441\u0432\u044F\u0442. \u041D\u0435\u043E\u0444\u0456\u0446\u0456\u0439\u043D\u043E
      \u0436 \u0437\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F \u0448\u043F\u0438\u0433\u0443\u043D\u0441\u0442\u0432\u043E\u043C
      \u0456 \u043A\u043E\u043D\u0442\u0440\u0440\u043E\u0437\u0432\u0456\u0434\u043A\u043E\u044E.\n[\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0412\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445 \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439]
      - \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E,
      \u043E\u0447\u043E\u043B\u044E\u0432\u0430\u043D\u0435 \u0415\u043F\u043F\u043B\u0434\u0436\u0435\u043A.
      \u0417\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u043E\u044E
      \u043D\u043E\u0432\u0456\u0442\u043D\u044C\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u0442\u0430 \u0437\u0430\u0441\u043E\u0431\u0456\u0432 \u0437\u0430\u0445\u0438\u0441\u0442\u0443,
      \u0442\u0430\u043A\u0438\u0445 \u044F\u043A \u0441\u0438\u043B\u043E\u0432\u0430
      \u0431\u0440\u043E\u043D\u044F.\n[\u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u041A\u0440\u0443\u0442\u043E\u0441\u0442\u0456] - \u043C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E,
      \u043E\u0447\u043E\u043B\u044E\u0432\u0430\u043D\u0435 \u0420\u0435\u0439\u043D\u0431\u043E\u0443
      \u0414\u0435\u0448. \u0427\u0438\u043C \u0437\u0430\u0439\u043C\u0430\u043B\u043E\u0441\u044F
      \u0432\u043E\u043D\u043E - \u0434\u043E\u0441\u0442\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629785
    m_Localized: "\u0429\u043E?.. \u0414\u0435? \u0429\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629786
    m_Localized: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E... \u043F\u0456\u0434\u043D\u044F\u0442\u0438\u0441\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629787
    m_Localized: "\u0422\u0440\u0435\u0431\u0430 \u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629788
    m_Localized: "\u0422\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0438 \u041C\u0422\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629789
    m_Localized: "\u0423\u0432\u0430\u0433\u0430! \u0412\u0438\u044F\u0432\u043B\u0435\u043D\u043E
      \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439 \u0441\u0438\u0433\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629790
    m_Localized: "\u0420\u043E\u0437\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430
      \u0441\u0438\u0433\u043D\u0430\u043B\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629791
    m_Localized: "\u0421\u0438\u0433\u043D\u0430\u043B \u0440\u043E\u0437\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043E.
      \u0421\u0438\u0433\u043D\u0430\u0442\u0443\u0440\u0443 \u041F\u0456\u043F\u0411\u0430\u043A\u0430
      \u0440\u043E\u0437\u043F\u0456\u0437\u043D\u0430\u043D\u043E. \u0417'\u0454\u0434\u043D\u0430\u043D\u043D\u044F
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E. \u0412\u0445\u0456\u0434
      \u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629792
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E,
      \u041A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447. \u0412\u0430\u0441
      \u0432\u0456\u0442\u0430\u0454 \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0416\u0438\u0442\u0442\u044F \u041C\u0456\u043D\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
      \u0422\u0430\u0454\u043C\u043D\u0438\u0445 \u041D\u0430\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629793
    m_Localized: "\u0412\u0438 \u0443\u0441\u043F\u0456\u0448\u043D\u043E \u043F\u0440\u043E\u0439\u0448\u043B\u0438
      \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044E \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0456
      \u0456 \u0442\u0435\u043F\u0435\u0440 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0432\u0441\u0456\u043C\u0430 \u0457\u0457 \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629794
    m_Localized: "\u0423 \u0440\u0430\u0437\u0456 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E\u0457
      \u0437\u0430\u0433\u0440\u043E\u0437\u0438 \u0434\u043B\u044F \u0432\u0430\u0448\u043E\u0433\u043E
      \u0436\u0438\u0442\u0442\u044F, \u044F\u043A-\u043E\u0442: \u0440\u0430\u043F\u0442\u043E\u0432\u0438\u0439
      \u043D\u0430\u043F\u0430\u0434 \u0437\u0435\u0431\u0440, \u0442\u0435\u0440\u0430\u043A\u0442,
      \u0432\u0438\u0431\u0443\u0445 \u043C\u0435\u0433\u0430\u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u0430\u0431\u043E \u043F\u0430\u0434\u0456\u043D\u043D\u044F \u0437\u0456
      \u0441\u0445\u043E\u0434\u0456\u0432, - \u0432\u0430\u0441 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E
      \u043F\u0435\u0440\u0435\u043C\u0456\u0441\u0442\u044F\u0442\u044C \u0443 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435
      \u043C\u0456\u0441\u0446\u0435 - \u0434\u043E \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E
      \u043F\u0440\u0430\u0446\u044E\u044E\u0447\u043E\u0433\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443
      \u041C\u0422\u041D. \u0422\u0430\u043A\u043E\u0436 \u0432\u0430\u043C \u0431\u0443\u0434\u0435
      \u043D\u0430\u0434\u0430\u043D\u043E \u043F\u0435\u0440\u0448\u0443 \u043C\u0435\u0434\u0438\u0447\u043D\u0443
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629795
    m_Localized: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F:
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u0440\u0430\u0446\u044E\u0454
      \u0432 \u0442\u0435\u0441\u0442\u043E\u0432\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456.
      \u041C\u043E\u0436\u043B\u0438\u0432\u0456 \u043D\u0435\u0437\u043D\u0430\u0447\u043D\u0456
      \u043D\u0435\u043F\u043E\u043B\u0430\u0434\u043A\u0438 \u0442\u0430 \u0437\u0431\u043E\u0457
      \u0432 \u0440\u043E\u0431\u043E\u0442\u0456. \u0414\u044F\u043A\u0443\u0454\u043C\u043E
      \u0437\u0430 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629796
    m_Localized: "\u0406\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F \u0437
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629797
    m_Localized: "[\u0406\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F \u0437
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F]
      \u0423\u0441\u0456 \u0440\u0435\u0447\u0456, \u044F\u043A\u0456 \u0432\u0438
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438\u043C\u0435\u0442\u0435
      \u0456 \u043F\u0456\u0434\u0431\u0438\u0440\u0430\u0442\u0438\u043C\u0435\u0442\u0435
      \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0456 \u0433\u0440\u0438, \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C
      \u0443 \u0432\u0430\u0448 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440.
      \u041F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0439\u043E\u0433\u043E
      \u0432\u043C\u0456\u0441\u0442 \u043C\u043E\u0436\u043D\u0430 \u0447\u0435\u0440\u0435\u0437
      \u041F\u0456\u043F\u0411\u0430\u043A (\u043A\u043B\u0430\u0432\u0456\u0448\u0430
      @1 \u0430\u0431\u043E @2), \u0440\u043E\u0437\u0434\u0456\u043B [\u0406\u043D\u0432\u0435\u043D\u0442\u0430\u0440].
      \u0420\u043E\u0437\u0434\u0456\u043B \u043C\u0456\u0441\u0442\u0438\u0442\u044C
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0432\u043A\u043B\u0430\u0434\u043E\u043A,
      \u044F\u043A\u0456 \u043C\u043E\u0436\u043D\u0430 \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u0442\u0438
      \u043A\u043D\u043E\u043F\u043A\u0430\u043C\u0438 \u0443 \u0432\u0435\u0440\u0445\u043D\u0456\u0439
      \u0447\u0430\u0441\u0442\u0438\u043D\u0456 \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443
      - [\u0417\u0431\u0440\u043E\u044F], [\u0411\u0440\u043E\u043D\u044F], [\u0421\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F],
      [\u0411\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438], [\u0406\u043D\u0448\u0435]."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629798
    m_Localized: "\u0423 \u0432\u043A\u043B\u0430\u0434\u0446\u0456 [\u0417\u0431\u0440\u043E\u044F]
      \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0441\u044F \u043D\u0430\u044F\u0432\u043D\u0430 \u0443 \u0432\u0430\u0441
      \u0437\u0431\u0440\u043E\u044F. \u0422\u0443\u0442 \u0457\u0457 \u043C\u043E\u0436\u043D\u0430
      \u0435\u043A\u0456\u043F\u0456\u0440\u0443\u0432\u0430\u0442\u0438, \u0430
      \u0442\u0430\u043A\u043E\u0436 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438,
      \u0441\u0442\u0430\u043D \u0456 \u043D\u0430\u044F\u0432\u043D\u0456\u0441\u0442\u044C
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432. \u0410\u043D\u0430\u043B\u043E\u0433\u0456\u0447\u043D\u043E
      \u0432\u043A\u043B\u0430\u0434\u043A\u0430 [\u0411\u0440\u043E\u043D\u044F]
      \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0432\u0434\u044F\u0433\u0430\u0442\u0438
      \u0431\u0440\u043E\u043D\u044E \u0456 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u0442\u0438
      \u0457\u0457 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u0442\u0430 \u0441\u0442\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629799
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0430 [\u0421\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F]
      \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0443\u0441\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438,
      \u044F\u043A\u0456 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      - \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u0438, \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u0435
      \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F, \u043A\u043D\u0438\u0436\u043A\u0438
      \u0456 \u0442. \u0456\u043D. \u0417\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043C\u043E\u0436\u043D\u0430 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0436, \u0447\u0435\u0440\u0435\u0437 \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441
      \u041F\u0456\u043F\u0411\u0430\u043A\u0430, \u0430\u0431\u043E \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0456
      \u0433\u0440\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043A\u043B\u0430\u0432\u0456\u0448\u0456 @1. \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      @5, \u0449\u043E\u0431 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u044F\u043A\u0438\u0439 \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432 \u043B\u0456\u0432\u043E\u043C\u0443 \u0432\u0435\u0440\u0445\u043D\u044C\u043E\u043C\u0443
      \u043A\u0443\u0442\u043A\u0443 \u0435\u043A\u0440\u0430\u043D\u0430 \u043F\u0456\u0434
      \u0441\u043C\u0443\u0436\u043A\u043E\u044E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F.
      \u041D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435 @2 \u0430\u0431\u043E
      @3, \u0449\u043E\u0431 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439
      \u0430\u0431\u043E \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442. \u0429\u043E\u0431 \u0448\u0432\u0438\u0434\u043A\u043E
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u0438,
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043A\u043B\u0430\u0432\u0456\u0448\u0443 @4, \u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0431\u0443\u0434\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0435
      \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0449\u0435
      \u043B\u0456\u043A\u0443\u0432\u0430\u043B\u044C\u043D\u0435 \u0437\u0456\u043B\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629800
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0438 [\u0411\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438]
      \u0442\u0430 [\u0406\u043D\u0448\u0435] \u043C\u0456\u0441\u0442\u044F\u0442\u044C
      \u0432\u0441\u0456 \u0456\u043D\u0448\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
      - \u043F\u0430\u0442\u0440\u043E\u043D\u0438, \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438,
      \u0446\u0456\u043D\u043D\u0456 \u0440\u0435\u0447\u0456 \u0442\u0430 \u0440\u0456\u0437\u043D\u0438\u0439
      \u043C\u043E\u0442\u043B\u043E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629801
    m_Localized: "\u041D\u0443 \u0432\u0436\u0435 \u0442\u0443\u0442 \u043C\u0435\u043D\u0456
      \u043D\u0456\u044F\u043A \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629802
    m_Localized: "\u042F\u043A\u0449\u043E \u0442\u0456\u043B\u044C\u043A\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629803
    m_Localized: "...\u043D\u0435 \u043F\u0456\u0434\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0442\u0438
      \u0441\u0435\u0431\u0435 \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456
      \u0442\u0435\u043B\u0435\u043A\u0456\u043D\u0435\u0437\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629804
    m_Localized: "\u041A\u0456\u043D\u0435\u0446\u044C \u043D\u0430\u0432\u0447\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629805
    m_Localized: "\u041A\u043E\u0440\u0438\u0434\u043E\u0440? \u0422\u0430\u043C,
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0454 \u0441\u0432\u0456\u0442\u043B\u043E. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0442\u0430\u043C \u0432\u0438\u0445\u0456\u0434 \u0456\u0437 \u0446\u044C\u043E\u0433\u043E
      \u043C\u0456\u0441\u0446\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629806
    m_Localized: "\u0410 \u0437\u043B\u0456\u0432\u0430 \u043E\u0434\u043D\u0430
      \u0447\u043E\u0440\u043D\u043E\u0442\u0430. \u041D\u0430\u043F\u0435\u0432\u043D\u043E,
      \u043C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u0439\u0442\u0438
      \u0434\u043E \u0432\u0438\u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629807
    m_Localized: "\u0427\u0438 \u043D\u0456? \u0429\u043E, \u044F\u043A\u0449\u043E
      \u043C\u0435\u043D\u0456, \u043D\u0430\u0432\u043F\u0430\u043A\u0438, \u0442\u0440\u0435\u0431\u0430
      \u043F\u0456\u0442\u0438 \u0432\u0433\u043B\u0438\u0431 \u0446\u0438\u0445
      \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629808
    m_Localized: "\u0412\u0438 \u0443\u0441\u043F\u0456\u0448\u043D\u043E \u0434\u0456\u0441\u0442\u0430\u043B\u0438\u0441\u044F
      \u0434\u043E \u0432\u0438\u0445\u043E\u0434\u0443 \u0439 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u0435
      \u0437\u0430 \u0446\u0435 \u043D\u043E\u0432\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629809
    m_Localized: "\u0417 \u043A\u043E\u0436\u043D\u0438\u043C \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F\u043C
      \u0440\u0456\u0432\u043D\u044F \u0432\u0438 \u0431\u0443\u0434\u0435\u0442\u0435
      \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u043E\u0447\u043A\u0438
      \u043D\u0430\u0432\u0438\u0447\u043E\u043A \u0456 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0435\u0439.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0457\u0445, \u0449\u043E\u0431 \u043F\u043E\u043B\u0456\u043F\u0448\u0438\u0442\u0438
      \u0441\u0432\u043E\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0447\u0435\u0440\u0435\u0437
      \u041F\u0456\u043F\u0411\u0430\u043A, \u0440\u043E\u0437\u0434\u0456\u043B
      \"\u0421\u0442\u0430\u0442\u0443\u0441\" - \"\u041D\u0430\u0432\u0438\u0447\u043A\u0438\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629810
    m_Localized: "\u041E\u0439-\u043E\u0439. \u0426\u044F \u0432\u043E\u0434\u0430
      \u043C\u0435\u043D\u0456 \u043D\u0435 \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629811
    m_Localized: "\u041D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u044F \u0432\u0437\u0430\u0433\u0430\u043B\u0456
      \u0449\u043E\u0441\u044C \u0437\u043D\u0430\u044E \u043F\u0440\u043E \u0432\u043E\u0434\u0443,
      \u0432\u043E\u043D\u0430 \u043D\u0435 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
      \u0442\u0430\u043A\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629812
    m_Localized: "\u0426\u044F \u0442\u0443\u0440\u0435\u043B\u044C \u043D\u0430
      \u0441\u0442\u0435\u043B\u0456 \u043D\u0430 \u0432\u0438\u0433\u043B\u044F\u0434
      \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0430,
      \u0430 \u0432 \u043C\u0435\u043D\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435\u043C\u0430\u0454 \u043F\u0440\u0438\u0441\u0442\u043E\u0439\u043D\u043E\u0457
      \u0437\u0431\u0440\u043E\u0457. \u041D\u0435 \u0434\u0443\u043C\u0430\u044E,
      \u0449\u043E \u043C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u0457\u0457
      \u0447\u0456\u043F\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629813
    m_Localized: "\u0410\u043B\u0435 \u0436 \u0446\u0435 \u0439 \u043D\u0435 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E,
      \u0442\u0430\u043A? \u042F\u043A\u0449\u043E \u044F \u0445\u043E\u0447\u0443
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u043D\u0430 \u0456\u043D\u0448\u0438\u0439
      \u0431\u0456\u043A, \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u043E \u043F\u0440\u043E\u043A\u0440\u0430\u0441\u0442\u0438\u0441\u044F
      \u043F\u043E\u0432\u0437 \u043D\u0435\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629814
    m_Localized: "\u0422\u0430\u043A, \u044F \u0442\u0430\u043A \u0456 \u0437\u0440\u043E\u0431\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629815
    m_Localized: "\u0422\u0443\u0440\u0435\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629816
    m_Localized: "\u0422\u0443\u0440\u0435\u043B\u0456 - \u0446\u0435 \u0441\u0442\u0430\u0446\u0456\u043E\u043D\u0430\u0440\u043D\u0456
      \u043E\u0445\u043E\u0440\u043E\u043D\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456 \u0432 \u043F\u0435\u0432\u043D\u0438\u0445
      \u043C\u0456\u0441\u0446\u044F\u0445 \u0456 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0456
      \u043F\u043E\u0442\u0443\u0436\u043D\u0438\u043C \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629817
    m_Localized: "\u041F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0447\u0438
      \u0432 \u0431\u043E\u0439\u043E\u0432\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456,
      \u0432\u043E\u043D\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E
      \u0440\u043E\u0437\u043F\u0456\u0437\u043D\u0430\u044E\u0442\u044C \u0432\u043E\u0440\u043E\u0436\u0456
      \u0446\u0456\u043B\u0456 \u0432 \u0437\u043E\u043D\u0456 \u0441\u0432\u043E\u0454\u0457
      \u0434\u043E\u0441\u044F\u0436\u043D\u043E\u0441\u0442\u0456 \u0439 \u043D\u0435\u0433\u0430\u0439\u043D\u043E
      \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u044E\u0442\u044C \u043F\u043E
      \u043D\u0438\u0445 \u0432\u043E\u0433\u043E\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629818
    m_Localized: "\u041D\u0430 \u041F\u0443\u0441\u0442\u043A\u0430\u0445 \u0437\u0431\u0435\u0440\u0435\u0433\u043B\u043E\u0441\u044F
      \u0431\u0435\u0437\u043B\u0456\u0447 \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u044E\u0447\u0438\u0445
      \u0434\u043E\u0432\u043E\u0454\u043D\u043D\u0438\u0445 \u0442\u0443\u0440\u0435\u043B\u0435\u0439,
      \u044F\u043A\u0456, \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438
      \u043D\u0430 \u043C\u0438\u043D\u0443\u043B\u0456 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F,
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u044E\u0442\u044C \u043E\u0445\u043E\u0440\u043E\u043D\u044F\u0442\u0438
      \u0432\u0432\u0456\u0440\u0435\u043D\u0456 \u0457\u043C \u043E\u0431'\u0454\u043A\u0442\u0438.
      \u0406 \u0446\u0435, \u0431\u0435\u0437\u0443\u043C\u043E\u0432\u043D\u043E,
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0443
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u0434\u043B\u044F \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u0456\u0432
      \u0440\u043E\u0437\u0436\u0438\u0442\u0438\u0441\u044F \u0445\u0430\u043B\u044F\u0432\u043E\u044E
      \u0432 \u0443\u0446\u0456\u043B\u0456\u043B\u0438\u0445 \u0431\u0443\u0434\u0456\u0432\u043B\u044F\u0445
      \u0444\u0430\u0431\u0440\u0438\u043A, \u0437\u0430\u0432\u043E\u0434\u0456\u0432
      \u0456 \u0432\u0456\u0439\u0441\u044C\u043A\u043E\u0432\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629819
    m_Localized: "\u041D\u0430 \u0449\u0430\u0441\u0442\u044F, \u0442\u0443\u0440\u0435\u043B\u0456
      \u0434\u043E\u0441\u0438\u0442\u044C \u043B\u0435\u0433\u043A\u043E \u0432\u0438\u0432\u0435\u0441\u0442\u0438
      \u0437 \u043B\u0430\u0434\u0443, \u043D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438
      \u043D\u0430 \u0457\u0445\u043D\u044E \u043D\u0438\u0449\u0456\u0432\u043D\u0443
      \u0432\u043E\u0433\u043D\u0435\u0432\u0443 \u043C\u0456\u0446\u044C. \u041C\u043E\u0436\u043D\u0430
      \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u043E\u044E
      \u0430\u0431\u043E \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u043E\u044E
      \u0437\u0431\u0440\u043E\u0454\u044E, \u0430\u0431\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u0457\u0445 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B \u0431\u0435\u0437\u043F\u0435\u043A\u0438.
      \u0413\u043E\u043B\u043E\u0432\u043D\u0435 - \u043D\u0435 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u043F\u0456\u0434 \u043A\u0443\u043B\u0456, \u0449\u043E \u043D\u0435 \u0442\u0430\u043A
      \u0432\u0436\u0435 \u0439 \u0441\u043A\u043B\u0430\u0434\u043D\u043E. \u041E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0442\u0443\u0440\u0435\u043B\u0456 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F,
      \u0442\u043E \u0432\u043E\u043D\u0438 \u043D\u0435 \u0433\u0430\u043D\u044F\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0432\u0430\u043C\u0438, \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0432\u0438\u0439\u0442\u0438 \u0456\u0437 \u0437\u043E\u043D\u0438 \u0457\u0445\u043D\u044C\u043E\u0457
      \u0434\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629820
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629821
    m_Localized: "\u0411\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442\u0438
      - \u0446\u0435, \u0441\u0443\u0434\u044F\u0447\u0438 \u0437 \u0443\u0441\u044C\u043E\u0433\u043E,
      \u043C\u0443\u0442\u043E\u0432\u0430\u043D\u0456 \u043F\u0456\u0434 \u0434\u0456\u0454\u044E
      \u043F\u043E\u0440\u0447\u0456 \u0430\u0431\u043E \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0457
      \u043F\u0430\u0440\u0430\u0441\u043F\u0440\u0430\u0439\u0442\u0438, \u044F\u043A\u0456
      \u043D\u0430\u0431\u0443\u043B\u0438 \u043D\u043E\u0432\u0438\u0445, \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0445
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439, \u0430\u043B\u0435
      \u043D\u0435 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
      \u0434\u043E \u0456\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E
      \u0440\u043E\u0437\u043C\u043D\u043E\u0436\u0435\u043D\u043D\u044F, \u0447\u0435\u0440\u0435\u0437
      \u0449\u043E \u0457\u0445\u043D\u044F \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043D\u0430 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0456\u0439
      \u041F\u0443\u0441\u0442\u0446\u0456 \u0432\u0435\u043B\u044C\u043C\u0438 \u0432\u0435\u043B\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629822
    m_Localized: "\u0414\u0435\u044F\u043A\u0456 \u0437 \u043D\u0438\u0445 \u0443\u043C\u0456\u044E\u0442\u044C
      \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438 \u043E\u0442\u0440\u0443\u0454\u043D\u0438\u043C\u0438
      \u0448\u0438\u043F\u0430\u043C\u0438 \u0430\u0431\u043E \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u044E,
      \u0456\u043D\u0448\u0456 \u0436 \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0442\u044C\u0441\u044F
      \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438 \u0437\u0431\u043B\u0438\u0437\u044C\u043A\u0430,
      \u0432\u0433\u0440\u0438\u0437\u0430\u044E\u0447\u0438\u0441\u044C \u0443 \u0441\u0432\u043E\u044E
      \u0436\u0435\u0440\u0442\u0432\u0443 \u0433\u043E\u0441\u0442\u0440\u0438\u043C\u0438
      \u0437\u0443\u0431\u0430\u043C\u0438. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439 \u0440\u0456\u0437\u043D\u043E\u0432\u0438\u0434
      \u043C\u043E\u0436\u0435 \u0432\u0456\u0434\u043A\u043B\u0430\u0434\u0430\u0442\u0438
      \u044F\u0439\u0446\u044F \u0432 \u0442\u0456\u043B\u0430 \u0456\u043D\u0448\u0438\u0445
      \u0456\u0441\u0442\u043E\u0442, \u0449\u043E\u0431 \u043D\u043E\u0432\u0456
      \u0442\u0432\u0430\u0440\u044E\u043A\u0438, \u0432\u0438\u043B\u0443\u043F\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0437\u0436\u0435\u0440\u0442\u0438 \u0457\u0445 \u0437\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629823
    m_Localized: "\u0423 \u0442\u043E\u0439 \u0447\u0430\u0441 \u044F\u043A \u043E\u0434\u0438\u043D
      \u0431\u043B\u043E\u0442\u0441\u043F\u0440\u0430\u0439\u0442 \u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0457 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438,
      \u0457\u0445\u043D\u044F \u0437\u0433\u0440\u0430\u044F \u043C\u043E\u0436\u0435
      \u0437\u0430\u0432\u0434\u0430\u0442\u0438 \u0447\u0438\u043C\u0430\u043B\u043E
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C. \u0426\u0438\u0445 \u0456\u0441\u0442\u043E\u0442
      \u0441\u043A\u043B\u0430\u0434\u043D\u043E \u0432\u0431\u0438\u0442\u0438 \u043A\u0443\u043B\u044F\u043C\u0438,
      \u043A\u0440\u0430\u0449\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0435\u043D\u0435\u0440\u0433\u043E\u043C\u0430\u0433\u0456\u0447\u043D\u0443
      \u0430\u0431\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u0443 \u0437\u0431\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629824
    m_Localized: "\u0422\u0430\u043C, \u0437\u0430 \u0446\u0456\u0454\u044E \u0441\u0442\u0456\u043D\u043E\u044E,
      \u0442\u043E\u0447\u043D\u043E \u0449\u043E\u0441\u044C \u0454. \u042F \u0447\u0443\u044E
      \u044F\u043A\u0435\u0441\u044C \u043F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u0435
      \u0434\u0437\u0438\u0436\u0447\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629825
    m_Localized: "\u0425\u043C... \u0441\u0442\u0456\u043D\u0430 \u043D\u0435 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043C\u0456\u0446\u043D\u043E\u044E.
      \u041C\u043E\u0436\u043D\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0432 \u043D\u0456\u0439 \u0434\u0456\u0440\u043A\u0443,
      \u0430\u043B\u0435 \u0447\u0438 \u0432\u0430\u0440\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629826
    m_Localized: "\u0422\u0443\u0442 \u0446\u0456\u043B\u0430 \u043A\u0443\u043F\u0430
      \u0432\u0438\u0431\u0443\u0445\u0456\u0432\u043A\u0438. \u041C\u043E\u0436\u043D\u0430
      \u0431\u0443\u043B\u043E \u0431 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u0437\u043D\u0435\u0448\u043A\u043E\u0434\u0438\u0442\u0438,
      \u0430\u043B\u0435 \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u043C\u043E\u0457\u0445
      \u043D\u0430\u0432\u0438\u0447\u043E\u043A \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629827
    m_Localized: "\u041C\u043E\u0436\u043D\u0430 \u0440\u0438\u0437\u0438\u043A\u043D\u0443\u0442\u0438
      \u0456 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438
      \u0457\u0457..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629828
    m_Localized: "\u0410\u043B\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0435\u0440\u0435\u0434
      \u0446\u0438\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0456\u0434\u0456\u0439\u0442\u0438
      \u043F\u043E\u0434\u0430\u043B\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629829
    m_Localized: "\u0425\u043E\u0447 \u0431\u0438 \u043D\u0435 \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E
      \u043F\u0440\u043E\u0445\u0456\u0434..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629830
    m_Localized: "\u041F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u0432\u0456\u0434 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629831
    m_Localized: "\u0420\u0430\u043F\u0442\u043E\u0432\u043E \u0432\u0430\u0448 \u041F\u0456\u043F\u0411\u0430\u043A
      \u0432\u043C\u0438\u043A\u0430\u0454\u0442\u044C\u0441\u044F \u0441\u0430\u043C
      \u0441\u043E\u0431\u043E\u044E. \u041F\u043E \u0435\u043A\u0440\u0430\u043D\u0443
      \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u0437\u0432\u0438\u0447\u043D\u043E\u0433\u043E
      \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u0431\u0456\u0436\u0430\u0442\u044C
      \u0440\u044F\u0434\u0438 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432,
      \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0447\u0438\u0441\u044C \u0443 \u0441\u043B\u043E\u0432\u0430
      \u0456 \u0440\u0435\u0447\u0435\u043D\u043D\u044F. \u0412\u0438 \u043D\u0435
      \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0442\u0435, \u0432 \u0447\u043E\u043C\u0443
      \u0441\u043F\u0440\u0430\u0432\u0430, \u0430\u0434\u0436\u0435 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0435
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043D\u0435 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F
      \u041F\u0456\u043F\u0411\u0430\u043A\u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454
      \u0442\u0430\u043A\u043E\u0433\u043E, \u0432\u0436\u0435 \u0432\u0430\u043C
      \u0446\u0435 \u0434\u043E\u0431\u0440\u0435 \u0432\u0456\u0434\u043E\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629832
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, \"\u041E\u0431\u0440\u0430\u043D\u0430-25\"
      @lp. \u042F - \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A, \u043C\u043E\u0454
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F - \u0441\u043F\u0440\u044F\u043C\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0442\u0432\u043E\u0457 \u0434\u0456\u0457 \u0442\u0430 \u0432\u043A\u0430\u0437\u0443\u0432\u0430\u0442\u0438
      \u0448\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629833
    m_Localized: "\u0429\u043E? \u0425\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0437\u0456 \u043C\u043D\u043E\u044E... \u0456 \u044F\u043A \u043C\u0435\u043D\u0456
      \u0442\u043E\u0431\u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629834
    m_Localized: "\u0417\u0430\u0440\u0430\u0437 \u0442\u0438, \u043C\u0430\u0431\u0443\u0442\u044C,
      \u0445\u043E\u0447\u0435\u0448 \u0437\u043D\u0430\u0442\u0438, \u0445\u0442\u043E
      \u044F \u0442\u0430\u043A\u0438\u0439, \u044F\u043A \u0432\u043B\u0456\u0437
      \u0434\u043E \u0442\u0432\u043E\u0433\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0443
      \u0456 \u0447\u043E\u043C\u0443 \u0442\u0438, \u0432\u043B\u0430\u0441\u043D\u0435,
      \u043C\u0430\u0454\u0448 \u043C\u0435\u043D\u0456 \u0434\u043E\u0432\u0456\u0440\u044F\u0442\u0438.
      \u0417\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F \u0431\u0456\u043B\u044C\u0448
      \u043D\u0456\u0436 \u0440\u0435\u0437\u043E\u043D\u043D\u0456, \u0456 \u044F,
      \u0437\u0432\u0456\u0441\u043D\u043E \u0436, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u043C
      \u043D\u0430 \u043D\u0438\u0445, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0437\u043C\u043E\u0436\u0443. \u041C\u043E\u044F \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0456\u0441\u0442\u044C
      \u043F\u043E\u043A\u0438 \u0449\u043E \u043C\u0430\u0454 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u043E\u044E. \u041E\u0434\u043D\u0435
      \u043C\u043E\u0436\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u0438 - \u043C\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0437\u043D\u0430\u0439\u043E\u043C\u0456,
      \u0456 \u044F \u0432 \u0436\u043E\u0434\u043D\u043E\u043C\u0443 \u0440\u0430\u0437\u0456
      \u043D\u0435 \u0432\u043E\u0440\u043E\u0433 \u0442\u043E\u0431\u0456. \u0426\u0456
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F \u0431\u0443\u043B\u0438
      \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u0456 \u0434\u043E
      \u0442\u0432\u043E\u0433\u043E \u041F\u0456\u043F\u0411\u0430\u043A\u0443 \u0437\u0430\u0437\u0434\u0430\u043B\u0435\u0433\u0456\u0434\u044C
      \u0456 \u0437\u0430\u0440\u0430\u0437 \u0432\u0456\u0434\u0442\u0432\u043E\u0440\u044E\u044E\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u0437\u0433\u0456\u0434\u043D\u043E
      \u0456\u0437 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u043C
      \u0442\u0430\u0439\u043C\u0435\u0440\u043E\u043C. \u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E,
      \u0446\u0435 \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044F
      \u0440\u043E\u0437\u043C\u043E\u0432\u0430, \u0456 \u0442\u0438 \u043D\u0435
      \u043C\u043E\u0436\u0435\u0448 \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437\u0456 \u043C\u043D\u043E\u044E. \u041F\u043E\u043A\u0438 \u0449\u043E.
      \u0429\u043E \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F \u0442\u043E\u0433\u043E,
      \u0447\u043E\u043C\u0443 \u0442\u0438 \u043C\u0435\u043D\u0456 \u043F\u043E\u0432\u0438\u043D\u043D\u0430
      \u0434\u043E\u0432\u0456\u0440\u044F\u0442\u0438, \u0442\u043E \u043E\u0441\u044C
      \u043C\u0456\u0439 \u043F\u0435\u0440\u0448\u0438\u0439 \u0456 \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629835
    m_Localized: "\u041F\u0456\u043F\u0411\u0430\u043A \u0432\u043C\u0438\u043A\u0430\u0454
      \u0430\u0443\u0434\u0456\u043E\u0437\u0430\u043F\u0438\u0441. \u0412\u0438
      \u0437 \u043F\u043E\u0434\u0438\u0432\u043E\u043C \u0432\u043F\u0456\u0437\u043D\u0430\u0454\u0442\u0435
      \u0441\u0432\u0456\u0439 \u0432\u043B\u0430\u0441\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629836
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, @lp \u0437 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0433\u043E,
      \u044F - @lp, \u0442\u043E\u0431\u0442\u043E \u0442\u0438 \u0436, \u0430\u043B\u0435
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0434\u043D\u0456\u0432 \u0442\u043E\u043C\u0443.
      \u042F \u0437\u0430\u043B\u0438\u0448\u0430\u044E \u0442\u043E\u0431\u0456...
      \u0442\u043E\u0431\u0442\u043E \u0441\u043E\u0431\u0456... \u0446\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F,
      \u0449\u043E\u0431 \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E. \u0411\u043E \u0434\u0435\u044F\u043A\u0438\u0439
      \u0447\u0430\u0441 \u0442\u043E\u043C\u0443 \u0442\u0438 \u043F\u0440\u0438\u0439\u0448\u043B\u0430
      \u0434\u043E \u0442\u044F\u043C\u0438 \u0432 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E\u043C\u0443
      \u043C\u0456\u0441\u0446\u0456 \u0456 \u0437 \u0434\u0438\u0432\u043D\u0438\u043C\u0438
      \u043F\u0440\u043E\u0432\u0430\u043B\u0430\u043C\u0438 \u0432 \u043F\u0430\u043C'\u044F\u0442\u0456.
      \u0406 \u043E\u0441\u044C, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u044F \u0437\u043D\u0430\u044E, \u0449\u043E \u044F, \u0442\u043E\u0431\u0442\u043E
      \u0442\u0438, \u043D\u0435 \u043F\u043E\u0432\u0456\u0440\u0438\u0448 \u043D\u0456\u043A\u043E\u043C\u0443,
      \u043E\u043A\u0440\u0456\u043C \u0441\u0435\u0431\u0435, \u0442\u043E \u044F
      \u0439 \u043C\u0430\u044E \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u0442\u043E\u0431\u0456
      \u0442\u0430\u043A\u0435: \u041C\u0435\u043D\u0456, \u0442\u043E\u0431\u0442\u043E
      \u0442\u043E\u0431\u0456, \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043E
      \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0443 \u043C\u0456\u0441\u0456\u044E.
      \u0414\u0456\u0439\u0441\u043D\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u0443
      \u0434\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E \u0421\u0442\u0456\u0439\u043B\u0430,
      \u0456 \u044F, \u0442\u043E\u0431\u0442\u043E \u0442\u0438, \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u0442\u0430\u043A \u0432\u0432\u0430\u0436\u0430\u044E. \u041D\u0438\u043D\u0456
      \u0442\u0438 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454\u0448 \u043F\u0456\u0434
      \u0434\u0456\u0454\u044E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
      \u043F\u0430\u043C'\u044F\u0442\u0456, \u044F\u043A\u0435 \u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043B\u043E
      \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u0442\u0432\u043E\u0457\u0445 \u0441\u043F\u043E\u0433\u0430\u0434\u0456\u0432.
      \u041D\u0430 \u0442\u0435, \u0449\u043E\u0431 \u043F\u0456\u0434\u0434\u0430\u0442\u0438\u0441\u044F
      \u0446\u044C\u043E\u043C\u0443 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044E,
      \u044F-\u0442\u0438 \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F
      \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u043E,
      \u0431\u0435\u0437 \u043D\u0430\u0439\u043C\u0435\u043D\u0448\u043E\u0433\u043E
      \u043F\u0440\u0438\u043C\u0443\u0441\u0443 \u0430\u0431\u043E \u0437\u0430\u0433\u0440\u043E\u0437\u0438.
      \u042F \u0437\u0440\u043E\u0431\u0438\u043B\u0430 \u0446\u0435, \u0442\u043E\u043C\u0443
      \u0449\u043E \u0442\u0430\u043A \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0432\u0456\u0440 \u043C\u0435\u043D\u0456...
      \u0442\u043E\u0431\u0442\u043E \u0441\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629837
    m_Localized: "\u0417 \u043C\u0435\u0442\u043E\u044E \u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u0442\u0438 \u043D\u0435 \u043F\u0430\u043C'\u044F\u0442\u0430\u0442\u0438\u043C\u0435\u0448,
      \u0434\u0435 \u0442\u0432\u0456\u0439 \u0434\u0456\u043C \u0456 \u0445\u0442\u043E
      \u0442\u0432\u043E\u0457 \u0431\u043B\u0438\u0437\u044C\u043A\u0456. \u0410\u043B\u0435
      \u0437\u043D\u0430\u0439, \u0449\u043E \u0446\u0435 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043A\u0438 \u0449\u043E
      \u0432\u0438\u043A\u043E\u043D\u0443\u0439 \u0432\u043A\u0430\u0437\u0456\u0432\u043A\u0438
      \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430, \u0432\u0456\u043D
      \u043F\u0456\u0434\u043A\u0430\u0436\u0435 \u0442\u043E\u0431\u0456, \u0449\u043E
      \u0440\u043E\u0431\u0438\u0442\u0438. \u0412\u0456\u043D \u043D\u0435 \u043E\u0431\u0434\u0443\u0440\u0438\u0442\u044C
      \u0442\u0435\u0431\u0435, \u044F \u043C\u043E\u0436\u0443 \u0442\u0435\u0431\u0435
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u0437\u0430\u043F\u0435\u0432\u043D\u0438\u0442\u0438.
      \u041F\u043E\u043A\u0438 \u0442\u0438 \u043D\u0430 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u0456,
      \u0442\u0432\u043E\u0454 \u043A\u043E\u0434\u043E\u0432\u0435 \u0456\u043C'\u044F
      - \"\u041E\u0431\u0440\u0430\u043D\u0430-25\". \u041D\u0430 \u0446\u044C\u043E\u043C\u0443
      \u0432\u0441\u0435. \u0423\u0434\u0430\u0447\u0456 \u0442\u043E\u0431\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629838
    m_Localized: "\u0417\u0430\u043F\u0438\u0441 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0432\u0441\u044F,
      \u0456 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456 \u0432\u0438\u0441\u0432\u0456\u0442\u0438\u043B\u0438\u0441\u044F
      \u043D\u043E\u0432\u0456 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629839
    m_Localized: "\u041D\u0443 \u043E\u0441\u044C, \u0442\u0435\u043F\u0435\u0440,
      \u043A\u043E\u043B\u0438 \u043C\u0438 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u043B\u0438\u0441\u044F
      \u0437 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u043C\u0438 \u043F\u0438\u0442\u0430\u043D\u043D\u044F\u043C\u0438,
      \u043D\u0430 \u0442\u0432\u043E\u0454\u043C\u0443 \u041F\u0456\u043F\u0411\u0430\u043A\u0443
      \u0440\u043E\u0437\u0431\u043B\u043E\u043A\u043E\u0432\u0430\u043D\u043E \u0437\u0430\u043F\u0438\u0441\u0438
      \u0437 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u043C\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F\u043C\u0438.
      \u041F\u0430\u043C'\u044F\u0442\u0430\u0439, \u0443 \u0442\u0432\u043E\u0457\u0445
      \u0436\u0435 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u0457\u0445 \u044F\u043A\u043D\u0430\u0439\u0448\u0432\u0438\u0434\u0448\u0435.
      \u041D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C \u0442\u0438 \u043E\u043F\u0438\u043D\u0438\u0448\u0441\u044F
      \u0432 \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0441\u0442\u0456, \u0456\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0456\u0439
      \"\u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u043E\u044E
      \u041F\u0443\u0441\u0442\u043A\u043E\u044E\". \u0414\u043E\u0442\u0440\u0438\u043C\u0443\u0439\u0441\u044F
      \u043A\u0440\u0430\u0439\u043D\u044C\u043E\u0457 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0441\u0442\u0456,
      \u0437\u0430 \u043C\u043E\u0457\u043C\u0438 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u044F\u043C\u0438,
      \u0446\u0435 \u043C\u0456\u0441\u0446\u0435 \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435.
      \u0422\u043E\u0431\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F
      \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u043E \u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0456
      \u0434\u0438\u043A\u0443\u043D\u0438 \u0456 \u0442\u0432\u0430\u0440\u0438\u043D\u0438-\u043C\u0443\u0442\u0430\u043D\u0442\u0438.
      \u0422\u0430\u043A\u043E\u0436 \u0437\u0430\u0433\u0440\u043E\u0437\u0443 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u0437\u043E\u043D\u0438 \u0437 \u0440\u0430\u0434\u0456\u0430\u0446\u0456\u0439\u043D\u0438\u043C
      \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u043D\u044F\u043C. \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
      \u0443\u0432\u0456\u0439\u0442\u0438 \u0432 \u043A\u043E\u043D\u0442\u0430\u043A\u0442
      \u0456\u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u043C\u0438 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438.
      \u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0448, \u043A\u043E\u043B\u0438
      \u0432 \u0446\u044C\u043E\u043C\u0443 \u0431\u0443\u0434\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0430.
      \u041F\u0430\u043C'\u044F\u0442\u0430\u0439, \u0442\u0432\u043E\u0454 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F
      \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0435 \u0434\u043B\u044F
      \u0432\u0441\u0456\u0445 \u043D\u0430\u0441. \u0414\u043E \u0437\u0432'\u044F\u0437\u043A\u0443,
      \"\u041E\u0431\u0440\u0430\u043D\u0430-25\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629840
    m_Localized: "\u041F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u0437\u043D\u0438\u043A\u043B\u0438, \u0456 \u041F\u0456\u043F\u0411\u0430\u043A
      \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F
      \u0443 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439 \u0440\u0435\u0436\u0438\u043C.
      \u0423 \u0440\u043E\u0437\u0434\u0456\u043B\u0456 \"\u0417\u0430\u0432\u0434\u0430\u043D\u043D\u044F\"
      \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F \u043D\u043E\u0432\u0456
      \u0437\u0430\u043F\u0438\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629841
    m_Localized: "\u042F \u043F\u0430\u043C'\u044F\u0442\u0430\u044E \u0441\u0432\u043E\u0454
      \u0421\u0442\u0456\u0439\u043B\u043E! \u0429\u043E\u0441\u044C \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043F\u0430\u043C'\u044F\u0442\u0430\u044E... \u0441\u043C\u0443\u0442\u043D\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629842
    m_Localized: "\u0410\u0440\u0433\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629843
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043F\u0430\u043C'\u044F\u0442\u0456?
      \u042F\u043A \u044F \u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0433\u043E\u0434\u0438\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0442\u0430\u043A\u0435? \u0410\u043B\u0435 \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0456
      \u0442\u043E\u0447\u043D\u043E \u0431\u0443\u0432 \u043C\u0456\u0439 \u0433\u043E\u043B\u043E\u0441,
      \u0456 \u044F\u043A\u0449\u043E \u044F \u0431\u0443\u043B\u0430 \u0442\u0430\u043A
      \u0443\u043F\u0435\u0432\u043D\u0435\u043D\u0430 \u0443 \u0441\u0432\u043E\u0457\u0439
      \u0434\u043E\u0432\u0456\u0440\u0456 \u0446\u044C\u043E\u043C\u0443... \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u0432\u0456,
      \u043D\u0430 \u0442\u0435 \u043C\u0430\u043B\u0438 \u0431\u0443\u0442\u0438
      \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629844
    m_Localized: "\u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u0440\u0430\u0437\u0456 \u0432 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0433\u043E \u0432\u0438\u0431\u043E\u0440\u0443.
      \u0410\u0431\u043E \u044F \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438
      \u0437\u0430\u043B\u0438\u0448\u0443\u0441\u044F \u0432 \u0446\u044C\u043E\u043C\u0443
      \u043C\u0456\u0441\u0446\u0456, \u0430\u0431\u043E \u0432\u0438\u043A\u043E\u043D\u0430\u044E
      \u0434\u043E\u0440\u0443\u0447\u0435\u043D\u043D\u044F \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430,
      \u0430 \u0442\u0430\u043C \u0443\u0436\u0435 \u0431\u0443\u0434\u044C \u0449\u043E
      \u0431\u0443\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629845
    m_Localized: "\u0422\u043E \u0446\u0435 \u0456 \u0454 \u0415\u043A\u0432\u0435\u0441\u0442\u0440\u0456\u0439\u0441\u044C\u043A\u0430
      \u041F\u0443\u0441\u0442\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629846
    m_Localized: "\u0422\u0443\u0442 \u0442\u0430\u043A... \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629847
    m_Localized: "\u041E\u0445! \u0413\u043E\u043B\u043E\u0432\u0430 \u043F\u0430\u043C\u043E\u0440\u043E\u0447\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629848
    m_Localized: "\u041D\u0435 \u043C\u043E\u0436\u0443 \u043F\u043E\u0432\u0456\u0440\u0438\u0442\u0438,
      \u044F \u043B\u0456\u0437\u0443 \u0432 \u0449\u0443\u0440\u044F\u0447\u0443
      \u043D\u043E\u0440\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629849
    m_Localized: "\u041D\u0430\u0432\u0456\u0449\u043E \u044F \u0446\u0435 \u0440\u043E\u0431\u043B\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629850
    m_Localized: "\u041F\u0435\u0440\u0448\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u0447
      \u0456\u0437 \u0440\u0435\u0439\u0434\u0435\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629851
    m_Localized: "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0442\u0430\u043C
      \u0445\u0442\u043E\u0441\u044C \u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629852
    m_Localized: "\u041B\u043E\u043A\u0430\u0442\u043E\u0440 \u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0454
      \u0432\u043E\u0440\u043E\u0436\u0443 \u0446\u0456\u043B\u044C! \u041D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0446\u0435 \u043F\u043E\u043D\u0456, \u0432\u043E\u043D\u0438
      \u0434\u0430\u043B\u0435\u043A\u043E \u043D\u0435 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u043E
      \u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629853
    m_Localized: "\u0410\u043B\u0435 \u0432\u0441\u0435 \u0436, \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u0438
      \u0436 \u043D\u0430 \u043D\u0438\u0445 \u043F\u0435\u0440\u0448\u043E\u044E.
      \u041C\u043E\u0436\u0435, \u0437 \u043D\u0438\u043C\u0438 \u0432\u0441\u0435
      \u0436 \u0442\u0430\u043A\u0438 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F
      \u0445\u043E\u0447\u0430 \u0431 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629854
    m_Localized: "\u0415-\u0435-\u0435... \u043F\u0440\u0438\u0432\u0456\u0442! \u0412\u0438
      \u0442\u0443\u0442 \u0436\u0438\u0432\u0435\u0442\u0435? \u042F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629855
    m_Localized: "\u0429\u043E? \u0410 \u0442\u0438 \u0449\u0435, \u043C\u0430\u0442\u0456\u0440
      \u0442\u0432\u043E\u044E, \u0445\u0442\u043E????"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629856
    m_Localized: "\u0413\u0435\u0439, \u0443\u0441\u0456 \u0441\u044E\u0434\u0438!
      \u0417\u0430\u0440\u0430\u0437 \u0443\u0441\u0456\u043C \u0431\u0443\u0434\u0435
      \u0434\u0443\u0436\u0435 \u0432\u0435\u0441\u0435\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629857
    m_Localized: "\u042F... \u0432\u0431\u0438\u043B\u0430 \u043F\u043E\u043D\u0456?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629858
    m_Localized: "\u041D\u0456! \u0425\u043E\u0447 \u0431\u0438 \u0449\u043E \u0442\u0430\u043C
      \u0431\u0443\u043B\u043E, \u0446\u044F \u043F\u0441\u0438\u0445\u043E\u043F\u0430\u0442\u043A\u0430
      \u043D\u0435 \u0434\u0443\u0436\u0435-\u0442\u043E \u0431\u0443\u043B\u0430
      \u0441\u0445\u043E\u0436\u0430 \u043D\u0430 \u043F\u043E\u043D\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629859
    m_Localized: "\u0417\u0430\u0441\u0456\u0434\u043A\u0430 \u0440\u0435\u0439\u0434\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629860
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u043C\u043E\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430
      \u043F\u043E\u043D\u0456. \u0429\u043E \u0446\u0435 \u0442\u0438 \u0442\u0443\u0442
      \u0440\u043E\u0431\u0438\u0448 \u0437\u043E\u0432\u0441\u0456\u043C \u0441\u0430\u043C\u0430?
      \u0410 \u0447\u0438 \u043D\u0435 \u0445\u043E\u0447\u0435\u0448 \u0432\u0435\u0441\u0435\u043B\u043E
      \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0437 \u043D\u0430\u043C\u0438
      \u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629861
    m_Localized: "\u041E\u0442\u0436\u0435, \u0445\u043E\u0447\u0435\u0448 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0438\u0442\u0438\u0441\u044F?
      \u041D\u0443 \u0434\u0430\u0432\u0430\u0439, \u0439\u0434\u0438 \u0441\u044E\u0434\u0438,
      \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F, \u043A\u043E\u043C\u0443
      \u0437\u0430\u0440\u0430\u0437 \u0431\u0443\u0434\u0435 \u0432\u0435\u0441\u0435\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629862
    m_Localized: "\u0425\u0430-\u0445\u0430-\u0445\u0430, \u043E\u0441\u044C \u0446\u0435
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F!
      \u0414\u0435\u043D\u044C \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u044F\u0432\u043D\u043E
      \u0432\u0434\u0430\u043B\u0438\u0439. \u0417\u0430\u0440\u0430\u0437 \u043C\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629863
    m_Localized: "\u0429\u043E \u0442\u0430\u043C \u0449\u0435 \u0437\u0430 \u043D\u0430\u0445\u0435\u0440?|
      \u0429\u043E \u0442\u0430\u043C \u0449\u0435 \u0442\u0430\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629864
    m_Localized: "\u0413\u0435\u0439, \u0442\u0438! \u041F\u0440\u0438\u0433\u043D\u0438\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629865
    m_Localized: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447 \u0456\u0437 \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629866
    m_Localized: "\u0413\u0435\u0439, \u0442\u0438 \u0448\u043E \u0442\u0430\u043C,
      \u0437\u043E\u0432\u0441\u0456\u043C \u0437\u0434\u0443\u0440\u0456\u043B\u0430?
      \u0427\u043E\u0433\u043E \u0442\u0438 \u0442\u0443\u0442 \u043E\u0434\u043D\u0430
      \u0440\u043E\u0431\u0438\u0448? \u0414\u043E\u0431\u0440\u0435, \u0449\u043E
      \u044F \u0442\u0435\u0431\u0435 \u043F\u043E\u043C\u0456\u0442\u0438\u0432
      \u0432\u0447\u0430\u0441\u043D\u043E, \u0430 \u0442\u043E \u0434\u0430\u0436
      \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u043E\u0433\u043E \u0431 \u0446\u0456
      \u0440\u0435\u0439\u0434\u0435\u0440\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E
      \u0432\u0447\u0438\u043D\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629867
    m_Localized: "\u0415-\u0435-\u0435... \u0441\u043F\u0430\u0441\u0438\u0431\u0456,
      \u0437\u0432\u0456\u0441\u043D\u043E, \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443,
      \u0430\u043B\u0435 \u0432 \u043C\u0435\u043D\u0435 \u0432\u0441\u0435 \u0431\u0443\u043B\u043E
      \u043F\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629868
    m_Localized: "\u0410\u0433\u0430, \u0449\u0430\u0441. \u042F \u0431\u0430\u0447\u0438\u0432,
      \u044F\u043A \u0443\u0441\u0435 \u0431\u0443\u043B\u043E. \u041E\u0434\u043D\u0456\u0441\u0456\u043D\u044C\u043A\u0430
      \u043F\u043E\u043D\u0456 \u0431\u0435\u0437 \u0431\u0440\u043E\u043D\u0456
      \u0456 \u0434\u043E\u0431\u0440\u043E\u0457 \u0437\u0431\u0440\u043E\u0457
      \u043F\u0440\u043E\u0442\u0438 \u043D\u0430\u0442\u043E\u0432\u043F\u0443 \u0432\u0456\u0434\u043C\u043E\u0440\u043E\u0437\u043A\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629869
    m_Localized: "\u0410 \u0448\u043E \u0446\u0435 \u0442\u0438 \u043D\u0430 \u043C\u0435\u043D\u0435
      \u0442\u0430\u043A \u0432\u0442\u0443\u043F\u0438\u043B\u0430\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629870
    m_Localized: "\u0412\u0438\u0431\u0430\u0447. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0456\u043A\u043E\u043B\u0438 \u0440\u0430\u043D\u0456\u0448\u0435 \u043D\u0435
      \u0431\u0430\u0447\u0438\u043B\u0430 \u043F\u0435\u0433\u0430\u0441\u0456\u0432.
      \u0423 \u043D\u0430\u0441 \u0443... \u0443 \u0441\u0435\u043D\u0441\u0456,
      \u0432 \u0442\u0438\u0445 \u043C\u0456\u0441\u0446\u044F\u0445, \u0437\u0432\u0456\u0434\u043A\u0438
      \u044F \u043F\u0440\u0438\u0439\u0448\u043B\u0430, \u043F\u0435\u0433\u0430\u0441\u0456\u0432
      \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629871
    m_Localized: "\u0410, \u043D\u0443 \u044F\u0441\u043D\u043E! \u041D\u0430\u0441
      \u0443\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0435 \u0442\u0430\u043A
      \u0443\u0436\u0435 \u0439 \u0431\u0430\u0433\u0430\u0442\u043E \u043D\u0430
      \u041F\u0443\u0441\u0442\u0438\u0449\u0430\u0445... \u041F\u043E\u0447\u0435\u043A\u0430\u0439,
      \u043F\u0440\u043E \u044F\u043A\u0456 \u0446\u0435 \u043C\u0456\u0441\u0446\u044F
      \u0442\u0438 \u0449\u0430\u0441 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629872
    m_Localized: "\u041D\u0443... \u044F \u043D\u0435 \u043C\u0456\u0441\u0446\u0435\u0432\u0430.
      \u0417 \u0434\u0430\u043B\u0435\u043A\u0438\u0445 \u043A\u0440\u0430\u0457\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629873
    m_Localized: "\u0417 \u044F\u043A\u0438\u0445 \u0442\u0430\u043A\u0438\u0445
      \u043A\u0440\u0430\u0457\u0432? \u0417\u0430\u0447\u0435\u043A\u0430\u0439
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443. \u0414\u0430\u0439 \u0432\u0433\u0430\u0434\u0430\u044E:
      \u0442\u0438 \u0437\u0456 \u0421\u0442\u0456\u0439\u043B\u0430? \u0425\u0430,
      \u0442\u043E\u0447\u043D\u044F\u043A, \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0437\u0432\u0456\u0434\u0442\u0438. \u0406 \u0446\u0435 \u0432\u0431\u0440\u0430\u043D\u043D\u044F
      \u0434\u0438\u0432\u043D\u0435... \u0422\u043E\u0447\u043D\u043E, \u0432\u0441\u0435
      \u0441\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F. \u0421\u043A\u0430\u0436\u0443
      \u0442\u043E\u0431\u0456, \u0421\u0442\u0456\u0439\u043B \u0437 \u0436\u0438\u0432\u0438\u043C\u0438
      \u043F\u043E\u043D\u0456 \u043C\u0430\u043B\u043E \u0437\u043E\u0432\u0441\u0456\u043C,
      \u044F \u0442\u0430\u043A\u0438\u0445, \u044F\u043A \u0442\u0438, \u043D\u0435
      \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044E \u043C\u0430\u0439\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629874
    m_Localized: "\u0422\u0438 \u043C\u0430\u0454\u0448 \u0440\u0430\u0446\u0456\u044E.
      \u0410\u043B\u0435, \u0431\u0435\u0437 \u043E\u0431\u0440\u0430\u0437, \u0434\u0430\u0432\u0430\u0439
      \u0446\u044E \u0442\u0435\u043C\u0443 \u0437\u0430\u0440\u0430\u0437 \u0437\u0430\u043A\u0440\u0438\u0454\u043C\u043E.
      \u0422\u0438 \u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445, \u0432\u0456\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629875
    m_Localized: "\u041D\u0443, \u043C\u043E\u0436\u043D\u0430 \u0439 \u0442\u0430\u043A
      \u0441\u043A\u0430\u0437\u0430\u0442\u0438. \u0411\u0443\u0434\u0435\u043C\u043E
      \u0437\u043D\u0430\u0439\u043E\u043C\u0456, \u044F - \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629876
    m_Localized: "\u0414\u0443\u0436\u0435 \u043F\u0440\u0438\u0454\u043C\u043D\u043E,
      @lp. \u0421\u043B\u0443\u0445\u0430\u0439, \u041A\u0430\u043B\u0430\u043C\u0456\u0442\u0456,
      \u044F\u043A\u0449\u043E \u0442\u043E\u0431\u0456 \u043D\u0435 \u0432\u0430\u0436\u043A\u043E,
      \u0442\u0438 \u043D\u0435 \u043C\u0456\u0433 \u0431\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0438
      \u043C\u0435\u043D\u0456 \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u043E
      \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E \u043C\u0456\u0441\u0442\u0430
      \u0447\u0438 \u0456\u043D\u0448\u043E\u0433\u043E \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629877
    m_Localized: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D, \u044F \u0442\u0435
      \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443.
      \u0422\u0443\u0442 \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E \u0442\u0430\u0431\u0456\u0440
      \"\u0413\u0430\u0440\u0446\u044E\u044E\u0447\u0438\u0439 \u041F\u043E\u043D\u0456\".
      \u0422\u0430\u043C \u0442\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0448
      \u0443\u0441\u0435, \u0449\u043E \u0442\u043E\u0431\u0456 \u043C\u043E\u0436\u0435
      \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F. \u0421\u043A\u0430\u0436\u0438,
      \u043A\u043E\u043B\u0438 \u0431\u0443\u0434\u0435\u0448 \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629878
    m_Localized: "\u0412\u0456\u0442\u0430\u0454\u043C\u043E! \u0412\u0438 \u043F\u043E\u0434\u043E\u043B\u0430\u043B\u0438
      [\u043F\u0435\u0440\u0448\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C
      \u0437\u0430\u0432\u043E\u0434\u0443]. \u0429\u043E\u0431 \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u043D\u0430 [\u0434\u0440\u0443\u0433\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C],
      \u043F\u0440\u043E\u0439\u0434\u0456\u0442\u044C \u0443 \u0434\u0432\u0435\u0440\u0456
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447. \u041D\u0430 \u043A\u043E\u0436\u043D\u043E\u043C\u0443
      \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u043D\u0430 \u0432\u0430\u0441 \u0447\u0435\u043A\u0430\u044E\u0442\u044C
      \u043D\u043E\u0432\u0456 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F,
      \u043D\u043E\u0432\u0456 \u0432\u043E\u0440\u043E\u0433\u0438 \u0442\u0430
      \u043D\u043E\u0432\u0456 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0438.
      \u0422\u0430\u043A\u043E\u0436 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F [\u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u043E\u043C
      \u041C\u0422\u041D], \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u043C\u0456\u0441\u0442\u0438\u0442\u0438\u0441\u044F
      \u0434\u043E \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u0442\u0430\u0431\u043E\u0440\u0443
      \u0434\u043B\u044F \u043B\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u0442\u0430
      \u043F\u043E\u043F\u043E\u0432\u043D\u0435\u043D\u043D\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629879
    m_Localized: "\u0422\u0430\u043A, \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F...
      \u0441\u0445\u043E\u0436\u0435 \u043D\u0430 \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0439
      \u043F\u043B\u0430\u043D \u0437\u0430\u0432\u043E\u0434\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629880
    m_Localized: "\u0417\u0430\u0440\u0430\u0437 \u044F \u043D\u0430 \u043F\u0435\u0440\u0448\u043E\u043C\u0443
      \u0440\u0456\u0432\u043D\u0456. \u0413\u043B\u0438\u0431\u0448\u0435 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F
      \u0434\u0440\u0443\u0433\u0438\u0439, \u0442\u0440\u0435\u0442\u0456\u0439
      \u0456... \u0449\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0456\u043D\u0448\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629881
    m_Localized: "\u041C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C, \u044F\u043A\u0438\u0439
      \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D,
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0443 \u0412\u0456\u0434\u0434\u0456\u043B\u0456
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445 \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C.
      \u0412\u0445\u043E\u0434\u0438 \u0432 \u043D\u044C\u043E\u0433\u043E \u0454
      \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u0439 \u0433\u043B\u0438\u0431\u0448\u0435. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0439\u0442\u0438 \u0432\u043D\u0438\u0437. \u0422\u0430\u043A, \u0456 \u0449\u043E\u0431
      \u0443\u0432\u0456\u0439\u0442\u0438 \u0442\u0443\u0434\u0438, \u043C\u0435\u043D\u0456
      \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u043A\u043B\u044E\u0447
      \u0441\u043B\u0443\u0436\u0431\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629882
    m_Localized: "\u0422\u0430\u043A, \u0446\u0435\u0439 \u0437\u0430\u0432\u043E\u0434
      \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439.
      \u042F\u043A\u0449\u043E \u043C\u0435\u043D\u0456 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u044C\u0441\u044F,
      \u044F \u043C\u043E\u0436\u0443 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0432\u0430\u0442\u0438
      \u0439\u043E\u0433\u043E \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629883
    m_Localized: "\u0422\u0430\u043A, \u0441\u0445\u043E\u0436\u0435, \u044F \u043D\u0430
      \u0432\u0456\u0440\u043D\u043E\u043C\u0443 \u0448\u043B\u044F\u0445\u0443.
      \u0412\u0456\u0434\u0434\u0456\u043B \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C \u0434\u0430\u043B\u0456
      \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629884
    m_Localized: "\u0406\u0434\u0456\u0442\u044C \u043F\u0440\u044F\u043C\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u043E\u043C,
      \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043E
      [\u0412\u0456\u0434\u0434\u0456\u043B\u0443 \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445
      \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C] \u0456 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438
      \u0441\u0432\u043E\u044E \u043C\u0456\u0441\u0456\u044E. \u0410\u0431\u043E
      \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044C \u0443 \u0434\u0432\u0435\u0440\u0456
      [Exit], \u0449\u043E\u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u043D\u043E\u0432\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F \u0437\u0430\u0432\u043E\u0434\u0443. \u0412\u0438
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0441\u044E\u0434\u0438, \u043A\u043E\u043B\u0438 \u0431\u0443\u0434\u0435\u0442\u0435
      \u0433\u043E\u0442\u043E\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629885
    m_Localized: "\u0421\u0445\u043E\u0436\u0435, \u0412\u0456\u0434\u0434\u0456\u043B
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445 \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C
      \u0442\u0443\u0442. \u0422\u0440\u0435\u0431\u0430 \u0437\u043D\u0430\u0439\u0442\u0438
      \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629886
    m_Localized: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430.
      \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0437\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F
      \u0434\u043E \u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2733629887
    m_Localized: "\u041F\u0435\u0440\u0448\u0430 \u0440\u043E\u0437\u043C\u043E\u0432\u0430
      \u0437 \u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629888
    m_Localized: "\u0412\u0438 \u043F\u0456\u0434\u043A\u043B\u044E\u0447\u0430\u0454\u0442\u0435
      \u0441\u0432\u0456\u0439 \u041F\u0456\u043F\u0411\u0430\u043A \u0434\u043E
      \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443 \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C\u0430.
      \u042F\u043A\u0438\u0439\u0441\u044C \u0447\u0430\u0441 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043F\u043E\u0442\u0456\u043C \u043F\u043E \u0435\u043A\u0440\u0430\u043D\u0443
      \u041F\u0456\u043F\u0411\u0430\u043A\u0430 \u043F\u0440\u043E\u0431\u0456\u0433\u0430\u044E\u0442\u044C
      \u0440\u044F\u0434\u0438 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432,
      \u044F\u043A\u0456 \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C\u0441\u044F
      \u0456\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u043E\u043C \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F.
      \u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u0435\u043A\u0440\u0430\u043D \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0443
      \u043E\u0436\u0438\u0432\u0430\u0454, \u0456 \u043D\u0430 \u043D\u044C\u043E\u043C\u0443
      \u043E\u0434\u0438\u043D \u0437\u0430 \u043E\u0434\u043D\u0438\u043C \u0437'\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u0440\u044F\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
