  - m_Id: 787473960
    m_Localized: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0439 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F
      \u043C\u044F\u0447\u0438\u043A \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0441\u0432\u0435\u0442\u0430 \u0438 \u0442\u0435\u043D\u0435\u0439. \u041E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439;
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      1 \u0435\u0434\u0438\u043D\u0438\u0446\u0443 \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043C\u044F\u0447\u0438\u043A. \u0421\u0432\u0435\u0442\u0438\u0442 120 \u0441\u0435\u043A\u0443\u043D\u0434
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
