    m_Metadata:
      m_Items: []
  - m_Id: 2742018691
    m_Localized: Somos los mejores!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018692
    m_Localized: "\xA1Haz que Equestria sea genial otra vez!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018693
    m_Localized: Han recortado las raciones otra vez...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018694
    m_Localized: Nuestro deber es duro
    m_Metadata:
      m_Items: []
  - m_Id: 2742018695
