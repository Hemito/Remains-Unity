    m_Localized: "Parece m\xE1s un huevo de alg\xFAn reptil que un p\xE1jaro"
    m_Metadata:
      m_Items: []
  - m_Id: 2725241917
    m_Localized: Carne
    m_Metadata:
      m_Items: []
  - m_Id: 2725241918
    m_Localized: No se recomienda comer carne cruda.
    m_Metadata:
      m_Items: []
  - m_Id: 2725241919
    m_Localized: Patata
    m_Metadata:
      m_Items: []
