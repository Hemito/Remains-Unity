    m_Localized: Un placer hacer un trato contigo
    m_Metadata:
      m_Items: []
  - m_Id: 2742019188
    m_Localized: "Si me necesitas, estar\xE9 aqu\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019189
    m_Localized: Regresa cuando tengas mas tapas
    m_Metadata:
      m_Items: []
  - m_Id: 2742019190
    m_Localized: "\xA1Oye, no toques esto!"
    m_Metadata:
      m_Items: []
