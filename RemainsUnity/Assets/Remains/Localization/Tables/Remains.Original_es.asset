  - m_Id: 2742018361
    m_Localized: Yikes!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018362
    m_Localized: Ouch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018363
    m_Localized: Ow, duele!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018364
    m_Localized: Oh mi, trasero!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018365
    m_Localized: creo que me dispararon en el trasero!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018366
    m_Localized: Maldita sea!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018367
    m_Localized: la Perra me tiene!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018368
    m_Localized: "Oh, j\xF3dete!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018369
    m_Localized: Mierdaaaa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018370
    m_Localized: Hah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018371
    m_Localized: "Aqu\xED vamos!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018372
    m_Localized: Hecho!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018373
    m_Localized: "No fue tan dif\xEDcil en lo absoluto"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018374
    m_Localized: Pan comido
    m_Metadata:
      m_Items: []
  - m_Id: 2742018375
    m_Localized: Yeah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018376
    m_Localized: "F\xE1cil!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018377
    m_Localized: "\xC9xitooo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018378
    m_Localized: Buen trabajo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018379
    m_Localized: BUM PERRA!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018380
    m_Localized: Ninguna cerradura puede detenerme!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018381
    m_Localized: "Toma eso, est\xFApido candado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018382
    m_Localized: Dichas cerraduras solo son buenas para los inodoros
    m_Metadata:
      m_Items: []
  - m_Id: 2742018383
    m_Localized: "Ning\xFAn jodido candado puede resistirse"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018384
    m_Localized: "\xBFLa contrase\xF1a es \"123\" nuevamente? o vamos!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018385
    m_Localized: Noobs!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018386
    m_Localized: "Qu\xE9 contrase\xF1a inapropiada..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018387
    m_Localized: "Contrase\xF1a \"polla123\"? \xA1Podr\xEDa haberlo adivinado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018388
    m_Localized: "\xA1Maldito!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018389
    m_Localized: que demonios!..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018390
    m_Localized: A NO MI HERMANO consiguete la tuya!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018391
    m_Localized: "\xA1Es una mierda!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018392
    m_Localized: "Es m\xE1s dif\xEDcil de lo que parece"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018393
    m_Localized: Mala suerte!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018394
    m_Localized: No hay problema
    m_Metadata:
      m_Items: []
  - m_Id: 2742018395
    m_Localized: "Lo intentar\xE9 de nuevo"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018396
    m_Localized: "\xA1Oh no, no me rendir\xE9 tan f\xE1cilmente!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018397
    m_Localized: "\xA1Yo puedo hacerlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018398
    m_Localized: Arrrgh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018399
    m_Localized: "Oh, vete al T\xE1rtaro..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018400
    m_Localized: "Oh, \xA1Luna me puso en tu cuerno!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018401
    m_Localized: "Oh, \xBFpor qu\xE9 la vida es tan injusta?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018402
    m_Localized: "\xBFPor qu\xE9 todo deber\xEDa ser tan dif\xEDcil?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018403
    m_Localized: "\xA1Celestia, t\xF3came con tu cuerno!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018404
    m_Localized: "\xA1Oh, ve con  Discord!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018405
    m_Localized: "\xA1Hoy no es mi d\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018406
    m_Localized: "\xBFPor qu\xE9 no puedo hacer esto?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018407
    m_Localized: "\xA1Oh, vete al heno!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018408
    m_Localized: "Oh tu peque\xF1o..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018409
    m_Localized: Que mierda!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018410
    m_Localized: "Si\xE9ntate en mi cuerno y gira!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018411
    m_Localized: Oh por el amor de Celestia!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018412
    m_Localized: "Bueno, eso est\xE1 jodido!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018413
    m_Localized: "\xA1Luna te viol\xF3 con su cuerno!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018414
    m_Localized: el premio mayor!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018415
    m_Localized: Jackpot!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018416
    m_Localized: SI!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018417
    m_Localized: Oh wow!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018418
    m_Localized: Guay!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018419
    m_Localized: "\xA1Eso vali\xF3 la pena!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018420
    m_Localized: Err...y?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018421
    m_Localized: Eso es todo?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018422
    m_Localized: "Me est\xE1s tomando el pelo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018423
    m_Localized: "\xA1Maldito! Solo basura"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018424
    m_Localized: "\xBFPor qu\xE9 est\xE1 vac\xEDo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018425
    m_Localized: "\xA1Tengo la sensaci\xF3n de que alg\xFAn pony me est\xE1 jugando
      una!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018426
    m_Localized: "Matar\xEDa por algo de humo..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018427
    m_Localized: Maldito dolor de cabeza...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018428
    m_Localized: Este maldito lugar tiene comida?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018429
    m_Localized: Hola, tontos!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018430
    m_Localized: Tengo que hacer pis
    m_Metadata:
      m_Items: []
  - m_Id: 2742018431
    m_Localized: "Un poco de cerveza me alegrar\xEDa el d\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018432
    m_Localized: Quiero un poco de golpes y golpes?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018433
    m_Localized: "\xBFQuieres que te pate las bolas??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018434
    m_Localized: "\xA1Qu\xE9 imbecil!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018435
    m_Localized: Buhuu...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018436
    m_Localized: Maldita sea, estoy drogado!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018437
    m_Localized: "\xA1Vayan por ella!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018438
    m_Localized: Manzanas de caballo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018439
    m_Localized: "\xBFQu\xE9 est\xE1s mirando, gilipollas??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018440
    m_Localized: Jack culo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018441
    m_Localized: A la luna, playa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018442
    m_Localized: Ahm estoy harto de esto!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018443
    m_Localized: Ahm con toda esta basura
    m_Metadata:
      m_Items: []
  - m_Id: 2742018444
    m_Localized: Dios quiera maldita sea!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018445
    m_Localized: '* silbidos *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018446
    m_Localized: '* escupitajo *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018447
    m_Localized: '* maldiciones *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018448
    m_Localized: '* bostezos *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018449
    m_Localized: '* risa loca *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018450
    m_Localized: "* mirada vac\xEDa *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018451
    m_Localized: "Prep\xE1rate para morir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018452
    m_Localized: Muereee!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018453
    m_Localized: Cargaaaa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018454
    m_Localized: ESTA PERRA ESTA LOCA!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018455
    m_Localized: "Te atrapar\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018456
    m_Localized: "\xA1La diversi\xF3n se ha duplicado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018457
    m_Localized: "\xA1Divertido! \xA1Divertido! \xA1Divertido!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018458
    m_Localized: Te voy a aplastar!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018459
    m_Localized: "\xA1Sum\xE9rgete!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018460
    m_Localized: "Tiempo de violaci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018461
    m_Localized: "Est\xFApido!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018462
    m_Localized: "\xA1Mata a todos!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018463
    m_Localized: "Ven aqu\xED, imb\xE9cil!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018464
    m_Localized: Mu-ha-ha-ha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018465
    m_Localized: Aha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018466
    m_Localized: Bu-ha-ha-ha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018467
    m_Localized: Sangre!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018468
    m_Localized: Meat!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018469
    m_Localized: "Est\xE1s condenado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018470
    m_Localized: "Di adi\xF3s, co\xF1o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018471
    m_Localized: "\xA1Te veoooo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018472
    m_Localized: "\xA1Ah\xED est\xE1 ella!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018473
    m_Localized: Cada pony para haya
    m_Metadata:
      m_Items: []
  - m_Id: 2742018474
    m_Localized: Matar!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018475
    m_Localized: Muere, perra!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018476
    m_Localized: "\xA1Mata, mata, mata!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018477
    m_Localized: Quemar!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018478
    m_Localized: Quieres crudo o bien hecho?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018479
    m_Localized: Fuego!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018480
    m_Localized: "M\xE1talo con fuego!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018481
    m_Localized: Carne rostizada!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018482
    m_Localized: "\xA1Hace calor aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018483
    m_Localized: "\xA1Me gusta el olor a napalm en la ma\xF1ana!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018484
    m_Localized: Papas gratis, para cada poni!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018485
    m_Localized: Captura!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018486
    m_Localized: Yeehaa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018487
    m_Localized: El tiempo no se detiene!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018488
    m_Localized: "Una explosi\xF3n, y eres polvo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018489
    m_Localized: Fuegos artificiales!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018490
    m_Localized: Fuego en el hoyo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018491
    m_Localized: "\xA1Deja que tu mundo explote!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018492
    m_Localized: Booom PERRA!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018493
    m_Localized: "Qu\xE9 fue eso?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018494
    m_Localized: Quien esta aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018495
    m_Localized: "\xBFHay alguien por ah\xED??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018496
    m_Localized: "\xBFEh? Que?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018497
    m_Localized: Mmm?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018498
    m_Localized: Que mierda?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018499
    m_Localized: Escuchaste eso?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018500
    m_Localized: "D\xF3nde?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018501
    m_Localized: La mierda esta pasando?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018502
    m_Localized: Quien esta disparando?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018503
    m_Localized: "\xBFEscuch\xE9 algo caer?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018504
    m_Localized: He escuchado algo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018505
    m_Localized: Esto de nuevo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018506
    m_Localized: Donde esta ella?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018507
    m_Localized: "Encu\xE9ntrala!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018508
    m_Localized: Te encontrare!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018509
    m_Localized: "No puedo esconderme, peque\xF1o co\xF1o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018510
    m_Localized: "D\xF3nde est\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018511
    m_Localized: No la veo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018512
    m_Localized: Ella esta en alguna parte
    m_Metadata:
      m_Items: []
  - m_Id: 2742018513
    m_Localized: "Encu\xE9ntrala, chicos!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018514
    m_Localized: "A d\xF3nde fue?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018515
    m_Localized: Joder, donde estas?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018516
    m_Localized: Donde te escondes?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018517
    m_Localized: "No sirve de nada esconderse, cari\xF1o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018518
    m_Localized: "\xA1Esto lo hace a\xFAn m\xE1s interesante!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018519
    m_Localized: "Sal y lo har\xE9 sin dolor"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018520
    m_Localized: "\xA1Sal, cobarde!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018521
    m_Localized: Oh, a la mierda...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018522
    m_Localized: "D\xE9jala ir a ella misma"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018523
    m_Localized: Si, corre, perra!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018524
    m_Localized: Manzanas de caballo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018525
    m_Localized: "La conseguire m\xE1s tarde"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018526
    m_Localized: "Ella no llegar\xE1 tan lejos"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018527
    m_Localized: Buen puto viaje
    m_Metadata:
      m_Items: []
  - m_Id: 2742018528
    m_Localized: Diosa, viola a sus muertos!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018529
    m_Localized: "Debe ser mi imaginaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018530
    m_Localized: Es solo viento
    m_Metadata:
      m_Items: []
  - m_Id: 2742018531
    m_Localized: Limpio...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018532
    m_Localized: Estaba bastante seguro de haber escuchado algo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018533
    m_Localized: Nah, eso no es nada
    m_Metadata:
      m_Items: []
  - m_Id: 2742018534
    m_Localized: Probablemente solo ratas...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018535
    m_Localized: "Nah, arr\xF3jate"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018536
    m_Localized: "\xBFY qui\xE9n era ese heno?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018537
    m_Localized: "Te digo que hay un pony all\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018538
    m_Localized: Ya veremos tu sangre...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018539
    m_Localized: "\xA1Te matar\xE9 lentamente!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018540
    m_Localized: OH MIERDAA!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018541
    m_Localized: Ouch!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018542
    m_Localized: Yikes!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018543
    m_Localized: Estoy herido!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018544
    m_Localized: "\xA1Me tienen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018545
    m_Localized: Me estan matando!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018546
    m_Localized: AAAAAH!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018547
    m_Localized: Atestiguame...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018548
    m_Localized: Estoy jodido
    m_Metadata:
      m_Items: []
  - m_Id: 2742018549
    m_Localized: He terminado
    m_Metadata:
      m_Items: []
  - m_Id: 2742018550
    m_Localized: '* jadeos *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018551
    m_Localized: '* muerte *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018552
    m_Localized: Que carajo es esto???
    m_Metadata:
      m_Items: []
  - m_Id: 2742018553
    m_Localized: Quee???
    m_Metadata:
      m_Items: []
  - m_Id: 2742018554
    m_Localized: "D\xE9jame ir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018555
    m_Localized: Magia de mierda!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018556
    m_Localized: Granada!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018557
    m_Localized: Baja!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018558
    m_Localized: Cuidado!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018559
    m_Localized: "Saca el heno de aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018560
    m_Localized: Mira!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018561
    m_Localized: "M\xEDralo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018562
    m_Localized: Oh santo cielo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018563
    m_Localized: Quee!..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018564
    m_Localized: Mierda mierda!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018565
    m_Localized: Que mierda!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018566
    m_Localized: "\xBFCu\xE1nto est\xE1n pagando?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018567
    m_Localized: "\xBFPor cu\xE1nto tiempo debemos estar colgandos aqu\xED??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018568
    m_Localized: Tengo mucha hambre!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018569
    m_Localized: "\xA1Te lo digo, ella no vendr\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018570
    m_Localized: "Deber\xEDamos buscar en otro lugar"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018571
    m_Localized: "No hay nadie all\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018572
    m_Localized: "Y te digo que el objetivo fue visto por \xFAltima vez aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018573
    m_Localized: "Cuanto tiempo m\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018574
    m_Localized: tu tienes un cigarro?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018575
    m_Localized: Revisa tus armas
    m_Metadata:
      m_Items: []
  - m_Id: 2742018576
    m_Localized: "Prep\xE1rate"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018577
    m_Localized: "\xA1Es peligroso aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018578
    m_Localized: "\xBFVale la pena?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018579
    m_Localized: No me gusta aqui
    m_Metadata:
      m_Items: []
  - m_Id: 2742018580
    m_Localized: "\xA1Eso es!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018581
    m_Localized: Alguien quiere jugar a las cartas?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018582
    m_Localized: Estoy tan harto de esto!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018583
    m_Localized: A la mierda esta vida!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018584
    m_Localized: lanzarlo todo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018585
    m_Localized: '* silbido *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018586
    m_Localized: '* escupe *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018587
    m_Localized: '* maldice *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018588
    m_Localized: '* bostezos *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018589
    m_Localized: '* bwak bwak *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018590
    m_Localized: "* rasgu\xF1os *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018591
    m_Localized: "\xA1Atenci\xF3n! Objetivo visto"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018592
    m_Localized: Abran fuego!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018593
    m_Localized: Objetivo a las 12
    m_Metadata:
      m_Items: []
  - m_Id: 2742018594
    m_Localized: Eliminar!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018595
    m_Localized: "Llevamos mucho tiempo esper\xE1ndote!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018596
    m_Localized: "\xA1Y aqu\xED est\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018597
    m_Localized: Eliminar el objetivo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018598
    m_Localized: Dispara a matar!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018599
    m_Localized: Vamos a terminarla!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018600
    m_Localized: Nada personal!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018601
    m_Localized: Esto es solo un negocio
    m_Metadata:
      m_Items: []
  - m_Id: 2742018602
    m_Localized: Solo necesito tu cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 2742018603
    m_Localized: Mejor no te resistas!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018604
    m_Localized: "Qu\xE9date donde est\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018605
    m_Localized: "No corras, o ser\xE1 m\xE1s doloroso"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018606
    m_Localized: Juntos ahora!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018607
    m_Localized: Una bala entre los ojos!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018608
    m_Localized: Solo estoy cumpliendo el contrato
    m_Metadata:
      m_Items: []
  - m_Id: 2742018609
    m_Localized: Este es mi trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018610
    m_Localized: "Pagar\xE1n muy bien por tu cabeza!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018611
    m_Localized: "\xBFQu\xE9 fue eso?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018612
    m_Localized: Quien esta ahi?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018613
    m_Localized: "\xBFHay alg\xFAn poni?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018614
    m_Localized: Ah? Que?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018615
    m_Localized: Ruido sospechoso!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018616
    m_Localized: "\xA1Oye! Mira lo que hay"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018617
    m_Localized: Oyes eso?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018618
    m_Localized: "D\xF3nde?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018619
    m_Localized: "\xBFEst\xE1n disparando en alguna parte??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018620
    m_Localized: Something fell?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018621
    m_Localized: "escuch\xE9 algo"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018622
    m_Localized: Ahi otra vez!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018623
    m_Localized: Donde esta?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018624
    m_Localized: "Encu\xE9ntrala!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018625
    m_Localized: "\xA1Te encontrar\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018626
    m_Localized: "\xA1No sirve de nada esconderse!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018627
    m_Localized: Donde esta ella?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018628
    m_Localized: No la veo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018629
    m_Localized: "Ella est\xE1 all\xED en alguna parte"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018630
    m_Localized: He perdido vision del objetivo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018631
    m_Localized: "\xBFDonde te escondes?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018632
    m_Localized: Buscar desde arriba
    m_Metadata:
      m_Items: []
  - m_Id: 2742018633
    m_Localized: "Te encontrar\xE9 de todos modos"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018634
    m_Localized: Limpiaremos el suelo contigo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018635
    m_Localized: No puedo encontrarla
    m_Metadata:
      m_Items: []
  - m_Id: 2742018636
    m_Localized: "Cesando la b\xFAsqueda"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018637
    m_Localized: "\xA1Nos separaremos y la encontraremos!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018638
    m_Localized: Uh oh, nuestras tapas se las robaron...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018639
    m_Localized: "La encontraremos m\xE1s tarde"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018640
    m_Localized: "Ella no llegar\xE1 lejos"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018641
    m_Localized: No puedes huir de nosotros para siempre
    m_Metadata:
      m_Items: []
  - m_Id: 2742018642
    m_Localized: "No importa, mataremos a alguien m\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018643
    m_Localized: "Mis o\xEDdos me enga\xF1aron"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018644
    m_Localized: Es solo el viento
    m_Metadata:
      m_Items: []
  - m_Id: 2742018645
    m_Localized: Nada...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018646
    m_Localized: Estaba seguro de haber escuchado algo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018647
    m_Localized: No, falsa alarma
    m_Metadata:
      m_Items: []
  - m_Id: 2742018648
    m_Localized: Deben ser las ratas...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018649
    m_Localized: "S\xED, dale un golpe"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018650
    m_Localized: me disparo un tiro pony!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018651
    m_Localized: "No puede ser, definitivamente hay alguien ah\xED"
