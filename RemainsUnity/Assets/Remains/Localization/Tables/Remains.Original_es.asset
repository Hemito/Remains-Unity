    m_Localized: Todos los sistemas se apagan
    m_Metadata:
      m_Items: []
  - m_Id: 2742018998
    m_Localized: La seguridad no puede se...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018999
    m_Localized: Error al asegurar el per...
