      m_Items: []
  - m_Id: 2742018975
    m_Localized: Alerta de acciones ilegales
    m_Metadata:
      m_Items: []
  - m_Id: 2742018976
    m_Localized: Alerta de entrada no autorizada
    m_Metadata:
      m_Items: []
  - m_Id: 2742018977
    m_Localized: Buscando al enemigo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018978
    m_Localized: "Ven e identif\xEDcate"
