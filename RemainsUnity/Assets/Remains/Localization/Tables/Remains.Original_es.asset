    m_Metadata:
      m_Items: []
  - m_Id: 2742019172
    m_Localized: "\xA1Tomamos efectivo o cr\xE9dito!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019173
    m_Localized: Lo que sea, lo tenemos!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019174
    m_Localized: "Precios bajos todos los d\xEDas!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019175
    m_Localized: Armas, explosivos, municiones ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019176
    m_Localized: "\xBFNecesitas munici\xF3n, compa\xF1ero?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019177
    m_Localized: "\xA1Prep\xE1rate y listo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019178
    m_Localized: "\xA1Hola, por aqu\xED, compa\xF1ero!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019179
    m_Localized: "\xA1El negocio m\xE1s honesto en Wasteland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019180
    m_Localized: "\xA1Se anima a un trueque!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019181
    m_Localized: "\xA1La mejor mercanc\xEDa de Wasteland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019182
    m_Localized: "\xA1Garant\xEDa de por vida!"
    m_Metadata:
      m_Items: []
