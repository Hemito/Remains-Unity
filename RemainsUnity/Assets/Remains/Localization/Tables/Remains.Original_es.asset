      m_Items: []
  - m_Id: 2742018916
    m_Localized: "P\xE9rdida de combustible"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018917
    m_Localized: Acciones hostiles
    m_Metadata:
      m_Items: []
  - m_Id: 2742018918
    m_Localized: "Pero por qu\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018919
    m_Localized: "La violencia no es la soluci\xF3n."
