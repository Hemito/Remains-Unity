    m_Localized: Objetivo enemigo adquirido
    m_Metadata:
      m_Items: []
  - m_Id: 2742018973
    m_Localized: "Tienes derecho a una muerte r\xE1pida"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018974
    m_Localized: "Iniciando el protocolo de b\xFAsqueda"
