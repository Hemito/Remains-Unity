    m_Metadata:
      m_Items: []
  - m_Id: 2742018958
    m_Localized: Abran fuego!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018959
    m_Localized: Comprometer al enemigo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018960
    m_Localized: "Protocolo de neutralizaci\xF3n de intrusos"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018961
    m_Localized: Todos los civiles, evacuen inmediatamente
    m_Metadata:
      m_Items: []
  - m_Id: 2742018962
    m_Localized: "No se preocupe, el pedido se restablecer\xE1 en breve."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018963
    m_Localized: "La resistencia se considerar\xE1 un delito."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018964
    m_Localized: Es lo mejor para usted
    m_Metadata:
      m_Items: []
  - m_Id: 2742018965
    m_Localized: "Suelta tus armas y r\xEDndete"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018966
    m_Localized: "Fuego cuando est\xE9n listos"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018967
    m_Localized: Suelta el arma!
    m_Metadata:
      m_Items: []
