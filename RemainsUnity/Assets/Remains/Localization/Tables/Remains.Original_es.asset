    m_Metadata:
      m_Items: []
  - m_Id: 2742018936
    m_Localized: "Por favor, mu\xE9vete"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018937
    m_Localized: La Ley y el orden
    m_Metadata:
      m_Items: []
  - m_Id: 2742018938
    m_Localized: Modo de patrullaje
    m_Metadata:
      m_Items: []
  - m_Id: 2742018939
    m_Localized: Objeto asegurado
    m_Metadata:
      m_Items: []
  - m_Id: 2742018940
    m_Localized: "Autorizaci\xF3n para el uso de la fuerza militar."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018941
    m_Localized: "Las acciones ilegales ser\xE1n castigadas"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018942
    m_Localized: El comportamiento antisocial es inaceptable.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018943
    m_Localized: Asunto militar, no interfieras
    m_Metadata:
      m_Items: []
  - m_Id: 2742018944
    m_Localized: Conforme a la ley
    m_Metadata:
      m_Items: []
  - m_Id: 2742018945
    m_Localized: El robo es un delito grave.
    m_Metadata:
      m_Items: []
  - m_Id: 2742018946
    m_Localized: "La situaci\xF3n est\xE1 bajo control."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018947
    m_Localized: No hay acciones ilegales registradas
    m_Metadata:
      m_Items: []
  - m_Id: 2742018948
    m_Localized: Unidad de seguridad de informes
    m_Metadata:
      m_Items: []
  - m_Id: 2742018949
    m_Localized: "Per\xEDmetro de patrullaje, todo despejado"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018950
    m_Localized: Al servicio de la ley
    m_Metadata:
      m_Items: []
  - m_Id: 2742018951
    m_Localized: Todo silencioso
    m_Metadata:
      m_Items: []
  - m_Id: 2742018952
    m_Localized: Bajo el derecho de la guerra
    m_Metadata:
      m_Items: []
