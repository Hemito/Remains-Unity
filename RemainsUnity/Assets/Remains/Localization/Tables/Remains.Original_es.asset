      m_Items: []
  - m_Id: 2729436087
    m_Localized: "Protecci\xF3n contra la magia negra."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436088
    m_Localized: "Protecci\xF3n de gases t\xF3xicos"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436089
    m_Localized: "Veneno resistencia al da\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436090
    m_Localized: "Suprime el da\xF1o a la salud causado por el veneno en su cuerpo"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436091
    m_Localized: "Resistencia a la radiaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436092
    m_Localized: Resistencia al sangrado
    m_Metadata:
      m_Items: []
  - m_Id: 2729436093
    m_Localized: "Suprime la p\xE9rdida de sangre causada por heridas abiertas."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436094
    m_Localized: "Reputaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436095
    m_Localized: "La reputaci\xF3n depende de la cantidad de misiones secundarias
      que completes. Completar misiones simples da un punto de reputaci\xF3n, las
      m\xE1s importantes, dif\xEDciles y peligrosas dan m\xE1s"
    m_Metadata:
