      m_Items: []
  - m_Id: 2742018680
    m_Localized: Patrullando, otra vez...
    m_Metadata:
      m_Items: []
  - m_Id: 2742018681
    m_Localized: "Deber\xEDa engrasar mi armadura"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018682
    m_Localized: "Me pregunto qu\xE9 tan pronto recibir\xE9 una promoci\xF3n.?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018683
    m_Localized: "La tecnolog\xEDa es el futuro."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018684
    m_Localized: Nuestro camino es justo
    m_Metadata:
      m_Items: []
  - m_Id: 2742018685
    m_Localized: "B\xE1rbaros tontos!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018686
    m_Localized: "\xBFCu\xE1nto tiempo se supone que debemos estar atrapados aqu\xED??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018687
    m_Localized: Cualquier pedido nuevo?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018688
    m_Localized: Es mejor cambiar las pilas
