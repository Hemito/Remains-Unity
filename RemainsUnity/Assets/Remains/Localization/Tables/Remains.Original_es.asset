  - m_Id: 2742018873
    m_Localized: Por favor, retrocede
    m_Metadata:
      m_Items: []
  - m_Id: 2742018874
    m_Localized: "Buen clima, \xBFno?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018875
    m_Localized: Nada personal
    m_Metadata:
      m_Items: []
  - m_Id: 2742018876
    m_Localized: Estoy programado para exterminarte
    m_Metadata:
      m_Items: []
  - m_Id: 2742018877
    m_Localized: "Por favor, baja tu arma y r\xEDndete"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018878
    m_Localized: Lo siento!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018879
    m_Localized: Lo siento, me veo obligado a abrir fuego
    m_Metadata:
      m_Items: []
  - m_Id: 2742018880
    m_Localized: Esto es triste
    m_Metadata:
      m_Items: []
  - m_Id: 2742018881
    m_Localized: "Por favor, qu\xE9date quieto y d\xE9jame eliminarte"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018882
    m_Localized: Lo siento, me veo obligado a eliminarte
    m_Metadata:
      m_Items: []
  - m_Id: 2742018883
    m_Localized: "R\xEDndete y queda eliminado"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018884
    m_Localized: Estoy autorizado a usar la fuerza
    m_Metadata:
      m_Items: []
  - m_Id: 2742018885
    m_Localized: "Mant\xE9n la calma, te cuidar\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018886
    m_Localized: Me temo que tienes que ser eliminado
    m_Metadata:
      m_Items: []
  - m_Id: 2742018887
    m_Localized: Mis instrucciones requieren que abra fuego
    m_Metadata:
      m_Items: []
  - m_Id: 2742018888
    m_Localized: Por favor no huyas!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018889
    m_Localized: Tampoco me gusta
    m_Metadata:
      m_Items: []
  - m_Id: 2742018890
    m_Localized: "Qu\xE9 es?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018891
