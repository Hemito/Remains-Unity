      m_Items: []
  - m_Id: 2742018905
    m_Localized: No te escondas de la seguridad
    m_Metadata:
      m_Items: []
  - m_Id: 2742018906
    m_Localized: Gracias. Vuelve pronto
    m_Metadata:
      m_Items: []
  - m_Id: 2742018907
    m_Localized: "\xBFPor qu\xE9 tuviste que correr?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018908
    m_Localized: "Procedimiento de b\xFAsqueda cancelado"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018909
    m_Localized: "Te eliminar\xE9 en otro momento"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018910
    m_Localized: "\xA1Por favor regrese! El procedimiento no est\xE1 completo."
    m_Metadata:
      m_Items: []
