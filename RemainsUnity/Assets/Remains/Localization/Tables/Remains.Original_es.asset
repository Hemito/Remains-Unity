      m_Items: []
  - m_Id: 2742019199
    m_Localized: "\xA1Tratamos enfermedades, heridas!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019200
    m_Localized: "\xA1Procedimientos absolutamente indoloros!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019201
    m_Localized: "Si muere, \xA1le devolveremos su dinero!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019202
    m_Localized: "\xA1La mejor atenci\xF3n m\xE9dica en Wasteland!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019203
    m_Localized: "\xBFD\xF3nde dej\xE9 mi bistur\xED?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019204
    m_Localized: "\xA1Disparos de rabia gratis!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019205
    m_Localized: "Una manzana al d\xEDa... ser\xEDa genial * suspiro *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019206
    m_Localized: "\xA1Obtenga un descuento en la transfusi\xF3n de sangre!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019207
    m_Localized: "Tratamiento de enfermedades ven\xE9reas a mitad de precio"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019208
    m_Localized: "\xBFTe sientes mejor?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019209
    m_Localized: "\xA1Todo listo! \xA1el siguienteeeee!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019210
    m_Localized: "Ten cuidado la pr\xF3xima vez, OK?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019211
    m_Localized: "\xA1Mantengase sano!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019212
    m_Localized: "Ah\xED, vas a estar bien"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019213
    m_Localized: "No te preocupes, \xA1volver\xE1 a crecer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019214
    m_Localized: "\xA1No olvides tomar tu medicamento!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019215
    m_Localized: Ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019216
    m_Localized: "\xA1Ay\xFAdame!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019217
    m_Localized: "\xA1D\xE9jame salir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019218
    m_Localized: Por favor ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019219
    m_Localized: Cualquier poni ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019220
    m_Localized: Por favor, agua ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019221
    m_Localized: "\xBFque me va a pasar?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019222
    m_Localized: Agua......
    m_Metadata:
      m_Items: []
  - m_Id: 2742019223
    m_Localized: Necesito ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019224
    m_Localized: "\xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019225
    m_Localized: "\xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019226
    m_Localized: "\xA1Me salvaste!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019227
    m_Localized: Dios te bendiga!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019228
    m_Localized: Estoy fuera!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019229
    m_Localized: Estoy libre!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019230
    m_Localized: "\xA1Salgamos de aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019231
    m_Localized: Hola!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019232
    m_Localized: "\xBFC\xF3mo est\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019233
    m_Localized: Huh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019234
    m_Localized: "S\xED, tenemos un problema ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019235
    m_Localized: "Los ponis siempre est\xE1n hablando"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019236
    m_Localized: "\xBFQu\xE9 hay de nuevo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019237
    m_Localized: "\xBFNo eres de por aqu\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019238
    m_Localized: "\xBFQu\xE9 estas diciendo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019239
    m_Localized: Alguien siempre necesita ayuda
    m_Metadata:
      m_Items: []
  - m_Id: 2742019240
    m_Localized: "Eso no es asunto m\xEDo..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019241
    m_Localized: Nel no es mi problema
    m_Metadata:
      m_Items: []
  - m_Id: 2742019242
    m_Localized: "Aqu\xED vamos de nuevo..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019243
    m_Localized: Que pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019244
    m_Localized: "\xBFQu\xE9 vamos a hacer ahora?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019245
    m_Localized: Estoy tan harto!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019246
    m_Localized: Como siempre...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019247
    m_Localized: "S\xED claro..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019248
    m_Localized: "Ella podr\xEDa haberlo hecho ella misma"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019249
    m_Localized: "Lo est\xE1n haciendo de nuevo ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019250
    m_Localized: Eso definitivamente no es de su incumbencia
    m_Metadata:
      m_Items: []
  - m_Id: 2742019251
    m_Localized: "\xBFPor qu\xE9 yo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567827
    m_Localized: "\xBFQu\xE9 es este horrible olor?"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567828
    m_Localized: "Ah, eres t\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567829
    m_Localized: "\xA1Oh maldita sea!"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567830
    m_Localized: "\xA1No lo entender\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567831
    m_Localized: Tengo mucho que hacer!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567832
    m_Localized: necesito descansar
    m_Metadata:
      m_Items: []
  - m_Id: 2742019252
    m_Localized: Tiempo de trabajar
    m_Metadata:
      m_Items: []
  - m_Id: 2742019253
    m_Localized: Esta pared necesita un mural ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019254
    m_Localized: "\xBFD\xF3nde est\xE1 mi destornillador?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019255
    m_Localized: No lo creo ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019256
    m_Localized: Golly...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019257
    m_Localized: "\xBFOtra vez?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019258
    m_Localized: Cuando es tu turno?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019259
    m_Localized: El almuerzo es a tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019260
    m_Localized: Estoy harto de eso ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019261
    m_Localized: Este lugar es un agujero abandonado por los dioses ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019262
    m_Localized: El alambre es brillante ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019263
    m_Localized: "Otro d\xEDa de mierda ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019264
    m_Localized: Jodida vida ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019265
    m_Localized: Por el bien de Celestia ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019266
    m_Localized: "\xBFY ahora que?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019267
    m_Localized: Todo es tan aburrido ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019268
    m_Localized: Mismo viejo...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019269
    m_Localized: "Bueno s\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019270
    m_Localized: Y que esperabas?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019271
    m_Localized: "Lo est\xE1n haciendo de nuevo ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019272
    m_Localized: "\xA1Apesta!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019273
    m_Localized: "Por qu\xE9 yo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019274
    m_Localized: Algo esta goteando en mi cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 2742019275
    m_Localized: "Qu\xE9 bueno que est\xE1s aqu\xED y no afuera"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019276
    m_Localized: El experimento fue exitoso
    m_Metadata:
      m_Items: []
  - m_Id: 2742019277
    m_Localized: "Hay moho aqu\xED otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019278
    m_Localized: "S\xED, \xBFd\xF3nde rod\xF3 ese pedazo de basura?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019279
    m_Localized: Odio limpiar
    m_Metadata:
      m_Items: []
  - m_Id: 2742019280
    m_Localized: Mi pipbuck tiene lag
    m_Metadata:
      m_Items: []
  - m_Id: 2742019281
    m_Localized: Oh si!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019282
    m_Localized: No me siento tan bien
    m_Metadata:
      m_Items: []
  - m_Id: 2742019283
    m_Localized: "\xA1Oh, @lp, mucho tiempo sin verte!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019284
    m_Localized: Ha pasado mucho tiempo, @lp!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019285
    m_Localized: '@lp, No te he visto en mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019286
    m_Localized: "\xBFC\xF3mo est\xE1s, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019287
    m_Localized: "Hola @lp, \xBFhas vuelto?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019288
    m_Localized: Regresaste, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019289
    m_Localized: "\xBFC\xF3mo est\xE1 all\xE1 arriba?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019290
    m_Localized: "\xBFEs cierto que afuera solo hay monstruos y radiaci\xF3n?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019291
    m_Localized: "\xBFHas visto monstruos?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019292
    m_Localized: "Oh ... @lp apareci\xF3 de nuevo ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019293
    m_Localized: TACOOOS!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019294
    m_Localized: "\xA1Solo m\xEDrate!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019295
    m_Localized: "\xBFCu\xE1ndo fue la \xFAltima vez que te duchaste?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019296
    m_Localized: Hola!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019297
    m_Localized: Hola, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019298
    m_Localized: "C\xF3mo est\xE1s, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019299
    m_Localized: "\xBFCu\xE1ndo vas a devolver esa deuda?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019300
    m_Localized: "Mi PipBuck est\xE1 roto nuevamente, \xBFpuedes arreglarlo?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019301
    m_Localized: Oh-wey nooo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019302
    m_Localized: "\xBFTodos los ponis afuera caminan as\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019303
    m_Localized: "\xBFTodav\xEDa necesitas tus cosas?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019304
    m_Localized: "Pens\xE9 que nunca volver\xEDas"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019305
    m_Localized: "\xBFPor qu\xE9, si este no es el \"Elegido-25\" ella misma ...
      gran cosa ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019306
    m_Localized: "\xBFDescubriste algo sobre Velvet??"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019307
    m_Localized: Ya has vuelto?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019308
    m_Localized: Hagamos una fiesta?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019309
    m_Localized: "\xA1Ven, toma un poco de alcohol ilegal!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019310
    m_Localized: "\xA1Hey est\xE1 ocupado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019311
    m_Localized: "\xA1Hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019312
    m_Localized: Que pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019313
    m_Localized: "\xBFQuieres jugar?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019314
    m_Localized: Pew-pew
    m_Metadata:
      m_Items: []
  - m_Id: 2742019315
    m_Localized: "Morir\xE1s pronto ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019316
    m_Localized: "\xA1Oh, eso es genial!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019317
    m_Localized: "Incre\xEDble!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019318
    m_Localized: "\xA1Hola, eso es m\xEDo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019319
    m_Localized: "\xA1El m\xEDo es mejor!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019320
    m_Localized: Pew! Boom
    m_Metadata:
      m_Items: []
  - m_Id: 2742019321
    m_Localized: La-la-la
    m_Metadata:
      m_Items: []
  - m_Id: 2742019322
    m_Localized: "\xBFAl escondite?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019323
    m_Localized: "\xA1Qu\xE9 tonto!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019324
    m_Localized: Nuh-huh
    m_Metadata:
      m_Items: []
  - m_Id: 2742019325
    m_Localized: "Quedarse atr\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019326
    m_Localized: Na-na-na
    m_Metadata:
      m_Items: []
  - m_Id: 2742019327
    m_Localized: "\xBFPuedo tener algunas tapas?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019328
    m_Localized: Golly!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019329
    m_Localized: "Oye, mira aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019330
    m_Localized: "\xA1No estoy haciendo nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019331
    m_Localized: "\xA1Estaba roto cuando lo encontr\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019332
    m_Localized: Hola, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019333
    m_Localized: Yay!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019334
    m_Localized: Estoy tan aburrido ...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019335
    m_Localized: "\xA1Es todo culpa suya!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019336
    m_Localized: Solo estoy parado aqui
    m_Metadata:
      m_Items: []
  references:
