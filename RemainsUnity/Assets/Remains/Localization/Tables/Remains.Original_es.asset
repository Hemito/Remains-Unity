    m_Localized: "\xBFNecesitas un parche?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019193
    m_Localized: Pociones curativas...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019194
    m_Localized: "\xA1Te volver\xE9 a poner de pie!"
    m_Metadata:
      m_Items: []
