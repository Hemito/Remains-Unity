  - m_Id: 1501152927830
    m_Localized: "\u041B\u041A\u041C \u2014 \u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927831
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C
      \xB7 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043C\u0438\u0433\u0440\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927832
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043E \u0438\u043B\u0438
      \u0438\u043C\u0435\u0435\u0442 \u043D\u0435\u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u044B\u0439
      \u0444\u043E\u0440\u043C\u0430\u0442.\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
      \xAB\u041C\u0438\u0440\u044B \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F\xBB
      \u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u0443\u044E
      \u043A\u043E\u043F\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927833
    m_Localized: "\n\u0412 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435
      \u0435\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F;
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u2014 \u0432
      \u0441\u043F\u0438\u0441\u043A\u0435 \u043C\u0438\u0440\u043E\u0432 \u0438
      \u0436\u0443\u0440\u043D\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927834
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439
      \u043C\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927835
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0432 \u043D\u043E\u0432\u043E\u043C
      \u043C\u0438\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927836
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
      \u043C\u0438\u0440 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D.\n\xAB\u041C\u0438\u0440\u044B
      \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F\xBB: \u0432\u044B\u0431\u043E\u0440,
      \u0438\u043C\u044F \u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927837
    m_Localized: "\u0427\u0442\u0435\u043D\u0438\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u043C\u0438\u0440\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1501152927838
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
