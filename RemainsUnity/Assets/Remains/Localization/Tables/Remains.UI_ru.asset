    m_Metadata:
      m_Items: []
  - m_Id: 1501148733443
    m_Localized: "\u0428\u0430\u043D\u0441 \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F:
      {0:0.#}%\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1501148733444
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 1501148733445
    m_Localized: "DSP-\u0431\u0443\u0444\u0435\u0440: {0} \u0441\u044D\u043C\u043F\u043B\u043E\u0432
      \xB7 256 \u2014 \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430,
      1024 \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1501148733446
    m_Localized: "\u0413\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u0441\u043B\u044B\u0448\u043D\u0430
      \u0441\u0440\u0430\u0437\u0443. DSP-\u0431\u0443\u0444\u0435\u0440 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043F\u043E \xAB\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C\xBB
      \u0441 \u043A\u0440\u0430\u0442\u043A\u0438\u043C \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A\u043E\u043C
      \u0437\u0432\u0443\u043A\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430
      \u044D\u0442\u043E\u043C \u041F\u041A."
    m_Metadata:
      m_Items: []
  - m_Id: 1501148733447
    m_Localized: "\u041F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \xAB{0}\xBB: \u0432\u0435\u0440\u0441\u0438\u044F
