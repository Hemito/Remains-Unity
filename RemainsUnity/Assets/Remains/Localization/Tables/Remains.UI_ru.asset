    m_Metadata:
      m_Items: []
  - m_Id: 1501148733441
    m_Localized: "\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C {0:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 1501148733442
    m_Localized: "\u041F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
