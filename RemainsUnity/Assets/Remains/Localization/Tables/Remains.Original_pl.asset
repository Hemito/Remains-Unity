      m_Items: []
  - m_Id: 2742018361
    m_Localized: Aj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018362
    m_Localized: "A\u0142\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018363
    m_Localized: "A\u0142, to boli!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018364
    m_Localized: O rety, o rety!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018365
    m_Localized: "Oberwa\u0142am!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018366
    m_Localized: "Suka mnie trafi\u0142a!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018367
    m_Localized: "Suka mnie dorwa\u0142a!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018368
    m_Localized: "Och, pierdol si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018369
    m_Localized: Kurwaaa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018370
    m_Localized: Hah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018371
    m_Localized: "Prosz\u0119 bardzo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018372
    m_Localized: Zrobione!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018373
    m_Localized: "Wcale nie by\u0142o trudne"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018374
    m_Localized: "\u015Amizna-\u0142atwizna"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018375
    m_Localized: Tak!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018376
    m_Localized: "\u0141atwe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018377
    m_Localized: Sukces!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018378
    m_Localized: Dobra robota!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018379
    m_Localized: Cudnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018380
    m_Localized: "\u017Baden zamek mnie nie powstrzyma!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018381
    m_Localized: "A masz, g\u0142upi zamku!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018382
    m_Localized: "Takie zamki s\u0105 dobre jedynie dla toalet"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018383
    m_Localized: "\u017Baden jebany zamek mi si\u0119 nie przeciwstawi"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018384
    m_Localized: "Has\u0142o to znowu \u201E123\u201D? Dajcie spok\xF3j!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018385
    m_Localized: Nooby!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018386
    m_Localized: "Co za nieodpowiednie has\u0142o\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018387
    m_Localized: "Has\u0142o \u201Echuj123\u201D? Mog\u0142am si\u0119 domy\u015Bli\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018388
    m_Localized: Kurde!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018389
    m_Localized: Co do!..
    m_Metadata:
      m_Items: []
  - m_Id: 2742018390
    m_Localized: Tylko nie to!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018391
    m_Localized: Do dupy!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018392
    m_Localized: "To trudniejsze ni\u017C si\u0119 zdaje"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018393
    m_Localized: Pech!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018394
    m_Localized: "\u017Baden problem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018395
    m_Localized: "Spr\xF3buj\u0119 jeszcze raz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018396
    m_Localized: "O nie, nie poddam si\u0119 tak \u0142atwo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018397
    m_Localized: "Dam rad\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018398
    m_Localized: Arrrgh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018399
    m_Localized: "No\u017C do jasnej kurwy, znowu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018400
    m_Localized: "Och, Luno umie\u015B\u0107 mnie na swoim rogu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018401
    m_Localized: "Och, dlaczego \u017Cycie jest takie niesprawiedliwe?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018402
    m_Localized: "Dlaczego wszystko musi by\u0107 takie trudne?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018403
    m_Localized: "R\xF3g Celestii mi w ucho!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018404
    m_Localized: "Och, id\u017A do Discorda!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018405
    m_Localized: "Dzisiaj nie jest m\xF3j dzie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018406
    m_Localized: "Dlaczego nie mog\u0119 tego zrobi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018407
    m_Localized: "Och, zje\u017Cd\u017Caj, kurcz\u0119bele!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018408
    m_Localized: "Och ty ma\u0142y\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018409
    m_Localized: Co do kurwy!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018410
    m_Localized: "Usi\u0105d\u017A na moim rogu i si\u0119 kr\u0119\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018411
    m_Localized: No i co, kurwa, teraz!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018412
    m_Localized: "C\xF3\u017C, to jest pokurwione!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018413
    m_Localized: "Celestio zgwa\u0142\u0107 mnie swoim rogiem!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018414
    m_Localized: Jackpot!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018415
    m_Localized: No, witajcie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018416
    m_Localized: Tak!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018417
    m_Localized: "O \u0142a\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018418
    m_Localized: Czad!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018419
    m_Localized: "Warto by\u0142o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018420
    m_Localized: "Err\u2026 i?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018421
    m_Localized: To tyle?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018422
    m_Localized: "\u017Bartujecie sobie ze mnie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018423
    m_Localized: "Kurde! Same \u015Bmieci"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018424
    m_Localized: Dlaczego jest tu pusto?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018425
    m_Localized: "Mam przeczucie, \u017Ce jaki\u015B kucyk robi mnie w chuja!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018426
    m_Localized: "Zabi\u0142oby si\u0119 za jakie\u015B palenie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018427
    m_Localized: "Zawszony b\xF3l g\u0142owy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018428
    m_Localized: To zawszone miejsce ma jakiekolwiek jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018429
    m_Localized: "Hej wy, \u0107woki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018430
    m_Localized: "Musz\u0119 siku"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018431
    m_Localized: "Jakie\u015B piwo uczyni\u0142oby m\xF3j dzie\u0144 lepszym\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018432
    m_Localized: "Chcesz jakie\u015B lanie i zabawianie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018433
    m_Localized: "Kto chce w pizd\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018434
    m_Localized: Co za dupek!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018435
    m_Localized: "Buhuu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018436
    m_Localized: Cholera, jestem na haju!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018437
    m_Localized: "Pierdol si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018438
    m_Localized: Kurestwo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018439
    m_Localized: "Na co si\u0119 lampisz, dupku?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018440
    m_Localized: "Peda\u0142y!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018441
    m_Localized: "Odpieprz si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018442
    m_Localized: "Mam do\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018443
    m_Localized: Mam przejebane
    m_Metadata:
      m_Items: []
  - m_Id: 2742018444
    m_Localized: Co za szajs!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018445
    m_Localized: "* gwi\u017Cd\u017Ce *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018446
    m_Localized: '* pluje *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018447
    m_Localized: '* klnie *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018448
    m_Localized: '* ziewa *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018449
    m_Localized: "* ob\u0142\u0105ka\u0144czy \u015Bmiech *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018450
    m_Localized: '* puste spojrzenie *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018451
    m_Localized: "Przygotuj si\u0119 na \u015Bmier\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018452
    m_Localized: "Giiii\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018453
    m_Localized: "Szaar\u017Ca!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018454
    m_Localized: "Ju\u017C po tobie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018455
    m_Localized: "Dorw\u0119 ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018456
    m_Localized: "Zabawa zosta\u0142a podwojona!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018457
    m_Localized: Zabawa! Zabawa! Zabawa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018458
    m_Localized: "Zmia\u017Cd\u017C\u0119 ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018459
    m_Localized: "Rozwal\u0119 ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018460
    m_Localized: "Czas na gwa\u0142t!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018461
    m_Localized: "O\u015Bla dupa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018462
    m_Localized: "Zajeba\u0107 ich wszystkich!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018463
    m_Localized: Nie uciekniesz!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018464
    m_Localized: Mu-ha-ha-ha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018465
    m_Localized: Aha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018466
    m_Localized: Bu-ha-ha-ha!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018467
    m_Localized: Krew!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018468
    m_Localized: "Mi\u0119so!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018469
    m_Localized: "Ju\u017C, kurwa, nie \u017Cyjesz!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018470
    m_Localized: "Chod\u017A tu, mi\u0119so!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018471
    m_Localized: "Widz\u0119 ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018472
    m_Localized: Tam jest!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018473
    m_Localized: "Wszystkie kucyki, t\u0119dy!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018474
    m_Localized: "Zaaabi\u0107!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018475
    m_Localized: "Gi\u0144, suko!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018476
    m_Localized: "Zabi\u0107, zabi\u0107, zaaabii\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018477
    m_Localized: "P\u0142o\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018478
    m_Localized: Odpalaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018479
    m_Localized: "Ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018480
    m_Localized: "Usma\u017C\u0119 j\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018481
    m_Localized: "Szasz\u0142yki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018482
    m_Localized: "Robi si\u0119 tu gor\u0105co!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018483
    m_Localized: "Lubi\u0119 zapach napalmu o poranku!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018484
    m_Localized: Ognia!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018485
    m_Localized: "\u0141ap granat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018486
    m_Localized: Ihaa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018487
    m_Localized: Odpalam lont!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018488
    m_Localized: "Rozsyp si\u0119 w py\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018489
    m_Localized: Fajerwerki!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018490
    m_Localized: Detonuj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018491
    m_Localized: "Ca\u0142y \u015Bwiat w gruzach!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018492
    m_Localized: Bomba!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018493
    m_Localized: "Co to by\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018494
    m_Localized: Kto tu jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018495
    m_Localized: "Czy jest tam jaki\u015B kucyk?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018496
    m_Localized: "H\u0119? Co?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018497
    m_Localized: Mmm?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018498
    m_Localized: Co do kurwy?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018499
    m_Localized: "S\u0142yszeli\u015Bcie to?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018500
    m_Localized: Gdzie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018501
    m_Localized: "Co si\u0119, kurwa, dzieje?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018502
    m_Localized: "Strzelaj\u0105 gdzie\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018503
    m_Localized: "Czy co\u015B spad\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018504
    m_Localized: "S\u0142ysz\u0119 co\u015B"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018505
    m_Localized: "Znowu si\u0119 zaczyna!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018506
    m_Localized: Gdzie ona jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018507
    m_Localized: "Znale\u017A\u0107 j\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018508
    m_Localized: "Znajd\u0119 ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018509
    m_Localized: "Nie ukryjesz si\u0119 przede mn\u0105, pizdeczko!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018510
    m_Localized: "Gdzie jeste\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018511
    m_Localized: "Nie widz\u0119 jej"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018512
    m_Localized: "Ona gdzie\u015B tam jest"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018513
    m_Localized: "Znajd\u017Acie j\u0105, kuce!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018514
    m_Localized: "Gdzie ona si\u0119 podzia\u0142a?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018515
    m_Localized: Kurwa, gdzie ona jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018516
    m_Localized: "Gdzie si\u0119 ukrywasz?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018517
    m_Localized: "Przede mn\u0105 si\u0119 nie ukryjesz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018518
    m_Localized: "To sprawia, \u017Ce robi si\u0119 ciekawiej!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018519
    m_Localized: "Wyjd\u017A, a zrobi\u0119 to bezbole\u015Bnie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018520
    m_Localized: "Wy\u0142a\u017A, ty podst\u0119pny tch\xF3rzu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018521
    m_Localized: "Och, dobra\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018522
    m_Localized: "Jeba\u0107 j\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018523
    m_Localized: Ta, uciekaj, suko!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018524
    m_Localized: "Ko\u0144skie \u0142ajno!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018525
    m_Localized: "P\xF3\u017Aniej si\u0119 j\u0105 dorwie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018526
    m_Localized: Daleko nie ucieknie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018527
    m_Localized: "Nigdzie si\u0119 nie wybierasz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018528
    m_Localized: "Mam powy\u017Cej uszu szukania jej"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018529
    m_Localized: "Musia\u0142o mi si\u0119 wydawa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018530
    m_Localized: To tylko wiatr
    m_Metadata:
      m_Items: []
  - m_Id: 2742018531
    m_Localized: "Czysto\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018532
    m_Localized: "Na pewno nie zdawa\u0142o mi si\u0119, \u017Ce co\u015B s\u0142ysz\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018533
    m_Localized: Nie, to nic
    m_Metadata:
      m_Items: []
  - m_Id: 2742018534
    m_Localized: "Prawdopodobnie tylko szczury\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018535
    m_Localized: "Nie, pierniczy\u0107 to"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018536
    m_Localized: "A kto to by\u0142?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018537
    m_Localized: "Kurwa! Tam zdecydowanie by\u0142 jaki\u015B kucyk"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018538
    m_Localized: "Jeszcze zobaczymy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018539
    m_Localized: "Zabij\u0119 ci\u0119 powoli!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018540
    m_Localized: O KURWA!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018541
    m_Localized: "Au\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018542
    m_Localized: Aj-aj-aj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018543
    m_Localized: Zraniono mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018544
    m_Localized: Dorwali mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018545
    m_Localized: "Zabijaj\u0105 mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018546
    m_Localized: AAAAAA!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018547
    m_Localized: "Pom\u015Bcijcie mnie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018548
    m_Localized: Zajebali mnie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018549
    m_Localized: "Ju\u017C po mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018550
    m_Localized: "* agonalne rz\u0119\u017Cenie *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018551
    m_Localized: '* trup *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018552
    m_Localized: Co to kurwa jest???
    m_Metadata:
      m_Items: []
  - m_Id: 2742018553
    m_Localized: "Co si\u0119 dzieje???"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018554
    m_Localized: "Pu\u015B\u0107 mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018555
    m_Localized: Zakichana magia!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018556
    m_Localized: Granat!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018557
    m_Localized: Padnij!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018558
    m_Localized: Uwaga!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018559
    m_Localized: Spierdalaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018560
    m_Localized: Patrzcie tam!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018561
    m_Localized: "Uwa\u017Cajcie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018562
    m_Localized: "Co to do diab\u0142a jest?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018563
    m_Localized: No bez jaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018564
    m_Localized: Do kurewskiej kurwy!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018565
    m_Localized: Jebana moc!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018566
    m_Localized: "Ile zap\u0142ac\u0105?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018567
    m_Localized: "Ile mo\u017Cna tu siedzie\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018568
    m_Localized: "Je\u015B\u0107 mi si\u0119 chce!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018569
    m_Localized: "Tia, ona si\u0119 nie zjawi!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018570
    m_Localized: "Powinni\u015Bmy poszuka\u0107 gdzie\u015B indziej"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018571
    m_Localized: "Nie ma tam \u017Cadnego kucyka!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018572
    m_Localized: "I m\xF3wi\u0119 wam, ostatni raz cel widziano tam!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018573
    m_Localized: "Jak d\u0142ugo jeszcze?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018574
    m_Localized: "Masz fajk\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018575
    m_Localized: "Sprawd\u017Acie swoje bronie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018576
    m_Localized: "Przygotujcie si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018577
    m_Localized: Tu jest niebezpiecznie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018578
    m_Localized: "Czy w og\xF3le warto?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018579
    m_Localized: "Nie podoba mi si\u0119 tutaj"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018580
    m_Localized: "Do\u015B\u0107 tego!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018581
    m_Localized: "Kto\u015B mo\u017Ce chce zagra\u0107 w karty?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018582
    m_Localized: "Mam tego tak bardzo do\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018583
    m_Localized: "Jeba\u0107 to \u017Cycie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018584
    m_Localized: "Dajcie spok\xF3j!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018585
    m_Localized: "* gwi\u017Cd\u017Ce *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018586
    m_Localized: '* pluje *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018587
    m_Localized: '* przeklina *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018588
    m_Localized: '* ziewa *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018589
    m_Localized: "* \u015Bwiergocze *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018590
    m_Localized: "* drapie si\u0119 *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018591
    m_Localized: "Baczno\u015B\u0107! Zauwa\u017Cono cel"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018592
    m_Localized: "Otworzy\u0107 ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018593
    m_Localized: Cel na 12
    m_Metadata:
      m_Items: []
  - m_Id: 2742018594
    m_Localized: "Zlikwidowa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018595
    m_Localized: "D\u0142ugo na ciebie czekali\u015Bmy!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018596
    m_Localized: "I oto jeste\u015B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018597
    m_Localized: "Unicestwi\u0107 cel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018598
    m_Localized: "Strzela\u0107, by zabi\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018599
    m_Localized: "Pozb\u0105d\u017Amy si\u0119 jej!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018600
    m_Localized: Nic osobistego!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018601
    m_Localized: To tylko interesy
    m_Metadata:
      m_Items: []
  - m_Id: 2742018602
    m_Localized: "Potrzebuj\u0119 jedynie twojej g\u0142owy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018603
    m_Localized: Lepiej nie stawiaj oporu!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018604
    m_Localized: "St\xF3j nieruchomo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018605
    m_Localized: "Nie uciekaj, albo b\u0119dzie bardziej bola\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018606
    m_Localized: Dobra, wszyscy razem!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018607
    m_Localized: "Kulk\u0119 mi\u0119dzy oczy!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018608
    m_Localized: "Ja tylko wykonuj\u0119 zlecenie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018609
    m_Localized: To moja robota
    m_Metadata:
      m_Items: []
  - m_Id: 2742018610
    m_Localized: "Nie\u017Ale zap\u0142ac\u0105 za twoj\u0105 g\u0142ow\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018611
    m_Localized: "Co to by\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018612
    m_Localized: Kto tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018613
    m_Localized: "Jest tam jaki\u015B kucyk?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018614
    m_Localized: "H\u0119? Co?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018615
    m_Localized: "Podejrzany ha\u0142as!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018616
    m_Localized: "Hej! Sprawdzi\u0107, co tam jest"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018617
    m_Localized: "S\u0142yszeli\u015Bcie to?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018618
    m_Localized: Gdzie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018619
    m_Localized: "Strzelaj\u0105 gdzie\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018620
    m_Localized: "Co\u015B spad\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018621
    m_Localized: "S\u0142ysz\u0119 co\u015B"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018622
    m_Localized: Znowu to samo!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018623
    m_Localized: "Gdzie ona podzia\u0142a?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018624
    m_Localized: "Znale\u017A\u0107 j\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018625
    m_Localized: "Znajd\u0119 ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018626
    m_Localized: "Nie ma sensu si\u0119 ukrywa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018627
    m_Localized: Gdzie ona jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018628
    m_Localized: "Nie widz\u0119 jej"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018629
    m_Localized: "Ona gdzie\u015B tam jest"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018630
    m_Localized: "Cel znikn\u0105\u0142 mi z oczu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018631
    m_Localized: "Gdzie si\u0119 ukrywasz?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018632
    m_Localized: "Szuka\u0107 z powietrza"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018633
    m_Localized: "I tak ci\u0119 znajd\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018634
    m_Localized: "Przeczesa\u0107 teren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018635
    m_Localized: "Nie mog\u0119 jej znale\u017A\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018636
    m_Localized: "Zaprzestaj\u0119 poszukiwa\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018637
    m_Localized: "Rozdzielimy si\u0119 i znajdziemy j\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018638
    m_Localized: "O o\u0142, nasze kapsle da\u0142y nog\u0119\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018639
    m_Localized: "P\xF3\u017Aniej j\u0105 znajdziemy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018640
    m_Localized: Daleko nie ucieknie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018641
    m_Localized: "Nigdzie si\u0119 nie wybierasz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018642
    m_Localized: "Bez znaczenia, zabijemy jakiego\u015B innego kucyka"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018643
    m_Localized: "Zdawa\u0142o mi si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018644
    m_Localized: To tylko wiatr
    m_Metadata:
      m_Items: []
  - m_Id: 2742018645
    m_Localized: "Nic\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018646
    m_Localized: "Niemo\u017Cliwe, \u017Ce mi si\u0119 zdawa\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018647
    m_Localized: "Nie, fa\u0142szywy alarm"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018648
    m_Localized: "Pewnie szczury\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018649
    m_Localized: "A do diab\u0142a z tym"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018650
    m_Localized: "Ale jaki\u015B kucyk strzela\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018651
    m_Localized: "Nie mo\u017Ce by\u0107, na pewno jest tam jaki\u015B kucyk"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018652
    m_Localized: "Powinni\u015Bmy p\xF3\u017Aniej wys\u0142a\u0107 patrole"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018653
    m_Localized: "Strzelanie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018654
    m_Localized: Trafiono mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018655
    m_Localized: "Dra\u015Bni\u0119to mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018656
    m_Localized: "Au\u0107! To nic!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018657
    m_Localized: Zraniono mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018658
    m_Localized: Dorwali mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018659
    m_Localized: "Strzelaj\u0105 do mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018660
    m_Localized: AAAAA!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018661
    m_Localized: Nic mi nie jest!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018662
    m_Localized: "Pom\u015Bcijcie mnie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018663
    m_Localized: "Przepraszam za wszystko\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018664
    m_Localized: "Ciemnieje mi w oczach\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018665
    m_Localized: "Mam z\u0142y dzie\u0144\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018666
    m_Localized: "Nie uda\u0142o mi si\u0119\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018667
    m_Localized: "Wci\u0105\u017C mog\u0119 wal\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018668
    m_Localized: "* agonalne rz\u0119\u017Cenie *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018669
    m_Localized: '* umiera *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018670
    m_Localized: Granat!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018671
    m_Localized: Padnij!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018672
    m_Localized: "Uwa\u017Cajcie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018673
    m_Localized: To granat!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018674
    m_Localized: Patrzcie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018675
    m_Localized: "Ostro\u017Cnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018676
    m_Localized: Co to znowu jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018677
    m_Localized: "Co za \u0142ajno!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018678
    m_Localized: "Niebezpiecze\u0144stwo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018679
    m_Localized: Zastrzelcie to!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018680
    m_Localized: "Patrolowanie, znowu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018681
    m_Localized: "Musz\u0119 naoliwi\u0107 pancerz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018682
    m_Localized: "Ciekawe, czy wkr\xF3tce dostan\u0119 awans?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018683
    m_Localized: "Technika jest przysz\u0142o\u015Bci\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018684
    m_Localized: "Nasza \u015Bcie\u017Cka jest prawd\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018685
    m_Localized: "G\u0142upie dzikusy!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018686
    m_Localized: "Ile mo\u017Cna tu siedzie\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018687
    m_Localized: "Jakie\u015B nowe rozkazy?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018688
    m_Localized: "Baterie wymagaj\u0105 wymiany"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018689
    m_Localized: "Sprawd\u017Acie swoje bronie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018690
    m_Localized: "B\u0105d\u017Acie gotowi"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018691
    m_Localized: "Jeste\u015Bmy najlepsi!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018692
    m_Localized: "Wskrzeszmy Equestri\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018693
    m_Localized: "Racje \u017Cywno\u015Bciowe znowu zosta\u0142y zmniejszone\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018694
    m_Localized: "S\u0142u\u017Cba nie dru\u017Cba"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018695
    m_Localized: Kiedy opuszczamy to miejsce?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018696
    m_Localized: "Mam do\u015B\u0107 czekania!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018697
    m_Localized: "A niech tylko spr\xF3buj\u0105 zaatakowa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018698
    m_Localized: "I tak ka\u017Cdego dnia\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018699
    m_Localized: "Porom-pom-pom-pom\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018700
    m_Localized: "Co m\xF3wi\u0105 prze\u0142o\u017Ceni?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018701
    m_Localized: "\u017Badnej dyscypliny\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018702
    m_Localized: "Przyda\u0142oby si\u0119 wymieni\u0107 filtry\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018703
    m_Localized: "Technologia jest lepsza ni\u017C magia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018704
    m_Localized: "Zauwa\u017Cono intruza"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018705
    m_Localized: "Otworzy\u0107 ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018706
    m_Localized: "Dzikusy atakuj\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018707
    m_Localized: "Wyeliminowa\u0107 cel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018708
    m_Localized: "Strzela\u0107, by zabi\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018709
    m_Localized: "Rozkazano strzela\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018710
    m_Localized: "Otwieram ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018711
    m_Localized: "Naje\u017Ad\u017Acy!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018712
    m_Localized: "Oczy\u015Bci\u0107 teren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018713
    m_Localized: Rozkaz numer 47
    m_Metadata:
      m_Items: []
  - m_Id: 2742018714
    m_Localized: "Wykonuj\u0119 polecenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018715
    m_Localized: "Przygotowa\u0107 wyrzutnie rakiet"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018716
    m_Localized: "Nie rozpoczyna\u0107 negocjacji"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018717
    m_Localized: Aktywowano tryb bojowy
    m_Metadata:
      m_Items: []
  - m_Id: 2742018718
    m_Localized: Ognia!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018719
    m_Localized: "S\u0142ysz\u0119 obcy d\u017Awi\u0119k"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018720
    m_Localized: "Wr\xF3g w pobli\u017Cu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018721
    m_Localized: "Baczno\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018722
    m_Localized: Szyk bitewny
    m_Metadata:
      m_Items: []
  - m_Id: 2742018723
    m_Localized: "Bronie w gotowo\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018724
    m_Localized: Przeprowadzam rekonesans
    m_Metadata:
      m_Items: []
  - m_Id: 2742018725
    m_Localized: "Przygotowa\u0107 si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018726
    m_Localized: Uwaga!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018727
    m_Localized: "Nie jeste\u015Bmy tu sami"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018728
    m_Localized: "Czy co\u015B spad\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018729
    m_Localized: "Sta\u0107! Kto idzie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018730
    m_Localized: "Szuka\u0107 celu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018731
    m_Localized: "Odszuka\u0107 i zniszczy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018732
    m_Localized: Zgubiono cel
    m_Metadata:
      m_Items: []
  - m_Id: 2742018733
    m_Localized: "Wr\xF3g poza zasi\u0119giem wzroku"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018734
    m_Localized: "Przeczesa\u0107 obszar!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018735
    m_Localized: "Zaprzesta\u0107 poszukiwa\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018736
    m_Localized: "Alarm odwo\u0142any"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018737
    m_Localized: "Miejcie si\u0119 na baczno\u015Bci!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018738
    m_Localized: "Wr\xF3g si\u0119 wycofa\u0142"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018739
    m_Localized: Bez rezultatu
    m_Metadata:
      m_Items: []
  - m_Id: 2742018740
    m_Localized: "Ju\u017C jest bezpiecznie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018741
    m_Localized: "Wr\xF3ci\u0107 od zaraz do zada\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018742
    m_Localized: "Cisza i spok\xF3j"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018743
    m_Localized: Nikogo na radarze
    m_Metadata:
      m_Items: []
  - m_Id: 2742018744
    m_Localized: "\u017Badnych zagro\u017Ce\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018745
    m_Localized: Nic nadzwyczajnego
    m_Metadata:
      m_Items: []
  - m_Id: 2742018746
    m_Localized: "Zwi\u0119kszy\u0107 czujno\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018747
    m_Localized: "Nieprzyjaciel jest gdzie\u015B w pobli\u017Cu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018748
    m_Localized: "B\u0105d\u017Acie czujne, kucyki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018749
    m_Localized: "Pilnujcie swoich bok\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018750
    m_Localized: "Musi gdzie\u015B tu by\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018751
    m_Localized: Pancerz uszkodzony
    m_Metadata:
      m_Items: []
  - m_Id: 2742018752
    m_Localized: "Mog\u0119 kontynuowa\u0107 walk\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018753
    m_Localized: "Moje urazy s\u0105 drobne"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018754
    m_Localized: "Obra\u017Cenia w dopuszczalnych granicach"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018755
    m_Localized: "Jestem pod ostrza\u0142em!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018756
    m_Localized: Trafiono mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018757
    m_Localized: Stan stabilny
    m_Metadata:
      m_Items: []
  - m_Id: 2742018758
    m_Localized: Nic mi nie jest!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018759
    m_Localized: "To ju\u017C koniec\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018760
    m_Localized: "Naprawd\u0119 w taki spos\xF3b?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018761
    m_Localized: "Pochowajcie mnie z godno\u015Bci\u0105\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018762
    m_Localized: "Nie! Nie dzisiaj\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018763
    m_Localized: "Nie uda\u0142o mi si\u0119 wykona\u0107 moich rozkaz\xF3w\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018764
    m_Localized: "Wszyscy si\u0119 na mnie zawiedli\u015Bcie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018765
    m_Localized: "Argh!\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018766
    m_Localized: '* umiera *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018767
    m_Localized: "Niech \u017Cyje Enklawa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018768
    m_Localized: "Pegazy s\u0105 ras\u0105 wy\u017Csz\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018769
    m_Localized: "Dostaniemy wkr\xF3tce przepustki?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018770
    m_Localized: "Prawda i pot\u0119ga s\u0105 z nami"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018771
    m_Localized: "Powierzchnia to niez\u0142a dziura"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018772
    m_Localized: "Tu na dole jest tylko brud i dziko\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018773
    m_Localized: "No ile mo\u017Cna?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018774
    m_Localized: "Jakie s\u0105 rozkazy?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018775
    m_Localized: Pancerz potrzebuje kalibracji
    m_Metadata:
      m_Items: []
  - m_Id: 2742018776
    m_Localized: "Sprawd\u017Acie swoje bronie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018777
    m_Localized: "B\u0105d\u017Acie gotowi"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018778
    m_Localized: Startujcie bezpiecznie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018779
    m_Localized: "Nie mog\u0119 si\u0119 doczeka\u0107, a\u017C wr\xF3c\u0119 do
      domu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018780
    m_Localized: "Bardzo pragn\u0119 si\u0119 st\u0105d wydosta\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018781
    m_Localized: "Przysz\u0142o\u015B\u0107 nale\u017Cy do nas"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018782
    m_Localized: Rozkaz to rozkaz
    m_Metadata:
      m_Items: []
  - m_Id: 2742018783
    m_Localized: "Moje skrzyd\u0142a ju\u017C zdr\u0119twia\u0142y"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018784
    m_Localized: "Siedzimy tu od miesi\u0105ca\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018785
    m_Localized: Kiedy wylatujemy?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018786
    m_Localized: "Wola\u0142bym ju\u017C si\u0119 st\u0105d wynie\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018788
    m_Localized: "Zauwa\u017Cono intruza"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018789
    m_Localized: "Otworzy\u0107 ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018790
    m_Localized: "Dzikusy atakuj\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018791
    m_Localized: "Wyeliminowa\u0107 cel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018792
    m_Localized: "Strzela\u0107, by zabi\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018793
    m_Localized: "Rozkazuj\u0119 otworzy\u0107 ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018794
    m_Localized: "Otwieram ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018795
    m_Localized: Postronni!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018796
    m_Localized: "Oczy\u015Bci\u0107 teren!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018797
    m_Localized: Rozkaz numer 56
    m_Metadata:
      m_Items: []
  - m_Id: 2742018798
    m_Localized: "Wykonuj\u0119 polecenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018799
    m_Localized: Atak z powietrza!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018800
    m_Localized: "Nie rozpoczyna\u0107 negocjacji"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018801
    m_Localized: Ognia!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018802
    m_Localized: "S\u0142ysz\u0119 obcy d\u017Awi\u0119k"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018803
    m_Localized: "Wr\xF3g jest w pobli\u017Cu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018804
    m_Localized: "Baczno\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018805
    m_Localized: Szyk bitewny
    m_Metadata:
      m_Items: []
  - m_Id: 2742018806
    m_Localized: "Bronie w gotowo\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018807
    m_Localized: Przeprowadzam rekonesans
    m_Metadata:
      m_Items: []
  - m_Id: 2742018808
    m_Localized: "Przygotowa\u0107 si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018809
    m_Localized: "Nie jeste\u015Bmy tu sami"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018810
    m_Localized: "Co\u015B spad\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018811
    m_Localized: "Sta\u0107! Kto idzie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018813
    m_Localized: Szukam
    m_Metadata:
      m_Items: []
  - m_Id: 2742018814
    m_Localized: "Odszuka\u0107 i zniszczy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018815
    m_Localized: Zgubiono cel
    m_Metadata:
      m_Items: []
  - m_Id: 2742018816
    m_Localized: "Wr\xF3g jest poza zasi\u0119giem wzroku"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018817
    m_Localized: "Szuka\u0107 z powietrza!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018818
    m_Localized: "Zaprzesta\u0107 po\u015Bcigu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018819
    m_Localized: "Alarm odwo\u0142any"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018820
    m_Localized: "B\u0105d\u017Acie w stanie gotowo\u015Bci, kucyki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018821
    m_Localized: "Wr\xF3g uciek\u0142"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018822
    m_Localized: Bez rezultatu
    m_Metadata:
      m_Items: []
  - m_Id: 2742018823
    m_Localized: "Ju\u017C jest bezpiecznie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018824
    m_Localized: "Wr\xF3ci\u0107 od zaraz do zada\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018825
    m_Localized: "Cisza i spok\xF3j"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018826
    m_Localized: "Czujniki milcz\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018827
    m_Localized: "\u017Badnych zagro\u017Ce\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018828
    m_Localized: Nic nadzwyczajnego
    m_Metadata:
      m_Items: []
  - m_Id: 2742018829
    m_Localized: "Zwi\u0119kszy\u0107 czujno\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018830
    m_Localized: "Nieprzyjaciel jest gdzie\u015B w pobli\u017Cu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018831
    m_Localized: "B\u0105d\u017Acie czujne, kucyki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018832
    m_Localized: "Pilnujcie swoich bok\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018833
    m_Localized: "Musi gdzie\u015B tu by\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018834
    m_Localized: Pancerz uszkodzony
    m_Metadata:
      m_Items: []
  - m_Id: 2742018835
    m_Localized: "Mog\u0119 kontynuowa\u0107 walk\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018836
    m_Localized: "Moje urazy s\u0105 drobne"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018837
    m_Localized: "Obra\u017Cenia w dopuszczalnych granicach"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018838
    m_Localized: "Jestem pod ostrza\u0142em!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018839
    m_Localized: Trafiono mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018840
    m_Localized: Stan stabilny
    m_Metadata:
      m_Items: []
  - m_Id: 2742018841
    m_Localized: Nic mi nie jest!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018842
    m_Localized: "To ju\u017C koniec\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018843
    m_Localized: "Naprawd\u0119 w taki spos\xF3b?.."
    m_Metadata:
      m_Items: []
  - m_Id: 2742018844
    m_Localized: "Trac\u0119 wysoko\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018845
    m_Localized: "Str\u0105cono mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018846
    m_Localized: "Nie uda\u0142o mi si\u0119 wykona\u0107 moich rozkaz\xF3w\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018847
    m_Localized: "Przepraszam za rozczarowanie was wszystkich\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018848
    m_Localized: "Aaaa!\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018849
    m_Localized: '* umiera *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018850
    m_Localized: Bip-bip
    m_Metadata:
      m_Items: []
  - m_Id: 2742018851
    m_Localized: "Analiza \u015Brodowiska\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018852
    m_Localized: Nie znaleziono pliku
    m_Metadata:
      m_Items: []
  - m_Id: 2742018853
    m_Localized: "Przechodz\u0119 do kolejnego polecenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018854
    m_Localized: Wymagana jest inspekcja techniczna
    m_Metadata:
      m_Items: []
  - m_Id: 2742018855
    m_Localized: "Niech zwr\xF3c\u0105 pa\u0144stwo uwag\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018856
    m_Localized: "Przeczytaj umow\u0119 licencyjn\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018857
    m_Localized: Wymagane nasmarowanie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018858
    m_Localized: "Wykonuj\u0119 polecenie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018859
    m_Localized: Bip
    m_Metadata:
      m_Items: []
  - m_Id: 2742018860
    m_Localized: Rozpoczynam
    m_Metadata:
      m_Items: []
  - m_Id: 2742018861
    m_Localized: "Zadanie uko\u0144czone"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018862
    m_Localized: Aktualizacja systemu
    m_Metadata:
      m_Items: []
  - m_Id: 2742018863
    m_Localized: Witaj
    m_Metadata:
      m_Items: []
  - m_Id: 2742018864
    m_Localized: "Dzie\u0144 dobry"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018865
    m_Localized: "Chroni\u0119 terenu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018866
    m_Localized: "Przemieszczam si\u0119 na pozycj\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018867
    m_Localized: Podaj polecenie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018868
    m_Localized: "Przepe\u0142nienie stosu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018869
    m_Localized: "\u0141adowanie baterii"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018870
    m_Localized: '* pika *'
    m_Metadata:
      m_Items: []
  - m_Id: 2742018871
    m_Localized: "* \u015Bwiat\u0142a migaj\u0105 *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018872
    m_Localized: "* brz\u0119czenie *"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018873
    m_Localized: "Prosz\u0119 si\u0119 odsun\u0105\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018874
    m_Localized: "\u0141adny dzi\u015B dzie\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018875
    m_Localized: Nic osobistego
    m_Metadata:
      m_Items: []
  - m_Id: 2742018876
    m_Localized: "Zaprogramowano mnie, by ci\u0119 zabi\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018877
    m_Localized: "Prosz\u0119, opu\u015B\u0107 swoj\u0105 bro\u0144 i poddaj si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018878
    m_Localized: Przepraszam!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018879
    m_Localized: Przykro mi, zmuszasz mnie do otwarcia ognia
    m_Metadata:
      m_Items: []
  - m_Id: 2742018880
    m_Localized: To smutne
    m_Metadata:
      m_Items: []
  - m_Id: 2742018881
    m_Localized: "St\xF3j nieruchomo, a\u017C ci\u0119 zabij\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018882
    m_Localized: "Przykro mi, ale musz\u0119 ci\u0119 zabi\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018883
    m_Localized: "Poddaj si\u0119 i daj si\u0119 zlikwidowa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018884
    m_Localized: "Musz\u0119 u\u017Cy\u0107 si\u0142y"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018885
    m_Localized: "Spokojnie, dojdzie jedynie do zlikwidowania ci\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018886
    m_Localized: "Obawiam si\u0119, \u017Ce musisz umrze\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018887
    m_Localized: "M\xF3j program ka\u017Ce mi strzela\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018888
    m_Localized: Nie uciekaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018889
    m_Localized: "Mi r\xF3wnie\u017C si\u0119 to nie podoba"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018890
    m_Localized: Co to jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018891
    m_Localized: Intruz?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018892
    m_Localized: "Wykryto obcy d\u017Awi\u0119k"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018893
    m_Localized: Wymagane zbadanie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018894
    m_Localized: "Wiesz, \u017Ce i tak ci\u0119 znajd\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018895
    m_Localized: "Prosz\u0119, przesta\u0144 si\u0119 ukrywa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018896
    m_Localized: "Gdzie jeste\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018897
    m_Localized: "Wyjd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018898
    m_Localized: "Poka\u017C si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018899
    m_Localized: "Nie widz\u0119 ci\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018900
    m_Localized: "Gdzie\u015B tu jeste\u015B, wiem to"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018901
    m_Localized: "Uruchamiam program szukaj\u0105cy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018902
    m_Localized: "Gdzie si\u0119 podziewasz?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018903
    m_Localized: "Wyjd\u017A i daj mi si\u0119 zabi\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018904
    m_Localized: "Znajd\u0119 ci\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018905
    m_Localized: "Nie ukryjesz si\u0119 przede mn\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018906
    m_Localized: "W porz\u0105dku. Mo\u017Ce nast\u0119pnym razem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018907
    m_Localized: "Jaki by\u0142 pow\xF3d twojej ucieczki?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018908
    m_Localized: "Anulowano procedur\u0119 szukania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018909
    m_Localized: "A wi\u0119c nast\u0119pnym razem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018910
    m_Localized: "Wr\xF3\u0107! Jeszcze nie sko\u0144czyli\u015Bmy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018911
    m_Localized: Wracam do pracy
    m_Metadata:
      m_Items: []
  - m_Id: 2742018912
    m_Localized: Jaka szkoda, nikogo tu nie ma
    m_Metadata:
      m_Items: []
  - m_Id: 2742018913
    m_Localized: "No dobrze, poznajmy si\u0119 nast\u0119pnym razem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018914
    m_Localized: Wykryto uszkodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 2742018915
    m_Localized: "Przebito kad\u0142ub"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018916
    m_Localized: Wyciek oleju
    m_Metadata:
      m_Items: []
  - m_Id: 2742018917
    m_Localized: "Nieprzyjacielskie dzia\u0142ania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018918
    m_Localized: Ale dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018919
    m_Localized: "Przemoc nie jest wyj\u015Bciem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018920
    m_Localized: bip-bip-bip
    m_Metadata:
      m_Items: []
  - m_Id: 2742018921
    m_Localized: "B\u0142\u0105d sys\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018922
    m_Localized: "Gwarancja jest nieaktu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018923
    m_Localized: "Program wykona\u0142 niedozwolon\u0105 ope\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018924
    m_Localized: "Awaria sys\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018925
    m_Localized: "O nie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018926
    m_Localized: "Co ty ro\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018927
    m_Localized: "Przest\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018928
    m_Localized: "Wymuszone zamkni\u0119cie sys\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018929
    m_Localized: "B\u0142\u0105d krytycz\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018930
    m_Localized: "Tak mi przykro\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018931
    m_Localized: Twoje zachowanie jest niedopuszczalne
    m_Metadata:
      m_Items: []
  - m_Id: 2742018932
    m_Localized: "Prosz\u0119, pu\u015B\u0107 mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018933
    m_Localized: "M\xF3j program tego nie obejmuje"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018934
    m_Localized: "Wykryto magi\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018935
    m_Localized: "S\u0142u\u017Cy\u0107 i chroni\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018936
    m_Localized: "Prosz\u0119 i\u015B\u0107 dalej"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018937
    m_Localized: "Prawo i porz\u0105dek"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018938
    m_Localized: Tryb patrolu
    m_Metadata:
      m_Items: []
  - m_Id: 2742018939
    m_Localized: Chronienie obiektu
    m_Metadata:
      m_Items: []
  - m_Id: 2742018940
    m_Localized: "U\u017Cycie si\u0142y dozwolone"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018941
    m_Localized: "Dzia\u0142ania przest\u0119pcze b\u0119d\u0105 karane"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018942
    m_Localized: "Zachowania antyspo\u0142eczne s\u0105 niedopuszczalne"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018943
    m_Localized: "Nie zak\u0142\xF3ca\u0107 pracy funkcjonariuszy organ\xF3w \u015Bcigania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018944
    m_Localized: Zgodnie z prawem
    m_Metadata:
      m_Items: []
  - m_Id: 2742018945
    m_Localized: "Kradzie\u017C jest zakazana"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018946
    m_Localized: "Sytuacja pod kontrol\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018947
    m_Localized: "Nie zaobserwowano \u017Cadnych bezprawnych czyn\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018948
    m_Localized: "Raport s\u0142u\u017Cb bezpiecze\u0144stwa na dzi\u015B"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018949
    m_Localized: Perymetr czysty
    m_Metadata:
      m_Items: []
  - m_Id: 2742018950
    m_Localized: "W s\u0142u\u017Cbie prawu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018951
    m_Localized: "Cisza i spok\xF3j"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018952
    m_Localized: Zgodnie z prawem wojennym
    m_Metadata:
      m_Items: []
  - m_Id: 2742018953
    m_Localized: "Rozejd\u017Acie si\u0119 do swoich miejsc pracy, kucyki"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018954
    m_Localized: "Kontynuowa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018955
    m_Localized: "Nie ma tu na co patrze\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018956
    m_Localized: "Nie wolno wam tu przebywa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018957
    m_Localized: "Strefa zamkni\u0119ta"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018958
    m_Localized: "Otwieram ogie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018959
    m_Localized: "Do\u0142\u0105czam do walki"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018960
    m_Localized: "Neutralizacja nieproszonych go\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018961
    m_Localized: "Wszyscy praworz\u0105dni obywatele opu\u015B\u0107cie stref\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018962
    m_Localized: "Bez obaw. Porz\u0105dek zostanie niebawem przywr\xF3cony"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018963
    m_Localized: "Op\xF3r jest uznawany za przest\u0119pstwo"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018964
    m_Localized: To jest w twoim najlepszym interesie
    m_Metadata:
      m_Items: []
  - m_Id: 2742018965
    m_Localized: "Od\u0142\xF3\u017C bro\u0144 i poddaj si\u0119 w\u0142adzom"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018966
    m_Localized: "U\u017Cycie si\u0142y jest zgodne z prawem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018967
    m_Localized: "Opu\u015B\u0107 bro\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018968
    m_Localized: "Zakaz wst\u0119pu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018969
    m_Localized: "Zg\u0142aszam bezprawne dzia\u0142ania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018970
    m_Localized: "Nie ruszaj si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018971
    m_Localized: "Wyeliminowa\u0107 zagro\u017Cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018972
    m_Localized: Rozpoznano nieprzyjacielski cel
    m_Metadata:
      m_Items: []
  - m_Id: 2742018973
    m_Localized: "Masz prawo do szybkiej \u015Bmierci"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018974
    m_Localized: "W\u0142\u0105czy\u0107 protok\xF3\u0142 szukania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018975
    m_Localized: "Potencjalne naruszenie porz\u0105dku"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018976
    m_Localized: Potencjalna bezprawna infiltracja
    m_Metadata:
      m_Items: []
  - m_Id: 2742018977
    m_Localized: Szukanie wroga
    m_Metadata:
      m_Items: []
  - m_Id: 2742018978
    m_Localized: "Wyjd\u017A i przedstaw si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018979
    m_Localized: "Szukanie naruszaj\u0105cych przepisy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018980
    m_Localized: "Nie pr\xF3buj si\u0119 ukrywa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018981
    m_Localized: Stawianie oporu podczas aresztowania jest karalne
    m_Metadata:
      m_Items: []
  - m_Id: 2742018982
    m_Localized: "Przest\u0119pca uciek\u0142 przed po\u015Bcigiem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018983
    m_Localized: "Wr\xF3g zwia\u0142"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018984
    m_Localized: "Poszukiwanie zako\u0144czone. Nie znaleziono \u017Cadnych wrog\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018985
    m_Localized: "Ko\u0144czenie protoko\u0142u po\u015Bcigu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018986
    m_Localized: "Fa\u0142szywy alarm"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018987
    m_Localized: Wracam do patrolowania
    m_Metadata:
      m_Items: []
  - m_Id: 2742018988
    m_Localized: Anulowanie polecenia
    m_Metadata:
      m_Items: []
  - m_Id: 2742018989
    m_Localized: Wykryto uszkodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 2742018990
    m_Localized: "Dalsze dzia\u0142anie systemu nie jest gwarantowane"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018991
    m_Localized: "Powa\u017Cna szkoda"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018992
    m_Localized: Awaria systemu
    m_Metadata:
      m_Items: []
  - m_Id: 2742018993
    m_Localized: Stawianie oporu podczas aresztowania
    m_Metadata:
      m_Items: []
  - m_Id: 2742018994
    m_Localized: "Kontynuowanie niemo\u017C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018995
    m_Localized: "Alarm! Wzywanie s\u0142u\u017Cb bezpiecz\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018996
    m_Localized: "Wykryto b\u0142\u0105d sys\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018997
    m_Localized: "Stan wszystkich system\xF3w wynosi zero procent"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018998
    m_Localized: "Bezpiecze\u0144stwo nie mo\u017Ce zosta\u0107 zagwar\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742018999
    m_Localized: "Porz\u0105dek nie m\xF3g\u0142 zosta\u0107 przywr\xF3\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019000
    m_Localized: "Nielegalne dzia\u0142ania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019001
    m_Localized: "Bezprawne u\u017Cycie magii"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019002
    m_Localized: "Naruszenie porz\u0105dku"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019003
    m_Localized: Nieakceptowalne zachowanie
    m_Metadata:
      m_Items: []
  - m_Id: 2742019004
    m_Localized: "Kolejny chwalebny dzie\u0144 w equestria\u0144skiej armii!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019005
    m_Localized: "Wr\xF3g zostanie pokonany!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019006
    m_Localized: "Chwa\u0142a patriotom!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019007
    m_Localized: "B\xF3l jest s\u0142abo\u015Bci\u0105 opuszczaj\u0105c\u0105 cia\u0142o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019008
    m_Localized: "Wszystko dla zwyci\u0119stwa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019009
    m_Localized: "Zwyci\u0119stwo b\u0119dzie nasze!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019010
    m_Localized: "\u017Baden kucyk nie z\u0142amie naszego ducha!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019011
    m_Localized: "Nasz wr\xF3g b\u0119dzie rycza\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019012
    m_Localized: Stworzono mnie do boju!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019013
    m_Localized: Jest taka profesja - chronienie Ojczyzny!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019014
    m_Localized: "Do\u0142\u0105cz do szereg\xF3w si\u0142 zbrojnych!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019015
    m_Localized: "Strach jest s\u0142abo\u015Bci\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019016
    m_Localized: "Jak tam cywilne \u017Cycie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019017
    m_Localized: "Wygrajmy wojn\u0119\u2026 nast\u0119pnie zacznijmy \u017Cy\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019018
    m_Localized: "Na ziemi\u0119 i r\xF3b pompki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019019
    m_Localized: Pora na prysznic!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019020
    m_Localized: "Tak to si\u0119 robi w armii!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019021
    m_Localized: "Wystarczy\u0142by mi medal"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019022
    m_Localized: "Pom\u015Bcimy naszych!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019023
    m_Localized: "Equestria\u0144czycy si\u0119 nie poddaj\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019024
    m_Localized: "To dobry dzie\u0144, by umrze\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019025
    m_Localized: "Jeste\u015B gotowy umrze\u0107 za swoj\u0105 ojczyzn\u0119, pasiasty
      gnoju?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019026
    m_Localized: "Zabi\u0107 \u015Bcierwa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019027
    m_Localized: "Poznaj equestria\u0144sk\u0105 armi\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019028
    m_Localized: "Zdaje si\u0119, \u017Ce mam dzisiaj szcz\u0119\u015Bcie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019029
    m_Localized: "Zaraz b\u0119dzie tu gor\u0105co!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019030
    m_Localized: "Ud\u0142aw si\u0119 o\u0142owiem, zebro!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019031
    m_Localized: "No dalej, ch\u0142opaki, zgotujmy im piek\u0142o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019032
    m_Localized: "Jak ci si\u0119 to podoba, pasiasty degeneracie?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019033
    m_Localized: "Nie bra\u0107 je\u0144c\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019034
    m_Localized: "Twoja sk\xF3ra b\u0119dzie moja!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019035
    m_Localized: "Dobra, teraz to mnie rozz\u0142oszczono!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019036
    m_Localized: "Po\u017Ca\u0142ujesz przyj\u015Bcia na \u015Bwiat, gnoju!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019037
    m_Localized: "Pasiaste \u015Bmieci!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019038
    m_Localized: "Zr\xF3bmy w nich dziury!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019039
    m_Localized: "Zabi\u0107 wszystkich! Boginie si\u0119 nimi zajm\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019040
    m_Localized: "My\u015Blisz, \u017Ce ci\u0119 nie s\u0142ysz\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019041
    m_Localized: "Tam jest jaki\u015B kucyk, sprawdzi\u0107 to!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019042
    m_Localized: "Zdecydowanie kto\u015B tam jest!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019043
    m_Localized: "Zosta\u0144cie na pozycjach, sprawdz\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019044
    m_Localized: "Wyjd\u017A i przedstaw si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019045
    m_Localized: "W co sobie ze mn\u0105 pogrywasz, bydlaku?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019046
    m_Localized: "Znajd\u0119 ci\u0119 i wyko\u0144cz\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019047
    m_Localized: "My\u015Blisz, \u017Ce ukryjesz si\u0119 przede mn\u0105?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019048
    m_Localized: "Pierdol si\u0119 z tym ukrywaniem si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019049
    m_Localized: "Typowy tch\xF3rzliwy manewr zebr"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019050
    m_Localized: "Wy\u0142a\u017A, szumowino zebr!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019051
    m_Localized: "Boisz si\u0119 mnie? S\u0142usznie si\u0119 mnie boisz!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019052
    m_Localized: "No dalej, ch\u0142opaki, kto do odstrza\u0142u?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019053
    m_Localized: "Ech, nie b\u0119dzie dzisiaj zabawy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019054
    m_Localized: Pole bitwy znowu jest nasze!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019055
    m_Localized: "Wr\xF3g zwia\u0142 tch\xF3rzliwie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019056
    m_Localized: "Fa\u0142szywy alarm. Wycofa\u0107 si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019057
    m_Localized: Tym lepiej!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019058
    m_Localized: "Odwo\u0142a\u0107 alarm!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019059
    m_Localized: "Ukrywaj\u0105 si\u0119, gnoje!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019060
    m_Localized: I to tyle???
    m_Metadata:
      m_Items: []
  - m_Id: 2742019061
    m_Localized: Rysa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019062
    m_Localized: "Ha, przesz\u0142o na wylot"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019063
    m_Localized: Kompletnie nic nie odczuwam!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019064
    m_Localized: "M\xF3j pancerz jest mocny"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019065
    m_Localized: Nazywasz to uderzeniem?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019066
    m_Localized: Nie rozbrajaj mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019067
    m_Localized: To wszystko, co potrafisz?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019068
    m_Localized: "To mnie jedynie z\u0142o\u015Bci!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019069
    m_Localized: To tyle?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019070
    m_Localized: "Ciemnieje mi w oczach\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019071
    m_Localized: "Powiedz matce, \u017Ce jej dziecko zrobi\u0142o, co mog\u0142o\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019072
    m_Localized: "Powiadom rodzin\u0119\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019073
    m_Localized: "Oto i koniec bojownika\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019074
    m_Localized: "I wy\u015Blijcie cynkow\u0105 trumn\u0119 do domu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019075
    m_Localized: "NIE! B\u0119dziemy dalej walczy\u0107\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019076
    m_Localized: "Do zobaczenia w piekle\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019077
    m_Localized: Twoja magia to dla mnie nic!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019078
    m_Localized: "N\u0119dzna pr\xF3ba, kreaturo"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019079
    m_Localized: Nie przytrzymasz mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019080
    m_Localized: No i co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019081
    m_Localized: "Pobawimy si\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019082
    m_Localized: "Naucz mnie bycia przyjaci\xF3\u0142mi!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019083
    m_Localized: "Zabawimy si\u0119 nieco?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019084
    m_Localized: "No nareszcie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019085
    m_Localized: "Patrz, co potrafi\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019086
    m_Localized: Witajcie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019087
    m_Localized: Niespodzianka!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019088
    m_Localized: "No to zaczynamy zabaw\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019089
    m_Localized: Jeeej!!!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019090
    m_Localized: Och! Co tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019091
    m_Localized: "Mamy go\u015Bci?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019092
    m_Localized: "S\u0142ysz\u0119 ci\u0119\u0119\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019093
    m_Localized: "St\xF3j! B\u0142agam ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019094
    m_Localized: "Hej! Gdzie jeste\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019095
    m_Localized: Nie uciekaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019096
    m_Localized: "Chcesz pobawi\u0107 si\u0119 w chowanego?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019097
    m_Localized: Dopiero zaczynamy!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019098
    m_Localized: "I tak ci\u0119 znajd\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019099
    m_Localized: "A by\u0142o tyle zabawy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019100
    m_Localized: I znowu nudy
    m_Metadata:
      m_Items: []
  - m_Id: 2742019101
    m_Localized: I znowu nikogo
    m_Metadata:
      m_Items: []
  - m_Id: 2742019102
    m_Localized: "Nie ma tu \u017Cadnego kucyka\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019103
    m_Localized: "Au\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019104
    m_Localized: "To \u0142askocze!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019105
    m_Localized: "A\u0142! Za co?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019106
    m_Localized: Dlaczego tak nieuprzejmie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019107
    m_Localized: "No dzi\u0119ki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019108
    m_Localized: "Czyli si\u0119 nie zaprzyja\u017Animy?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019109
    m_Localized: "Jest w porz\u0105dku, mam kopi\u0119 zapaso\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019110
    m_Localized: Bywaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019111
    m_Localized: O nieeee!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019112
    m_Localized: Jak poradzisz sobie beze mnie?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019113
    m_Localized: "Och! To m\xF3j pechowy dzie\u0144!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019114
    m_Localized: "O \u0142a\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019115
    m_Localized: Ja latam!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019116
    m_Localized: "Tak! Przele\u0107my si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019117
    m_Localized: Zabawa!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019118
    m_Localized: Status broni - gotowa
    m_Metadata:
      m_Items: []
  - m_Id: 2742019119
    m_Localized: "Poziom niebezpiecze\u0144stwa - zielony"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019120
    m_Localized: Teren czysty
    m_Metadata:
      m_Items: []
  - m_Id: 2742019121
    m_Localized: 'Specyfika otoczenia: strefa wojny'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019122
    m_Localized: "Obiekt pod ochron\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019123
    m_Localized: "Status baterii: brak potrzeby \u0142adowania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019124
    m_Localized: 'Status systemu: wymagana zaplanowana konserwacja'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019125
    m_Localized: "Cywilom wst\u0119p wzbroniony"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019126
    m_Localized: "Obecny protok\xF3\u0142: ochrona"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019127
    m_Localized: "Obecny protok\xF3\u0142: patrolowanie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019128
    m_Localized: "Szukanie niebezpiecze\u0144stw\u2026 Nie znaleziono"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019129
    m_Localized: "System dzia\u0142a w trybie normalnym"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019130
    m_Localized: "U\u017Cycie si\u0142y: Dozwolone"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019131
    m_Localized: "Kontynuuj\u0119 wykonywanie polecenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019132
    m_Localized: "Poziom niebezpiecze\u0144stwa - czerwony"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019133
    m_Localized: Dodano cel do kolejki
    m_Metadata:
      m_Items: []
  - m_Id: 2742019134
    m_Localized: Ustawiono priorytetowy cel
    m_Metadata:
      m_Items: []
  - m_Id: 2742019135
    m_Localized: "Wszyscy cywile, natychmiast opu\u015Bci\u0107 stref\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019136
    m_Localized: "Rozpoczynam eliminacj\u0119 celu"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019137
    m_Localized: "Do\u0142\u0105czam do walki"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019138
    m_Localized: "Wszyscy cywile, oddali\u0107 si\u0119 na bezpieczn\u0105 odleg\u0142o\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019139
    m_Localized: Uwaga. Wykryto nieprzyjaciela
    m_Metadata:
      m_Items: []
  - m_Id: 2742019140
    m_Localized: Alarm. Wykryto wroga
    m_Metadata:
      m_Items: []
  - m_Id: 2742019141
    m_Localized: "Trwa proces neutralizacji zagro\u017Cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019142
    m_Localized: "Namierzono cel. Otworzy\u0107 ogie\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019143
    m_Localized: "Bro\u0144 s\u0142u\u017Cy do ra\u017Cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019144
    m_Localized: "Bezpiecze\u0144stwo cywil\xF3w nie jest gwarantowane"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019145
    m_Localized: Aktywowano systemy obronne
    m_Metadata:
      m_Items: []
  - m_Id: 2742019146
    m_Localized: "Rozpoznano cel. Dzia\u0142anie: unicestwienie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019147
    m_Localized: "Procedura pozbywania si\u0119 zagro\u017Cenia w toku"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019148
    m_Localized: Bronie gotowe do walki
    m_Metadata:
      m_Items: []
  - m_Id: 2742019149
    m_Localized: "Uwaga: otworzono ogie\u0144 bez ostrze\u017Cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019150
    m_Localized: "Protok\xF3\u0142 obserwacji jest aktywny"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019151
    m_Localized: "Wszystkie systemy s\u0105 w stanie gotowo\u015Bci bojowej"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019152
    m_Localized: Szukanie priorytetowego celu
    m_Metadata:
      m_Items: []
  - m_Id: 2742019153
    m_Localized: "Poziom niebezpiecze\u0144stwa - \u017C\xF3\u0142ty"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019154
    m_Localized: Przeczesywanie terytorium
    m_Metadata:
      m_Items: []
  - m_Id: 2742019155
    m_Localized: "Zgubiono cel. G\u0142\xF3wne zadanie pozostaje niezmienione"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019156
    m_Localized: "Cel nie zosta\u0142 unicestwiony. Rozpoczynam poszukiwanie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019157
    m_Localized: "Poziom niebezpiecze\u0144stwa - zielony. Odbi\xF3r"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019158
    m_Localized: "Brak zagro\u017Cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019159
    m_Localized: "Poszukiwanie zako\u0144czone. Nie znaleziono przeciwnika"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019160
    m_Localized: Powracanie do standardowego trybu patrolu
    m_Metadata:
      m_Items: []
  - m_Id: 2742019161
    m_Localized: Powracanie do patrolu
    m_Metadata:
      m_Items: []
  - m_Id: 2742019162
    m_Localized: Pancerz uszkodzony
    m_Metadata:
      m_Items: []
  - m_Id: 2742019163
    m_Localized: "G\u0142\xF3wne systemy uszkodzone"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019164
    m_Localized: "Kontynuowanie pracy jest mo\u017Cliwe"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019165
    m_Localized: "Naruszenie integralno\u015Bci kad\u0142uba"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019166
    m_Localized: "Prze\u0142\u0105czanie na tryb awaryjny"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019167
    m_Localized: "G\u0142\xF3wne systemy nie dzia\u0142a\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019168
    m_Localized: "Awaria sys\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019169
    m_Localized: "Poziom uszkodze\u0144 jest krytycz\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019170
    m_Localized: "Operacja nie zosta\u0142a zako\u0144\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019171
    m_Localized: "Wsparcie silnie potrzeb\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019172
    m_Localized: "Przyb\u0105d\u017A i nab\u0105d\u017A, byle szybko!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019173
    m_Localized: "Przyjd\u017A, zobacz, kup!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019174
    m_Localized: "P\u0142atno\u015B\u0107 kapslami!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019175
    m_Localized: "Spluwy, dzia\u0142a, amunicja\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019176
    m_Localized: "Komu amunicj\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019177
    m_Localized: "Skupujemy amunicj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019178
    m_Localized: "Hej, t\u0119dy!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019179
    m_Localized: "\u017Badnych oszustw!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019180
    m_Localized: "Targowanie si\u0119 jest w\u0142a\u015Bciwe!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019181
    m_Localized: Najlepszy towar na Pustkowiu!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019182
    m_Localized: "Firma daje gwarancj\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019183
    m_Localized: Wszystko uczciwie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019184
    m_Localized: "Wyprzeda\u017C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019185
    m_Localized: "Zni\u017Cki dla weteran\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019186
    m_Localized: "Dzi\u0119kujemy, zapraszamy ponownie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019187
    m_Localized: "Mi\u0142o si\u0119 z tob\u0105 robi interesy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019188
    m_Localized: "Jakby co, b\u0119d\u0119 tutaj"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019189
    m_Localized: "Wr\xF3\u0107, gdy b\u0119dziesz mie\u0107 kapsle"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019190
    m_Localized: Hej, nie dotykaj tego!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019191
    m_Localized: "Gdzie ci\u0119 boli?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019192
    m_Localized: "Przyjd\u017A na opatrzenie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019193
    m_Localized: "Mikstury lecznicze\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019194
    m_Localized: "Po\u0142atamy ci\u0119 natychmiast!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019195
    m_Localized: Kto jest ranny?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019196
    m_Localized: Kto potrzebuje lekarza?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019197
    m_Localized: Magiczne leczenie
    m_Metadata:
      m_Items: []
  - m_Id: 2742019198
    m_Localized: Co ci dolega?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019199
    m_Localized: Leczymy wszystko
    m_Metadata:
      m_Items: []
  - m_Id: 2742019200
    m_Localized: "Wszystko odbywa si\u0119 bezbole\u015Bnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019201
    m_Localized: "Je\u015Bli nie prze\u017Cyjesz leczenia, to mo\u017Cesz nie p\u0142aci\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019202
    m_Localized: Najlepsza opieka zdrowotna na Pustkowiu!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019203
    m_Localized: "Gdzie jest m\xF3j skalpel?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019204
    m_Localized: "Szczepienia na w\u015Bcieklizn\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019205
    m_Localized: "\u017Badnego szarlata\u0144stwa"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019206
    m_Localized: "Transfuzja krwi za p\xF3\u0142 ceny"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019207
    m_Localized: "Zni\u017Cki na leczenie chor\xF3b wenerycznych"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019208
    m_Localized: "\u017Bycz\u0119 zdrowia"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019209
    m_Localized: "Nast\u0119pny!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019210
    m_Localized: "B\u0105d\u017A ostro\u017Cna nast\u0119pnym razem"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019211
    m_Localized: "B\u0105d\u017A zdrowa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019212
    m_Localized: "Ju\u017C dobrze, zagoi si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019213
    m_Localized: To nic, przejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 2742019214
    m_Localized: "I tak powinno by\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019215
    m_Localized: "Pomocy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019216
    m_Localized: "Pom\xF3\u017Ccie mi!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019217
    m_Localized: "Wypu\u015B\u0107cie mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019218
    m_Localized: "Na pomoc\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019219
    m_Localized: "Jakikolwiek kucyk\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019220
    m_Localized: "Dajcie wody\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019221
    m_Localized: "Co si\u0119 ze mn\u0105 stanie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019222
    m_Localized: "Pi\u0107......"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019223
    m_Localized: "Potrzebuj\u0119 pomocy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019224
    m_Localized: "Dzi\u0119ki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019225
    m_Localized: "Dzi\u0119kuj\u0119 ci!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019226
    m_Localized: "Uratowa\u0142a\u015B mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019227
    m_Localized: "Dzi\u0119ki ci!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019228
    m_Localized: "Wynosz\u0119 si\u0119 st\u0105d!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019229
    m_Localized: "Wolno\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019230
    m_Localized: "Wyno\u015Bmy si\u0119 st\u0105d!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019231
    m_Localized: Hej!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019232
    m_Localized: "Jak si\u0119 masz?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019233
    m_Localized: Ech!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019234
    m_Localized: "Tak, to jest problem\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019235
    m_Localized: "Kucyki zawsze gadaj\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019236
    m_Localized: Co nowego?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019237
    m_Localized: "Nie jeste\u015B z naszej okolicy?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019238
    m_Localized: "Co ty m\xF3wisz?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019239
    m_Localized: "Jaki\u015B kucyk zawsze potrzebuje pomocy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019240
    m_Localized: "To w og\xF3le nie jest moja sprawa\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019241
    m_Localized: "To mnie nie dotyczy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019242
    m_Localized: "Znowu si\u0119 zaczyna\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019243
    m_Localized: "Co tam s\u0142ycha\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019244
    m_Localized: Co teraz zrobimy?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019245
    m_Localized: "Mam tego wszystkiego tak bardzo do\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019246
    m_Localized: "Jak zwykle\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019247
    m_Localized: "No tak\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019248
    m_Localized: "Sama by sobie poradzi\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019249
    m_Localized: "Znowu to robi\u0105\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019250
    m_Localized: To zdecydowanie nie jest jego zmartwienie
    m_Metadata:
      m_Items: []
  - m_Id: 2742019251
    m_Localized: "A co ze mn\u0105?"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567827
    m_Localized: "Sk\u0105d dobiega ten smr\xF3d?"
    m_Metadata:
      m_Items: []
  - m_Id: 2926567828
    m_Localized: Och, to ty
    m_Metadata:
      m_Items: []
  - m_Id: 2926567829
    m_Localized: Niech to szlag!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567830
    m_Localized: Sporo rozumiesz!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567831
    m_Localized: Mam wiele do zrobienia!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567832
    m_Localized: "Powinni\u015Bmy nieco odpocz\u0105\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019252
    m_Localized: Znowu do pracy
    m_Metadata:
      m_Items: []
  - m_Id: 2742019253
    m_Localized: "Mi\u0142o by by\u0142o pomalowa\u0107 t\u0119 \u015Bcian\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019254
    m_Localized: "Gdzie jest m\xF3j \u015Brubokr\u0119t?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019255
    m_Localized: "No i co zrobisz\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019256
    m_Localized: "Jejku\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019257
    m_Localized: Wszystko po staremu?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019258
    m_Localized: Kiedy jest twoja zmiana?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019259
    m_Localized: Obiad jest na czas?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019260
    m_Localized: "Mam tego wszystkiego\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019261
    m_Localized: "To miejsce to kompletna dziura\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019262
    m_Localized: "Instalacja iskrzy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019263
    m_Localized: "Dzie\u0144 min\u0105\u0142, i chuj z nim\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019264
    m_Localized: "Jebane \u017Cycie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019265
    m_Localized: "Ty skur\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019266
    m_Localized: Co teraz zrobimy?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019267
    m_Localized: "Mam tego wszystkiego tak bardzo do\u015B\u0107\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019268
    m_Localized: "Jak zwykle\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019269
    m_Localized: "No tak\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019270
    m_Localized: "A czego niby mo\u017Cna by\u0142o si\u0119 spodziewa\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019271
    m_Localized: "Znowu to robi\u0105\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019272
    m_Localized: "To miejsce \u015Bmierdzi!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019273
    m_Localized: "A co ze mn\u0105?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019274
    m_Localized: "Co\u015B mi skapuje z g\u0142owy"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019275
    m_Localized: "Dobrze, \u017Ce jeste\u015B tutaj, a nie na zewn\u0105trz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019276
    m_Localized: "Eksperyment zako\u0144czy\u0142 si\u0119 pomy\u015Blnie"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019277
    m_Localized: "Znowu jest tu ple\u015B\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019278
    m_Localized: "No i gdzie si\u0119 poturla\u0142o to badziewie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019279
    m_Localized: "Nienawidz\u0119 sprz\u0105tania"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019280
    m_Localized: "M\xF3j PipBuck si\u0119 gliczuje"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019281
    m_Localized: No tak!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019282
    m_Localized: "Nie czuj\u0119 si\u0119 zbyt dobrze"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019283
    m_Localized: "Och, @lp, kop\u0119 lat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019284
    m_Localized: "Min\u0119\u0142o sporo czasu, @lp!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019285
    m_Localized: "@lp, troszk\u0119 ci\u0119 nie by\u0142o."
    m_Metadata:
      m_Items: []
  - m_Id: 2742019286
    m_Localized: "Jak si\u0119 masz, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019287
    m_Localized: "Hej @lp, ju\u017C wr\xF3ci\u0142a\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019288
    m_Localized: "Wr\xF3ci\u0142a\u015B, @lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019289
    m_Localized: "Jak jest tam na g\xF3rze?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019290
    m_Localized: "Czy to prawda, \u017Ce na zewn\u0105trz s\u0105 jedynie potwory
      i promieniowanie?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019291
    m_Localized: "Widzia\u0142a\u015B potwory?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019292
    m_Localized: "Och\u2026 @lp wr\xF3ci\u0142a\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019293
    m_Localized: "\u0141a\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019294
    m_Localized: "Tylko sp\xF3jrz na siebie!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019295
    m_Localized: "Kiedy po raz ostatni bra\u0142a\u015B prysznic?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019296
    m_Localized: Hej!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019297
    m_Localized: Siema, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019298
    m_Localized: Co tam, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019299
    m_Localized: "Kiedy zwr\xF3cisz m\xF3j d\u0142ug?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019300
    m_Localized: "M\xF3j PipBuck znowu si\u0119 zepsu\u0142, mo\u017Cesz go zreperowa\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019301
    m_Localized: A niech mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019302
    m_Localized: "Czy wszystkie kucyki na zewn\u0105trz tak chodz\u0105?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019303
    m_Localized: "Wci\u0105\u017C potrzebujesz swoich rzeczy?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019304
    m_Localized: "Wydawa\u0142o mi si\u0119, \u017Ce nigdy nie wr\xF3cisz"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019305
    m_Localized: "No, to\u017C to \"Dziecko-25\" we w\u0142asnej osobie\u2026 pomy\u015Ble\u0107\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019306
    m_Localized: "Dowiedzia\u0142a\u015B si\u0119 czego\u015B o Velvet?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019307
    m_Localized: "Ju\u017C wr\xF3ci\u0142a\u015B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019308
    m_Localized: "Urz\u0105dzamy imprez\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019309
    m_Localized: "Podejd\u017A, napij si\u0119 troch\u0119 alkoholu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019310
    m_Localized: "Hej, zaj\u0119te!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019311
    m_Localized: "Cze\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019312
    m_Localized: "Jak si\u0119 masz?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019313
    m_Localized: "Pobawimy si\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019314
    m_Localized: Pif-paf
    m_Metadata:
      m_Items: []
  - m_Id: 2742019315
    m_Localized: "Wkr\xF3tce umrzecie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019316
    m_Localized: Ale fajnie!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019317
    m_Localized: Czad!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019318
    m_Localized: Hej, to moje!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019319
    m_Localized: Moje lepsze!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019320
    m_Localized: Piu! Piu!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019321
    m_Localized: Tra-la-la
    m_Metadata:
      m_Items: []
  - m_Id: 2742019322
    m_Localized: "Pobawimy si\u0119 w chowanego?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019323
    m_Localized: "Ale z ciebie g\u0142upek!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019324
    m_Localized: Bla-bla-bla
    m_Metadata:
      m_Items: []
  - m_Id: 2742019325
    m_Localized: "Cofn\u0105\u0107 si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019326
    m_Localized: Bum-bum-burum
    m_Metadata:
      m_Items: []
  - m_Id: 2742019327
    m_Localized: "Dasz par\u0119 kapsli?"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019328
    m_Localized: Jeny!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019329
    m_Localized: Hej, pacz tutaj!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019330
    m_Localized: "Ja nic nie robi\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019331
    m_Localized: "To ju\u017C by\u0142o zepsute!"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019332
    m_Localized: Hej, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019333
    m_Localized: Jej!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019334
    m_Localized: "Nuuudyyy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2742019335
    m_Localized: To wszystko jego wina!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019336
    m_Localized: "Ja tu tylko stoj\u0119"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
