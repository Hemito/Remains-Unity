      m_Items: []
  - m_Id: 2729436591
    m_Localized: "Korzystanie z zakl\u0119cia: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436592
    m_Localized: "Co\u015B uniemo\u017Cliwia zamkni\u0119cie drzwi"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436593
    m_Localized: "Nie mo\u017Cesz zmienia\u0107 ubra\u0144 podczas walki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436594
    m_Localized: "Mo\u017Cesz zmieni\u0107 sw\xF3j pancerz jedynie w obozie bazowym"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436595
    m_Localized: "Nie mo\u017Cesz u\u017Cy\u0107 tego podczas walki!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436596
    m_Localized: "PipBuck jest obecnie niedost\u0119pny"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436597
    m_Localized: 'Naprawiono: @1 (kondycja @2%)'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436598
    m_Localized: Naprawa nie jest wymagana
    m_Metadata:
      m_Items: []
  - m_Id: 2729436599
    m_Localized: "Ta bro\u0144 nie mo\u017Ce zosta\u0107 naprawiona"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436600
    m_Localized: 'Brak amunicji: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436601
    m_Localized: "Z t\u0105 broni\u0105 nie mo\u017Cna u\u017Cywa\u0107 amunicji:
      @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436602
    m_Localized: "Bro\u0144 jest zepsuta: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436603
    m_Localized: "Prze\u0142adowanie: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436604
    m_Localized: "Roz\u0142adowano bro\u0144: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436605
    m_Localized: 'Nabyto profit: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436606
    m_Localized: "Nabyto umiej\u0119tno\u015B\u0107: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436607
    m_Localized: "Dodano punkt umiej\u0119tno\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436608
    m_Localized: "Bonus za skradanie si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436609
    m_Localized: "Dodano punkty umiej\u0119tno\u015Bci: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436610
    m_Localized: "Dost\u0119pne nowe profity"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436611
    m_Localized: "Ulepszono umiej\u0119tno\u015B\u0107: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436612
    m_Localized: "Nic ciekawego\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436613
    m_Localized: "Brak efektu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436614
    m_Localized: "Efekt min\u0105\u0142: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436615
    m_Localized: "Min\u0105\u0142 efekt od jedzenia"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436616
    m_Localized: "Obiekt jest poza zasi\u0119giem wzroku"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436617
    m_Localized: 'Przechodzenie do: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436618
    m_Localized: "Nie mo\u017Cesz opu\u015Bci\u0107 pomieszczenia podczas ataku"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436619
    m_Localized: "Systemy bezpiecze\u0144stwa zosta\u0142y wy\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436620
    m_Localized: Otwarto zamki
    m_Metadata:
      m_Items: []
  - m_Id: 2729436621
    m_Localized: "Odci\u0119to zasilanie Robokom\xF3rki"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436622
    m_Localized: "Wy\u0142\u0105czono alarm"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436623
    m_Localized: "Ta bro\u0144 nie jest wspierana przez S.A.T.S."
    m_Metadata:
      m_Items: []
  - m_Id: 2729436624
    m_Localized: "Za ma\u0142o punkt\xF3w akcji"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436625
    m_Localized: "Powi\u0119kszenie 100%"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436626
    m_Localized: "Powi\u0119kszenie 1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436627
    m_Localized: "Powi\u0119kszenie 2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436628
    m_Localized: "Potrzeba wi\u0119cej kapsli: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436629
    m_Localized: "Za ma\u0142o punkt\xF3w umiej\u0119tno\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436630
    m_Localized: "Niewypa\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436631
    m_Localized: "Bro\u0144 si\u0119 zaci\u0119\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436632
    m_Localized: "\u0141adowanie zakl\u0119cia - @1 s"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436633
    m_Localized: "Magiczne przeci\u0105\u017Cenie"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436635
    m_Localized: "Za ma\u0142o magicznej mocy"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436636
    m_Localized: "Niemo\u017Cno\u015B\u0107 u\u017Cywania zakl\u0119\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436637
    m_Localized: Zwarcie w baterii
    m_Metadata:
      m_Items: []
