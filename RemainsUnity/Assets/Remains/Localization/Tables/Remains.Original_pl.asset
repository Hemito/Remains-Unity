    m_Localized: "Twoja umiej\u0119tno\u015B\u0107 pos\u0142ugiwania si\u0119 broni\u0105
      jest niewystarczaj\u0105ca"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629441
    m_Localized: "Niewystarczaj\u0105cy poziom postaci"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629442
    m_Localized: Ulepszono pancerz
    m_Metadata:
      m_Items: []
  - m_Id: 2733629443
    m_Localized: Uszkodzono pancerz
    m_Metadata:
      m_Items: []
  - m_Id: 2733629444
    m_Localized: "Stworzono bro\u0144: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629445
    m_Localized: "Stworzono przedmiot: @1. Og\xF3\u0142em masz - @2"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629446
    m_Localized: '@1 created'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629447
    m_Localized: 'Zainstalowano usprawnienie: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629448
    m_Localized: "Brak wymaganych materia\u0142\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629449
    m_Localized: Gra zapisana
    m_Metadata:
      m_Items: []
  - m_Id: 2733629450
    m_Localized: "B\u0142\u0105d zapisywania"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629451
    m_Localized: "B\u0142\u0105d wczytywania"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629452
    m_Localized: Punkt kontrolny
    m_Metadata:
      m_Items: []
  - m_Id: 2733629453
    m_Localized: "Dodano now\u0105 misj\u0119: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629454
    m_Localized: 'Dodano nowy etap misji: "@1"'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629455
    m_Localized: "Misja \"@1\" uko\u0144czona"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629456
    m_Localized: "Etap misji \"@1\" uko\u0144czony"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629457
    m_Localized: '@1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629458
    m_Localized: Uwaga! Doznano drobnego urazu
    m_Metadata:
      m_Items: []
  - m_Id: 2733629459
    m_Localized: "Uwaga! Doznano powa\u017Cnego urazu. Skontaktuj si\u0119 z lekarzem"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629460
    m_Localized: "Uwaga! Wykryto wiele uraz\xF3w. Krytyczny stan zdrowia. Wymagana
      jest natychmiastowa hospitalizacja"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629461
    m_Localized: "@1 Urazy niekompatybilne z \u017Cyciem. Spoczywaj w pokoju, @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629462
    m_Localized: Uwaga! Drobna utrata krwi
    m_Metadata:
      m_Items: []
  - m_Id: 2733629463
    m_Localized: "Uwaga! Powa\u017Cna utrata krwi"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629464
    m_Localized: Uwaga! Umierasz od utraty krwi. Krytyczny stan zdrowia
    m_Metadata:
      m_Items: []
  - m_Id: 2733629465
    m_Localized: "U\u017Cytkownik umar\u0142 od utraty krwi. Spoczywaj w pokoju,
      @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629466
    m_Localized: "Odczuwasz ma\u0142e magiczne wyczerpanie"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629467
    m_Localized: "Uwaga! Odczuwasz powa\u017Cne magiczne wyczerpanie"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629468
    m_Localized: "Uwaga! Twoja magiczna moc zosta\u0142a wyczerpana. Dalsze u\u017Cycie
      magii jest niemo\u017Cliwe"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629469
    m_Localized: "Uwaga! Zatruto ci\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629470
    m_Localized: Uwaga! Krwawisz!
    m_Metadata:
      m_Items: []
  - m_Id: 2733629471
    m_Localized: "Lekkie uzale\u017Cnienie od: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629472
    m_Localized: "\u015Aredni poziom uzale\u017Cnienia od: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629473
    m_Localized: "Ca\u0142kowite uzale\u017Cnienie od: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629474
    m_Localized: "Przywo\u0142ano towarzysza: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629475
    m_Localized: 'Odprawiono towarzysza: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629476
    m_Localized: Towarzysz w trakcie odrodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 2733629477
    m_Localized: "Akcja niedost\u0119pna"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629478
    m_Localized: Sowobot wymaga naprawy
    m_Metadata:
      m_Items: []
  - m_Id: 2733629479
    m_Localized: '@1 umiera. Czas do odrodzenia - @2 sekundy'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629480
    m_Localized: '@1 ulega zniszczeniu'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629481
    m_Localized: '@1 powraca do ciebie'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629482
    m_Localized: "Nie mo\u017Cna przywo\u0142a\u0107 tu towarzysza"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629483
    m_Localized: "Tw\xF3j towarzysz nie b\u0119dzie tu za tob\u0105 pod\u0105\u017Ca\u0142"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629484
    m_Localized: "Pr\xF3ba \"@1\" uko\u0144czona"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629485
    m_Localized: "To musi zosta\u0107 zrobione w bezpiecznym miejscu"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629486
    m_Localized: "Handlarze maj\u0105 nowe produkty na sprzeda\u017C"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629487
    m_Localized: Aktywuj [@1] = @2
    m_Metadata:
      m_Items: []
  - m_Id: 2733629488
    m_Localized: "Poziom trudno\u015Bci gry zmieniony: \"@1\""
    m_Metadata:
      m_Items: []
  - m_Id: 2733629489
    m_Localized: 'Wymagany przedmiot: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2733629490
    m_Localized: "U\u017Cyto przedmiotu: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629491
    m_Localized: "Mo\u017Cna przypisa\u0107 jedynie materia\u0142y wybuchowe lub
      zakl\u0119cia"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629492
    m_Localized: "Tylko dla zakl\u0119\u0107 obronnych"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629493
    m_Localized: "Zakl\u0119cie niedost\u0119pne"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629494
    m_Localized: "Bro\u0144 niedost\u0119pna"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629495
    m_Localized: "Nie \u015Bmie\u0107 w obozie bazowym, zamiast tego skorzystaj ze
      schowka"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629496
    m_Localized: "Lepiej b\u0119dzie zachowa\u0107 ten przedmiot"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629497
    m_Localized: "Handlarz nie posiada wystarczaj\u0105co kapsli, by zap\u0142aci\u0107
      za twoje towary"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629498
    m_Localized: "Za ma\u0142o miejsc na bronie"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629499
    m_Localized: "Za ma\u0142o miejsc na zakl\u0119cia"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629500
    m_Localized: "Zniszczono sprz\u0119t: (@1, @2szt.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2733629501
