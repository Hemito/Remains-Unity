    m_Localized: "Zajmuje miejsc na bro\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436383
    m_Localized: "Warto\u015B\u0107 sprzeda\u017Cy"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436384
    m_Localized: "Wymagana umiej\u0119tno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436385
    m_Localized: "Ca\u0142kowita waga sprz\u0119tu"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436386
    m_Localized: "Ca\u0142kowita waga amunicji"
    m_Metadata:
