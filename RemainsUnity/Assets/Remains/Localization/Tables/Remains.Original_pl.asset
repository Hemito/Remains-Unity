    m_Localized: 'Niewymagane: @1'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436589
    m_Localized: "Brak lek\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436590
    m_Localized: "By pozby\u0107 si\u0119 promieniowania u\u017Cyj RadAwayu"
