    m_Metadata:
      m_Items: []
  - m_Id: 2729436536
    m_Localized: Funkcja pancerza
    m_Metadata:
      m_Items: []
  - m_Id: 2729436537
    m_Localized: "Szybkie zakl\u0119cie 1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436538
    m_Localized: "Szybkie zakl\u0119cie 2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436539
    m_Localized: "Szybkie zakl\u0119cie 3"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436540
    m_Localized: "Szybkie zakl\u0119cie 4"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436541
    m_Localized: "Nie mo\u017Cna nic tu zrobi\u0107 bez narz\u0119dzi"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436542
    m_Localized: Pusto!
    m_Metadata:
      m_Items: []
  - m_Id: 2729436543
    m_Localized: "Pomy\u015Blnie otworzono zamek"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436544
    m_Localized: Otworzono kluczem
    m_Metadata:
      m_Items: []
  - m_Id: 2729436545
    m_Localized: "Zu\u017Cywa materia\u0142y do naprawy"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436546
    m_Localized: "Pole si\u0142owe jest wy\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436547
    m_Localized: "U\u017Cyto runy w\u0142amywacza"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436548
    m_Localized: "U\u017Cyto elektronicznego wytrychu"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436549
    m_Localized: "Uzyskano dost\u0119p"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436550
    m_Localized: Zreperowano
    m_Metadata:
      m_Items: []
  - m_Id: 2729436551
    m_Localized: "Nie uda\u0142o si\u0119 otworzy\u0107 zamka"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436552
    m_Localized: "Nie uda\u0142o si\u0119 otworzy\u0107 zamka. Wsuwka si\u0119 z\u0142ama\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436553
    m_Localized: "Nie uda\u0142o si\u0119 otworzy\u0107 zamka. Spr\xF3buj ponownie"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436554
    m_Localized: "Nie uda\u0142o si\u0119 wy\u0142\u0105czy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436555
    m_Localized: "Nie uda\u0142o si\u0119 naprawi\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436556
    m_Localized: "Hakowanie nieudane. Pozosta\u0142o pr\xF3b: @1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436557
    m_Localized: "Hakowanie nieudane. Pozosta\u0142a ostatnia pr\xF3ba"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436558
    m_Localized: "Hakowanie nieudane. Spr\xF3buj ponownie"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436559
    m_Localized: "Zamek si\u0119 zaci\u0105\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436560
    m_Localized: "Doznajesz wstrz\u0105su elektrycznego"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436561
    m_Localized: "System si\u0119 zablokowa\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436562
    m_Localized: Zepsute na dobre
    m_Metadata:
      m_Items: []
  - m_Id: 2729436563
    m_Localized: "Wymagane umiej\u0119tno\u015Bci @1-@2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436564
    m_Localized: "Rozbrojono \u0142adunek wybuchowy"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436565
    m_Localized: "Nie uda\u0142o si\u0119 rozbroi\u0107 \u0142adunku wybuchowego"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436566
    m_Localized: "Bomba eksplodowa\u0142a!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436567
    m_Localized: "Wy\u0142\u0105czono alarm"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436568
    m_Localized: "Nie uda\u0142o si\u0119 wy\u0142\u0105czy\u0107 alarmu"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436569
    m_Localized: "Alarm si\u0119 w\u0142\u0105czy\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436570
    m_Localized: "Aktywowano pu\u0142apk\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2729436571
    m_Localized: "Rozbrojono pu\u0142apk\u0119"
    m_Metadata:
      m_Items: []
