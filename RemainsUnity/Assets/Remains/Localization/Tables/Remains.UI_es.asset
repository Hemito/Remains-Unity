  - m_Id: 3325348012032
    m_Localized: "El dispositivo de audio rechaz\xF3 el cambio del b\xFAfer DSP."
    m_Metadata:
      m_Items:
      - rid: 4666841079933048844
  - m_Id: 3325348012033
    m_Localized: " Se ha conservado la configuraci\xF3n anterior."
    m_Metadata:
      m_Items:
