      m_Items:
      - rid: 4666841079933048852
  - m_Id: 3325352206343
    m_Localized: " Se ha restaurado el b\xFAfer DSP anterior."
    m_Metadata:
      m_Items:
      - rid: 4666841079933048853
  - m_Id: 3325352206344
    m_Localized: " No se pudo restaurar el b\xFAfer DSP anterior; comprueba el dispositivo
