    m_Metadata:
      m_Items:
      - rid: 4666841079933048854
  - m_Id: 1501148733444
    m_Localized: 'No se pudieron guardar los ajustes. '
    m_Metadata:
      m_Items:
      - rid: 4666841079933048855
  - m_Id: 1501148733445
    m_Localized: "B\xFAfer DSP: {0} muestras \xB7 256 \u2014 menor latencia, 1024
      \u2014 mayor estabilidad"
    m_Metadata:
      m_Items:
      - rid: 4666841079933048856
  - m_Id: 1501148733446
    m_Localized: "El volumen cambia al instante. \xABGuardar\xBB aplica el b\xFAfer
