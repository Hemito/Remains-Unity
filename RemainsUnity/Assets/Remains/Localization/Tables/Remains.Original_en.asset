      m_Items: []
  - m_Id: 2729436401
    m_Localized: Automatically pick up any ammunition providing there is enough space
      in the "Ammunition" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436402
    m_Localized: Matching ammunition
    m_Metadata:
      m_Items: []
  - m_Id: 2729436403
    m_Localized: Automatically pick up ammunition that matches weapons you have with
      you providing there is enough space in the "Ammunition" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436404
    m_Localized: Explosives
    m_Metadata:
      m_Items: []
  - m_Id: 2729436405
    m_Localized: Automatically pick up grenades, mines and bombs providing there
      is enough space in the "Ammunition" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436406
    m_Localized: Medicine and Potions
    m_Metadata:
      m_Items: []
  - m_Id: 2729436407
    m_Localized: Automatically collect all potions and medications providing there
      is enough space in the "Equipment" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436408
    m_Localized: Chemicals
    m_Metadata:
      m_Items: []
  - m_Id: 2729436409
    m_Localized: Automatically collect all chemicals providing there is enough space
      in the "Equipment" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436410
    m_Localized: Other equipment
    m_Metadata:
      m_Items: []
  - m_Id: 2729436411
    m_Localized: Automatically collect StealthBucks, repair kits, runes and similar
      items providing there is enough space in the "Equipment" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436412
    m_Localized: All stuff
    m_Metadata:
      m_Items: []
  - m_Id: 2729436413
    m_Localized: Automatically collect all non equipment or ammunition items providing
      there is enough space in the "Stuff" section
    m_Metadata:
      m_Items: []
  - m_Id: 2729436414
    m_Localized: '- Valuables'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436415
    m_Localized: Gems, disks, pre-war books - all that can be sold to merchants
    m_Metadata:
      m_Items: []
  - m_Id: 2729436416
    m_Localized: '- Skill items'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436417
    m_Localized: Educational books and memory orbs
    m_Metadata:
      m_Items: []
  - m_Id: 2729436418
    m_Localized: '- Food'
    m_Metadata:
      m_Items: []
  - m_Id: 2729436419
