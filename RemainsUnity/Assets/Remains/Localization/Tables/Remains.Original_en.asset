    m_Metadata:
      m_Items: []
  - m_Id: 2733629495
    m_Localized: Do not litter in the base camp, use the storage instead
    m_Metadata:
      m_Items: []
  - m_Id: 2733629496
    m_Localized: It is better to keep this item
    m_Metadata:
