  - m_Id: 2729435218
    m_Localized: A mechanism for spraying paint
    m_Metadata:
      m_Items: []
  - m_Id: 2729435219
    m_Localized: Trinitrotoluene
    m_Metadata:
      m_Items: []
  - m_Id: 2729435220
    m_Localized: A substance in shape of yellow crystals, a base for powerful explosives
    m_Metadata:
