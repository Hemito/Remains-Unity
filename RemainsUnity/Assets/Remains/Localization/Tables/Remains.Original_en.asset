      m_Items: []
  - m_Id: 2742018594
    m_Localized: Eliminate!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018595
    m_Localized: We`ve been long waiting for you!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018596
    m_Localized: And here you are!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018597
    m_Localized: Eliminate the target!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018598
    m_Localized: Shoot to kill!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018599
    m_Localized: Let`s finish her up!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018600
    m_Localized: Nothing personal!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018601
    m_Localized: This is just business
    m_Metadata:
      m_Items: []
  - m_Id: 2742018602
    m_Localized: I only need your head
    m_Metadata:
      m_Items: []
  - m_Id: 2742018603
    m_Localized: Better not resisting!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018604
    m_Localized: Stay where you are!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018605
    m_Localized: Don`t run, or it will be more painful
    m_Metadata:
      m_Items: []
  - m_Id: 2742018606
    m_Localized: Together now!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018607
    m_Localized: A bullet between eyes!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018608
    m_Localized: I am just fulfilling the contract
    m_Metadata:
      m_Items: []
  - m_Id: 2742018609
    m_Localized: This is my job
    m_Metadata:
      m_Items: []
  - m_Id: 2742018610
    m_Localized: They will pay nicely for your head!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018611
    m_Localized: What was that?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018612
    m_Localized: Who`s there?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018613
    m_Localized: Is there anypony?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018614
    m_Localized: Ah? Wha?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018615
    m_Localized: Suspicious noise!
    m_Metadata:
      m_Items: []
  - m_Id: 2742018616
    m_Localized: Hey! Check what`s there
    m_Metadata:
      m_Items: []
  - m_Id: 2742018617
    m_Localized: You hear that?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018618
    m_Localized: Where?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018619
    m_Localized: Are they shooting somewhere?
    m_Metadata:
      m_Items: []
  - m_Id: 2742018620
    m_Localized: Something fell?
    m_Metadata:
      m_Items: []
