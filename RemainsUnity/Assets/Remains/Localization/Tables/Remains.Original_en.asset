      m_Items: []
  - m_Id: 2742019185
    m_Localized: Discounts for veterans!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019186
    m_Localized: Thank you, come back soon!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019187
    m_Localized: Pleasure to make a deal with you
    m_Metadata:
      m_Items: []
  - m_Id: 2742019188
    m_Localized: If you need me, I will be right here
    m_Metadata:
      m_Items: []
  - m_Id: 2742019189
    m_Localized: Come back when you have extra caps
    m_Metadata:
      m_Items: []
  - m_Id: 2742019190
    m_Localized: Hey, don`t touch this!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019191
    m_Localized: Tell me where it hurts?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019192
    m_Localized: Do you need patching up?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019193
    m_Localized: Healing potions...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019194
    m_Localized: I`ll get you back on your hooves!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019195
    m_Localized: Is anypony injured?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019196
    m_Localized: Do you need a doctor?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019197
    m_Localized: First class healing magic!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019198
    m_Localized: Not feeling well?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019199
    m_Localized: We treat illnesses, wounds, injuries!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019200
    m_Localized: Absolutely painless procedures!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019201
    m_Localized: If you die, we`ll return your money!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019202
    m_Localized: Best medical care in the Wasteland!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019203
    m_Localized: Where did I leave my scalpel?..
    m_Metadata:
      m_Items: []
  - m_Id: 2742019204
    m_Localized: Free rabies shots!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019205
    m_Localized: An apple a day... would be great * sigh *
    m_Metadata:
      m_Items: []
  - m_Id: 2742019206
    m_Localized: Get a discount on blood transfusion!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019207
    m_Localized: Treating venereal diseases for half a price
    m_Metadata:
      m_Items: []
  - m_Id: 2742019208
    m_Localized: Feeling better?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019209
    m_Localized: All set! Neeext!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019210
    m_Localized: Be careful next time, OK?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019211
    m_Localized: Stay healthy!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019212
    m_Localized: There, there, you`re going to be OK
    m_Metadata:
      m_Items: []
  - m_Id: 2742019213
    m_Localized: Don`t you worry, it will grow back!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019214
    m_Localized: Don`t forget to take your medicine!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019215
    m_Localized: Help...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019216
    m_Localized: Help me!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019217
    m_Localized: Let me out!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019218
    m_Localized: Please, help...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019219
    m_Localized: Anypony...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019220
    m_Localized: Please, water...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019221
    m_Localized: What will happen to me?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019222
    m_Localized: Water......
    m_Metadata:
      m_Items: []
  - m_Id: 2742019223
    m_Localized: I need help...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019224
    m_Localized: Thanks!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019225
    m_Localized: Thank you!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019226
    m_Localized: You saved me!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019227
    m_Localized: Goddesses bless you!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019228
    m_Localized: I`m out of here!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019229
    m_Localized: I`m free!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019230
    m_Localized: Let`s get out of here!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019231
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019232
    m_Localized: How are you?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019233
    m_Localized: Huh!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019234
    m_Localized: Yeah, we have a problem...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019235
    m_Localized: Ponies are always talking
    m_Metadata:
      m_Items: []
  - m_Id: 2742019236
    m_Localized: What`s new?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019237
    m_Localized: You are not from around here?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019238
    m_Localized: What are you saying?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019239
    m_Localized: Somepony always needs help
    m_Metadata:
      m_Items: []
  - m_Id: 2742019240
    m_Localized: That`s none of my business...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019241
    m_Localized: Not my problem
    m_Metadata:
      m_Items: []
  - m_Id: 2742019242
    m_Localized: Here we go again...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019243
    m_Localized: What`s up?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019244
    m_Localized: What are we going to do now?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019245
    m_Localized: I`m so fed up!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019246
    m_Localized: As usual...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019247
    m_Localized: Yeah, right...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019248
    m_Localized: She could have done it herself
    m_Metadata:
      m_Items: []
  - m_Id: 2742019249
    m_Localized: They are doing it again...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019250
    m_Localized: That is definitely none of his concern
    m_Metadata:
      m_Items: []
  - m_Id: 2742019251
    m_Localized: Why me?
    m_Metadata:
      m_Items: []
  - m_Id: 2926567827
    m_Localized: What is this horrible smell?
    m_Metadata:
      m_Items: []
  - m_Id: 2926567828
    m_Localized: Ah, it`s you
    m_Metadata:
      m_Items: []
  - m_Id: 2926567829
    m_Localized: Oh, damn it!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567830
    m_Localized: You won`t understand!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567831
    m_Localized: I have much to do!
    m_Metadata:
      m_Items: []
  - m_Id: 2926567832
    m_Localized: I need some rest
    m_Metadata:
      m_Items: []
  - m_Id: 2742019252
    m_Localized: Time to work
    m_Metadata:
      m_Items: []
  - m_Id: 2742019253
    m_Localized: This wall needs a mural...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019254
    m_Localized: Where is my screwdriver?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019255
    m_Localized: I don`t believe it...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019256
    m_Localized: Golly...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019257
    m_Localized: Again?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019258
    m_Localized: When is your shift?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019259
    m_Localized: Lunch is on time?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019260
    m_Localized: I`m sick of it...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019261
    m_Localized: This place is a goddess-forsaken hole...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019262
    m_Localized: Wire is sparkling...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019263
    m_Localized: Another day, fuck it...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019264
    m_Localized: Fucking life...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019265
    m_Localized: For Celestia`s sake...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019266
    m_Localized: What now?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019267
    m_Localized: Everything is so dull...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019268
    m_Localized: Same old...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019269
    m_Localized: Well, yeah...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019270
    m_Localized: And what did you expect?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019271
    m_Localized: They are doing that again...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019272
    m_Localized: It stinks!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019273
    m_Localized: Why me?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019274
    m_Localized: Something is dripping on my head
    m_Metadata:
      m_Items: []
  - m_Id: 2742019275
    m_Localized: Good thing you are here and not outside
    m_Metadata:
      m_Items: []
  - m_Id: 2742019276
    m_Localized: The experiment was successful
    m_Metadata:
      m_Items: []
  - m_Id: 2742019277
    m_Localized: There`s mold here again
    m_Metadata:
      m_Items: []
  - m_Id: 2742019278
    m_Localized: Yes, where did that piece of crap roll?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019279
    m_Localized: I hate cleaning
    m_Metadata:
      m_Items: []
  - m_Id: 2742019280
    m_Localized: My PipBuck is buggy
    m_Metadata:
      m_Items: []
  - m_Id: 2742019281
    m_Localized: Oh yeah!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019282
    m_Localized: I`m not feeling so well
    m_Metadata:
      m_Items: []
  - m_Id: 2742019283
    m_Localized: Oh, @lp, long time no see!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019284
    m_Localized: It`s been a long time, @lp!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019285
    m_Localized: '@lp, haven`t seen you in a while.'
    m_Metadata:
      m_Items: []
  - m_Id: 2742019286
    m_Localized: How are you, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019287
    m_Localized: Hi @lp, you`re back?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019288
    m_Localized: You are back, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019289
    m_Localized: How is it up there?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019290
    m_Localized: Is it true that outside there are only monsters and radiation?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019291
    m_Localized: Have you seen monsters?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019292
    m_Localized: Oh... @lp showed up again...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019293
    m_Localized: Wow!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019294
    m_Localized: Just look at you!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019295
    m_Localized: When was the last time you took shower?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019296
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019297
    m_Localized: Hello, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019298
    m_Localized: How are you, @lp?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019299
    m_Localized: When are you going to return that debt?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019300
    m_Localized: My PipBuck is broken again, can you fix it?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019301
    m_Localized: Oh-wei!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019302
    m_Localized: Does everypony outside walk like this?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019303
    m_Localized: Do you still need your stuff?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019304
    m_Localized: I thought you would never return
    m_Metadata:
      m_Items: []
  - m_Id: 2742019305
    m_Localized: Why, if this isn`t the "Chosen-25" herself... big deal...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019306
    m_Localized: Did you find out something about Velvet?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019307
    m_Localized: You are back already?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019308
    m_Localized: Let`s make a party?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019309
    m_Localized: Come over, have some moonshine!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019310
    m_Localized: Hey, it`s occupied!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019311
    m_Localized: Hello!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019312
    m_Localized: What`s up?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019313
    m_Localized: Wanna play?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019314
    m_Localized: Pew-pew
    m_Metadata:
      m_Items: []
  - m_Id: 2742019315
    m_Localized: You`ll die soon...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019316
    m_Localized: Oh, that`s soo cool!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019317
    m_Localized: Awesome!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019318
    m_Localized: Hey, that`s mine!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019319
    m_Localized: Mine`s better!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019320
    m_Localized: Pew! Boom
    m_Metadata:
      m_Items: []
  - m_Id: 2742019321
    m_Localized: La-la-la
    m_Metadata:
      m_Items: []
  - m_Id: 2742019322
    m_Localized: Hide and seek?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019323
    m_Localized: What a dummy!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019324
    m_Localized: Nuh-huh
    m_Metadata:
      m_Items: []
  - m_Id: 2742019325
    m_Localized: Stay back!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019326
    m_Localized: Na-na-na
    m_Metadata:
      m_Items: []
  - m_Id: 2742019327
    m_Localized: Can I have some caps?
    m_Metadata:
      m_Items: []
  - m_Id: 2742019328
    m_Localized: Golly!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019329
    m_Localized: Hey, looky here!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019330
    m_Localized: I`m not doing anything!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019331
    m_Localized: It was broken when I found it!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019332
    m_Localized: Hi, @lp
    m_Metadata:
      m_Items: []
  - m_Id: 2742019333
    m_Localized: Yay!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019334
    m_Localized: I`m soo bored...
    m_Metadata:
      m_Items: []
  - m_Id: 2742019335
    m_Localized: It`s all his fault!
    m_Metadata:
      m_Items: []
  - m_Id: 2742019336
    m_Localized: I`m just standing here
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
